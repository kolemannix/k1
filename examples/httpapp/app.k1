ns app

use std/source
use http/http-response
use http/response
use http/routing
use http/sse-response
use http/sse-events
use http/datastar
use std/rc-byte-stream
use std/owned
use std/heap-bytes
use std/pubsub
use std/html
use std/url/pair
use http/cookie
use sqlite/sqlite3
use uv/libuv

type deps = {
  db: db,
  bus: *pubsub/bus[span[u8]],
}

let(mutable) db-path: string = "httpapp.sqlite"
let(mutable, tls) worker-deps: ptr = ptr/null

type db = { conn: *sqlite3/db }

ns for db {
  fn open(path: string): db {
    let conn: optref[sqlite3/db] = null()
    let open-status = sqlite3/open(path.to-c(), conn.&)
    if open-status != 0 crash("sqlite open failed for $path: $open-status")
    let db: db = .{ conn = conn.get() }
    sqlite3/busy_timeout(db.conn, 2000)
    db.run("create table if not exists visits(id integer primary key, path text not null, at text not null default current_timestamp)", "")
    db
  }

  fn fail(self: db, what: string): never {
    crash("sqlite $what failed: ${string/wrap-c(sqlite3/errmsg(self.conn).get())}")
  }

  fn prepare(self: db, sql: string): *sqlite3/stmt {
    let stmt: optref[sqlite3/stmt] = null()
    let tail: optref[u8] = null()
    if sqlite3/prepare_v2(self.conn, sql.to-c(), -1, stmt.&, tail.&) != 0 { self.fail("prepare") }
    stmt.get()
  }

  fn run(self: db, sql: string, text: string) {
    let stmt = self.prepare(sql)
    if text.non-empty() {
      sqlite3/bind_text(stmt, 1, text.data-ref-byte(), text.len().trunc[i32], fn(_p: ptr) .{})
    }
    let step-status = sqlite3/step(stmt)
    sqlite3/finalize(stmt)
    if step-status != sqlite3/DONE.trunc[i32] { self.fail("step") }
  }

  fn count(self: db, sql: string): i64 {
    let stmt = self.prepare(sql)
    if sqlite3/step(stmt) != sqlite3/ROW.trunc[i32] { self.fail("step") }
    let n = sqlite3/column_int64(stmt, 0)
    sqlite3/finalize(stmt)
    n
  }

  fn record-visit(self: db, path: string): i64 {
    self.run("insert into visits(path) values (?1)", path)
    self.count("select count(*) from visits")
  }
}

$http/routing/define(route, \{
  get    home         "/"
  get    events       "/events"
  get    counter      "/counter/events"
  get    big-file     "/static/big-file.json"
  get    starry       "/app/starry-night"
  get    visits       "/visits" ?{ who: ?string }
  post   login        "/login"
  get    game-events  "/game/{id: u64}/events"
  post   game-poke    "/game/{id: u64}/poke"
  delete delete-game  "/game/{id: u64}"
})

fn handle(req: http/request, bus: *pubsub/bus[span[u8]]): http-response {
  if worker-deps.is-null() {
    worker-deps = heap.new(app/deps.{ db = db/open(db-path), bus }).as[ptr]
  }
  let deps = worker-deps.ref[deps]
  if route/parse-request(req.header) is {
    :err e -> error-response(e),
    :ok r -> if r is {
      :home -> home-page(),
      :events -> global-events(deps),
      :counter -> counter-events(),
      :game-events .{ id } -> game-events(deps, id),
      :game-poke .{ id } -> game-poke(deps, id),
      :big-file -> big-file(),
      :starry -> response/html("todo"),
      :visits p -> visits(deps, req, p.who),
      :login -> login(req),
      :delete-game p -> response/html("todo ${p.id}"),
    }
  }
}

fn visits(deps: *deps, req: http/request, who: ?string): http-response {
  let n = deps.db.record-visit(req.header.url.path())
  let name = who ? (pair/find(req.cookies(), "who") ? "stranger")
  response/text(:ok, "hello $name, visit number $n\n")
}

fn login(req: http/request): http-response {
  if req.form() is {
    :some fields -> if pair/find(fields, "who") is {
      :some who -> .{
        status = :ok,
        content-type = "text/plain",
        extra-headers = span/single(cookie/set-header("who", who, cookie/attrs/default())),
        body = :complete span/single("logged in\n".span-bytes()),
      },
      :none -> response/text(:bad-request, "missing who\n"),
    },
    :none -> response/text(:unsupported-media-type, "send a form\n"),
  }
}

let global-topic: string = "global"
fn game-topic(id: u64): string { "game.$id" }

fn global-events(deps: *deps): http-response {
  datastar/patch-signals(deps.bus.subscribe(global-topic) || rc-byte-stream)
}

fn game-events(deps: *deps, id: u64): http-response {
  datastar/patch-signals(deps.bus.subscribe(game-topic(id)) || rc-byte-stream)
}

fn game-poke(deps: *deps, id: u64): http-response {
  publish-text(deps.bus, game-topic(id), "poked\nover http")
  response/text(:ok, "poked; events at ${route:game-events .{ id }}\n")
}

// One SSE event per number, rendered into the ambient request arena
fn counter-events(): http-response {
  let counts = 1.until(11).to-list()
  sse-response(source/from-printed(counts.as-span()) || sse-events("counter", ""))
}

fn big-file(): http-response {
  let out = string-builder/new()
  render-big-json(out.&, rows = 20000)
  response/stream("application/json", source/from-span(out.build().span-bytes(), chunk-size = 65536))
}

fn error-response(e: routing/route-error): http-response {
  if e is {
    :not-found -> response/not-found(),
    :bad-param b -> response/text(:bad-request, "Expected ${b.pattern}: `${b.got}` is not a valid ${b.ty} for ${b.name}\n"),
    :missing-param m -> response/text(:bad-request, "Expected ${m.pattern}: missing query param ${m.name}\n"),
    :bad-method b -> response/method-not-allowed(b.allowed),
  }
}

fn home-page(): http-response {
  let styles = core/files/read-to-string("web/styles.css").!
  response/html(html/render(\{
    <!DOCTYPE html>
    <html lang="en">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <script type="module" src="../datastar.js"></script>
        <title>k1/d* stress test</title>
        <link id="live-css" rel="stylesheet"/>
        <style>{styles}</style>
      </head>
      <body>
        <div data-json-signals></div>
        <h1>Hello, World!</h1>
        <input data-bind="foo"/>
        <label><input type="checkbox" name="sync" data-bind="sync"/> Sync</label>
        <div data-on-interval__duration.1000ms="if (\$sync) @get('/app/sync')"></div>
        <div id="grid"></div>
      </body>
    </html>
  }))
}

fn render-big-json(out: *string-builder, rows: size) {
  out.write("[")
  let i: size = 0
  while i < rows {
    if i > 0 { out.write(",") }
    let score = i * 7 % 1000
    out.write(`{"id": $i, "name": "row-$i", "flags": [true, false], "score": $score}`)
    i = i + 1
  }
  out.write("]")
}

// The bus takes rc'd payloads; text publishers copy to the heap once here.
// A publisher already holding heap-bytes would .to-rc() them directly.
fn publish-text(bus: *pubsub/bus[span[u8]], topic: string, data: string) {
  bus.publish(topic, heap-bytes/cloned(data.span-bytes()).to-rc())
}

let(mutable) game-tick: u64 = 0
fn spawn-tick-publisher-thread(bus: *pubsub/bus[span[u8]]) {
  let thread-id: *libuv/thread = heap.alloc-t()
  uv/check(libuv/thread_create(thread-id, fn arg. {
    libuv/thread_setname("publisher\0".data-ref-byte())
    let bus = arg.ref[pubsub/bus[span[u8]]]()
    loop {
      libuv/sleep(1000)
      // this thread's tmp arena holds the interpolated event data
      mem/tmp().reset()
      game-tick = game-tick + 1
      publish-text(bus, game-topic(42), `{"tick": $game-tick}`)
      if game-tick % 5 == 0 {
        publish-text(bus, global-topic, `{"uptime-seconds": $game-tick}`)
      }
    }
  }, arg = bus.as[ptr])).!
}
