use core/c-int
use std/sys

let ROUNDS: size = 7
let ROUND-NANOS: u64 = 200_000_000

fn c-out-capacity(input-len: size): size {
  cbrotli/encoder-max-compressed-size(input-len) + 1024
}

type run = { quality: size, lgwin: size }

fn c-new-encoder(r: run): ptr {
  let st = cbrotli/encoder-create-instance(ptr/null, ptr/null, ptr/null)
  cbrotli/encoder-set-parameter(st, :quality, r.quality.unsigned().trunc[u32])
  cbrotli/encoder-set-parameter(st, :lgwin, r.lgwin.unsigned().trunc[u32])
  st
}

fn c-stream(st: ptr, op: cbrotli/encoder-op, input: span[u8], out: buffer[u8], out-pos: *size) {
  let avail-in: size = input.len()
  let next-in: ptr = input.data-ptr()
  let avail-out: size = out.len() - out-pos.*
  let next-out: ptr = out.data-ptr().add-bytes(out-pos.*)
  let total-out: size = 0
  let ok = cbrotli/encoder-compress-stream(
    st, op, avail-in.&, next-in.&, avail-out.&, next-out.&, total-out.&)
  if ok == 0 crash("BrotliEncoderCompressStream failed")
  if avail-in != 0 crash("C encoder did not consume all input")
  out-pos.* = out.len() - avail-out
}

fn c-compress-into(input: span[u8], r: run, out: buffer[u8]): size {
  let st = c-new-encoder(r)
  defer cbrotli/encoder-destroy-instance(st)
  let out-pos: size = 0
  c-stream(st, :finish, input, out, out-pos.&)
  out-pos
}

fn c-compress(input: span[u8], r: run): span[u8] {
  let out = buffer/allocate[u8](c-out-capacity(input.len()))
  span/wrap-buffer(out.slice(0, c-compress-into(input, r, out)))
}

fn check-round-trip(name: string, input: span[u8], encoded: span[u8]) {
  let mark = mem/current-arena().mark()
  defer mem/current-arena().pop-to-mark(mark)
  let decoded = if brotli/decompress(encoded) is {
    :ok(b) -> b,
    :err(e) -> crash("$name: decode failed: $e")
  }
  if decoded.len() != input.len() {
    crash("$name: decoded ${decoded.len()} bytes, expected ${input.len()}")
  }
  let i: size = 0
  while i < input.len() {
    if decoded.index-unchecked(i).* != input.[i] {
      crash("$name: round-trip mismatch at byte $i")
    }
    i = i + 1
  }
}

fn check-input(name: string, input: span[u8], r: run) {
  let c-out = c-compress(input, r)

  let e = brotli/encoder/new-in(mem/current-arena(), r.quality, r.lgwin)
  let k1-out: list[u8] = list/empty()
  e.compress(input, k1-out.&)

  check-round-trip(name, input, c-out)
  check-round-trip(name, input, k1-out.as-span())

  if k1-out.len() != c-out.len() {
    crash("$name: k1 ${k1-out.len()} bytes != c ${c-out.len()} bytes")
  }
  let i: size = 0
  while i < c-out.len() {
    if k1-out.[i] != c-out.[i] {
      crash("$name: byte $i differs: k1 ${k1-out.[i]} c ${c-out.[i]}")
    }
    i = i + 1
  }
  println("$name q${r.quality} w${r.lgwin}: ${input.len()} -> ${k1-out.len()} bytes, byte-identical to C")
}

fn check-streaming(name: string, input: span[u8], r: run, chunk-size: size) {
  let chunks = input.len() / chunk-size + 1
  let st = c-new-encoder(r)
  defer cbrotli/encoder-destroy-instance(st)
  let c-out = buffer/allocate[u8](c-out-capacity(input.len()) + 16 * chunks)
  let c-pos: size = 0

  let e = brotli/encoder/new-in(mem/current-arena(), r.quality, r.lgwin)
  let out: list[u8] = list/empty()
  let pos: size = 0
  while pos < input.len() {
    let n = chunk-size.min(input.len() - pos)
    let chunk = input.slice(pos, pos + n)
    e.process(chunk, out.&)
    e.flush(out.&)
    c-stream(st, :flush, chunk, c-out, c-pos.&)
    pos = pos + n
  }
  e.finish(out.&)
  c-stream(st, :finish, span/empty(), c-out, c-pos.&)
  check-round-trip(name, input, out.as-span())

  if out.len() != c-pos {
    crash("$name: streaming k1 ${out.len()} bytes != c $c-pos bytes")
  }
  let i: size = 0
  while i < c-pos {
    if out.[i] != c-out.[i] {
      crash("$name: streaming byte $i differs: k1 ${out.[i]} c ${c-out.[i]}")
    }
    i = i + 1
  }
  println("$name q${r.quality} w${r.lgwin}: streaming ${input.len()} -> ${out.len()} bytes in $chunks chunks, byte-identical to C")
}

fn make-corpora(): list[{ name: string, data: span[u8] }] {
  let corpora: list[{ name: string, data: span[u8] }] = list/empty()
  corpora.push(.{ name = "empty", data = span/empty[u8]() })
  corpora.push(.{ name = "one-byte", data = "x".span-bytes() })
  corpora.push(.{ name = "tiny", data = "hello brotli".span-bytes() })

  let repeated = list/empty[u8]()
  let i: size = 0
  while i < 100000 {
    repeated.push((i % 251).trunc[u8])
    i = i + 1
  }
  corpora.push(.{ name = "cycle-251", data = repeated.as-span() })

  let zeros = buffer/filled[u8](1 << 20, 0)
  corpora.push(.{ name = "zeros-1mb", data = span/wrap-buffer(zeros) })

  let rand = list/empty[u8]()
  let state: u64 = 0x9E3779B97F4A7C15
  i = 0
  while i < 300000 {
    state = state ^ (state << 13)
    state = state ^ (state >> 7)
    state = state ^ (state << 17)
    rand.push((state & 0xFF).trunc[u8])
    i = i + 1
  }
  corpora.push(.{ name = "random-300k", data = rand.as-span() })

  let text = core/files/read-to-string("../../src/k1/typer.rs").!.span-bytes()
  corpora.push(.{ name = "typer.rs", data = text })

  corpora
}

fn mbps(nanos: u64, bytes: size): f64 {
  bytes.as[f64] / nanos.as[f64] * 1000.0
}

fn write-mbps(sb: *string-builder, label: string, nanos: *list[u64], bytes: size) {
  nanos.sort()
  sb.write("$label ")
  mbps(nanos.[nanos.len() / 2], bytes).format(sb, 1)
  sb.write(" MB/s (best ")
  mbps(nanos.[0], bytes).format(sb, 1)
  sb.write(")")
}

fn bench-one(name: string, input: span[u8], r: run) {
  use std/time

  let cap = c-out-capacity(input.len())
  let e = brotli/encoder/new-in(mem/current-arena(), r.quality, r.lgwin)
  let k1-out: list[u8] = list/with-capacity(cap)
  let c-out = buffer/allocate[u8](cap)

  let warm-start = time/read-cpu-counter()
  e.compress(input, k1-out.&)
  let k1-bytes = k1-out.len()
  let c-bytes = c-compress-into(input, r, c-out)
  assert-equals(k1-bytes, c-bytes)
  let warm-nanos = time/elapsed-nanos(warm-start)
  let reps = (ROUND-NANOS / warm-nanos.max(1)).max(1).signed()

  let k1-times: list[u64] = list/empty()
  let c-times: list[u64] = list/empty()
  let decode-times: list[u64] = list/empty()
  for 0.until(ROUNDS) {
    let k1-nanos: u64 = 0
    let c-nanos: u64 = 0
    let decode-nanos: u64 = 0
    for 0.until(reps) {
      let k1-start = time/read-cpu-counter()
      e.reset()
      k1-out.clear()
      e.compress(input, k1-out.&)
      let c-start = time/read-cpu-counter()
      c-compress-into(input, r, c-out)
      let decode-start = time/read-cpu-counter()
      let mark = mem/current-arena().mark()
      let decoded = brotli/decompress(k1-out.as-span()).!
      let end = time/read-cpu-counter()
      assert-equals(decoded.len(), input.len())
      mem/current-arena().pop-to-mark(mark)
      k1-nanos = k1-nanos + time/counter-to-nanos(c-start - k1-start)
      c-nanos = c-nanos + time/counter-to-nanos(decode-start - c-start)
      decode-nanos = decode-nanos + time/counter-to-nanos(end - decode-start)
    }
    k1-times.push(k1-nanos)
    c-times.push(c-nanos)
    decode-times.push(decode-nanos)
  }

  let round-bytes = input.len() * reps
  let sb = string-builder/new()
  sb.write("$name q${r.quality} w${r.lgwin}: ")
  write-mbps(sb.&, "k1", k1-times.&, round-bytes)
  sb.write(", ")
  write-mbps(sb.&, "c", c-times.&, round-bytes)
  sb.write(", ratio ")
  (c-times.[c-times.len() / 2].as[f64] / k1-times.[k1-times.len() / 2].as[f64]).format(sb.&, 3)
  sb.write(", ")
  write-mbps(sb.&, "k1 decode", decode-times.&, round-bytes)
  sb.write(", ${input.len()} -> $k1-bytes bytes, $reps reps x $ROUNDS rounds")
  println(sb.&.build())
}

fn main(argc: u32, argv: ptr): i32 {
  let args = std/sys/parse-main-args(argc, argv)
  let corpora = make-corpora()
  let runs: list[run] = list/empty()
  let rest: list[string] = list/empty()
  let lgwin: size = 18
  for i in 1.until(args.len()) {
    if args.[i].starts-with("lgwin=") {
      lgwin = u64/from-string(args.[i].drop(6)).!.signed()
    } else if u64/from-string(args.[i]) is :ok q {
      runs.push(.{ quality = q.signed(), lgwin })
    } else {
      rest.push(args.[i])
    }
  }
  if runs.is-empty() {
    for q in 0.until(12) { runs.push(.{ quality = q, lgwin = 18 }) }
    for q in [5, 7, 9] { runs.push(.{ quality = q, lgwin = 16 }) }
    runs.push(.{ quality = 6, lgwin = 22 })
  }
  for r in runs {
    for c in corpora {
      check-input(c.name, c.data, r)
    }
    for c in corpora {
      if c.data.non-empty() {
        check-streaming("${c.name}/333b-chunks", c.data, r, 333)
        check-streaming("${c.name}/64k-chunks", c.data, r, 1 << 16)
      }
    }
  }
  println("all parity + round-trip checks passed")

  if rest.len() > 0 and rest.[0] == "bench" {
    let only = if rest.len() > 1 rest.[1] else ""
    for r in runs {
      println("")
      for c in corpora {
        if c.data.len() >= 100000 and (only == "" or only == c.name) {
          bench-one(c.name, c.data, r)
        }
      }
    }
  }
  0
}
