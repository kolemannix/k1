// This was formerly a narrative guide through the macro system
// But it go way better; so now its a bit of a spelunk through the 
// primitives that sit below the `macro` end-user syntax (sugar)

fn addgen[a](x: a, y: a): a { 
  #meta "x + y"
}

// But we can do better, with some sugar:
macro addmacro(x, y) {
  "$x + $y"
}

fn addlazy(x: code, y: code): code {
  "$x + $y"
}

fn repeat(n: int, expr: code): code {
  let cb = code-builder/new()
  for 0.until(n) { cb.write("$expr;") }
  cb.build()
}
macro repeatm(n: int, expr) {
  let cb = code-builder/new()
  for 0.until(n) { cb.write("$expr;") }
  cb.build()
}

fn main(): i32 {


  let thunk = fn.{ println("thunk"); 21 }
  let x = #meta addlazy(\thunk(), \55)
  println(x);

  let x2 = addmacro(thunk(), 55);
  println(x2);

  // Here is how we would invoke the 'repeat' function manually
  #meta repeat(5, \println("hello ${addgen(x, x)}"))

  // Here is how we would invoke the 'repeat' function as a macro
  // TODO we can mask locals when compiling metaprogram output for opt-in hygiene
  repeatm(5, println("hello ${addmacro(x, x)}"))

  0
}
