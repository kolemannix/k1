ns flag {
  let INIT-VIDEO: sdl3/InitFlags = 0x00000020

  let WINDOW-FULLSCREEN: sdl3/WindowFlags = 0x0000000000000001
  let WINDOW-RESIZABLE: sdl3/WindowFlags = 0x0000000000000020
  let WINDOW-HIGH-PIXEL-DENSITY: sdl3/WindowFlags = 0x0000000000002000
  let WINDOW-ALWAYS-ON-TOP: sdl3/WindowFlags = 0x0000000000010000

  let BLENDMODE-NONE: sdl3/BlendMode = 0x00000000
  let BLENDMODE-BLEND: sdl3/BlendMode = 0x00000001
  let BLENDMODE-BLEND-PREMULTIPLIED: sdl3/BlendMode = 0x00000010
}
