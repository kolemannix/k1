ns flag {
  let INIT-VIDEO: c/InitFlags = 0x00000020

  let WINDOW-FULLSCREEN: c/WindowFlags = 0x0000000000000001
  let WINDOW-RESIZABLE: c/WindowFlags = 0x0000000000000020
  let WINDOW-HIGH-PIXEL-DENSITY: c/WindowFlags = 0x0000000000002000
  let WINDOW-ALWAYS-ON-TOP: c/WindowFlags = 0x0000000000010000

  let BLENDMODE-NONE: c/BlendMode = 0x00000000
  let BLENDMODE-BLEND: c/BlendMode = 0x00000001
  let BLENDMODE-BLEND-PREMULTIPLIED: c/BlendMode = 0x00000010
}
