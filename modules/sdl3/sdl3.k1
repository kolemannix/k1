type Haptic = opaque[0, 1]
type(alias) HapticEffectType = Uint16
#static assert-layout[HapticEffectType](2, 2, [])
type(alias) HapticDirectionType = Uint8
#static assert-layout[HapticDirectionType](1, 1, [])
type(alias) HapticEffectID = i32
#static assert-layout[HapticEffectID](4, 4, [])
type HapticDirection = {
  type: HapticDirectionType,
  dir: array[Sint32, 3],
}
#static assert-layout[HapticDirection](16, 4, [0, 4, ])
type HapticConstant = {
  type: HapticEffectType,
  direction: HapticDirection,
  length: Uint32,
  delay: Uint16,
  button: Uint16,
  interval: Uint16,
  level: Sint16,
  attack_length: Uint16,
  attack_level: Uint16,
  fade_length: Uint16,
  fade_level: Uint16,
}
#static assert-layout[HapticConstant](40, 4, [0, 4, 20, 24, 26, 28, 30, 32, 34, 36, 38, ])
type HapticPeriodic = {
  type: HapticEffectType,
  direction: HapticDirection,
  length: Uint32,
  delay: Uint16,
  button: Uint16,
  interval: Uint16,
  period: Uint16,
  magnitude: Sint16,
  offset: Sint16,
  phase: Uint16,
  attack_length: Uint16,
  attack_level: Uint16,
  fade_length: Uint16,
  fade_level: Uint16,
}
#static assert-layout[HapticPeriodic](48, 4, [0, 4, 20, 24, 26, 28, 30, 32, 34, 36, 38, 40, 42, 44, ])
type HapticCondition = {
  type: HapticEffectType,
  direction: HapticDirection,
  length: Uint32,
  delay: Uint16,
  button: Uint16,
  interval: Uint16,
  right_sat: array[Uint16, 3],
  left_sat: array[Uint16, 3],
  right_coeff: array[Sint16, 3],
  left_coeff: array[Sint16, 3],
  deadband: array[Uint16, 3],
  center: array[Sint16, 3],
}
#static assert-layout[HapticCondition](68, 4, [0, 4, 20, 24, 26, 28, 30, 36, 42, 48, 54, 60, ])
type HapticRamp = {
  type: HapticEffectType,
  direction: HapticDirection,
  length: Uint32,
  delay: Uint16,
  button: Uint16,
  interval: Uint16,
  start: Sint16,
  end: Sint16,
  attack_length: Uint16,
  attack_level: Uint16,
  fade_length: Uint16,
  fade_level: Uint16,
}
#static assert-layout[HapticRamp](44, 4, [0, 4, 20, 24, 26, 28, 30, 32, 34, 36, 38, 40, ])
type HapticLeftRight = {
  type: HapticEffectType,
  length: Uint32,
  large_magnitude: Uint16,
  small_magnitude: Uint16,
}
#static assert-layout[HapticLeftRight](12, 4, [0, 4, 8, 10, ])
type HapticCustom = {
  type: HapticEffectType,
  direction: HapticDirection,
  length: Uint32,
  delay: Uint16,
  button: Uint16,
  interval: Uint16,
  channels: Uint8,
  period: Uint16,
  samples: Uint16,
  data: *mut Uint16,
  attack_length: Uint16,
  attack_level: Uint16,
  fade_length: Uint16,
  fade_level: Uint16,
}
#static assert-layout[HapticCustom](56, 8, [0, 4, 20, 24, 26, 28, 30, 32, 34, 40, 48, 50, 52, 54, ])
type HapticEffect = union {
  type: HapticEffectType,
  constant: HapticConstant,
  periodic: HapticPeriodic,
  condition: HapticCondition,
  ramp: HapticRamp,
  leftright: HapticLeftRight,
  custom: HapticCustom,
}
#static assert-layout[HapticEffect](72, 8, [])
type(alias) HapticID = Uint32
#static assert-layout[HapticID](4, 4, [])
