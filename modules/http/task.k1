use std/pool
use uv/job
use uv/worker-pool

type task[t] = { pool: *worker-pool, job: pool/handle[job], output: *uv/monitor[?t] }

type task-work[t, params] = {
  output: *uv/monitor[?t],
  params,
  handler: *fn(params) -> t,
}

ns for task {
  fn spawn[t, params](pool: *worker-pool, handler: *fn(params) -> t, params): ?task[t] {
    let output: *uv/monitor[?t] = heap.alloc-t()
    output.init(:none)
    let work: *task-work[t, params] = heap.new(.{ output, params, handler })
    require pool.submit(work, run-task-work[t, params].&) is :some job else {
      heap.free-t(work)
      output.destroy()
      heap.free-t(output)
      return :none
    }
    :some .{ pool, job, output }
  }

  fn await[t](self: task[t]): t {
    let _ = self.pool.try-run-inline(self.job)
    let monitor = self.output
    let output = worker-pool/block-in-place(fn[monitor]. {
      let guard = monitor.lock()
      while guard.value.* is :none { guard.wait() }
      let output = guard.value.*.!
      guard.unlock()
      output
    })
    self.output.destroy()
    heap.free-t(self.output)
    output
  }
}

fn run-task-work[t, params](work: *task-work[t, params]) {
  let output = (work.handler)(work.params)
  let guard = work.output.lock()
  guard.value.* = :some output
  guard.signal()
  guard.unlock()
  heap.free-t(work)
}
