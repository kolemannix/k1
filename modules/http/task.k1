// An experimental libuv work based async 'task'
// Spawns the given callback on a libuv worker thread
// And awaits the result via a condition variable

// Using this from libuv worker threads themselves
// can result in deadlocks, so don't do that.

// i think ideally we probably re-purpose this to run
// on a newly spawned thread, for work that is expensive enough
// that we don't care about thread overhead.

// That or we re-purpose this to enqueue the work onto a dedicated work thread
// that perhaps we have a handle to; db-writer.spawn(task)
// This will be the shape of our solution for ensuring our sqlite writes
// never deadlock; they must be serialized to something like this
type task[t] = {
  state: *task-state[t],
}

type task-progress[t] = {
  handler-done: bool,
  libuv-done: bool,
  output: ?t,
}

type task-state[t] = {
  req: *libuv/work,
  cond: uv/cond,
  progress: uv/mutex[task-progress[t]],
}

ns for task-state {
  fn release[t](self: *task-state[t]) {
    self.cond.destroy()
    self.progress.destroy-lock()
    heap.free-t(self.req)
    heap.free-t(self)
  }
}

type task-work[t, params] = {
  state: *task-state[t],
  params,
  handler: *fn(params) -> t,
}

ns for task {
  fn spawn[t, params](
    l: *uv-loop,
    handler: *fn(params) -> t,
    params,
  ): task[t] {
    let state: *task-state[t] = heap.new(.{
      req = heap.alloc-t[libuv/work],
      cond = uninit,
      progress = uninit,
    })
    state.cond.init()
    state.progress.init(.{ handler-done = false, libuv-done = false, output = :none })
    let work: *task-work[t, params] = heap.new(.{
      state,
      params,
      handler,
    })

    state.req.set-data(work)

    work/submit-work(
      state.req,
      fn req. {
        let task-work = req.get-data[task-work[t, params]]
        let handler = task-work.handler
        task/complete(task-work.state, handler(task-work.params))
        .{}
      },
      fn (req, status) {
        let task-work = req.get-data[task-work[t, params]]
        if status != 0 {
          println("task work failed with status $status")
        }
        uv/locked(task-work.state.progress, p, {
          p.libuv-done = true
          task-work.state.cond.signal()
        })
        heap.free-t(task-work)
      }
    )

    .{ state }
  }

  fn await[t](self: task[t]): t {
    let state = self.state

    let p = state.progress.lock()
    while p.value.handler-done == false or p.value.libuv-done == false {
      state.cond.wait(p)
    }
    let output = p.value.output.!
    p.unlock()

    state.release()
    output
  }

  fn complete[t](state: *task-state[t], output: t) {
    uv/locked(state.progress, p, {
      p.output = :some output
      p.handler-done = true
      state.cond.signal()
    })
  }
}
