use std/process

fn module(): k1/module {
  let m = k1/module/new()
  m.dep("libuv")
  m.lib("llhttp", :static)
  m.setup(["libs/libllhttp.a", "llhttp.k1"], ["vendor"])
  m
}

// Compiles the vendored llhttp release C (v9.4.1, generated once from the
// nodejs/llhttp repo) into libs/libllhttp.a and regenerates the llhttp
// bindings. Runs in the compile-time VM with cwd = the module dir; needs cc
// and k1bindgen on PATH.
fn setup(_ctx: k1/setup-ctx) {
  process/run-command("mkdir", ["-p", "libs", ".k1-out/llhttp"], :inherit).!

  for ["llhttp", "api", "http"] {
    let cc-args: list[string] = ["-O2", "-Ivendor", "-c", "vendor/${it}.c", "-o", ".k1-out/llhttp/${it}.o"]
    if k1/platform-macos { cc-args.push("-mmacosx-version-min=15.0.0") }
    process/run-command("cc", cc-args.as-span(), :inherit).!
  }
  process/run-command("/bin/sh", ["-c", "ar rcs libs/libllhttp.a .k1-out/llhttp/*.o"], :inherit).!

  let args: list[string] = [
    "-in-path", "vendor/llhttp.h",
    "-out-path", "llhttp.k1",
    "-lib-name", "llhttp",
    "+strip-prefix", "llhttp_",
    "+strip-prefix", "HTTP_",
    "+strip-suffix", "_t",
  ]
  // The host SDK, for system headers
  if k1/platform-macos {
    let sdk = process/run("/bin/sh", ["-c", "printf %s $(xcrun --sdk macosx --show-sdk-path)"]).!
    args.push("+clangarg")
    args.push("-isysroot")
    args.push("+clangarg")
    args.push(sdk)
  }
  let _ = process/run-command("k1bindgen", args.as-span(), :inherit).!
}
