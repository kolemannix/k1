ns date {
  let MONTH-NAMES: span[string] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  let WEEKDAY-NAMES: span[string] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]

  fn parse(text: string): ?u64 {
    let time: ?{ hour: u64, minute: u64, second: u64 } = :none
    let day: ?u64 = :none
    let month: ?u64 = :none
    let year: ?u64 = :none
    let rest = text
    while rest.non-empty() {
      rest = rest.drop-while(is-delimiter)
      let token = rest.take-while(fn c. not is-delimiter(c))
      rest = rest.drop(token.len())
      if time is :none and read-digits(token, 1, 2) is :some h and h.rest.starts-with(":")
        and read-digits(h.rest.drop(1), 1, 2) is :some m and m.rest.starts-with(":")
        and read-digits(m.rest.drop(1), 1, 2) is :some s {
        time = :some .{ hour = h.value, minute = m.value, second = s.value }
        continue
      }
      if day is :none and read-digits(token, 1, 2) is :some d {
        day = :some d.value
        continue
      }
      if month is :none and MONTH-NAMES.find-index(fn[token] name. token.starts-with-ignore-ascii-case(name)) is :some i {
        month = :some ((i + 1).unsigned())
        continue
      }
      if year is :none and read-digits(token, 2, 4) is :some y { year = :some y.value }
    }
    require time is :some hms and day is :some d and month is :some m and year is :some two-or-four else {
      return :none
    }
    let y = if two-or-four < 70 two-or-four + 2000 else if two-or-four < 100 two-or-four + 1900 else two-or-four
    let is-leap = y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
    let month-days: u64 = if m == 2 (if is-leap 29 else 28) else if m == 4 or m == 6 or m == 9 or m == 11 30 else 31
    if d < 1 or d > month-days or y < 1601 or hms.hour > 23 or hms.minute > 59 or hms.second > 59 return :none
    if y < 1970 return :some 0

    // days since 1970-01-01, with years starting in March so the leap day falls last
    let march-year = if m <= 2 y - 1 else y
    let era = march-year / 400
    let year-of-era = march-year - era * 400
    let day-of-year = ((if m > 2 m - 3 else m + 9) * 153 + 2) / 5 + d - 1
    let day-of-era = year-of-era * 365 + year-of-era / 4 - year-of-era / 100 + day-of-year
    let days = era * 146097 + day-of-era - 719468
    :some (days * 86400 + hms.hour * 3600 + hms.minute * 60 + hms.second)
  }

  fn to-string(unix-seconds: u64): string {
    let days = unix-seconds / 86400
    let second-of-day = unix-seconds % 86400

    // civil date from days since 1970-01-01, with years starting in March
    let day-of-epoch = days + 719468
    let era = day-of-epoch / 146097
    let day-of-era = day-of-epoch - era * 146097
    let year-of-era = (day-of-era - day-of-era / 1460 + day-of-era / 36524 - day-of-era / 146096) / 365
    let day-of-year = day-of-era - (year-of-era * 365 + year-of-era / 4 - year-of-era / 100)
    let march-month = (day-of-year * 5 + 2) / 153
    let day = day-of-year - (march-month * 153 + 2) / 5 + 1
    let month = if march-month < 10 march-month + 3 else march-month - 9
    let year = year-of-era + era * 400 + (if month <= 2 1: u64 else 0)

    let weekday = WEEKDAY-NAMES.[((days + 4) % 7).signed()]
    let month-name = MONTH-NAMES.[(month - 1).signed()]
    let hour = second-of-day / 3600
    let minute = second-of-day / 60 % 60
    let second = second-of-day % 60
    "$weekday, ${day:02} $month-name $year ${hour:02}:${minute:02}:${second:02} GMT"
  }

  fn is-delimiter(c: char): bool {
    c == '\t' or (c >= ' ' and c <= '/') or (c >= ';' and c <= '@') or (c >= '[' and c <= '`') or (c >= '{' and c <= '~')
  }

  fn read-digits(text: string, min: size, max: size): ?{ value: u64, rest: string } {
    let digits = text.take-while(fn c. c.is-ascii-digit())
    require digits.len() >= min and digits.len() <= max and u64/from-string(digits) is :ok value else { return :none }
    :some .{ value, rest = text.drop(digits.len()) }
  }
}
