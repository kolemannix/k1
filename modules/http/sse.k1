use std/source
use std/pipe
use std/byte-source

type sse-encoder = {
  event-line: span[u8],
  line-prefix: span[u8],
}

fn sse-events(upstream: byte-source, event-name: string, data-prefix: string): byte-source {
  let stage: sse-encoder = .{
    event-line = "event: $event-name\n".span-bytes(),
    line-prefix = (if data-prefix.is-empty() "data: " else "data: $data-prefix ").span-bytes(),
  }
  source/through(upstream, stage)
}

impl pipe[t = u8, out = u8] for sse-encoder {
  fn map(self: *sse-encoder, group: span[span[u8]], out: *list[span[u8]]) {
    out.push(self.event-line)
    let at-line-start = true
    let after-cr = false
    for seg in group {
      let line-start: size = 0
      let i: size = 0
      while i < seg.len() {
        let b = seg.[i]
        if b == 10 and after-cr {
          line-start = i + 1
        } else if b == 10 or b == 13 {
          if at-line-start { out.push(self.line-prefix) }
          if i > line-start { out.push(seg.slice(line-start, i)) }
          out.push("\n".span-bytes())
          at-line-start = true
          line-start = i + 1
        }
        after-cr = b == 13
        i = i + 1
      }
      if line-start < seg.len() {
        if at-line-start { out.push(self.line-prefix) }
        out.push(seg.slice(line-start, seg.len()))
        at-line-start = false
      }
    }
    if not at-line-start { out.push("\n".span-bytes()) }
    out.push("\n".span-bytes())
  }
}

fn sse-response(events: byte-source): http-response {
  .{
    content-type = "text/event-stream",
    extra-headers = ["Cache-Control: no-cache"],
    body = :stream events,
    status = 200,
  }
}

ns datastar {
  fn patch-elements(elements: byte-source): http-response {
    sse-response(elements || sse-events("datastar-patch-elements", "elements"))
  }
  fn patch-signals(signals: byte-source): http-response {
    sse-response(signals || sse-events("datastar-patch-signals", "signals"))
  }
}
