use std/stream/pipe
use std/utf8

type sse-encoder = {
  event-line: span[u8],
  line-prefix: span[u8],
}

ns for sse-encoder {
  fn new(event-name: string, data-prefix: string): sse-encoder {
    .{
      event-line = "event: $event-name\n".span-bytes(),
      line-prefix = (if data-prefix.is-empty() "data: " else "data: $data-prefix ").span-bytes(),
    }
  }
}

ns sse {
  fn push-data-lines(out: *list[span[u8]], line-prefix: span[u8], group: span[span[u8]]) {
    let at-line-start = true
    let after-cr = false
    for seg in group {
      let line-start: size = 0
      let i: size = 0
      while i < seg.len() {
        let b = seg.[i]
        if b == 10 and after-cr {
          line-start = i + 1
        } else if b == 10 or b == 13 {
          if at-line-start { out.push(line-prefix) }
          if i > line-start { out.push(seg.slice(line-start, i)) }
          out.push("\n".span-bytes())
          at-line-start = true
          line-start = i + 1
        }
        after-cr = b == 13
        i = i + 1
      }
      if line-start < seg.len() {
        if at-line-start { out.push(line-prefix) }
        out.push(seg.slice(line-start, seg.len()))
        at-line-start = false
      }
    }
    if not at-line-start { out.push("\n".span-bytes()) }
  }
}

impl pipe[t = u8, out = u8] for sse-encoder {
  fn map(self: *sse-encoder, group: span[span[u8]], out: *list[span[u8]]) {
    out.push(self.event-line)
    sse/push-data-lines(out, self.line-prefix, group)
    out.push("\n".span-bytes())
  }
}

type sse-event = { event: string, data: string, id: ?string, retry-ms: ?u64 }

type sse-decoder = {
  current-line: list[char],
  is-after-cr: bool,
  has-read-line: bool,
  event-name: list[char],
  data: list[char],
  id: ?list[char],
  retry-ms: ?u64,
  events: list[sse-event],
  text: list[char],
}

ns for sse-decoder {
  fn new(): sse-decoder { .0 }

  fn copy-text(self: *sse-decoder, text: span[char]): string {
    let start = self.text.len()
    self.text.append-span(text)
    string/wrap-span(self.text.as-span().drop(start))
  }

  fn end-line(self: *sse-decoder) {
    let line = string/wrap-list(self.current-line)
    if not self.has-read-line {
      self.has-read-line = true
      if line.span-bytes().starts-with(utf8/BOM) { line = line.drop(utf8/BOM.len()) }
    }
    if line.is-empty() {
      if self.data.non-empty() {
        self.events.push(.{
          event = if self.event-name.is-empty() "message" else self.copy-text(self.event-name.as-span()),
          data = self.copy-text(self.data.as-span().take(self.data.len() - 1)),
          id = if self.id is :some id :some self.copy-text(id.as-span()) else :none,
          retry-ms = self.retry-ms,
        })
        self.id = :none
        self.retry-ms = :none
      }
      self.data.clear()
      self.event-name.clear()
    } else {
      let field = line.split-once(":")
      let name = field.before
      let value = field.after ? ""
      if value.starts-with(" ") { value = value.drop(1) }
      if name == "data" {
        self.data.append-span(value.span)
        self.data.push('\n')
      } else if name == "event" {
        self.event-name.clear()
        self.event-name.append-span(value.span)
      } else if name == "id" and not value.contains('\0') {
        self.id = :some list/from-span(value.span)
      } else if name == "retry" and u64/from-string(value) is :ok(ms) {
        self.retry-ms = :some ms
      }
    }
    self.current-line.clear()
  }
}

impl pipe[t = u8, out = sse-event] for sse-decoder {
  fn map(self: *sse-decoder, group: span[span[u8]], out: *list[span[sse-event]]) {
    for segment in group {
      for b in segment {
        let is-cr = b == '\r'.as-u8()
        let is-lf = b == '\n'.as-u8()
        if not (is-lf and self.is-after-cr) {
          if is-cr or is-lf self.end-line() else self.current-line.push(bitcast(b))
        }
        self.is-after-cr = is-cr
      }
    }
    if self.events.non-empty() { out.push(self.events.as-span()) }
  }
  fn retire(self: *sse-decoder) {
    self.events.clear()
    self.text.clear()
  }
}
