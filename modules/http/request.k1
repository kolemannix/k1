use std/url
use std/url/pair
use std/url/percent

ns cookie {
  fn parse(header: string): list[pair] {
    let out = list/empty[pair]()
    for part in header.split-by-char(';') {
      let field = part.trim-ascii-space()
      if field.index-of('=') is :some i {
        out.push(.{ name = field.take(i), value = percent/decode(field.drop(i + 1)) })
      }
    }
    out
  }

  type attrs = {
    path: string,
    max-age: ?u64,
    http-only: bool,
    secure: bool,
    same-site: either { lax, strict, none },
  }
  ns for attrs {
    fn default(): attrs { .{ path = "/", max-age = :none, http-only = true, secure = false, same-site = :lax } }
  }

  fn set-header(name: string, value: string, attrs: attrs): string {
    let out = string-builder/new()
    out.write("Set-Cookie: $name=${percent/encode(value, :unreserved)}; Path=${attrs.path}")
    if attrs.max-age is :some n { out.write("; Max-Age=$n") }
    if attrs.http-only { out.write("; HttpOnly") }
    if attrs.secure { out.write("; Secure") }
    out.write(if attrs.same-site is { :lax -> "; SameSite=Lax", :strict -> "; SameSite=Strict", :none -> "; SameSite=None" })
    out.build()
  }
}

ns for request {
  fn accepts-encoding(self: request, coding: string): bool {
    require self.header.find("Accept-Encoding") is :some value else return false
    for value.split-by-char(',') {
      let params = it.split-by-char(';')
      if not params.[0].trim-ascii-space().equals-ignore-ascii-case(coding) continue
      for p in params.drop(1) {
        let param = p.trim-ascii-space()
        if param.starts-with("q=") or param.starts-with("Q=") {
          return param.drop(2).exists(fn c. c != '0' and c != '.')
        }
      }
      return true
    }
    false
  }

  fn join-body-chunks(self: request): span[u8] {
    if self.body.len() == 1 return self.body.[0]
    let joined = list/empty[u8]()
    for chunk in self.body { joined.append-span(chunk) }
    joined.as-span()
  }

  fn form(self: request): ?span[pair] {
    require self.header.find("Content-Type") is :some ct else { return :none }
    if not ct.starts-with("application/x-www-form-urlencoded") return :none
    :some url/form/parse-chunks(self.body).as-span()
  }

  fn cookies(self: request): span[pair] {
    if self.header.find("Cookie") is {
      :some h -> cookie/parse(h).as-span(),
      :none -> span/empty(),
    }
  }
}
