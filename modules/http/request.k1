type pair = { name: string, value: string }

ns pairs {
  fn find-by-name(pairs: span[pair], name: string): ?string {
    for p in pairs { if p.name == name { return :some p.value } }
    :none
  }
}

ns percent {
  fn decode(s: string, plus-is-space: bool): ?string {
    if (not s.contains('%')) and (not (plus-is-space and s.contains('+'))) return :some s
    let b = string-builder/new()
    let i: size = 0
    while i < s.len() {
      let c = s.[i]
      if c == '%' {
        if i + 2 >= s.len() return :none
        require s.[i + 1].to-ascii-hex-digit() is :some hi else { return :none }
        require s.[i + 2].to-ascii-hex-digit() is :some lo else { return :none }
        b.write-char((hi * 16 + lo).as-char())
        i = i + 3
      } else {
        b.write-char(if plus-is-space and c == '+' ' ' else c)
        i = i + 1
      }
    }
    :some b.build()
  }

  fn is-unreserved(c: char): bool {
    c.is-ascii-letter() or c.is-ascii-digit() or c == '-' or c == '.' or c == '_' or c == '~'
  }

  fn hex-digit(v: u8): char { "0123456789ABCDEF".[v.widen[size]] }

  fn encode-into[w: writer](s: string, w, keep-slash: bool) {
    for c in s {
      if is-unreserved(c) or (keep-slash and c == '/') {
        w.write-char(c)
      } else {
        let b = c.u8()
        w.write-char('%')
        w.write-char(hex-digit(b / 16))
        w.write-char(hex-digit(b % 16))
      }
    }
  }

  fn encode(s: string): string {
    let b = string-builder/new()
    encode-into(s, b.&, keep-slash = false)
    b.build()
  }
}

ns urlencoded {
  fn push-field(out: *list[pair], straddling: *string-builder, piece: string) {
    let field = if straddling.list.is-empty() piece else {
      straddling.write(piece)
      let joined = straddling.build()
      straddling.reset()
      joined
    }
    if field.is-empty() return
    let eq = field.index-of('=')
    let raw-name = if eq is :some i field.take(i) else field
    let raw-value = if eq is :some i field.drop(i + 1) else ""
    out.push(.{
      name = percent/decode(raw-name, plus-is-space = true) ? raw-name,
      value = percent/decode(raw-value, plus-is-space = true) ? raw-value,
    })
  }

  fn parse-chunks(chunks: span[span[u8]]): list[pair] {
    let out = list/empty[pair]()
    let straddling = string-builder/new()
    for chunk in chunks {
      let rest = string/wrap-bytes(chunk)
      while rest.index-of('&') is :some i {
        push-field(out.&, straddling.&, rest.take(i))
        rest = rest.drop(i + 1)
      }
      if it-index + 1 == chunks.len() push-field(out.&, straddling.&, rest)
      else straddling.write(rest)
    }
    out
  }

  fn parse(s: string): list[pair] { parse-chunks(span/single(s.span-bytes())) }
}

ns cookie {
  fn parse(header: string): list[pair] {
    let out = list/empty[pair]()
    for part in header.split-by-char(';') {
      let field = part.trim-ascii-space()
      if field.index-of('=') is :some i {
        let raw = field.drop(i + 1)
        out.push(.{ name = field.take(i), value = percent/decode(raw, plus-is-space = false) ? raw })
      }
    }
    out
  }

  type attrs = {
    path: string,
    max-age: ?u64,
    http-only: bool,
    secure: bool,
    same-site: either { lax, strict, none },
  }
  ns for attrs {
    fn default(): attrs { .{ path = "/", max-age = :none, http-only = true, secure = false, same-site = :lax } }
  }

  fn set-header(name: string, value: string, attrs: attrs): string {
    let out = string-builder/new()
    out.write("Set-Cookie: $name=${percent/encode(value)}; Path=${attrs.path}")
    if attrs.max-age is :some n { out.write("; Max-Age=$n") }
    if attrs.http-only { out.write("; HttpOnly") }
    if attrs.secure { out.write("; Secure") }
    out.write(if attrs.same-site is { :lax -> "; SameSite=Lax", :strict -> "; SameSite=Strict", :none -> "; SameSite=None" })
    out.build()
  }
}

ns for request {
  fn query(self: request): span[pair] {
    if self.header.url.index-of('?') is {
      :some i -> urlencoded/parse(self.header.url.drop(i + 1)).as-span(),
      :none -> span/empty(),
    }
  }

  fn join-body-chunks(self: request): span[u8] {
    if self.body.len() == 1 return self.body.[0]
    let joined = list/empty[u8]()
    for chunk in self.body { joined.append-span(chunk) }
    joined.as-span()
  }

  fn form(self: request): ?span[pair] {
    require self.header.find("Content-Type") is :some ct else { return :none }
    if not ct.starts-with("application/x-www-form-urlencoded") return :none
    :some urlencoded/parse-chunks(self.body).as-span()
  }

  fn cookies(self: request): span[pair] {
    if self.header.find("Cookie") is {
      :some h -> cookie/parse(h).as-span(),
      :none -> span/empty(),
    }
  }
}
