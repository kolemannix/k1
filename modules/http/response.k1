use std/source
use std/pipe
use std/byte-source

type http-response = {
  content-type: string,
  extra-headers: span[string],
  body: either { complete(span[span[u8]]), stream(byte-source) },
  status: u16,
}

ns response {
  fn complete(status: u16, content-type: string, body: string): http-response {
    .{ content-type, extra-headers = [], body = :complete span/single(body.span-bytes()), status }
  }
  fn html(body: string): http-response { complete(200, "text/html", body) }
  fn not-found(): http-response { complete(404, "text/plain", "Not Found\n") }
  fn text(status: u16, body: string): http-response { complete(status, "text/plain", body) }
  fn method-not-allowed(allowed: span[string]): http-response {
    let allow = string-builder/new()
    allow.write("Allow: ")
    for m in allowed { if it-index > 0 { allow.write(", ") }; allow.write(m) }
    .{
      content-type = "text/plain",
      extra-headers = span/single(allow.build()),
      body = :complete span/single("Method Not Allowed\n".span-bytes()),
      status = 405,
    }
  }
  fn stream(content-type: string, source: byte-source): http-response {
    .{ content-type, extra-headers = [], body = :stream source, status = 200 }
  }
  fn no-content(): http-response {
    .0 | .{ status = 204 }
  }
  fn redirect(status: u16, location: string, extra-headers: span[string]): http-response {
    let headers: list[string] = list/with-capacity(extra-headers.len() + 1)
    headers.push("Location: $location")
    headers.append-span(extra-headers)
    .{ content-type = "", extra-headers = headers.as-span(), body = :complete span/empty(), status }
  }

  fn status-text(status: u16): string {
    if status is {
      100 -> "Continue",
      101 -> "Switching Protocols",
      103 -> "Early Hints",
      200 -> "OK",
      201 -> "Created",
      202 -> "Accepted",
      203 -> "Non-Authoritative Information",
      204 -> "No Content",
      205 -> "Reset Content",
      206 -> "Partial Content",
      300 -> "Multiple Choices",
      301 -> "Moved Permanently",
      302 -> "Found",
      303 -> "See Other",
      304 -> "Not Modified",
      307 -> "Temporary Redirect",
      308 -> "Permanent Redirect",
      400 -> "Bad Request",
      401 -> "Unauthorized",
      402 -> "Payment Required",
      403 -> "Forbidden",
      404 -> "Not Found",
      405 -> "Method Not Allowed",
      406 -> "Not Acceptable",
      407 -> "Proxy Authentication Required",
      408 -> "Request Timeout",
      409 -> "Conflict",
      410 -> "Gone",
      411 -> "Length Required",
      412 -> "Precondition Failed",
      413 -> "Content Too Large",
      414 -> "URI Too Long",
      415 -> "Unsupported Media Type",
      416 -> "Range Not Satisfiable",
      417 -> "Expectation Failed",
      421 -> "Misdirected Request",
      422 -> "Unprocessable Content",
      426 -> "Upgrade Required",
      428 -> "Precondition Required",
      429 -> "Too Many Requests",
      431 -> "Request Header Fields Too Large",
      451 -> "Unavailable For Legal Reasons",
      500 -> "Internal Server Error",
      501 -> "Not Implemented",
      502 -> "Bad Gateway",
      503 -> "Service Unavailable",
      504 -> "Gateway Timeout",
      505 -> "HTTP Version Not Supported",
      _ -> "",
    }
  }

  fn may-have-content(status: u16): bool { status >= 200 and status != 204 and status != 304 }
}

// zero-copy chunked transfer framing
// wraps each upstream group in a hex-size prefix
// and CRLF trailer without touching the payload segments, then emits the
// terminal "0\r\n\r\n".
type chunked-encoder = { prefix: list[u8] }

fn chunked(upstream: byte-source): byte-source {
  let stage: chunked-encoder = .{ prefix = list/empty() }
  source/through(upstream, stage)
}

let rn: span[u8] = "\r\n".span-bytes()
impl pipe[t = u8, out = u8] for chunked-encoder {
  fn map(self: *chunked-encoder, group: span[span[u8]], out: *list[span[u8]]) {
    let total: size = 0
    for seg in group { total = total + seg.len() }
    if total == 0 { return }
    core/format-uint(context self.prefix.&)(total.unsigned(), 16)
    self.prefix.append-span(rn)
    out.push(self.prefix.as-span())
    for seg in group { out.push(seg) }
    out.push(rn)
  }
  fn finish(_self: *chunked-encoder, out: *list[span[u8]]) { out.push(#static "0\r\n\r\n".span-bytes()) }
  fn retire(self: *chunked-encoder) { self.prefix.clear() }
}
