use core/arena
use std/url
use uv/libuv
use uv/libuv/uv-loop
use uv/req
use uv/handle
use uv/stream

let params: { tlog: bool } = k1/module-params(.{ tlog = false })

type header = {
  url: url/url,
  headers: list[{ field: string, value: string }],
  method: llhttp/method,
  keep-alive: bool,
  content-length: ?size
}

ns for header {
  fn get(target: string): header { make(:GET, target) }
  fn post(target: string): header { make(:POST, target) }
  fn make(method: llhttp/method, target: string): header {
    .{
      url = url/parse(target).!,
      headers = list/empty(),
      method,
      keep-alive = true,
      content-length = :none,
    }
  }
  fn find(self: header, name: string): ?string {
    for h in self.headers { if h.field.equals-ignore-ascii-case(name) { return :some h.value } }
    :none
  }
}

type parse-state = {
  user-data: ptr,
  *arena,
  on-header-complete: *fn(ptr, header) -> {},
  on-body-complete: *fn(ptr, span[span[byte]]) -> {},
  max-body-size: size,
  body-size: size,
  reject: ?u16,
  url: list[char],
  current-header-field: list[char],
  current-header-value: list[char],
  headers: list[{ field: string, value: string }],
  body-chunks: list[span[u8]],
}
ns for parse-state {
  fn empty[t](arena: *arena, user-data: *t, on-header-complete: *fn(ptr, header) -> {}, on-body-complete: *fn(ptr, span[span[byte]]) -> {}, max-body-size: size): parse-state {
    .{
      user-data = user-data.as[ptr],
      arena,
      on-header-complete,
      on-body-complete,
      max-body-size,
      body-size = 0,
      reject = :none,
      url = list/empty(),
      current-header-field = list/empty(),
      current-header-value = list/empty(),
      headers = list/empty(),
      body-chunks = list/empty(),
    }
  }

  fn reset(self: *parse-state) {
    let user-data = self.user-data
    let arena = self.arena
    let on-header-complete = self.on-header-complete
    let on-body-complete = self.on-body-complete
    self.* = empty[empty](arena, user-data.ref[empty], on-header-complete, on-body-complete, self.max-body-size)
  }


}

// Wraps a pointer to an llhttp_t with some stronger-ish typing
// over our particular user-data, 'parse-state'
type parser = { parser: llhttp/t }
ns for parser {
  fn data(self: *parser): *parse-state { self.parser.data.ref[parse-state] }
  fn set-data(self: *parser, data: *parse-state) { self.parser.data = data.as[ptr] }

  fn reset(self: *parser) {
    self.data().reset()

    // Reset an already initialized parser back to the start state, preserving the existing parser type, callback settings, user data, and lenient flags.
    llhttp/reset(self.parser.&)
  }
}

// a fully parsed request
type request = {
  header,
  body: span[span[u8]],
}

fn on-url-part(parser: *parser, data: *u8, count: usize): i32 {
  let state = parser.data()
  let bytes: span[char] = span/wrap-raw(data.as[ptr], count.signed())
  let a = state.arena
  if state.url.is-empty() { state.url.reserve-in(a, 1024) }
  state.url.append-span-in(a, bytes)
  if state.url.len() > 16384 {
    return llhttp/errno:HPE_USER.value.signed()
  }
  0
}

fn on-header-field(parser: *parser, data: *u8, count: usize): i32 {
  let state = parser.data()
  let a = state.arena
  let bytes: span[char] = span/wrap-raw(data.as[ptr], count.signed())

  if state.current-header-field.is-empty() { state.current-header-field.reserve-in(a, 256) }
  state.current-header-field.append-span-in(a, bytes)
  0
}
fn on-header-field-complete(parser: *parser): i32 {
  let _state = parser.data()
  0
}
fn on-header-value(parser: *parser, data: *u8, count: usize): i32 {
  let state = parser.data()
  let a = state.arena
  let bytes: span[char] = span/wrap-raw(data.as[ptr], count.signed())

  if state.current-header-value.is-empty() { state.current-header-value.reserve-in(a, 256) }
  state.current-header-value.append-span-in(a, bytes)
  0
}
fn on-header-value-complete(parser: *parser): i32 {
  let state = parser.data()
  let a = state.arena
  let field-string = string/wrap-span(state.current-header-field.as-span().cloned-in(a))
  let value-string = string/wrap-span(state.current-header-value.as-span().cloned-in(a))

  state.headers.reserve-in(a, 64)
  let header = .{
    field = field-string,
    value = value-string,
  }
  state.headers.push-in(a, header)
  state.current-header-field.clear()
  state.current-header-value.clear()

  0
}

fn on-headers-complete(parser: *parser): i32 {
  let state = parser.data()
  require url/parse(string/wrap-span(state.url.as-span())) is :ok url else {
    state.reject = :some 400
    return llhttp/errno:HPE_PAUSED.value.signed()
  }

  let keep-alive = llhttp/should_keep_alive(parser.parser.&).as-bool()
  let content-length: ?size = if parser.parser.flags.widen[u32] & llhttp/flags:F_CONTENT_LENGTH.value != 0 {
    :some parser.parser.content_length.signed()
  } else :none
  let header: header = .{
    url,
    headers = state.headers,
    method = mem/bitcast(llhttp/get_method(parser.as()).widen[u32]),
    keep-alive,
    content-length,
  }
  (state.on-header-complete)(state.user-data, header)
  if content-length is :some n and n > state.max-body-size {
    state.reject = :some 413
    return llhttp/errno:HPE_PAUSED.value.signed()
  }
  0
}

fn impl-on-body(parser: *parser, data: *u8, count: usize): i32 {
  let state = parser.data()
  let a = state.arena
  state.body-size = state.body-size + count.signed()
  if state.body-size > state.max-body-size {
    state.reject = :some 413
    return llhttp/errno:HPE_PAUSED.value.signed()
  }
  let bytes: span[byte] = span/wrap-raw(data.as[ptr], count.signed())
  // FIXME: streamed request bodies — hand chunks to the handler as they
  // arrive instead of buffering the whole body
  state.body-chunks.push-in(a, bytes)
  0
}
fn impl-on-body-complete(parser: *parser): i32 {
  let state = parser.data()
  (state.on-body-complete)(state.user-data, state.body-chunks.as-span())
  // Pause at every message boundary: one request in flight per connection.
  // finish-request resets the parser and restarts reads
  llhttp/errno:HPE_PAUSED.value.signed()
}

fn parser-init[user-data](
  state-arena: *arena,
  request-arena: *arena,
  *user-data,
  on-header-complete: *fn(*user-data, header) -> {},
  on-body-complete: *fn(*user-data, span[span[u8]]) -> {},
  max-body-size: size,
): parser {
  let settings: llhttp/settings = uninit
  llhttp/settings_init(settings.&)
  let settings = state-arena.push(settings | .{
    on_method                = fn(_p, _, _) 0,
    on_url                   = on-url-part.&.as(),
    on_url_complete          = fn(_) 0,
    on_header_field          = on-header-field.&.as(),
    on_header_field_complete = on-header-field-complete.&.as(),
    on_header_value          = on-header-value.&.as(),
    on_header_value_complete = on-header-value-complete.&.as(),
    on_headers_complete      = on-headers-complete.&.as(),
    on_body                  = impl-on-body.&.as(),
    on_message_complete      = impl-on-body-complete.&.as(),
  })

  let parser: parser = uninit
  llhttp/init(parser.&.as(), :REQUEST, settings)
  let parse-state: *parse-state = state-arena.push(
    parse-state/empty(request-arena, user-data, on-header-complete.narrow(), on-body-complete.narrow(), max-body-size)
  )
  parser.set-data(parse-state)
  parser
}

type tick-result = either { ok, paused(size), reject(u16), fail(llhttp/errno) }

// Feed bytes to the parser. :paused means llhttp stopped at a message
// boundary; its payload counts the bytes left unparsed, nonzero only when a
// client pipelines requests. :reject carries the status to answer with: 400
// for a request target that isn't a URL, 413 when the body passed max-body-size
fn tick(
  *parser,
  bytes: span[u8],
): tick-result {
  let result = llhttp/execute(
    parser = parser.parser.&,
    data   = mem/bitcast[ptr, *u8](bytes.data-ptr()),
    len    = bytes.len().unsigned()
  )
  if result is {
    :HPE_OK -> :ok,
    :HPE_PAUSED -> {
      if parser.data().reject is :some status return :reject status
      let end = bytes.data-ptr().add-bytes(bytes.len())
      :paused end.diff(llhttp/get_error_pos(parser.parser.&).inner)
    },
    _ -> :fail result
  }
}
