use core/arena
use uv/libuv
use uv/libuv/uv-loop
use uv/req
use uv/handle
use uv/stream
use std/source
use std/pull
use std/byte-source
use std/pool
use std/posix

type server = {
  server/config,
  *uv-loop,
  listener: libuv/tcp,
  sigint: libuv/signal,
  sigterm: libuv/signal,
  drain-timer: libuv/timer,
  scratch: *arena,
  scratch-prepare: libuv/prepare,
  port: u16,
  handler: dyn[fn(http/request) -> http-response],
  connections: pool[server/connection],
  draining: bool,
  conn-serial: u64,
}

ns for server {

type config = {
  host: string,
  port: u16,
  accept-queue-len: i32,
  max-connections: size,
  max-body-size: size,
  header-timeout-ms: u64,
  body-timeout-ms: u64,
  write-timeout-ms: u64,
  idle-timeout-ms: u64,
  drain-timeout-ms: u64,
  handle-signals: bool,
}

fn start(
  config: config,
  handler: dyn[fn(http/request) -> http-response]
): result[*server, libuv/errno] {
  let l = libuv/default_loop().get()
  libuv/thread_setname("mainthread\0".data-ref-byte())
  work/init-work-queue(l)
  let scratch = core/arena/init(8 * core/arena/mb)
  scratch.set-name("loop-scratch")

  let s: *server = heap.new(.{
    config,
    uv-loop = l,
    listener = uninit,
    sigint = uninit,
    sigterm = uninit,
    drain-timer = uninit,
    scratch,
    scratch-prepare = uninit,
    port = config.port,
    handler,
    connections = pool/with-capacity-in[connection, _](heap, config.max-connections),
    draining = false,
    conn-serial = 0,
  })

  uv/check(libuv/tcp_init(l, s.listener.&)).try
  s.listener.&.set-data(s)

  let addr: libuv/sockaddr_in = uninit
  uv/check(libuv/ip4_addr(config.host.to-c().ptr.ref[u8], config.port.widen[i32], addr.&)).try
  uv/check(libuv/tcp_bind(s.listener.&, addr.&.as[ptr].narrow(), 0)).try
  uv/check(libuv/listen(s.listener.&.as-stream(), config.accept-queue-len, on-new-connection.&)).try

  let bound: libuv/sockaddr_in = uninit
  let bound-len: i32 = types/size[libuv/sockaddr_in].trunc[i32]
  if libuv/tcp_getsockname(s.listener.&, bound.&.as[ptr].narrow(), bound-len.&) == 0 {
    s.port = ((bound.sin_port & 0xff) << 8) | (bound.sin_port >> 8)
  }

  uv/check(libuv/prepare_init(l, s.scratch-prepare.&)).!
  s.scratch-prepare.&.set-data(s)
  uv/check(libuv/prepare_start(s.scratch-prepare.&, fn p. p.get-data[server]().scratch.reset())).!
  libuv/unref(s.scratch-prepare.&.as-handle())

  if config.handle-signals {
    s.install-signal(s.sigint.&, posix/SIGINT)
    s.install-signal(s.sigterm.&, posix/SIGTERM)
  }
  :ok s
}

fn install-signal(*self, handle: *libuv/signal, signum: i32) {
  uv/check(libuv/signal_init(self.uv-loop, handle)).!
  handle.set-data(self)
  uv/check(libuv/signal_start(handle, fn(h, _signum) { h.get-data[server]().stop() }, signum)).!
}

fn run(*self) {
  let outer-tmp = mem/tmp()
  mem/set-tmp-arena(self.scratch)
  libuv/run(self.uv-loop, :UV_RUN_DEFAULT)
  mem/set-tmp-arena(outer-tmp)
  self.scratch.release()
}

fn stop(*self) {
  if self.draining return
  self.draining = true
  tprintln("server stopping; draining ${self.connections.len()} connections")
  libuv/close(self.listener.&.as-handle(), fn _h. .{})
  libuv/close(self.scratch-prepare.&.as-handle(), fn _h. .{})
  if self.config.handle-signals {
    libuv/close(self.sigint.&.as-handle(), fn _h. .{})
    libuv/close(self.sigterm.&.as-handle(), fn _h. .{})
  }
  if self.connections.is-empty() return

  for self.connections.& {
    let conn = self.connections.get(it)
    if conn.phase is {
      :idle or :header or :body or :parked -> conn.close(),
      :handling or :writing or :closing -> .{},
    }
  }
  uv/check(libuv/timer_init(self.uv-loop, self.drain-timer.&)).!
  self.drain-timer.&.set-data(self)
  self.drain-timer.&.start(fn t. {
    let s = t.get-data[server]()
    tprintln("drain deadline passed; closing ${s.connections.len()} connections")
    for s.connections.& { s.connections.get(it).close() }
    libuv/close(t.as-handle(), fn _h. .{})
  }, self.config.drain-timeout-ms, 0)
}

type phase = either { header, body, handling, writing, parked, idle, closing }

type connection = {
  *server,
  client-storage: libuv/tcp,
  timer-storage: libuv/timer,
  write-storage: libuv/write,
  work-storage: libuv/work,
  serial-no: u64,
  slot: pool/handle[connection],
  pending-closes: u32,
  phase: phase,

  request-arena: *arena,
  request-start: core/arena-mark,
  request-parser: http/parser,

  active-stream: ?byte-source,
  parsed-header: ?http/header,
}

ns for connection {
  fn make(s: *server): *connection {
    let request-arena: *arena = core/arena/init(8 * core/arena/mb)
    request-arena.set-name("request")
    s.conn-serial = s.conn-serial + 1
    let slot = s.connections.acquire(.{
      server = s,
      client-storage = uninit,
      timer-storage = uninit,
      write-storage = uninit,
      work-storage = uninit,
      serial-no = s.conn-serial,
      slot = .0,
      pending-closes = 0,
      phase = :header,

      request-arena,
      request-start = .0,
      active-stream = :none,
      request-parser = uninit,
      parsed-header = :none,
    })
    let conn = s.connections.get(slot)
    conn.slot = slot
    conn.request-parser = http/parser-init[connection](
      state-arena = request-arena,
      request-arena = request-arena,
      user-data = conn,
      on-header-complete = on-complete-http-header.&,
      on-body-complete = on-complete-http-body.&,
      max-body-size = s.config.max-body-size,
    )
    conn.request-start = request-arena.mark()

    uv/check(libuv/tcp_init(s.uv-loop, conn.client())).!
    conn.client().set-data(conn)
    libuv/tcp_nodelay(conn.client(), 1)

    uv/check(libuv/timer_init(s.uv-loop, conn.timer())).!
    conn.timer().set-data(conn)
    conn.write-req().set-data(conn)
    conn
  }

  fn release(*self) {
    let s = self.server
    self.request-arena.release()
    s.connections.release(self.slot)
    tprintln("conn${self.serial-no} released; active connections: ${s.connections.len()}")
    if s.draining and s.connections.is-empty() and libuv/is_active(s.drain-timer.&.as-handle()).as-bool() {
      s.drain-timer.&.stop()
      libuv/close(s.drain-timer.&.as-handle(), fn _h. .{})
    }
  }

  fn finish-request(*self) {
    self.stop-stream()
    if self.server.draining or not (self.parsed-header is :some h and h.keep-alive) {
      self.close()
      return
    }
    self.parsed-header = :none
    self.request-arena.pop-to-mark(self.request-start)
    self.request-parser.reset()
    self.enter-phase(:idle)
    self.client().read-stop()
    if self.client().read-start(alloc-read-buffer.&, on-client-read.&) is :err e {
      tprintln("read restart error: $e")
      self.close()
    }
  }

  fn enter-phase(*self, phase) {
    core/assert(not (self.phase is :closing))
    self.phase = phase
    let c = self.server.config
    let deadline-ms = if phase is {
      :header -> c.header-timeout-ms,
      :body -> c.body-timeout-ms,
      :writing -> c.write-timeout-ms,
      :idle -> c.idle-timeout-ms,
      :handling or :parked or :closing -> 0,
    }
    if deadline-ms == 0 self.timer().stop() else self.timer().start(on-timeout.&, deadline-ms, 0)
  }

  fn close(*self) {
    if self.phase is :closing { return }
    let handling = self.phase is :handling
    self.enter-phase(:closing)
    tprintln("conn${self.serial-no} closing")
    self.stop-stream()
    if handling {
      if uv/check(libuv/cancel(self.work-req().as-req())) is :err e { tprintln("handler already running: $e") }
      return
    }
    self.close-handles()
  }

  fn close-handles(*self) {
    self.pending-closes = 2
    libuv/close(self.client().as-handle(), on-handle-closed.&)
    libuv/close(self.timer().as-handle(), on-handle-closed.&)
  }

  fn stop-stream(*self) {
    if self.active-stream is :some s {
      self.active-stream = :none
      s.stop()
    }
  }

  fn begin-response(*self, resp: http-response) {
    mem/push-arena(self.request-arena)
    defer { mem/pop-arena() }
    let out = string-builder/with-capacity(1024)
    out.write("HTTP/1.1 ${resp.status} ${response/status-text(resp.status)}\r\n")
    if resp.content-type.non-empty() out.write("Content-Type: ${resp.content-type}\r\n")
    for h in resp.extra-headers { out.write("$h\r\n") }
    let body = if resp.body is {
      :complete segments -> {
        if response/may-have-content(resp.status) {
          let total: size = 0
          for seg in segments { total = total + seg.len() }
          out.write("Content-Length: $total\r\n")
        }
        out.write("\r\n")
        source/once(segments)
      },
      :stream source -> {
        out.write("Transfer-Encoding: chunked\r\n\r\n")
        source || chunked
      },
    }
    let headers = out.take()

    self.active-stream = :some body
    body.start(.{ state = self.as[ptr], wake-fn = on-wake.& })

    let group = if body.pull() is {
      :chunk group -> group,
      :pending or :done -> span/empty(),
      :fail message -> {
        tprintln("stream failed on first pull: $message")
        self.close()
        return
      },
    }
    let first = list/with-capacity[span[u8]](group.len() + 1)
    first.push(headers.span-bytes())
    first.append-span(group)
    self.write-group(first.as-span())
    if resp.body is :stream _ and not (self.phase is :closing) {
      if self.client().read-start(alloc-read-buffer.&, on-hangup-read.&) is :err e {
        tprintln("hangup watch error: $e")
        self.close()
      }
    }
  }

  fn write-group(*self, group: span[span[u8]]) {
    self.enter-phase(:writing)
    if self.client().write(self.write-req(), group, on-write-complete.&) is :err e {
      tprintln("response write failed: $e")
      self.close()
    }
  }

  fn pump(*self) {
    mem/push-arena(self.request-arena)
    defer { mem/pop-arena() }
    if self.active-stream.!.pull() is {
      :chunk group -> self.write-group(group),
      :pending -> self.enter-phase(:parked),
      :done -> self.finish-request(),
      :fail message -> {
        tprintln("stream failed: $message")
        self.close()
      },
    }
  }

  fn client(*self): *libuv/tcp { self.client-storage.& }
  fn timer(*self): *libuv/timer { self.timer-storage.& }
  fn write-req(*self): *libuv/write { self.write-storage.& }
  fn work-req(*self): *libuv/work { self.work-storage.& }
}

fn on-write-complete(req: *libuv/write, status: i32) {
  let connection = req.get-data[connection]()
  if connection.phase is :closing { return }
  if status != 0 {
    tprintln("response write failed: ${libuv/errno/from-i32(status).enum-name()}")
    connection.close()
    return
  }
  connection.pump()
}

fn on-wake(state: ptr) {
  let connection = state.ref[connection]()
  if connection.phase is :parked { connection.pump() }
}

fn on-timeout(t: *libuv/timer) {
  let conn = t.get-data[connection]()
  tprintln("conn${conn.serial-no} timed out")
  conn.close()
}

fn on-handle-closed(h: *libuv/handle) {
  let conn = h.get-data[connection]()
  conn.pending-closes = conn.pending-closes - 1
  if conn.pending-closes == 0 { conn.release() }
}

type http-handler-work = {
  *connection,
  request: http/request,
  ?http-response,
}

let(mutable, tls) worker-scratch: ptr = ptr/null

fn reset-worker-scratch() {
  if worker-scratch.is-null() {
    let scratch = core/arena/init(8 * core/arena/mb)
    scratch.set-name("worker-scratch")
    worker-scratch = scratch.as[ptr]
    mem/set-tmp-arena(scratch)
  }
  worker-scratch.ref[arena].reset()
}

fn do-work(req: *libuv/work) {
  let work: *http-handler-work = req.get-data()
  reset-worker-scratch()
  work.http-response = :some mem/with-arena(
    work.connection.request-arena,
    (work.connection.server.handler)(work.request)
  )
}

fn after-do-work(req: *libuv/work, _status: i32) {
  let work: *http-handler-work = req.get-data()
  let connection = work.connection
  if connection.phase is :closing {
    if work.http-response is :some response and response.body is :stream s { s.stop() }
    connection.close-handles()
    return
  }
  connection.begin-response(work.http-response.!)
}

fn alloc-read-buffer(handle: *libuv/handle, suggested-size: usize, buf: *libuv/buf) {
  let connection = handle.get-data[connection]()
  let byte-buffer = connection.request-arena.alloc-buffer[u8](suggested-size.signed())
  buf.* = libuv/buf/wrap-buffer(byte-buffer)
}

fn on-client-read(client: *libuv/stream, nread: size, buf: *libuv/buf) {
  if nread == 0 return
  let connection = client.get-data[connection]()
  if nread < 0 {
    tprintln("conn${connection.serial-no} read ended: ${libuv/errno/from-i32(nread.trunc[i32]).enum-name()}")
    connection.close()
    return
  }
  if connection.phase is :idle { connection.enter-phase(:header) }
  if http/tick(connection.request-parser.&, span/wrap-raw[byte](buf.base.inner, nread)) is {
    :ok -> .{},
    :paused leftover -> {
      if leftover > 0 {
        tprintln("client pipelined $leftover unparsed bytes; closing after response")
        if connection.parsed-header is :some h {
          connection.parsed-header = :some (h | .{ keep-alive = false })
        }
      }
    },
    :reject status -> {
      tprintln("conn${connection.serial-no} rejected with $status; closing after response")
      if connection.parsed-header is :some h {
        connection.parsed-header = :some (h | .{ keep-alive = false })
      }
      connection.client().read-stop()
      connection.begin-response(response/text(status, "${response/status-text(status)}\n"))
    },
    :fail e -> {
      tprintln("http parse error ${e.enum-name()}; closing connection")
      connection.close()
    },
  }
}

fn on-hangup-read(client: *libuv/stream, nread: size, _buf: *libuv/buf) {
  if nread == 0 return
  let connection = client.get-data[connection]()
  if nread > 0 tprintln("client sent $nread bytes during a streamed response; closing")
  connection.close()
}

fn on-complete-http-header(connection: *connection, header: http/header) {
  connection.parsed-header = :some header
  connection.enter-phase(:body)
}

fn on-complete-http-body(connection: *connection, chunks: span[span[u8]]) {
  let work: *http-handler-work = connection.request-arena.push(.{
    connection,
    request = .{ header = connection.parsed-header.get(), body = chunks },
    http-response = :none,
  })
  connection.work-req().set-data(work)
  connection.client().read-stop()
  uv/check(libuv/queue_work(connection.server.uv-loop, connection.work-req(), do-work.&, after-do-work.&)).!
  connection.enter-phase(:handling)
}

fn on-new-connection(listener: *libuv/stream, status: i32) {
  if status < 0 {
    tprintln("new connection error: ${libuv/errno/from-i32(status)}")
    return
  }
  let s = listener.as-handle().get-data[server]()
  if s.connections.is-full() {
    let client: *libuv/tcp = heap.alloc-t()
    uv/check(libuv/tcp_init(s.uv-loop, client)).!
    if uv/check(libuv/accept(listener, client.as-stream())) is :err e {
      tprintln("accept error while rejecting: $e")
    } else {
      tprintln("at ${s.connections.capacity()} connections; rejecting")
      let response = "HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
      let buf = libuv/buf/wrap-span(response.span-bytes())
      let written = libuv/try_write(client.as-stream(), buf.&, 1)
      if written < 0 { tprintln("503 write failed: ${libuv/errno/from-i32(written)}") }
    }
    libuv/close(client.as-handle(), fn closed. heap.free-t(closed.as[ptr].ref[libuv/tcp]))
    return
  }
  let connection = connection/make(s)
  let client = connection.client()

  if uv/check(libuv/accept(listener, client.as-stream())) is :err e {
    tprintln("accept error: $e")
    connection.close()
    return
  }
  libuv/tcp_keepalive_ex(client, 1, idle = 60, intvl = 10, cnt = 3)
  connection.enter-phase(:header)
  if client.read-start(alloc-read-buffer.&, on-client-read.&) is :err e {
    tprintln("read start error: $e")
    connection.close()
  }
}

}

macro tprintln(arg: code) {
  if params.tlog `tprintln-log($arg)` else `.{}`
}
fn tprintln-log[t: print](t) {
  let thread-self = libuv/thread_self()
  let thread-name-buf = array/zeroed[u8, 256]()
  let _rc = libuv/thread_getname(thread-self.&, thread-name-buf.data-ref(), thread-name-buf.len().unsigned())
  let thread-name = string/wrap-c(thread-name-buf.data-ptr())
  eprintln("[$thread-name] $t")
}
