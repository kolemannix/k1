ns routing {

use core/meta/str-lit

type field = { name: string, ty: code }

type seg = either { text(string), capture(field), rest(string) }

type entry = {
  method: string,
  name: code-token,
  pattern: string,
  pattern-tok: code-token,
  path: list[seg],
  query: ?code,
}

fn check-ident(at: code-token, s: string, what: string) {
  if s.is-empty() at.fail("Empty $what")
  if not s.[0].is-ascii-letter() at.fail("The $what `$s` must start with a letter")
  for c in s {
    if not (c.is-ascii-letter() or c.is-ascii-digit() or c == '-') {
      at.fail("The $what `$s` is not a valid identifier")
    }
  }
}

fn parse-pattern(tok: code-token, pat: string): list[seg] {
  if pat.is-empty() or pat.[0] != '/' tok.fail("A route pattern starts with `/`")
  let segs = list/empty[seg]()
  if pat == "/" return segs
  let rest = pat.drop(1)
  loop {
    if rest.starts-with("{") {
      require rest.index-of('}') is :some close else tok.fail("Unclosed `{` in `$pat`")
      let inner = rest.slice(1, close)
      require inner.index-of(':') is :some colon else tok.fail("Expected `{name: type}`, got `{${inner}}`")
      let name = inner.take(colon).trim-ascii-space()
      let ty = inner.drop(colon + 1).trim-ascii-space()
      check-ident(tok, name, "param name")
      if ty.is-empty() tok.fail("Param `$name` needs a type")
      let ty-code = code-builder/new()
      ty-code.write-spanned(ty, tok.source)
      segs.push(:capture .{ name, ty = ty-code.build() })
      rest = rest.drop(close + 1)
      if rest.non-empty() and rest.[0] != '/' tok.fail("Expected `/` after `{${inner}}`")
    } else {
      let piece = rest.take(rest.index-of('/') ? rest.len())
      rest = rest.drop(piece.len())
      if piece.starts-with("*") {
        check-ident(tok, piece.drop(1), "param name")
        if rest.non-empty() tok.fail("The rest capture `$piece` must be the last segment")
        segs.push(:rest piece.drop(1))
      } else {
        if piece.is-empty() tok.fail("Empty segment in `$pat`")
        for c in piece {
          if not std/url/percent/encode-set:unreserved.keeps(c) {
            tok.fail("The literal segment `$piece` may only hold letters, digits and `-._~`")
          }
        }
        segs.push(:text piece)
      }
    }
    if rest.is-empty() break
    rest = rest.drop(1)
  }
  if segs.len() > 16 tok.fail("A route pattern is at most 16 segments deep")
  segs
}

fn parse-rows(rows: span[code-token]): list[entry] {
  if rows.is-empty() crash("routing: no routes given")
  let rd = token-cursor/new(rows)
  let entries = list/empty[entry]()
  while not rd.is-at-end() {
    let m = rd.expect-ident()
    if not ["get", "head", "post", "put", "delete", "patch", "options"].contains(m.text) {
      m.fail("Expected a method (get, head, post, put, delete, patch, options), got `${m.text}`")
    }
    let name = rd.expect-ident()
    check-ident(name, name.text, "route name")
    let pat = rd.eat()
    if (not (pat.kind is :string)) or pat.text.contains('$') or pat.text.contains('\\') {
      pat.fail("Expected a plain pattern string like \"/game/{id: u64}/poke\", got `${pat.text}`")
    }
    let pattern = pat.text.slice(1, pat.text.len() - 1)
    let path = parse-pattern(pat, pattern)
    let query: ?code = if rd.eat-if-text-eq("?") {
      let open = rd.expect("{")
      let toks = rd.eat-until-close(open, "}")
      if toks.is-empty() open.fail("`?{}` declares no query params")
      let ty = code-builder/new()
      ty.write("{ ")
      ty.write-tokens(toks)
      ty.write(" }")
      :some ty.build()
    } else :none
    entries.push(.{ method = m.text, name, pattern, pattern-tok = pat, path, query })
  }
  entries
}

fn shape-suffix(e: entry, from: size): string {
  let b = string-builder/new()
  let j = from
  while j < e.path.len() {
    if e.path.[j] is {
      :text t -> b.write("/l:$t"),
      :rest _ -> b.write("/**"),
      _ -> b.write("/*"),
    }
    j = j + 1
  }
  b.write("@${e.method}")
  b.build()
}

fn validate(entries: span[entry]) {
  for en in entries {
    let ps = params(en)
    for p in ps {
      let j = it-index + 1
      while j < ps.len() {
        if ps.[j].name == p.name en.pattern-tok.fail("Route `${en.name.text}` binds param `${p.name}` twice")
        j = j + 1
      }
    }
  }
  for a in entries {
    let outer = it-index
    for b in entries {
      if it-index > outer {
        if a.name.text == b.name.text b.name.fail("Duplicate route name `${b.name.text}`")
        if shape-suffix(a, 0) == shape-suffix(b, 0) {
          b.pattern-tok.fail("Routes `${a.name.text}` and `${b.name.text}` have the same method and shape")
        }
      }
    }
  }
}

type param = { name: string, ty: code, at: either { seg(size), rest } }

fn params(e: entry): list[param] {
  let ps = list/empty[param]()
  for s in e.path {
    let j: size = it-index
    if s is {
      :text _ -> .{},
      :capture f -> ps.push(.{ name = f.name, ty = f.ty, at = :seg j }),
      :rest n -> ps.push(.{ name = n, ty = code/from-string("string"), at = :rest }),
    }
  }
  ps
}

fn path-type(e: entry): code {
  let cb = code-builder/new()
  cb.write("{ ")
  for c in params(e) {
    if it-index > 0 cb.write(", ")
    cb.write("${c.name}: ")
    cb.write-code(c.ty)
  }
  cb.write(" }")
  cb.build()
}

fn payload-type(e: entry): ?code {
  let has-path = params(e).non-empty()
  if e.query is {
    :none -> if has-path :some path-type(e) else :none,
    :some q -> if has-path {
      let cb = code-builder/new()
      cb.write("_struct_combine[")
      cb.write-code(path-type(e))
      cb.write(", ")
      cb.write-code(q)
      cb.write("]")
      :some cb.build()
    } else :some q,
  }
}

fn struct-fields(id: types/type-id): span[{ name: string, type-id: types/type-id, offset: size }] {
  if id.schema().as-struct() is :some st st.fields else span/empty()
}

fn from-string-line(cb: *code-builder, ty: types/type-id, src: string, name: string, out: string) {
  if ty == types/id[string] {
    cb.line("let $out = $src")
  } else {
    cb.line(`require from-string@(${ty.spell()})/from-string($src) is :ok $out else { return :err :bad-param .{ pattern, name = ${str-lit(name)}, ty = ${str-lit(ty.name())}, got = $src } }`)
  }
}

fn parse-payload[t, n: static size](segs: span[string], u: std/url/url, pattern: string): result[t, route-error] {
  #meta { payload-code(types/id[t], core/meta/static-type-to-value[_, n]()) }
}

fn payload-code(payload-id: types/type-id, n: size): code {
  let fields = struct-fields(payload-id)
  let cb-storage = code-builder/new()
  let cb = cb-storage.&
  for f in fields {
    if it-index < n from-string-line(cb, f.type-id, "segs.[$it-index]", f.name, "v$it-index")
  }
  if fields.len() > n {
    for f in fields {
      if it-index >= n cb.line("let q$it-index: ?string = :none")
    }
    cb.block("for kv in u.query-pairs()", fn[cb, fields, n]. {
      for f in fields {
        let k = it-index
        if k >= n {
          cb.block(`if kv.name == ${str-lit(f.name)}`, fn[cb, f, k]. {
            cb.line(`if q$k.is-some() { return :err :bad-param .{ pattern, name = ${str-lit(f.name)}, ty = ${str-lit(f.type-id.name())}, got = kv.value } }`)
            cb.line("q$k = :some kv.value")
          })
        }
      }
    })
  }
  for f in fields {
    let k = it-index
    if k >= n {
      if f.type-id.is-instance-of(types/id[opt]) {
        let inner = f.type-id.instance-info().!.args.[0]
        cb.block-close(`let v$k: ${f.type-id.spell()} = if q$k is :some qv$k`, "} else :none", fn[cb, k, inner, f]. {
          from-string-line(cb, inner, "qv$k", f.name, "d$k")
          cb.line(":some d$k")
        })
      } else {
        cb.line(`require q$k is :some qv$k else { return :err :missing-param .{ pattern, name = ${str-lit(f.name)} } }`)
        from-string-line(cb, f.type-id, "qv$k", f.name, "v$k")
      }
    }
  }
  cb.line(":ok .{")
  for f in fields {
    cb.line("${f.name} = v$it-index,")
  }
  cb.line("}")
  cb.build()
}

fn write-query[t, n: static size, w: writer](v: t, w: w) {
  #meta { query-print-code(types/id[t], core/meta/static-type-to-value[_, n]()) }
}

fn query-print-code(payload-id: types/type-id, n: size): code {
  let cb-storage = code-builder/new()
  let cb = cb-storage.&
  cb.line(`let sep = "?"`)
  for f in struct-fields(payload-id) {
    if it-index >= n {
      let lit = str-lit("${f.name}=")
      if f.type-id.is-instance-of(types/id[opt]) {
        cb.block(`if v.${f.name} is :some x`, fn[cb, lit]. {
          cb.line("w.write(sep)")
          cb.line("w.write($lit)")
          cb.line("std/url/percent/write-encoded(w, x, :form)")
          cb.line(`sep = "&"`)
        })
      } else {
        cb.line("w.write(sep)")
        cb.line("w.write($lit)")
        cb.line("std/url/percent/write-encoded(w, v.${f.name}, :form)")
        cb.line(`sep = "&"`)
      }
    }
  }
  cb.build()
}

fn emit-leaf-body(cb: *code-builder, en: entry, d: size) {
  let srcs = list/empty[string]()
  for c in params(en) {
    srcs.push(if c.at is {
      :seg i -> "sd$i",
      :rest -> {
        cb.line(`let rest = std/url/percent/decode(if (not sp.more) and sp.count == $d "" else http/routing/tail-from(path, segs.[$d]))`)
        "rest"
      },
    })
  }
  if payload-type(en) is :some ty {
    cb.pad()
    cb.write("let payload = http/routing/parse-payload[")
    cb.write-code(ty)
    cb.write(`, ${srcs.len()}]([${string/join(srcs, ", ")}], u, ${str-lit(en.pattern)}).try`)
    cb.write("\n")
    cb.line("return :ok :${en.name.text} payload")
  } else {
    cb.line("return :ok :${en.name.text}")
  }
}

fn emit-leafs(cb: *code-builder, entries: span[entry], idxs: list[size], d: size) {
  let head-present = {
    let found = false
    for gi in idxs { if entries.[gi].method == "head" { found = true } }
    found
  }
  for gi in idxs {
    let en = entries.[gi]
    let cond = "method == http/llhttp/method:${en.method.to-ascii-upper()}"
    if en.method == "get" and not head-present {
      cond = "$cond or method == http/llhttp/method:HEAD"
    }
    cb.block("if $cond", fn[cb, entries, gi, d]. emit-leaf-body(cb, entries.[gi], d))
  }
  let first = entries.[idxs.[0]]
  let allowed = list/empty[string]()
  for gi in idxs { allowed.push(str-lit(entries.[gi].method.to-ascii-upper())) }
  cb.line(`return :err :bad-method .{ pattern = ${str-lit(first.pattern)}, allowed = [${string/join(allowed, ", ")}] }`)
}

fn emit-seg-edges(cb: *code-builder, entries: span[entry], group: list[size], d: size, lit-texts: list[string], caps: list[size]) {
  cb.line(`let sd$d = std/url/percent/decode(segs.[$d])`)
  for t in lit-texts {
    let sub = list/empty[size]()
    for gi in group {
      let en = entries.[gi]
      if en.path.len() > d and en.path.[d] is :text lt and lt == t { sub.push(gi) }
    }
    cb.block("if sd$d == ${str-lit(t)}", fn[cb, entries, sub, d]. emit-node(cb, entries, sub, d + 1))
  }
  if caps.non-empty() {
    emit-node(cb, entries, caps, d + 1)
  }
}

fn emit-node(cb: *code-builder, entries: span[entry], group: list[size], d: size) {
  let exact = list/empty[size]()
  let rests = list/empty[size]()
  let caps = list/empty[size]()
  let lit-texts = list/empty[string]()
  for gi in group {
    let en = entries.[gi]
    if en.path.len() == d { exact.push(gi) }
    else if en.path.[d] is {
      :rest _ -> rests.push(gi),
      :text t -> if not lit-texts.contains(t) { lit-texts.push(t) },
      _ -> caps.push(gi),
    }
  }

  if rests.non-empty() and (exact.non-empty() or caps.non-empty() or lit-texts.non-empty()) {
    entries.[rests.[0]].pattern-tok.fail("A rest route shares a prefix with other routes: `${entries.[rests.[0]].pattern}` would shadow or be shadowed by them")
  }

  for t in lit-texts {
    for ci in caps {
      let cshape = shape-suffix(entries.[ci], d + 1)
      let covered = false
      for gi in group {
        let en = entries.[gi]
        if en.path.len() > d and en.path.[d] is :text lt and lt == t {
          if shape-suffix(en, d + 1) == cshape { covered = true }
        }
      }
      if not covered {
        entries.[ci].pattern-tok.fail("Route `${entries.[ci].pattern}` is unreachable for URLs whose segment $d is `$t`: add the same route shape under `$t`, or remove the overlap")
      }
    }
  }

  if lit-texts.non-empty() or caps.non-empty() {
    cb.block("if sp.more or sp.count > $d", fn[cb, entries, group, d, lit-texts, caps]. emit-seg-edges(cb, entries, group, d, lit-texts, caps))
  }
  if exact.non-empty() {
    cb.block("if (not sp.more) and sp.count == $d", fn[cb, entries, exact, d]. emit-leafs(cb, entries, exact, d))
  }
  if rests.non-empty() {
    emit-leafs(cb, entries, rests, d)
  } else {
    cb.line("return :err :not-found")
  }
}

fn emit-parse-fn(cb: *code-builder, base: code, entries: span[entry]) {
  cb.line("fn parse-request(header: http/header): result[$base, http/routing/route-error] { parse(header.method, header.url) }")
  cb.block("fn parse(method: http/llhttp/method, u: std/url/url): result[$base, http/routing/route-error]", fn[cb, entries]. {
    cb.line(`let path = u.path()`)
    cb.line(`if not path.starts-with("/") { return :err :not-found }`)
    cb.line(`let segs = array/zeroed[string, 16]()`)
    cb.line(`let sp = http/routing/split-path(path, segs.&)`)
    let all = list/empty[size]()
    for en in entries { all.push(it-index) }
    emit-node(cb, entries, all, 0)
  })
}

fn emit-url-arm(cb: *code-builder, en: entry) {
  let lit = string-builder/new()
  if en.path.is-empty() lit.write("/")
  for s in en.path {
    lit.write("/")
    if s is {
      :text t -> lit.write(t),
      :capture f -> {
        cb.line("w.write(${str-lit(lit.build())})")
        lit.reset()
        cb.line("std/url/percent/write-encoded(w, p.${f.name}, :segment)")
      },
      :rest n -> {
        cb.line("w.write(${str-lit(lit.build())})")
        lit.reset()
        cb.line("std/url/percent/write-encoded(w, p.$n, :path)")
      },
    }
  }
  let tail = lit.build()
  if tail.non-empty() cb.line("w.write(${str-lit(tail)})")
  if en.query is :some _ {
    cb.pad()
    cb.write("http/routing/write-query[")
    cb.write-code(payload-type(en).!)
    cb.write(", ${params(en).len()}, _](p, w)\n")
  }
}

fn emit-print-impl(cb: *code-builder, base: code, entries: span[entry]) {
  cb.block("impl print for $base", fn[cb, base, entries]. {
    cb.block("fn print-to[w: writer](self: $base, w)", fn[cb, entries]. {
      cb.block("if self is", fn[cb, entries]. {
        for en in entries {
          let arm: code = if (payload-type(en) is :none) ":${en.name.text} ->" else ":${en.name.text} p ->"
          cb.block-close(arm, "},", fn[cb, en]. emit-url-arm(cb, en))
        }
      })
    })
  })
}

macro define(base: code, rows: span[code-token]) {
  let entries = parse-rows(rows).as-span()
  validate(entries)

  let cb-storage = code-builder/new()
  let cb = cb-storage.&

  cb.write-code("type $base = either { ")
  for en in entries {
    if it-index > 0 cb.write(", ")
    cb.write-token(en.name)
    if payload-type(en) is :some ty {
      cb.write("(")
      cb.write-code(ty)
      cb.write(")")
    }
  }
  cb.write(" }\n")

  cb.block("ns for $base", fn[cb, base, entries]. emit-parse-fn(cb, base, entries))
  emit-print-impl(cb, base, entries)

  cb.build()
}

type route-error = either {
  not-found,
  bad-param({ pattern: string, name: string, ty: string, got: string }),
  missing-param({ pattern: string, name: string }),
  bad-method({ pattern: string, allowed: span[string] }),
}

fn split-path(path: string, out: *array[string, 16]): { count: size, more: bool } {
  let count: size = 0
  let rest = path.drop(1)
  while rest.non-empty() {
    let end = rest.index-of('/') ? rest.len()
    if count == 16 { return .{ count = 16, more = true } }
    out.[count] = rest.take(end)
    count = count + 1
    rest = rest.drop(end + 1)
  }
  .{ count, more = false }
}

fn tail-from(path: string, seg: string): string {
  path.drop(seg.data-ptr().diff(path.data-ptr()))
}

}
