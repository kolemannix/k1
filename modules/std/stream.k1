// Pull-based chunk streams with async support via wakers

// Loop-thread-only wake: exactly one party holds a waker and calls it from
// the thread that runs the stream. For cross-thread signaling use notify.
type waker = { state: ptr, wake-fn: *fn(ptr) -> {} }
ns for waker {
  fn wake(self: waker) { (self.wake-fn)(self.state) }
  fn noop(): waker { .{ state = ptr/null, wake-fn = fn(_p: ptr) .{} } }
}

type pull[t] = either { chunk(span[span[t]]), pending, done, fail(string) }

type(alias) byte-source = dyn[source[t = u8]]

// The stream interface. Synchronous sources implement `pull` and keep the
// default no-op lifecycle; async sources also implement `start` (which
// delivers the waker to call when a :pending source has data again) and
// `stop` (which must release everything the source owns).
// Erase to a storable handle with `.to-dyn()`.
ability source[impl t] {
  fn start(_self: *self, _waker: waker) {}
  fn pull(self: *self): pull[t]
  fn stop(_self: *self) {}
}

// Consumes a stream chunk by chunk, then yields a single result value.
ability sink[impl t, impl out] {
  fn receive(self: *self, chunk: span[t])
  fn finish(self: *self): out
}

ability pipe[impl t, impl out] {
  fn map(self: *self, group: span[span[t]], out: *list[span[out]])
  fn finish(_self: *self, _out: *list[span[out]]) {}
  fn retire(_self: *self) {}
}

// Constructors: `source/` is the place to look for ways to make a stream
ns source {
  // A source over an in-memory span, yielding fixed-size chunks. Allocates its
  // cursor state in the ambient mode
  fn from-span[t](items: span[t], chunk-size: size): dyn[source[t = t]] {
    let state: *span-source[t] = mem/new(.{
      items,
      cursor = 0,
      chunk-size,
      part = span/empty(),
    })
    state.to-dyn()
  }

  // One printed item per pull, rendered into a reused buffer: each element
  // becomes its own chunk (and so, downstream, its own SSE event or message)
  fn from-printed[t: print](items: span[t]): byte-source {
    let state: *print-source[t] = mem/new(.{
      items,
      cursor = 0,
      buf = list/empty[u8](),
      part = span/empty(),
    })
    state.to-dyn()
  }

  fn once[t](group: span[span[t]]): dyn[source[t = t]] {
    let state: *once-source[t] = mem/new(.{ group, done = false })
    state.to-dyn()
  }

  fn through[t, out, p](upstream: dyn[source[t = t]], stage: p): dyn[source[t = out]] where p: pipe[t = t, out = out] {
    let state: *piped[t, out, p] = mem/new(.{
      upstream,
      stage,
      parts = list/empty[span[out]](),
      finished = false,
    })
    state.to-dyn()
  }

  // Drain a synchronous source through a sink, returning the sink's value.
  fn run-to[t, out, k](src: dyn[source[t = t]], into: *k): out where k: sink[t = t, out = out] {
    src.start(waker/noop())
    loop {
      if src.pull() is {
        :chunk group -> for c in group { sink@(k)/receive(into, c) },
        :pending -> crash("run-to: source returned pending; drive async sources from an event loop"),
        :done -> break,
        :fail message -> crash("run-to: stream failed: $message"),
      }
    }
    src.stop()
    sink@(k)/finish(into)
  }
}

type span-source[t] = {
  items: span[t],
  cursor: size,
  chunk-size: size,
  // backing for the emitted single-segment group
  part: span[t],
}

impl[t] source[t = t] for span-source[t] {
  fn pull(self: *span-source[t]): pull[t] {
    let remaining = self.items.len() - self.cursor
    if remaining == 0 { return :done }
    let n = remaining.min(self.chunk-size)
    self.part = self.items.slice(self.cursor, self.cursor + n)
    self.cursor = self.cursor + n
    :chunk span/wrap-single(self.part.&)
  }
}

type piped[t, out, p] = {
  upstream: dyn[source[t = t]],
  stage: p,
  parts: list[span[out]],
  finished: bool,
}

impl[t, out, p: pipe[t = t, out = out]] source[t = out] for piped[t, out, p] {
  fn start(self: *piped[t, out, p], waker: waker) { self.upstream.start(waker) }
  fn stop(self: *piped[t, out, p]) {
    pipe@(p)/retire(self.stage.&)
    self.upstream.stop()
  }
  fn pull(self: *piped[t, out, p]): pull[out] {
    self.parts.clear()
    pipe@(p)/retire(self.stage.&)
    if self.finished { return :done }
    loop {
      if self.upstream.pull() is {
        :chunk group -> {
          pipe@(p)/map(self.stage.&, group, self.parts.&)
          if self.parts.non-empty() { return :chunk self.parts.as-span() }
        },
        :pending -> return :pending,
        :done -> {
          self.finished = true
          pipe@(p)/finish(self.stage.&, self.parts.&)
          if self.parts.non-empty() { return :chunk self.parts.as-span() }
          return :done
        },
        :fail message -> return :fail message,
      }
    }
  }
}

type once-source[t] = { group: span[span[t]], done: bool }

impl[t] source[t = t] for once-source[t] {
  fn pull(self: *once-source[t]): pull[t] {
    if self.done { return :done }
    self.done = true
    :chunk self.group
  }
}

type print-source[t] = {
  items: span[t],
  cursor: size,
  // rendering buffer, overwritten each pull
  buf: list[u8],
  part: span[u8],
}

impl[t: print] source[t = u8] for print-source[t] {
  fn pull(self: *print-source[t]): pull[u8] {
    if self.cursor == self.items.len() { return :done }
    self.buf.clear()
    self.items.[self.cursor].print-to(self.buf.&)
    self.cursor = self.cursor + 1
    self.part = self.buf.as-span()
    :chunk span/wrap-single(self.part.&)
  }
}

// Unwraps a stream of rc-bytes into the payload bytes, zero-copy. Each
// handed-out payload is released when its group retires: on the following
// pull, or at stop.
type rc-byte-stream = { inflight: list[rc-bytes] }

fn rc-byte-stream(upstream: dyn[source[t = rc-bytes]]): byte-source {
  let stage: rc-byte-stream = .{ inflight = list/empty() }
  source/through(upstream, stage)
}

impl pipe[t = rc-bytes, out = u8] for rc-byte-stream {
  fn map(self: *rc-byte-stream, group: span[span[rc-bytes]], out: *list[span[u8]]) {
    for seg in group {
      for payload in seg {
        self.inflight.push(payload)
        out.push(payload.bytes())
      }
    }
  }
  fn retire(self: *rc-byte-stream) {
    for payload in self.inflight { payload.release() }
    self.inflight.clear()
  }
}

// The canonical sink: fold a stream of addable values into their sum.
type sum-sink[t] = { total: t }

impl[t: add] sink[t = t, out = t] for sum-sink[t] {
  fn receive(self: *sum-sink[t], chunk: span[t]) {
    for x in chunk { self.total = self.total + x }
  }
  fn finish(self: *sum-sink[t]): t { self.total }
}

type collect-sink[t] = { items: list[t] }

impl[t] sink[t = t, out = span[t]] for collect-sink[t] {
  fn receive(self: *collect-sink[t], chunk: span[t]) { self.items.append-span(chunk) }
  fn finish(self: *collect-sink[t]): span[t] { self.items.as-span() }
}
