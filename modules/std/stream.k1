// Pull-based chunk streams with async support via wakers

// Loop-thread-only wake: exactly one party holds a waker and calls it from
// the thread that runs the stream. For cross-thread signaling use notify.
type waker = { state: ptr, wake-fn: *fn(ptr) -> {} }
ns for waker {
  fn wake(self: waker) { (self.wake-fn)(self.state) }
  fn noop(): waker { .{ state = ptr/null, wake-fn = fn(_p: ptr) .{} } }
}

type pull[t] = either { chunk(span[span[t]]), pending, done, fail(string) }

// The stream interface. Synchronous sources implement `next` and keep the
// default no-op lifecycle; async sources also implement `start` (which
// delivers the waker to call when a :pending source has data again) and
// `stop` (which must release everything the source owns).
// Erase to a storable handle with `.to-dyn()`.
ability source[impl t] {
  fn start(self: *mut self, _waker: waker) { .{} }
  fn next(self: *mut self): pull[t]
  fn stop(self: *mut self) { .{} }
}

// Consumes a stream chunk by chunk, then yields a single result value.
ability sink[impl t, impl out] {
  fn receive(self: *mut self, chunk: span[t])
  fn finish(self: *mut self): out
}

// Constructors: `source/` is the place to look for ways to make a stream
ns source {
  // A source over an in-memory span, yielding fixed-size chunks. Allocates its
  // cursor state in the ambient mode
  fn from-span[t](items: span[t], chunk-size: size): dyn[source[t = t]] {
    let state: *mut buffer-source[t] = mem/new(.{
      items,
      cursor = 0,
      chunk-size,
      part = span/empty(),
    })
    state.to-dyn()
  }

  // One printed item per pull, rendered into a reused buffer: each element
  // becomes its own chunk (and so, downstream, its own SSE event or message)
  fn from-items[t: print](items: span[t]): dyn[source[t = u8]] {
    let state: *mut item-source[t] = mem/new(.{
      items,
      cursor = 0,
      buf = list/empty[u8](),
      part = span/empty(),
    })
    state.to-dyn()
  }

  // Drain a synchronous source through a sink, returning the sink's value.
  fn run-to[t, out, k](src: dyn[source[t = t]], into: *mut k): out where k: sink[t = t, out = out] {
    src.start(waker/noop())
    loop {
      src.next() is {
        :chunk group -> for c in group { sink@(k)/receive(into, c) },
        :pending -> crash("run-to: source returned pending; drive async sources from an event loop"),
        :done -> break,
        :fail message -> crash("run-to: stream failed: $message"),
      }
    }
    src.stop()
    sink@(k)/finish(into)
  }
}

type buffer-source[t] = {
  items: span[t],
  cursor: size,
  chunk-size: size,
  // backing for the emitted single-segment group
  part: span[t],
}

impl[t] source[t = t] for buffer-source[t] {
  fn next(self: *mut buffer-source[t]): pull[t] {
    let remaining = self.items.len() - self.cursor
    if remaining == 0 { return :done }
    let n = if remaining < self.chunk-size remaining else self.chunk-size
    self.part = self.items.slice(self.cursor, self.cursor + n)
    self.cursor = self.cursor + n
    :chunk span/wrap-single(self.part.&)
  }
}

type item-source[t] = {
  items: span[t],
  cursor: size,
  // rendering buffer, overwritten each pull
  buf: list[u8],
  part: span[u8],
}

impl[t: print] source[t = u8] for item-source[t] {
  fn next(self: *mut item-source[t]): pull[u8] {
    if self.cursor == self.items.len() { return :done }
    self.buf.clear()
    self.items.get(self.cursor).print-to(self.buf.&)
    self.cursor = self.cursor + 1
    self.part = self.buf.as-span()
    :chunk span/wrap-single(self.part.&)
  }
}

// The canonical sink: fold a stream of addable values into their sum.
type sum-sink[t] = { total: t }

impl[t: add] sink[t = t, out = t] for sum-sink[t] {
  fn receive(self: *mut sum-sink[t], chunk: span[t]) {
    for x in chunk { self.total = self.total + x }
  }
  fn finish(self: *mut sum-sink[t]): t { self.total }
}
