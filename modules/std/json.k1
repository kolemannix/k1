ns json

type json = either {
  null,
  bool  (bool),
  int   (i64),
  uint  (u64),
  float (f64),
  str   (string),
  array (span[json]),
  object(span[{ key: string, value: json }])
}

ns for json {
  fn get(self, key: string): ?json {
    if self is :object members {
      for m in members { if m.key == key return :some m.value }
    }
    :none
  }
}

type opts = {
  key-case: either { as-is, camel, snake },
  skip-none: bool,
  renames: span[{ field: string, key: string }],
}

ns for opts {
  let default: opts = .{ key-case = :as-is, skip-none = false, renames = [] }

  fn apply-key-case(self, name: string): string {
    if self.key-case is :as-is { return name }
    let sb = string-builder/new()
    let upper = false
    for c in name {
      if c == '-' {
        if self.key-case is :snake { sb.write-char('_') } else { upper = true }
      } else {
        sb.write-char(if upper c.to-ascii-upper() else c)
        upper = false
      }
    }
    sb.build()
  }

  fn get-field-key(self, field: string): string {
    for r in self.renames { if r.field == field return r.key }
    self.apply-key-case(field)
  }
}

ability json-write {
  fn write-json[w: writer, o: static opts](self, w)
}

fn write[t: json-write, w: writer](w, value: t) { value.write-json[_, opts/default](w) }

fn to-string[t: json-write](value: t): string {
  let sb = string-builder/new()
  write(sb.&, value)
  sb.build()
}

fn to-string-with[t: json-write, o: static opts](value: t): string {
  let sb = string-builder/new()
  value.write-json[_, o](sb.&)
  sb.build()
}

fn to-string-pretty[t: json-write](value: t, indent: size): string {
  let sb = string-builder/new()
  pretty(sb.&, to-string(value), indent)
  sb.build()
}

fn write-float[w: writer](w, f: f64) {
  if f != f or f == f64/inf or f == f64/neg-inf w.write("null") else f.print-to(w)
}

fn write-string[w: writer](w, s: string) {
  w.write-char('"')
  let i: size = 0
  loop {
    let next = internal/escape-position(s, i)
    w.write(s.slice(i, next))
    if next == s.len() break
    internal/write-escape(w, s.[next])
    i = next + 1
  }
  w.write-char('"')
}

impl json-write for json {
  fn write-json[w: writer, o: static opts](self, w) {
    if self is {
      :null -> w.write("null"),
      :bool b -> b.print-to(w),
      :int i -> i.print-to(w),
      :uint u -> u.print-to(w),
      :float f -> write-float(w, f),
      :str s -> write-string(w, s),
      :array items -> {
        w.write-char('[')
        for items {
          if it-index > 0 w.write-char(',')
          it.write-json[_, o](w)
        }
        w.write-char(']')
      },
      :object members -> {
        w.write-char('{')
        for members {
          if it-index > 0 w.write-char(',')
          write-string(w, it.key)
          w.write-char(':')
          it.value.write-json[_, o](w)
        }
        w.write-char('}')
      }
    }
  }
}

impl[t] json-write for t {
  fn write-json[w: writer, o: static opts](self, w) {
    #meta internal/write-code(o, types/id[t])
  }
}

fn pretty[w: writer](w, compact: string, indent: size) {
  let len = compact.len()
  let depth: size = 0
  let i: size = 0
  while i < len {
    let c = compact.[i]
    if c == '"' {
      let end = i + 1
      loop {
        if end >= len break
        let e = compact.[end]
        end = end + (if e == '\\' 2 else 1)
        if e == '"' break
      }
      w.write(compact.slice(i, end))
      i = end
      continue
    }
    i = i + 1
    if c == '{' or c == '[' {
      let close = if c == '{' '}' else ']'
      if i < len and compact.[i] == close {
        w.write-char(c)
        w.write-char(close)
        i = i + 1
        continue
      }
      depth = depth + 1
      w.write-char(c)
      internal/newline(w, depth, indent)
    } else if c == '}' or c == ']' {
      depth = depth - 1
      internal/newline(w, depth, indent)
      w.write-char(c)
    } else if c == ',' {
      w.write-char(c)
      internal/newline(w, depth, indent)
    } else if c == ':' {
      w.write(": ")
    } else {
      w.write-char(c)
    }
  }
}

type error-kind = either {
  unexpected-char(char),
  unexpected-end,
  control-char,
  bad-escape,
  invalid-utf8,
  bad-number,
  overflow,
  depth,
  trailing,
  missing-field(string),
  wrong-type(string),
  unknown-variant(string),
}
type error = { pos: size, kind: error-kind, input: string }

impl print for error {
  fn print-to[w: writer](self, w) {
    if self.kind is {
      :unexpected-char c -> { w.write("unexpected '"); w.write-char(c); w.write("'") },
      :unexpected-end -> w.write("unexpected end of input"),
      :control-char -> w.write("control character in string"),
      :bad-escape -> w.write("bad escape sequence"),
      :invalid-utf8 -> w.write("invalid utf-8"),
      :bad-number -> w.write("bad number"),
      :overflow -> w.write("number out of range"),
      :depth -> w.write("nesting too deep"),
      :trailing -> w.write("trailing content after value"),
      :missing-field f -> { w.write("missing field "); w.write(f) },
      :wrong-type t -> { w.write("expected "); w.write(t) },
      :unknown-variant v -> { w.write("unknown variant "); w.write(v) },
    }
    let line: size = 1
    let col: size = 1
    let i: size = 0
    let end = if self.pos < self.input.len() self.pos else self.input.len()
    while i < end {
      if self.input.[i] == '\n' { line = line + 1; col = 1 } else { col = col + 1 }
      i = i + 1
    }
    w.write(" at line ")
    line.print-to(w)
    w.write(", column ")
    col.print-to(w)
  }
}

ability json-read {
  fn read-json[o: static opts](r: *reader): result[self, error]
}

fn parse[t: json-read](input: string): result[t, error] { parse-with[t, opts/default](input) }

fn parse-with[t: json-read, o: static opts](input: string): result[t, error] {
  let r = reader/new(input)
  r.skip-ws()
  let value = json-read@(t)/read-json[o](r.&).try
  r.skip-ws()
  if not r.at-end() { return r.fail(:trailing) }
  :ok value
}

type reader = {
  input: string,
  pos: size,
  depth: size,
  max-depth: size,
  arena: *core/arena,
  scratch: list[json],
  members: list[{ key: string, value: json }],
}

ns for reader {
  fn new(input: string): reader {
    .{
      input,
      pos = 0,
      depth = 0,
      max-depth = 1024,
      arena = mem/current-arena(),
      scratch = list/empty(),
      members = list/empty(),
    }
  }

  fn(inline) at-end(*self): bool { self.pos >= self.input.len() }

  fn(inline) peek(*self): char {
    if self.pos < self.input.len() self.input.[self.pos] else '\0'
  }

  fn fail[t](*self, kind: error-kind): result[t, error] {
    :err .{ pos = self.pos, kind, input = self.input }
  }

  fn unexpected[t](*self): result[t, error] {
    if self.at-end() self.fail(:unexpected-end) else self.fail(:unexpected-char self.peek())
  }

  fn expect(*self, c: char): result[empty, error] {
    if self.peek() == c {
      self.pos = self.pos + 1
      :ok(.{})
    } else {
      self.unexpected()
    }
  }

  fn skip-ws(*self) {
    let input = self.input
    let len = input.len()
    let base = input.data-ptr()
    let spaces = ' '.as-u8().widen[u64] * 0x0101010101010101
    let pos = self.pos
    while pos < len {
      let c = input.[pos]
      if not (c == ' ' or c == '\n' or c == '\r' or c == '\t') { break }
      pos = pos + 1
      while pos + 8 <= len and mem/read-unaligned[u64](base.add-bytes(pos)) == spaces {
        pos = pos + 8
      }
    }
    self.pos = pos
  }

  fn enter(*self): result[empty, error] {
    self.depth = self.depth + 1
    if self.depth > self.max-depth { return self.fail(:depth) }
    :ok(.{})
  }

  fn array-start(*self): result[empty, error] {
    self.expect('[').try
    self.enter()
  }

  fn object-start(*self): result[empty, error] {
    self.expect('{').try
    self.enter()
  }

  fn next-item(*self, first: bool): result[bool, error] {
    self.skip-ws()
    if self.peek() == ']' {
      self.pos = self.pos + 1
      self.depth = self.depth - 1
      return :ok false
    }
    if not first {
      self.expect(',').try
      self.skip-ws()
    }
    :ok true
  }

  fn next-key(*self, first: bool): result[?string, error] {
    self.skip-ws()
    if self.peek() == '}' {
      self.pos = self.pos + 1
      self.depth = self.depth - 1
      return :ok :none
    }
    if not first {
      self.expect(',').try
      self.skip-ws()
    }
    let key = self.read-string().try
    self.skip-ws()
    self.expect(':').try
    self.skip-ws()
    :ok :some key
  }

  fn literal(*self, text: string): result[empty, error] {
    let n = text.len()
    if self.pos + n > self.input.len() { return self.unexpected() }
    let have = self.input.data-ptr().add-bytes(self.pos)
    let want = text.data-ptr()
    let i: size = 0
    while i < n {
      if have.ref-at[u8](i).* != want.ref-at[u8](i).* { return self.unexpected() }
      i = i + 1
    }
    self.pos = self.pos + n
    :ok(.{})
  }

  fn read-null(*self): result[empty, error] { self.literal("null") }

  fn read-bool(*self): result[bool, error] {
    if self.peek() == 't' {
      self.literal("true").try
      :ok true
    } else if self.peek() == 'f' {
      self.literal("false").try
      :ok false
    } else {
      self.unexpected()
    }
  }

  fn read-string(*self): result[string, error] {
    if self.peek() != '"' { return self.unexpected() }
    let input = self.input
    let len = input.len()
    let start = self.pos + 1
    let seg = internal/string-stop(input, start)
    if seg.stop >= len {
      self.pos = len
      return self.fail(:unexpected-end)
    }
    let c = input.[seg.stop]
    if c == '"' {
      let s = input.slice(start, seg.stop)
      if seg.high and not utf8/is-valid(s.span-bytes()) {
        self.pos = start
        return self.fail(:invalid-utf8)
      }
      self.pos = seg.stop + 1
      return :ok s
    }
    if c < ' ' {
      self.pos = seg.stop
      return self.fail(:control-char)
    }
    let sb = string-builder/new()
    sb.write(input.slice(start, seg.stop))
    let high = seg.high
    let i = seg.stop
    loop {
      self.pos = i
      i = i + 1
      if i >= len { return self.fail(:unexpected-end) }
      let e = input.[i]
      i = i + 1
      if e is {
        '"'  -> sb.write-char('"'),
        '\\' -> sb.write-char('\\'),
        '/'  -> sb.write-char('/'),
        'b'  -> sb.write-byte(8),
        'f'  -> sb.write-byte(12),
        'n'  -> sb.write-char('\n'),
        'r'  -> sb.write-char('\r'),
        't'  -> sb.write-char('\t'),
        'u'  -> {
          let cp = self.read-hex4(i).try
          i = i + 4
          if cp >= 0xD800 and cp <= 0xDBFF {
            if i + 6 > len or input.[i] != '\\' or input.[i + 1] != 'u' { return self.fail(:bad-escape) }
            let low = self.read-hex4(i + 2).try
            if low < 0xDC00 or low > 0xDFFF { return self.fail(:bad-escape) }
            i = i + 6
            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00)
          } else if cp >= 0xDC00 and cp <= 0xDFFF {
            return self.fail(:bad-escape)
          }
          utf8/write-codepoint(sb.&, cp)
        },
        _ -> return self.fail(:bad-escape)
      }
      let next = internal/string-stop(input, i)
      sb.write(input.slice(i, next.stop))
      high = high or next.high
      if next.stop >= len {
        self.pos = len
        return self.fail(:unexpected-end)
      }
      let c = input.[next.stop]
      if c == '"' {
        self.pos = next.stop + 1
        break
      }
      if c < ' ' {
        self.pos = next.stop
        return self.fail(:control-char)
      }
      i = next.stop
    }
    let s = sb.build()
    if high and not utf8/is-valid(s.span-bytes()) {
      self.pos = start
      return self.fail(:invalid-utf8)
    }
    :ok s
  }

  fn read-hex4(*self, at: size): result[u32, error] {
    if at + 4 > self.input.len() { return self.fail(:bad-escape) }
    let v: u32 = 0
    let j: size = 0
    while j < 4 {
      require self.input.[at + j].to-ascii-hex-digit() is :some d else { return self.fail(:bad-escape) }
      v = (v << 4) + d.widen[u32]
      j = j + 1
    }
    :ok v
  }

  fn scan-number(*self): result[{ end: size, is-int: bool, neg: bool }, error] {
    let input = self.input
    let len = input.len()
    let i = self.pos
    let neg = i < len and input.[i] == '-'
    if neg { i = i + 1 }
    if i >= len { self.pos = i; return self.fail(:unexpected-end) }
    if input.[i] == '0' {
      i = i + 1
    } else if input.[i].is-ascii-digit() {
      i = internal/skip-digits(input, i)
    } else {
      self.pos = i
      return self.fail(:bad-number)
    }
    let is-int = true
    if i < len and input.[i] == '.' {
      is-int = false
      i = i + 1
      let digits = internal/skip-digits(input, i)
      if digits == i { self.pos = i; return self.fail(:bad-number) }
      i = digits
    }
    if i < len and (input.[i] == 'e' or input.[i] == 'E') {
      is-int = false
      i = i + 1
      if i < len and (input.[i] == '+' or input.[i] == '-') { i = i + 1 }
      let digits = internal/skip-digits(input, i)
      if digits == i { self.pos = i; return self.fail(:bad-number) }
      i = digits
    }
    :ok .{ end = i, is-int, neg }
  }

  fn digits-u64(*self, start: size, end: size): ?u64 {
    u64/from-string(self.input.slice(start, end)).as-ok()
  }

  fn read-f64(*self): result[f64, error] {
    let n = self.scan-number().try
    self.read-f64-to(n.end)
  }

  fn read-f64-to(*self, end: size): result[f64, error] {
    let out: f64 = uninit
    let r = core/ffc/parse_double(end - self.pos, self.input.data-ptr().add-bytes(self.pos), out.&)
    if r.outcome == core/ffc/FFC_OUTCOME_INVALID_INPUT { return self.fail(:bad-number) }
    self.pos = end
    :ok out
  }

  fn read-int(*self, min: i64, max: i64): result[i64, error] {
    let n = self.scan-number().try
    if not n.is-int { return self.fail(:wrong-type "integer") }
    let start = if n.neg self.pos + 1 else self.pos
    require self.digits-u64(start, n.end) is :some digits else { return self.fail(:overflow) }
    require i64/from-magnitude(n.neg, digits) is :some v else { return self.fail(:overflow) }
    if v < min or v > max { return self.fail(:overflow) }
    self.pos = n.end
    :ok v
  }

  fn read-u64(*self): result[u64, error] {
    let n = self.scan-number().try
    if not n.is-int { return self.fail(:wrong-type "integer") }
    let start = if n.neg self.pos + 1 else self.pos
    require self.digits-u64(start, n.end) is :some digits else { return self.fail(:overflow) }
    if n.neg and digits != 0 { return self.fail(:overflow) }
    self.pos = n.end
    :ok digits
  }

  fn read-number(*self): result[json, error] {
    let n = self.scan-number().try
    if n.is-int {
      let start = if n.neg self.pos + 1 else self.pos
      if self.digits-u64(start, n.end) is :some digits {
        if i64/from-magnitude(n.neg, digits) is :some v {
          self.pos = n.end
          return :ok :int v
        }
        if not n.neg {
          self.pos = n.end
          return :ok :uint digits
        }
      }
    }
    :ok :float self.read-f64-to(n.end).try
  }

  fn read-value(*self): result[json, error] {
    let c = self.peek()
    if c is {
      '{' -> self.read-object(),
      '[' -> self.read-array(),
      '"' -> { :ok :str self.read-string().try },
      't' -> { self.literal("true").try; :ok :bool true },
      'f' -> { self.literal("false").try; :ok :bool false },
      'n' -> { self.literal("null").try; :ok :null },
      _ -> if c == '-' or c.is-ascii-digit() self.read-number() else self.unexpected()
    }
  }

  fn read-array(*self): result[json, error] {
    self.array-start().try
    let mark = self.scratch.len
    let first = true
    while self.next-item(first).try {
      let v = self.read-value().try
      self.scratch.push(v)
      first = false
    }
    let items = self.arena.push-span(self.scratch.as-span().drop(mark)).as-span()
    self.scratch.len = mark
    :ok :array items
  }

  fn read-object(*self): result[json, error] {
    self.object-start().try
    let mark = self.members.len
    let first = true
    loop {
      require self.next-key(first).try is :some key else { break }
      first = false
      let value = self.read-value().try
      self.members.push(.{ key, value })
    }
    let members = self.arena.push-span(self.members.as-span().drop(mark)).as-span()
    self.members.len = mark
    :ok :object members
  }

  fn skip-value(*self): result[empty, error] {
    let c = self.peek()
    if c is {
      '{' -> {
        self.object-start().try
        let first = true
        loop {
          require self.next-key(first).try is :some _ else { break }
          first = false
          self.skip-value().try
        }
        :ok(.{})
      },
      '[' -> {
        self.array-start().try
        let first = true
        while self.next-item(first).try {
          self.skip-value().try
          first = false
        }
        :ok(.{})
      },
      '"' -> { self.read-string().try; :ok(.{}) },
      't' -> self.literal("true"),
      'f' -> self.literal("false"),
      'n' -> self.literal("null"),
      _ -> {
        if not (c == '-' or c.is-ascii-digit()) { return self.unexpected() }
        self.pos = self.scan-number().try.end
        :ok(.{})
      }
    }
  }
}

impl json-read for json {
  fn read-json[o: static opts](r: *reader): result[json, error] { r.read-value() }
}

impl[t] json-read for t {
  fn read-json[o: static opts](r: *reader): result[t, error] {
    #meta internal/read-code(o, types/id[t])
  }
}

ns internal {
  fn write-escape[w: writer](w, c: char) {
    w.write-char('\\')
    if c is {
      '"'  -> w.write-char('"'),
      '\\' -> w.write-char('\\'),
      '\n' -> w.write-char('n'),
      '\r' -> w.write-char('r'),
      '\t' -> w.write-char('t'),
      _ -> if c.as-u8() is {
        8  -> w.write-char('b'),
        12 -> w.write-char('f'),
        b  -> { w.write("u00"); b.write-hex(w, false) }
      }
    }
  }

  fn escape-position(s: string, from: size): size {
    let len = s.len()
    let base = s.data-ptr()
    let lanes: size = k1/simd-bytes
    let i = from
    if i + lanes <= len {
      let quote = vector/splat[u8, k1/simd-bytes]('"'.as-u8())
      let slash = vector/splat[u8, k1/simd-bytes]('\\'.as-u8())
      let high = vector/splat[u8, k1/simd-bytes](0xE0)
      let zero = vector/splat[u8, k1/simd-bytes](0)
      while i + lanes <= len {
        let chunk = vector/load-unchecked[u8, k1/simd-bytes](base.add-bytes(i))
        let hit = chunk.eq-lanes(quote).bit-or(chunk.eq-lanes(slash)).bit-or(chunk.bit-and(high).eq-lanes(zero))
        let mask = hit.to-mask()
        if mask != 0 return i + mask.trailing-zeros().signed()
        i = i + lanes
      }
    }
    while i < len {
      let c = s.[i]
      if c == '"' or c == '\\' or c < ' ' return i
      i = i + 1
    }
    len
  }

  fn write-code(o: opts, id: types/type-id): code {
    let cb = code-builder/new()
    if id.instance-of[opt] {
      cb.line(`if self is { :some x -> x.write-json[_, o](w), :none -> w.write("null") }`)
    } else if id.instance-of[list] or id.instance-of[span] {
      write-seq-code(cb.&)
    } else if id.schema() is {
      :bool -> cb.line(`self.print-to(w)`),
      :int _ -> cb.line(`self.print-to(w)`),
      :float _ -> cb.line(if id == types/id[f32] `write-float(w, self.widen[f64])` else `write-float(w, self)`),
      :string -> cb.line(`write-string(w, self)`),
      :char -> cb.line(`write-string(w, self.to-string())`),
      :array _ -> write-seq-code(cb.&),
      :reference _ -> cb.line(`self.*.write-json[_, o](w)`),
      :enum _ -> cb.line(`write-string(w, self.enum-name())`),
      :struct .{ fields } -> {
        let flag = false
        if o.skip-none {
          for f in fields { if f.type-id.instance-of[opt] { flag = true } }
        }
        cb.line(`w.write-char('{')`)
        if flag cb.line(`let first = true`)
        for f in fields {
          let key = meta/str-lit(`"${o.get-field-key(f.name)}":`)
          let write-key = if flag `if first { first = false } else { w.write-char(',') }; w.write($key)`
            else if it-index == 0 `w.write($key)`
            else `w.write-char(','); w.write($key)`
          if flag and f.type-id.instance-of[opt] {
            cb.line(`if self.${f.name} is :some x { $write-key; x.write-json[_, o](w) }`)
          } else {
            cb.line(`$write-key; self.${f.name}.write-json[_, o](w)`)
          }
        }
        cb.line(`w.write-char('}')`)
      },
      :either .{ variants } -> {
        cb.line("if self is {")
        for v in variants {
          let name = meta/str-lit(`"${o.apply-key-case(v.name)}"`)
          if v.payload is :some _ {
            let key = meta/str-lit(`{"${o.apply-key-case(v.name)}":`)
            cb.line(`:${v.name} p -> { w.write($key); p.write-json[_, o](w); w.write-char('}') },`)
          } else {
            cb.line(`:${v.name} -> w.write($name),`)
          }
        }
        cb.line("}")
      },
      _ -> crash("json: no encoding for ${id.name()}")
    }
    cb.build()
  }

  fn write-seq-code(cb: *code-builder) {
    cb.line(`w.write-char('[')`)
    cb.line(`for self { if it-index > 0 w.write-char(','); it.write-json[_, o](w) }`)
    cb.line(`w.write-char(']')`)
  }

  fn newline[w: writer](w, depth: size, indent: size) {
    w.write-char('\n')
    w.repeat(" ", depth * indent)
  }

  fn skip-digits(s: string, from: size): size {
    let len = s.len()
    let lanes: size = k1/simd-bytes
    let i = from
    if i + lanes <= len {
      let chunk = vector/load-unchecked[u8, k1/simd-bytes](s.data-ptr().add-bytes(i))
      let digits = chunk.sub(vector/splat[u8, k1/simd-bytes]('0'.as-u8())).lt-lanes(vector/splat[u8, k1/simd-bytes](10))
      let all = u64/bitmask-low(lanes)
      let mask = digits.to-mask()
      if mask != all { return i + mask.bit-not().bit-and(all).trailing-zeros().signed() }
      i = i + lanes
    }
    while i < len and s.[i].is-ascii-digit() { i = i + 1 }
    i
  }

  fn string-stop(s: string, from: size): { stop: size, high: bool } {
    let len = s.len()
    let base = s.data-ptr()
    let lanes: size = k1/simd-bytes
    let i = from
    let high = false
    if i + lanes <= len {
      let quote = vector/splat[u8, k1/simd-bytes]('"'.as-u8())
      let slash = vector/splat[u8, k1/simd-bytes]('\\'.as-u8())
      let space = vector/splat[u8, k1/simd-bytes](' '.as-u8())
      let seen = vector/splat[u8, k1/simd-bytes](0)
      while i + lanes <= len {
        let chunk = vector/load-unchecked[u8, k1/simd-bytes](base.add-bytes(i))
        seen = seen.bit-or(chunk)
        let hit = chunk.eq-lanes(quote).bit-or(chunk.eq-lanes(slash)).bit-or(chunk.lt-lanes(space))
        if hit.reduce-or() != 0 {
          return .{ stop = i + hit.to-mask().trailing-zeros().signed(), high = seen.reduce-or() >= 0x80 }
        }
        i = i + lanes
      }
      high = seen.reduce-or() >= 0x80
    }
    while i < len {
      let c = s.[i]
      if c == '"' or c == '\\' or c < ' ' { return .{ stop = i, high } }
      if not c.is-ascii() { high = true }
      i = i + 1
    }
    .{ stop = len, high }
  }

  fn read-of(id: types/type-id): string { `json-read@(${id.spell()})/read-json[o](r).try` }

  fn read-seq-code(cb: *code-builder, elem: types/type-id) {
    cb.line(`r.array-start().try`)
    cb.line(`let items = list/empty[${elem.spell()}]()`)
    cb.line(`let first = true`)
    cb.line(`while r.next-item(first).try { items.push(${read-of(elem)}); first = false }`)
  }

  fn read-code(o: opts, id: types/type-id): code {
    let cb = code-builder/new()
    if id.elem-of[opt] is :some inner {
      cb.line(`if r.peek() == 'n' { r.read-null().try; :ok :none } else { :ok :some ${read-of(inner)} }`)
    } else if id.elem-of[list] is :some elem {
      read-seq-code(cb.&, elem)
      cb.line(`:ok items`)
    } else if id.elem-of[span] is :some elem {
      read-seq-code(cb.&, elem)
      cb.line(`:ok items.as-span()`)
    } else if id.schema() is {
      :int :u64 -> cb.line(`r.read-u64()`),
      :int :i64 -> cb.line(`r.read-int(i64/min-value, i64/max-value)`),
      :int k -> {
        let t = k.enum-name()
        cb.line(`:ok r.read-int($t/min-value, $t/max-value).try.trunc[$t]`)
      },
      :float :f32 -> cb.line(`:ok r.read-f64().try.trunc[f32]`),
      :float :f64 -> cb.line(`r.read-f64()`),
      :bool -> cb.line(`r.read-bool()`),
      :string -> cb.line(`r.read-string()`),
      :char -> {
        cb.line(`let s = r.read-string().try`)
        cb.line(`if s.len() != 1 { return r.fail(:wrong-type "single character") }`)
        cb.line(`:ok s.[0]`)
      },
      :array .{ element-type-id, size } -> {
        let n = size.!
        read-seq-code(cb.&, element-type-id)
        cb.line(`if items.len() != $n { return r.fail(:wrong-type "array of $n") }`)
        cb.line(`:ok items.as-span().to-array[${element-type-id.spell()}, $n]`)
      },
      :reference .{ inner-type-id } -> cb.line(`:ok mem/new(${read-of(inner-type-id)})`),
      :enum .{ values } -> {
        cb.line(`let s = r.read-string().try`)
        for v in values {
          let name = meta/str-lit(o.apply-key-case(v.name))
          cb.line(`${if it-index == 0 "if" else "else if"} s == $name { :ok :${v.name} }`)
        }
        cb.line(`else { r.fail(:unknown-variant s) }`)
      },
      :either .{ variants } -> {
        cb.line(`if r.peek() == '"' {`)
        cb.line(`let s = r.read-string().try`)
        for v in variants {
          if v.payload is :none {
            let name = meta/str-lit(o.apply-key-case(v.name))
            cb.line(`if s == $name { return :ok :${v.name} }`)
          }
        }
        cb.line(`r.fail(:unknown-variant s)`)
        cb.line(`} else {`)
        cb.line(`r.object-start().try`)
        cb.line(`require r.next-key(true).try is :some key else { return r.fail(:wrong-type "variant") }`)
        cb.line(`let v: ${id.spell()} = uninit`)
        let first = true
        for v in variants {
          if v.payload is :some p {
            let name = meta/str-lit(o.apply-key-case(v.name))
            cb.line(`${if first "if" else "else if"} key == $name { v = :${v.name} (${read-of(p.type-id)}) }`)
            first = false
          }
        }
        cb.line(`${if first "" else "else "}{ return r.fail(:unknown-variant key) }`)
        cb.line(`if r.next-key(false).try is :some _ { return r.fail(:wrong-type "single-key variant object") }`)
        cb.line(`:ok v`)
        cb.line(`}`)
      },
      :struct .{ fields } -> {
        cb.line(`r.object-start().try`)
        for f in fields {
          if f.type-id.instance-of[opt] {
            cb.line(`let f$it-index: ${f.type-id.spell()} = :none`)
          } else {
            cb.line(`let f$it-index: ?${f.type-id.spell()} = :none`)
          }
        }
        cb.line(`let first = true`)
        cb.line(`loop {`)
        cb.line(`require r.next-key(first).try is :some key else { break }`)
        cb.line(`first = false`)
        for f in fields {
          let key = meta/str-lit(o.get-field-key(f.name))
          let assign = if f.type-id.instance-of[opt] `f$it-index = ${read-of(f.type-id)}`
            else `f$it-index = :some (${read-of(f.type-id)})`
          cb.line(`${if it-index == 0 "if" else "else if"} key == $key { $assign }`)
        }
        cb.line(`${if fields.len() == 0 "" else "else "}{ r.skip-value().try }`)
        cb.line(`}`)
        for f in fields {
          if not f.type-id.instance-of[opt] {
            cb.line(`require f$it-index is :some v$it-index else { return r.fail(:missing-field ${meta/str-lit(o.get-field-key(f.name))}) }`)
          }
        }
        cb.line(`:ok(.{`)
        for f in fields {
          let v = if f.type-id.instance-of[opt] `f$it-index` else `v$it-index`
          cb.line(`${f.name} = $v,`)
        }
        cb.line(`})`)
      },
      _ -> crash("json: no decoding for ${id.name()}")
    }
    cb.build()
  }
}
