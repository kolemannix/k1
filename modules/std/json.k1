ns json
use codec/encode
use codec/encoder
use codec/decoder

type json = either {
  null,
  bool  (bool),
  int   (i64),
  uint  (u64),
  float (f64),
  str   (string),
  array (span[json]),
  object(span[{ key: string, value: json }])
}

ns for json {
  fn get(self, key: string): ?json {
    if self is :object members {
      for m in members { if m.key == key return :some m.value }
    }
    :none
  }

  fn merge(self, patch: json): json {
    require self is :object members and patch is :object patched else return patch
    let merged = list/from-span(members)
    for p in patched {
      if merged.find-index(fn[p](m) m.key == p.key) is :some i {
        merged.[i].value = merged.[i].value.merge(p.value)
      } else merged.push(p)
    }
    :object merged.as-span()
  }
}

type text-encoder[w] = { w: w }

impl[w: writer] codec/encoder for text-encoder[w] {
  fn encode-name(kind: codec/name-kind, name: string, out: *string-builder) {
    write-string(out, name)
    if not (kind is :unit-variant) { out.write-char(':') }
  }
  fn write-null(self) { self.w.write("null") }
  fn write-bool(self, b: bool) { b.print-to(self.w) }
  fn write-int(self, i: i64) { i.print-to(self.w) }
  fn write-uint(self, u: u64) { u.print-to(self.w) }
  fn write-float(self, f: f64) { write-float(self.w, f) }
  fn write-string(self, s: string) { write-string(self.w, s) }
  fn begin-seq(self, _len: size) { self.w.write-char('[') }
  fn begin-item(self, index: size) { if index > 0 self.w.write-char(',') }
  fn end-seq(self) { self.w.write-char(']') }
  fn begin-map(self, _len: size) { self.w.write-char('{') }
  fn write-field-name(self, index: size, name: string) {
    if index > 0 self.w.write-char(',')
    self.w.write(name)
  }
  fn write-key(self, index: size, key: string) {
    if index > 0 self.w.write-char(',')
    write-string(self.w, key)
    self.w.write-char(':')
  }
  fn end-map(self) { self.w.write-char('}') }
  fn write-unit-variant(self, name: string) { self.w.write(name) }
}

fn write[t: codec/encode, w: writer](w, value: t) {
  let e: text-encoder[w] = .{ w }
  value.encode[o = codec/opts/default](e)
}

fn to-string[t: codec/encode](value: t): string { to-string-with[o = codec/opts/default](value) }

fn to-string-with[t: codec/encode, o: static codec/opts](value: t): string {
  let sb = string-builder/new()
  let e: text-encoder[*string-builder] = .{ w = sb.& }
  value.encode[o = o](e)
  sb.build()
}

fn to-string-pretty[t: codec/encode](value: t, indent: size): string {
  let sb = string-builder/new()
  pretty(sb.&, to-string(value), indent)
  sb.build()
}

fn write-float[w: writer](w, f: f64) {
  if f != f or f == f64/inf or f == f64/neg-inf w.write("null") else f.print-to(w)
}

fn write-string[w: writer](w, s: string) {
  w.write-char('"')
  let i: size = 0
  loop {
    let next = internal/escape-position(s, i)
    w.write(s.slice(i, next))
    if next == s.len() break
    internal/write-escape(w, s.[next])
    i = next + 1
  }
  w.write-char('"')
}

impl codec/encode for json {
  fn encode[e: codec/encoder, o: static codec/opts](self, e) {
    if self is {
      :null -> e.write-null(),
      :bool b -> e.write-bool(b),
      :int i -> e.write-int(i),
      :uint u -> e.write-uint(u),
      :float f -> e.write-float(f),
      :str s -> e.write-string(s),
      :array items -> items.encode[o = o](e),
      :object members -> {
        e.begin-map(members.len())
        for members { e.write-key(it-index, it.key); it.value.encode[o = o](e) }
        e.end-map()
      }
    }
  }
}

impl codec/decode for json {
  fn decode[d: codec/decoder, o: static codec/opts](d): result[json, codec/error] {
    let scratch: list[json] = list/empty()
    let members: list[{ key: string, value: json }] = list/empty()
    internal/decode-value(d, mem/current-arena(), scratch.&, members.&)
  }
}

fn pretty[w: writer](w, compact: string, indent: size) {
  let len = compact.len()
  let depth: size = 0
  let i: size = 0
  while i < len {
    let c = compact.[i]
    if c == '"' {
      let end = i + 1
      loop {
        if end >= len break
        let e = compact.[end]
        end = end + (if e == '\\' 2 else 1)
        if e == '"' break
      }
      w.write(compact.slice(i, end))
      i = end
      continue
    }
    i = i + 1
    if c == '{' or c == '[' {
      let close = if c == '{' '}' else ']'
      if i < len and compact.[i] == close {
        w.write-char(c)
        w.write-char(close)
        i = i + 1
        continue
      }
      depth = depth + 1
      w.write-char(c)
      internal/newline(w, depth, indent)
    } else if c == '}' or c == ']' {
      depth = depth - 1
      internal/newline(w, depth, indent)
      w.write-char(c)
    } else if c == ',' {
      w.write-char(c)
      internal/newline(w, depth, indent)
    } else if c == ':' {
      w.write(": ")
    } else {
      w.write-char(c)
    }
  }
}

fn parse[t: codec/decode](input: string): result[t, codec/error] { parse-with[t, codec/opts/default](input) }

fn parse-with[t: codec/decode, o: static codec/opts](input: string): result[t, codec/error] {
  let r = text-decoder/new(input)
  r.skip-ws()
  let value = codec/decode@(t)/decode[o = o](r.&).try
  r.skip-ws()
  if not r.at-end() { return r.&.error(:trailing) }
  :ok value
}

fn to-value[t: codec/encode](value: t): json {
  let e: tree-encoder = .{ frames = list/empty(), out = :null }
  value.encode[o = codec/opts/default](e.&)
  e.out
}

fn from-value[t: codec/decode](value: json): result[t, codec/error] {
  let d: tree-decoder = .{ next = value, seqs = list/empty(), maps = list/empty() }
  codec/decode@(t)/decode[o = codec/opts/default](d.&)
}

type text-decoder = {
  input: string,
  pos: size,
  depth: size,
}

ns for text-decoder {
  fn new(input: string): text-decoder { .{ input, pos = 0, depth = 0 } }

  fn(inline) at-end(*self): bool { self.pos >= self.input.len() }

  fn(inline) peek(*self): char {
    if self.pos < self.input.len() self.input.[self.pos] else '\0'
  }

  fn unexpected[t](*self): result[t, codec/error] {
    if self.at-end() self.error(:unexpected-end) else self.error(:unexpected-char self.peek())
  }

  fn expect(*self, c: char): result[empty, codec/error] {
    if self.peek() == c {
      self.pos = self.pos + 1
      :ok(.{})
    } else {
      self.unexpected()
    }
  }

  fn skip-ws(*self) {
    let input = self.input
    let len = input.len()
    let base = input.data-ptr()
    let spaces = ' '.as-u8().widen[u64] * 0x0101010101010101
    let pos = self.pos
    while pos < len {
      let c = input.[pos]
      if not (c == ' ' or c == '\n' or c == '\r' or c == '\t') { break }
      pos = pos + 1
      while pos + 8 <= len and mem/read-unaligned[u64](base.add-bytes(pos)) == spaces {
        pos = pos + 8
      }
    }
    self.pos = pos
  }

  fn(inline) begin-entry(*self, close: char, index: size): result[bool, codec/error] {
    self.skip-ws()
    if self.peek() == close {
      self.pos = self.pos + 1
      self.depth = self.depth - 1
      return :ok false
    }
    if index > 0 {
      self.expect(',').try
      self.skip-ws()
    }
    :ok true
  }

  fn enter(*self): result[empty, codec/error] {
    self.depth = self.depth + 1
    if self.depth > codec/max-depth { return self.error(:depth) }
    :ok(.{})
  }

  fn expect-literal(*self, text: string): result[empty, codec/error] {
    let n = text.len()
    if self.pos + n > self.input.len() { return self.unexpected() }
    let have = self.input.data-ptr().add-bytes(self.pos)
    let want = text.data-ptr()
    let i: size = 0
    while i < n {
      if have.ref-at[u8](i).* != want.ref-at[u8](i).* { return self.unexpected() }
      i = i + 1
    }
    self.pos = self.pos + n
    :ok(.{})
  }

  fn read-hex4(*self, at: size): result[u32, codec/error] {
    if at + 4 > self.input.len() { return self.error(:bad-escape) }
    let v: u32 = 0
    let j: size = 0
    while j < 4 {
      require self.input.[at + j].to-ascii-hex-digit() is :some d else { return self.error(:bad-escape) }
      v = (v << 4) + d.widen[u32]
      j = j + 1
    }
    :ok v
  }

  fn scan-number(*self): result[{ end: size, is-int: bool, neg: bool }, codec/error] {
    let input = self.input
    let len = input.len()
    let i = self.pos
    let neg = i < len and input.[i] == '-'
    if neg { i = i + 1 }
    if i >= len { self.pos = i; return self.error(:unexpected-end) }
    if input.[i] == '0' {
      i = i + 1
    } else if input.[i].is-ascii-digit() {
      i = internal/skip-digits(input, i)
    } else {
      self.pos = i
      return self.error(:bad-number)
    }
    let is-int = true
    if i < len and input.[i] == '.' {
      is-int = false
      i = i + 1
      let digits = internal/skip-digits(input, i)
      if digits == i { self.pos = i; return self.error(:bad-number) }
      i = digits
    }
    if i < len and (input.[i] == 'e' or input.[i] == 'E') {
      is-int = false
      i = i + 1
      if i < len and (input.[i] == '+' or input.[i] == '-') { i = i + 1 }
      let digits = internal/skip-digits(input, i)
      if digits == i { self.pos = i; return self.error(:bad-number) }
      i = digits
    }
    :ok .{ end = i, is-int, neg }
  }

  fn parse-magnitude(*self, n: { end: size, is-int: bool, neg: bool }): ?u64 {
    let start = if n.neg self.pos + 1 else self.pos
    u64/from-string(self.input.slice(start, n.end)).as-ok()
  }

  fn read-f64-to(*self, end: size): result[f64, codec/error] {
    let out: f64 = uninit
    let r = core/ffc/parse_double(end - self.pos, self.input.data-ptr().add-bytes(self.pos), out.&)
    if r.outcome == core/ffc/FFC_OUTCOME_INVALID_INPUT { return self.error(:bad-number) }
    self.pos = end
    :ok out
  }

}

impl codec/decoder for *text-decoder {
  fn(inline) peek-kind(self): result[codec/value-kind, codec/error] {
    let c = self.peek()
    if c is {
      '{' -> :ok :map,
      '[' -> :ok :seq,
      '"' -> :ok :string,
      't' or 'f' -> :ok :bool,
      'n' -> :ok :null,
      _ -> if c == '-' or c.is-ascii-digit() :ok :number else self.unexpected()
    }
  }

  fn read-null(self): result[empty, codec/error] { self.expect-literal("null") }

  fn read-bool(self): result[bool, codec/error] {
    if self.peek() == 't' {
      self.expect-literal("true").try
      :ok true
    } else if self.peek() == 'f' {
      self.expect-literal("false").try
      :ok false
    } else {
      self.unexpected()
    }
  }

  fn read-int(self, min: i64, max: i64): result[i64, codec/error] {
    let n = self.scan-number().try
    if not n.is-int { return self.error(:wrong-type "integer") }
    require self.parse-magnitude(n) is :some digits else { return self.error(:overflow) }
    require i64/from-magnitude(n.neg, digits) is :some v else { return self.error(:overflow) }
    if v < min or v > max { return self.error(:overflow) }
    self.pos = n.end
    :ok v
  }

  fn read-uint(self, max: u64): result[u64, codec/error] {
    let n = self.scan-number().try
    if not n.is-int { return self.error(:wrong-type "integer") }
    require self.parse-magnitude(n) is :some digits else { return self.error(:overflow) }
    if (n.neg and digits != 0) or digits > max { return self.error(:overflow) }
    self.pos = n.end
    :ok digits
  }

  fn read-float(self): result[f64, codec/error] {
    let n = self.scan-number().try
    self.read-f64-to(n.end)
  }

  fn(inline) read-number(self): result[codec/number, codec/error] {
    let n = self.scan-number().try
    if n.is-int {
      if self.parse-magnitude(n) is :some digits {
        if i64/from-magnitude(n.neg, digits) is :some v {
          self.pos = n.end
          return :ok :int v
        }
        if not n.neg {
          self.pos = n.end
          return :ok :uint digits
        }
      }
    }
    :ok :float self.read-f64-to(n.end).try
  }

  fn read-string(self): result[string, codec/error] {
    if self.peek() != '"' { return self.unexpected() }
    let input = self.input
    let len = input.len()
    let start = self.pos + 1
    let seg = internal/string-stop(input, start)
    if seg.stop >= len {
      self.pos = len
      return self.error(:unexpected-end)
    }
    let c = input.[seg.stop]
    if c == '"' {
      let s = input.slice(start, seg.stop)
      if seg.high and not utf8/is-valid(s.span-bytes()) {
        self.pos = start
        return self.error(:invalid-utf8)
      }
      self.pos = seg.stop + 1
      return :ok s
    }
    if c < ' ' {
      self.pos = seg.stop
      return self.error(:control-char)
    }
    let sb = string-builder/new()
    sb.write(input.slice(start, seg.stop))
    let high = seg.high
    let i = seg.stop
    loop {
      self.pos = i
      i = i + 1
      if i >= len { return self.error(:unexpected-end) }
      let e = input.[i]
      i = i + 1
      if e is {
        '"'  -> sb.write-char('"'),
        '\\' -> sb.write-char('\\'),
        '/'  -> sb.write-char('/'),
        'b'  -> sb.write-byte(8),
        'f'  -> sb.write-byte(12),
        'n'  -> sb.write-char('\n'),
        'r'  -> sb.write-char('\r'),
        't'  -> sb.write-char('\t'),
        'u'  -> {
          let cp = self.read-hex4(i).try
          i = i + 4
          if cp >= 0xD800 and cp <= 0xDBFF {
            if i + 6 > len or input.[i] != '\\' or input.[i + 1] != 'u' { return self.error(:bad-escape) }
            let low = self.read-hex4(i + 2).try
            if low < 0xDC00 or low > 0xDFFF { return self.error(:bad-escape) }
            i = i + 6
            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00)
          } else if cp >= 0xDC00 and cp <= 0xDFFF {
            return self.error(:bad-escape)
          }
          utf8/write-codepoint(sb.&, cp)
        },
        _ -> return self.error(:bad-escape)
      }
      let next = internal/string-stop(input, i)
      sb.write(input.slice(i, next.stop))
      high = high or next.high
      if next.stop >= len {
        self.pos = len
        return self.error(:unexpected-end)
      }
      let c = input.[next.stop]
      if c == '"' {
        self.pos = next.stop + 1
        break
      }
      if c < ' ' {
        self.pos = next.stop
        return self.error(:control-char)
      }
      i = next.stop
    }
    let s = sb.build()
    if high and not utf8/is-valid(s.span-bytes()) {
      self.pos = start
      return self.error(:invalid-utf8)
    }
    :ok s
  }

  fn(inline) begin-seq(self): result[empty, codec/error] {
    self.expect('[').try
    self.enter()
  }

  fn(inline) begin-item(self, index: size): result[bool, codec/error] { self.begin-entry(']', index) }

  fn begin-map(self): result[empty, codec/error] {
    self.expect('{').try
    self.enter()
  }

  fn read-key(self, index: size): result[?string, codec/error] {
    if not self.begin-entry('}', index).try { return :ok :none }
    let key = self.read-string().try
    self.skip-ws()
    self.expect(':').try
    self.skip-ws()
    :ok :some key
  }

  fn skip-value(self): result[empty, codec/error] {
    if self.peek-kind().try is {
      :map -> {
        self.begin-map().try
        let n: size = 0
        while self.read-key(n).try is :some _ { self.skip-value().try; n = n + 1 }
      },
      :seq -> {
        self.begin-seq().try
        let n: size = 0
        while self.begin-item(n).try { self.skip-value().try; n = n + 1 }
      },
      :string -> { let _ = self.read-string().try },
      :bool -> { let _ = self.read-bool().try },
      :null -> self.read-null().try,
      :number -> { self.pos = self.scan-number().try.end },
    }
    :ok(.{})
  }

  fn error[t](self, kind: codec/error-kind): result[t, codec/error] {
    :err mem/new[codec/error-info](.{ kind, location = :some .{ pos = self.pos, input = self.input } })
  }
}

type tree-encoder = {
  frames: list[{ is-map: bool, key: string, items: list[json], members: list[{ key: string, value: json }] }],
  out: json,
}

ns for tree-encoder {
  fn emit(*self, value: json) {
    if self.frames.len == 0 { self.out = value; return }
    let f = self.frames.[self.frames.len - 1].&
    if f.is-map f.members.push(.{ key = f.key, value }) else f.items.push(value)
  }

  fn open(*self, is-map: bool) {
    self.frames.push(.{ is-map, key = "", items = list/empty(), members = list/empty() })
  }
}

impl codec/encoder for *tree-encoder {
  fn write-null(self) { self.emit(:null) }
  fn write-bool(self, b: bool) { self.emit(:bool b) }
  fn write-int(self, i: i64) { self.emit(:int i) }
  fn write-uint(self, u: u64) { self.emit(:uint u) }
  fn write-float(self, f: f64) { self.emit(:float f) }
  fn write-string(self, s: string) { self.emit(:str s) }
  fn begin-seq(self, _len: size) { self.open(false) }
  fn begin-item(_self: self, _index: size) {}
  fn end-seq(self) { self.emit(:array self.frames.pop().!.items.as-span()) }
  fn begin-map(self, _len: size) { self.open(true) }
  fn write-key(self, _index: size, key: string) { self.frames.[self.frames.len - 1].key = key }
  fn end-map(self) { self.emit(:object self.frames.pop().!.members.as-span()) }
}

type tree-decoder = { next: json, seqs: list[span[json]], maps: list[span[{ key: string, value: json }]] }

impl codec/decoder for *tree-decoder {
  fn peek-kind(self): result[codec/value-kind, codec/error] {
    :ok(if self.next is {
      :null -> :null,
      :bool _ -> :bool,
      :int _ or :uint _ or :float _ -> :number,
      :str _ -> :string,
      :array _ -> :seq,
      :object _ -> :map,
    })
  }
  fn read-null(self): result[empty, codec/error] { if self.next is :null { :ok(.{}) } else self.error(:wrong-type "null") }
  fn read-bool(self): result[bool, codec/error] { if self.next is :bool b { :ok b } else self.error(:wrong-type "bool") }
  fn read-number(self): result[codec/number, codec/error] {
    if self.next is {
      :int i -> :ok :int i,
      :uint u -> :ok :uint u,
      :float f -> :ok :float f,
      _ -> self.error(:wrong-type "number")
    }
  }
  fn read-string(self): result[string, codec/error] { if self.next is :str s { :ok s } else self.error(:wrong-type "string") }
  fn begin-seq(self): result[empty, codec/error] {
    require self.next is :array items else { return self.error(:wrong-type "array") }
    self.seqs.push(items)
    :ok(.{})
  }
  fn begin-item(self, index: size): result[bool, codec/error] {
    let items = self.seqs.[self.seqs.len - 1]
    if index == items.len() { let _ = self.seqs.pop(); return :ok false }
    self.next = items.[index]
    :ok true
  }
  fn begin-map(self): result[empty, codec/error] {
    require self.next is :object members else { return self.error(:wrong-type "object") }
    self.maps.push(members)
    :ok(.{})
  }
  fn read-key(self, index: size): result[?string, codec/error] {
    let members = self.maps.[self.maps.len - 1]
    if index == members.len() { let _ = self.maps.pop(); return :ok :none }
    self.next = members.[index].value
    :ok :some members.[index].key
  }
  fn skip-value(_self: self): result[empty, codec/error] { :ok(.{}) }
  fn error[t](self, kind: codec/error-kind): result[t, codec/error] { :err mem/new[codec/error-info](.{ kind, location = :none }) }
}

ns internal {
  fn decode-value[d: codec/decoder](d, arena: *core/arena, scratch: *list[json], members: *list[{ key: string, value: json }]): result[json, codec/error] {
    if d.peek-kind().try is {
      :null -> { d.read-null().try; :ok :null },
      :bool -> { :ok :bool d.read-bool().try },
      :number -> if d.read-number().try is {
        :int i -> :ok :int i,
        :uint u -> :ok :uint u,
        :float f -> :ok :float f,
      },
      :string -> { :ok :str d.read-string().try },
      :seq -> {
        d.begin-seq().try
        let mark = scratch.len
        while d.begin-item(scratch.len - mark).try { scratch.push(decode-value(d, arena, scratch, members).try) }
        let items = arena.push-span(scratch.as-span().drop(mark)).as-span()
        scratch.len = mark
        :ok :array items
      },
      :map -> {
        d.begin-map().try
        let mark = members.len
        loop {
          require d.read-key(members.len - mark).try is :some key else { break }
          members.push(.{ key, value = decode-value(d, arena, scratch, members).try })
        }
        let out = arena.push-span(members.as-span().drop(mark)).as-span()
        members.len = mark
        :ok :object out
      }
    }
  }

  fn write-escape[w: writer](w, c: char) {
    w.write-char('\\')
    if c is {
      '"'  -> w.write-char('"'),
      '\\' -> w.write-char('\\'),
      '\n' -> w.write-char('n'),
      '\r' -> w.write-char('r'),
      '\t' -> w.write-char('t'),
      _ -> if c.as-u8() is {
        8  -> w.write-char('b'),
        12 -> w.write-char('f'),
        b  -> { w.write("u00"); b.write-hex(w, false) }
      }
    }
  }

  fn escape-position(s: string, from: size): size {
    let len = s.len()
    let base = s.data-ptr()
    let lanes: size = k1/simd-bytes
    let i = from
    if i + lanes <= len {
      let quote = vector/splat[u8, k1/simd-bytes]('"'.as-u8())
      let slash = vector/splat[u8, k1/simd-bytes]('\\'.as-u8())
      let high = vector/splat[u8, k1/simd-bytes](0xE0)
      let zero = vector/splat[u8, k1/simd-bytes](0)
      while i + lanes <= len {
        let chunk = vector/load-unchecked[u8, k1/simd-bytes](base.add-bytes(i))
        let hit = chunk.eq-lanes(quote).bit-or(chunk.eq-lanes(slash)).bit-or(chunk.bit-and(high).eq-lanes(zero))
        let mask = hit.to-mask()
        if mask != 0 return i + mask.trailing-zeros().signed()
        i = i + lanes
      }
    }
    while i < len {
      let c = s.[i]
      if c == '"' or c == '\\' or c < ' ' return i
      i = i + 1
    }
    len
  }

  fn newline[w: writer](w, depth: size, indent: size) {
    w.write-char('\n')
    w.repeat(" ", depth * indent)
  }

  fn skip-digits(s: string, from: size): size {
    let len = s.len()
    let lanes: size = k1/simd-bytes
    let i = from
    if i + lanes <= len {
      let chunk = vector/load-unchecked[u8, k1/simd-bytes](s.data-ptr().add-bytes(i))
      let digits = chunk.sub(vector/splat[u8, k1/simd-bytes]('0'.as-u8())).lt-lanes(vector/splat[u8, k1/simd-bytes](10))
      let all = u64/bitmask-low(lanes)
      let mask = digits.to-mask()
      if mask != all { return i + mask.bit-not().bit-and(all).trailing-zeros().signed() }
      i = i + lanes
    }
    while i < len and s.[i].is-ascii-digit() { i = i + 1 }
    i
  }

  fn string-stop(s: string, from: size): { stop: size, high: bool } {
    let len = s.len()
    let base = s.data-ptr()
    let lanes: size = k1/simd-bytes
    let i = from
    let high = false
    if i + lanes <= len {
      let quote = vector/splat[u8, k1/simd-bytes]('"'.as-u8())
      let slash = vector/splat[u8, k1/simd-bytes]('\\'.as-u8())
      let space = vector/splat[u8, k1/simd-bytes](' '.as-u8())
      let seen = vector/splat[u8, k1/simd-bytes](0)
      while i + lanes <= len {
        let chunk = vector/load-unchecked[u8, k1/simd-bytes](base.add-bytes(i))
        seen = seen.bit-or(chunk)
        let hit = chunk.eq-lanes(quote).bit-or(chunk.eq-lanes(slash)).bit-or(chunk.lt-lanes(space))
        if hit.reduce-or() != 0 {
          return .{ stop = i + hit.to-mask().trailing-zeros().signed(), high = seen.reduce-or() >= 0x80 }
        }
        i = i + lanes
      }
      high = seen.reduce-or() >= 0x80
    }
    while i < len {
      let c = s.[i]
      if c == '"' or c == '\\' or c < ' ' { return .{ stop = i, high } }
      if not c.is-ascii() { high = true }
      i = i + 1
    }
    .{ stop = len, high }
  }
}
