ns msgpack
use codec/encode
use codec/encoder
use codec/decoder

ns tag {
  let positive-fixint-max: u8 = 0x7f
  let fixmap: u8 = 0x80
  let fixarray: u8 = 0x90
  let fixstr: u8 = 0xa0
  let nil: u8 = 0xc0
  let bool-false: u8 = 0xc2
  let bool-true: u8 = 0xc3
  let bin8: u8 = 0xc4
  let bin32: u8 = 0xc6
  let ext8: u8 = 0xc7
  let ext32: u8 = 0xc9
  let float32: u8 = 0xca
  let float64: u8 = 0xcb
  let uint8: u8 = 0xcc
  let uint16: u8 = 0xcd
  let uint32: u8 = 0xce
  let uint64: u8 = 0xcf
  let int8: u8 = 0xd0
  let int16: u8 = 0xd1
  let int32: u8 = 0xd2
  let int64: u8 = 0xd3
  let fixext1: u8 = 0xd4
  let fixext16: u8 = 0xd8
  let str8: u8 = 0xd9
  let str32: u8 = 0xdb
  let array16: u8 = 0xdc
  let array32: u8 = 0xdd
  let map16: u8 = 0xde
  let map32: u8 = 0xdf
  let negative-fixint: u8 = 0xe0
}

let byte-bits: u32 = 8
let ext-type-size: size = types/size[i8]

type encoder[w] = { w: w }

ns for encoder {
  fn write-be[w: writer](self: encoder[w], tag: u8, v: u64, bytes: size) {
    if bytes == 1 {
      self.w.write-byte(tag)
      self.w.write-byte(v.trunc[u8])
      return
    }
    let unused-bits = (types/size[u64] - bytes).unsigned().trunc[u32] * byte-bits
    let buf: array[u8, 9] = uninit
    buf.[0] = tag
    mem/write-unaligned(buf.data-ptr().add-bytes(1), (v << unused-bits).swap-bytes())
    self.w.write-bytes(span/wrap-raw(buf.data-ptr(), 1 + bytes))
  }

  fn write-header[w: writer](self: encoder[w], len: size, fix: u8, fix-count: size, sized: u8, first-log2: u8) {
    let n = len.unsigned()
    if len < fix-count { self.w.write-byte(fix | n.trunc[u8]); return }
    let need: u8 = if n <= u8/max-value.widen[u64] 0 else if n <= u16/max-value.widen[u64] 1 else if n <= u32/max-value.widen[u64] 2 else crash("msgpack: length $len does not fit in 32 bits")
    let log2 = need.max(first-log2)
    self.write-be(sized + log2 - first-log2, n, (1: size) << log2.widen[u32])
  }
}

impl[w: writer] codec/encoder for encoder[w] {
  fn write-null(self) { self.w.write-byte(tag/nil) }
  fn write-bool(self, b: bool) { self.w.write-byte(if b tag/bool-true else tag/bool-false) }
  fn write-int(self, i: i64) {
    if i >= 0 self.write-uint(i.unsigned())
    else if i >= tag/negative-fixint.signed().widen[i64] self.w.write-byte(i.trunc[i8].unsigned())
    else if i >= i8/min-value.widen[i64] self.write-be(tag/int8, i.unsigned(), types/size[i8])
    else if i >= i16/min-value.widen[i64] self.write-be(tag/int16, i.unsigned(), types/size[i16])
    else if i >= i32/min-value.widen[i64] self.write-be(tag/int32, i.unsigned(), types/size[i32])
    else self.write-be(tag/int64, i.unsigned(), types/size[i64])
  }
  fn write-uint(self, u: u64) {
    if u <= tag/positive-fixint-max.widen[u64] self.w.write-byte(u.trunc[u8])
    else if u <= u8/max-value.widen[u64] self.write-be(tag/uint8, u, types/size[u8])
    else if u <= u16/max-value.widen[u64] self.write-be(tag/uint16, u, types/size[u16])
    else if u <= u32/max-value.widen[u64] self.write-be(tag/uint32, u, types/size[u32])
    else self.write-be(tag/uint64, u, types/size[u64])
  }
  fn write-float(self, f: f64) { self.write-be(tag/float64, mem/bitcast[f64, u64](f), types/size[f64]) }
  fn write-string(self, s: string) {
    self.write-header(s.len(), tag/fixstr, 32, tag/str8, 0)
    self.w.write(s)
  }
  fn begin-seq(self, len: size) { self.write-header(len, tag/fixarray, 16, tag/array16, 1) }
  fn begin-item(_self: self, _index: size) {}
  fn end-seq(_self: self) {}
  fn begin-map(self, len: size) { self.write-header(len, tag/fixmap, 16, tag/map16, 1) }
  fn write-key(self, _index: size, key: string) { self.write-string(key) }
  fn end-map(_self: self) {}
}

fn write[t: codec/encode, w: writer](w, value: t) {
  let e: encoder[w] = .{ w }
  value.encode[o = codec/opts/default](e)
}

fn to-bytes[t: codec/encode](value: t): span[byte] { to-bytes-with[o = codec/opts/default](value) }

fn to-bytes-with[t: codec/encode, o: static codec/opts](value: t): span[byte] {
  let out: list[byte] = list/empty()
  let e: encoder[*list[byte]] = .{ w = out.& }
  value.encode[o = o](e)
  out.as-span()
}

fn parse[t: codec/decode](input: span[byte]): result[t, codec/error] { parse-with[t, codec/opts/default](input) }

fn parse-with[t: codec/decode, o: static codec/opts](input: span[byte]): result[t, codec/error] {
  let d: decoder = .{ input, pos = 0, counts = list/empty(), capacity-budget = input.len() }
  let value = codec/decode@(t)/decode[o = o](d.&).try
  if d.pos != input.len() { return d.&.error(:trailing) }
  :ok value
}

type head = either { other(size), str(size), seq(size), map(size) }

type decoder = { input: span[byte], pos: size, counts: list[size], capacity-budget: size }

ns for decoder {
  fn peek-byte(*self): result[u8, codec/error] {
    if self.pos >= self.input.len() { return self.error(:unexpected-end) }
    :ok self.input.[self.pos]
  }

  fn read-byte(*self): result[u8, codec/error] {
    let b = self.peek-byte().try
    self.pos = self.pos + 1
    :ok b
  }

  fn read-bytes(*self, n: size): result[span[byte], codec/error] {
    if self.pos + n > self.input.len() { return self.error(:unexpected-end) }
    let bytes = self.input.slice(self.pos, self.pos + n)
    self.pos = self.pos + n
    :ok bytes
  }

  fn read-be(*self, bytes: size): result[u64, codec/error] {
    let p = self.read-bytes(bytes).try.data-ptr()
    :ok(if bytes is {
      1 -> mem/read-unaligned[u8](p).widen[u64],
      2 -> mem/read-unaligned[u16](p).swap-bytes().widen[u64],
      4 -> mem/read-unaligned[u32](p).swap-bytes().widen[u64],
      _ -> mem/read-unaligned[u64](p).swap-bytes(),
    })
  }

  fn read-len(*self, log2: u8): result[size, codec/error] { :ok self.read-be((1: size) << log2.widen[u32]).try.signed() }

  fn(inline) read-head(*self): result[head, codec/error] {
    let b = self.read-byte().try
    if b <= tag/positive-fixint-max or b >= tag/negative-fixint or b == tag/nil or b == tag/bool-false or b == tag/bool-true { return :ok :other 0 }
    if b < tag/fixarray { return :ok :map((b - tag/fixmap).widen[u64].signed()) }
    if b < tag/fixstr { return :ok :seq((b - tag/fixarray).widen[u64].signed()) }
    if b < tag/nil { return :ok :str((b - tag/fixstr).widen[u64].signed()) }
    if b >= tag/float32 and b <= tag/int64 { return :ok :other((1: size) << (b & 3).widen[u32]) }
    if b >= tag/bin8 and b <= tag/bin32 { return :ok :other self.read-len(b - tag/bin8).try }
    if b >= tag/ext8 and b <= tag/ext32 { return :ok :other(ext-type-size + self.read-len(b - tag/ext8).try) }
    if b >= tag/fixext1 and b <= tag/fixext16 { return :ok :other(ext-type-size + ((1: size) << (b - tag/fixext1).widen[u32])) }
    if b >= tag/str8 and b <= tag/str32 { return :ok :str self.read-len(b - tag/str8).try }
    if b >= tag/array16 and b <= tag/array32 { return :ok :seq self.read-len(b - tag/array16 + 1).try }
    if b >= tag/map16 and b <= tag/map32 { return :ok :map self.read-len(b - tag/map16 + 1).try }
    self.error(:wrong-type "value")
  }

  fn push-count(*self, count: size): result[empty, codec/error] {
    if self.counts.len >= codec/max-depth { return self.error(:depth) }
    self.counts.push(count)
    :ok(.{})
  }

  fn next-entry(*self, index: size): bool {
    if index < self.counts.[self.counts.len - 1] { return true }
    let _ = self.counts.pop()
    false
  }
}

impl codec/decoder for *decoder {
  fn peek-kind(self): result[codec/value-kind, codec/error] {
    let b = self.peek-byte().try
    if b <= tag/positive-fixint-max or b >= tag/negative-fixint or (b >= tag/float32 and b <= tag/int64) { return :ok :number }
    if b < tag/fixarray or b == tag/map16 or b == tag/map32 { return :ok :map }
    if b < tag/fixstr or b == tag/array16 or b == tag/array32 { return :ok :seq }
    if b < tag/nil or (b >= tag/str8 and b <= tag/str32) { return :ok :string }
    if b == tag/nil { return :ok :null }
    if b == tag/bool-false or b == tag/bool-true { return :ok :bool }
    self.error(:wrong-type "value")
  }

  fn read-null(self): result[empty, codec/error] {
    if self.read-byte().try != tag/nil { return self.error(:wrong-type "null") }
    :ok(.{})
  }

  fn read-bool(self): result[bool, codec/error] {
    let b = self.read-byte().try
    if b != tag/bool-false and b != tag/bool-true { return self.error(:wrong-type "bool") }
    :ok(b == tag/bool-true)
  }

  fn read-number(self): result[codec/number, codec/error] {
    let b = self.read-byte().try
    if b <= tag/positive-fixint-max { return :ok :int b.widen[u64].signed() }
    if b >= tag/negative-fixint { return :ok :int b.signed().widen[i64] }
    if b < tag/float32 or b > tag/int64 { return self.error(:wrong-type "number") }
    let v = self.read-be((1: size) << (b & 3).widen[u32]).try
    if b == tag/float32 return :ok :float mem/bitcast[u32, f32](v.trunc[u32]).widen[f64]
    if b == tag/float64 return :ok :float mem/bitcast[u64, f64](v)
    if b <= tag/uint64 return if v > i64/max-value.unsigned() :ok :uint v else :ok :int v.signed()
    let unused-bits: u32 = 64 - (byte-bits << (b & 3).widen[u32])
    :ok :int((v << unused-bits).signed() >> unused-bits)
  }

  fn read-string(self): result[string, codec/error] {
    require self.read-head().try is :str len else { return self.error(:wrong-type "string") }
    let bytes = self.read-bytes(len).try
    if not utf8/is-valid(bytes) { return self.error(:invalid-utf8) }
    :ok string/wrap-bytes(bytes)
  }

  fn begin-seq(self): result[size, codec/error] {
    require self.read-head().try is :seq count else { return self.error(:wrong-type "array") }
    self.push-count(count).try
    let hint = count.min(self.capacity-budget)
    self.capacity-budget = self.capacity-budget - hint
    :ok hint
  }

  fn begin-item(self, index: size): result[bool, codec/error] { :ok self.next-entry(index) }

  fn begin-map(self): result[empty, codec/error] {
    require self.read-head().try is :map count else { return self.error(:wrong-type "map") }
    self.push-count(count)
  }

  fn read-key(self, index: size): result[?string, codec/error] {
    if not self.next-entry(index) { return :ok :none }
    :ok :some self.read-string().try
  }

  fn skip-value(self): result[empty, codec/error] {
    let items: size = if self.read-head().try is {
      :seq count -> count,
      :map count -> count * 2,
      :other len or :str len -> { let _ = self.read-bytes(len).try; 0 },
    }
    if items > 0 {
      self.push-count(items).try
      for 0.until(items) { self.skip-value().try }
      let _ = self.counts.pop()
    }
    :ok(.{})
  }

  fn(inline) error[t](self, kind: codec/error-kind): result[t, codec/error] { :err codec/new-error(kind, :none) }
}
