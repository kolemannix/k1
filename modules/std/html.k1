ns html

type escaper[w] = { out: w }

fn entity(b: u8): string {
  if b == '&'.as-u8() "&amp;"
  else if b == '<'.as-u8() "&lt;"
  else if b == '>'.as-u8() "&gt;"
  else if b == '"'.as-u8() "&quot;"
  else if b == '\''.as-u8() "&#39;"
  else ""
}

impl[w: writer] writer for escaper[w] {
  fn write-byte(self, value: u8) {
    let e = entity(value)
    if e.len() == 0 self.out.write-byte(value) else self.out.write-string(e)
  }
  fn write-bytes(self, bytes: span[byte]) {
    let start: size = 0
    for b in bytes {
      let e = entity(b)
      if e.len() > 0 {
        self.out.write-bytes(bytes.slice(start, it-index))
        self.out.write-string(e)
        start = it-index + 1
      }
    }
    self.out.write-bytes(bytes.drop(start))
  }
}

fn write-escaped[w: writer, t: print](out: w, value: t) {
  value.print-to(escaper[w].{ out })
}

fn escape(s: string): string {
  let sb = string-builder/new()
  write-escaped(sb.&, s)
  sb.build()
}

fn is-void(name: string): bool {
  name == "br" or name == "hr" or name == "img" or name == "input" or name == "meta" or
  name == "link" or name == "area" or name == "base" or name == "col" or name == "embed" or
  name == "source" or name == "track" or name == "wbr"
}

macro write(out: code, markup: span[code-token]) {
  emit(out, markup)
}

macro render(markup: span[code-token]) {
  let cb = code-builder/new()
  cb.line("let html-sb = string-builder/new()")
  cb.write-code(emit(\html-sb.&, markup))
  cb.line("html-sb.build()")
  cb.build()
}

fn emit(out: code, markup: span[code-token]): code {
  let e: emitter = .{
    cur = token-cursor/new(markup),
    cb = code-builder/new(),
    pending = string-builder/new(),
    out,
    after-text = false,
    lead = :as-written,
  }
  e.nodes(in-block = false, raw = false)
  if not e.cur.is-at-end() e.cur.peek().fail("Unexpected `${e.cur.peek().text}`")
  e.flush()
  e.cb.build()
}

type emitter = {
  cur: token-cursor,
  cb: code-builder,
  pending: string-builder,
  out: code,
  after-text: bool,
  lead: either(u8) { as-written, trim, space },
}

ns for emitter {
  fn peek-digraph(self: *emitter, first: string, second: string): bool {
    self.cur.peek-2() is :some p and p.fst.text == first and p.snd.text == second and p.snd.spacing is :none
  }

  fn peek-self-close(self: *emitter): bool { self.peek-digraph("/", ">") }

  fn joined-continues(self: *emitter): bool {
    if self.cur.is-at-end() or self.cur.peek-text-eq(">") or self.peek-self-close() return false
    self.cur.peek().spacing is :none
  }

  fn text(self: *emitter, s: string) { self.pending.write(s) }

  fn flush(self: *emitter) {
    let s = self.pending.build()
    if s.len() == 0 return
    self.cb.write-code(self.out)
    self.cb.write(".write(${meta/str-lit(s)})\n")
    self.pending.reset()
  }

  fn dynamic(self: *emitter, value: span[code-token], raw: bool) {
    self.flush()
    if raw {
      self.cb.write("(")
      self.cb.write-tokens(value)
      self.cb.write(").print-to(")
      self.cb.write-code(self.out)
      self.cb.write(")\n")
    } else {
      self.cb.write("std/html/write-escaped(")
      self.cb.write-code(self.out)
      self.cb.write(", ")
      self.cb.write-tokens(value)
      self.cb.write(")\n")
    }
  }

  fn braced(self: *emitter): span[code-token] {
    let open = self.cur.expect("{")
    self.cur.eat-until-close(open, "}")
  }

  fn header-until-brace(self: *emitter, directive: code-token): span[code-token] {
    let start = self.cur.i
    while not self.cur.peek-text-eq("{") {
      if self.cur.is-at-end() directive.fail("Expected `{` after #${directive.text}")
      self.cur.skip(1)
    }
    self.cur.toks.slice(start, self.cur.i)
  }

  fn block(self: *emitter, raw: bool, spaced: bool) {
    let _ = self.cur.expect("{")
    self.lead = if spaced :space else :trim
    self.nodes(in-block = true, raw)
    self.flush()
    self.cur.expect("}")
    self.after-text = false
  }

  fn space-before(self: *emitter, t: code-token, is-text: bool) {
    if self.lead is {
      :trim -> {},
      :space -> self.text(" "),
      :as-written -> if t.spacing is :inline or (t.spacing is :newline and is-text and self.after-text) {
        self.text(" ")
      },
    }
    self.lead = :as-written
    self.after-text = is-text
  }

  fn nodes(self: *emitter, in-block: bool, raw: bool) {
    while not self.cur.is-at-end() {
      let t = self.cur.peek()
      if in-block and is-punct(t, "}") return
      if is-punct(t, "<") {
        if self.peek-digraph("<", "/") return
        if (not raw) and self.peek-digraph("<", "!") {
          self.space-before(t, false)
          self.doctype()
          continue
        }
        if (not raw) and self.cur.peek-2() is :some p and p.snd.kind is :ident and p.snd.spacing is :none {
          self.space-before(t, false)
          self.element()
          continue
        }
      }
      if is-punct(t, "{") {
        self.space-before(t, true)
        let value = self.braced()
        self.dynamic(value, raw)
        continue
      }
      if is-punct(t, "#") and self.cur.peek-2() is :some p and p.snd.spacing is :none {
        let n = p.snd
        if n.text == "for" or n.text == "if" {
          let spaced = self.lead is :space or (self.lead is :as-written and t.spacing is :inline)
          self.lead = :as-written
          self.after-text = false
          self.flush()
          self.cur.skip(1)
          if n.text == "for" self.directive-for(raw, spaced) else self.directive-if(raw, spaced)
          continue
        }
        if n.text == "raw" {
          self.space-before(t, true)
          self.cur.skip(2)
          let value = self.braced()
          self.dynamic(value, true)
          continue
        }
        if n.text == "{" {
          self.space-before(t, false)
          self.flush()
          self.cur.skip(1)
          self.cb.write-tokens(self.braced())
          self.cb.write("\n")
          continue
        }
      }
      self.text-token(self.cur.eat(), raw)
    }
  }

  fn text-token(self: *emitter, t: code-token, raw: bool) {
    self.space-before(t, true)
    if t.kind is :string {
      if foldable(t.text) {
        let inner = t.text.slice(1, t.text.len() - 1)
        self.text(if raw inner else escape(inner))
      } else {
        self.dynamic([t].as-span(), raw)
      }
    } else {
      self.text(if raw t.text else escape(t.text))
    }
  }

  fn doctype(self: *emitter) {
    let open = self.cur.eat()
    self.text("<")
    loop {
      if self.cur.is-at-end() open.fail("This `<!` is never closed")
      let t = self.cur.eat()
      if not (t.spacing is :none) self.text(" ")
      self.text(t.text)
      if t.text == ">" break
    }
  }

  fn directive-for(self: *emitter, raw: bool, spaced: bool) {
    let directive = self.cur.eat()
    let header = self.header-until-brace(directive)
    self.cb.write("for ")
    self.cb.write-tokens(header)
    self.cb.write(" {\n")
    self.block(raw, spaced)
    self.cb.write("}\n")
  }

  fn directive-if(self: *emitter, raw: bool, spaced: bool) {
    let directive = self.cur.eat()
    let cond = self.header-until-brace(directive)
    self.cb.write("if ")
    self.cb.write-tokens(cond)
    self.cb.write(" {\n")
    self.block(raw, spaced)
    self.cb.write("}")
    if self.cur.peek-text-eq("else") {
      self.cur.skip(1)
      self.cb.write(" else ")
      if self.peek-digraph("#", "if") {
        self.cur.skip(1)
        self.directive-if(raw, spaced)
        return
      }
      self.cb.write("{\n")
      self.block(raw, spaced)
      self.cb.write("}")
    }
    self.cb.write("\n")
  }

  fn element(self: *emitter) {
    self.cur.skip(1)
    let name-tok = self.cur.eat()
    let name = name-tok.text
    self.text("<$name")
    loop {
      if self.cur.is-at-end() name-tok.fail("<$name> has no closing `>`")
      if self.cur.peek-text-eq(">") {
        self.cur.skip(1)
        break
      }
      if self.peek-self-close() {
        self.cur.skip(2)
        self.text(if is-void(name) ">" else "></$name>")
        self.after-text = false
        return
      }
      self.attr()
    }
    self.text(">")
    self.after-text = false
    if is-void(name) return
    let raw = name == "script" or name == "style"
    self.nodes(in-block = false, raw)
    if self.cur.is-at-end() name-tok.fail("<$name> is never closed")
    self.cur.skip(1)
    let slash = self.cur.eat()
    if self.cur.is-at-end() slash.fail("Expected </$name>")
    let close-name = self.cur.eat()
    if close-name.text != name close-name.fail("</${close-name.text}> does not close <$name>")
    let _ = self.cur.expect(">")
    self.text("</$name>")
    self.after-text = false
  }

  fn attr(self: *emitter) {
    let first = self.cur.eat()
    if first.kind is :string or first.text == "=" or first.text == "{" {
      first.fail("Expected an attribute name, got `${first.text}`")
    }
    self.text(" ")
    self.text(first.text)
    while self.joined-continues() and not self.cur.peek-text-eq("=") {
      self.text(self.cur.eat().text)
    }
    if not self.cur.peek-text-eq("=") return
    let eq = self.cur.eat()
    if self.cur.is-at-end() or self.cur.peek-text-eq(">") or self.peek-self-close() eq.fail("Expected a value after `=`")
    let v = self.cur.peek()
    self.text("=\"")
    if v.kind is :string {
      self.cur.skip(1)
      if foldable(v.text) {
        self.text(escape(v.text.slice(1, v.text.len() - 1)))
      } else {
        self.dynamic([v].as-span(), false)
      }
    } else if v.text == "{" {
      let value = self.braced()
      self.dynamic(value, false)
    } else {
      self.cur.skip(1)
      self.text(escape(v.text))
      while self.joined-continues() {
        self.text(escape(self.cur.eat().text))
      }
    }
    self.text("\"")
  }
}

fn is-punct(t: code-token, text: string): bool { t.kind is :punct and t.text == text }

fn foldable(literal: string): bool {
  for c in literal {
    if c == '\\' or c == '$' return false
  }
  true
}
