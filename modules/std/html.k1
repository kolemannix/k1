ns html

type escaper[w] = { out: w }

fn escaping[w: writer](out: w): escaper[w] { .{ out } }

fn entity(b: u8): string {
  if b == '&'.as-u8() "&amp;"
  else if b == '<'.as-u8() "&lt;"
  else if b == '>'.as-u8() "&gt;"
  else if b == '"'.as-u8() "&quot;"
  else if b == '\''.as-u8() "&#39;"
  else ""
}

impl[w: writer] writer for escaper[w] {
  fn write-byte(self, value: u8) {
    let e = entity(value)
    if e.len() == 0 self.out.write-byte(value) else self.out.write-string(e)
  }
  fn write-bytes(self, bytes: span[byte]) {
    let start: size = 0
    for b in bytes {
      let e = entity(b)
      if e.non-empty() {
        self.out.write-bytes(bytes.slice(start, it-index))
        self.out.write-string(e)
        start = it-index + 1
      }
    }
    self.out.write-bytes(bytes.drop(start))
  }
}

fn write-escaped[w: writer, t: print](out: w, value: t) {
  #if types/id[t] == types/id[dom/node] value.print-to(out)
  else value.print-to(escaping(out))
}

fn escape(s: string): string {
  let sb = string-builder/new()
  write-escaped(sb.&, s)
  sb.build()
}

fn is-void(name: string): bool {
  let names: span[string] = ["br", "hr", "img", "input", "meta", "link", "area", "base", "col", "embed", "source", "track", "wbr"]
  names.contains(name)
}

fn is-boolean-attr(name: string): bool {
  let names: span[string] = [
    "allowfullscreen", "async", "autofocus", "autoplay", "checked", "controls", "default", "defer",
    "disabled", "formnovalidate", "hidden", "inert", "ismap", "itemscope", "loop", "multiple", "muted",
    "nomodule", "novalidate", "open", "playsinline", "readonly", "required", "reversed", "selected",
  ]
  names.contains(name)
}

ns dom {
  type attr = { name: string, value: either { text(string), present } }
  type element = { tag: string, attrs: list[attr], children: list[node] }
  type node = either { text(string), raw(string), attr(attr), elem(*element), frag(span[node]) }

  fn el(tag: string, mods: span[node]): node {
    let e: element = .{ tag, attrs = list/empty(), children = list/empty() }
    for m in mods {
      if m is :attr a e.attrs.push(a) else e.children.push(m)
    }
    :elem mem/new(e)
  }

  fn at[t](name: string, value: t): node {
    #if types/id[t].instance-of[opt] {
      if value is :some v at(name, v) else :frag span/empty()
    } else if value is {
      type[bool](b) -> if is-boolean-attr(name) {
        if b :attr .{ name, value = :present } else :frag span/empty()
      } else {
        :attr .{ name, value = :text b.to-string() }
      },
      _ -> :attr .{ name, value = :text value.to-string() },
    }
  }

  fn class(value: string): node { at("class", value) }
  fn id(value: string): node { at("id", value) }
  fn href(value: string): node { at("href", value) }
  fn src(value: string): node { at("src", value) }

  fn each[t](items: span[t], f: some fn t -> node): node { :frag items.map(f) }

  impl print for node {
    fn print-to[w: writer](self, w) {
      if self is {
        :text s -> write-escaped(w, s),
        :raw s -> w.write(s),
        :attr _ -> {},
        :frag nodes -> for n in nodes { n.print-to(w) },
        :elem e -> {
          w.write("<${e.tag}")
          for a in e.attrs {
            w.write(" ${a.name}")
            if a.value is :text v {
              w.write("=\"")
              write-escaped(w, v)
              w.write("\"")
            }
          }
          w.write(">")
          if is-void(e.tag) return
          for c in e.children { c.print-to(w) }
          w.write("</${e.tag}>")
        },
      }
    }
  }
}

#meta {
  let tags: span[string] = [
    "a", "abbr", "address", "area", "article", "aside", "audio", "b", "base", "bdi", "bdo", "blockquote",
    "body", "br", "button", "canvas", "caption", "cite", "code", "col", "colgroup", "data", "datalist",
    "dd", "del", "details", "dfn", "dialog", "div", "dl", "dt", "em", "embed", "fieldset", "figcaption",
    "figure", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header", "hgroup", "hr",
    "html", "i", "iframe", "img", "input", "ins", "kbd", "label", "legend", "li", "link", "main", "map",
    "mark", "menu", "meta", "meter", "nav", "noscript", "object", "ol", "optgroup", "option", "output",
    "p", "picture", "pre", "progress", "q", "rp", "rt", "ruby", "s", "samp", "script", "section",
    "select", "slot", "small", "source", "span", "strong", "style", "sub", "summary", "sup", "table",
    "tbody", "td", "template", "textarea", "tfoot", "th", "thead", "time", "title", "tr", "track", "u",
    "ul", "var", "video", "wbr",
  ]
  let cb = code-builder/new()
  cb.write("ns dom {\n")
  for tags { cb.write("fn $it(mods: span[node]): node { el(${meta/str-lit(it)}, mods) }\n") }
  cb.write("}\n")
  cb.build()
}

fn write-attr[w: writer, t](out: w, name: string, value: t, presence: bool) {
  #if types/id[t].instance-of[opt] {
    if value is :some v write-attr(out, name, v, presence)
  } else if value is {
    type[bool](b) -> if presence { if b out.write(" $name") } else { out.write(" $name=\"$b\"") },
    _ -> {
      out.write(" $name=\"")
      write-escaped(out, value)
      out.write("\"")
    },
  }
}

macro write(out: code, markup: span[code-token]) {
  emit(out, markup)
}

macro render(markup: span[code-token]) {
  let cb = code-builder/new()
  cb.line("let html-render-sb = string-builder/new()")
  cb.line("let(context(impl writer)) _html-render-out: *string-builder = html-render-sb.&")
  cb.write-code(emit(\_html-render-out, markup))
  cb.line("html-render-sb.build()")
  cb.build()
}

fn emit(out: code, markup: span[code-token]): code {
  let e: emitter = .{
    cur = token-cursor/new(markup),
    cb = code-builder/new(),
    pending = string-builder/new(),
    out,
    after-text = false,
    lead = :as-written,
  }
  e.nodes(in-block = false, raw = false)
  if not e.cur.is-at-end() e.cur.peek().fail("Unexpected `${e.cur.peek().text}`")
  e.flush()
  e.cb.build()
}

type emitter = {
  cur: token-cursor,
  cb: code-builder,
  pending: string-builder,
  out: code,
  after-text: bool,
  lead: either(u8) { as-written, trim, space },
}

ns for emitter {
  fn peek-digraph(self: *emitter, first: string, second: string): bool {
    self.cur.peek-2() is :some p and p.fst.text == first and p.snd.text == second and p.snd.spacing is :none
  }

  fn peek-self-close(self: *emitter): bool { self.peek-digraph("/", ">") }

  fn joined-continues(self: *emitter): bool {
    if self.cur.is-at-end() or self.cur.peek-text-eq(">") or self.peek-self-close() return false
    self.cur.peek().spacing is :none
  }

  fn text(self: *emitter, s: string) { self.pending.write(s) }

  fn flush(self: *emitter) {
    let s = self.pending.build()
    if s.len() == 0 return
    self.cb.write-code(self.out)
    self.cb.write(".write(${meta/str-lit(s)})\n")
    self.pending.reset()
  }

  fn dynamic(self: *emitter, value: span[code-token], raw: bool) {
    self.flush()
    if raw self.cb.write("(") else {
      self.cb.write("std/html/write-escaped(")
      self.cb.write-code(self.out)
      self.cb.write(", ")
    }
    self.cb.write-tokens(value)
    if raw {
      self.cb.write(").print-to(")
      self.cb.write-code(self.out)
    }
    self.cb.write(")\n")
  }

  fn literal(self: *emitter, t: code-token, raw: bool) {
    for t.parts {
      if it is {
        :text p -> self.text(if raw p.value else escape(p.value)),
        :hole h -> {
          if h.spec.is-empty() { self.dynamic(h.tokens, raw); continue }
          self.flush()
          if raw self.cb.write-code(self.out) else {
            self.cb.write("std/html/escaping(")
            self.cb.write-code(self.out)
            self.cb.write(")")
          }
          self.cb.write(".write(\"\${")
          self.cb.write-tokens(h.tokens)
          self.cb.write(":${h.spec}}\")\n")
        },
      }
    }
  }

  fn braced(self: *emitter): span[code-token] {
    let open = self.cur.expect("{")
    self.cur.eat-until-close(open, "}")
  }

  fn header-until-brace(self: *emitter, directive: code-token): span[code-token] {
    let start = self.cur.i
    while not self.cur.peek-text-eq("{") {
      if self.cur.is-at-end() directive.fail("Expected `{` after #${directive.text}")
      self.cur.skip(1)
    }
    self.cur.toks.slice(start, self.cur.i)
  }

  fn block(self: *emitter, raw: bool, spaced: bool) {
    self.cur.expect("{")
    self.lead = if spaced :space else :trim
    self.nodes(in-block = true, raw)
    self.flush()
    self.cur.expect("}")
    self.after-text = false
  }

  fn space-before(self: *emitter, t: code-token, is-text: bool) {
    if self.lead is {
      :trim -> {},
      :space -> self.text(" "),
      :as-written -> if t.spacing is :inline or (t.spacing is :newline and is-text and self.after-text) {
        self.text(" ")
      },
    }
    self.lead = :as-written
    self.after-text = is-text
  }

  fn nodes(self: *emitter, in-block: bool, raw: bool) {
    while not self.cur.is-at-end() {
      let t = self.cur.peek()
      if in-block and is-punct(t, "}") return
      if is-punct(t, "<") {
        if self.peek-digraph("<", "/") return
        if (not raw) and self.peek-digraph("<", "!") {
          self.space-before(t, false)
          self.doctype()
          continue
        }
        if (not raw) and self.cur.peek-2() is :some p and p.snd.kind is :ident and p.snd.spacing is :none {
          self.space-before(t, false)
          self.element()
          continue
        }
      }
      if is-punct(t, "{") {
        self.space-before(t, true)
        let value = self.braced()
        self.dynamic(value, raw)
        continue
      }
      if is-punct(t, "#") and self.cur.peek-2() is :some p and p.snd.spacing is :none {
        let n = p.snd
        if n.text == "for" or n.text == "if" {
          let spaced = self.lead is :space or (self.lead is :as-written and t.spacing is :inline)
          self.lead = :as-written
          self.after-text = false
          self.flush()
          self.cur.skip(1)
          if n.text == "for" self.directive-for(raw, spaced) else self.directive-if(raw, spaced)
          continue
        }
        if n.text == "raw" {
          self.space-before(t, true)
          self.cur.skip(2)
          let value = self.braced()
          self.dynamic(value, true)
          continue
        }
        if n.text == "{" {
          self.space-before(t, false)
          self.flush()
          self.cur.skip(1)
          self.cb.write-tokens(self.braced())
          self.cb.write("\n")
          continue
        }
      }
      self.text-token(self.cur.eat(), raw)
    }
  }

  fn text-token(self: *emitter, t: code-token, raw: bool) {
    self.space-before(t, true)
    if t.kind is :string { self.literal(t, raw) } else self.text(if raw t.text else escape(t.text))
  }

  fn doctype(self: *emitter) {
    let open = self.cur.eat()
    self.text("<")
    loop {
      if self.cur.is-at-end() open.fail("This `<!` is never closed")
      let t = self.cur.eat()
      if not (t.spacing is :none) self.text(" ")
      self.text(t.text)
      if t.text == ">" break
    }
  }

  fn directive-for(self: *emitter, raw: bool, spaced: bool) {
    let directive = self.cur.eat()
    let header = self.header-until-brace(directive)
    self.cb.write("for ")
    self.cb.write-tokens(header)
    self.cb.write(" {\n")
    self.block(raw, spaced)
    self.cb.write("}\n")
  }

  fn directive-if(self: *emitter, raw: bool, spaced: bool) {
    let directive = self.cur.eat()
    let cond = self.header-until-brace(directive)
    self.cb.write("if ")
    self.cb.write-tokens(cond)
    self.cb.write(" {\n")
    self.block(raw, spaced)
    self.cb.write("}")
    if self.cur.peek-text-eq("else") {
      self.cur.skip(1)
      self.cb.write(" else ")
      if self.peek-digraph("#", "if") {
        self.cur.skip(1)
        self.directive-if(raw, spaced)
        return
      }
      self.cb.write("{\n")
      self.block(raw, spaced)
      self.cb.write("}")
    }
    self.cb.write("\n")
  }

  fn element(self: *emitter) {
    self.cur.skip(1)
    let name-tok = self.cur.eat()
    let name = name-tok.text
    self.text("<$name")
    loop {
      if self.cur.is-at-end() name-tok.fail("<$name> has no closing `>`")
      if self.cur.peek-text-eq(">") {
        self.cur.skip(1)
        break
      }
      if self.peek-self-close() {
        self.cur.skip(2)
        self.text(if is-void(name) ">" else "></$name>")
        self.after-text = false
        return
      }
      self.attr()
    }
    self.text(">")
    self.after-text = false
    if is-void(name) return
    let raw = name == "script" or name == "style"
    self.nodes(in-block = false, raw)
    if self.cur.is-at-end() name-tok.fail("<$name> is never closed")
    self.cur.skip(1)
    let slash = self.cur.eat()
    if self.cur.is-at-end() slash.fail("Expected </$name>")
    let close-name = self.cur.eat()
    if close-name.text != name close-name.fail("</${close-name.text}> does not close <$name>")
    self.cur.expect(">")
    self.text("</$name>")
    self.after-text = false
  }

  fn attr(self: *emitter) {
    let first = self.cur.eat()
    if first.kind is :string or first.text == "=" or first.text == "{" {
      first.fail("Expected an attribute name, got `${first.text}`")
    }
    let name-sb = string-builder/new()
    name-sb.write(first.text)
    while self.joined-continues() and not self.cur.peek-text-eq("=") {
      name-sb.write(self.cur.eat().text)
    }
    let name = name-sb.build()
    if not self.cur.peek-text-eq("=") {
      self.text(" $name")
      return
    }
    let eq = self.cur.eat()
    if self.cur.is-at-end() or self.cur.peek-text-eq(">") or self.peek-self-close() eq.fail("Expected a value after `=`")
    let v = self.cur.peek()
    if v.text == "{" {
      let value = self.braced()
      self.flush()
      self.cb.write("std/html/write-attr(")
      self.cb.write-code(self.out)
      self.cb.write(", ${meta/str-lit(name)}, ")
      self.cb.write-tokens(value)
      self.cb.write(", presence = ${is-boolean-attr(name)})\n")
      return
    }
    self.text(" $name=\"")
    if v.kind is :string {
      self.cur.skip(1)
      self.literal(v, false)
    } else {
      self.cur.skip(1)
      self.text(escape(v.text))
      while self.joined-continues() {
        self.text(escape(self.cur.eat().text))
      }
    }
    self.text("\"")
  }
}

fn is-punct(t: code-token, text: string): bool { t.kind is :punct and t.text == text }
