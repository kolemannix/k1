ns crypto

type sha256 = { state: array[u32, 8], block: array[u8, 64], block-len: size, total-len: u64 }

ns for sha256 {
  let INIT: array[u32, 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
  ]
  let K: array[u32, 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  ]

  fn new(): sha256 { .{ state = INIT, block = .0, block-len = 0, total-len = 0 } }

  fn compress(state: *array[u32, 8], block: ptr) {
    let w: array[u32, 64] = uninit
    let i: size = 0
    while i < 16 {
      w.[i] = mem/read-unaligned[u32](block.add-bytes(i * 4)).swap-bytes()
      i = i + 1
    }
    while i < 64 {
      let x = w.[i - 15]
      let y = w.[i - 2]
      let s0 = x.rotate-right(7) ^ x.rotate-right(18) ^ (x >> 3)
      let s1 = y.rotate-right(17) ^ y.rotate-right(19) ^ (y >> 10)
      w.[i] = w.[i - 16] + s0 + w.[i - 7] + s1
      i = i + 1
    }
    let a = state.[0]
    let b = state.[1]
    let c = state.[2]
    let d = state.[3]
    let e = state.[4]
    let f = state.[5]
    let g = state.[6]
    let h = state.[7]
    i = 0
    while i < 64 {
      let s1 = e.rotate-right(6) ^ e.rotate-right(11) ^ e.rotate-right(25)
      let ch = (e & f) ^ (e.bit-not() & g)
      let t1 = h + s1 + ch + K.[i] + w.[i]
      let s0 = a.rotate-right(2) ^ a.rotate-right(13) ^ a.rotate-right(22)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let t2 = s0 + maj
      h = g
      g = f
      f = e
      e = d + t1
      d = c
      c = b
      b = a
      a = t1 + t2
      i = i + 1
    }
    state.[0] = state.[0] + a
    state.[1] = state.[1] + b
    state.[2] = state.[2] + c
    state.[3] = state.[3] + d
    state.[4] = state.[4] + e
    state.[5] = state.[5] + f
    state.[6] = state.[6] + g
    state.[7] = state.[7] + h
  }

  fn update(self: *self, data: span[u8]) {
    self.total-len = self.total-len + data.len().unsigned()
    let rest = data
    if self.block-len > 0 {
      let room = 64 - self.block-len
      let take = if rest.len() < room rest.len() else room
      buffer/copy(src = rest.take(take).inner-buffer(), dst = self.block.&.as-buffer().slice(self.block-len, self.block-len + take))
      self.block-len = self.block-len + take
      rest = rest.drop(take)
      if self.block-len < 64 return
      compress(self.state.&, self.block.&.as[ptr])
      self.block-len = 0
    }
    while rest.len() >= 64 {
      compress(self.state.&, rest.data-ptr())
      rest = rest.drop(64)
    }
    if rest.non-empty() {
      buffer/copy(src = rest.inner-buffer(), dst = self.block.&.as-buffer().slice(0, rest.len()))
      self.block-len = rest.len()
    }
  }

  fn finish(self: *self): array[u8, 32] {
    let bit-len = self.total-len * 8
    self.block.[self.block-len] = 0x80
    self.block-len = self.block-len + 1
    if self.block-len > 56 {
      while self.block-len < 64 {
        self.block.[self.block-len] = 0
        self.block-len = self.block-len + 1
      }
      compress(self.state.&, self.block.&.as[ptr])
      self.block-len = 0
    }
    while self.block-len < 56 {
      self.block.[self.block-len] = 0
      self.block-len = self.block-len + 1
    }
    mem/write-unaligned(self.block.&.as[ptr].add-bytes(56), bit-len.swap-bytes())
    compress(self.state.&, self.block.&.as[ptr])
    let out: array[u8, 32] = uninit
    let i: size = 0
    while i < 8 {
      mem/write-unaligned(out.&.as[ptr].add-bytes(i * 4), self.state.[i].swap-bytes())
      i = i + 1
    }
    out
  }

  fn hash(data: span[u8]): array[u8, 32] {
    let h = new()
    h.&.update(data)
    h.&.finish()
  }
}

type hmac-sha256 = { inner: sha256, okey: array[u8, 64] }

ns for hmac-sha256 {
  fn new(key: span[u8]): hmac-sha256 {
    let block: array[u8, 64] = .0
    if key.len() > 64 {
      let digest = sha256/hash(key)
      buffer/copy(src = digest.&.as-buffer(), dst = block.&.as-buffer().slice(0, 32))
    } else {
      buffer/copy(src = key.inner-buffer(), dst = block.&.as-buffer().slice(0, key.len()))
    }
    let ikey: array[u8, 64] = uninit
    let okey: array[u8, 64] = uninit
    let i: size = 0
    while i < 64 {
      ikey.[i] = block.[i] ^ 0x36
      okey.[i] = block.[i] ^ 0x5c
      i = i + 1
    }
    let inner = sha256/new()
    inner.&.update(ikey.&.as-span())
    .{ inner, okey }
  }

  fn update(self: *self, data: span[u8]) { self.inner.&.update(data) }

  fn finish(self: *self): array[u8, 32] {
    let inner-digest = self.inner.&.finish()
    let outer = sha256/new()
    outer.&.update(self.okey.&.as-span())
    outer.&.update(inner-digest.&.as-span())
    outer.&.finish()
  }

  fn hash(key: span[u8], data: span[u8]): array[u8, 32] {
    let h = new(key)
    h.&.update(data)
    h.&.finish()
  }
}
