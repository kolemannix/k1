// Disclaimer: This is a temporary, ai-generated utility to test the compiler and push the http project forward
type notify = { state: ptr, notify-fn: *fn(ptr) -> {} }
ns for notify {
  fn notify(self: notify) { (self.notify-fn)(self.state) }
}

// Lock-free multi-producer single-consumer handoff: send from any thread,
// take on the consumer's thread. Each send allocates one node and fires the
// notify; take drains everything queued in send order.
type mpsc-node[t] = { value: t, next: ptr }
type mpsc[t] = { head: ptr, on-send: notify }

ns for mpsc {
  fn make[t](on-send: notify): *mpsc[t] {
    heap.new(.{ head = ptr/null, on-send })
  }

  // Any thread
  fn send[t](self: *mpsc[t], value: t) {
    let node: *mpsc-node[t] = heap.new(.{ value, next = ptr/null })
    loop {
      let old = atomic/load(self.head.&, :relaxed)
      node.next = old
      if atomic/cmpxchg-weak(self.head.&, old, node.as[ptr], :release, :relaxed).ok { break }
    }
    self.on-send.notify()
  }

  // Consumer thread only. Appends every queued value to `out` (assumed
  // empty) in send order; out's pushes go to the system heap.
  fn take[t](self: *mpsc[t], out: *list[t]) {
    let n = atomic/xchg(self.head.&, ptr/null, :acquire)
    while not (n is null) {
      let node = n.ref[mpsc-node[t]]
      out.push-in(heap, node.value)
      n = node.next
      heap.free-t(node)
    }
    out.reverse()
  }
}

// A bounded single-consumer queue whose receive side is a stream source:
// callbacks push, the stream pulls, all on the consumer's thread. Items
// handed out by a pull are owned by the puller; items still queued at
// close-and-free are released through drop-fn. cap-weight bounds the queue
// in weight-fn units (pass fn(_) 1 for a plain item count).
type channel[t] = {
  queue: list[t],
  queued-weight: size,
  cap-weight: size,
  weight-fn: *fn(t) -> size,
  drop-fn: *fn(t) -> {},
  ?waker,
  pending-wake: bool,
  failure: ?string,
  closed: bool,
  // backing for the emitted one-item, single-segment group
  part: t,
  seg: span[t],
}

ns for channel {
  fn make[t](cap-weight: size, weight-fn: *fn(t) -> size, drop-fn: *fn(t) -> {}): *channel[t] {
    heap.new(.{
      queue = list/empty[t](),
      queued-weight = 0,
      cap-weight,
      weight-fn,
      drop-fn,
      waker = :none,
      pending-wake = false,
      failure = :none,
      closed = false,
      part = uninit,
      seg = span/empty(),
    })
  }

  // False if closed, failed, or over cap; a rejected value stays owned by
  // the caller, who picks the policy (drop it, fail() the channel, ...)
  fn push[t](self: *channel[t], value: t): bool {
    if self.closed or self.failure.is-some() { return false }
    let w = (self.weight-fn)(value)
    if self.queued-weight + w > self.cap-weight { return false }
    self.queue.push-in(heap, value)
    self.queued-weight = self.queued-weight + w
    self.pending-wake = true
    true
  }

  // Poison: the stream fails on its next pull
  fn fail[t](self: *channel[t], message: string) {
    self.failure = :some message
    self.pending-wake = true
  }

  // Wake the consumer if anything happened since the last wake. Callers that
  // batch pushes (e.g. a dispatch loop) defer this until the batch is done.
  fn flush[t](self: *channel[t]) {
    if not self.pending-wake { return }
    self.pending-wake = false
    if self.waker is :some w { w.wake() }
  }

  // Drop queued items and free the channel; call only when no more pushes
  // can arrive.
  fn close-and-free[t](self: *channel[t]) {
    self.closed = true
    for item in self.queue { (self.drop-fn)(item) }
    if self.queue.cap() > 0 {
      heap.free(self.queue.data-ptr(), self.queue.cap() * types/size[t], types/align[t])
    }
    heap.free-t(self)
  }
}

impl[t] source[t = t] for channel[t] {
  fn start(self: *channel[t], waker: waker) { self.waker = :some waker }
  fn next(self: *channel[t]): pull[t] {
    if self.failure is :some message { return :fail message }
    if self.queue.is-empty() { return :pending }
    let item = self.queue.[0]
    self.queue.remove(0)
    self.queued-weight = self.queued-weight - (self.weight-fn)(item)
    self.part = item
    self.seg = span/wrap-single(self.part.&)
    :chunk span/wrap-single(self.seg.&)
  }
  fn stop(self: *channel[t]) { channel/close-and-free(self) }
}
