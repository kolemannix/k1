ability hasher {
  fn hash-bytes(*self, span[u8])
  fn finish(*self): u64

  fn hash-u8(*self, u8) { 
    let data = u8.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-u16(*self, u16) {
    let data = u16.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-u32(*self, u32) {
    let data = u32.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-u64(*self, u64) {
    let data = u64.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-i8(*self, i8) { 
    let data = i8.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-i16(*self, i16) {
    let data = i16.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-i32(*self, i32) {
    let data = i32.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-i64(*self, i64) {
    let data = i64.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-length-prefix(*self, size) {
    self.hash-i64(size)
  }
}
ability hash {
  fn hash[h: hasher](self, *h)
}

ns murmur3 {
  fn fmix64(h0: u64): u64 {
    let m1: u64 = 0xff51afd7ed558ccd
    let m2: u64 = 0xc4ceb9fe1a85ec53
    let h = h0 ^ (h0 >> 33)
    h = h * m1
    h = h ^ (h >> 33)
    h = h * m2
    h ^ (h >> 33)
  }
}

ns wordhash {
  fn(inline) mix-word(h: u64, w: u64): u64 {
    (h.rotate-left(5) ^ w) * 0x9E3779B97F4A7C15
  }

  fn hash-bytes(bytes: span[u8]): u64 {
    let p = bytes.data-ptr()
    let len = bytes.len()
    let h: wordhasher = wordhasher/new()
    // nocommit: this was an xor, but hash-length-prefix just incorporates it as a size.
    h.hash-length-prefix(len)
    let h: u64 = 0xcbf29ce484222325 ^ len.u()

    if len >= 8 {
      let i: size = 0
      while i + 8 <= len {
        h = mix-word(h, mem/read-unaligned[u64](p.ref-at[u8](i).as[ptr]))
        i = i + 8
      }
      if i < len { h = mix-word(h, mem/read-unaligned[u64](p.ref-at[u8](len - 8).as[ptr])) }
    } else if len >= 4 {
      let head = mem/read-unaligned[u32](p).as[u64]
      let tail = mem/read-unaligned[u32](p.ref-at[u8](len - 4).as[ptr]).as[u64]
      h = mix-word(h, (head << 32) | tail)
    } else if len > 0 {
      let first = p.ref-at[u8](0).*.as[u64]
      let middle = p.ref-at[u8](len >> 1).*.as[u64]
      let last = p.ref-at[u8](len - 1).*.as[u64]
      h = mix-word(h, (first << 16) | (middle << 8) | last)
    }
    murmur3/fmix64(h)
  }
}

ns fnv1a {
  fn hash-bytes(bytes: span[u8]): u64 {
    let h: u64 = 0xcbf29ce484222325
    for b in bytes { h = (h ^ b.as[u64]) * 0x100000001b3 }
    h
  }
}

type wordhasher = { state: u64 }
ns for wordhasher {
  let default-seed: u64 = 0xcbf29ce484222325
  fn new(): self { .{ state = default-seed } }
  fn from-seed(seed: u64): self { .{ state = seed } }
}
impl hasher for wordhasher {
  fn hash-bytes(*self, span[u8]) {

  }
  fn hash-length-prefix(*self, len: size) {
    self.state = self.state ^ len.u()
  }
  fn finish(*self): u64 { murmur3/fmix64(self.state) }
}

impl hash for u8   { fn hash[h: hasher](self, *h) { h.hash-u8(self) } }
impl hash for u16  { fn hash[h: hasher](self, *h) { h.hash-u16(self) } }
impl hash for u32  { fn hash[h: hasher](self, *h) { h.hash-u32(self) } }
impl hash for u64  { fn hash[h: hasher](self, *h) { h.hash-u64(self) } }
impl hash for i8   { fn hash[h: hasher](self, *h) { h.hash-i8(self) } }
impl hash for i16  { fn hash[h: hasher](self, *h) { h.hash-i16(self) } }
impl hash for i32  { fn hash[h: hasher](self, *h) { h.hash-i32(self) } }
impl hash for i64  { fn hash[h: hasher](self, *h) { h.hash-i64(self) } }
impl hash for char { fn hash[h: hasher](self, *h) { h.hash-u8(self.as-u8()) } }
impl hash for bool { fn hash[h: hasher](self, *h) { h.hash-u8(self.as-u8()) } }

impl hash for span[u8] { fn hash[h: hasher](self, *h) { h.hash-bytes(self) } }
impl hash for string { fn hash[h: hasher](self, *h) {   h.hash-bytes(self.span-bytes()) } }

