ability hasher {
  fn hash-bytes(*self, span[u8])
  fn finish(*self): u64

  fn hash-u8(*self, u8) {
    let data = u8.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-u16(*self, u16) {
    let data = u16.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-u32(*self, u32) {
    let data = u32.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-u64(*self, u64) {
    let data = u64.to-bytes-ne()
    self.hash-bytes(data.as-span())
  }

  fn hash-length-prefix(*self, size) { self.hash-u64(size.u()) }
}

ability hash {
  fn hash-to[h: hasher](self, *h)

  fn hash(self): u64 {
    let h = wordhasher/new()
    self.hash-to(h.&)
    h.finish()
  }
}

ns murmur3 {
  fn fmix64(h0: u64): u64 {
    let m1: u64 = 0xff51afd7ed558ccd
    let m2: u64 = 0xc4ceb9fe1a85ec53
    let h = h0 ^ (h0 >> 33)
    h = h * m1
    h = h ^ (h >> 33)
    h = h * m2
    h ^ (h >> 33)
  }
}

ns fnv1a {
  fn hash-bytes(bytes: span[u8]): u64 {
    let h: u64 = 0xcbf29ce484222325
    for b in bytes { h = (h ^ b.as[u64]) * 0x100000001b3 }
    h
  }
}

type wordhasher = { state: u64 }
ns for wordhasher {
  let default-seed: u64 = 0xcbf29ce484222325
  fn new(): self { .{ state = default-seed } }
  fn from-seed(seed: u64): self { .{ state = seed } }

  fn(inline) mix-word(*self, w: u64) {
    self.state = (self.state.rotate-left(5) ^ w) * 0x9E3779B97F4A7C15
  }
}
impl hasher for wordhasher {
  fn hash-bytes(*self, bytes: span[u8]) {
    let p = bytes.data-ptr()
    let len = bytes.len()
    self.state = self.state ^ len.u()

    if len >= 8 {
      let i: size = 0
      while i + 8 <= len {
        let this-word = p.add-bytes(i).read-unaligned[u64]
        self.mix-word(this-word)
        i = i + 8
      }
      if i < len {
        let this-word = p.add-bytes(len - 8).read-unaligned[u64]
        self.mix-word(this-word)
      }
    } else if len >= 4 {
      let head = p.read-unaligned[u32].as[u64]
      let tail = p.add-bytes(len - 4).read-unaligned[u32]().as[u64]
      self.mix-word((head << 32) | tail)
    } else if len > 0 {
      let first = bytes.[0].as[u64]
      let middle = bytes.[len >> 1].as[u64]
      let last = bytes.[len - 1].as[u64]
      self.mix-word((first << 16) | (middle << 8) | last)
    } else {
      self.mix-word(0xFF)
    }
  }
  fn hash-u8(*self, u8) { self.mix-word(u8.as[u64]) }
  fn hash-u16(*self, u16) { self.mix-word(u16.as[u64]) }
  fn hash-u32(*self, u32) { self.mix-word(u32.as[u64]) }
  fn hash-u64(*self, u64) { self.mix-word(u64) }
  fn finish(*self): u64 { murmur3/fmix64(self.state) }
}

impl hash for u8   { fn hash-to[h: hasher](self, *h) { h.hash-u8(self) } }
impl hash for u16  { fn hash-to[h: hasher](self, *h) { h.hash-u16(self) } }
impl hash for u32  { fn hash-to[h: hasher](self, *h) { h.hash-u32(self) } }
impl hash for u64  { fn hash-to[h: hasher](self, *h) { h.hash-u64(self) } }
impl hash for i8   { fn hash-to[h: hasher](self, *h) { h.hash-u8(self.u()) } }
impl hash for i16  { fn hash-to[h: hasher](self, *h) { h.hash-u16(self.u()) } }
impl hash for i32  { fn hash-to[h: hasher](self, *h) { h.hash-u32(self.u()) } }
impl hash for i64  { fn hash-to[h: hasher](self, *h) { h.hash-u64(self.u()) } }
impl hash for char { fn hash-to[h: hasher](self, *h) { h.hash-u8(self.as-u8()) } }
impl hash for bool { fn hash-to[h: hasher](self, *h) { h.hash-u8(self.as-u8()) } }

impl hash for span[u8] { fn hash-to[h: hasher](self, *h) { h.hash-bytes(self) } }
impl hash for string { fn hash-to[h: hasher](self, *h) { h.hash-bytes(self.span-bytes()) } }

