// Disclaimer: This is a temporary, ai-generated utility to test the compiler and push the http project forward
// Topic-based publish/subscribe: an mpsc ingress, a topic router, and a
// channel per subscriber, generic over the payload.
//
//   pubsub/create[t](on-event, cap, weight)  on-event fires on publish (any thread);
//                                            wire it to wake your loop, then call
//                                            bus.dispatch() on the consumer thread
//   bus.publish(topic, value: rc[t])         from any thread; takes one reference
//   bus.subscribe(topic)                     a dyn[source[t = rc[t]]], one event per pull;
//                                            any thread
//
// Topics are unique strings that exist by use. The bus knows nothing about
// event loops or wire formats: the consumer drives dispatch(), and
// subscribers pull rc'd payloads and apply their own unwrapping and framing.
//
// Delivery is at-most-once, no replay: subscribers only see events published
// while they're connected. A subscriber lagging more than the bus's
// cap-weight of undelivered payloads (in weight-fn units) is failed.
ns pubsub {

  type event[t] = {
    // both released after dispatch; data is retained per matching subscriber
    topic: rc[string],
    data: rc[t],
  }

  type bus[t] = {
    ingress: *mut mpsc[event[t]],
    // consumer thread: reused drain buffer
    scratch: list[event[t]],
    // consumer thread only
    subscribers: list[*mut subscription[t]],
    subscriber-cap-weight: size,
    weight-fn: *fn(rc[t]) -> size,
  }

  fn create[t](
    on-event: notify,
    subscriber-cap-weight: size,
    weight-fn: *fn(rc[t]) -> size,
  ): *mut bus[t] {
    heap.new(.{
      ingress = mpsc/make[event[t]](on-event),
      scratch = list/empty[event[t]](),
      subscribers = list/empty[*mut subscription[t]](),
      subscriber-cap-weight,
      weight-fn,
    })
  }

  ns for bus {
    // Any thread. Takes ownership of one reference to `value`.
    fn publish[t](self: *mut bus[t], topic: string, value: rc[t]) {
      self.ingress.send(.{
        topic = heap-string/cloned(topic).to-rc(),
        data = value,
      })
    }

    // Any thread: only allocates; the bus learns about the subscription when
    // the consumer start()s the stream on its own thread.
    fn subscribe[t](self: *mut bus[t], topic: string): dyn[source[t = rc[t]]] {
      let chan = channel/make[rc[t]](
        cap-weight = self.subscriber-cap-weight,
        weight-fn = self.weight-fn,
        drop-fn = fn(value: rc[t]) value.release(),
      )
      let sub: *mut subscription[t] = heap.new(.{
        bus = self,
        topic = heap-string/cloned(topic).to-rc(),
        chan,
      })
      sub.to-dyn()
    }

    // Consumer thread only: route every queued event to its subscribers,
    // then wake the ones that got something.
    fn dispatch[t](self: *mut bus[t]) {
      self.scratch.clear()
      self.ingress.take(self.scratch.&)
      for event in self.scratch {
        for sub in self.subscribers {
          if sub.topic.get().* == event.topic.get().* {
            let payload = event.data.retain()
            if not sub.chan.push(payload) {
              payload.release()
              sub.chan.fail("subscriber exceeded backlog cap")
            }
          }
        }
        event.topic.release()
        event.data.release()
      }
      self.scratch.clear()

      // Flush after dispatch, on a snapshot: a woken stream can fail
      // synchronously and detach its subscription from subscribers, so never
      // wake while iterating that list. One flush per subscriber also
      // coalesces multi-event batches.
      let to-flush = mem/with-arena(mem/tmp(), self.subscribers.cloned())
      for sub in to-flush { sub.chan.flush() }
    }
  }

  // The channel receiver wearing a topic: registers with the bus in start(),
  // detaches and frees everything it owns in stop().
  type subscription[t] = {
    bus: *mut bus[t],
    topic: rc[string],
    chan: *mut channel[rc[t]],
  }

  impl[t] source[t = rc[t]] for subscription[t] {
    fn next(self: *mut subscription[t]): pull[rc[t]] {
      source@(channel[rc[t]])/next(self.chan)
    }

    fn start(self: *mut subscription[t], waker: waker) {
      source@(channel[rc[t]])/start(self.chan, waker)
      self.bus.subscribers.push-in(heap, self)
    }

    fn stop(self: *mut subscription[t]) {
      let bus = self.bus
      let sub-ptr = self.as[ptr]
      let i: size = 0
      while i < bus.subscribers.len() {
        if bus.subscribers.get(i).as[ptr] == sub-ptr {
          bus.subscribers.remove(i)
        } else {
          i = i + 1
        }
      }
      self.chan.close-and-free()
      self.topic.release()
      heap.free-t(self)
    }
  }
}
