ns posix {

  use core/c-int
  use core/c-sizet
  use core/c-varargs

  let stdin: i32  = 0
  let stdout: i32 = 1
  let stderr: i32 = 2

  let O_RDONLY: c-int = 0x0000
  let O_WRONLY: c-int = 0x0001
  let O_RDWR  : c-int = 0x0002
  fn O_CREAT(): c-int { k1/select-os(macos = fn. 0x0200, linux = fn. 0x40) }
  fn O_TRUNC(): c-int { k1/select-os(macos = fn. 0x0400, linux = fn. 0x200) }
  fn O_SEARCH(): c-int { k1/select-os(macos = fn. 0x40100000, linux = fn. 0x200000) }
  fn O_EXEC(): c-int { k1/select-os(macos = fn. 0x40000000, linux = fn. 0x200000) }
  fn(extern) open(path: *u8, oflag: c-int, c-varargs): c-int
  fn(extern) read(file-no: c-int, buffer: ptr, count: c-sizet): i64
  fn(extern) write(file-no: c-int, data: ptr, count: c-sizet): i64
  fn(extern) isatty(fd: c-int): c-int
  fn(extern) mkdir(path: *u8, mode: c-int): c-int
  fn(extern) link(from: *u8, to: *u8): c-int
  fn(extern) rename(from: *u8, to: *u8): c-int
  fn(extern) rmdir(path: *u8): c-int
  fn(extern) opendir(path: *u8): ptr
  fn(extern) readdir(dir: ptr): ptr
  fn(extern) closedir(dir: ptr): c-int
  type pollfd = { fd: c-int, events: i16, revents: i16 }
  let POLLIN: i16 = 1
  fn(extern) poll(fds: ptr, nfds: u64, timeout: c-int): c-int

  let SEEK_SET: c-int = 0
  let SEEK_END: c-int = 2
  fn(extern) lseek(fd: c-int, offset: i64, whence: c-int): i64

  let MAP_FILE   : c-int = 0x0000
  let MAP_SHARED : c-int = 0x0001
  let MAP_PRIVATE: c-int = 0x0002
  let MAP_FIXED  : c-int = 0x0010
  // MAP_ANONYMOUS = 0x20 on Linux, but MAP_ANON = 0x1000 on macOS.
  fn MAP_ANON(): c-int { k1/select-os(macos = fn. 0x1000, linux = fn. 0x20) }

  // Pages may not be accessed.
  let PROT_NONE: c-int = 0x0
  // Pages may be read.
  let PROT_READ: c-int = 0x1
  // Pages may be written.
  let PROT_WRITE: c-int = 0x2
  // Pages may be executed.
  let PROT_EXEC: c-int = 0x4
  let MAP_FAILED: i64 = -1
  fn(extern) mmap(addr: ptr, len: size, prot: i32, flags: c-int, fd: c-int, offset: size): ptr

  fn(extern) munmap(addr: ptr, len: size): i32

  let MADV_SEQUENTIAL: i32 = 2
  fn(extern("posix_madvise")) madvise(addr: ptr, len: c-sizet, advice: c-int): c-int

  fn(extern) backtrace(buffer: ptr, size: c-int)

  type timespec = { tv_sec: u64, tv_nsec: u64 }
  type(alias) clockid_t = c-int
  let CLOCK_REALTIME: clockid_t = 0
  let CLOCK_MONOTONIC: clockid_t = 1
  fn(extern) clock_gettime(clockid: clockid_t, tp: *timespec): c-int
  fn(extern) nanosleep(req: *timespec, rem: ptr): c-int
  type mach-timebase = { numer: u32, denom: u32 }
  fn(extern) mach_absolute_time(): u64
  fn(extern) mach_timebase_info(timebase: *mach-timebase): u64

  fn(extern) pthread_create(thread: ptr, attrs: ptr, start_routine: ptr, input: ptr): i32
  fn(extern) pthread_join(thread: ptr, retval: ptr): i32
  fn(extern) pthread_detach(thread: ptr): i32
  fn(extern) sysconf(name: c-int): i64

  fn(extern) fork(): i32
  fn(extern) execve(path: *u8, argv: ptr, envp: ptr): i32
  fn(extern) waitpid(pid: i32, status: *i32, options: i32): i32
  let SIGHUP : c-int = 1
  let SIGINT : c-int = 2
  let SIGKILL: c-int = 9
  let SIGPIPE: c-int = 13
  let SIGTERM: c-int = 15
  fn SIGUSR1(): c-int { k1/select-os(macos = fn. 30, linux = fn. 10) }
  fn SIGUSR2(): c-int { k1/select-os(macos = fn. 31, linux = fn. 12) }
  fn(extern) kill(pid: i32, sig: c-int): c-int

  fn(extern) pipe(fds: ptr): c-int
  fn(extern) close(fd: c-int): c-int
  fn(extern) dup2(fd: c-int, fd2: c-int): c-int

  fn(extern) posix_spawn(pid: *i32, path: *u8, file-actions: ptr, attrp: ptr, argv: ptr, envp: ptr): c-int
  fn(extern) posix_spawn_file_actions_init(file-actions: ptr): c-int
  fn(extern) posix_spawn_file_actions_destroy(file-actions: ptr): c-int
  fn(extern) posix_spawn_file_actions_adddup2(file-actions: ptr, fd: c-int, new-fd: c-int): c-int
  fn(extern) posix_spawn_file_actions_addclose(file-actions: ptr, fd: c-int): c-int

  let RTLD_NOW: c-int = 0x2
  fn RTLD_LOCAL(): c-int { k1/select-os(macos = fn. 0x4, linux = fn. 0) }
  fn(extern) dlopen(path: optref[u8], mode: c-int): ptr
  fn(extern) dlsym(handle: ptr, symbol: *u8): ptr
  fn(extern) dlclose(handle: ptr): c-int
  fn(extern) dlerror(): optref[u8]

  fn(extern) getentropy(buf: ptr, count: c-sizet): c-int

  fn(extern) readlink(path: *u8, buf: ptr, bufsize: c-sizet): i64
  fn(extern) unlink(path: *u8): c-int
  let F_OK: c-int = 0
  let X_OK: c-int = 1
  fn(extern) access(path: *u8, mode: c-int): c-int

  fn(extern) _NSGetEnviron(): ptr
  let(extern) environ: ptr
  fn environ-ptr(): ptr {
    k1/select-os(macos = fn. _NSGetEnviron().ref[ptr].*, linux = fn. environ)
  }

  // The scalar convention over the bindings above -- bytes moved or -errno,
  // negative fd on failed open, retryable interruptions absorbed
  ns port {
    use core/platform/io/file-handle

    fn or-errno(rc: c-int): i32 { if rc < 0 { 0 - libc/errno() } else rc }

    fn read(file-no: i32, buffer: ptr, count: size): i64 {
      let n = posix/read(file-no, buffer, count.unsigned())
      while n < 0 and libc/errno() == libc/EINTR {
        n = posix/read(file-no, buffer, count.unsigned())
      }
      if n < 0 { 0 - libc/errno().widen[i64] } else n
    }
    fn poll-readable(file-no: i32): bool {
      let p: pollfd = .{ fd = file-no, events = POLLIN, revents = 0 }
      let n = poll(p.&.as[ptr], 1, 0)
      while n < 0 and libc/errno() == libc/EINTR {
        n = poll(p.&.as[ptr], 1, 0)
      }
      n > 0
    }
    fn open-to-read(path: string): i32 { or-errno(open(path.to-c-tmp(), O_RDONLY, .{})) }
    fn open-to-write(path: string): i32 {
      let create-mode-rw-all: c-int = 0x1B6
      or-errno(open(path.to-c-tmp(), O_WRONLY | O_CREAT() | O_TRUNC(), .{ mode = create-mode-rw-all }))
    }
    fn close(fd: i32) { let _ = posix/close(fd) }
    fn make-dir(path: string): i32 { or-errno(mkdir(path.to-c-tmp(), 0o755)) }
    fn link(from: string, to: string): i32 { or-errno(posix/link(from.to-c-tmp(), to.to-c-tmp())) }
    fn rename(from: string, to: string): i32 { or-errno(posix/rename(from.to-c-tmp(), to.to-c-tmp())) }
    fn remove(path: string): i32 { or-errno(unlink(path.to-c-tmp())) }
    fn remove-dir(path: string): i32 { or-errno(rmdir(path.to-c-tmp())) }
    fn dir-open(path: string): result[files/dir-handle, i32] {
      let dir = opendir(path.to-c-tmp())
      if dir.is-null() :err(libc/errno()) else :ok(.{ raw = dir })
    }
    fn dir-next(dir: ptr): ?string {
      let entry = readdir(dir)
      let name-offset: size = k1/select-os(macos = fn. 21, linux = fn. 19)
      if entry.is-null() :none else :some(string/wrap-c(entry.add-bytes(name-offset).ref[u8]))
    }
    fn dir-close(dir: ptr) { let _ = closedir(dir) }
    fn file-size(fd: i32): i64 {
      let end = lseek(fd, 0, SEEK_END)
      lseek(fd, 0, SEEK_SET)
      end
    }

    fn env-get(name: string): ?string {
      let v = libc/getenv(name.to-c-tmp())
      if v.is-null() :none else :some(string/wrap-c(v.get()))
    }

    fn dylib-open(path: string): ptr {
      dlopen(path.to-c-tmp().as(), RTLD_NOW | RTLD_LOCAL())
    }
    fn dylib-open-self(): ptr { dlopen(.0, RTLD_NOW) }
    fn dylib-sym(lib: ptr, name: string): ptr { dlsym(lib, name.to-c-tmp()) }
    fn dylib-close(lib: ptr) { let _ = dlclose(lib) }

    // getentropy caps each call at 256 bytes
    fn random-fill(dest: ptr, count: size) {
      let done: size = 0
      while done < count {
        let n = if count - done > 256 256 else count - done
        if getentropy(dest.add-bytes(done), n.unsigned()) != 0 crash("getentropy failed")
        done = done + n
      }
    }

    let(mutable) timebase: mach-timebase = .{ numer = 0, denom = 0 }

    fn mach-counter-to-nanos(counter: u64): u64 {
      if timebase.denom == 0 { mach_timebase_info(timebase.&) }
      counter * timebase.numer.widen[u64] / timebase.denom.widen[u64]
    }

    fn get-time(clockid: clockid_t): u64 {
      let ts: timespec = .0
      clock_gettime(clockid, ts.&)
      ts.tv_sec * 1_000_000_000 + ts.tv_nsec
    }

    fn counter(): u64 {
      k1/select-os(macos = fn. mach_absolute_time(), linux = fn. get-time(CLOCK_MONOTONIC))
    }

    fn counter-to-nanos(counter: u64): u64 {
      k1/select-os(macos = fn[counter]. mach-counter-to-nanos(counter), linux = fn[counter]. counter)
    }

    fn wall-nanos(): u64 { get-time(CLOCK_REALTIME) }

    fn thread-spawn(function: ptr, input: ptr): ptr {
      if k1/is-static crash("threads are not supported in static execution")
      let handle: ptr = ptr/null
      if pthread_create(handle.&.as[ptr], ptr/null, function, input) != 0 return ptr/null
      handle
    }
    fn thread-join(t: ptr): ptr {
      let out: ptr = ptr/null
      if pthread_join(t, out.&.as[ptr]) != 0 crash("pthread_join failed")
      out
    }
    fn thread-detach(t: ptr) {
      if pthread_detach(t) != 0 crash("pthread_detach failed")
    }
    fn sleep-ms(ms: u64) {
      let req: timespec = .{ tv_sec = ms / 1000, tv_nsec = (ms % 1000) * 1000000 }
      let _ = nanosleep(req.&, ptr/null)
    }
    fn cpu-count(): size {
      let sc-nprocessors-onln: c-int = k1/select-os(macos = fn. 58, linux = fn. 84)
      sysconf(sc-nprocessors-onln).max(1)
    }

    fn pipe(): { read: i32, write: i32 } {
      let fds = array/zeroed[i32, 2]()
      if posix/pipe(fds.&.as[ptr]) != 0 return .{ read = -1, write = -1 }
      .{ read = fds.[0], write = fds.[1] }
    }

    fn child-closes(stdin: ?file-handle, stdout: ?file-handle, stderr: ?file-handle, extra-close: span[file-handle]): list[i32] {
      let fds = list/with-capacity[i32](extra-close.len() + 3)
      for [stdin, stdout, stderr] {
        if it is :some h and h.raw > 2 and not fds.as-span().contains(h.raw) { fds.push(h.raw) }
      }
      for extra-close {
        if it.raw > 2 and not fds.as-span().contains(it.raw) { fds.push(it.raw) }
      }
      fds
    }

    fn spawn(path: string, argv: span[string], stdin: ?file-handle, stdout: ?file-handle, stderr: ?file-handle, extra-close: span[file-handle]): result[i32, i32] {
      // argv for exec-family calls: strings, then a null terminator, all in tmp
      mem/push-arena(mem/tmp())
      let cargv = list/with-capacity[ptr](argv.len() + 1)
      for a in argv { cargv.push(a.to-c().as[ptr]) }
      cargv.push(ptr/null)
      mem/pop-arena()

      // posix_spawn_file_actions_t is opaque: 8 bytes on darwin, 80 on glibc
      let fa-buf = array/zeroed[u8, 128]()
      let fa = fa-buf.&.as[ptr]
      posix_spawn_file_actions_init(fa)
      defer { posix_spawn_file_actions_destroy(fa) }

      if stdin is :some h { posix_spawn_file_actions_adddup2(fa, h.raw, 0) }
      if stdout is :some h { posix_spawn_file_actions_adddup2(fa, h.raw, 1) }
      if stderr is :some h { posix_spawn_file_actions_adddup2(fa, h.raw, 2) }
      for child-closes(stdin, stdout, stderr, extra-close) { posix_spawn_file_actions_addclose(fa, it) }

      let pid: i32 = 0
      let rc = posix_spawn(pid.&, path.to-c-tmp(), fa, ptr/null, cargv.data-ptr(), environ-ptr())
      if rc != 0 :err rc else :ok pid
    }

    fn fork(stdin: ?file-handle, stdout: ?file-handle, stderr: ?file-handle, extra-close: span[file-handle]): result[i32, i32] {
      if k1/is-static crash("fork is not supported in static execution")
      let closes = child-closes(stdin, stdout, stderr, extra-close)
      let pid = posix/fork()
      if pid < 0 return :err libc/errno()
      if pid > 0 return :ok pid
      if stdin is :some h { dup2(h.raw, 0) }
      if stdout is :some h { dup2(h.raw, 1) }
      if stderr is :some h { dup2(h.raw, 2) }
      for closes { close(it) }
      :ok 0
    }

    fn wait(pid: i32): result[process/wait-status, i32] {
      let status: i32 = 0
      let rc = waitpid(pid, status.&, 0)
      while rc < 0 and libc/errno() == libc/EINTR {
        rc = waitpid(pid, status.&, 0)
      }
      if rc < 0 return :err libc/errno()
      if status.bit-and(0x7f) == 0 {
        :ok .{ exit-code = status.shift-right(8).bit-and(0xff), signal = 0 }
      } else {
        :ok .{ exit-code = -1, signal = status.bit-and(0x7f) }
      }
    }

    fn kill(pid: i32) { let _ = posix/kill(pid, SIGKILL) }
  }

}
