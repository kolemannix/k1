ns posix {

  use core/c-int
  use core/c-varargs

  let stdin: i32  = 0
  let stdout: i32 = 1
  let stderr: i32 = 2

  let O_RDONLY: c-int = 0x0000
  let O_WRONLY: c-int = 0x0001
  let O_RDWR  : c-int = 0x0002
  fn O_CREAT(): c-int { k1/select-os(macos = fn. 0x0200, linux = fn. 0x40) }
  fn O_TRUNC(): c-int { k1/select-os(macos = fn. 0x0400, linux = fn. 0x200) }
  fn O_SEARCH(): c-int { k1/select-os(macos = fn. 0x40100000, linux = fn. 0x200000) }
  fn O_EXEC(): c-int { k1/select-os(macos = fn. 0x40000000, linux = fn. 0x200000) }
  fn(extern) open(path: *u8, oflag: c-int, c-varargs): c-int
  fn(extern) read(file-no: c-int, buffer: ptr, count: size): i64
  fn(extern) write(file-no: c-int, data: ptr, count: size): i64
  fn(extern) isatty(fd: c-int): c-int
  fn(extern) mkdir(path: *u8, mode: c-int): c-int
  fn(extern) link(from: *u8, to: *u8): c-int
  fn(extern) rename(from: *u8, to: *u8): c-int
  fn(extern) rmdir(path: *u8): c-int
  fn(extern) opendir(path: *u8): ptr
  fn(extern) readdir(dir: ptr): ptr
  fn(extern) closedir(dir: ptr): c-int
  type pollfd = { fd: c-int, events: i16, revents: i16 }
  let POLLIN: i16 = 1
  let POLLOUT: i16 = 4
  fn(extern) poll(fds: ptr, nfds: u64, timeout: c-int): c-int

  let SEEK_SET: c-int = 0
  let SEEK_END: c-int = 2
  fn(extern) lseek(fd: c-int, offset: i64, whence: c-int): i64
  let S_IFMT: u16 = 0xF000
  let S_IFREG: u16 = 0x8000
  fn(extern) fstat(fd: c-int, status: ptr): c-int

  let MAP_FILE   : c-int = 0x0000
  let MAP_SHARED : c-int = 0x0001
  let MAP_PRIVATE: c-int = 0x0002
  let MAP_FIXED  : c-int = 0x0010
  // MAP_ANONYMOUS = 0x20 on Linux, but MAP_ANON = 0x1000 on macOS.
  fn MAP_ANON(): c-int { k1/select-os(macos = fn. 0x1000, linux = fn. 0x20) }

  // Pages may not be accessed.
  let PROT_NONE: c-int = 0x0
  // Pages may be read.
  let PROT_READ: c-int = 0x1
  // Pages may be written.
  let PROT_WRITE: c-int = 0x2
  // Pages may be executed.
  let PROT_EXEC: c-int = 0x4
  let MAP_FAILED: i64 = -1
  fn(extern) mmap(addr: ptr, len: size, prot: i32, flags: c-int, fd: c-int, offset: size): ptr

  fn(extern) munmap(addr: ptr, len: size): i32

  let MADV_SEQUENTIAL: i32 = 2
  fn(extern("posix_madvise")) madvise(addr: ptr, len: size, advice: c-int): c-int

  fn(extern) backtrace(buffer: ptr, size: c-int)

  type timespec = { tv_sec: u64, tv_nsec: u64 }
  type(alias) clockid_t = c-int
  let CLOCK_REALTIME: clockid_t = 0
  let CLOCK_MONOTONIC: clockid_t = 1
  fn(extern) clock_gettime(clockid: clockid_t, tp: *timespec): c-int
  fn(extern) nanosleep(req: *timespec, rem: ptr): c-int
  type mach-timebase = { numer: u32, denom: u32 }
  fn(extern) mach_absolute_time(): u64
  fn(extern) mach_timebase_info(timebase: *mach-timebase): u64

  fn(extern) pthread_create(thread: ptr, attrs: ptr, start_routine: ptr, input: ptr): i32
  fn(extern) pthread_join(thread: ptr, retval: ptr): i32
  fn(extern) pthread_detach(thread: ptr): i32
  fn(extern) sysconf(name: c-int): i64

  fn(extern) fork(): i32
  fn(extern) execve(path: *u8, argv: ptr, envp: ptr): i32
  fn(extern) waitpid(pid: i32, status: *i32, options: i32): i32
  let SIGHUP : c-int = 1
  let SIGINT : c-int = 2
  let SIGKILL: c-int = 9
  let SIGPIPE: c-int = 13
  let SIGTERM: c-int = 15
  fn SIGUSR1(): c-int { k1/select-os(macos = fn. 30, linux = fn. 10) }
  fn SIGUSR2(): c-int { k1/select-os(macos = fn. 31, linux = fn. 12) }
  fn(extern) kill(pid: i32, sig: c-int): c-int

  fn(extern) pipe(fds: ptr): c-int
  fn(extern) close(fd: c-int): c-int
  fn(extern) dup2(fd: c-int, fd2: c-int): c-int

  fn(extern) posix_spawn(pid: *i32, path: *u8, file-actions: ptr, attrp: ptr, argv: ptr, envp: ptr): c-int
  fn(extern) posix_spawn_file_actions_init(file-actions: ptr): c-int
  fn(extern) posix_spawn_file_actions_destroy(file-actions: ptr): c-int
  fn(extern) posix_spawn_file_actions_adddup2(file-actions: ptr, fd: c-int, new-fd: c-int): c-int
  fn(extern) posix_spawn_file_actions_addclose(file-actions: ptr, fd: c-int): c-int

  let RTLD_NOW: c-int = 0x2
  fn RTLD_LOCAL(): c-int { k1/select-os(macos = fn. 0x4, linux = fn. 0) }
  fn(extern) dlopen(path: optref[u8], mode: c-int): ptr
  fn(extern) dlsym(handle: ptr, symbol: *u8): ptr
  fn(extern) dlclose(handle: ptr): c-int
  fn(extern) dlerror(): optref[u8]

  fn(extern) getentropy(buf: ptr, count: size): c-int

  fn(extern) readlink(path: *u8, buf: ptr, bufsize: size): i64
  fn(extern) unlink(path: *u8): c-int
  let F_OK: c-int = 0
  let X_OK: c-int = 1
  fn(extern) access(path: *u8, mode: c-int): c-int

  fn(extern) _NSGetEnviron(): ptr
  let(extern) environ: ptr
  fn environ-ptr(): ptr {
    k1/select-os(macos = fn. _NSGetEnviron().ref[ptr].*, linux = fn. environ)
  }

  // Sockets
  let AF_INET: c-int = 2
  fn AF_INET6(): c-int { k1/select-os(macos = fn. 30, linux = fn. 10) }
  let SOCK_STREAM: c-int = 1
  let IPPROTO_TCP: c-int = 6
  let TCP_NODELAY: c-int = 1
  let SHUT_RD: c-int = 0
  let SHUT_WR: c-int = 1
  let SHUT_RDWR: c-int = 2
  fn SOL_SOCKET(): c-int { k1/select-os(macos = fn. 0xffff, linux = fn. 1) }
  fn SO_REUSEADDR(): c-int { k1/select-os(macos = fn. 0x4, linux = fn. 2) }
  fn SO_ERROR(): c-int { k1/select-os(macos = fn. 0x1007, linux = fn. 4) }
  fn SO_SNDTIMEO(): c-int { k1/select-os(macos = fn. 0x1005, linux = fn. 21) }
  fn SO_RCVTIMEO(): c-int { k1/select-os(macos = fn. 0x1006, linux = fn. 20) }
  fn MSG_NOSIGNAL(): c-int { k1/select-os(macos = fn. 0x80000, linux = fn. 0x4000) }
  let F_GETFL: c-int = 3
  let F_SETFL: c-int = 4
  fn O_NONBLOCK(): c-int { k1/select-os(macos = fn. 0x4, linux = fn. 0x800) }
  fn EAI_AGAIN(): c-int { k1/select-os(macos = fn. 2, linux = fn. -3) }
  fn EAI_NODATA(): c-int { k1/select-os(macos = fn. 7, linux = fn. -5) }
  fn EAI_NONAME(): c-int { k1/select-os(macos = fn. 8, linux = fn. -2) }
  fn EAI_SYSTEM(): c-int { k1/select-os(macos = fn. 11, linux = fn. -11) }

  type(alias) socklen_t = u32
  type timeval = { tv_sec: u64, tv_usec: u64 }
  type sockaddr = { sa_len_family: u16, sa_data: array[u8, 14] }
  type sockaddr_in = { sin_len_family: u16, sin_port: u16, sin_addr: u32, sin_zero: array[u8, 8] }
  type sockaddr_in6 = {
    sin6_len_family: u16,
    sin6_port: u16,
    sin6_flowinfo: u32,
    sin6_addr: array[u8, 16],
    sin6_scope_id: u32,
  }
  type addrinfo = {
    ai_flags: c-int,
    ai_family: c-int,
    ai_socktype: c-int,
    ai_protocol: c-int,
    ai_addrlen: socklen_t,
    addr-on-linux: ptr,
    addr-on-macos: ptr,
    ai_next: optref[addrinfo],
  }

  ns for sockaddr {
    fn pack-family(family: c-int, len: size): u16 {
      k1/select-os(
        macos = fn[family, len]. family.low[u16] << 8 | len.low[u16],
        linux = fn[family]. family.low[u16]
      )
    }
    fn family(self: *sockaddr): c-int {
      let packed = self.sa_len_family.as[c-int]
      k1/select-os(macos = fn[packed]. packed >> 8, linux = fn[packed]. packed)
    }
  }

  ns for addrinfo {
    fn ai_addr(self: *addrinfo): ptr {
      k1/select-os(macos = fn[self]. self.addr-on-macos, linux = fn[self]. self.addr-on-linux)
    }
  }

  fn(extern) socket(domain: c-int, kind: c-int, protocol: c-int): c-int
  fn(extern) connect(fd: c-int, address: ptr, address-len: socklen_t): c-int
  fn(extern) bind(fd: c-int, address: ptr, address-len: socklen_t): c-int
  fn(extern) listen(fd: c-int, backlog: c-int): c-int
  fn(extern) accept(fd: c-int, address: ptr, address-len: *socklen_t): c-int
  fn(extern) send(fd: c-int, data: ptr, count: size, flags: c-int): i64
  fn(extern) shutdown(fd: c-int, how: c-int): c-int
  fn(extern) getsockopt(fd: c-int, level: c-int, option: c-int, value: ptr, value-len: *socklen_t): c-int
  fn(extern) setsockopt(fd: c-int, level: c-int, option: c-int, value: ptr, value-len: socklen_t): c-int
  fn(extern) getsockname(fd: c-int, address: ptr, address-len: *socklen_t): c-int
  fn(extern) fcntl(fd: c-int, cmd: c-int, c-varargs): c-int
  fn(extern) getaddrinfo(host: *u8, service: optref[u8], hints: *addrinfo, addresses: *optref[addrinfo]): c-int
  fn(extern) freeaddrinfo(addresses: optref[addrinfo])
  fn(extern) gai_strerror(code: c-int): *u8

  // The scalar convention over the bindings above -- bytes moved or -errno,
  // negative fd on failed open, retryable interruptions absorbed
  ns port {
    use core/platform/io/file-handle

    fn or-errno(rc: c-int): i32 { if rc < 0 { 0 - libc/errno() } else rc }

    fn read(file-no: i32, buffer: ptr, count: size): i64 {
      let capped = count.min(i32/max-value.as[i64])
      let n = posix/read(file-no, buffer, capped)
      while n < 0 and libc/errno() == libc/EINTR {
        n = posix/read(file-no, buffer, capped)
      }
      if n < 0 { 0 - libc/errno().as[i64] } else n
    }
    fn poll-one(fd: i32, events: i16, timeout-ms: u64): i32 {
      let p: pollfd = .{ fd, events, revents = 0 }
      let start = counter()
      let remaining = timeout-ms
      loop {
        let n = poll(p.&.as[ptr], 1, remaining.min(i32/max-value.u().as[u64]).low[c-int])
        if n >= 0 return n
        if libc/errno() != libc/EINTR return 0 - libc/errno()
        let elapsed-ms = counter-to-nanos(counter() - start) / 1_000_000
        remaining = if elapsed-ms < timeout-ms timeout-ms - elapsed-ms else 0
      }
    }
    fn poll-readable(file-no: i32): bool { poll-one(file-no, POLLIN, 0) > 0 }
    fn open-to-read(path: string): i32 { or-errno(open(path.to-c-tmp(), O_RDONLY, .{})) }
    fn open-to-write(path: string): i32 {
      let create-mode-rw-all: c-int = 0x1B6
      or-errno(open(path.to-c-tmp(), O_WRONLY | O_CREAT() | O_TRUNC(), .{ mode = create-mode-rw-all }))
    }
    fn close(fd: i32) { let _ = posix/close(fd) }
    fn make-dir(path: string): i32 { or-errno(mkdir(path.to-c-tmp(), 0o755)) }
    fn link(from: string, to: string): i32 { or-errno(posix/link(from.to-c-tmp(), to.to-c-tmp())) }
    fn rename(from: string, to: string): i32 { or-errno(posix/rename(from.to-c-tmp(), to.to-c-tmp())) }
    fn remove(path: string): i32 { or-errno(unlink(path.to-c-tmp())) }
    fn remove-dir(path: string): i32 { or-errno(rmdir(path.to-c-tmp())) }
    fn dir-open(path: string): result[files/dir-handle, i32] {
      let dir = opendir(path.to-c-tmp())
      if dir.is-null() :err(libc/errno()) else :ok(.{ raw = dir })
    }
    fn dir-next(dir: ptr): ?string {
      let entry = readdir(dir)
      let name-offset: size = k1/select-os(macos = fn. 21, linux = fn. 19)
      if entry.is-null() :none else :some(string/wrap-c(entry.add-bytes(name-offset).ref[u8]))
    }
    fn dir-close(dir: ptr) { let _ = closedir(dir) }
    fn file-size(fd: i32): i64 {
      let status: array[u8, 144] = .0
      if fstat(fd, status.data-ptr()) != 0 return -1
      let mode = mem/read-unaligned[u16](status.data-ptr().add-bytes(k1/select-os(macos = fn. 4, linux = fn. 24)))
      if mode & S_IFMT != S_IFREG return -1
      mem/read-unaligned[i64](status.data-ptr().add-bytes(k1/select-os(macos = fn. 96, linux = fn. 48)))
    }

    fn env-get(name: string): ?string {
      let v = libc/getenv(name.to-c-tmp())
      if v.is-null() :none else :some(string/wrap-c(v.get()))
    }

    fn dylib-open(path: string): ptr {
      dlopen(path.to-c-tmp().as(), RTLD_NOW | RTLD_LOCAL())
    }
    fn dylib-open-self(): ptr { dlopen(.0, RTLD_NOW) }
    fn dylib-sym(lib: ptr, name: string): ptr { dlsym(lib, name.to-c-tmp()) }
    fn dylib-close(lib: ptr) { let _ = dlclose(lib) }

    // getentropy caps each call at 256 bytes
    fn random-fill(dest: ptr, count: size) {
      let done: size = 0
      while done < count {
        let n = if count - done > 256 256 else count - done
        if getentropy(dest.add-bytes(done), n) != 0 crash("getentropy failed")
        done = done + n
      }
    }

    let(mutable) timebase: mach-timebase = .{ numer = 0, denom = 0 }

    fn mach-counter-to-nanos(counter: u64): u64 {
      if timebase.denom == 0 { mach_timebase_info(timebase.&) }
      counter * timebase.numer.as[u64] / timebase.denom.as[u64]
    }

    fn get-time(clockid: clockid_t): u64 {
      let ts: timespec = .0
      clock_gettime(clockid, ts.&)
      ts.tv_sec * 1_000_000_000 + ts.tv_nsec
    }

    fn counter(): u64 {
      k1/select-os(macos = fn. mach_absolute_time(), linux = fn. get-time(CLOCK_MONOTONIC))
    }

    fn counter-to-nanos(counter: u64): u64 {
      k1/select-os(macos = fn[counter]. mach-counter-to-nanos(counter), linux = fn[counter]. counter)
    }

    fn wall-nanos(): u64 { get-time(CLOCK_REALTIME) }

    fn thread-spawn(function: ptr, input: ptr): ptr {
      if k1/is-static crash("threads are not supported in static execution")
      let handle: ptr = ptr/null
      if pthread_create(handle.&.as[ptr], ptr/null, function, input) != 0 return ptr/null
      handle
    }
    fn thread-join(t: ptr): ptr {
      let out: ptr = ptr/null
      if pthread_join(t, out.&.as[ptr]) != 0 crash("pthread_join failed")
      out
    }
    fn thread-detach(t: ptr) {
      if pthread_detach(t) != 0 crash("pthread_detach failed")
    }
    fn sleep-ms(ms: u64) {
      let req: timespec = .{ tv_sec = ms / 1000, tv_nsec = (ms % 1000) * 1000000 }
      let _ = nanosleep(req.&, ptr/null)
    }
    fn cpu-count(): size {
      let sc-nprocessors-onln: c-int = k1/select-os(macos = fn. 58, linux = fn. 84)
      sysconf(sc-nprocessors-onln).max(1)
    }

    fn pipe(): { read: i32, write: i32 } {
      let fds = array/zeroed[i32, 2]()
      if posix/pipe(fds.&.as[ptr]) != 0 return .{ read = -1, write = -1 }
      .{ read = fds.[0], write = fds.[1] }
    }

    fn child-closes(stdin: ?file-handle, stdout: ?file-handle, stderr: ?file-handle, extra-close: span[file-handle]): list[i32] {
      let fds = list/with-capacity[i32](extra-close.len() + 3)
      for [stdin, stdout, stderr] {
        if it is :some h and h.raw > 2 and not fds.as-span().contains(h.raw) { fds.push(h.raw) }
      }
      for extra-close {
        if it.raw > 2 and not fds.as-span().contains(it.raw) { fds.push(it.raw) }
      }
      fds
    }

    fn spawn(path: string, argv: span[string], stdin: ?file-handle, stdout: ?file-handle, stderr: ?file-handle, extra-close: span[file-handle]): result[i32, i32] {
      // argv for exec-family calls: strings, then a null terminator, all in tmp
      mem/push-arena(mem/tmp())
      let cargv = list/with-capacity[ptr](argv.len() + 1)
      for a in argv { cargv.push(a.to-c().as[ptr]) }
      cargv.push(ptr/null)
      mem/pop-arena()

      // posix_spawn_file_actions_t is opaque: 8 bytes on darwin, 80 on glibc
      let fa-buf = array/zeroed[u8, 128]()
      let fa = fa-buf.&.as[ptr]
      posix_spawn_file_actions_init(fa)
      defer { posix_spawn_file_actions_destroy(fa) }

      if stdin is :some h { posix_spawn_file_actions_adddup2(fa, h.raw, 0) }
      if stdout is :some h { posix_spawn_file_actions_adddup2(fa, h.raw, 1) }
      if stderr is :some h { posix_spawn_file_actions_adddup2(fa, h.raw, 2) }
      for child-closes(stdin, stdout, stderr, extra-close) { posix_spawn_file_actions_addclose(fa, it) }

      let pid: i32 = 0
      let rc = posix_spawn(pid.&, path.to-c-tmp(), fa, ptr/null, cargv.data-ptr(), environ-ptr())
      if rc != 0 :err rc else :ok pid
    }

    fn fork(stdin: ?file-handle, stdout: ?file-handle, stderr: ?file-handle, extra-close: span[file-handle]): result[i32, i32] {
      if k1/is-static crash("fork is not supported in static execution")
      let closes = child-closes(stdin, stdout, stderr, extra-close)
      let pid = posix/fork()
      if pid < 0 return :err libc/errno()
      if pid > 0 return :ok pid
      if stdin is :some h { dup2(h.raw, 0) }
      if stdout is :some h { dup2(h.raw, 1) }
      if stderr is :some h { dup2(h.raw, 2) }
      for closes { close(it) }
      :ok 0
    }

    fn wait(pid: i32): result[process/wait-status, i32] {
      let status: i32 = 0
      let rc = waitpid(pid, status.&, 0)
      while rc < 0 and libc/errno() == libc/EINTR {
        rc = waitpid(pid, status.&, 0)
      }
      if rc < 0 return :err libc/errno()
      if status.bit-and(0x7f) == 0 {
        :ok .{ exit-code = status.shift-right(8).bit-and(0xff), signal = 0 }
      } else {
        :ok .{ exit-code = -1, signal = status.bit-and(0x7f) }
      }
    }

    fn kill(pid: i32) { let _ = posix/kill(pid, SIGKILL) }

    // Sockets
    type raw-socket-address = {
      storage: union { v4: sockaddr_in, v6: sockaddr_in6 },
      family: c-int,
      len: socklen_t,
    }

    fn make-raw-socket-address(address: net/socket-address): raw-socket-address {
      let port = address.port.swap-bytes()
      if address.ip is {
        :v4 ip -> .{
          storage = .{ v4 = .{
            sin_len_family = sockaddr/pack-family(AF_INET, types/size[sockaddr_in]),
            sin_port = port,
            sin_addr = bitcast(ip.octets),
            sin_zero = .0,
          } },
          family = AF_INET,
          len = types/size[sockaddr_in].low[socklen_t],
        },
        :v6 ip -> .{
          storage = .{ v6 = .{
            sin6_len_family = sockaddr/pack-family(AF_INET6(), types/size[sockaddr_in6]),
            sin6_port = port,
            sin6_flowinfo = 0,
            sin6_addr = ip.octets,
            sin6_scope_id = ip.scope-id,
          } },
          family = AF_INET6(),
          len = types/size[sockaddr_in6].low[socklen_t],
        },
      }
    }

    fn read-socket-address(address: ptr): net/socket-address {
      let family = address.ref[sockaddr].family()
      if family == AF_INET {
        let v4 = address.ref[sockaddr_in]
        .{ ip = :v4 .{ octets = bitcast(v4.sin_addr) }, port = v4.sin_port.swap-bytes() }
      } else if family == AF_INET6() {
        let v6 = address.ref[sockaddr_in6]
        .{ ip = :v6 .{ octets = v6.sin6_addr, scope-id = v6.sin6_scope_id }, port = v6.sin6_port.swap-bytes() }
      } else crash("unexpected socket address family $family")
    }

    fn set-flag-option(fd: i32, level: c-int, option: c-int, enabled: bool): i32 {
      let value: c-int = if enabled 1 else 0
      or-errno(setsockopt(fd, level, option, value.&.as[ptr], types/size[c-int].low[socklen_t]))
    }

    fn set-timeout(fd: i32, option: c-int, ms: ?u64): i32 {
      let total = if ms is :some m m.max(1) else 0
      let tv: timeval = .{ tv_sec = total / 1000, tv_usec = total % 1000 * 1000 }
      or-errno(setsockopt(fd, SOL_SOCKET(), option, tv.&.as[ptr], types/size[timeval].low[socklen_t]))
    }

    fn set-nonblocking(fd: i32, enabled: bool): i32 {
      let flags = fcntl(fd, F_GETFL, .{})
      if flags < 0 return 0 - libc/errno()
      let next = if enabled flags | O_NONBLOCK() else flags & O_NONBLOCK().bit-not()
      or-errno(fcntl(fd, F_SETFL, .{ next }))
    }

    fn get-socket-error(fd: i32): i32 {
      let code: c-int = 0
      let len = types/size[c-int].low[socklen_t]
      if getsockopt(fd, SOL_SOCKET(), SO_ERROR(), code.&.as[ptr], len.&) < 0 return 0 - libc/errno()
      0 - code
    }

    fn connect(address: net/socket-address, timeout-ms: u64): i32 {
      let raw = make-raw-socket-address(address)
      let fd = or-errno(socket(raw.family, SOCK_STREAM, 0))
      if fd < 0 return fd
      defer rc. if rc < 0 close(fd)
      let status = set-nonblocking(fd, true)
      if status < 0 return status
      if posix/connect(fd, raw.storage.&.as[ptr], raw.len) < 0 {
        let code = libc/errno()
        if code != libc/EINPROGRESS() and code != libc/EINTR return 0 - code
        let ready = poll-one(fd, POLLOUT, timeout-ms)
        if ready < 0 return ready
        if ready == 0 return 0 - libc/ETIMEDOUT()
        status = get-socket-error(fd)
        if status < 0 return status
      }
      status = set-nonblocking(fd, false)
      if status < 0 return status
      fd
    }

    fn listen(address: net/socket-address, backlog: i32): i32 {
      let raw = make-raw-socket-address(address)
      let fd = or-errno(socket(raw.family, SOCK_STREAM, 0))
      if fd < 0 return fd
      defer rc. if rc < 0 close(fd)
      let status = set-flag-option(fd, SOL_SOCKET(), SO_REUSEADDR(), true)
      if status < 0 return status
      status = or-errno(bind(fd, raw.storage.&.as[ptr], raw.len))
      if status < 0 return status
      status = or-errno(posix/listen(fd, backlog))
      if status < 0 return status
      fd
    }

    fn accept(fd: i32): result[net/accepted, i32] {
      let storage: sockaddr_in6 = .0
      let len = types/size[sockaddr_in6].low[socklen_t]
      let client = posix/accept(fd, storage.&.as[ptr], len.&)
      while client < 0 and libc/errno() == libc/EINTR {
        client = posix/accept(fd, storage.&.as[ptr], len.&)
      }
      if client < 0 return :err libc/errno()
      :ok .{ stream = .{ file = .{ raw = client } }, peer = read-socket-address(storage.&.as[ptr]) }
    }

    fn local-address(fd: i32): result[net/socket-address, i32] {
      let storage: sockaddr_in6 = .0
      let len = types/size[sockaddr_in6].low[socklen_t]
      if getsockname(fd, storage.&.as[ptr], len.&) < 0 return :err libc/errno()
      :ok read-socket-address(storage.&.as[ptr])
    }

    fn send(fd: i32, data: ptr, count: size): i64 {
      let n = posix/send(fd, data, count, MSG_NOSIGNAL())
      while n < 0 and libc/errno() == libc/EINTR {
        n = posix/send(fd, data, count, MSG_NOSIGNAL())
      }
      if n < 0 { 0 - libc/errno().as[i64] } else n
    }

    fn shutdown(fd: i32, how: c-int): i32 { or-errno(posix/shutdown(fd, how)) }

    fn resolve(host: string, port: u16): result[list[net/socket-address], net/resolve-error] {
      let hints: addrinfo = .0
      hints.ai_socktype = SOCK_STREAM
      let head: optref[addrinfo] = .0
      let code = getaddrinfo(host.to-c-tmp(), .0, hints.&, head.&)
      if code != 0 {
        return :err .{ host, code, errno = if code == EAI_SYSTEM() libc/errno() else 0 }
      }
      defer freeaddrinfo(head)
      let addresses = list/empty[net/socket-address]()
      let node = head
      while not node.is-null() {
        addresses.push(read-socket-address(node.get().ai_addr()) | .{ port })
        node = node.get().ai_next
      }
      :ok addresses
    }

    fn resolve-error-string(error: net/resolve-error): string {
      if error.code == EAI_SYSTEM() libc/strerror-string(error.errno)
      else string/wrap-c(gai_strerror(error.code))
    }
  }

}
