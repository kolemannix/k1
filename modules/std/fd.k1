ns fd {
  use core/platform/io/file-handle
  use core/platform/io/io-result

  // ok(0) with a nonzero count is end-of-file
  fn read(file: file-handle, buffer: ptr, count: size): io-result {
    let n =
      if k1/is-static posix/port/read(file.raw, buffer, count)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/read(file.raw, buffer, count),
        :wasi -> wasi/read(file.raw, buffer, count),
        :bare -> bare/read(file.raw, buffer, count)
      }
    .{ raw = n }
  }

  fn read-all(file: file-handle): result[string, i32] { read-all-in(mem/current-arena(), file) }

  fn read-all-in[a: allocator](alloc: a, file: file-handle): result[string, i32] {
    let contents: list[char] = list/with-capacity-in(alloc, if file-size(file) is :some(n) and n > 0 n + 1 else 4096)
    loop {
      if contents.len == contents.cap() contents.reserve-in(alloc, contents.cap() * 2)
      if read(file, contents.data-ptr().add-bytes(contents.len), contents.cap() - contents.len).result() is {
        :ok(0) -> return :ok(string/wrap-list(contents)),
        :ok(n) -> { contents.len = contents.len + n },
        :err(code) -> {
          contents.inner-buffer().free-in(alloc)
          return :err(code)
        },
      }
    }
  }

  fn poll-readable(file: file-handle): bool {
    if k1/is-static posix/port/poll-readable(file.raw)
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/port/poll-readable(file.raw),
      :wasi -> wasi/poll-readable(file.raw),
      :bare -> crash("poll-readable is not supported on this platform")
    }
  }

  fn open-to-read(path: string): result[file-handle, i32] {
    let fd =
      if k1/is-static posix/port/open-to-read(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/open-to-read(path),
        :wasi -> crash("file io is not supported on wasi"),
        :bare -> bare/open-to-read(path)
      }
    if fd < 0 :err(0 - fd) else :ok(.{ raw = fd })
  }

  fn open-to-write(path: string): result[file-handle, i32] {
    let fd =
      if k1/is-static posix/port/open-to-write(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/open-to-write(path),
        :wasi -> crash("file io is not supported on wasi"),
        :bare -> bare/open-to-write(path)
      }
    if fd < 0 :err(0 - fd) else :ok(.{ raw = fd })
  }

  fn close(file: file-handle) {
    if k1/is-static posix/port/close(file.raw)
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/port/close(file.raw),
      :wasi -> crash("file io is not supported on wasi"),
      :bare -> bare/close(file.raw)
    }
  }

  fn file-size(file: file-handle): ?size {
    let n =
      if k1/is-static posix/port/file-size(file.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/file-size(file.raw),
        :wasi -> -1,
        :bare -> bare/file-size(file.raw)
      }
    if n < 0 :none else :some(n)
  }

  type pipe-ends = { read: file-handle, write: file-handle }

  fn pipe(): ?pipe-ends {
    let fds =
      if k1/is-static posix/port/pipe()
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/pipe(),
        :wasi or :bare -> crash("pipes are not supported on this platform")
      }
    if fds.read < 0 :none
    else :some(.{ read = .{ raw = fds.read }, write = .{ raw = fds.write } })
  }

  // Loops until every byte is written
  fn write-all(file: file-handle, bytes: span[u8]): result[empty, i32] {
    write-all-with(bytes, fn[file](data: ptr, count: size) core/platform/io/write(file, data, count))
  }

  fn write-all-with(bytes: span[u8], write-fn: some fn(ptr, size) -> io-result): result[empty, i32] {
    let written: size = 0
    while written < bytes.len() {
      let n = write-fn(bytes.data-ptr().add-bytes(written), bytes.len() - written).try
      if n == 0 crash("write made no progress")
      written = written + n
    }
    :ok
  }

  // Buffered line reads: pending/consumed hold file bytes between calls
  type reader = { file: file-handle, pending: list[u8], consumed: size }

  ns for reader {

    fn new(file: file-handle): reader {
      .{ file, pending = list/empty[u8](), consumed = 0 }
    }

    // Blocking; :none only at EOF with nothing buffered. The last line before
    // EOF may arrive without its newline.
    fn read-line(self: *reader): ?string {
      loop {
        let i = self.consumed
        while i < self.pending.len() {
          if self.pending.[i] == '\n'.as-u8() {
            let line = self.take-line(i)
            self.consumed = i + 1
            if self.consumed == self.pending.len() {
              self.pending.clear()
              self.consumed = 0
            }
            return :some(line)
          }
          i = i + 1
        }
        let chunk = buffer/allocate-in[t = u8](mem/tmp(), 4096)
        let n = if read(self.file, chunk.data, chunk.len).result() is {
          :ok(n) -> n,
          :err(_) -> return :none
        }
        if n > 0 {
          self.pending.append-span(span/wrap-buffer(chunk.slice(0, n)))
        } else {
          if self.consumed < self.pending.len() {
            let line = self.take-line(self.pending.len())
            self.pending.clear()
            self.consumed = 0
            return :some(line)
          }
          return :none
        }
      }
    }

    fn take-line(self: *reader, end: size): string {
      let sb = string-builder/new()
      sb.write-bytes(self.pending.slice(self.consumed, end))
      sb.build()
    }

  }

}
