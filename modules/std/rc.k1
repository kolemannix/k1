// Disclaimer: This is a temporary, ai-generated utility to test the compiler and push the http project forward
type rc[t] = { inner: *mut rc-inner[t] }
type rc-inner[t] = { count: u64, drop-fn: ?*fn(*mut t) -> {}, value: t }

// Census of live rc cells; tests assert it returns to zero to catch a dropped
// release. Not debug-gated: the test suite builds without k1/debug, and two
// relaxed atomics bracketing the cell's malloc/free are noise.
let(mutable) live-cells: u64 = 0

ns for rc {
  fn alloc[t](value: t, drop-fn: ?*fn(*mut t) -> {}): rc[t] {
    atomic/fetch-add(live-cells.&, 1, :relaxed)
    .{ inner = heap.new(.{ count = 1, drop-fn, value }) }
  }

  fn new[t](value: t): rc[t] { alloc(value, :none) }
  fn new-with-drop[t](value: t, drop: *fn(*mut t) -> {}): rc[t] { alloc(value, :some drop) }

  fn live-count(): u64 { atomic/load(live-cells.&, :relaxed) }

  fn get[t](self: rc[t]): *mut t { self.inner.value.& }

  fn retain[t](self: rc[t]): rc[t] {
    atomic/fetch-add(self.inner.count.&, 1, :relaxed)
    self
  }

  fn release[t](self: rc[t]) {
    let prev = atomic/fetch-sub(self.inner.count.&, 1, :release)
    if prev == 1 {
      atomic/fence(:acquire)
      if self.inner.drop-fn is :some drop { drop(self.inner.value.&) }
      heap.free-t(self.inner)
      let _ = atomic/fetch-sub(live-cells.&, 1, :relaxed)
    }
  }

  fn bytes(self: rc-bytes): span[u8] { self.get().* }
}

// Individual-object ownership: a value owning a resource that must be
// explicitly freed or handed onward to rc. raw is the transferable payload
// stored in the rc cell; the derived drop re-wraps it with adopt to free.
ability owned[impl raw] {
  fn adopt(value: raw): self
  fn raw(self): raw
  fn free(self)

  fn to-rc(self): rc[raw] {
    rc/new-with-drop(self.raw(), fn(p: *mut raw) owned@(self)/adopt(p.*).free())
  }
}

// Bytes/strings whose backing memory is owned by the system heap. The type is
// the declaration of provenance: holders must free() or hand ownership
// onward (to-rc). Construct with cloned (copies from anywhere) or adopt
// (asserts the memory is already a system-heap allocation).
type heap-bytes = { raw: span[u8] }
type heap-string = { raw: string }

ns for heap-bytes {
  fn cloned(bytes: span[u8]): heap-bytes { .{ raw = bytes.cloned-in(heap) } }
}

impl owned[raw = span[u8]] for heap-bytes {
  fn adopt(value: span[u8]): heap-bytes { .{ raw = value } }
  fn raw(self: heap-bytes): span[u8] { self.raw }
  fn free(self: heap-bytes) { heap.free(self.raw.data-ptr(), self.raw.len(), 1) }
}

ns for heap-string {
  fn cloned(s: string): heap-string { .{ raw = s.cloned-in(heap) } }
}

impl owned[raw = string] for heap-string {
  fn adopt(value: string): heap-string { .{ raw = value } }
  fn raw(self: heap-string): string { self.raw }
  fn free(self: heap-string) { heap.free(self.raw.data-ptr(), self.raw.len(), 1) }
}

// Refcounted byte payloads: the common currency for zero-copy fan-out.
type(alias) rc-bytes = rc[span[u8]]

// Unwraps a stream of rc-bytes into the payload bytes, zero-copy. Each
// handed-out payload is retired (released) on the following pull, matching
// the chunk-validity contract.
type rc-byte-stream = {
  upstream: dyn[source[t = rc-bytes]],
  inflight: list[rc-bytes],
  parts: list[span[u8]],
}

fn rc-byte-stream(upstream: dyn[source[t = rc-bytes]]): dyn[source[t = u8]] {
  let state: *mut rc-byte-stream = mem/new(.{
    upstream,
    inflight = list/empty[rc-bytes](),
    parts = list/empty[span[u8]](),
  })
  state.to-dyn()
}

impl source[t = u8] for rc-byte-stream {
  fn start(self: *mut rc-byte-stream, waker: waker) { self.upstream.start(waker) }
  fn stop(self: *mut rc-byte-stream) {
    for payload in self.inflight { payload.release() }
    self.inflight.clear()
    self.upstream.stop()
  }
  fn next(self: *mut rc-byte-stream): pull[u8] {
    for payload in self.inflight { payload.release() }
    self.inflight.clear()
    if self.upstream.next() is {
      :chunk group -> {
        self.parts.clear()
        for seg in group {
          for payload in seg {
            self.inflight.push(payload)
            self.parts.push(payload.bytes())
          }
        }
        :chunk self.parts.as-span()
      },
      :pending -> :pending,
      :done -> :done,
      :fail message -> :fail message,
    }
  }
}

