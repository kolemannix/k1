ns math

ability exp {
  fn exp(self): self
}
impl exp for f64 {
  fn exp(self: f64): f64 {
    libc/math/exp_f64(self)
  }
}
impl exp for f32 {
  fn exp(self: f32): f32 {
    libc/math/exp_f32(self)
  }
}

ability log2 {
  fn log2(self): self
}
impl log2 for f64 {
  fn log2(self: f64): f64 {
    libc/math/log2_f64(self)
  }
}
impl log2 for f32 {
  fn log2(self: f32): f32 {
    libc/math/log2_f32(self)
  }
}
