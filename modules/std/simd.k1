ns simd

//   $simd/map[u8](scale, x, [c("k", 3)], x * k + x)
//     -> fn scale(dst: buffer[u8], src: span[u8])
//   $simd/reduce[u8](total, a, b, a + b, 0)
//     -> fn total(src: span[u8]): u8
//   $simd/first-of(delims, [',', ':', '"'])
//     -> ns delims { fn scan(data: span[u8], from: size): { index: i64, which: i64 } }
//
// Generated loops process `natural-bytes` at a time with a scalar tail. Map
// and reduce bodies are emitted into both worlds, which works because the
// arithmetic/bitwise operators dispatch through abilities both implement;
// declared constants are `let`s in the tail and splats in the vector loop.
// Reduce bodies must be commutative and associative.

let natural-bytes: size = k1/simd-bytes

// A named integer constant available to a kernel body
fn c(name: string, value: i64): { name: string, value: i64 } { .{ name, value } }

fn lanes-for(elem-name: string, elem-size: size): size {
  let lanes = natural-bytes / elem-size
  if lanes < 2 crash("simd kernels need an element half a vector or smaller; got $elem-name")
  lanes
}

fn map-impl(
  name: code,
  elem-name: string,
  elem-size: size,
  binding: code,
  consts: span[{ name: string, value: i64 }],
  body: code
): code {
  let lanes = lanes-for(elem-name, elem-size)
  let splats = string-builder/new()
  let scalars = string-builder/new()
  for consts {
    splats.writeln("let ${it.name} = vector/splat[$elem-name, $lanes](${it.value})")
    scalars.writeln("let ${it.name}: $elem-name = ${it.value}")
  }
  `
    fn $name(dst: buffer[$elem-name], src: span[$elem-name]) {
      assert(dst.len == src.len())
      let len = src.len()
      let sbase = src.data-ptr()
      let dbase = dst.data-ptr()
      let i = 0: size
      {
        ${splats.build()}
        while i + $lanes <= len {
          let $binding = vector/load-unchecked[$elem-name, $lanes](sbase.ref-at[$elem-name](i).as[ptr])
          ($body).store-unchecked(dbase.ref-at[$elem-name](i).as[ptr])
          i = i + $lanes
        }
      }
      while i < len {
        ${scalars.build()}
        let $binding = src.[i]
        dst.[i] = $body
        i = i + 1
      }
    }
  `
}

macro map[t](name: code, binding: code, consts: span[{ name: string, value: i64 }], body: code) {
  map-impl(name, types/name[t], types/size[t], binding, consts, body)
}

fn reduce-impl(
  name: code,
  elem-name: string,
  elem-size: size,
  acc-binding: code,
  item-binding: code,
  body: code,
  identity: i64
): code {
  let lanes = lanes-for(elem-name, elem-size)
  `
    fn $name(src: span[$elem-name]): $elem-name {
      let len = src.len()
      let sbase = src.data-ptr()
      let i = 0: size
      let vacc = vector/splat[$elem-name, $lanes]($identity)
      while i + $lanes <= len {
        let $acc-binding = vacc
        let $item-binding = vector/load-unchecked[$elem-name, $lanes](sbase.ref-at[$elem-name](i).as[ptr])
        vacc = $body
        i = i + $lanes
      }
      let acc: $elem-name = $identity
      let lane = 0: size
      while lane < $lanes {
        let $acc-binding = acc
        let $item-binding = vacc.get-lane(lane)
        acc = $body
        lane = lane + 1
      }
      while i < len {
        let $acc-binding = acc
        let $item-binding = src.[i]
        acc = $body
        i = i + 1
      }
      acc
    }
  `
}

macro reduce[t](name: code, acc-binding: code, item-binding: code, body: code, identity: i64) {
  reduce-impl(name, types/name[t], types/size[t], acc-binding, item-binding, body, identity)
}

fn first-of-impl(name: code, needles: span[char]): code {
  if needles.len() == 0 crash("first-of needs at least one needle")
  if needles.len() > 8 crash("first-of supports at most 8 needles; got ${needles.len()}")
  let lanes = natural-bytes
  let last = needles.len() - 1
  if last == 0 {
    let needle = needles.[0].as-u8()
    return `
      ns $name {
        fn scan(data: span[u8], from: size): { index: i64, which: i64 } {
          if data.drop(from).position($needle) is :some p .{ index = from + p, which = 0 }
          else .{ index = -1, which = -1 }
        }
      }
    `
  }

  let splats = string-builder/new()
  let compares = string-builder/new()
  let any-compare = string-builder/new()
  let masks = string-builder/new()
  let any-mask = string-builder/new()
  let earlier-hits = string-builder/new()
  let scalar-hits = string-builder/new()
  any-compare.write("e0")
  any-mask.write("m0")
  for needles {
    let needle = it.as-u8()
    splats.writeln("let needle$it-index = vector/splat[u8, $lanes]($needle)")
    compares.writeln("let e$it-index = chunk.eq-lanes(needle$it-index)")
    masks.writeln("let m$it-index = e$it-index.to-mask()")
    if it-index > 0 {
      any-compare.write(".bit-or(e$it-index)")
      any-mask.write(".bit-or(m$it-index)")
    }
    if it-index < last {
      earlier-hits.writeln("if m$it-index.shift-right(lane.trunc[u32]).bit-and(1) == 1 return .{ index = i + lane.signed(), which = $it-index }")
    }
    scalar-hits.writeln("if b == $needle return .{ index = i, which = $it-index }")
  }
  `
    ns $name {
      fn scan(data: span[u8], from: size): { index: i64, which: i64 } {
        let len = data.len()
        let base = data.data-ptr()
        let i = from
        ${splats.build()}
        while i + $lanes <= len {
          let chunk = vector/load-unchecked[u8, $lanes](base.ref-at[u8](i).as[ptr])
          ${compares.build()}
          if ${any-compare.build()}.any() {
            ${masks.build()}
            let lane = ${any-mask.build()}.trailing-zeros()
            ${earlier-hits.build()}
            return .{ index = i + lane.signed(), which = $last }
          }
          i = i + $lanes
        }
        while i < len {
          let b = data.[i]
          ${scalar-hits.build()}
          i = i + 1
        }
        .{ index = -1, which = -1 }
      }
    }
  `
}

macro first-of(name: code, needles: span[char]) {
  first-of-impl(name, needles)
}
