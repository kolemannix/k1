ns files {

  let ERROR-NOT-FOUND: i32 = 2
  let ERROR-EXISTS: i32 = 17

  type error = { code: i32, path: string }

  ns for error {
    fn not-found(self: error): bool { self.code == ERROR-NOT-FOUND }
    fn already-exists(self: error): bool { self.code == ERROR-EXISTS }
  }

  impl print for error {
    fn print-to[w: writer](self, w) {
      w.write("`${self.path}`: ${sys/error-string(self.code)}")
    }
  }

  fn read-to-string(path: string): result[string, error] {
    read-to-string-in(mem/current-arena(), path)
  }

  fn read-to-string-in[a: allocator](alloc: a, path: string): result[string, error] {
    let file = if fd/open-to-read(path) is {
      :ok(file) -> file,
      :err(code) -> return :err(.{ code, path })
    }
    defer fd/close(file)
    fd/read-all-in(alloc, file).map-err(fn[path](code: i32) .{ code, path })
  }

  fn write-entire-file(out-path: string, contents: string): result[empty, error] {
    let file = if fd/open-to-write(out-path) is {
      :ok(file) -> file,
      :err(code) -> return :err(.{ code, path = out-path })
    }
    defer fd/close(file)

    if fd/write-all(file, contents.span-bytes()) is :err(code) :err(.{ code, path = out-path }) else :ok
  }

  fn dir-of(path: string): string {
    let i = path.len()
    while i > 0 {
      i = i - 1
      if path.[i] == '/' return if i == 0 "/" else path.take(i)
    }
    "."
  }

  fn exists(path: string): bool {
    if fd/open-to-read(path) is {
      :ok(file) -> { fd/close(file); true },
      :err(_) -> false
    }
  }

  fn is-executable(path: string): bool {
    if k1/is-static posix/access(path.to-c-tmp(), posix/X_OK) == 0
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/access(path.to-c-tmp(), posix/X_OK) == 0,
      :wasi -> crash("file io is not supported on wasi"),
      :bare -> bare/is-executable(path)
    }
  }

  type dir-handle = { raw: ptr }

  fn dir-open(path: string): result[dir-handle, i32] {
    if k1/is-static posix/port/dir-open(path)
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/port/dir-open(path),
      :wasi or :bare -> crash("directories are not supported on this platform")
    }
  }
  fn dir-next(dir: dir-handle): ?string {
    if k1/is-static posix/port/dir-next(dir.raw)
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/port/dir-next(dir.raw),
      :wasi or :bare -> crash("directories are not supported on this platform")
    }
  }
  fn dir-close(dir: dir-handle) {
    if k1/is-static posix/port/dir-close(dir.raw)
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/port/dir-close(dir.raw),
      :wasi or :bare -> crash("directories are not supported on this platform")
    }
  }

  fn list-dir(path: string): result[list[string], error] {
    list-dir-in(mem/current-arena(), path)
  }

  fn list-dir-in[a: allocator](alloc: a, path: string): result[list[string], error] {
    let dir = if dir-open(path) is {
      :ok(dir) -> dir,
      :err(code) -> return :err(.{ code, path })
    }
    defer dir-close(dir)
    let names: list[string] = list/empty()
    while dir-next(dir) is :some(name) {
      if name != "." and name != ".." { names.push-in(alloc, name.cloned-in(alloc)) }
    }
    :ok(names)
  }

  fn status(rc: i32, path: string): result[empty, error] {
    if rc < 0 :err(.{ code = 0 - rc, path }) else :ok
  }

  fn make-dir(path: string): result[empty, error] {
    status(
      if k1/is-static posix/port/make-dir(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/make-dir(path),
        :wasi or :bare -> crash("directories are not supported on this platform")
      },
      path
    )
  }

  fn link(from: string, to: string): result[empty, error] {
    status(
      if k1/is-static posix/port/link(from, to)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/link(from, to),
        :wasi or :bare -> crash("links are not supported on this platform")
      },
      to
    )
  }

  fn rename(from: string, to: string): result[empty, error] {
    status(
      if k1/is-static posix/port/rename(from, to)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/rename(from, to),
        :wasi or :bare -> crash("rename is not supported on this platform")
      },
      from
    )
  }

  fn remove(path: string): result[empty, error] {
    status(
      if k1/is-static posix/port/remove(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/remove(path),
        :wasi or :bare -> crash("remove is not supported on this platform")
      },
      path
    )
  }

  fn remove-dir(path: string): result[empty, error] {
    status(
      if k1/is-static posix/port/remove-dir(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> posix/port/remove-dir(path),
        :wasi or :bare -> crash("directories are not supported on this platform")
      },
      path
    )
  }

}
