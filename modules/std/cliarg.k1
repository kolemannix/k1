// a utility for parsing command line arguments into a given
// struct type. Also generates a help string

ns sys

fn parse-next(i: *mut size, args: span[string]): ?string {
  let r = args.get-opt(i + 1)
  i.* = i.* + 2
  r
}
fn get-arg-kind(type-id: type-id): either { string, list-string, opt-string } {
  if      type-id == types/id[string]       :string
  else if type-id == types/id[list[string]] :list-string
  else if type-id == types/id[opt[string]]  :opt-string
  else crash("Unsupported arg type: ${type-id.name()}. Must be string, ?string, or list[string] for now")
}

fn gen-help-text[t](summary: string): string {
  let s = types/schema[t] is { :struct s -> s, _ -> crash("need a struct") }
  let sb = string-builder/new()
  if summary.non-empty() sb.writeln(summary)
  sb.writeln(`supported command line arguments`)
  for s.fields {
    get-arg-kind(it.type-id) is {
      :string -> sb.writeln(`  -${it.name} - required. (/-${it.name} to comment out)`),
      :opt-string -> sb.writeln(`  -${it.name} - optional. (/-${it.name} to comment out)`),
      :list-string -> sb.writeln(`  -${it.name} - list. (/-${it.name} to comment out)`),
    }
  }
  sb.build-tmp()
}

// For each field in the target type, a local variable to house its parsed data
fn emit-arg-locals(cb: *mut code-builder, s: types/type-schema:struct, args-type-id: type-id) {
  for s.fields {
    get-arg-kind(it.type-id) is {
      :string      -> cb.line("let ${it.name}-val: ?${args-type-id.spell()}.${it.name} = :none"),
      :opt-string  -> cb.line("let ${it.name}-val: ${args-type-id.spell()}.${it.name} = :none"),
      :list-string -> cb.line("let ${it.name}-val: ${args-type-id.spell()}.${it.name} = list/empty()"),
    }
  }
}

// A case or two per arg field; the match arms update the locals
fn emit-arg-match(cb: *mut code-builder, s: types/type-schema:struct) {
  cb.block("cur is", fn[cb, s]. {
    for s.fields {
      get-arg-kind(it.type-id) is {
        :string or :opt-string -> {
          cb.line(`"-${it.name}" -> { if parse-next(&i, args) is :some next { ${it.name}-val = :some next } },`)
          cb.line(`"/${it.name}" -> { if parse-next(&i, args) is :some(next) .{} },`)
        },
        :list-string -> {
          cb.line(`"+${it.name}" -> { if parse-next(&i, args) is :some next { ${it.name}-val.push(next) } },`)
        },
      }
    }
    cb.line(`_ -> crash("Unrecognized arg \$cur")`)
  })
}

fn emit-arg-loop(cb: *mut code-builder, s: types/type-schema:struct) {
  cb.line("let i = 1")
  cb.block("while i < args.len()", fn[cb, s]. {
    cb.line("let cur = args.get(i)")
    emit-arg-match(cb, s)
  })
}

fn emit-arg-validate(cb: *mut code-builder, s: types/type-schema:struct) {
  for s.fields {
    get-arg-kind(it.type-id) is {
      :string                     -> cb.line(`require ${it.name}-val is :some ${it.name}-out else return :err "${it.name} is missing"`),
      :list-string or :opt-string -> cb.line("let ${it.name}-out = ${it.name}-val"),
    }
  }
}

fn emit-arg-construct(cb: *mut code-builder, s: types/type-schema:struct) {
  cb.line(":ok(.{")
  cb.indent()
  for s.fields {
    cb.line("${it.name} = ${it.name}-out,")
  }
  cb.dedent()
  cb.line("})")
}

fn parse-args[t](args: span[string], customizations: span[{ name: string, settings: {} }]): result[t, string] {
  // Note: it would be better to move these two lines inside the meta call
  // But this exercises the compiler better
  let _t-id = #static types/id[t]
  let _s = #static types/schema[t] is { :struct s -> s, _ -> crash("need a struct") }

  let result: result[t, string] = #meta(_s, _t-id) {
    let args-type-id = _t-id
    let s: types/type-schema:struct = _s.from-static()
    let cb-storage = code-builder/new()
    let cb = cb-storage.&
    emit-arg-locals(cb, s, args-type-id)
    emit-arg-loop(cb, s)
    emit-arg-validate(cb, s)
    emit-arg-construct(cb, s)
    cb.build()
  }

  result
}

