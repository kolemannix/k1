// Running short-lived commands, from runtime or comptime code; catered to the
// needs of build() and scripting as first consumers

ns process {

  // :inherit streams the child's stdout/stderr to ours (output is empty)
  type output-mode = either { drop, capture, inherit }

  // signal == 0 means normal exit; when killed by a signal, exit-code is -1;
  // output is empty for :drop and :inherit
  type run-output = { exit-code: i32, signal: i32, output: string }

  type run-error = either {
    spawn({ program: string, message: string }),
    failed({ program: string, status: run-output }),
  }

  impl print for run-error {
    fn print-to[w: writer](self, w) {
      if self is {
        :spawn s -> w.write("'${s.program}': ${s.message}"),
        :failed f -> {
          if f.status.signal != 0 {
            w.write("'${f.program}' killed by signal ${f.status.signal}")
          } else {
            w.write("'${f.program}' exited with code ${f.status.exit-code}")
          }
          if not f.status.output.is-empty() {
            w.write(": ")
            w.write(f.status.output)
          }
        }
      }
    }
  }

  // execvp's search rule, done up front instead of by the spawn capability: a
  // failed exec is reported to the parent on darwin but not on glibc, where the
  // child just exits 127, indistinguishable from a command that ran and exited
  // 127. Resolving here is the only portable way to tell those apart.
  fn resolve-program(program: string): result[string, run-error] {
    if program.contains('/') {
      return if core/platform/io/is-executable(program) :ok program
             else :err :spawn .{ program = program, message = "not executable" }
    }
    require core/sys/env("PATH") is :some path else {
      return :err :spawn .{ program = program, message = "PATH is unset" }
    }
    for dir in path.split-by-char(':') {
      let candidate = if dir.is-empty() "./$program" else "$dir/$program"
      if core/platform/io/is-executable(candidate) return :ok candidate
    }
    :err :spawn .{ program = program, message = "command not found" }
  }

  fn full-argv(program: string, args: span[string]): span[string] {
    let argv = list/with-capacity[string](args.len() + 1)
    argv.push(program)
    for arg in args { argv.push(arg) }
    argv.as-span()
  }

  fn reap(pid: i32, program: string): result[run-output, run-error] {
    if core/platform/process/wait(pid) is {
      :ok(s) -> :ok .{ exit-code = s.exit-code, signal = s.signal, output = "" },
      :err(code) -> :err :spawn .{
        program = program,
        message = "waitpid failed: ${core/platform/error-string(code)}"
      }
    }
  }

  // Exit status is data: a nonzero exit or signal death is still :ok, reported
  // in run-output; the err is always :spawn
  fn run-status(program: string, args: span[string], mode: output-mode): result[run-output, run-error] {
    let program-path = resolve-program(program).try

    let pipe-read: i32 = -1
    let child-out: i32 = if mode is {
      :inherit -> -1,
      :capture -> {
        let p = if core/platform/io/pipe() is {
          :some(p) -> p,
          :none -> return :err :spawn .{ program = program, message = "pipe failed" }
        }
        pipe-read = p.read.raw
        p.write.raw
      },
      :drop -> {
        if core/platform/io/open-to-write("/dev/null") is {
          :some(h) -> h.raw,
          :none -> return :err :spawn .{ program = program, message = "open /dev/null failed" }
        }
      }
    }

    let spawned = core/platform/process/spawn(
      path = program-path,
      argv = full-argv(program, args),
      fd0 = -1,
      fd1 = child-out,
      fd2 = child-out,
      extra-close = [pipe-read]
    )
    if child-out >= 0 { core/platform/io/close(.{ raw = child-out }) }
    let pid = if spawned is {
      :ok(pid) -> pid,
      :err(code) -> {
        if pipe-read >= 0 { core/platform/io/close(.{ raw = pipe-read }) }
        return :err :spawn .{
          program = program,
          message = "spawn failed: ${core/platform/error-string(code)}"
        }
      }
    }

    let output = if mode is :capture {
      mem/push-arena(mem/tmp())
      let read-result = fd/read-all(pipe-read)
      mem/pop-arena()
      core/platform/io/close(.{ raw = pipe-read })
      if read-result is {
        :ok s -> s,
        :err message -> {
          // Reap before reporting so we never leave a zombie behind
          let _ = core/platform/process/wait(pid)
          return :err :spawn .{ program = program, message = "pipe read failed: $message" }
        },
      }
    } else ""

    let r = reap(pid, program).try
    :ok .{ exit-code = r.exit-code, signal = r.signal, output = output }
  }

  // Any failure -- spawn, nonzero exit, death by signal -- is the err; ok is
  // the captured output (empty for :drop and :inherit)
  fn run-command(program: string, args: span[string], mode: output-mode): result[string, run-error] {
    let r = run-status(program, args, mode).try
    if r.exit-code == 0 { :ok r.output }
    else :err :failed .{ program = program, status = r }
  }

  // Runs `program`, resolved via PATH, with stdout and stderr merged into the output
  fn run(program: string, args: span[string]): result[string, run-error] {
    run-command(program, args, :capture)
  }

  fn sh(command: string): result[string, run-error] {
    run("/bin/sh", ["-c", command])
  }

  fn run-verbose(program: string, args: span[string]): sh.return {
    let start = time/read-cpu-counter()
    let arg-text = string/join(args, " ")
    core/io/stderr.write("+ $program $arg-text\n")
    defer core/io/stderr.write("+ [${time/elapsed-ms(start)}ms]\n")
    run-command(program, args, :inherit)
  }

  fn sh-verbose(script: string): sh.return {
    let start = time/read-cpu-counter()
    defer core/io/stderr.write("+ [${time/elapsed-ms(start)}ms]\n")
    run-command("/bin/sh", ["-c", "set -ex\n$script"], :inherit)
  }

  // A long-lived interactive child: stdin and stdout piped, stderr inherited.
  // Talk to it through the raw fds: fd/write-all(child.stdin-fd, ..) and
  // child.stdout.read-line(); protocol shaping (lines, framing) is the
  // caller's business.
  type child = {
    program: string,
    pid: i32,
    stdin-fd: i32,
    stdout: fd/reader,
  }

  // stdin and stdout piped, stderr inherited so the child's own noise and
  // crashes stay visible
  fn spawn(program: string, args: span[string]): result[child, run-error] {
    let program-path = resolve-program(program).try

    // in: parent writes, child reads; out: child writes, parent reads
    let in-pipe = if core/platform/io/pipe() is {
      :some(p) -> p,
      :none -> return :err :spawn .{ program = program, message = "pipe failed" }
    }
    let out-pipe = if core/platform/io/pipe() is {
      :some(p) -> p,
      :none -> {
        core/platform/io/close(in-pipe.read)
        core/platform/io/close(in-pipe.write)
        return :err :spawn .{ program = program, message = "pipe failed" }
      }
    }

    let spawned = core/platform/process/spawn(
      path = program-path,
      argv = full-argv(program, args),
      fd0 = in-pipe.read.raw,
      fd1 = out-pipe.write.raw,
      fd2 = -1,
      extra-close = [in-pipe.write.raw, out-pipe.read.raw]
    )
    core/platform/io/close(in-pipe.read)
    core/platform/io/close(out-pipe.write)
    let pid = if spawned is {
      :ok(pid) -> pid,
      :err(code) -> {
        core/platform/io/close(in-pipe.write)
        core/platform/io/close(out-pipe.read)
        return :err :spawn .{
          program = program,
          message = "spawn failed: ${core/platform/error-string(code)}"
        }
      }
    }
    :ok .{
      program = program,
      pid = pid,
      stdin-fd = in-pipe.write.raw,
      stdout = fd/reader/new(out-pipe.read.raw),
    }
  }

  fn child-close-pipes(child: *mut child) {
    if child.stdin-fd >= 0 {
      core/platform/io/close(.{ raw = child.stdin-fd })
      child.stdin-fd = -1
    }
    if child.stdout.fd >= 0 {
      core/platform/io/close(.{ raw = child.stdout.fd })
      child.stdout.fd = -1
    }
  }

  ns for child {

    // Closes both pipes (EOF on the child's stdin) and reaps
    fn wait(self: *mut child): result[run-output, run-error] {
      child-close-pipes(self)
      reap(self.pid, self.program)
    }

    fn kill(self: *mut child) {
      core/platform/process/kill(self.pid)
    }

  }

}
