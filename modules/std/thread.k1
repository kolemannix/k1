ns thread

type(alias) thread = ptr

// No arms for wasi or bare: TLS lowers to plain globals there, so running a
// second thread is unsound by construction
fn start[t](handle: *thread, function: *fn(*t) -> ptr, input: *t) {
  let spawned =
    if k1/is-static posix/port/thread-spawn(function.as[ptr], input.as[ptr])
    else #if k1/platform is {
      :posix-macos or :posix-linux -> posix/port/thread-spawn(function.as[ptr], input.as[ptr]),
      :wasi or :bare -> crash("threads are not supported on this platform")
    }
  if spawned.is-null() crash("thread spawn failed")
  handle.* = spawned
}

// Fire-and-forget: no join handle, the thread's resources release on exit.
// `input` must outlive the thread; the caller can't know when it finishes,
// so heap-allocate it and free it from the thread fn.
fn start-detached[t](function: *fn(*t) -> ptr, input: *t) {
  let handle: thread = ptr/null
  start(handle.&, function, input)
  detach(handle)
}

type task-state[f, t] = { body: f, result: *t }

type task[t] = { thread: thread, result: *t }

ns for task {

  fn spawn[t](body: some fn() -> t): task[t] {
    let result = heap.alloc-t[t]
    let state = heap.new(task-state[type-of(body), t].{ body = body, result = result })
    let thread: thread = ptr/null
    start(thread.&, fn(s: *task-state[type-of(body), t] -> ptr) {
      s.result.* = (s.body)()
      heap.free-t(s)
      ptr/null
    }, state)
    .{ thread = thread, result = result }
  }

  fn join[t](self: task[t]): t {
    thread/join(self.thread)
    let value = self.result.*
    heap.free-t(self.result)
    value
  }

}

fn sleep-ms(ms: u64) {
  if k1/is-static posix/port/sleep-ms(ms)
  else #if k1/platform is {
    :posix-macos or :posix-linux -> posix/port/sleep-ms(ms),
    :wasi -> wasi/sleep-ms(ms),
    :bare -> bare/sleep-ms(ms)
  }
}

fn cpu-count(): size {
  if k1/is-static posix/port/cpu-count()
  else #if k1/platform is {
    :posix-macos or :posix-linux -> posix/port/cpu-count(),
    :wasi or :bare -> 1
  }
}

type sleep-poll-mutex = { state: u64 }

ns for sleep-poll-mutex {

  fn new(): sleep-poll-mutex { .0 }

  fn lock(self: *sleep-poll-mutex) {
    while atomic/cmpxchg(self.state.&, 0: u64, 1, :acquire, :relaxed).ok == false {
      sleep-ms(1)
    }
  }

  fn unlock(self: *sleep-poll-mutex) {
    atomic/store(self.state.&, 0: u64, :release)
  }

}

fn join(thread: thread): ptr {
  if k1/is-static posix/port/thread-join(thread)
  else #if k1/platform is {
    :posix-macos or :posix-linux -> posix/port/thread-join(thread),
    :wasi or :bare -> crash("threads are not supported on this platform")
  }
}

fn detach(thread: thread) {
  if k1/is-static posix/port/thread-detach(thread)
  else #if k1/platform is {
    :posix-macos or :posix-linux -> posix/port/thread-detach(thread),
    :wasi or :bare -> crash("threads are not supported on this platform")
  }
}
