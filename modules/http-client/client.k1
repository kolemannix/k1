use std/fd
use std/net
use std/stream/pull
use std/stream/source
use std/ring
use std/sys
use std/thread/sleep-poll-mutex
use std/time
use std/url

type config = {
  trust: tls/trust,
  connect-timeout-ms: u64,
  read-timeout-ms: ?u64,
  write-timeout-ms: ?u64,
  max-idle-per-origin: u32,
  max-idle-total: u32,
  idle-timeout-ms: u64,
  max-header-size: size,
  max-body-size: size,
  max-redirects: u32,
}

ns for config {
  fn default(): config {
    .{
      trust = :system,
      connect-timeout-ms = 10_000,
      read-timeout-ms = :some 30_000,
      write-timeout-ms = :some 30_000,
      max-idle-per-origin = 16,
      max-idle-total = 256,
      idle-timeout-ms = 60_000,
      max-header-size = 64 * 1024,
      max-body-size = 16 * 1024 * 1024,
      max-redirects = 5,
    }
  }
}

type error = either {
  invalid-request(string),
  resolve(net/resolve-error),
  connect(i32),
  timeout,
  tls(tls/error),
  transport(i32),
  truncated,
  protocol(http/llhttp/errno),
  header-too-large,
  body-too-large,
  too-many-redirects,
  insecure-redirect(string),
}

impl print for error {
  fn print-to[w: writer](self, w) {
    if self is {
      :invalid-request(reason) -> w.write("invalid HTTP request: $reason"),
      :resolve(e) -> w.write("could not resolve $e"),
      :connect(code) -> w.write("could not connect: ${sys/error-string(code)}"),
      :timeout -> w.write("HTTP request timed out"),
      :tls(e) -> w.write("$e"),
      :transport(code) -> w.write("HTTP connection failed: ${sys/error-string(code)}"),
      :truncated -> w.write("HTTP connection closed before the response ended"),
      :protocol(code) -> w.write("malformed HTTP response: ${code.enum-name()}"),
      :header-too-large -> w.write("HTTP response headers are too large"),
      :body-too-large -> w.write("HTTP response body is too large"),
      :too-many-redirects -> w.write("too many HTTP redirects"),
      :insecure-redirect(location) -> w.write("refused HTTP redirect from https to `$location`"),
    }
  }
}

ns for error {
  fn from-tls(e: tls/error): error {
    if e is {
      :timeout -> :timeout,
      :truncated -> :truncated,
      :transport(code) -> :transport(code),
      _ -> :tls(e),
    }
  }

  fn from-errno(code: i32): error { if net/is-timeout(code) :timeout else :transport(code) }
}

type client = {
  config: config,
  tls-config: *tls/config,
  lock: sleep-poll-mutex,
  idle: ring[*client/connection],
  open-bodies: atomic/cell[u32],
}

ns for client {

fn new(config: config): result[*client, error] {
  let tls-config = tls/config/new(config.trust, "http/1.1").map-err(error/from-tls).try
  let idle = ring/init-in[*connection, heap](heap, config.max-idle-total.as[size])
  :ok heap.new(.{ config, tls-config, lock = sleep-poll-mutex/new(), idle, open-bodies = .0 })
}

fn close(self: *client) {
  let open = self.open-bodies.load(:acquire)
  if open > 0 crash("http-client: close with $open response bodies neither read to the end nor stopped")
  for self.idle { it.close() }
  self.idle.free-in(heap)
  self.tls-config.free()
  heap.free-t(self)
}

fn fetch(self: *client, request: http/request): result[response, error] { self.stream(request).try.read-all() }

fn stream(self: *client, request: http/request): result[stream-response, error] {
  // Validate the request headers
  for h in request.head.headers {
    if h.name.is-empty() or h.name.exists(fn c. not (c.is-ascii-letter() or c.is-ascii-digit() or "!#$%&'*+-.^_`|~".contains(c))) {
      return :err(:invalid-request("bad header name `${h.name}`"))
    }
    if h.value.exists(fn c. c.as-u8() < 0x20 and c != '\t' or c.as-u8() == 0x7f) {
      return :err(:invalid-request("control character in header `${h.name}`"))
    }
    let owned-fields: span[string] = ["Host", "Content-Length", "Transfer-Encoding", "Connection"]
    if owned-fields.exists(fn[h] owned. h.name.equals-ignore-ascii-case(owned)) {
      return :err(:invalid-request("`${h.name}` is set by the HTTP client"))
    }
  }

  let current = request
  let target = target/from-url(current.head.url).try
  let redirect-count: u32 = 0
  loop {
    let connection = connection/exchange(self, current, target).try
    let head = connection.parser.head.!
    let keeps-body = head.status == 307 or head.status == 308
    let is-redirect = keeps-body or head.status >= 301 and head.status <= 303
    let location = if self.config.max-redirects > 0 and is-redirect head.find-header("Location") else :none
    require location is :some location else {
      let _ = self.open-bodies.add(1, :relaxed)
      return :ok .{ head, body = mem/new(.{ client = self, connection = :some connection, failure = :none, has-delivered = false }) }
    }
    connection.check-in(self)
    if redirect-count == self.config.max-redirects return :err(:too-many-redirects)
    redirect-count = redirect-count + 1

    // Follow the redirect
    require url/parse(location) is :ok reference else return :err(:invalid-request("bad redirect Location `$location`"))
    let next-url = current.head.url.resolve(reference)
    let next-target = target/from-url(next-url).try
    if target.is-https and not next-target.is-https return :err(:insecure-redirect(location))
    let is-cross-origin = next-target.origin != target.origin
    let credential-fields: span[string] = ["Authorization", "Cookie", "Proxy-Authorization"]
    let headers = list/empty[http/header-field]()
    for h in current.head.headers {
      let is-dropped =
        is-cross-origin and credential-fields.exists(fn[h] name. h.name.equals-ignore-ascii-case(name))
        or (not keeps-body) and h.name.starts-with-ignore-ascii-case("content-")
      if not is-dropped { headers.push(h) }
    }
    let method = if keeps-body or current.head.method is :HEAD { current.head.method } else :GET
    current = .{
      head = current.head | .{ url = next-url, headers, method },
      body = if keeps-body current.body else span/empty(),
    }
    target = next-target
  }
}

type target = {
  is-https: bool,
  hostname: string,
  port: u16,
  origin: string,
  host-field: string,
  path-and-query: string,
}

ns for target {
  fn from-url(url: url/url): result[target, error] {
    require url.scheme() is :some scheme else return :err(:invalid-request("`$url` has no scheme"))
    let is-https = scheme.equals-ignore-ascii-case("https")
    if (not is-https) and not scheme.equals-ignore-ascii-case("http") {
      return :err(:invalid-request("`$url` is not http or https"))
    }
    require url.host() is :some host and host.non-empty() else return :err(:invalid-request("`$url` has no host"))
    if url.userinfo().is-some() return :err(:invalid-request("credentials in `$url`: set an Authorization header"))

    let default-port = url/default-port(scheme).!
    let port = url.port() ? default-port
    let path = if url.path().is-empty() "/" else url.path()
    :ok .{
      is-https,
      hostname = if host.starts-with("[") host.slice(1, host.len() - 1) else host,
      port,
      origin = "${scheme.to-ascii-lower()}://${host.to-ascii-lower()}:$port",
      host-field = if port == default-port host else "$host:$port",
      path-and-query = if url.query() is :some query "$path?$query" else path,
    }
  }
}

type connection = {
  origin: string,
  stream: net/tcp-stream,
  secure: ?*tls/client,
  parser: http/response-parser,
  buffer: array[u8, 16384],
  idle-since: u64,
  has-received: bool,
  keeps-alive: bool,
}

ns for connection {
  fn open(target: target, client: *client): result[*connection, error] {
    let addresses = net/resolve(target.hostname, target.port).map-err(fn(e: net/resolve-error) error:resolve(e)).try
    let config = client.config
    let connected: ?net/tcp-stream = :none
    let last-code: i32 = 0
    for address in addresses {
      if net/connect(address, config.connect-timeout-ms) is {
        :ok(stream) -> {
          connected = :some stream
          break
        },
        :err(code) -> { last-code = code },
      }
    }
    require connected is :some stream else {
      return :err(if net/is-timeout(last-code) :timeout else :connect(last-code))
    }
    let self = heap.alloc-t[connection]
    self.origin = target.origin.cloned-in(heap)
    self.stream = stream
    self.secure = :none
    self.parser.init(config.max-header-size)
    defer r. if r is :err _ self.close()

    stream.set-no-delay(true).map-err(error/from-errno).try
    stream.set-read-timeout(:some config.connect-timeout-ms).map-err(error/from-errno).try
    stream.set-write-timeout(:some config.connect-timeout-ms).map-err(error/from-errno).try
    if target.is-https { self.secure = :some tls/connect(client.tls-config, stream, target.hostname).map-err(error/from-tls).try }
    stream.set-read-timeout(config.read-timeout-ms).map-err(error/from-errno).try
    stream.set-write-timeout(config.write-timeout-ms).map-err(error/from-errno).try
    :ok self
  }

  fn close(self: *connection) {
    if self.secure is :some session { session.close() }
    self.stream.close()
    heap.free(self.origin.data-ptr(), self.origin.len(), 1)
    heap.free-t(self)
  }

  fn write-all(self: *connection, bytes: span[u8]): result[empty, error] {
    if self.secure is :some session session.write-all(bytes).map-err(error/from-tls)
    else self.stream.write-all(bytes).map-err(error/from-errno)
  }

  fn read-more(self: *connection): result[empty, error] {
    let buffer = self.buffer.data-ptr()
    let n =
      if self.secure is :some session session.read(buffer, self.buffer.len()).map-err(error/from-tls).try
      else fd/read(self.stream.file, buffer, self.buffer.len()).result().map-err(error/from-errno).try
    if n == 0 {
      self.parser.finish()
      return if self.parser.is-complete :ok else :err(:truncated)
    }
    self.has-received = true
    if self.parser.feed(span/wrap-raw(self.buffer.data-ptr(), n)) is {
      :ok -> :ok,
      :paused(leftover) -> {
        if leftover > 0 { self.parser.is-reusable = false }
        :ok
      },
      :fail(:HPE_USER) -> :err(:header-too-large),
      :fail(code) -> :err(:protocol(code)),
    }
  }

  fn send-request(self: *connection, request: http/request, head-text: string): result[empty, error] {
    self.parser.begin(mem/current-arena(), request.head.method is :HEAD)
    self.has-received = false
    self.keeps-alive = request.head.keep-alive
    self.write-all(head-text.span-bytes()).try
    self.write-all(request.body).try
    while self.parser.head.is-none() { self.read-more().try }
    :ok
  }

  fn exchange(client: *client, request: http/request, target: target): result[*connection, error] {
    // Format the request head
    let method = request.head.method
    let out = string-builder/with-capacity(512)
    out.write("${string/wrap-c(http/llhttp/method_name(method).get())} ${target.path-and-query} HTTP/1.1\r\n")
    out.write("Host: ${target.host-field}\r\n")
    for h in request.head.headers { out.write("${h.name}: ${h.value}\r\n") }
    if request.body.non-empty() or method is :POST or method is :PUT or method is :PATCH {
      out.write("Content-Length: ${request.body.len()}\r\n")
    }
    if not request.head.keep-alive { out.write("Connection: close\r\n") }
    out.write("\r\n")
    let head-text = out.build()

    if take-idle(client, target.origin) is :some pooled {
      require pooled.send-request(request, head-text) is :err(e) else return :ok pooled
      let is-safe-method = method is :GET or method is :HEAD or method is :OPTIONS or method is :TRACE
      let may-retry = is-safe-method and (not pooled.has-received) and not (e is :timeout)
      pooled.close()
      if not may-retry return :err(e)
    }
    let connection = open(target, client).try
    if connection.send-request(request, head-text) is :err(e) {
      connection.close()
      return :err(e)
    }
    :ok connection
  }

  fn take-idle(client: *client, origin: string): ?*connection {
    loop {
      let expired = list/empty[*connection]()
      let found: ?*connection = :none
      client.lock.lock()
      move-expired(client, expired.&)
      let idle = client.idle.&
      let i = idle.len()
      while i > 0 and found.is-none() {
        i = i - 1
        if idle.[i].origin == origin {
          found = :some idle.[i]
          idle.remove(i)
        }
      }
      client.lock.unlock()
      for expired { it.close() }
      require found is :some connection else return :none
      if not fd/poll-readable(connection.stream.file) return found
      connection.close()
    }
  }

  fn check-in(self: *connection, client: *client) {
    if not (self.keeps-alive and self.parser.is-reusable) {
      self.close()
      return
    }
    let evicted = list/empty[*connection]()
    client.lock.lock()
    move-expired(client, evicted.&)
    let idle = client.idle.&
    let same-origin-count: u32 = 0
    for idle { if it.origin == self.origin { same-origin-count = same-origin-count + 1 } }
    let has-room = same-origin-count < client.config.max-idle-per-origin and idle.cap() > 0
    if has-room {
      if idle.is-full() { evicted.push(idle.pop-front().!) }
      self.idle-since = time/read-cpu-counter()
      idle.push(self)
    }
    client.lock.unlock()
    if not has-room { self.close() }
    for evicted { it.close() }
  }

  fn move-expired(client: *client, expired: *list[*connection]) {
    let idle = client.idle.&
    while idle.non-empty() and time/elapsed-ms(idle.[0].idle-since) >= client.config.idle-timeout-ms {
      expired.push(idle.pop-front().!)
    }
  }
}

}

type body-reader = {
  client: *client,
  connection: ?*client/connection,
  failure: ?error,
  has-delivered: bool,
}

impl source[t = u8] for body-reader {
  fn pull(self: *body-reader): pull[u8] {
    require self.connection is :some connection else {
      return if self.failure is :some e :fail "$e" else :done
    }
    if self.has-delivered { connection.parser.body-parts.clear() }
    loop {
      if connection.parser.body-parts.non-empty() {
        self.has-delivered = true
        return :chunk connection.parser.body-parts.as-span()
      }
      if connection.parser.is-complete {
        self.stop()
        return :done
      }
      if connection.read-more() is :err(e) {
        self.failure = :some e
        self.stop()
        return :fail "$e"
      }
    }
  }

  fn stop(self: *body-reader) {
    require self.connection is :some connection else return
    self.connection = :none
    connection.check-in(self.client)
    let _ = self.client.open-bodies.sub(1, :release)
  }
}

type response = { head: http/response-head, body: span[u8] }

type stream-response = { head: http/response-head, body: *body-reader }

ns for stream-response {
  fn read-all(self: stream-response): result[response, error] {
    let reader = self.body
    let max-size = reader.client.config.max-body-size
    let has-more-to-read = reader.connection is :some connection and not connection.parser.is-complete
    let expected = if has-more-to-read { self.head.content-length ? 0 } else 0
    if expected > max-size {
      reader.stop()
      return :err(:body-too-large)
    }
    let body = list/with-capacity[u8](expected)
    loop {
      if reader.pull() is {
        :chunk group -> for part in group {
          if body.len() + part.len() > max-size {
            reader.stop()
            return :err(:body-too-large)
          }
          body.append-span(part)
        },
        :pending -> crash("a blocking HTTP body never pends"),
        :done -> return :ok .{ head = self.head, body = body.as-span() },
        :fail(_) -> return :err(reader.failure.!),
      }
    }
  }
}
