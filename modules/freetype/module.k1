ns build {
  use std/process

  fn module(): k1/module {
    let m = k1/module/new()
    m.lib("freetype", :dynamic)
    m.setup(outputs = ["libs/libfreetype.dylib", "c.k1"], inputs = ["ft.h"])
    m
  }

  // Links the homebrew freetype dylib and regenerates bindings from ft.h.
  // Endgame is a vendored static build (like sdl3); this gets the API stable first.
  fn setup(_ctx: k1/setup-ctx) {
    process/sh-verbose(`
      mkdir -p libs
      ln -sf "$(brew --prefix freetype)/lib/libfreetype.dylib" libs/libfreetype.dylib
      `).!

    let inc = process/sh("printf %s $(brew --prefix freetype)/include/freetype2").!
    let bindgen-args: list[string] = [
      "-in-path", "ft.h",
      "-out-path", "c.k1",
      "-lib-name", "freetype",
      "-ns-name", "c",
      "+strip-prefix", "FT_",
      "+clangarg", "-I$inc",
    ]
    if k1/platform-macos {
      let sdk = process/sh("printf %s $(xcrun --sdk macosx --show-sdk-path)").!
      bindgen-args.push("+clangarg")
      bindgen-args.push("-isysroot")
      bindgen-args.push("+clangarg")
      bindgen-args.push(sdk)
    }
    let _ = process/run-verbose("k1bindgen", bindgen-args.as-span()).!
  }
}
