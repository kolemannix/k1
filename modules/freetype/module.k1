use std/process

fn module(): k1/module {
  let m = k1/module/new()
  m.lib("freetype", :dynamic)
  m.setup(["libs/libfreetype.dylib", "freetype.k1"], ["ft.h"])
  m
}

// Links the homebrew freetype dylib and regenerates bindings from ft.h.
// Endgame is a vendored static build (like sdl3); this gets the API stable first.
fn setup(_ctx: k1/setup-ctx) {
  let script = `
    set -e
    mkdir -p libs
    ln -sf "$(brew --prefix freetype)/lib/libfreetype.dylib" libs/libfreetype.dylib
    `
  process/run-command("/bin/sh", ["-c", script], :inherit).!

  let inc = process/run("/bin/sh", ["-c", "printf %s $(brew --prefix freetype)/include/freetype2"]).!
  let bindgen-args: list[string] = [
    "-in-path", "ft.h",
    "-out-path", "freetype.k1",
    "-lib-name", "freetype",
    "+strip-prefix", "FT_",
    "+clangarg", "-I$inc",
  ]
  if k1/platform-macos {
    let sdk = process/run("/bin/sh", ["-c", "printf %s $(xcrun --sdk macosx --show-sdk-path)"]).!
    bindgen-args.push("+clangarg")
    bindgen-args.push("-isysroot")
    bindgen-args.push("+clangarg")
    bindgen-args.push(sdk)
  }
  let _ = process/run-command("k1bindgen", bindgen-args.as-span(), :inherit).!
}
