fn(test) c-layouts() {
  assert-layout[sqlite_int64](8, 8, [])
  assert-layout[sqlite_uint64](8, 8, [])
  assert-layout[int64](8, 8, [])
  assert-layout[uint64](8, 8, [])
  assert-layout[callback](8, 8, [])
  assert-layout[file](8, 8, [0, ])
  assert-layout[io_methods](152, 8, [0, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128, 136, 144, ])
  assert-layout[filename](8, 8, [])
  assert-layout[syscall_ptr](8, 8, [])
  assert-layout[vfs](168, 8, [0, 4, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128, 136, 144, 152, 160, ])
  assert-layout[mem_methods](64, 8, [0, 8, 16, 24, 32, 40, 48, 56, ])
  assert-layout[destructor_type](8, 8, [])
  assert-layout[module](200, 8, [0, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128, 136, 144, 152, 160, 168, 176, 184, 192, ])
  assert-layout[index_constraint](12, 4, [0, 4, 5, 8, ])
  assert-layout[index_orderby](8, 4, [0, 4, ])
  assert-layout[index_constraint_usage](8, 4, [0, 4, ])
  assert-layout[index_info](96, 8, [0, 8, 16, 24, 32, 40, 48, 56, 60, 64, 72, 80, 88, ])
  assert-layout[vtab](24, 8, [0, 8, 16, ])
  assert-layout[vtab_cursor](8, 8, [0, ])
  assert-layout[mutex_methods](72, 8, [0, 8, 16, 24, 32, 40, 48, 56, 64, ])
  assert-layout[pcache_page](16, 8, [0, 8, ])
  assert-layout[pcache_methods2](104, 8, [0, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, ])
  assert-layout[pcache_methods](88, 8, [0, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, ])
  assert-layout[snapshot](48, 1, [0, ])
  assert-layout[rtree_dbl](8, 8, [])
  assert-layout[rtree_geometry](40, 8, [0, 8, 16, 24, 32, ])
  assert-layout[rtree_query_info](112, 8, [0, 8, 16, 24, 32, 40, 48, 56, 60, 64, 72, 80, 88, 92, 96, 104, ])
  assert-layout[fts5_extension_function](8, 8, [])
  assert-layout[Fts5PhraseIter](16, 8, [0, 8, ])
  assert-layout[Fts5ExtensionApi](192, 8, [0, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 120, 128, 136, 144, 152, 160, 168, 176, 184, ])
  assert-layout[fts5_tokenizer_v2](32, 8, [0, 8, 16, 24, ])
  assert-layout[fts5_tokenizer](24, 8, [0, 8, 16, ])
  assert-layout[fts5_api](48, 8, [0, 8, 16, 24, 32, 40, ])
}
