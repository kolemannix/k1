use std/process

fn module(_b: k1/build-config): k1/module {
  let m = k1/module/new()
  m.lib("sqlite3", :static)
  m.setup(outputs = ["libs/libsqlite3.a", "libs/libsqlite3.${k1/host-platform.dylib-ext()}", "sqlite3.k1"], inputs = ["vendor"])
  m
}

let defines: span[string] = [
  "SQLITE_DQS=0",
  "SQLITE_ENABLE_COLUMN_METADATA",
  "SQLITE_DEFAULT_MEMSTATUS=0",
  "SQLITE_DEFAULT_WAL_SYNCHRONOUS=1",
  "SQLITE_LIKE_DOESNT_MATCH_BLOBS",
  "SQLITE_MAX_EXPR_DEPTH=0",
  "SQLITE_OMIT_DEPRECATED",
  "SQLITE_OMIT_LOAD_EXTENSION",
  "SQLITE_USE_ALLOCA",
  "SQLITE_STRICT_SUBTYPE=1",
]

fn setup(ctx: k1/setup-ctx) {
  let minver = if (ctx.build.target is :arm64-macos) "-mmacosx-version-min=15.0.0" else ""
  let cflags = string-builder/new()
  for defines { cflags.write(" -D$it") }
  process/sh-verbose(`
    mkdir -p libs .k1-out/sqlite
    cc -O2 -fPIC ${minver}${cflags.build()} -c vendor/sqlite3.c -o .k1-out/sqlite/sqlite3.o
    ar rcs libs/libsqlite3.a .k1-out/sqlite/sqlite3.o
    cc -shared .k1-out/sqlite/sqlite3.o -o libs/libsqlite3.${k1/host-platform.dylib-ext()}
    `).!

  let bindgen-args: list[string] = [
    "-in-path", "vendor/sqlite3.h",
    "-out-path", "sqlite3.k1",
    "-lib-name", "sqlite3",
    "+strip-prefix", "sqlite3_",
    "+strip-prefix", "SQLITE_",
    "+rename", "sqlite3:db",
    "+exclude", "sqlite3_load_extension",
    "+exclude", "sqlite3_enable_load_extension",
  ]
  for defines {
    bindgen-args.push("+clangarg")
    bindgen-args.push("-D$it")
  }
  let _ = process/run-verbose("k1bindgen", bindgen-args.as-span()).!
}
