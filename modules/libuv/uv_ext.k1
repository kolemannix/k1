
ability uv-request {
  fn as-request(self: *self): *uv/req
  fn set-data[t](self: *self, data: *t) { uv/req_set_data(self.as-request(), data.as[ptr]) }
  fn get-data[t](self: *self): *t { uv/req_get_data(self.as-request()).narrow[*t] }
}

impl uv-request for uv/fs {
  fn as-request(self: *self): *uv/req { self.narrow() }
}

impl uv-request for uv/work {
  fn as-request(self: *self): *uv/req { self.narrow() }
}

impl uv-request for uv/write {
  fn as-request(self: *self): *uv/req { self.narrow() }
}

impl uv-request for uv/connect {
  fn as-request(self: *self): *uv/req { self.narrow() }
}

fn set-request-data[r: uv-request, t](
  req: *r,
  data: *t,
) {
  uv/req_set_data(req.as-request(), data.as[ptr])
}
fn get-request-data[r: uv-request, t](
  req: *r,
): *t {
  uv/req_get_data(req.as-request()).narrow[*t]
}

ability uv-handle {
  fn as-handle(self: *self): *uv/handle
  fn set-data[t](self: *self, data: *t) { uv/handle_set_data(self.as-handle(), data.as[ptr]) }
  fn get-data[t](self: *self): *t { uv/handle_get_data(self.as-handle()).narrow[*t] }
}

impl uv-handle for uv/tcp {
  fn as-handle(self: *self): *uv/handle { self.narrow() }
}

impl uv-handle for uv/async {
  fn as-handle(self: *self): *uv/handle { self.narrow() }
}

impl uv-handle for uv/timer {
  fn as-handle(self: *self): *uv/handle { self.narrow() }
}

impl uv-handle for uv/signal {
  fn as-handle(self: *self): *uv/handle { self.narrow() }
}

impl uv-handle for uv/stream {
  fn as-handle(self: *self): *uv/handle { self.narrow() }
}

impl uv-handle for uv/handle {
  fn as-handle(self: *self): *uv/handle { self }
}

ns uv {
  ns for buf {
    fn as-buffer(self: buf): buffer[u8] {
      buffer/wrap-raw(self.base.inner, self.len.signed())
    }

    fn wrap-buffer(buffer: buffer[u8]): buf {
      uv/buf_init(mem/bitcast[ptr, *u8](buffer.data), buffer.len.trunc[u32])
    }

    fn wrap-span(span: span[u8]): buf {
      wrap-buffer(span.inner-buffer())
    }
  }

  ns for errno {
    fn from-i32(i: i32): errno {
      if i >= 0 crash("not an errno: $i")
      enum/enum-from-value-unchecked(i)
    }
  }

  impl print for errno {
    fn print-to[w: writer](self, w) { w.write(string/wrap-c(strerror(self.enum-value()).inner)) }
  }

  type status = { code: i32 }

  fn check(code: i32): status { .{ code } }

  impl try[t = empty, e = errno] for status {
    fn error(e: errno): status { .{ code = e.enum-value() } }
    fn value(_t: empty): status { .{ code = 0 } }
    fn is-ok(self): bool { self.code >= 0 }
    fn get-error(self): errno { errno/from-i32(self.code) }
    fn get-value(self): empty {
      if self.code < 0 crash("libuv call failed: ${errno/from-i32(self.code)}")
    }
  }
}

ability uv-stream {
  fn as-stream(self: *self): *uv/stream
}

impl uv-stream for uv/tcp {
  fn as-stream(self: *self): *uv/stream { self.narrow() }
}

impl uv-stream for uv/stream {
  fn as-stream(self: *self): *uv/stream { self }
}
