// Builds the vendored libuv release (v1.52.1, from github.com/libuv/libuv;
// vendor bumps replace vendor/ wholesale) and regenerates the uv/net bindings.
// Needs cmake and k1bindgen on PATH.
use std/process

// The host SDK, for system headers
fn sdk-args(): list[string] {
  if not k1/os-macos { return list/empty() }
  let sdk = process/run("/bin/sh", ["-c", "printf %s $(xcrun --sdk macosx --show-sdk-path)"]).!
  let args: list[string] = [
    "+clangarg", "-isysroot",
    "+clangarg", sdk,
  ]
  args
}

fn setup(ctx: k1/setup-ctx) {
  let _ = process/run-command("mkdir", ["-p", "libs"], :inherit).!

  let _ = process/run-command("cmake", ["-S", "vendor", "-B", ".k1-out/libuv-build", "-DBUILD_TESTING=OFF", "-DCMAKE_BUILD_TYPE=Release"], :inherit).!
  let _ = process/run-command("cmake", ["--build", ".k1-out/libuv-build", "-j", "8"], :inherit).!
  let _ = process/run-command("cp", [".k1-out/libuv-build/libuv.a", "libs/libuv.a"], :inherit).!

  let net-args: list[string] = [
    "-in-path", "net.c",
    "-out-path", "net.k1",
    "-lib-name", "net",
    "-system", "true",
    "+include", "sockaddr_in",
    "+include", "sockaddr_in6",
    "+include", "sa_family_t",
    "+include", "sockaddr",
    "+include", "socklen_t",
    "+opaque", "socklen_t",
    "+include", "addrinfo",
    "+include", "in_port_t",
    "+include", "in_addr",
    "+include", "in6_addr",
    "+include", "in_addr_t",
    "+include", "FILE",
    "+opaque", "FILE",
  ]
  for sdk-args() { net-args.push(it) }
  let _ = process/run-command("k1bindgen", net-args.as-span(), :inherit).!

  let uv-args: list[string] = [
    "-in-path", "vendor/include/uv.h",
    "-out-path", "uv.k1",
    "-lib-name", "uv",
    "-prelude-file", "uv_bindgen_prelude.k1.txt",
    "+clangarg", "-Ivendor/include",
    "+rename", "uv_loop_t:uv-loop",
    "+rename", "uv_fs_event:fs_event_kind",
    "+strip-prefix", "uv_",
    "+strip-suffix", "_t",
    "+opaque", "uv__dirent_t",
    "+opaque", "uv_uid_t",
    "+opaque", "uv_gid_t",
    "+opaque", "uv_pid_t",
    "+opaque", "uv_once_t",
    "+opaque", "uv_thread_t",
    "+opaque", "uv_mutex_t",
    "+opaque", "uv_rwlock_t",
    "+opaque", "uv_sem_t",
    "+opaque", "uv_cond_t",
    "+opaque", "uv_key_t",
    "+opaque", "_uv_barrier",
    "+exclude", "uv_loop_s$",
    "+opaque", "uv_loop_t",
    "+opaque", "uv_connect_t",
    "+exclude", "uv_connect_s$",
    "+opaque", "uv_shutdown_t",
    "+exclude", "uv_shutdown_s$",
    "+opaque", "uv_handle_t",
    "+exclude", "uv_handle_s$",
    "+opaque", "uv_fs_event_t",
    "+exclude", "uv_fs_event_s$",
    "+opaque", "uv_fs_poll_t",
    "+exclude", "uv_fs_poll_s$",
    "+opaque", "uv_any_handle",
    "+opaque", "uv_any_req",
    "+exclude", "uv_stream_s$",
    "+opaque", "uv_stream_t",
    "+opaque", "uv_tcp_t",
    "+exclude", "uv_tcp_s$",
    "+opaque", "uv_udp_t",
    "+exclude", "uv_udp_s$",
    "+opaque", "uv_udp_send_t",
    "+exclude", "uv_udp_send_s$",
    "+opaque", "uv_work_t",
    "+exclude", "uv_work_s$",
    "+opaque", "uv_pipe_t",
    "+exclude", "uv_pipe_s$",
    "+opaque", "uv_tty_t",
    "+exclude", "uv_tty_s$",
    "+opaque", "uv_fs_t",
    "+exclude", "uv_fs_s$",
    "+opaque", "uv_req_t",
    "+exclude", "uv_req_s$",
    "+opaque", "uv_random_t",
    "+exclude", "uv_random_s$",
    "+opaque", "uv_poll_t",
    "+exclude", "uv_poll_s$",
    "+opaque", "uv_dir_t",
    "+exclude", "uv_dir_s$",
    "+opaque", "uv_getaddrinfo_t",
    "+exclude", "uv_getaddrinfo_s$",
    "+opaque", "uv_getnameinfo_t",
    "+exclude", "uv_getnameinfo_s$",
    "+opaque", "uv_timer_t",
    "+exclude", "uv_timer_s$",
    "+opaque", "uv_prepare_t",
    "+exclude", "uv_prepare_s$",
    "+opaque", "uv_check_t",
    "+exclude", "uv_check_s$",
    "+opaque", "uv_idle_t",
    "+exclude", "uv_idle_s$",
    "+opaque", "uv_async_t",
    "+exclude", "uv_async_s$",
    "+opaque", "uv_process_t",
    "+exclude", "uv_process_s$",
    "+opaque", "uv_fs_poll_t",
    "+opaque", "uv_signal_t",
    "+exclude", "uv_signal_s$",
    "+exclude", "uv__",
    "+opaque", "uv_write_t",
    "+exclude", "uv_write_s$",
    "+exclude", "UV_OVERLAPPED_PIPE",
  ]
  for sdk-args() { uv-args.push(it) }
  let _ = process/run-command("k1bindgen", uv-args.as-span(), :inherit).!
}
