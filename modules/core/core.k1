use core/spill-list

fn assert-equals[t: print and equals](context locn: k1/source-location)(a: t, b: t) {
  if a != b {
    crash("ASSERT FAILED: $a != $b")
  }
}

fn assert-not-equals[t: print and equals](context locn: k1/source-location)(a: t, b: t) {
  if a == b {
    crash("ASSERT FAILED: $a == $b")
  }
}

fn(inline) inc(i: *size) { i.* = i.* + 1 }
// TODO: Would be cool to have this
// fn incNew[t: Add and KnowledgeOfOne](i: *t): t { i.* = i.* + KnowledgeOfOne@(t)/one() }

fn(inline) identity[t](value: t): t { value }

fn print[t: print](context locn: k1/source-location)(t) {
  // TODO: Instead of this hack, make write(Sink, span[byte]) the intrinsic.
  if k1/is-static and k1/capture-prints {
    let s = t.to-string()
    k1/emit-compiler-message(locn, :info, s)
  } else {
    t.print-to(io/stdout)
  }
}
fn println[t: print](context locn: k1/source-location)(t) {
  print[t](t)
  print[string]("\n")
}

fn eprint[t: print](context locn: k1/source-location)(t) {
  if k1/is-static and k1/capture-prints {
    let s = t.to-string()
    k1/emit-compiler-message(locn, :warn, s)
  } else {
    t.print-to(io/stderr)
  }
}
fn eprintln(context locn: k1/source-location)(s: string) {
  eprint(s)
  eprint("\n")
}

fn(inline) get-context-writer[w: writer](context w)(): w { w }

ns io {
  type out-stream = { file-no: i32 }
  let stdout: out-stream = .{ file-no = 1 }
  let stderr: out-stream = .{ file-no = 2 }

  type stdout-buffering = either(u8) { unknown, line, block }
  type(alias) STDOUT_BUF_CAP = 8192
  let(mutable, tls) stdout-buf: fixlist[u8, STDOUT_BUF_CAP] = .0
  let(mutable, tls) stdout-mode: stdout-buffering = :unknown

  fn stdout-buffering-mode(): stdout-buffering {
    if stdout-mode is :unknown {
      stdout-mode = if platform/io/is-tty(platform/io/STDOUT) :line else :block
    }
    stdout-mode
  }

  fn write-all(file-no: i32, data: ptr, count: size) {
    let written: size = 0
    while written < count {
      let n = if platform/io/write(
        file = .{ raw = file-no },
        data = data.add-bytes(written),
        count = count - written
      ).result() is {
        :ok(n) -> n,
        :err(_) -> return
      }
      if n == 0 return
      written = written + n
    }
  }

  fn read-all(file-no: i32): result[string, i32] {
    let sb = string-builder/new()
    let chunk = buffer/allocate[u8](4096)
    loop {
      let n = platform/io/read(.{ raw = file-no }, chunk.data, chunk.len).result().try
      if n == 0 return :ok sb.build()
      sb.write-bytes(span/wrap-buffer(chunk.slice(0, n)))
    }
  }

  fn flush-stdout() {
    if stdout-buf.non-empty() {
      write-all(1, stdout-buf.as-span().data-ptr(), stdout-buf.len())
      stdout-buf.clear()
    }
  }

  fn stdout-buffer-bytes(bytes: span[byte]) {
    if bytes.len() >= stdout-buf.cap() {
      flush-stdout()
      write-all(1, bytes.data-ptr(), bytes.len())
      return
    }
    if stdout-buf.len() + bytes.len() > stdout-buf.cap() {
      flush-stdout()
    }
    stdout-buf.push-n(bytes)
    if stdout-buffering-mode() is :line and bytes.contains(10) {
      flush-stdout()
    }
  }

  impl writer for out-stream {
    fn write-byte(self, value: u8) {
      if self.file-no == 1 {
        if stdout-buf.len() == stdout-buf.cap() flush-stdout()
        stdout-buf.push(value)
        if value == 10 and (stdout-buffering-mode() is :line) flush-stdout()
      } else {
        let value_spot = value
        write-all(self.file-no, value_spot.&.as[ptr], 1)
      }
      .{}
    }
    fn write-bytes(self, bytes: span[byte]) {
      if self.file-no == 1 {
        stdout-buffer-bytes(bytes)
      } else {
        write-all(self.file-no, bytes.data-ptr(), bytes.len())
      }
      .{}
    }
  }
}

ns files {

  type error = { code: i32, path: string }

  ns for error {
    fn not-found(self: error): bool { self.code == platform/io/ERROR-NOT-FOUND }
    fn already-exists(self: error): bool { self.code == platform/io/ERROR-EXISTS }
  }

  impl print for error {
    fn print-to[w: writer](self, w) {
      w.write("`${self.path}`: ${platform/error-string(self.code)}")
    }
  }

  fn read-to-string(path: string): result[string, error] {
    read-to-string-in(mem/current-arena(), path)
  }

  fn read-to-string-in[a: allocator](alloc: a, path: string): result[string, error] {
    let fd = if platform/io/open-to-read(path) is {
      :ok(fd) -> fd,
      :err(code) -> return :err(.{ code, path })
    }
    defer platform/io/close(fd)

    let file-size-bytes = if platform/io/file-size(fd) is {
      :some(n) -> n,
      :none -> crash("cannot size `$path`")
    }
    let buf = buffer/allocate-in[t = char](alloc, file-size-bytes)

    let total: size = 0
    while total < buf.len() {
      let n = if platform/io/read(fd, buf.data-ptr().add-bytes(total), buf.len() - total).result() is {
        :ok(n) -> n,
        :err(code) -> return :err(.{ code, path })
      }
      if n == 0 break
      total = total + n
    }
    buf.len = total
    :ok(string/wrap-buffer(buf))
  }

  fn write-entire-file(out-path: string, contents: string): result[empty, error] {
    let fd = if platform/io/open-to-write(out-path) is {
      :ok(fd) -> fd,
      :err(code) -> return :err(.{ code, path = out-path })
    }
    defer platform/io/close(fd)

    let written: size = 0
    while written < contents.len() {
      let n = if platform/io/write(
        file = fd,
        data = contents.data-ptr().add-bytes(written),
        count = contents.len() - written
      ).result() is {
        :ok(n) -> n,
        :err(code) -> return :err(.{ code, path = out-path })
      }
      if n == 0 crash("write of $out-path made no progress")
      written = written + n
    }
    :ok
  }

  fn exists(path: string): bool {
    if platform/io/open-to-read(path) is {
      :ok(fd) -> { platform/io/close(fd); true },
      :err(_) -> false
    }
  }

  fn list-dir(path: string): result[list[string], error] {
    list-dir-in(mem/current-arena(), path)
  }

  fn list-dir-in[a: allocator](alloc: a, path: string): result[list[string], error] {
    let dir = if platform/io/dir-open(path) is {
      :ok(dir) -> dir,
      :err(code) -> return :err(.{ code, path })
    }
    defer platform/io/dir-close(dir)
    let names: list[string] = list/empty()
    while platform/io/dir-next(dir) is :some(name) {
      if name != "." and name != ".." { names.push-in(alloc, name.cloned-in(alloc)) }
    }
    :ok(names)
  }

  fn make-dir(path: string): result[empty, error] {
    if platform/io/make-dir(path) is :err(code) :err(.{ code, path }) else :ok
  }

  fn link(from: string, to: string): result[empty, error] {
    if platform/io/link(from, to) is :err(code) :err(.{ code, path = to }) else :ok
  }

  fn rename(from: string, to: string): result[empty, error] {
    if platform/io/rename(from, to) is :err(code) :err(.{ code, path = from }) else :ok
  }

  fn remove(path: string): result[empty, error] {
    if platform/io/remove(path) is :err(code) :err(.{ code, path }) else :ok
  }

  fn remove-dir(path: string): result[empty, error] {
    if platform/io/remove-dir(path) is :err(code) :err(.{ code, path }) else :ok
  }

}

ns sys {
  fn env(name: string): ?string {
    platform/env/get(name)
  }

  // The k1 installation root: the K1_HOME env var when set (dev workflows point
  // it at a repo checkout), otherwise the installed location ~/.k1
  fn k1-home(): string {
    if env("K1_HOME") is {
      :some h -> h,
      :none -> "${env("HOME").!}/.k1",
    }
  }
}

fn assert-msg(context locn: k1/source-location)(msg: string, value: bool) {
  if not value {
    crash("ASSERT FAILED: $msg")
  }
}

ns for char {
  fn(inline) as-u8(self: char): u8 { mem/bitcast[char, u8](self) }
  fn(inline) u8(self: char): u8    { mem/bitcast[char, u8](self) }
  fn(inline) as-i8(self: char): i8 { mem/bitcast[char, i8](self) }
  fn(inline) as-byte(self: char): u8 { mem/bitcast[char, u8](self) }

  // mask to convert ASCII letters to uppercase
  let ASCII_CASE_MASK: u8 = 0b0010_0000
  fn is-ascii(self: char): bool {
    self.as-u8() <= 0x7F
  }

  fn is-ascii-letter(self: char): bool {
    let s = self.as-u8()
    (s >= 'a'.as-u8() and s <= 'z'.as-u8()) or (s >= 'A'.as-u8() and s <= 'Z'.as-u8())
  }

  fn is-ascii-space(self: char): bool {
    let s = self.as-u8()
    s == 32 or (s >= 9 and s <= 13)
  }

  fn is-ascii-digit(self: char): bool {
    let s = self.as-u8()
    s >= '0'.as-u8() and s <= '9'.as-u8()
  }

  fn to-ascii-digit(self: char): ?u8 {
    if self.is-ascii-digit() { :some(self.as-u8() - '0'.as-u8()) } 
    else :none
  }

  fn to-ascii-hex-digit(self: char): ?u8 {
    let s = self.as-u8()
    if self.is-ascii-digit() :some(s - '0'.as-u8())
    else if s >= 'a'.as-u8() and s <= 'f'.as-u8() :some(s - 'a'.as-u8() + 10)
    else if s >= 'A'.as-u8() and s <= 'F'.as-u8() :some(s - 'A'.as-u8() + 10)
    else :none
  }

  fn is-ascii-lower(self: char): bool {
    let s = self.as-u8()
    s >= 'a'.as-u8() and s <= 'z'.as-u8()
  }

  fn is-ascii-upper(self: char): bool {
    let s = self.as-u8()
    s >= 'A'.as-u8() and s <= 'Z'.as-u8()
  }

  fn to-ascii-upper(self: char): char {
    // Toggle (clear) the 6th bit if we are ascii lower
    let u8 = (self.as-u8()).xor(ASCII_CASE_MASK * self.is-ascii-lower().as-u8())
    u8.as-char()
  }

  fn to-ascii-lower(self: char): char {
    // Set the 6th bit if we are ascii upper
    let u8 = (self.as-u8()) | (ASCII_CASE_MASK * self.is-ascii-upper().as-u8())
    u8.as-char()
  }

}

impl scalar-cmp for char {
  fn(inline) lt(self, other: self): bool { (self.as-u8()).lt(other.as-u8()) }
  fn(inline) le(self, other: self): bool { (self.as-u8()).le(other.as-u8()) }
  fn(inline) gt(self, other: self): bool { (self.as-u8()).gt(other.as-u8()) }
  fn(inline) ge(self, other: self): bool { (self.as-u8()).ge(other.as-u8()) }
}

impl comparable for char {
  fn(inline) compare(self, other: self): ordering { self.as-u8().compare(other.as-u8()) }
}

impl scalar-cmp for ptr {
  fn(inline) lt(self, other: self): bool { self.to-uint().lt(other.to-uint()) }
  fn(inline) le(self, other: self): bool { self.to-uint().le(other.to-uint()) }
  fn(inline) gt(self, other: self): bool { self.to-uint().gt(other.to-uint()) }
  fn(inline) ge(self, other: self): bool { self.to-uint().ge(other.to-uint()) }
}

impl comparable for ptr {
  fn(inline) compare(self, other: self): ordering { self.to-uint().compare(other.to-uint()) }
}

impl[t: print] to-string for t {
  fn to-string(self): string {
    let bytes = spill-list/new[u8, 64]()
    self.print-to(bytes.&)
    string/wrap-bytes(bytes.as-span()).cloned()
  }
}


impl print for bool {
  fn print-to[w: writer](self: bool, w) { 
    let s = if self "true" else "false"
    w.write(s)
  }
}
impl to-string for bool { fn to-string(self: bool): string { if self "true" else "false" } }

impl print for char { fn print-to[w: writer](self: char, w) { w.write-char(self) } }
// Direct specialized 'to-string' impl to avoid going through a buffer
impl to-string for char { fn to-string(self: char): string { string/wrap-list([self]) } }

let DECIMAL_PAIRS: array[u16, 100] = {
  let pairs: array[u16, 100] = uninit
  for i in (0: u8).until(100) {
    let two: array[u8, 2] = [u8/to-ascii-digit(i / 10).as-u8(), u8/to-ascii-digit(i % 10).as-u8()]
    pairs.[i.as-size()] = mem/read-unaligned[u16](two.&.as[ptr])
  }
  pairs
}

fn(inline) _write-decimal-pair(digits: *array[u8, 64], at: size, pair: u64) {
  let dst = checked-index(at, 63)
  mem/write-unaligned(digits.as[ptr].add-bytes(dst), DECIMAL_PAIRS.[pair.signed()])
}

fn format-uint[w: writer](w, value: u64, base: u64) {
  let digits: array[u8, 64] = uninit
  let start: size = 64
  let remaining = value
  if base == 10 {
    while remaining >= 100 {
      start = start - 2
      _write-decimal-pair(digits.&, start, remaining % 100)
      remaining = remaining / 100
    }
    if remaining >= 10 {
      start = start - 2
      _write-decimal-pair(digits.&, start, remaining)
    } else {
      start = start - 1
      digits.[start] = remaining.trunc[u8] + '0'.as-u8()
    }
  } else {
    loop {
      start = start - 1
      digits.[start] = u8/to-ascii-digit((remaining % base).trunc[u8]).as-u8()
      remaining = remaining / base
      if remaining == 0 break
    }
  }
  w.write-bytes(digits.&.as-buffer().slice(start, 64).as-span())
}

impl print for u8 {
  fn print-to[w: writer](self: u8, w) {
    (self.widen[u64]).print-to(w)
  }
}

impl print for u16 {
  fn print-to[w: writer](self: u16, w) {
    (self.widen[u64]).print-to(w)
  }
}

impl print for u32 {
  fn print-to[w: writer](self: u32, w) {
    (self.widen[u64]).print-to(w)
  }
}

impl print for u64 {
  fn print-to[w: writer](self: u64, w) {
    format-uint(w, self, base = 10)
  }
}

impl print for i8 {
  fn print-to[w: writer](self: i8, w) {
    (self.widen[int]).print-to(w)
  }
}

impl print for i16 {
  fn print-to[w: writer](self: i16, w) {
    (self.widen[int]).print-to(w)
  }
}

impl print for i32 {
  fn print-to[w: writer](self: i32, w) {
    (self.widen[int]).print-to(w)
  }
}

impl print for int {
  fn print-to[w: writer](self: int, w) {
    let neg = self < 0
    if neg {
      w.write-char('-')
    }

    let pos = if neg self.negated() else self
    format-uint(w, pos.unsigned(), 10)
  }
}

impl[s, f: print] try[t = s, e = f] for result[s, f] {
  fn(inline) error(e: e): self { :err e }
  fn(inline) value(t: t): self    { :ok t }

  fn(inline) is-ok(self): bool { self is :ok _ }
  fn get-value(self): t  {
    if self is {
      :ok s -> s,
      :err e -> crash("get-value() on :err: $e")
    }
  }
  fn get-error(self): e {
    if self is {
      :ok _ -> crash("get-error() on :ok"),
      :err e -> e
    }
  }
}

impl[s, f] try[t = s, e = f] for result[s, f] {
  fn(inline) error(e: e): self { :err e }
  fn(inline) value(t: t): self    { :ok t }

  fn(inline) is-ok(self): bool { self is :ok _ }
  fn get-value(self): t  {
    if self is {
      :ok s -> s,
      :err e -> crash("get-value() on :err")
    }
  }
  fn get-error(self): e {
    if self is {
      :ok _ -> crash("get-error() on :ok"),
      :err e -> e
    }
  }
}

impl[t: scalar-cmp] comparable for t {
  fn(inline) compare(self: t, other: t): ordering {
    let gt = self.gt(other).as-u8().signed()
    let lt = self.lt(other).as-u8().signed()
    mem/bitcast[i8, ordering](gt - lt)
  }
}

ns for u8 {
  fn(inline) to-ascii-digit(v: u8): char {
    if v < 10 {
      (v + '0'.as-u8()).as-char()
    } else if v < 36 {
      (v - 10 + 'a'.as-u8()).as-char()
    } else if v < 62 {
      (v - 36 + 'A'.as-u8()).as-char()
    } else {
      _ascii-digit-out-of-range(v)
    }
  }

  fn(cold) _ascii-digit-out-of-range(v: u8): never {
    crash("u8/to-ascii-digit: value $v is out of range (max 61)")
  }

  let min-value: u8 = 0x00
  let max-value: u8 = 0xFF

  fn(inline) as-char(self: u8): char { mem/bitcast[u8, char](self) }
  fn(inline) signed(self: u8): i8 { mem/bitcast[u8, i8](self) }
  fn(inline) as-size(self: u8): size { self.widen[size] }

  fn write-hex[w: writer](self: u8, w, upper: bool) {
    let digits = if upper "0123456789ABCDEF" else "0123456789abcdef"
    w.write-char(digits.[(self >> 4).as-size()])
    w.write-char(digits.[(self & 15).as-size()])
  }
}

ns for i8 {
  let max-value: i8 = 0x7F
  let min-value: i8 = -0x80

  fn(inline) unsigned(self: i8): u8 { mem/bitcast[i8, u8](self) }
  fn(inline) as-size(self: i8): size { self.widen[size] }
}

ns for u16 {
  let min-value: u16 = 0x0000
  let max-value: u16 = 0xFFFF

  fn(inline) signed(self: u16): i16 { mem/bitcast[u16, i16](self) }
  fn(inline) as-size(self: u16): size { self.widen[size] }
}

ns for i16 {
  let max-value: i16 = 0x7FFF
  let min-value: i16 = -0x8000

  fn(inline) unsigned(self: i16): u16 { mem/bitcast[i16, u16](self) }
  fn(inline) as-size(self: i16): size { self.widen[size] }
}

ns for u32 {
  let min-value: u32 = 0x00000000
  let max-value: u32 = 0xFFFFFFFF

  fn(inline) as-bool(self: u32): bool { self != 0 }
  fn(inline) signed(self: u32): i32 { mem/bitcast(self) }

  fn(inline) as-size(self: u32): size { self.widen[u64].signed() }
}

ns for i32 {
  let max-value: i32 = 0x7FFFFFFF
  let min-value: i32 = -0x80000000

  fn(inline) as-bool(self: i32): bool { self != 0 }
  fn(inline) unsigned(self: i32): u32 { mem/bitcast(self) }
  fn(inline) as-size(self: i32): size { self.widen[size] }

  fn abs(self: i32): i32 {
    let mask = self >> 31
    self.xor(mask) - mask
  }
}

ns for i64 {
  let max-value: i64 = 0x7FFFFFFFFFFFFFFF
  let min-value: i64 = -0x8000000000000000

  fn(inline) unsigned(self: i64): u64 { mem/bitcast[i64, u64](self) }
  fn(builtin) mul-high(self: i64, rhs: i64): i64
  fn(inline) to-ptr(self: i64): ptr { mem/bitcast[i64, ptr](self) }

  fn from-string(s: string): result[i64, string] {
    if s.is-empty() return :err "empty string"
    let neg = s.[0] == '-'
    let magnitude = u64/from-string(if neg s.drop(1) else s).try
    require from-magnitude(neg, magnitude) is :some v else { return :err "i64 overflow" }
    :ok v
  }

  fn from-magnitude(neg: bool, magnitude: u64): ?i64 {
    if magnitude > (if neg i64/min-value else i64/max-value).unsigned() :none
    else if neg :some magnitude.signed().negated()
    else :some magnitude.signed()
  }
  fn next-pow2(self: i64): i64 {
    if self < 0 crash("i64/next-pow2: value must be positive") else
    if self == 0 return 1

    let next = (self.unsigned()).next-pow2()
    if next > i64/max-value.unsigned() {
      crash("i64/next-pow2: value too large to fit in i64")
    }
    next.signed()
  }

  fn abs(self: i64): i64 {
    let mask = self >> 63
    self.xor(mask) - mask
  }
}

ns for u64 {
  let min-value: u64 = 0
  let max-value: u64 = 0xFFFFFFFFFFFFFFFF

  fn(inline) signed(self: u64): i64 { mem/bitcast(self) }
  fn(builtin) mul-high(self: u64, rhs: u64): u64
  fn(inline) to-ptr(self: u64): ptr { mem/bitcast[u64, ptr](self) }

  fn from-string(s: string): result[u64, string] {
    if s.is-empty() return :err "empty string"
    let o: u64 = 0
    for c in s {
      require c.to-ascii-digit() is :some d else { return :err "not a digit" }
      let tens = o.mul-overflow(10)
      let next = tens.value.add-overflow(d.widen[u64])
      if tens.overflowed or next.overflowed return :err "u64 overflow"
      o = next.value
    }
    :ok o
  }

  fn next-pow2(self: u64): u64 {
    if self <= 1 self else (u64/max-value >> (self - 1).leading-zeros().trunc[u32]) + 1
  }

  fn bitmask-low(n: size): u64 {
    assert(n <= 64)
    if n == 64 18446744073709551615: u64 else (1usize << n.trunc[u32]) - 1
  }
}

ns(lib("k1rt")) k1rt {
  // TODO: Add ".c" dependency support; so we can go back to single compilation unit for k1rt:
  // fn(extern("_k1_show_backtrace"), lib("k1rt.c")) _k1_show_backtrace()
  // Allowing you to mix and match .c and .k1 files

  fn(extern("_k1_print_backtrace")) _k1_print_backtrace(frame_count: c-int)

  fn(extern("_k1_snprintf_f32")) snprintf_f32(buf: ptr, size: c-sizet, float: f32, places: i32): i32
  fn(extern("_k1_snprintf_f64")) snprintf_f64(buf: ptr, size: c-sizet, float: f64, places: i32): i32

  fn(extern("_k1_parse_f64")) parse-f64()
}

ns float-impl {
  fn write-output[w: writer](w, buf: span[u8], written-len: i32, places: i32) {
    if written-len <= 0 crash("snprintf float returned $written-len")
    let len = written-len.as-size()
    if len >= buf.len() crash("float format: $places places needs $len bytes, cap is ${buf.len()}")
    w.write-bytes(buf.slice(0, len))
  }
}

ns for f64 {
  let nan: f64 = builtin
  let inf: f64 = builtin
  let neg-inf: f64 = builtin

  fn abs(self: f64): f64 {
    mem/bitcast[u64, f64](mem/bitcast[f64, u64](self).bit-and(0x7FFFFFFFFFFFFFFF))
  }

  fn(builtin) sqrt(self: f64): f64
  fn(builtin) floor(self: f64): f64
  fn(builtin) ceil(self: f64): f64
  fn(builtin) round-to-zero(self: f64): f64
  fn(builtin) round-even(self: f64): f64
  fn(builtin) fma(self: f64, b: f64, c: f64): f64

  fn format[w: writer](f: f64, w, places: i32) {
    let buf: array[u8, 512] = uninit
    float-impl/write-output(w, buf.as-span(), k1rt/snprintf_f64(buf.data-ptr(), 512, f, places), places)
  }

  fn from-string(s: string): result[f64, string] {
    :ok parse-string(s = s, require-total = true).try.value
  }
  fn parse-string(s: string, require-total: bool): result[{ value: f64, len: size }, string] {
    let out: f64 = uninit
    let result = ffc/parse_double(s.len(), s.data-ptr(), out.&)
    if not ffc/result_is_ok(result) {
      :err "Could not parse '$s' as f64"
    } else {
      let len = result.ptr.diff(s.data-ptr())
      if require-total and len != s.len() {
        :err "Parsed an f64 but there was stuff at the end: $len vs ${s.len()}"
      } else {
        :ok .{ value = out, len }
      }
    }
  }

  // Maps to an i64 key whose integer order is IEEE-754 totalOrder:
  // -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN
  fn total-order-key(self: f64): i64 {
    let bits = mem/bitcast[f64, i64](self)
    bits.xor(((bits >> 63).unsigned() >> 1).signed())
  }
}

ns for f32 {
  let nan: f32 = builtin
  let inf: f32 = builtin
  let neg-inf: f32 = builtin

  fn format[w: writer](f: f32, w, places: i32) {
    let buf: array[u8, 512] = uninit
    float-impl/write-output(w, buf.as-span(), k1rt/snprintf_f32(buf.data-ptr(), 512, f, places), places)
  }

  // See f64/total-order-key
  fn total-order-key(self: f32): i32 {
    let bits = mem/bitcast[f32, i32](self)
    bits.xor(((bits >> 31).unsigned() >> 1).signed())
  }

  fn abs(self: f32): f32 {
    mem/bitcast[u32, f32](mem/bitcast[f32, u32](self).bit-and(0x7FFFFFFF))
  }

  fn(builtin) sqrt(self: f32): f32
  fn(builtin) floor(self: f32): f32
  fn(builtin) ceil(self: f32): f32
  fn(builtin) round-to-zero(self: f32): f32
  fn(builtin) round-even(self: f32): f32
  fn(builtin) fma(self: f32, b: f32, c: f32): f32
}

impl equals for f32 {
  fn(builtin) equals(self: f32, other: f32): bool
  fn(builtin) not-equals(self: f32, other: f32): bool
}
impl equals for f64 {
  fn(builtin) equals(self: f64, other: f64): bool
  fn(builtin) not-equals(self: f64, other: f64): bool
}

impl from-string[e = string] for u64 {
  fn from-string(s: string): result[u64, string] { u64/from-string(s) }
}
impl from-string[e = string] for i64 {
  fn from-string(s: string): result[i64, string] { i64/from-string(s) }
}
impl from-string[e = string] for f64 {
  fn from-string(s: string): result[f64, string] { f64/from-string(s) }
}

impl add for f32 { fn(builtin) add(self, other: self): self }
impl add for f64 { fn(builtin) add(self, other: self): self }

impl sub for f32 { fn(builtin) sub(self, other: self): self }
impl sub for f64 { fn(builtin) sub(self, other: self): self }

impl mul for f32 { fn(builtin) mul(self, other: self): self }
impl mul for f64 { fn(builtin) mul(self, other: self): self }

impl div for f32 { fn(builtin) div(self, other: self): self }
impl div for f64 { fn(builtin) div(self, other: self): self }

impl rem for f32 { fn(builtin) rem(self, other: self): self }
impl rem for f64 { fn(builtin) rem(self, other: self): self }

impl neg for f32 { fn(builtin) negated(self): self }
impl neg for f64 { fn(builtin) negated(self): self }

impl scalar-cmp for f32 {
  fn(builtin) lt(self, other: self): bool
  fn(builtin) le(self, other: self): bool
  fn(builtin) gt(self, other: self): bool
  fn(builtin) ge(self, other: self): bool
  fn(builtin) min(self, other: self): self
  fn(builtin) max(self, other: self): self
}
impl scalar-cmp for f64 {
  fn(builtin) lt(self, other: self): bool
  fn(builtin) le(self, other: self): bool
  fn(builtin) gt(self, other: self): bool
  fn(builtin) ge(self, other: self): bool
  fn(builtin) min(self, other: self): self
  fn(builtin) max(self, other: self): self
}

// float compare is IEEE-754 totalOrder, so it stays a consistent total order
// even for NaN. Note two divergences from the `==`/`<` operators: -0.0 compares
// :less than +0.0, and NaN compares :greater than +inf (-NaN :less than -inf).
impl comparable for f32 {
  fn(inline) compare(self: f32, other: f32): ordering {
    self.total-order-key().compare(other.total-order-key())
  }
}
impl comparable for f64 {
  fn(inline) compare(self: f64, other: f64): ordering {
    self.total-order-key().compare(other.total-order-key())
  }
}

impl zero for char { fn zero(): char { .0 } }
impl zero for f32 { fn zero(): f32 { 0.0 } }
impl zero for f64 { fn zero(): f64 { 0.0 } }
impl zero for u8  { fn zero(): u8  { 0   } }
impl zero for u16 { fn zero(): u16 { 0   } }
impl zero for u32 { fn zero(): u32 { 0   } }
impl zero for u64 { fn zero(): u64 { 0   } }
impl zero for i8  { fn zero(): i8  { 0   } }
impl zero for i16 { fn zero(): i16 { 0   } }
impl zero for i32 { fn zero(): i32 { 0   } }
impl zero for i64 { fn zero(): i64 { 0   } }

impl one for f32 { fn one(): f32 { 1.0 } }
impl one for f64 { fn one(): f64 { 1.0 } }
impl one for u8  { fn one(): u8  { 1   } }
impl one for u16 { fn one(): u16 { 1   } }
impl one for u32 { fn one(): u32 { 1   } }
impl one for u64 { fn one(): u64 { 1   } }
impl one for i8  { fn one(): i8  { 1   } }
impl one for i16 { fn one(): i16 { 1   } }
impl one for i32 { fn one(): i32 { 1   } }
impl one for i64 { fn one(): i64 { 1   } }

impl print for f32 {
  fn print-to[w: writer](self: f32, w) {
    f32/format(self, w, places = -1)
  }
}

impl print for f64 {
  fn print-to[w: writer](self: f64, w) {
    f64/format(self, w, places = -1)
  }
}

impl print-precise for f32 {
  fn print-precise-to[w: writer](self: f32, w, precision: u32) {
    f32/format(self, w, places = precision.signed())
  }
}

impl print-precise for f64 {
  fn print-precise-to[w: writer](self: f64, w, precision: u32) {
    f64/format(self, w, places = precision.signed())
  }
}

impl print for ptr {
  fn print-to[w: writer](self: ptr, w) {
    w.write("0x")
    format-uint(w, self.to-uint(), base = 16)
  }
}

// A little abstraction over a reference that can be null
// where you can pay a small cost (option construction)
// to check it, but can still store it 'raw'
// As opposed to storing the sum, which carries waste
type optref[t] = { inner: ptr }
ns for optref {
  fn(inline) make[t](inner: *t): optref[t] { .{ inner = inner.as[ptr] } }
  fn(inline) null[t](): optref[t] { .{ inner = ptr/null } }
  fn(inline) get[t](self: optref[t]): *t { self.inner.ref[t] }
  fn deref[t](self: optref[t]): ?t {
    if (self.inner is null) :none else :some(self.inner.ref[t].*)
  }
  fn as-opt[t](self: optref[t]): ?*t {
    if (self.inner is null) :none else :some(self.inner.ref[t])
  }
  fn(inline) is-null[t](self: optref[t]): bool { self.inner is null }
}
