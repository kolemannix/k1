type string-builder = { list: list[u8] }
ns for string-builder {
  fn new(): string-builder { .0 }

  fn with-capacity(cap: size): string-builder {
    .{ list = list/with-capacity(cap) }
  }

  fn reset(self: *string-builder) {
    self.list.clear()
  }

  fn peek(self: *string-builder): string {
    string/wrap-bytes(self.list.as-span())
  }

  fn build(self: *string-builder): string {
    self.peek().cloned()
  }

  fn take(self: *string-builder): string {
    let taken = self.peek()
    self.list = list/empty()
    taken
  }
}

impl writer for *string-builder {
  fn write-byte(self, b: u8): empty {
    self.list.push(b)
  }
  fn write-bytes(self, b: span[u8]): empty {
    self.list.append-span(b)
  }
}
