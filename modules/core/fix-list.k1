// Represents an inline, 'pushable' contiguous collection of Ts, with a fixed capacity.
type fixlist[t, n: static size] = { len: u32, data: array[t, n] }
ns for fixlist {
  fn(inline) cap[t, n: static size](_self: *fixlist[t, n]): size { n }
  fn(inline) len[t, n](self: *fixlist[t, n]): size { self.len.as-size() }

  fn zeroed[t, n](): fixlist[t, n] { .0 }

  fn uninit[t, n](): core/fixlist[t, n] {
    .{ len = 0, data = uninit }
  }

  fn clear[t, n](self: *fixlist[t, n]): empty {
    self.len = 0
  }

  fn push[t, n](self: *fixlist[t, n], value: t): empty {
    if self.try-push(value) is :err {
      let typename = types/name[type-of(self).value]
      crash("$typename cannot fulfill push. ${self.len() + 1} > ${self.cap()}")
    }
  }

  fn try-push[t, n](self: *fixlist[t, n], value: t): result[empty, empty] {
    let len = self.len()
    if len < self.cap() {
      self.data.[len] = value
      self.len = len.trunc[u32] + 1
      :ok
    } else {
      :err
    }
  }

  fn try-push-n[t, n](self: *fixlist[t, n], values: span[t]): result[span[t], empty] {
    let needed = self.len() + values.len()
    if needed <= self.cap() {
      let dst-slice = self.data.as-buffer().slice(start = self.len(), end = needed)
      buffer/copy(src = values.inner-buffer(), dst = dst-slice)
      self.len = needed.trunc[u32]
      :ok span/wrap-buffer(dst-slice)
    } else {
      :err
    }
  }

  fn push-n[t, n](self: *fixlist[t, n], values: span[t]): empty {
    if self.try-push-n(values) is :err {
      let typename = types/name[type-of(self).value]
      crash("$typename cannot fulfill push-n. ${self.len() + values.len()} > ${self.cap()}")
    }
  }

  fn pop[t, n](self: *fixlist[t, n]): ?t {
    if self.len == 0 return :none
    self.len = self.len - 1
    :some self.data.[self.len()]
  }

}

impl[t, n: static size] as-buffer[t = t] for *fixlist[t, n] {
  fn(inline) as-buffer(self): buffer[t] {
    self.data.as-buffer().slice(0, self.len())
  }
}

impl[t, n: static size] index[key = size, t = t] for *fixlist[t, n] {
  fn(inline) index-ref(self, key: size): *t { self.as-buffer().index-ref(key) }
}

impl[t, n: static size] as-span[t = t] for *fixlist[t, n] {
  fn(inline) as-span(self): span[t] {
    self.data.as-span().slice(0, self.len())
  }
}

impl[t, n: static size] iterable[item = t, i = buffer-iterator[t]] for *fixlist[t, n] {
  fn iterator(self): i {
    self.as-span().iterator()
  }
}
