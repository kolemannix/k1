// Represents an inline, 'pushable' contiguous collection of Ts, with a fixed capacity.
// Storage is inline!
//  
// For example, a fixlist[byte, 10] is 14 bytes long, and looks like:
// +----+----------+
// |used|10 items  |
// +----+----------+
// 0    4
type fixlist[t, n: static size] = { data: array[t, n], used: u32 }
ns for fixlist {
  fn cap[t, n](_self: *fixlist[t, n]): size { core/meta/static-type-to-value[_, n]() }
  fn len[t, n](self: *fixlist[t, n]): size { self.used.widen[size] }

  fn zeroed[t, n](): fixlist[t, n] { mem/zeroed() }

  fn uninit[t, n](): core/fixlist[t, n] {
    .{ used = 0, data = uninit }
  }

  fn clear[t, n](self: *mut fixlist[t, n]): empty {
    self.used = 0
  }

  fn push[t, n](self: *mut fixlist[t, n], value: t): empty {
    let used: size = self.len()
    if used < self.cap() {
      self.data.[used] = value
      self.used = used.trunc[u32] + 1
    } else {
      let typename = types/name[type-of(self).value]
      crash("$typename cannot fulfill push. ${used + 1} > ${self.cap()}")
    }
  }

  fn try-push[t, n](self: *mut fixlist[t, n], value: t): result[empty, empty] {
    let used: size = self.len()
    if used < self.cap() {
      self.data.[used] = value
      self.used = used.trunc[u32] + 1
      :ok
    } else {
      :err
    }
  }

  fn try-push-n[t, n](self: *mut fixlist[t, n], values: span[t]): result[empty, empty] {
    let needed = self.len() + values.len()
    if needed <= self.cap() {
      let dst-slice = self.data.as-buffer().slice(start = self.len(), end = needed)
      buffer/copy(src = values.inner-buffer(), dst = dst-slice)
      self.used = needed.trunc[u32]
      :ok
    } else {
      :err
    }
  }

  fn push-n[t, n](self: *mut fixlist[t, n], values: span[t]): empty {
    let result = self.try-push-n[t, n](values)
    if result is :err { crash("fixlist out of space") }
  }

  fn pop[t, n](self: *mut fixlist[t, n]): ?t {
    self.last() is {
       :some t -> {
         self.used = self.used - 1
         :some t
       },
       :none -> :none
    }
  }

}

impl[t, n: static size] as-buffer[t = t] for *mut fixlist[t, n] {
  fn as-buffer(self): buffer[t] {
    self.data.as-buffer().slice(0, self.len())
  }
}

impl[t, n: static size] index[key = size, t = t] for *mut fixlist[t, n] {
  fn index-ref(self, key: size): *t { self.as-buffer().index-ref(key) }
}

impl[t, n: static size] as-span[t = t] for *fixlist[t, n] {
  fn as-span(self): span[t] {
    self.data.as-span().slice(0, self.len())
  }
}

impl[t, n: static size] iterable[item = t, i = buffer-iterator[t]] for *fixlist[t, n] {
  fn iterator(self): i {
    self.as-span().iterator()
  }
}
