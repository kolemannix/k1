ns for result {

  impl[t: print, e: print] print for result[t, e] {
    fn print-to[w: writer](self, w) {
      if self is {
        :ok t -> w.write(":ok($t)"),
        :err e -> w.write(":err($e)"),
      }
    }
  }

  fn map[t, e, t2](self: result[t, e], f: some fn(t) -> t2): result[t2, e] {
    if self is {
      :ok t  -> :ok f(t),
      :err e -> :err e
    }
  }

  fn map-err[t, e, e2](self: result[t, e], f: some fn(e) -> e2): result[t, e2] {
    if self is {
      :ok t  -> :ok t,
      :err e -> :err f(e)
    }
  }

  fn show-err[t, e: print](self: result[t, e]): result[t, string] {
    if self is {
      :ok t  -> :ok t,
      :err e -> :err e.show()
    }
  }

  fn fold[t](self: result[t, t]): t {
    if self is {
      :ok t -> t,
      :err t -> t
    }
  }
  
}
