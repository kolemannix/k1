// a growable, ordered collection of elements.
// Backed by an efficient, contiguously allocated buffer
ns for list {

  ///////////////////////////
  // Construction functions

  fn empty[t](): list[t] {
    with-capacity[t](0)
  }

  fn(inline) len[t](self: list[t]): size { self.len }
  fn(inline) cap[t](self: list[t]): size { self.buffer.len }

  // pointer to the underlying buffer
  // Use at your own risk; the region past
  // len is not initialized
  fn(inline) data-ptr[t](self: list[t]): ptr { self.buffer.data-ptr() }
  fn(inline) data-ref[t](self: list[t]): *t { self.buffer.data-ref() }

  fn filled[t](size: size, value: t): list[t] {
    let buffer = buffer/filled(size, value)
    .{ len = size, buffer }
  }

  fn filled-in[t, a: allocator](alloc: a, size: size, value: t): list[t] {
    let buffer = buffer/filled-in(alloc, size, value)
    .{ len = size, buffer }
  }

  fn with-capacity[t](cap: size): list[t] {
    let buffer = buffer/allocate[t](cap)
    .{ len = 0, buffer }
  }

  fn with-capacity-in[t, a: allocator](alloc: a, cap: size): list[t] {
    let buffer = buffer/allocate-in[t, _](alloc, cap)
    .{ len = 0, buffer }
  }

  fn reserve-in[t, a: allocator](self: *mut list[t], alloc: a, count: size) {
    if self.cap() >= count return
    self.buffer._grow-to[t, _](alloc, count)
  }

  fn reserve[t](self: *mut list[t], count: size) {
    self.reserve-in[t, _](mem/current-arena(), count)
  }

  fn single[t](value: t): list[t] {
    filled[t](1, value)
  }

  fn wrap-buffer[t](buffer: buffer[t]): list[t] {
    .{ len = buffer.len, buffer }
  }

  fn from-span[t](span: span[t]): list[t] {
    .{ len = span.len(), buffer = span.buffer.cloned() }
  }

  fn to-buffer[t](self: list[t]): buffer[t] {
    self.as-buffer().cloned()
  }

  fn to-array[t, n: static size](self: list[t], count: n): *mut array[t, n] {
    let count-val = count.from-static()
    assert-equals(self.len, count-val)
    let base: ptr = self.as-buffer().cloned().data-ptr()
    base.ref[array[t, n]]
  }

  // The possibly-uninitialized backing buffer of this list
  fn(inline) inner-buffer[t](self: list[t]): buffer[t] { self.buffer }

  fn _grow[t, a: allocator](self: *mut list[t], alloc: a) {
    let new-cap: size = if self.buffer.is-empty() {
      // For large elements, just allocate what's needed - Rust's RawVec does this :)
      let elem-size = types/size[t]
      if elem-size >= 1024 1 else 8
    } else {
      self.cap() * 2
    }
    self.reserve-in(alloc, new-cap)
  }

  fn cloned-in[t, a: allocator](self: list[t], alloc: a): list[t] {
    .{ len = self.len, buffer = self.buffer.cloned-in(alloc) }
  }

  fn cloned[t](self: list[t]): list[t] {
    self.cloned-in[t, _](mem/current-arena())
  }

  fn(inline) push-in[t, a: allocator](self: *mut list[t], alloc: a, elem: t) {
    let start-length = self.len
    if start-length == self.*.cap() {
      self._grow(alloc)
    }
    self.len = start-length + 1
    self.[start-length] = elem
  }

  fn(inline) push[t](self: *mut list[t], elem: t) {
    self.push-in[t, _](mem/current-arena(), elem)
  }

  fn(inline) clear[t](self: *mut list[t]) {
    self.len = 0
  }

  fn position[t: equals](self: list[t], needle: t): ?size {
    self.as-buffer().position(needle)
  }

  fn contains[t: equals](self: list[t], needle: t): bool {
    self.as-buffer().position(needle).is-some()
  }

  fn reversed[t](self: list[t]): list[t] {
    let clone = self.cloned()
    clone.reverse()
    clone
  }

  fn concat[t](self: list[t], other: list[t]): list[t] {
    let dst = list/with-capacity[t](self.len + other.len)
    dst.append-list(self)
    dst.append-list(other)
    dst
  }

  fn append-list[t](self: *mut list[t], other: list[t]) {
    self.append-buffer(other.as-buffer())
  }

  fn append-buffer[t](self: *mut list[t], other: buffer[t]) {
    self.append-buffer-in[t, _](mem/current-arena(), other)
  }
  fn append-buffer-in[t, a: allocator](self: *mut list[t], alloc: a, other: buffer[t]) {
    let needed = self.len + other.len
    if needed > self.cap() {
      let doubled = self.cap() * 2
      self.reserve-in(alloc, if doubled > needed doubled else needed)
    }
    let dst = self.inner-buffer().slice(start = self.len, end = needed)
    buffer/copy(src = other, dst = dst)
    self.len = needed
  }

  fn append-span[t](self: *mut list[t], other: span[t]) {
    self.append-buffer(other.inner-buffer())
  }
  fn append-span-in[t, a: allocator](self: *mut list[t], alloc: a, other: span[t]) {
    self.append-buffer-in(alloc, other.inner-buffer())
  }

  fn sort[t](input: *mut list[t]) where t: comparable {
    input.as-buffer().sort()
  }

  fn join[t: print](self: list[t], sep: string): string {
    let b = string-builder/new()
    for s in self {
      s.print-to(&b)
      let is-last = it-index + 1 == self.len
      if not is-last { b.write(sep) }
    }
    b.build()
  }

  fn from-mapping[t, iter, iterable, u](input: iterable, f: some fn t -> u): list[u]
  where iter: iterator[item = t], iterable: iterable[item = t, i = iter]
  {
    let iter = input.iterator()
    let us = list/with-capacity[u](iter.size-hint().at-least)
    for iter {
      let u = f(it)
      us.push(u)
    }
    us
  }

  fn map[t, u](self: list[t], f: some fn t -> u): list[u] {
    let us = list/with-capacity[u](self.len)
    for i in self { us.push[u](f(i)) }
    us
  }
  
  fn flat-map[t, u](self: list[t], f: some fn t -> list[u]): list[u] {
    let us = list/empty[u]()
    for i in self { us.append-list[u](f(i)) }
    us
  }
  
  fn filter[t](self: list[t], f: some fn t -> bool): list[t] {
    let keep = list/empty[t]()
    for i in self { if f(i) keep.push(i) }
    keep
  }

  fn remove[t](self: *mut list[t], index: size) {
    if index.unsigned() >= self.len.unsigned() {
      crash("list index out of bounds. index $index, len ${self.len}")
    }
    self.buffer.remove(index)
    self.len = self.len - 1
  }

  fn filter-in-place[t](self: *mut list[t], f: some fn t -> bool) {
    let kept: size = 0
    for i in 0.until(self.len) {
      let elem = self.[i]
      if f(elem) {
        self.[kept] = elem
        kept = kept + 1
      }
    }
    self.len = kept
  }

}

impl writer for *mut list[char] {
  fn(inline) write-byte(self, value: u8) { self.push(value.as-char()) }
  fn(inline) write-bytes(self, bytes: span[byte]) { self.append-span(bytes.as-char-span()) }
}

impl writer for *mut list[u8] {
  fn(inline) write-byte(self, value: u8) { self.push(value) }
  fn(inline) write-bytes(self, bytes: span[byte]) {
    self.append-span(bytes)
  }
}

impl equals for list[u8] {
  fn equals(self: list[u8], other: list[u8]): bool { self.as-buffer() == other.as-buffer() }
}

impl equals for list[int] {
  fn equals(self: list[int], other: list[int]): bool { self.as-buffer() == other.as-buffer() }
}

impl[t: equals] equals for list[t] {
  fn equals(self: list[t], other: list[t]): bool {
    self.as-buffer() == other.as-buffer()
  }
}

impl[t: print] print for list[t] {
  fn print-to[w: writer](self: list[t], w) {
    w.write-char('[')
    for self {
      it.print-to(w)
      let last = it-index + 1 == self.len
      if not last {
        w.write(",")
      }
    }
    w.write-char(']')
  }
}

impl[t] as-buffer[t = t] for list[t] {
  fn(inline) as-buffer(self): buffer[t] {
    self.buffer.slice(0, self.len)
  }
}

impl[t] as-buffer[t = t] for *mut list[t] {
  fn(inline) as-buffer(self): buffer[t] {
    self.*.as-buffer()
  }
}

impl[t] as-span[t = t] for *list[t] {
  fn(inline) as-span(self): span[t] {
    self.*.as-span()
  }
}

impl[t] index[key = size, t = t] for list[t] {
  fn(inline) index-ref(self, key: size): *t {
    raw-buffer/check-bounds(self.len, key)
    self.buffer.index-unchecked(key)
  }
}

impl[t] iterable[item = t, i = buffer-iterator[t]] for list[t] {
  fn(inline) iterator(self): i {
    self.as-buffer().iterator()
  }
}

impl[t] iterable[item = t, i = buffer-iterator[t]] for *list[t] {
  fn(inline) iterator(self): i {
    self.*.iterator()
  }
}
