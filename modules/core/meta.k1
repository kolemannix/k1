ns meta {

  // Escapes into a valid K1 double-quoted string literal
  fn str-lit(s: string): string {
    let b = string-builder/new()
    b.write-char('"')
    for c in s {
      if c == '\\' b.write("\\\\")
      else if c == '"' b.write("\\\"")
      else if c == '$' b.write("\\$")
      else if c == '\n' b.write("\\n")
      else if c == '\r' b.write("\\r")
      else if c == '\t' b.write("\\t")
      else b.write-char(c)
    }
    b.write-char('"')
    b.build()
  }

  fn type-of(expr: code): types/type-id { eval("type-of($expr)") }

  fn baked-value-expr[t](value: t): string {
    let value-id = bake-static-value[t](value)
    `core/meta/get-static-value($value-id)`
  }

  fn baked-variable[t](name: string, value: t): string {
    let baked-value-expr: string = baked-value-expr[t](value)
    let type-id = types/id[t]
    `let $name: ${type-id.spell()} = $baked-value-expr;\n`
  }

  fn define-soa[t](context locn: k1/source-location)(name: string): code {
    let row-id = types/id[t]
    require row-id.struct-parts() is .{ kind = :struct, fields } else crash("define-soa needs a plain struct")
    if fields.is-empty() crash("Input struct must have at least one field")
    let row = row-id.spell()
    let columns = row-id.map-struct(fn elem. types/make-instance(types/id[list], [elem]))

    let cb = code-builder/new()
    cb.writeln("type $name = ${columns.spell()}")
    cb.writeln("ns for $name {")
    cb.writeln("  fn row(self: $name, index: size): $row { .{")
    for f in fields { cb.writeln("    ${f.name} = self.${f.name}.[index],") }
    cb.writeln("  } }")
    cb.writeln("  fn empty(): $name { .0 }")
    cb.writeln("  fn push(self: *$name, value: $row) {")
    for f in fields { cb.writeln("    self.${f.name}.push(value.${f.name})") }
    cb.writeln("  }")
    cb.writeln("}")
    cb.build()
  }

}
