// core types code that does not need to live in builtin.k1
ns types

impl print for int-value {
   fn print-to[w: writer](self, w) {
     if self is {
       :u8 v  -> w.write("${v}u8"),
       :u16 v -> w.write("${v}u16"),
       :u32 v -> w.write("${v}u32"),
       :u64 v -> w.write("${v}u64"),
       :i8 v  -> w.write("${v}i8"),
       :i16 v -> w.write("${v}i16"),
       :i32 v -> w.write("${v}i32"),
       :i64 v -> w.write("${v}i64"),
     }
   }
}

ns for int-value {
  fn to[t](self: int-value): t {
    #if types/schema[t] is {
      :int :u8  -> self.as-u8().!,
      :int :u16 -> self.as-u16().!,
      :int :u32 -> self.as-u32().!,
      :int :u64 -> self.as-u64().!,
      :int :i8  -> self.as-i8().!,
      :int :i16 -> self.as-i16().!,
      :int :i32 -> self.as-i32().!,
      :int :i64 -> self.as-i64().!,
      _ -> crash("int-value.to: ${types/name[t]} is not an integer type"),
    }
  }
}

type any = {
  type-id,
  value: ptr
}

fn make-any[t](t: *t): any {
  .{ type-id = id[t], value = t.as[ptr] }
}

fn assert-wrapper-type[wrapper, inner]() {
  let schema-a = types/schema[wrapper]
  let b-type-id = types/id[inner]
  require schema-a is :struct .{ fields } else { crash("is-wrapper-type: Wrapper must be a struct") }
  require fields.first() is :some field and fields.len() == 1 else crash("Wrapper must have one field, got ${fields.len()}")
  let equal = field.type-id == b-type-id
  if not equal crash("Expected ${types/name[inner]} but got ${field.type-id.name()}")
}

fn map-struct(type-id, map-type: some fn(type-id) -> type-id): type-id {
  let source: { kind: record-kind, fields: type-schema:struct.fields } = if type-id.schema() is {
    :struct s -> .{ kind = if s.packed :packed else :struct, fields = s.fields },
    :union u -> .{ kind = :union, fields = u.fields },
    _ -> crash("map-struct: ${type-id.name()} is not a struct"),
  }
  let fields: list[make-struct.fields.t] = list/with-capacity(source.fields.len())
  for source.fields { fields.push(.{ name = it.name, type = map-type(it.type-id) }) }
  make-struct(source.kind, fields.as-span())
}

fn type-eq[a, b](): bool { types/id[a] == types/id[b] }

fn assert-layout[t](size: size, align: size, struct-fields: span[size]) {
  let actual-size = types/stride[t]
  let actual-align = types/align[t]
  assert-equals(size, actual-size)
  assert-equals(align, actual-align)
  if struct-fields.non-empty() {
    let schema-fields = types/schema[t].as-struct().!.fields
    for offset in struct-fields {
      let actual-field = schema-fields.[it-index]
      assert-msg("offset of ${actual-field.name} ${actual-field.offset} != $offset", actual-field.offset == offset)
    }
  }
}
