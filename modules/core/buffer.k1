// Represents a contiguously allocated segment of memory that
// is alleged to store values of type t. This is an inherently
// unsafe type as all of the memory is not guaranteed to be populated
//
// i'm going to introduce a safe wrapper around it that is meant to be used
// as your 'slice' type, and we'll rename this, perhaps, to RawBuffer
// It'll be the same thing except for a 'Promise' from the creator that
// it's fully populated
ns for buffer {

  fn buffer-size-bytes[t](count: size): size {
    count * core/types/stride[t]
  }

  fn size-bytes[t](self: buffer[t]): size { buffer-size-bytes[t](self.len) }

  fn data-ptr[t](self: buffer[t]): ptr { self.data.as[ptr] }

  fn len[t](self: buffer[t]): size { self.len }

  fn raw-parts[t](self: buffer[t]): { ptr: ptr, len: size } { .{ ptr = self.data.as[ptr], len = self.len } }

  ////////////////////////
  // Constructor functions

  fn empty[t](): buffer[t] {
    .{ len = 0, data = ptr/null.ref[t] }
  }

  fn wrap-raw[t](ptr, count: size): buffer[t] {
    .{ len = count, data = ptr.ref[t] }
  }

  fn wrap-ref[t](data: *t, len: size): buffer[t] {
    .{ len, data }
  }

  fn from-array[t, n: static size](array: *array[t, n]): buffer[t] {
    array.as-span().inner-buffer().cloned()
  }

  fn from-span[t](span: span[t]): buffer[t] {
    span.inner-buffer().cloned()
  }

  fn cloned[t](self: buffer[t]): buffer[t] {
    let clone = self._enlarged-clone(new-count = self.len)
    clone
  }

  fn fill[t](self: buffer[t], value: t): empty {
    if value is {
      type[u8](byte) -> {
        self.memset(byte)
      },
      type[i8](byte) -> {
        self.memset(byte.unsigned())
      },
      _ -> {
        let i = 0
        while i < self.len {
          self.index-unchecked(i).* = value
          i = i + 1
        }
      }
    }
  }

  fn filled-in[t, a: allocator](alloc: a, size: size, value: t): buffer[t] {
    let buf: buffer[t] = allocate-in[t, _](alloc, size)
    buf.fill(value)
    buf
  }

  fn filled[t](size: size, value: t): buffer[t] {
    buffer/filled-in[t, _](mem/current-arena(), size, value)
  }

  fn allocate-in[t, a: allocator](alloc: a, count: size): buffer[t] {
    let ptr = if count == 0 {
      ptr/null
    } else {
      let size-bytes = buffer-size-bytes[t](count)
      alloc.alloc(size-bytes, core/types/align[t]())
    }
    let data = ptr.ref[t]
    .{ len = count, data }
  }

  fn allocate[t](count: size): buffer[t] {
    allocate-in[t, _](mem/current-arena(), count)
  }

  ////////////////////////
  // Modification

  fn _grow-to[t, a: allocator](self: *mut buffer[t], alloc: a, new-count: size): empty {
    let new-size = buffer-size-bytes[t](new-count)
    let old-size = buffer-size-bytes[t](self.len)
    let new-ptr = alloc.realloc(
      old-ptr = self.data-ptr(),
      old-size = old-size,
      align = core/types/align[t](),
      new-size = new-size,
    )
    self.* = .{ len = new-count, data = new-ptr.ref[t] }
  }

  fn _enlarged-clone-in[t, a: allocator](self: buffer[t], alloc: a, new-count: size): buffer[t] {
    let new-buffer = allocate-in[t, _](alloc, new-count)
    copy[t](src = self, dst = new-buffer)
    new-buffer
  }

  fn _enlarged-clone[t](self: buffer[t], new-count: size): buffer[t] {
    self._enlarged-clone-in[t, _](mem/current-arena(), new-count)
  }

  fn copy[t](src: buffer[t], dst: buffer[t]) {
    if src.len > dst.len {
      crash("Buffer copy dst index out of bounds: ${src.len} > ${dst.len}")
    }
    if src.len == 0 return
    let num-bytes = buffer-size-bytes[t](src.len)
    mem/copy(dst = dst.data-ptr(), src = src.data-ptr(), count = num-bytes)
  }

  fn move[t](src: buffer[t], dst: buffer[t]) {
    if src.len > dst.len {
      crash("Buffer copy dst index out of bounds: ${src.len} > ${dst.len}")
    }
    if src.len == 0 return
    let num-bytes = buffer-size-bytes[t](src.len)
    mem/move(dst = dst.data-ptr(), src = src.data-ptr(), count = num-bytes)
  }

  fn cloned-in[t, a: allocator](self: buffer[t], alloc: a): buffer[t] {
    self._enlarged-clone-in(alloc, new-count = self.len)
  }

  // Performs a shifting remove, but does not shrink buffer.len
  fn remove[t](self: buffer[t], index: size) {
    check-bounds(self, index)
  
    if index + 1 < self.len {
      let src = self.slice(start = index + 1, end = self.len)
      let dst = self.slice(start = index,     end = self.len - 1)
      buffer/move(src = src, dst = dst) // memmove semantics
    }
  
    self.[self.len - 1] = mem/zeroed[t]
  }

  ///////////////////////////
  // Accessor functions

  fn index-unchecked[t](self: buffer[t], index: size): *mut t {
    self.data-ptr().ref-at[t](index)
  }

  fn check-bounds[t](self: buffer[t], index: size) {
    if index.unsigned() >= self.len.unsigned() {
      crash("index out of bounds: $index / ${self.len}")
    }
  }

  fn memset[t](self: buffer[t], value: u8): empty {
    mem/set(
      dst = self.data-ptr(),
      value = value,
      count = buffer-size-bytes[t](self.len)
    )
  }

  fn slice[t](self: buffer[t], start: size, end: size): buffer[t] {
    if start < 0 or start > self.len {
      crash("slice start index out of bounds: $start. length is: ${self.len}")
    }
    
    let end-clamp = if end > self.len self.len else end
    
    if end-clamp <= start or self.len == 0 {
      return empty[t]()
    }
    
    let new-len = end-clamp - start
    let new-base = self.[start].&
    .{ len = new-len, data = new-base }
  }

  fn take[t](self: buffer[t], count: size): buffer[t] { self.slice(0, count) }
  fn drop[t](self: buffer[t], count: size): buffer[t] {
    self.slice(if count > self.len self.len else count, self.len)
  }
  fn take-right[t](self: buffer[t], count: size): buffer[t] {
    self.slice(if count > self.len 0 else self.len - count, self.len)
  }
  fn drop-right[t](self: buffer[t], count: size): buffer[t] {
    self.slice(0, if count > self.len 0 else self.len - count)
  }

  fn starts-with[t: equals](self: buffer[t], other: buffer[t]): bool {
    other.len() <= self.len() and
    self.take(other.len()) == other
  }
  
  fn ends-with[t: equals](self: buffer[t], other: buffer[t]): bool {
    other.len() <= self.len() and
    self.take-right(other.len()) == other
  }

  fn position-byte(base: ptr, len: size, needle: u8): ?size {
    let w: size = k1/simd-bytes
    let i = 0: size
    if len >= w {
      let lanes = vector/splat[u8, k1/simd-bytes](needle)
      while i + w <= len {
        let chunk = vector/load-unchecked[u8, k1/simd-bytes](base.ref-at[u8](i).as[ptr])
        let lane = chunk.eq-lanes(lanes).first-true-lane()
        if lane >= 0 return :some (i + lane)
        i = i + w
      }
    }
    while i < len {
      if base.ref-at[u8](i).* == needle return :some i
      i = i + 1
    }
    :none
  }

  // SIMD candidate filter: positions matching the needle's first and last
  // byte at the right distance, verified with a full compare
  fn index-of-bytes(base: ptr, len: size, needle-base: ptr, needle-len: size): ?size {
    let n = len
    let k = needle-len
    if k == 0 return :some 0
    if k > n return :none
    if k == 1 return position-byte(base, n, needle-base.ref-at[u8](0).*)

    let w: size = k1/simd-bytes
    let first = vector/splat[u8, k1/simd-bytes](needle-base.ref-at[u8](0).*)
    let last = vector/splat[u8, k1/simd-bytes](needle-base.ref-at[u8](k - 1).*)
    let i = 0: size
    // Both loads must stay in bounds: lanes [i, i+w) paired with [i+k-1, i+k-1+w)
    while i + w + k - 1 <= n {
      let block-first = vector/load-unchecked[u8, k1/simd-bytes](base.ref-at[u8](i).as[ptr])
      let block-last = vector/load-unchecked[u8, k1/simd-bytes](base.ref-at[u8](i + k - 1).as[ptr])
      let m = block-first.eq-lanes(first).bit-and(block-last.eq-lanes(last)).to-mask()
      while m != 0 {
        let j = m.trailing-zeros().signed()
        if mem/equals(base.ref-at[u8](i + j).as[ptr], needle-base, k) return :some (i + j)
        m = m.bit-and(m - 1)
      }
      i = i + w
    }
    while i + k <= n {
      if mem/equals(base.ref-at[u8](i).as[ptr], needle-base, k) return :some i
      i = i + 1
    }
    :none
  }

  fn position[t: equals](self: buffer[t], needle: t): ?size {
    if needle is {
      type[u8](byte) -> position-byte(self.data-ptr(), self.len, byte),
      type[char](c) -> position-byte(self.data-ptr(), self.len, c.as-u8()),
      _ -> {
        let i = 0: size
        while i < self.len {
          if self.[i] == needle return :some i
          i = i + 1
        }
        :none
      }
    }
  }

  fn index-of-buffer[t: equals](self: buffer[t], needle: buffer[t]): ?size {
    if mem/zeroed[t]() is {
      type[u8](_byte) -> index-of-bytes(self.data-ptr(), self.len, needle.data-ptr(), needle.len),
      type[char](_c) -> index-of-bytes(self.data-ptr(), self.len, needle.data-ptr(), needle.len),
      _ -> {
        let k = needle.len
        if k == 0 return :some 0
        if k > self.len return :none
        let i = 0: size
        while i + k <= self.len {
          let j = 0: size
          let matched = true
          while j < k and matched {
            if self.[i + j] != needle.[j] { matched = false }
            j = j + 1
          }
          if matched return :some i
          i = i + 1
        }
        :none
      }
    }
  }

  fn first-diff[t: equals](self: buffer[t], other: buffer[t]): ?size {
    let n = if self.len < other.len self.len else other.len
    let i = 0: size
    while i < n {
      if self.[i] != other.[i] return :some i
      i = i + 1
    }
    if self.len == other.len :none else :some n
  }

  fn chunks[t](self: buffer[t], size: size): span[buffer[t]] {
    if size == 0 return span/empty()
    let rem = self.len() % size != 0
    let div = self.len() / size
    let results = list/with-capacity[buffer[t]](div + (rem.as-u8().widen[size]))

    let i = 0
    let j = 0
    while i < self.len() {
      let chunk = self.slice(i, i + size)
      results.push(chunk)
      i = i + size
      j = j + 1
    }
    span/wrap-buffer(results.as-buffer())
  }

  fn is-empty[t](self: buffer[t]): bool {
    self.len == 0
  }

  fn non-empty[t](self: buffer[t]): bool {
    self.len > 0
  }

  fn first-ref[t](self: buffer[t]): ?(*mut t) {
    if not self.is-empty() {
      :some self.[0].&
    } else {
      :none
    }
  }

  fn first[t](self: buffer[t]): ?t {
    if self.first-ref() is {
      :none -> :none,
      :some first-ref -> :some first-ref.*
    }
  }

  fn last-ref[t](self: buffer[t]): ?(*mut t) {
    if not self.is-empty() {
      :some self.[self.len - 1].&
    } else {
      :none
    }
  }

  fn last[t](self: buffer[t]): ?t {
    if self.last-ref() is {
      :none -> :none,
      :some last-ref -> :some last-ref.*
    }
  }

  fn concat[t](self: buffer[t], other: buffer[t]): buffer[t] {
    let new = self._enlarged-clone[t](self.len + other.len)
    buffer/copy(
      src = other, 
      dst = new.slice(self.len, self.len + other.len), 
    )
    new
  }

  fn swap[t](self: buffer[t], index-a: size, index-b: size): empty {
    if index-a == index-b return
    let a-ref = self.[index-a].&
    let b-ref = self.[index-b].&
    let b-value = b-ref.*
    b-ref.* = a-ref.*
    a-ref.* = b-value
  }

  let SORT_RUN: size = 24

  fn sort[t](self: buffer[t]) where t: comparable {
    if self.len <= 1 return
    if self.len <= SORT_RUN {
      self._insertion-sort-range(0, self.len - 1)
      return
    }

    let run-start: size = 0
    while run-start < self.len {
      self._insertion-sort-range(run-start, _at-most(run-start + SORT_RUN, self.len) - 1)
      run-start = run-start + SORT_RUN
    }

    let src = self
    let dst = buffer/allocate[t](self.len)
    let width = SORT_RUN
    while width < self.len {
      let lo: size = 0
      while lo < src.len {
        let mid = _at-most(lo + width, src.len)
        let hi = _at-most(lo + (width * 2), src.len)
        _merge-runs(src, dst, lo, mid, hi)
        lo = lo + (width * 2)
      }
      let done = src
      src = dst
      dst = done
      width = width * 2
    }
    if src.data-ptr() != self.data-ptr() { buffer/copy(src = src, dst = self) }
  }

  fn _at-most(value: size, limit: size): size { if value > limit limit else value }

  fn _merge-runs[t](src: buffer[t], dst: buffer[t], lo: size, mid: size, hi: size)
  where t: comparable {
    let left = lo
    let right = mid
    let out = lo
    while out < hi {
      let take-left = if left >= mid false
        else if right >= hi true
        else not (src.[right].compare(src.[left]) is :less)
      if take-left {
        dst.[out] = src.[left]
        left = left + 1
      } else {
        dst.[out] = src.[right]
        right = right + 1
      }
      out = out + 1
    }
  }

  fn _insertion-sort-range[t](self: buffer[t], from: size, to: size) where t: comparable {
    if to <= from return
    let i = from + 1
    while i <= to {
      let value = self.[i]
      let j = i
      while j > from and self.[j - 1].compare(value) is :greater {
        self.[j] = self.[j - 1]
        j = j - 1
      }
      self.[j] = value
      i = i + 1
    }
  }

  fn reverse[t](self: buffer[t]) {
    let i = 0
    while (i < (self.len / 2)) {
      let j = self.len - i - 1
      self.swap(i, j)
      i = i + 1
    }
  }

  fn as-char-buffer(self: buffer[byte]): buffer[char] {
    buffer/wrap-raw[char](
      count = self.len,
      ptr = self.data-ptr()
    )
  }

  fn as-byte-buffer(self: buffer[char]): buffer[byte] {
    buffer/wrap-raw[byte](
      count = self.len,
      ptr = self.data-ptr()
    )
  }

  fn ref-iter[t](self: buffer[t]): buffer-ref-iterator[t] {
    buffer-ref-iterator/from-buffer(self)
  }

}

type buffer-iterator[t] = {
  buf: buffer[t],
  pos: size
}
ns for buffer-iterator {
  fn from-buffer[t](buf: buffer[t]): buffer-iterator[t] { 
    .{ buf, pos = 0 }
  }
}

impl[t] iterator[item = t] for buffer-iterator[t] {
  fn next(self: *mut self): ?item {
    if self.pos < self.buf.len {
      let item = self.buf.[self.pos]
      self.pos = self.pos + 1
      :some item
    } else :none
  }
  fn size-hint(self: *self): { at-least: size, at-most: ?size } {
    let rem = if self.pos < self.buf.len self.buf.len - self.pos else 0
    .{ at-least = rem, at-most = :some rem }
  }
  fn advance-by(self: *mut self, n: size): empty {
    self.pos = self.pos + n
  }
}

impl[t] as-buffer[t = t] for buffer[t] {
  fn as-buffer(self): buffer[t] { self }
}

impl[t] index[key = size, t = t] for buffer[t] {
  fn index-ref(self, key: size): *t {
    self.check-bounds(key)
    self.index-unchecked(key)
  }
}

impl[t] iterable[item = t, i = buffer-iterator[t]] for buffer[t] {
  fn iterator(self): i {
    buffer-iterator/from-buffer(self)
  }
}

impl[t: print] print for buffer[t] {
  fn print-to[w: writer](self, w): empty {
    w.write-char('[')
    for self {
      it.print-to(w)
      let last = it-index == self.len - 1
      if not last {
        w.write-char(',')
      }
    }
    w.write-char(']')
  }
}

type buffer-ref-iterator[t] = {
  buf: buffer[t],
  pos: size
}
ns for buffer-ref-iterator {
  fn from-buffer[t](buf: buffer[t]): buffer-ref-iterator[t] { 
    .{ buf, pos = 0 }
  }
}

impl[t] iterator[item = *mut t] for buffer-ref-iterator[t] {
  fn next(self: *mut self): ?item {
    if self.pos < self.buf.len {
      let item = self.buf.[self.pos].&
      self.pos = self.pos + 1
      :some item
    } else :none
  }
  fn size-hint(self: *self): { at-least: size, at-most: ?size } {
    let rem = if self.pos < self.buf.len self.buf.len - self.pos else 0
    .{ at-least = rem, at-most = some(rem) }
  }
  fn advance-by(self: *mut self, n: size): empty {
    self.pos = self.pos + n
  }
}

impl[t: equals] equals for buffer[t] {
  fn equals(self: buffer[t], other: buffer[t]): bool {
    if self.len != other.len false else {
      for a in self {
        let b = other.[it-index]
        if a != b return false
      }
      true
    }
  }
}

impl[n: static size, t] iterable[item = t, i = buffer-iterator[t]] for *array[t, n] {
  fn iterator(self): i {
    buffer-iterator/from-buffer(
      self.as-span().inner-buffer()
    )
  }
}

impl[n: static size, t] iterable[item = *mut t, i = buffer-ref-iterator[t]] for *array[t, n] {
  fn iterator(self): i {
    buffer-ref-iterator/from-buffer(
      self.as-span().inner-buffer()
    )
  }
}
