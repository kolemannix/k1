// Represents a contiguously allocated segment of memory that
// is alleged to store values of type t. This is an inherently
// unsafe type as all of the memory is not guaranteed to be populated
//
// i'm going to introduce a safe wrapper around it that is meant to be used
// as your 'slice' type, and we'll rename this, perhaps, to RawBuffer
// It'll be the same thing except for a 'Promise' from the creator that
// it's fully populated
ns for buffer {

  fn(inline) buffer-size-bytes[t](count: size): size { count * types/stride[t] }
  fn(inline) size-bytes[t](self: buffer[t]): size { self.len * types/stride[t] }

  fn(inline) data-ptr[t](self: buffer[t]): ptr { self.data }
  fn(inline) data-ref[t](self: buffer[t]): *t { self.data.ref[t] }

  fn(inline) len[t](self: buffer[t]): size { self.len }

  fn(inline) raw-parts[t](self: buffer[t]): { ptr: ptr, len: size } { .{ ptr = self.data, len = self.len } }

  fn(inline) grown-cap(cap: size, elem-size: size): size {
    if cap == 0 { if elem-size >= 1024 1 else 8 } else cap * 2
  }

  ////////////////////////
  // Constructor functions

  fn(inline) empty[t](): buffer[t] { .{ len = 0, data = ptr/null } }
  fn(inline) wrap-raw[t](ptr, count: size): buffer[t] { .{ len = count, data = ptr } }
  fn(inline) wrap-ref[t](data: *t, len: size): buffer[t] { .{ len, data = data.as[ptr] } }

  fn(inline) from-array[t, n: static size](array: *array[t, n]): buffer[t] {
    array.as-span().inner-buffer().cloned()
  }

  fn(inline) from-span[t](span: span[t]): buffer[t] { span.inner-buffer().cloned() }

  fn(inline) cloned[t](self: buffer[t]): buffer[t] { self._enlarged-clone(new-count = self.len) }

  fn fill[t](self: buffer[t], value: t): empty {
    #if types/schema[t] is {
      :int :u8 -> self.memset(value),
      :int :i8 -> self.memset(value.unsigned()),
      :char -> self.memset(value.as-u8()),
      _ -> {
        let i = 0
        while i < self.len {
          self.index-unchecked(i).* = value
          i = i + 1
        }
      }
    }
  }

  fn(inline) filled-in[t, a: allocator](alloc: a, size: size, value: t): buffer[t] {
    let buf: buffer[t] = allocate-in[t, _](alloc, size)
    buf.fill(value)
    buf
  }

  fn(inline) filled[t](size: size, value: t): buffer[t] {
    buffer/filled-in[t, _](mem/current-arena(), size, value)
  }

  fn(inline) allocate-in[t, a: allocator](alloc: a, count: size): buffer[t] {
    let data = if count == 0 ptr/null else alloc.alloc(count * types/stride[t], types/align[t]())
    .{ data, len = count }
  }

  fn(inline) allocate[t](count: size): buffer[t] {
    allocate-in[t, _](mem/current-arena(), count)
  }

  ////////////////////////
  // Modification

  fn(noinline) _grow-to[t, a: allocator](self: *buffer[t], alloc: a, new-count: size): empty {
    let data = alloc.realloc(
      old-ptr = self.data,
      old-size = self.size-bytes(),
      align = types/align[t](),
      new-size = new-count * types/stride[t],
    )
    self.* = .{ data, len = new-count }
  }

  fn(inline) _enlarged-clone-in[t, a: allocator](self: buffer[t], alloc: a, new-count: size): buffer[t] {
    let new = allocate-in[t, _](alloc, new-count)
    buffer/copy(src = self, dst = new)
    new
  }

  fn(inline) _enlarged-clone[t](self: buffer[t], new-count: size): buffer[t] {
    self._enlarged-clone-in[t, _](mem/current-arena(), new-count)
  }

  fn(inline) copy[t](src: buffer[t], dst: buffer[t]) {
    if src.len > dst.len crash-bounds(dst.len, src.len, "buffer copy: src longer than dst")
    mem/copy(dst = dst.data, src = src.data, count = src.size-bytes())
  }

  fn(inline) move[t](src: buffer[t], dst: buffer[t]) {
    if src.len > dst.len crash-bounds(dst.len, src.len, "buffer move: src longer than dst")
    mem/move(dst = dst.data, src = src.data, count = src.size-bytes())
  }

  fn(inline) cloned-in[t, a: allocator](self: buffer[t], alloc: a): buffer[t] {
    self._enlarged-clone-in(alloc, new-count = self.len)
  }

  fn remove[t](self: buffer[t], index: size) {
    checked-index(index, self.len)
    if index + 1 < self.len {
      buffer/move(src = self.slice(index + 1, self.len), dst = self.slice(index, self.len - 1))
    }
    mem/set(dst = self.data.add-bytes((self.len - 1) * types/stride[t]), value = 0, count = types/stride[t])
  }

  ///////////////////////////
  // Accessor functions

  fn(inline) index-unchecked[t](self: buffer[t], index: size): *t {
    self.data-ptr().ref-at[t](index)
  }

  fn(inline) memset[t](self: buffer[t], value: u8): empty {
    mem/set(dst = self.data, value = value, count = self.size-bytes())
  }

  fn slice[t](self: buffer[t], start: size, end: size): buffer[t] {
    if start.unsigned() > self.len.unsigned() crash-bounds(self.len, start, "slice start out of bounds")
    let end-clamp = end.min(self.len)
    if end-clamp <= start or self.len == 0 {
      return .{ data = ptr/null, len = 0 }
    }
    .{ data = self.data.add-bytes(types/stride[t] * start), len = end-clamp - start }
  }

  fn(inline) take[t](self: buffer[t], count: size): buffer[t] { self.slice(0, count) }
  fn(inline) drop[t](self: buffer[t], count: size): buffer[t] {
    self.slice(count.min(self.len), self.len)
  }
  fn(inline) take-right[t](self: buffer[t], count: size): buffer[t] {
    self.slice(if count > self.len 0 else self.len - count, self.len)
  }
  fn(inline) drop-right[t](self: buffer[t], count: size): buffer[t] {
    self.slice(0, if count > self.len 0 else self.len - count)
  }

  fn starts-with[t: equals](self: buffer[t], other: buffer[t]): bool {
    other.len() <= self.len() and
    self.take(other.len()) == other
  }
  
  fn ends-with[t: equals](self: buffer[t], other: buffer[t]): bool {
    other.len() <= self.len() and
    self.take-right(other.len()) == other
  }

  fn position-lanes[t: equals and bitwise, n: static size](base: ptr, len: size, needle: t): ?size {
    let w: size = core/meta/static-type-to-value[_, n]()
    let i = 0: size
    if len >= w {
      let lanes = vector/splat[t, n](needle)
      while i + 4 * w <= len {
        let e0 = vector/load-unchecked[t, n](base.ref-at[t](i).as[ptr]).eq-lanes(lanes)
        let e1 = vector/load-unchecked[t, n](base.ref-at[t](i + w).as[ptr]).eq-lanes(lanes)
        let e2 = vector/load-unchecked[t, n](base.ref-at[t](i + 2 * w).as[ptr]).eq-lanes(lanes)
        let e3 = vector/load-unchecked[t, n](base.ref-at[t](i + 3 * w).as[ptr]).eq-lanes(lanes)
        if e0.bit-or(e1).bit-or(e2).bit-or(e3).any() {
          let l0 = e0.first-true-lane()
          if l0 >= 0 return :some (i + l0)
          let l1 = e1.first-true-lane()
          if l1 >= 0 return :some (i + w + l1)
          let l2 = e2.first-true-lane()
          if l2 >= 0 return :some (i + 2 * w + l2)
          return :some (i + 3 * w + e3.first-true-lane())
        }
        i = i + 4 * w
      }
      while i + w <= len {
        let lane = vector/load-unchecked[t, n](base.ref-at[t](i).as[ptr]).eq-lanes(lanes).first-true-lane()
        if lane >= 0 return :some (i + lane)
        i = i + w
      }
    }
    while i < len {
      if base.ref-at[t](i).* == needle return :some i
      i = i + 1
    }
    :none
  }

  // SIMD candidate filter: positions matching the needle's first and last
  // byte at the right distance, verified with a full compare
  fn index-of-bytes(base: ptr, len: size, needle-base: ptr, needle-len: size): ?size {
    let n = len
    let k = needle-len
    if k == 0 return :some 0
    if k > n return :none
    if k == 1 return position-lanes[u8, k1/simd-bytes](base, n, needle-base.ref-at[u8](0).*)

    let w: size = k1/simd-bytes
    let first = vector/splat[u8, k1/simd-bytes](needle-base.ref-at[u8](0).*)
    let last = vector/splat[u8, k1/simd-bytes](needle-base.ref-at[u8](k - 1).*)
    let i = 0: size
    // Both loads must stay in bounds: lanes [i, i+w) paired with [i+k-1, i+k-1+w)
    while i + w + k - 1 <= n {
      let block-first = vector/load-unchecked[u8, k1/simd-bytes](base.ref-at[u8](i).as[ptr])
      let block-last = vector/load-unchecked[u8, k1/simd-bytes](base.ref-at[u8](i + k - 1).as[ptr])
      let m = block-first.eq-lanes(first).bit-and(block-last.eq-lanes(last)).to-mask()
      while m != 0 {
        let j = m.trailing-zeros().signed()
        if mem/equals(base.ref-at[u8](i + j).as[ptr], needle-base, k) return :some (i + j)
        m = m.bit-and(m - 1)
      }
      i = i + w
    }
    while i + k <= n {
      if mem/equals(base.ref-at[u8](i).as[ptr], needle-base, k) return :some i
      i = i + 1
    }
    :none
  }

  fn index-of-buffer[t: equals](self: buffer[t], needle: buffer[t]): ?size {
    #if types/schema[t] is {
      :int :u8 or :int :i8 or :char ->
        index-of-bytes(self.data-ptr(), self.len, needle.data-ptr(), needle.len),
      _ -> {
        let k = needle.len
        if k == 0 return :some 0
        if k > self.len return :none
        let i = 0: size
        while i + k <= self.len {
          let j = 0: size
          let matched = true
          while j < k and matched {
            if self.[i + j] != needle.[j] { matched = false }
            j = j + 1
          }
          if matched return :some i
          i = i + 1
        }
        :none
      }
    }
  }

  fn first-diff[t: equals](self: buffer[t], other: buffer[t]): ?size {
    let n = self.len.min(other.len)
    let i = 0: size
    while i < n {
      if self.[i] != other.[i] return :some i
      i = i + 1
    }
    if self.len == other.len :none else :some n
  }

  fn chunks[t](self: buffer[t], size: size): span[buffer[t]] {
    if size == 0 return span/empty()
    let rem = self.len() % size != 0
    let div = self.len() / size
    let results = list/with-capacity[buffer[t]](div + (rem.as-u8().widen[size]))

    let i = 0
    let j = 0
    while i < self.len() {
      let chunk = self.slice(i, i + size)
      results.push(chunk)
      i = i + size
      j = j + 1
    }
    span/wrap-buffer(results.as-buffer())
  }

  fn(inline) is-empty[t](self: buffer[t]): bool {
    self.len == 0
  }

  fn(inline) non-empty[t](self: buffer[t]): bool {
    self.len > 0
  }

  fn first-ref[t](self: buffer[t]): ?(*t) {
    if not self.is-empty() {
      :some self.[0].&
    } else {
      :none
    }
  }

  fn first[t](self: buffer[t]): ?t {
    if self.first-ref() is {
      :none -> :none,
      :some first-ref -> :some first-ref.*
    }
  }

  fn last-ref[t](self: buffer[t]): ?(*t) {
    if not self.is-empty() {
      :some self.[self.len - 1].&
    } else {
      :none
    }
  }

  fn last[t](self: buffer[t]): ?t {
    if self.last-ref() is {
      :none -> :none,
      :some last-ref -> :some last-ref.*
    }
  }

  fn concat[t](self: buffer[t], other: buffer[t]): buffer[t] {
    let new = self._enlarged-clone-in(mem/current-arena(), self.len + other.len)
    buffer/copy(src = other, dst = new.slice(self.len, self.len + other.len))
    new
  }

  fn swap[t](self: buffer[t], index-a: size, index-b: size): empty {
    if index-a == index-b return
    let a-ref = self.[index-a].&
    let b-ref = self.[index-b].&
    let b-value = b-ref.*
    b-ref.* = a-ref.*
    a-ref.* = b-value
  }

  let SORT_RUN: size = 24

  fn sort[t](self: buffer[t]) where t: comparable {
    if self.len <= 1 return
    if self.len <= SORT_RUN {
      self._insertion-sort-range(0, self.len - 1)
      return
    }

    let run-start: size = 0
    while run-start < self.len {
      self._insertion-sort-range(run-start, (run-start + SORT_RUN).min(self.len) - 1)
      run-start = run-start + SORT_RUN
    }

    let src = self
    let dst = buffer/allocate[t](self.len)
    let width = SORT_RUN
    while width < self.len {
      let lo: size = 0
      while lo < src.len {
        let mid = (lo + width).min(src.len)
        let hi = (lo + (width * 2)).min(src.len)
        _merge-runs(src, dst, lo, mid, hi)
        lo = lo + (width * 2)
      }
      let done = src
      src = dst
      dst = done
      width = width * 2
    }
    if src.data-ptr() != self.data-ptr() { buffer/copy(src = src, dst = self) }
  }

  fn _merge-runs[t](src: buffer[t], dst: buffer[t], lo: size, mid: size, hi: size)
  where t: comparable {
    let left = lo
    let right = mid
    let out = lo
    while out < hi {
      let take-left = if left >= mid false
        else if right >= hi true
        else not (src.[right].compare(src.[left]) is :less)
      if take-left {
        dst.[out] = src.[left]
        left = left + 1
      } else {
        dst.[out] = src.[right]
        right = right + 1
      }
      out = out + 1
    }
  }

  fn _insertion-sort-range[t](self: buffer[t], from: size, to: size) where t: comparable {
    if to <= from return
    let i = from + 1
    while i <= to {
      let value = self.[i]
      let j = i
      while j > from and self.[j - 1].compare(value) is :greater {
        self.[j] = self.[j - 1]
        j = j - 1
      }
      self.[j] = value
      i = i + 1
    }
  }

  fn reverse[t](self: buffer[t]) {
    let i = 0
    while (i < (self.len / 2)) {
      let j = self.len - i - 1
      self.swap(i, j)
      i = i + 1
    }
  }

  fn(inline) as-char-buffer(self: buffer[byte]): buffer[char] {
    buffer/wrap-raw[char](
      count = self.len,
      ptr = self.data-ptr()
    )
  }

  fn(inline) as-byte-buffer(self: buffer[char]): buffer[byte] {
    buffer/wrap-raw[byte](
      count = self.len,
      ptr = self.data-ptr()
    )
  }

  fn(inline) ref-iter[t](self: buffer[t]): buffer-ref-iterator[t] {
    buffer-ref-iterator/from-buffer(self)
  }

}

type buffer-iterator[t] = {
  buf: buffer[t],
  pos: size
}
ns for buffer-iterator {
  fn(inline) from-buffer[t](buf: buffer[t]): buffer-iterator[t] { .{ buf, pos = 0 } }
}

impl[t] iterator[item = t] for buffer-iterator[t] {
  fn(inline) next(self: *self): ?item {
    if self.pos < self.buf.len {
      let item = self.buf.index-unchecked(self.pos).*
      self.pos = self.pos + 1
      :some item
    } else :none
  }
  fn size-hint(self: *self): { at-least: size, at-most: ?size } {
    let rem = if self.pos < self.buf.len self.buf.len - self.pos else 0
    .{ at-least = rem, at-most = :some rem }
  }
  fn advance-by(self: *self, n: size): empty {
    self.pos = self.pos + n
  }
  fn seek(self: *self, needle: item): ?size {
    let base = self.buf.data-ptr().ref-at[t](self.pos).as[ptr]
    let len = self.buf.len - self.pos
    let found: ?size = #if types/schema[t] is {
      :int :u8 or :int :i8 -> buffer/position-lanes[t, k1/simd-bytes](base, len, needle),
      :char or :bool -> buffer/position-lanes[u8, k1/simd-bytes](base, len, mem/bitcast[t, u8](needle)),
      :int :u16 or :int :i16 -> buffer/position-lanes[t, vector/simd-lanes-16](base, len, needle),
      :int :u32 or :int :i32 -> buffer/position-lanes[t, vector/simd-lanes-32](base, len, needle),
      :int :u64 or :int :i64 -> buffer/position-lanes[t, vector/simd-lanes-64](base, len, needle),
      _ -> {
        let i = 0: size
        while i < len {
          if base.ref-at[t](i).* == needle break
          i = i + 1
        }
        if i < len :some i else :none
      }
    }
    self.pos = if found is :some i self.pos + i + 1 else self.buf.len
    found
  }
}

impl[t] as-buffer[t = t] for buffer[t] {
  fn(inline) as-buffer(self): buffer[t] { self }
}

impl[t] index[key = size, t = t] for buffer[t] {
  fn(inline) index-ref(self, key: size): *t {
    self.index-unchecked(checked-index(key, self.len))
  }
}

impl[t] iterable[item = t, i = buffer-iterator[t]] for buffer[t] {
  fn(inline) iterator(self): i {
    buffer-iterator/from-buffer(self)
  }
}

impl[t: print] print for buffer[t] {
  fn print-to[w: writer](self, w): empty {
    w.write-char('[')
    for self {
      it.print-to(w)
      let last = it-index == self.len - 1
      if not last {
        w.write-char(',')
      }
    }
    w.write-char(']')
  }
}

type buffer-ref-iterator[t] = {
  buf: buffer[t],
  pos: size
}
ns for buffer-ref-iterator {
  fn from-buffer[t](buf: buffer[t]): buffer-ref-iterator[t] { 
    .{ buf, pos = 0 }
  }
}

impl[t] iterator[item = *t] for buffer-ref-iterator[t] {
  fn(inline) next(self: *self): ?item {
    if self.pos < self.buf.len {
      let item = self.buf.index-unchecked(self.pos)
      self.pos = self.pos + 1
      :some item
    } else :none
  }
  fn size-hint(self: *self): { at-least: size, at-most: ?size } {
    let rem = if self.pos < self.buf.len self.buf.len - self.pos else 0
    .{ at-least = rem, at-most = some(rem) }
  }
  fn advance-by(self: *self, n: size): empty {
    self.pos = self.pos + n
  }
}

impl[t: equals] equals for buffer[t] {
  fn equals(self: buffer[t], other: buffer[t]): bool {
    if self.len != other.len false else {
      for a in self {
        let b = other.[it-index]
        if a != b return false
      }
      true
    }
  }
}

impl[n: static size, t] iterable[item = t, i = buffer-iterator[t]] for *array[t, n] {
  fn(inline) iterator(self): i {
    buffer-iterator/from-buffer(
      self.as-span().inner-buffer()
    )
  }
}

impl[n: static size, t] iterable[item = *t, i = buffer-ref-iterator[t]] for *array[t, n] {
  fn(inline) iterator(self): i {
    buffer-ref-iterator/from-buffer(
      self.as-span().inner-buffer()
    )
  }
}
