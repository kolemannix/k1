// SIMD vectors: `vector[t, n]` holds n lanes of scalar t, where t is an
// int, char, or float type and n is a power of two with a total size of at
// most 64 bytes (512 bits)
ns vector {

  let simd-lanes-16: size = (k1/simd-bytes) / 2
  let simd-lanes-32: size = (k1/simd-bytes) / 4
  let simd-lanes-64: size = (k1/simd-bytes) / 8

  fn(builtin) splat[t, n: static size](value: t): vector[t, n]

  fn(builtin) load-unchecked[t, n: static size](src: ptr): vector[t, n]
  fn(builtin) store-unchecked[t, n: static size](v: vector[t, n], dst: ptr)

  fn(builtin) get-lane[t, n: static size](v: vector[t, n], index: size): t
  fn(builtin) with-lane[t, n: static size](v: vector[t, n], index: size, value: t): vector[t, n]

  // Lane-wise compare: each lane is all-ones on equal, all-zeros otherwise.
  fn(builtin) eq-lanes[t, n: static size](a: vector[t, n], b: vector[t, n]): vector[t, n]
  // Lane-wise a < b; unsigned for unsigned elements, ordered for floats
  fn(builtin) lt-lanes[t, n: static size](a: vector[t, n], b: vector[t, n]): vector[t, n]
  fn(inline) gt-lanes[t, n: static size](a: vector[t, n], b: vector[t, n]): vector[t, n] {
    lt-lanes(b, a)
  }

  // Byte table lookup with pshufb semantics: a lane whose top bit is set
  // yields 0, any other lane yields table[idx & 15]
  fn(builtin) shuffle-bytes(table: vector[u8, 16], idx: vector[u8, 16]): vector[u8, 16]

  fn(builtin) shuffle[t, n: static size](a: vector[t, n], b: vector[t, n], mask: array[size, n]): vector[t, n]

  fn window-mask[n: static size](start: size): array[size, n] {
    let mask: array[size, n] = uninit
    for i in 0.until(n) { mask.[i] = start + i }
    mask
  }

  // The 16 bytes ending k before the end of cur: prev's last k bytes, then cur's first 16-k
  fn shift-bytes[k: static size](prev: vector[u8, 16], cur: vector[u8, 16]): vector[u8, 16] {
    shuffle(prev, cur, #static window-mask[16](16 - k))
  }

  // collapses lane MSBs into one bit per lane (movemask)
  fn(builtin) to-mask[t, n: static size](v: vector[t, n]): u64

  // The bitwise or of every lane; integer elements only
  fn(builtin) reduce-or[t, n: static size](v: vector[t, n]): t

  fn(inline) load-word(ptr): u64 { load-unchecked[u8, 8](ptr).to-u64() }

  fn zeroed[t, n: static size](): vector[t, n] {
    .0
  }

  fn(inline) lane-count[t, n: static size](_v: vector[t, n]): size { n }

  fn(inline) size-bytes[t, n: static size](_v: vector[t, n]): size {
    types/size[vector[t, n]]
  }

  fn from-span[t, n: static size](s: span[t], start: size): vector[t, n] {
    if start + n > s.len() {
      crash("vector/from-span out of bounds")
    }
    load-unchecked[t, n](s.data-ptr().ref-at[t](start).as[ptr])
  }

  fn(inline) to-u64[t, n: static size](v: vector[t, n]): u64 { mem/bitcast(v) }

  fn(inline) eq-mask[t, n: static size](a: vector[t, n], b: vector[t, n]): u64 {
    a.eq-lanes(b).to-mask()
  }

  fn(inline) any[t, n: static size](v: vector[t, n]): bool {
    v.to-mask() != 0
  }

  fn(inline) all[t, n: static size](v: vector[t, n]): bool {
    v.to-mask() == u64/bitmask-low(v.lane-count())
  }

  // Lane index of the first true (all-ones) lane of a lane-mask, or -1
  fn first-true-lane[t, n: static size](v: vector[t, n]): i64 {
    let mask = v.to-mask()
    if mask == 0 { -1 } else { mask.trailing-zeros().signed() }
  }
}

impl[t: add, n: static size] add for vector[t, n] { fn(builtin) add(self, rhs: self): self }
impl[t: sub, n: static size] sub for vector[t, n] { fn(builtin) sub(self, rhs: self): self }
impl[t: mul, n: static size] mul for vector[t, n] { fn(builtin) mul(self, rhs: self): self }

impl[t: bitwise, n: static size] bitwise for vector[t, n] {
  fn(builtin) bit-not(self): self
  fn(builtin) bit-and(self, other: self): self
  fn(builtin) bit-or(self, other: self): self
  fn(builtin) xor(self, other: self): self
  fn(builtin) shift-left(self, count: u32): self
  fn(builtin) shift-right(self, count: u32): self
}

impl[t, n: static size] equals for vector[t, n] {
  fn equals(self, other: self): bool {
    self.eq-lanes(other).all()
  }
}

impl[t: print, n: static size] print for vector[t, n] {
  fn print-to[w: writer](self, w) {
    w.write("v[")
    w.join-with(0.until(self.lane-count()), ", ", fn[w, self] i. self.get-lane(i).print-to(w))
    w.write("]")
  }
}
