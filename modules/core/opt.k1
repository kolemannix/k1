ns for opt {

  fn(inline) is-some[t](self: ?t): bool { self is :some _ }
  fn(inline) is-none[t](self: ?t): bool { self is :none }

  fn(inline) get[t](context locn: k1/source-location)(self: ?t): t {
    if self is :some(t) t else {
      crash("opt.get on None")
    }
  }

  fn contains[t: equals](self: ?t, t: t): bool {
    if self is {
      :none -> false,
      :some v -> v == t
    }
  }

  fn map[t, u](self: opt[t], f: some fn t -> u): opt[u] {
    if self is {
      :none -> :none,
      :some t -> :some f(t)
    }
  }

}

impl[t: equals] equals for opt[t] {
  fn equals(self: opt[t], other: opt[t]): bool {
    if self is :some at {
      if other is :some(bt) at == bt else false
    } else {
      other is :none
    }
  }
}

impl[a] try[t = a, e = string] for opt[a] {
  fn(inline) error(_e: string): opt[t] { opt:none }
  fn(inline) value(t): opt[t] { opt:some t }

  fn(inline) is-ok(self: opt[t]): bool { self is :some _ }
  fn get-error(self: opt[t]): string {
    if self is {
      :none   -> #static "${types/name[opt[t]]} was :none",
      :some _ -> crash("get-error on :some")
    }
  }
  fn(inline) get-value(self: opt[t]): t { self.get() }
}
