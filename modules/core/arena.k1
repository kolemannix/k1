// The bump window (base-ptr/cur-addr/end-addr) points into the current
// chunk. The first chunk holds this header and is where reset restores the
// window; chunks acquired by growth are chained through extra-chunks.
// Field order is mirrored in the compiler (vm.rs k1_types::Arena).
type arena = {
  base-ptr: ptr,
  cur-addr: ptr,
  end-addr: ptr,
  first-base: ptr,
  first-end: ptr,
  extra-chunks: ptr,
  // Hard limit, no chaining
  fixed: bool,
  name: string,
}

// At the start of each chunk acquired after the first
type arena-chunk = { region: platform/memory/region, next: ptr, prev-cur: ptr }

ns for arena {
  let kb: size = 1024
  let mb: size = 1048576
  let gb: size = 1073741824

  fn used-bytes(self: *arena): size {
    self.cur-addr.diff(self.base-ptr)
  }

  fn set-name(self: *arena, name: string) { self.name = name }

  fn first-region(self: *arena): platform/memory/region {
    let base = self.first-base.sub-bytes(types/stride[arena])
    .{ base, len = self.first-end.diff(base) }
  }

  fn store-header(region: platform/memory/region): *arena {
    assert(region.len >= types/stride[arena] * 2)
    let memory-start = region.base.add-bytes(types/stride[arena])
    let region-end = region.base.add-bytes(region.len)
    let arena: *arena = region.base.ref[arena]
    arena.* = .{
      base-ptr = memory-start,
      cur-addr = memory-start,
      end-addr = region-end,
      first-base = memory-start,
      first-end = region-end,
      extra-chunks = ptr/null,
      fixed = false,
      name = "",
    }
    arena
  }

  fn init(region-size: size): *arena {
    store-header(platform/memory/acquire(region-size))
  }

  fn init-fixed(region-size: size): *arena {
    let a = init(region-size)
    a.fixed = true
    a
  }

  fn init-default(): *arena {
    init(1 * gb)
  }

  fn _chunk-data-start(chunk: ptr): ptr {
    chunk.add-bytes(types/stride[arena-chunk]).aligned(MIN_ALIGN)
  }

  fn(noinline) _drop-chunks-to(self: *arena, keep: ptr): ptr {
    let dirty-end = self.cur-addr
    let chunk = self.extra-chunks
    while chunk != keep {
      assert(not chunk.is-null())
      let record = chunk.ref[arena-chunk].*
      dirty-end = record.prev-cur
      platform/memory/release(record.region)
      chunk = record.next
    }
    self.extra-chunks = keep
    if keep.is-null() {
      self.base-ptr = self.first-base
      self.end-addr = self.first-end
    } else {
      self.base-ptr = _chunk-data-start(keep)
      self.end-addr = keep.add-bytes(keep.ref[arena-chunk].region.len)
    }
    dirty-end
  }

  fn release(self: *arena) {
    self._drop-chunks-to(ptr/null)
    platform/memory/release(self.first-region())
  }

  fn reset(self: *arena) {
    self.pop-to-mark(.{ start = self.first-base, chunks = ptr/null })
  }

  let MIN_ALIGN: size = types/size[ptr]
  fn(inline) alloc-layout(self: *arena, size: size, align: size): ptr {
    let cursor = self.cur-addr
    let prefix-padding =
      if align > MIN_ALIGN ptr/get-align-offset(cursor.to-size(), align) else 0
    let raw-bump = size + prefix-padding
    if self.end-addr.diff(cursor) >= raw-bump {
      self.cur-addr = cursor.add-bytes(raw-bump + ptr/get-align-offset(raw-bump, MIN_ALIGN))
      cursor.add-bytes(prefix-padding)
    } else {
      self._alloc-in-new-chunk(size, align)
    }
  }

  fn(noinline) _alloc-in-new-chunk(self: *arena, size: size, align: size): ptr {
    if self.fixed crash("fixed arena exhausted")
    let overhead = types/stride[arena-chunk] + MIN_ALIGN + align
    let needed = size + overhead
    let first-len = self.first-end.diff(self.first-base)
    let chunk-len = needed.max(first-len)
    let region = platform/memory/acquire(chunk-len)
    let record: *arena-chunk = region.base.ref[arena-chunk]
    record.* = .{ region, next = self.extra-chunks, prev-cur = self.cur-addr }
    self.extra-chunks = region.base
    self.base-ptr = _chunk-data-start(region.base)
    self.cur-addr = self.base-ptr
    self.end-addr = region.base.add-bytes(region.len)
    self.alloc-layout(size, align)
  }

  fn push[t](self: *arena, t: t): *t {
    let data-start = self.alloc-layout(types/size[t], types/align[t])

    let ref: *t = data-start.ref()
    ref.* = t
    ref
  }

  fn push-span[t](self: *arena, ts: span[t]): buffer[t] {
    let size = ts.buffer.size-bytes()
    let align = types/align[t]
    let base = self.alloc-layout(size, align)
    let buffer: buffer[t] = buffer/wrap-raw[t](base, ts.len())
    buffer/copy(src = ts.buffer, dst = buffer)
    buffer
  }

  fn alloc-buffer[t](self: *arena, size): buffer[t] {
    buffer/allocate-in[t, _](self, size)
  }

  fn push-string(self: *arena, s: string): string {
    let data: buffer[char] = self.push-span(s.span())
    string/wrap-buffer(data)
  }

  fn alloc-list[t](self: *arena, cap: size): list[t] {
    list/with-capacity-in(self, cap)
  }

  fn try-realloc(self: *arena, old-ptr: ptr, old-size: size, new-size: size, align: size): ptr {
    assert(new-size >= old-size)
    let old-end-aligned = old-ptr.add-bytes(old-size).aligned(MIN_ALIGN)
    let new-end-aligned = old-ptr.add-bytes(new-size).aligned(MIN_ALIGN)
    if old-end-aligned == self.cur-addr and new-end-aligned <= self.end-addr {
      self.cur-addr = new-end-aligned
      old-ptr
    } else {
      let new-allocation = self.alloc-layout(new-size, align)
      mem/copy(dst = new-allocation, src = old-ptr, count = old-size)
      new-allocation
    }
  }

  fn mark(self: *arena): arena-mark {
    .{ start = self.cur-addr, chunks = self.extra-chunks }
  }

  fn pop-to-mark(self: *arena, arena-mark) {
    let dirty-end =
      if self.extra-chunks == arena-mark.chunks self.cur-addr
      else self._drop-chunks-to(arena-mark.chunks)
    assert(arena-mark.start >= self.base-ptr)
    assert(arena-mark.start <= dirty-end)
    mem/set(dst = arena-mark.start, value = 0, count = dirty-end.diff(arena-mark.start))
    self.cur-addr = arena-mark.start
  }

}
type arena-mark = { start: ptr, chunks: ptr }

impl allocator for *arena {
  fn(inline) alloc(self: *arena, size: size, align: size): ptr {
    self.alloc-layout(size, align)
  }
  fn realloc(self: *arena, old-ptr: ptr, old-size: size, align: size, new-size: size): ptr {
    self.try-realloc(old-ptr, old-size, new-size, align)
  }
  fn free(_self: *arena, _ptr: ptr, _size: size, _align: size) {}
}
