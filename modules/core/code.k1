type code-span = { start: u32, len: u32, source: u64 }

type code = { text: string, spans: list[code-span] }

type code-token = {
  kind: either(u8) { ident = 0, number = 1, string = 2, char = 3, punct = 4 },
  text: string,
  source: u64,
  spacing: either(u8) { none = 0, inline = 1, newline = 2 },
  parts: span[code-string-part],
}

type code-string-part = either {
  text({ value: string, source: u64 }),
  hole({ tokens: span[code-token], spec: string, source: u64 }),
}

ns for code-token {
  fn fail(self, msg: string): never {
    crash(context .{ filename = "", line = 0, span = self.source })(msg)
  }
}

ns for code {
  fn from-string(s: string): code {
    .{ text = s, spans = list/empty() }
  }
}

type token-cursor = { toks: span[code-token], i: size }

ns for token-cursor {
  fn new(toks: span[code-token]): token-cursor { .{ toks, i = 0 } }

  fn(inline) is-at-end(self: *token-cursor): bool { self.i >= self.toks.len() }

  fn fail-at-end(self: *token-cursor, msg: string): never {
    if self.toks.is-empty() crash(msg)
    self.toks.[self.toks.len() - 1].fail(msg)
  }

  fn(inline) peek(self: *token-cursor): code-token {
    if self.is-at-end() self.fail-at-end("Unexpected end of input")
    self.toks.[self.i]
  }

  fn(inline) peek-2(self: *token-cursor): ?{ fst: code-token, snd: code-token } {
    if self.i + 1 < self.toks.len() :some .{ fst = self.toks.[self.i], snd = self.toks.[self.i + 1] } else :none
  }

  fn(inline) eat(self: *token-cursor): code-token {
    let t = self.peek()
    self.i = self.i + 1
    t
  }

  fn(inline) skip(self: *token-cursor, n: size) { self.i = self.i + n }

  fn(inline) peek-text-eq(self: *token-cursor, text: string): bool {
    (not self.is-at-end()) and self.peek().text == text
  }

  fn(inline) eat-if-text-eq(self: *token-cursor, text: string): bool {
    let hit = self.peek-text-eq(text)
    if hit self.skip(1)
    hit
  }

  fn expect(self: *token-cursor, text: string): code-token {
    if self.is-at-end() self.fail-at-end("Expected `$text` before the end of the input")
    let t = self.eat()
    if t.text != text t.fail("Expected `$text`, got `${t.text}`")
    t
  }

  fn expect-ident(self: *token-cursor): code-token {
    let t = self.eat()
    if not (t.kind is :ident) t.fail("Expected a name, got `${t.text}`")
    t
  }

  fn eat-until-close(self: *token-cursor, open: code-token, close: string): span[code-token] {
    let start = self.i
    let depth: size = 1
    loop {
      if self.is-at-end() open.fail("This `${open.text}` is never closed")
      let t = self.eat()
      if t.text == open.text { depth = depth + 1 }
      else if t.text == close {
        depth = depth - 1
        if depth == 0 break
      }
    }
    self.toks.slice(start, self.i - 1)
  }
}

type code-builder = { text: list[u8], spans: list[code-span], indent-level: size }

ns for code-builder {
  fn new(): code-builder { .0 }

  fn(inline) write-spanned(self: *code-builder, text: string, source: u64) {
    self.spans.push(.{ start = self.text.len.trunc[u32], len = text.len().trunc[u32], source })
    self.write(text)
  }

  fn(inline) write-token(self: *code-builder, tok: code-token) {
    self.write-spanned(tok.text, tok.source)
  }

  fn write-tokens(self: *code-builder, toks: span[code-token]) {
    for tok in toks {
      if it-index > 0 {
        if tok.spacing is {
          :none -> {},
          :inline -> self.write-char(' '),
          :newline -> self.write-char('\n'),
        }
      }
      self.write-token(tok)
    }
  }

  fn write-code(self: *code-builder, c: code) {
    let base = self.text.len.trunc[u32]
    self.write(c.text)
    for s in c.spans {
      self.spans.push(.{ start = base + s.start, len = s.len, source = s.source })
    }
  }

  fn build(self: *code-builder): code {
    .{ text = string/wrap-bytes(self.text.as-span()), spans = self.spans }
  }

  fn indent(self: *code-builder) { self.indent-level = self.indent-level + 1 }
  fn dedent(self: *code-builder) {
    if self.indent-level == 0 crash("code-builder/dedent below zero")
    self.indent-level = self.indent-level - 1
  }
  fn pad(self: *code-builder) { self.repeat("  ", self.indent-level) }

  fn line(self: *code-builder, c: code) {
    self.pad()
    self.write-code(c)
    self.write-char('\n')
  }

  fn block(self: *code-builder, header: code, body: some fn() -> {}) {
    self.block-close(header, "}", body)
  }

  fn block-close(self: *code-builder, header: code, close: string, body: some fn() -> {}) {
    self.pad()
    self.write-code(header)
    self.write(" {\n")
    self.indent()
    body()
    self.dedent()
    self.pad()
    self.write(close)
    self.write-char('\n')
  }

  fn sep[t, iter, i](self: *code-builder, items: i, separator: string, each: some fn t -> {})
    where iter: iterator[item = t], i: iterable[item = t, i = iter] {
    for x in items {
      if it-index > 0 { self.write(separator) }
      each(x)
    }
  }
}

impl writer for *code-builder {
  fn(inline) write-byte(self, b: u8): empty {
    self.text.push(b)
  }
  fn(inline) write-bytes(self, b: span[u8]): empty {
    self.text.append-span(b)
  }
}
