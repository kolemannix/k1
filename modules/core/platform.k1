ns platform {

  //////////////////////////////////
  // The surface: every fn dispatches the same way -- static execution runs on
  // the posix host, otherwise the target platform's impl serves the call

  ns memory {

    type region = { base: ptr, len: size }

    // reserve guarantees address space, not pages: the platform may commit
    // eagerly where its own paging keeps commit lazy (wasm). commit makes
    // [base, base+len) usable; first-committed pages arrive zeroed, and
    // re-committing preserves contents
    fn reserve(min-size: size): region {
      if k1/is-static impls/posix/reserve(min-size)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/reserve(min-size),
        :wasi -> impls/wasi/reserve(min-size),
        :bare -> impls/bare/reserve(min-size)
      }
    }

    fn commit(base: ptr, len: size) {
      if k1/is-static impls/posix/commit(base, len)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/commit(base, len),
        :wasi -> impls/wasi/commit(base, len),
        :bare -> impls/bare/commit(base, len)
      }
    }

    fn release(r: region) {
      if k1/is-static impls/posix/release(r)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/release(r),
        :wasi -> impls/wasi/release(r),
        :bare -> impls/bare/release(r)
      }
    }

    fn acquire(min-size: size): region {
      let r = reserve(min-size)
      commit(r.base, r.len)
      r
    }

  }

  // heap delegates to whoever owns an allocator: libc on posix, the linking
  // consumer on bare; wasi has no one to ask, so it gets the bump heap
  ns heap {
    fn alloc(size: size): ptr {
      if k1/is-static impls/posix/alloc(size)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/alloc(size),
        :wasi -> impls/bump/alloc(size),
        :bare -> impls/bare/alloc(size)
      }
    }
    fn realloc(old-ptr: ptr, new-size: size): ptr {
      if k1/is-static impls/posix/realloc(old-ptr, new-size)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/realloc(old-ptr, new-size),
        :wasi -> impls/bump/realloc(old-ptr, new-size),
        :bare -> impls/bare/realloc(old-ptr, new-size)
      }
    }
    fn free(p: ptr) {
      if k1/is-static impls/posix/free(p)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/free(p),
        :wasi -> impls/bump/free(p),
        :bare -> impls/bare/free(p)
      }
    }
  }

  // Ports speak the scalar convention -- bytes moved or -errno, negative fd
  // on failed open, retryable interruptions absorbed. io-result packs that
  // convention unchanged; its try impl decodes it, and .result() builds the
  // sum for consumers who want to match
  ns io {

    // Opaque handle: i32 covers every current platform's fd; widening the
    // raw field is a private change
    type file-handle = { raw: i32 }

    let STDIN: file-handle = .{ raw = 0 }
    let STDOUT: file-handle = .{ raw = 1 }
    let STDERR: file-handle = .{ raw = 2 }

    // raw >= 0 is bytes moved, raw < 0 is -errno
    type io-result = { raw: i64 }

    impl try[t = size, e = i32] for io-result {
      fn error(e: i32): io-result { .{ raw = e.widen[i64].negated() } }
      fn value(t: size): io-result { .{ raw = t } }
      fn is-ok(self): bool { self.raw >= 0 }
      fn get-error(self): i32 { self.raw.negated().trunc[i32] }
      fn get-value(self): size { self.raw }
    }

    fn write(file: file-handle, data: ptr, count: size): io-result {
      let n =
        if k1/is-static impls/posix/write(file.raw, data, count)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/write(file.raw, data, count),
          :wasi -> impls/wasi/write(file.raw, data, count),
          :bare -> impls/bare/write(file.raw, data, count)
        }
      .{ raw = n }
    }
    // ok(0) with a nonzero count is end-of-file
    fn read(file: file-handle, buffer: ptr, count: size): io-result {
      let n =
        if k1/is-static impls/posix/read(file.raw, buffer, count)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/read(file.raw, buffer, count),
          :wasi -> impls/wasi/read(file.raw, buffer, count),
          :bare -> impls/bare/read(file.raw, buffer, count)
        }
      .{ raw = n }
    }
    fn poll-readable(file: file-handle): bool {
      if k1/is-static impls/posix/poll-readable(file.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/poll-readable(file.raw),
        :wasi -> impls/wasi/poll-readable(file.raw),
        :bare -> crash("poll-readable is not supported on this platform")
      }
    }
    fn is-tty(file: file-handle): bool {
      if k1/is-static impls/posix/is-tty(file.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/is-tty(file.raw),
        :wasi -> impls/wasi/is-tty(file.raw),
        :bare -> impls/bare/is-tty(file.raw)
      }
    }
    fn open-to-read(path: string): result[file-handle, i32] {
      let fd =
        if k1/is-static impls/posix/open-to-read(path)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/open-to-read(path),
          :wasi -> impls/wasi/open-to-read(path),
          :bare -> impls/bare/open-to-read(path)
        }
      if fd < 0 :err(0 - fd) else :ok(.{ raw = fd })
    }
    fn open-to-write(path: string): result[file-handle, i32] {
      let fd =
        if k1/is-static impls/posix/open-to-write(path)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/open-to-write(path),
          :wasi -> impls/wasi/open-to-write(path),
          :bare -> impls/bare/open-to-write(path)
        }
      if fd < 0 :err(0 - fd) else :ok(.{ raw = fd })
    }
    fn close(file: file-handle) {
      if k1/is-static impls/posix/close(file.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/close(file.raw),
        :wasi -> impls/wasi/close(file.raw),
        :bare -> impls/bare/close(file.raw)
      }
    }
    // none when the size is unknowable (a pipe, an unseekable stream)
    fn file-size(file: file-handle): ?size {
      let n =
        if k1/is-static impls/posix/file-size(file.raw)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/file-size(file.raw),
          :wasi -> impls/wasi/file-size(file.raw),
          :bare -> impls/bare/file-size(file.raw)
        }
      if n < 0 :none else :some(n)
    }

    type pipe-ends = { read: file-handle, write: file-handle }

    fn pipe(): ?pipe-ends {
      let fds =
        if k1/is-static impls/posix/pipe()
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/pipe(),
          :wasi or :bare -> crash("pipes are not supported on this platform")
        }
      if fds.read < 0 :none
      else :some(.{ read = .{ raw = fds.read }, write = .{ raw = fds.write } })
    }

    fn is-executable(path: string): bool {
      if k1/is-static impls/posix/is-executable(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/is-executable(path),
        :wasi -> crash("file io is not supported on wasi"),
        :bare -> impls/bare/is-executable(path)
      }
    }

    let ERROR-NOT-FOUND: i32 = 2
    let ERROR-EXISTS: i32 = 17

    fn status(rc: i32): result[empty, i32] {
      if rc < 0 :err(0 - rc) else :ok
    }
    fn make-dir(path: string): result[empty, i32] {
      status(
        if k1/is-static impls/posix/make-dir(path)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/make-dir(path),
          :wasi or :bare -> crash("directories are not supported on this platform")
        }
      )
    }
    fn link(from: string, to: string): result[empty, i32] {
      status(
        if k1/is-static impls/posix/link(from, to)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/link(from, to),
          :wasi or :bare -> crash("links are not supported on this platform")
        }
      )
    }
    fn rename(from: string, to: string): result[empty, i32] {
      status(
        if k1/is-static impls/posix/rename(from, to)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/rename(from, to),
          :wasi or :bare -> crash("rename is not supported on this platform")
        }
      )
    }
    fn remove(path: string): result[empty, i32] {
      status(
        if k1/is-static impls/posix/remove(path)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/remove(path),
          :wasi or :bare -> crash("remove is not supported on this platform")
        }
      )
    }

    fn remove-dir(path: string): result[empty, i32] {
      status(
        if k1/is-static impls/posix/remove-dir(path)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/remove-dir(path),
          :wasi or :bare -> crash("directories are not supported on this platform")
        }
      )
    }

    type dir-handle = { raw: ptr }

    fn dir-open(path: string): result[dir-handle, i32] {
      if k1/is-static impls/posix/dir-open(path)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/dir-open(path),
        :wasi or :bare -> crash("directories are not supported on this platform")
      }
    }
    fn dir-next(dir: dir-handle): ?string {
      if k1/is-static impls/posix/dir-next(dir.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/dir-next(dir.raw),
        :wasi or :bare -> crash("directories are not supported on this platform")
      }
    }
    fn dir-close(dir: dir-handle) {
      if k1/is-static impls/posix/dir-close(dir.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/dir-close(dir.raw),
        :wasi or :bare -> crash("directories are not supported on this platform")
      }
    }
  }

  ns process {
    fn exit(code: i32): never {
      if k1/is-static k1/exit(code)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/exit(code),
        :wasi -> impls/wasi/exit(code),
        :bare -> impls/bare/exit(code)
      }
    }
    fn(builtin("llvm.trap")) trap()
    fn abort(): never {
      if k1/is-static { trap(); k1/exit(134) }
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/abort(),
        :wasi -> impls/wasi/abort(),
        :bare -> impls/bare/abort()
      }
    }

    // signal == 0 means normal exit; killed by a signal means exit-code -1
    type wait-status = { exit-code: i32, signal: i32 }

    // stdin/stdout/stderr replace the child's streams (:none inherits); the
    // child closes them and every handle in extra-close. ok = pid, err = errno
    fn spawn(path: string, argv: span[string], stdin: ?io/file-handle, stdout: ?io/file-handle, stderr: ?io/file-handle, extra-close: span[io/file-handle]): result[i32, i32] {
      if k1/is-static impls/posix/spawn(path, argv, stdin, stdout, stderr, extra-close)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/spawn(path, argv, stdin, stdout, stderr, extra-close),
        :wasi or :bare -> crash("processes are not supported on this platform")
      }
    }
    fn fork(stdin: ?io/file-handle, stdout: ?io/file-handle, stderr: ?io/file-handle, extra-close: span[io/file-handle]): result[i32, i32] {
      if k1/is-static impls/posix/fork(stdin, stdout, stderr, extra-close)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/fork(stdin, stdout, stderr, extra-close),
        :wasi or :bare -> crash("processes are not supported on this platform")
      }
    }
    fn wait(pid: i32): result[wait-status, i32] {
      if k1/is-static impls/posix/wait(pid)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/wait(pid),
        :wasi or :bare -> crash("processes are not supported on this platform")
      }
    }
    fn kill(pid: i32) {
      if k1/is-static impls/posix/kill(pid)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/kill(pid),
        :wasi or :bare -> crash("processes are not supported on this platform")
      }
    }
  }

  ns env {
    fn get(name: string): ?string {
      if k1/is-static impls/posix/env-get(name)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/env-get(name),
        :wasi -> impls/wasi/env-get(name),
        :bare -> impls/bare/env-get(name)
      }
    }
  }

  // Renders the errno-style codes carried by io-result and process errors
  fn error-string(code: i32): string {
    if k1/is-static impls/posix/error-string(code)
    else #if k1/platform is {
      :posix-macos or :posix-linux -> impls/posix/error-string(code),
      :wasi or :bare -> "error ${code}"
    }
  }

  ns dylib {

    type handle = { raw: ptr }

    // Loads private and isolated (posix: RTLD_NOW | RTLD_LOCAL); no flag
    // vocabulary crosses the boundary
    fn open(path: string): ?handle {
      let lib =
        if k1/is-static impls/posix/dylib-open(path)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/dylib-open(path),
          :wasi -> crash("dylibs are not supported on wasi"),
          :bare -> impls/bare/dylib-open(path)
        }
      if lib.is-null() :none else :some(.{ raw = lib })
    }

    // The running program's own symbols
    fn open-self(): handle {
      let lib =
        if k1/is-static impls/posix/dylib-open-self()
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/dylib-open-self(),
          :wasi -> crash("dylibs are not supported on wasi"),
          :bare -> impls/bare/dylib-open-self()
        }
      .{ raw = lib }
    }

    fn sym(lib: handle, name: string): ?ptr {
      let addr =
        if k1/is-static impls/posix/dylib-sym(lib.raw, name)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/dylib-sym(lib.raw, name),
          :wasi -> crash("dylibs are not supported on wasi"),
          :bare -> impls/bare/dylib-sym(lib.raw, name)
        }
      if addr.is-null() :none else :some(addr)
    }

    fn close(lib: handle) {
      if k1/is-static impls/posix/dylib-close(lib.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/dylib-close(lib.raw),
        :wasi -> crash("dylibs are not supported on wasi"),
        :bare -> impls/bare/dylib-close(lib.raw)
      }
    }

    // The message for the most recent failed open or sym, if the platform kept one
    fn error-message(): ?string {
      let e =
        if k1/is-static impls/posix/dylib-error()
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/dylib-error(),
          :wasi -> crash("dylibs are not supported on wasi"),
          :bare -> impls/bare/dylib-error()
        }
      if e.is-null() :none else :some(string/wrap-c(e.get()))
    }
  }

  ns random {
    // Cryptographically secure host entropy
    fn fill(dest: ptr, count: size) {
      if k1/is-static impls/posix/random-fill(dest, count)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/random-fill(dest, count),
        :wasi -> impls/wasi/random-fill(dest, count),
        :bare -> impls/bare/random-fill(dest, count)
      }
    }
  }

  // The raw counter is the cheapest monotonic read the platform has; only
  // counter-to-nanos gives it meaning
  ns clock {
    fn counter(): u64 {
      if k1/is-static impls/posix/counter()
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/counter(),
        :wasi -> impls/wasi/counter(),
        :bare -> impls/bare/clock-nanos()
      }
    }
    fn counter-to-nanos(counter: u64): u64 {
      if k1/is-static impls/posix/counter-to-nanos(counter)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/counter-to-nanos(counter),
        :wasi or :bare -> counter
      }
    }
    fn wall-nanos(): u64 {
      if k1/is-static impls/posix/wall-nanos()
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/wall-nanos(),
        :wasi -> impls/wasi/wall-nanos(),
        :bare -> crash("no wall clock on this platform")
      }
    }
  }

  // No spawn/join arms for wasi or bare: TLS lowers to plain globals there,
  // so running a second thread is unsound by construction. sleep is
  // single-thread-safe and gets real arms everywhere
  ns thread {

    type handle = { raw: ptr }

    fn spawn(function: ptr, input: ptr): ?handle {
      let t =
        if k1/is-static impls/posix/thread-spawn(function, input)
        else #if k1/platform is {
          :posix-macos or :posix-linux -> impls/posix/thread-spawn(function, input),
          :wasi or :bare -> crash("threads are not supported on this platform")
        }
      if t.is-null() :none else :some(.{ raw = t })
    }

    fn join(t: handle): ptr {
      if k1/is-static impls/posix/thread-join(t.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/thread-join(t.raw),
        :wasi or :bare -> crash("threads are not supported on this platform")
      }
    }

    fn detach(t: handle) {
      if k1/is-static impls/posix/thread-detach(t.raw)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/thread-detach(t.raw),
        :wasi or :bare -> crash("threads are not supported on this platform")
      }
    }

    fn sleep-ms(ms: u64) {
      if k1/is-static impls/posix/sleep-ms(ms)
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/sleep-ms(ms),
        :wasi -> impls/wasi/sleep-ms(ms),
        :bare -> impls/bare/sleep-ms(ms)
      }
    }

    fn cpu-count(): size {
      if k1/is-static impls/posix/cpu-count()
      else #if k1/platform is {
        :posix-macos or :posix-linux -> impls/posix/cpu-count(),
        :wasi or :bare -> 1
      }
    }
  }

  //////////////////////////////////
  // The ports: one per platform, each implementing the surface above; only
  // the dispatchers may call them

  ns impls {

    // Heap for platforms without a host allocator: a grow-only bump over
    // memory/acquire with a size header per allocation; free is a no-op and
    // carved chunks are never reused, so acquire's zeroed hand-off makes
    // every allocation zeroed
    ns bump {
      let CHUNK: size = 1048576
      let HEADER: size = 16
      let(mutable) cur: size = 0
      let(mutable) end: size = 0

      fn alloc(size-arg: size): ptr {
        let needed = HEADER + ((size-arg + 15) & 15.bit-not())
        if cur + needed > end {
          let grow-size = needed.max(CHUNK)
          let r = memory/acquire(grow-size)
          cur = r.base.to-size()
          end = cur + r.len
        }
        let base = cur
        base.to-ptr().ref[size].* = size-arg
        cur = base + needed
        (base + HEADER).to-ptr()
      }

      fn realloc(old-ptr: ptr, new-size: size): ptr {
        let old-size = old-ptr.sub-bytes(HEADER).ref[size].*
        if new-size <= old-size return old-ptr
        let new-ptr = alloc(new-size)
        mem/copy(dst = new-ptr, src = old-ptr, count = old-size)
        new-ptr
      }

      fn free(_p: ptr) { }
    }

    ns posix {

      ns c {
        let PROT_NONE: c-int = 0x0
        let PROT_READ: c-int = 0x1
        let PROT_WRITE: c-int = 0x2
        let MAP_PRIVATE: c-int = 0x0002
        let MAP_FAILED: i64 = -1
        fn(extern("mmap")) mmap(addr: ptr, len: size, prot: i32, flags: c-int, fd: c-int, offset: size): ptr
        fn(extern("munmap")) munmap(addr: ptr, len: size): i32
        fn(extern("mprotect")) mprotect(addr: ptr, len: size, prot: c-int): i32
        fn(extern("getpagesize")) getpagesize(): c-int

        fn(extern("calloc")) calloc(count: int, size: size): ptr
        fn(extern("realloc")) realloc(ptr: ptr, size: size): ptr
        fn(extern("free")) free(ptr: ptr)

        let O_RDONLY: c-int = 0x0000
        let SEEK_SET: c-int = 0
        let SEEK_END: c-int = 2
        let CREATE_MODE_RW_ALL: c-int = 0x1B6
        fn(extern("open")) open(path: *u8, oflag: c-int): c-int
        fn(extern("creat")) creat(path: *u8, mode: c-int): c-int
        fn(extern("read")) read(file-no: c-int, buffer: ptr, count: c-sizet): i64
        fn(extern("write")) write(file-no: c-int, data: ptr, count: c-sizet): i64
        fn(extern("close")) close(fd: c-int): c-int
        fn(extern("mkdir")) mkdir(path: *u8, mode: c-int): c-int
        fn(extern("link")) link(from: *u8, to: *u8): c-int
        fn(extern("rename")) rename(from: *u8, to: *u8): c-int
        fn(extern("unlink")) unlink(path: *u8): c-int
        fn(extern("rmdir")) rmdir(path: *u8): c-int
        fn(extern("opendir")) opendir(path: *u8): ptr
        fn(extern("readdir")) readdir(dir: ptr): ptr
        fn(extern("closedir")) closedir(dir: ptr): c-int
        fn(extern("lseek")) lseek(fd: c-int, offset: i64, whence: c-int): i64
        fn(extern("isatty")) isatty(fd: c-int): c-int
        type pollfd = { fd: c-int, events: i16, revents: i16 }
        let POLLIN: i16 = 1
        fn(extern("poll")) poll(fds: ptr, nfds: u64, timeout: c-int): c-int

        let EINTR: c-int = 4

        fn(extern("exit")) exit(code: i32): never
        fn(extern("abort")) abort(): never
        fn(extern("getenv")) getenv(name: *u8): optref[u8]
        fn(extern("strerror")) strerror(code: c-int): *u8

        let RTLD_NOW: c-int = 0x2
        fn(extern("dlopen")) dlopen(path: optref[u8], mode: c-int): ptr
        fn(extern("dlsym")) dlsym(handle: ptr, symbol: *u8): ptr
        fn(extern("dlclose")) dlclose(handle: ptr): c-int
        fn(extern("dlerror")) dlerror(): optref[u8]

        fn(extern("getentropy")) getentropy(buf: ptr, count: c-sizet): c-int

        type timespec = { tv_sec: u64, tv_nsec: u64 }
        fn(extern("clock_gettime")) clock_gettime(clockid: u32, tp: *timespec): c-int
        fn(extern("nanosleep")) nanosleep(req: *timespec, rem: ptr): c-int
        type mach-timebase = { numer: u32, denom: u32 }
        fn(extern("mach_absolute_time")) mach_absolute_time(): u64
        fn(extern("mach_timebase_info")) mach_timebase_info(timebase: *mach-timebase): u64

        fn(extern("pthread_create")) pthread_create(thread: ptr, attrs: ptr, start_routine: ptr, input: ptr): i32
        fn(extern("pthread_join")) pthread_join(thread: ptr, retval: ptr): i32
        fn(extern("pthread_detach")) pthread_detach(thread: ptr): i32
        fn(extern("sysconf")) sysconf(name: c-int): i64

        let X_OK: c-int = 1
        fn(extern("access")) access(path: *u8, mode: c-int): c-int
        fn(extern("pipe")) pipe(fds: ptr): c-int
        fn(extern("fork")) fork(): i32
        fn(extern("dup2")) dup2(fd: c-int, fd2: c-int): c-int
        let SIGKILL: c-int = 9
        fn(extern("kill")) kill(pid: i32, sig: c-int): c-int
        fn(extern("waitpid")) waitpid(pid: i32, status: *i32, options: i32): i32
        fn(extern("posix_spawn")) posix_spawn(pid: *i32, path: *u8, file-actions: ptr, attrp: ptr, argv: ptr, envp: ptr): c-int
        fn(extern("posix_spawn_file_actions_init")) spawn-fa-init(file-actions: ptr): c-int
        fn(extern("posix_spawn_file_actions_destroy")) spawn-fa-destroy(file-actions: ptr): c-int
        fn(extern("posix_spawn_file_actions_adddup2")) spawn-fa-adddup2(file-actions: ptr, fd: c-int, new-fd: c-int): c-int
        fn(extern("posix_spawn_file_actions_addclose")) spawn-fa-addclose(file-actions: ptr, fd: c-int): c-int
        fn(extern("_NSGetEnviron")) ns-get-environ(): ptr
        let(extern) environ: ptr

        // errno is a libc thread-local reached through its address fn; there is
        // no plain symbol to bind
        fn(extern("__error")) errno-location-macos(): ptr
        fn(extern("__errno_location")) errno-location-linux(): ptr
      }

      fn errno-now(): c-int {
        k1/select-os(macos = fn. c/errno-location-macos(), linux = fn. c/errno-location-linux()).ref[c-int].*
      }

      fn reserve(min-size: size): memory/region {
        let map-anon: c-int = k1/select-os(macos = fn. 0x1000, linux = fn. 0x20)
        let private-anon = c/MAP_PRIVATE | map-anon
        let addr = c/mmap(
          addr = ptr/null,
          len = min-size,
          prot = c/PROT_NONE,
          flags = private-anon,
          fd = -1i32,
          offset = 0
        )
        if addr.to-int() == c/MAP_FAILED {
          crash("mmap failed")
        }
        .{ base = addr, len = min-size }
      }

      fn commit(base: ptr, len: size) {
        let page = c/getpagesize().as-size()
        let start = base.to-size() / page * page
        let end = (base.to-size() + len + page - 1) / page * page
        if c/mprotect(start.to-ptr(), end - start, c/PROT_READ | c/PROT_WRITE) != 0 {
          crash("mprotect failed")
        }
      }

      fn release(r: memory/region) {
        let result = c/munmap(r.base, r.len)
        if result == -1 crash("munmap of region at ${r.base} x ${r.len} failed")
      }

      fn alloc(size: size): ptr { c/calloc(1, size) }
      fn realloc(old-ptr: ptr, new-size: size): ptr { c/realloc(old-ptr, new-size) }
      fn free(p: ptr) { c/free(p) }

      fn write(file-no: i32, data: ptr, count: size): i64 {
        let n = c/write(file-no, data, count.unsigned())
        while n < 0 and errno-now() == c/EINTR {
          n = c/write(file-no, data, count.unsigned())
        }
        if n < 0 { 0 - errno-now().widen[i64] } else n
      }
      fn read(file-no: i32, buffer: ptr, count: size): i64 {
        let n = c/read(file-no, buffer, count.unsigned())
        while n < 0 and errno-now() == c/EINTR {
          n = c/read(file-no, buffer, count.unsigned())
        }
        if n < 0 { 0 - errno-now().widen[i64] } else n
      }
      fn is-tty(file-no: i32): bool { c/isatty(file-no) == 1 }
      fn poll-readable(file-no: i32): bool {
        let p: c/pollfd = .{ fd = file-no, events = c/POLLIN, revents = 0 }
        let n = c/poll(p.&.as[ptr], 1, 0)
        while n < 0 and errno-now() == c/EINTR {
          n = c/poll(p.&.as[ptr], 1, 0)
        }
        n > 0
      }
      fn or-errno(rc: c-int): i32 { if rc < 0 { 0 - errno-now() } else rc }
      fn open-to-read(path: string): i32 { or-errno(c/open(path.to-c-tmp(), c/O_RDONLY)) }
      // open(2) is variadic, which a fixed 3-arg extern miscompiles on
      // arm64-darwin; creat(2) is a real 2-arg fn equal to
      // O_WRONLY|O_CREAT|O_TRUNC
      fn open-to-write(path: string): i32 { or-errno(c/creat(path.to-c-tmp(), c/CREATE_MODE_RW_ALL)) }
      fn close(fd: i32) { let _ = c/close(fd) }
      fn make-dir(path: string): i32 { or-errno(c/mkdir(path.to-c-tmp(), 0o755)) }
      fn link(from: string, to: string): i32 { or-errno(c/link(from.to-c-tmp(), to.to-c-tmp())) }
      fn rename(from: string, to: string): i32 { or-errno(c/rename(from.to-c-tmp(), to.to-c-tmp())) }
      fn remove(path: string): i32 { or-errno(c/unlink(path.to-c-tmp())) }
      fn remove-dir(path: string): i32 { or-errno(c/rmdir(path.to-c-tmp())) }
      fn dir-open(path: string): result[io/dir-handle, i32] {
        let dir = c/opendir(path.to-c-tmp())
        if dir.is-null() :err(errno-now()) else :ok(.{ raw = dir })
      }
      fn dir-next(dir: ptr): ?string {
        let entry = c/readdir(dir)
        let name-offset: size = k1/select-os(macos = fn. 21, linux = fn. 19)
        if entry.is-null() :none else :some(string/wrap-c(entry.add-bytes(name-offset).ref[u8]))
      }
      fn dir-close(dir: ptr) { let _ = c/closedir(dir) }
      fn file-size(fd: i32): i64 {
        let end = c/lseek(fd, 0, c/SEEK_END)
        c/lseek(fd, 0, c/SEEK_SET)
        end
      }
      fn exit(code: i32): never { c/exit(code) }
      fn abort(): never { c/abort() }

      fn env-get(name: string): ?string {
        let v = c/getenv(name.to-c-tmp())
        if v.is-null() :none else :some(string/wrap-c(v.get()))
      }

      fn error-string(code: i32): string { string/wrap-c(c/strerror(code)) }

      fn dylib-open(path: string): ptr {
        let rtld-local: c-int = k1/select-os(macos = fn. 0x4, linux = fn. 0)
        c/dlopen(optref/make(path.to-c-tmp()), c/RTLD_NOW | rtld-local)
      }
      fn dylib-open-self(): ptr { c/dlopen(.0, c/RTLD_NOW) }
      fn dylib-sym(lib: ptr, name: string): ptr { c/dlsym(lib, name.to-c-tmp()) }
      fn dylib-close(lib: ptr) { let _ = c/dlclose(lib) }
      fn dylib-error(): optref[u8] { c/dlerror() }

      // getentropy caps each call at 256 bytes
      fn random-fill(dest: ptr, count: size) {
        let done: size = 0
        while done < count {
          let n = if count - done > 256 256 else count - done
          if c/getentropy(dest.add-bytes(done), n.unsigned()) != 0 crash("getentropy failed")
          done = done + n
        }
      }

      let(mutable) timebase: c/mach-timebase = .{ numer = 0, denom = 0 }

      fn mach-counter-to-nanos(counter: u64): u64 {
        if timebase.denom == 0 { c/mach_timebase_info(timebase.&) }
        counter * timebase.numer.widen[u64] / timebase.denom.widen[u64]
      }

      fn(inline) monotonic-nanos(): u64 {
        let monotonic: u32 = 1
        get-time(clockid = monotonic)
      }

      fn(inline) wall-nanos(): u64 {
        let realtime: u32 = 0
        get-time(clockid = realtime)
      }

      fn get-time(clockid: u32): u64 {
        let ts: c/timespec = .0
        c/clock_gettime(clockid, ts.&)
        ts.tv_sec * 1_000_000_000 + ts.tv_nsec
      }

      fn counter(): u64 {
        k1/select-os(macos = fn. c/mach_absolute_time(), linux = fn. monotonic-nanos())
      }

      fn counter-to-nanos(counter: u64): u64 {
        k1/select-os(macos = fn[counter]. mach-counter-to-nanos(counter), linux = fn[counter]. counter)
      }

      fn thread-spawn(function: ptr, input: ptr): ptr {
        if k1/is-static crash("threads are not supported in static execution")
        let handle: ptr = ptr/null
        if c/pthread_create(handle.&.as[ptr], ptr/null, function, input) != 0 return ptr/null
        handle
      }
      fn thread-join(t: ptr): ptr {
        let out: ptr = ptr/null
        if c/pthread_join(t, out.&.as[ptr]) != 0 crash("pthread_join failed")
        out
      }
      fn thread-detach(t: ptr) {
        if c/pthread_detach(t) != 0 crash("pthread_detach failed")
      }
      fn sleep-ms(ms: u64) {
        let req: c/timespec = .{ tv_sec = ms / 1000, tv_nsec = (ms % 1000) * 1000000 }
        let _ = c/nanosleep(req.&, ptr/null)
      }
      fn cpu-count(): size {
        let sc-nprocessors-onln: c-int = k1/select-os(macos = fn. 58, linux = fn. 84)
        c/sysconf(sc-nprocessors-onln).max(1)
      }

      fn pipe(): { read: i32, write: i32 } {
        let fds = array/zeroed[i32, 2]()
        if c/pipe(fds.&.as[ptr]) != 0 return .{ read = -1, write = -1 }
        .{ read = fds.[0], write = fds.[1] }
      }

      fn is-executable(path: string): bool {
        c/access(path.to-c-tmp(), c/X_OK) == 0
      }

      fn environ-ptr(): ptr {
        k1/select-os(macos = fn. c/ns-get-environ().ref[ptr].*, linux = fn. c/environ)
      }

      fn child-closes(stdin: ?io/file-handle, stdout: ?io/file-handle, stderr: ?io/file-handle, extra-close: span[io/file-handle]): list[i32] {
        let fds = list/with-capacity[i32](extra-close.len() + 3)
        for [stdin, stdout, stderr] {
          if it is :some h and h.raw > 2 and not fds.as-span().contains(h.raw) { fds.push(h.raw) }
        }
        for extra-close {
          if it.raw > 2 and not fds.as-span().contains(it.raw) { fds.push(it.raw) }
        }
        fds
      }

      fn spawn(path: string, argv: span[string], stdin: ?io/file-handle, stdout: ?io/file-handle, stderr: ?io/file-handle, extra-close: span[io/file-handle]): result[i32, i32] {
        // argv for exec-family calls: strings, then a null terminator, all in tmp
        mem/push-arena(mem/tmp())
        let cargv = list/with-capacity[ptr](argv.len() + 1)
        for a in argv { cargv.push(a.to-c().as[ptr]) }
        cargv.push(ptr/null)
        mem/pop-arena()

        // posix_spawn_file_actions_t is opaque: 8 bytes on darwin, 80 on glibc
        let fa-buf = array/zeroed[u8, 128]()
        let fa = fa-buf.&.as[ptr]
        c/spawn-fa-init(fa)
        defer { c/spawn-fa-destroy(fa) }

        if stdin is :some h { c/spawn-fa-adddup2(fa, h.raw, 0) }
        if stdout is :some h { c/spawn-fa-adddup2(fa, h.raw, 1) }
        if stderr is :some h { c/spawn-fa-adddup2(fa, h.raw, 2) }
        for child-closes(stdin, stdout, stderr, extra-close) { c/spawn-fa-addclose(fa, it) }

        let pid: i32 = 0
        let rc = c/posix_spawn(pid.&, path.to-c-tmp(), fa, ptr/null, cargv.data-ptr(), environ-ptr())
        if rc != 0 :err rc else :ok pid
      }

      fn fork(stdin: ?io/file-handle, stdout: ?io/file-handle, stderr: ?io/file-handle, extra-close: span[io/file-handle]): result[i32, i32] {
        if k1/is-static crash("fork is not supported in static execution")
        let closes = child-closes(stdin, stdout, stderr, extra-close)
        let pid = c/fork()
        if pid < 0 return :err errno-now()
        if pid > 0 return :ok pid
        if stdin is :some h { c/dup2(h.raw, 0) }
        if stdout is :some h { c/dup2(h.raw, 1) }
        if stderr is :some h { c/dup2(h.raw, 2) }
        for closes { close(it) }
        :ok 0
      }

      fn wait(pid: i32): result[process/wait-status, i32] {
        let status: i32 = 0
        let rc = c/waitpid(pid, status.&, 0)
        while rc < 0 and errno-now() == c/EINTR {
          rc = c/waitpid(pid, status.&, 0)
        }
        if rc < 0 return :err errno-now()
        if status.bit-and(0x7f) == 0 {
          :ok .{ exit-code = status.shift-right(8).bit-and(0xff), signal = 0 }
        } else {
          :ok .{ exit-code = -1, signal = status.bit-and(0x7f) }
        }
      }

      fn kill(pid: i32) { let _ = c/kill(pid, c/SIGKILL) }
    }

    // WASI preview1; a wasm32 ABI even under memory64, so pointers cross as u32
    ns wasi {
      fn(extern("proc_exit"), lib("wasi_snapshot_preview1")) proc-exit(code: i32): never
      fn(extern("fd_write"), lib("wasi_snapshot_preview1")) fd-write(fd: i32, iovs: u32, iovs-len: u32, nwritten: u32): i32
      fn(extern("fd_read"), lib("wasi_snapshot_preview1")) fd-read(fd: i32, iovs: u32, iovs-len: u32, nread: u32): i32
      fn(extern("fd_fdstat_get"), lib("wasi_snapshot_preview1")) fd-fdstat-get(fd: i32, stat: u32): i32
      fn(extern("environ_sizes_get"), lib("wasi_snapshot_preview1")) environ-sizes-get(count: u32, buf-size: u32): i32
      fn(extern("environ_get"), lib("wasi_snapshot_preview1")) environ-get(environ: u32, buf: u32): i32
      fn(extern("clock_time_get"), lib("wasi_snapshot_preview1")) clock-time-get(id: u32, precision: u64, time: u32): i32
      fn(extern("random_get"), lib("wasi_snapshot_preview1")) random-get(buf: u32, buf-len: u32): i32
      fn(extern("poll_oneoff"), lib("wasi_snapshot_preview1")) poll-oneoff(subs: u32, events: u32, nsubscriptions: u32, nevents: u32): i32

      let FILETYPE_CHARACTER_DEVICE: u8 = 2
      let EINTR: i32 = 27

      type iovec = { buf: u32, len: u32 }

      fn a32(ptr): u32 {
        ptr.to-size().trunc[u32]
      }

      let PAGE-SIZE: size = 65536

      fn(builtin("llvm.wasm.memory.grow.i64")) memory-grow(mem: i32, delta-pages: i64): i64

      // memory.grow can never shrink, so released regions form an intrusive
      // free list in their own first bytes: next at offset 0, len at offset 8
      let(mutable) freelist: ptr = ptr/null

      fn grow-fresh(min-size: size): memory/region {
        let pages = (min-size + PAGE-SIZE - 1) / PAGE-SIZE
        let prev-pages = memory-grow(0, pages)
        if prev-pages == -1 crash("wasm memory.grow failed")
        .{ base = (prev-pages * PAGE-SIZE).to-ptr(), len = pages * PAGE-SIZE }
      }

      // Like mmap, the page-granular rounding is invisible: callers see
      // exactly the min-size they asked for. Reserve commits eagerly (grow is
      // wasm's only way to get address space) and pre-zeroes freelist reuse,
      // so the no-op commit still hands over zeroed pages
      fn reserve(min-size: size): memory/region {
        let prev = ptr/null
        let cur = freelist
        while not cur.is-null() {
          let next = cur.ref[ptr].*
          let len = cur.add-bytes(8).ref[size].*
          if len >= min-size {
            if prev.is-null() {
              freelist = next
            } else {
              prev.ref[ptr].* = next
            }
            mem/set(dst = cur, value = 0, count = len)
            return .{ base = cur, len = min-size }
          }
          prev = cur
          cur = next
        }
        .{ base = grow-fresh(min-size).base, len = min-size }
      }

      fn commit(base: ptr, len: size) {
        let _ = base
        let _ = len
      }

      fn release(r: memory/region) {
        r.base.ref[ptr].* = freelist
        r.base.add-bytes(8).ref[size].* = r.len
        freelist = r.base
      }

      fn write(file-no: i32, data: ptr, count: size): i64 {
        let iov: iovec = .{ buf = a32(data), len = count.trunc[u32] }
        let nwritten: u32 = 0
        let err = fd-write(file-no, a32(iov.&.as[ptr]), 1, a32(nwritten.&.as[ptr]))
        while err == EINTR {
          err = fd-write(file-no, a32(iov.&.as[ptr]), 1, a32(nwritten.&.as[ptr]))
        }
        if err != 0 { 0 - err.widen[i64] } else nwritten.widen[i64]
      }

      fn read(file-no: i32, buffer: ptr, count: size): i64 {
        let iov: iovec = .{ buf = a32(buffer), len = count.trunc[u32] }
        let nread: u32 = 0
        let err = fd-read(file-no, a32(iov.&.as[ptr]), 1, a32(nread.&.as[ptr]))
        while err == EINTR {
          err = fd-read(file-no, a32(iov.&.as[ptr]), 1, a32(nread.&.as[ptr]))
        }
        if err != 0 { 0 - err.widen[i64] } else nread.widen[i64]
      }

      fn is-tty(file-no: i32): bool {
        let stat = array/zeroed[u8, 24]()
        if fd-fdstat-get(file-no, a32(stat.&.as[ptr])) != 0 return false
        stat.&.as[ptr].ref[u8].* == FILETYPE_CHARACTER_DEVICE
      }

      type fd-read-subscription = {
        userdata: u64,
        tag: u64,
        fd: u32,
        pad0: u32,
        pad1: u64,
        pad2: u64,
        pad3: u64,
      }
      let EVENTTYPE_FD_READ: u8 = 1

      fn poll-readable(file-no: i32): bool {
        let subs: array[fd-read-subscription, 2] = .0
        subs.[0] = .{ userdata = 1, tag = EVENTTYPE_FD_READ.widen[u64], fd = file-no.unsigned(), pad0 = 0, pad1 = 0, pad2 = 0, pad3 = 0 }
        let clock: *clock-subscription = subs.[1].&.as[ptr].ref[clock-subscription]
        clock.* = .{ userdata = 0, tag = 0, id = 1, timeout = 0, precision = 0, flags = 0 }
        let events: array[poll-event, 2] = .0
        let nevents: u32 = 0
        if poll-oneoff(a32(subs.&.as[ptr]), a32(events.&.as[ptr]), 2, a32(nevents.&.as[ptr])) != 0 return false
        for i in 0u32.until(nevents) {
          if events.[i].tag == EVENTTYPE_FD_READ and events.[i].error == 0 return true
        }
        false
      }

      fn open-to-read(path: string): i32 { let _ = path; crash("file io is not supported on wasi") }
      fn open-to-write(path: string): i32 { let _ = path; crash("file io is not supported on wasi") }
      fn close(fd: i32) { let _ = fd; crash("file io is not supported on wasi") }
      fn file-size(fd: i32): i64 { let _ = fd; crash("file io is not supported on wasi") }

      fn exit(code: i32): never { proc-exit(code) }
      // proc_exit rejects codes outside [0..126)
      fn abort(): never { proc-exit(101) }

      fn counter(): u64 {
        let monotonic: u32 = 1
        let t: u64 = 0
        if clock-time-get(monotonic, 1, a32(t.&.as[ptr])) != 0 crash("wasi clock_time_get failed")
        t
      }

      fn wall-nanos(): u64 {
        let realtime: u32 = 0
        let t: u64 = 0
        if clock-time-get(realtime, 1, a32(t.&.as[ptr])) != 0 crash("wasi clock_time_get failed")
        t
      }

      fn random-fill(dest: ptr, count: size) {
        if random-get(a32(dest), count.trunc[u32]) != 0 crash("wasi random_get failed")
      }

      // The subscription tag is one byte at offset 8 padded to 16; carried as
      // a u64 so natural layout lands every clock field at its ABI offset
      type clock-subscription = {
        userdata: u64,
        tag: u64,
        id: u32,
        timeout: u64,
        precision: u64,
        flags: u16,
      }
      type poll-event = { userdata: u64, error: u16, tag: u8, nbytes: u64, flags: u16 }

      // wasi has no sleep call: poll_oneoff on one relative (flags = 0)
      // monotonic-clock subscription
      fn sleep-ms(ms: u64) {
        let sub: clock-subscription = .{
          userdata = 0,
          tag = 0,
          id = 1,
          timeout = ms * 1000000,
          precision = 0,
          flags = 0,
        }
        let event = poll-event.0
        let nevents: u32 = 0
        let _ = poll-oneoff(a32(sub.&.as[ptr]), a32(event.&.as[ptr]), 1, a32(nevents.&.as[ptr]))
      }

      fn env-get(name: string): ?string {
        let count: u32 = 0
        let buf-size: u32 = 0
        if environ-sizes-get(a32(count.&.as[ptr]), a32(buf-size.&.as[ptr])) != 0 return :none
        if count == 0 return :none
        let entry-ptrs = mem/alloc-layout(count.as-size() * 4, 4)
        let entry-bytes = mem/alloc-layout(buf-size.as-size(), 1)
        if environ-get(a32(entry-ptrs), a32(entry-bytes)) != 0 return :none
        for i in 0.until(count.as-size()) {
          let entry-addr = entry-ptrs.add-bytes(i * 4).ref[u32].*
          let entry = string/wrap-c(entry-addr.as-size().to-ptr().ref[u8])
          if entry.starts-with(name) and entry.drop(name.len()).starts-with("=") {
            return :some(entry.drop(name.len() + 1))
          }
        }
        :none
      }
    }

    // The bare platform is an extern contract: whoever links the emitted
    // object provides the k1_platform_* symbols their program actually
    // references, and unreferenced externs never emit. Committed memory and
    // alloc results are zeroed; a provider whose reserve is already lazy
    // (overcommit) makes commit a no-op; write/read return bytes moved or a
    // negative error code, and the provider absorbs its own retryable
    // interruptions; abort demands no symbol at all
    ns bare {
      fn(extern("k1_platform_mem_reserve")) reserve-bytes(min-size: size): ptr
      fn(extern("k1_platform_mem_commit")) commit(base: ptr, len: size)
      fn(extern("k1_platform_mem_release")) release-bytes(base: ptr, len: size)
      fn(extern("k1_platform_heap_alloc")) alloc(size: size): ptr
      fn(extern("k1_platform_heap_realloc")) realloc(old-ptr: ptr, new-size: size): ptr
      fn(extern("k1_platform_heap_free")) free(p: ptr)
      fn(extern("k1_platform_io_write")) write(file-no: i32, data: ptr, count: size): i64
      fn(extern("k1_platform_io_read")) read(file-no: i32, buffer: ptr, count: size): i64
      fn(extern("k1_platform_io_is_tty")) is-tty-flag(file-no: i32): i32
      fn(extern("k1_platform_file_open_read")) open-read-c(path: *u8): i32
      fn(extern("k1_platform_file_open_write")) open-write-c(path: *u8): i32
      fn(extern("k1_platform_file_close")) close-fd(fd: i32)
      fn(extern("k1_platform_file_size")) file-size(fd: i32): i64
      fn(extern("k1_platform_process_exit")) exit(code: i32): never
      fn(extern("k1_platform_env_get")) getenv(name: *u8): optref[u8]
      fn(extern("k1_platform_dylib_open")) dylib-open-c(path: *u8): ptr
      fn(extern("k1_platform_dylib_open_self")) dylib-open-self(): ptr
      fn(extern("k1_platform_dylib_sym")) dylib-sym-c(lib: ptr, name: *u8): ptr
      fn(extern("k1_platform_dylib_close")) dylib-close(lib: ptr)
      fn(extern("k1_platform_dylib_error")) dylib-error(): optref[u8]
      fn(extern("k1_platform_random_fill")) random-fill(dest: ptr, count: size)
      fn(extern("k1_platform_clock_nanos")) clock-nanos(): u64
      fn(extern("k1_platform_thread_sleep_ms")) sleep-ms(ms: u64)
      fn(extern("k1_platform_file_is_executable")) is-executable-flag(path: *u8): i32

      fn reserve(min-size: size): memory/region {
        .{ base = reserve-bytes(min-size), len = min-size }
      }
      fn release(r: memory/region) { release-bytes(r.base, r.len) }
      fn is-tty(file-no: i32): bool { is-tty-flag(file-no) == 1 }
      fn open-to-read(path: string): i32 { open-read-c(path.to-c-tmp()) }
      fn open-to-write(path: string): i32 { open-write-c(path.to-c-tmp()) }
      fn close(fd: i32) { close-fd(fd) }
      fn is-executable(path: string): bool { is-executable-flag(path.to-c-tmp()) == 1 }
      fn dylib-open(path: string): ptr { dylib-open-c(path.to-c-tmp()) }
      fn dylib-sym(lib: ptr, name: string): ptr { dylib-sym-c(lib, name.to-c-tmp()) }
      fn abort(): never { process/trap(); k1/exit(134) }
      fn env-get(name: string): ?string {
        let v = getenv(name.to-c-tmp())
        if v.is-null() :none else :some(string/wrap-c(v.get()))
      }
    }
  }
}
