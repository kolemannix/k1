ability scalar-cmp {
  fn lt(self, other: self): bool
  fn le(self, other: self): bool
  fn gt(self, other: self): bool
  fn ge(self, other: self): bool
  fn(inline) min(self, other: self): self { if self.lt(other) self else other }
  fn(inline) max(self, other: self): self { if self.gt(other) self else other }
}

impl scalar-cmp for u8 {
  fn(builtin) lt(self, other: self): bool
  fn(builtin) le(self, other: self): bool
  fn(builtin) gt(self, other: self): bool
  fn(builtin) ge(self, other: self): bool
}
