///////////
// Types //
type u8          = builtin
type u16         = builtin
type u32         = builtin
type u64         = builtin
type(alias) usize = u64
type(alias) uint  = u64
type i8          = builtin
type i16         = builtin
type i32         = builtin
type i64         = builtin
type(alias) int   = i64
type(alias) size  = i64

type char    = builtin
type bool    = builtin

/// An uninhabited type representing that code with this type never returns
/// Used to signal termination and enables basic control flow analysis
type never   = builtin

type ptr = builtin

type f32 = builtin
type f64 = builtin


type buffer[t] = { data: ptr, len: size }

type span[t] = { buffer: buffer[t] }

type list[t] = { buffer: buffer[t], len: size }
type string = { span: span[char] }

type opt[t] = either { none, some(t) }


type(alias) c-sizet  = u64
type(alias) c-ssizet = i64
type(alias) c-int    = i32
type(alias) c-long   = i64

type ordering = either(i8) { less = -1, equal = 0, greater = 1 }

type result[t, e] = either { ok(t), err(e) }

type(alias) empty = {}

type(alias) byte = u8

ns types {

  type type-id = { inner: u64 }
  type instance-info = { parent: type-id, args: span[type-id] }
  type layout = { size: size, align: size }
  type type-info = {
    name: string,
    schema: type-schema,
    instance: ?instance-info,
    layout: layout,
    zero-safe: bool,
  }
  type impl-kind = either { direct, blanket, compiler }
  type impl-info = { kind: impl-kind, args: span[{ name: string, type-id }] }
  ns for type-id {
    fn(builtin) info(self: type-id): type-info
    fn(builtin) impl-of(self: type-id, ability-id: u32, impl-args: span[type-id]): ?impl-info
    fn name(self: type-id): string { self.info().name }
    fn schema(self: type-id): type-schema { self.info().schema }
    fn instance-info(self: type-id): ?instance-info { self.info().instance }
    fn size(self: type-id): size { self.info().layout.size }
    fn stride(self: type-id): size {
      let layout = self.info().layout
      layout.size + ptr/get-align-offset(layout.size, layout.align)
    }
    fn align(self: type-id): size { self.info().layout.align }
    fn(inline) is-instance-of(self: type-id, parent: type-id): bool {
      self.instance-info() is :some info and info.parent == parent
    }
    fn(inline) instance-of[parent](self: type-id): bool {
      self.is-instance-of(id[parent])
    }
    fn(inline) elem-of[parent](self: type-id): ?type-id {
      require self.instance-info() is :some info and info.parent == id[parent] else return :none
      :some info.args.[0]
    }
    fn(inline) make(inner: u64): type-id { .{ inner } }
    fn spell(self: type-id): string {
      `(#type type-id/make(${self.inner}))`
    }
  }

  // Magically implemented for all enums
  // enum must have ability id 1
  ability enum[impl v] {
    fn(builtin) enum-value(self): v
    fn(builtin) enum-name(self): string
    fn(builtin) enum-from-value(value: v): ?self
    fn(builtin) enum-from-value-unchecked(value: v): self

    fn members(): span[self] {
      #static {
        require types/schema[self] is :enum .{ values } else crash("members: not an enum")
        let out: list[self] = list/with-capacity(values.len())
        for m in values { out.push(enum-from-value-unchecked(m.value.to[v])) }
        out.as-span()
      }
    }
  }

  ability sum[impl v] {
    fn(builtin) sum-tag(self): v
    fn(builtin) sum-name(self): string
  }

  // This implements equals for all enums, in userspace B-)
  // We do it more efficiently, with a builtin, so as not to pollute the blanket impl search space
  // but still a good flex
  // impl[i: equals, e: types/enum[v = i]] equals for e {
  //   fn equals(self: e, other: e): bool { self.enum-value() == other.enum-value() }
  // }

  // The size, in bytes, of type t. Unlike c's sizeof, does not include end padding
  fn(builtin) size[t](): size
  // The stride, in bytes, of type t. includes end padding
  fn(builtin) stride[t](): size

  // The alignment, in bytes, of type t. Always a power of two
  fn(builtin) align[t](): int

  fn(builtin) id[t](): type-id

  fn type-id-of-val[t](_t: t): type-id { id[t] }
  fn name[t](): string { id[t].info().name }

  fn type-name-of-val[t](_t: t): string { name[t] }
  fn schema[t](): type-schema { id[t].info().schema }
  fn instance-info[t](): ?instance-info { id[t].info().instance }
  fn is-zero-safe[t](): bool { id[t].info().zero-safe }

  // FIXME: We should encode both width and signedness into the bits instead, 'flags in tags' project
  type int-value = either {
    u8(u8) = 0, u16(u16) = 1, u32(u32) = 2, u64(u64) = 3,
    i8(i8) = 4, i16(i16) = 5, i32(i32) = 6, i64(i64) = 7
  }

  type int-kind = int-value.tag-enum
  ns for int-kind {
    fn(inline) bit-width(self: int-kind): size {
      if self is {
        :u8  -> 8,
        :u16 -> 16,
        :u32 -> 32,
        :u64 -> 64,
        :i8  -> 8,
        :i16 -> 16,
        :i32 -> 32,
        :i64 -> 64,
      }
    }
    fn(inline) type-id(self: int-kind): type-id {
      if self is {
        :u8  -> id[u8],
        :u16 -> id[u16],
        :u32 -> id[u32],
        :u64 -> id[u64],
        :i8  -> id[i8],
        :i16 -> id[i16],
        :i32 -> id[i32],
        :i64 -> id[i64],
      }
    }
  }

  type float-value = either { f32(f32) = 0, f64(f64) = 1 }
  type float-kind = float-value.tag-enum

  type record-kind = either { struct = 0, union = 1, packed = 2 }

  fn(builtin) make-struct(kind: record-kind, fields: span[{ name: string, type: type-id }]): type-id
  fn field[t](name: string): make-struct.fields.t { .{ name, type = types/id[t] } }

  fn(builtin) make-either(
    tag-type: ?type-id,
    variants: span[{ name: string, payload: ?type-id, tag: ?int-value }]
  ): type-id
  fn make-either-default(variants: make-either.variants): type-id { make-either(:none, variants) }

  fn variant-data[t](name: string): make-either.variants.t { .{ name, payload = :some types/id[t], tag = :none } }
  fn variant-empty(name: string):   make-either.variants.t { .{ name, payload = :none,             tag = :none } }

  // Mirrors source *: a function inner type makes a function pointer
  fn(builtin) make-reference(inner: type-id): type-id
  fn(builtin) make-array(element: type-id, size: int): type-id
  fn(builtin) make-fn(params: span[type-id], return-type: type-id): type-id
  fn(builtin) make-instance(parent: type-id, args: span[type-id]): type-id

  type type-schema = either {
    char,
    bool,
    ptr,
    int(int-kind),
    float(float-kind),
    enum({
      int-kind,
      values: span[{
        name: string,
        value: int-value,
      }],
      partial: bool,
    }),
    reference({ inner-type-id: type-id }),
    array({
      element-type-id: type-id,
      size: ?int
    }),
    vector({
      element-type-id: type-id,
      size: ?int
    }),
    struct({
      fields: span[{
        name: string,
        type-id,
        offset: size
      }],
      packed: bool,
    }),
    union({
      fields: span[{
        name: string,
        type-id,
        offset: size
      }],
    }),
    either({
      tag-type: int-kind,
      payload-offset: size,
      variants: span[{
        name: string,
        tag: int-value,
        payload: ?{ type-id: type-id }
      }],
    }),
    string,
    never,
    function({
      params: span[type-id],
      return-type-id: type-id,
    }),
    function-pointer({ function-type-id: type-id }),
    named-function({ function-type-id: type-id, param-names: span[string] }),
    other(string)
  }

}

ns meta {

  /////// Static value ferrying across the runtime/comptime border:
  /////// Likely marked internal eventually
  fn(builtin) bake-static-value[t](value: t): u64
  // Must be provided an integer literal.
  // Can only be called by generated code
  fn(builtin) get-static-value[t](id: u64): t


}

////////////////////////////////
// Built-in Abilities

ability equals {
  fn equals(self, other: self): bool
  fn not-equals(self, other: self): bool { not self.equals(other) }
}

// TODO: Enhance with an `impl error` type parameter
// TODO: Allow error = never for infallible writes
ability writer {
  fn write-byte(self, value: u8)
  fn write-bytes(self, bytes: span[byte])

  fn(inline) write-char(self, value: char) { self.write-byte(value.as-u8()) }
  fn(inline) write-string(self, value: string) { self.write-bytes(value.span-bytes()) }

  fn(inline) write(self, value: string) { self.write-string(value) }

  fn writeln(self, value: string) {
    self.write-string(value)
    self.write-char('\n')
  }

  fn repeat(self, value: string, n: size) {
    let i = 0
    while i < n {
      self.write-string(value)
      i = i + 1
    }
  }
}

// rename print to ability display
ability print {
  fn print-to[w: writer](self, w)
}

ability print-precise {
  fn print-precise-to[w: writer](self, w, precision: u32)
}
// where formatter is a concrete type that always writes into a string-builder?
// or generic over w
// ability inspect { fn inspect-to[w: writer](f: formatter[w], self) }

// prints self into the current default allocator
ability to-string {
  fn to-string(self): string
}

ability bitwise {
  fn bit-not(self): self
  fn bit-and(self, other: self): self
  fn bit-or(self, other: self): self
  fn xor(self, other: self): self

  fn shift-left(self, count: u32): self
  fn shift-right(self, count: u32): self
}

ability int-bits {
  fn trailing-zeros(self): self
  fn leading-zeros(self): self
  fn count-ones(self): self
  fn swap-bytes(self): self
  fn rotate-left(self, count: u32): self
  fn rotate-right(self, count: u32): self
}

ability add { fn add(self, rhs: self): self }
ability sub { fn sub(self, rhs: self): self }
ability mul { fn mul(self, rhs: self): self }
ability div { fn div(self, rhs: self): self }
ability rem { fn rem(self, rhs: self): self }
ability neg { fn negated(self): self }

type overflow-result[t] = { value: t, overflowed: bool }

ability overflow-arith {
  fn add-overflow(self, rhs: self): overflow-result[self]
  fn sub-overflow(self, rhs: self): overflow-result[self]
  fn mul-overflow(self, rhs: self): overflow-result[self]

  fn(inline) add-checked(self, rhs: self): ?self {
    let r = self.add-overflow(rhs)
    if r.overflowed :none else :some r.value
  }
  fn(inline) sub-checked(self, rhs: self): ?self {
    let r = self.sub-overflow(rhs)
    if r.overflowed :none else :some r.value
  }
  fn(inline) mul-checked(self, rhs: self): ?self {
    let r = self.mul-overflow(rhs)
    if r.overflowed :none else :some r.value
  }
}

// This is a more simple notion of add
// than Rust's std::ops::Add, generic over rhs and output.
// Being able to assume a symmetric add gives us much better and simpler
// type inference for 99% of cases. If we ever do Defaults, where
// we could default rhs and output to self, and also somehow use
// that information while inferring... then maybe. But i don't want
// to achieve it by doing "try the call with every impl" for performance reasons
impl add for u8  {   fn(builtin) add(self, rhs: self): self }
impl add for u16 {   fn(builtin) add(self, rhs: self): self }
impl add for u32 {   fn(builtin) add(self, rhs: self): self }
impl add for u64 {   fn(builtin) add(self, rhs: self): self }
impl add for i8  {   fn(builtin) add(self, rhs: self): self }
impl add for i16 {   fn(builtin) add(self, rhs: self): self }
impl add for i32 {   fn(builtin) add(self, rhs: self): self }
impl add for i64 {   fn(builtin) add(self, rhs: self): self }

