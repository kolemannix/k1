ability comparable {
  fn compare(self, other: self): ordering
}

impl comparable for u8  { fn(builtin) compare(self, other: self): ordering }
impl comparable for u16 { fn(builtin) compare(self, other: self): ordering }
impl comparable for u32 { fn(builtin) compare(self, other: self): ordering }
impl comparable for u64 { fn(builtin) compare(self, other: self): ordering }
impl comparable for i8  { fn(builtin) compare(self, other: self): ordering }
impl comparable for i16 { fn(builtin) compare(self, other: self): ordering }
