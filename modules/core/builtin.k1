impl sub for u32 {   fn(intern) sub(self, rhs: self): self }
impl sub for u64 {   fn(intern) sub(self, rhs: self): self }
impl sub for i8  {   fn(intern) sub(self, rhs: self): self }
impl sub for i16 {   fn(intern) sub(self, rhs: self): self }
impl sub for i32 {   fn(intern) sub(self, rhs: self): self }
