ability scalar-cmp {
  fn lt(self, other: self): bool
  fn le(self, other: self): bool
  fn gt(self, other: self): bool
  fn ge(self, other: self): bool
}

impl scalar-cmp for u8 {
  fn(intern) lt(self, other: self): bool
  fn(intern) le(self, other: self): bool
  fn(intern) gt(self, other: self): bool
  fn(intern) ge(self, other: self): bool
}
impl scalar-cmp for u16 {
  fn(intern) lt(self, other: self): bool
  fn(intern) le(self, other: self): bool
  fn(intern) gt(self, other: self): bool
  fn(intern) ge(self, other: self): bool
}
impl scalar-cmp for u32 {
  fn(intern) lt(self, other: self): bool
  fn(intern) le(self, other: self): bool
  fn(intern) gt(self, other: self): bool
  fn(intern) ge(self, other: self): bool
}
impl scalar-cmp for u64 {
  fn(intern) lt(self, other: self): bool
  fn(intern) le(self, other: self): bool
  fn(intern) gt(self, other: self): bool
  fn(intern) ge(self, other: self): bool
}
impl scalar-cmp for i8 {
  fn(intern) lt(self, other: self): bool
  fn(intern) le(self, other: self): bool
  fn(intern) gt(self, other: self): bool
  fn(intern) ge(self, other: self): bool
}
impl scalar-cmp for i16 {
  fn(intern) lt(self, other: self): bool
  fn(intern) le(self, other: self): bool
  fn(intern) gt(self, other: self): bool
  fn(intern) ge(self, other: self): bool
}
