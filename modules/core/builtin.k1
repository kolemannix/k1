ability try[impl t, impl e] {
  fn error(e: e): self
  fn value(t: t): self

  fn is-ok(self): bool
  fn get-error(self): e
  fn get-value(self): t

  fn result(self): result[t, e] {
    if self.is-ok() :ok(self.get-value()) else :err(self.get-error())
  }
}

ability iterator[impl item] {
  fn next(self: *self): ?item
  fn size-hint(_self: *self): { at-least: size, at-most: ?size } {
    .{ at-least = 0, at-most = :none }
  }
  fn advance-by(self: *self, n: size) {
    let i: size = 0
    while i < n {
      if self.next() is :none { break }
      i = i + 1
    }
  }
  fn nth(self: *self, n: size): ?item {
    self.advance-by(n)
    self.next()
  }
  fn seek(self: *self, needle: item): ?size where item: equals {
    let i: size = 0
    while self.next() is :some x {
      if x == needle return :some i
      i = i + 1
    }
    :none
  }
}

ability iterable[impl item, impl i: iterator[item = item]] {
  fn iterator(self): i

  fn find(self, pred: some fn item -> bool): ?item {
    for self {
      if pred(it) return :some it
    }
    :none
  }

  fn find-index(self, pred: some fn item -> bool): ?size {
    for self {
      if pred(it) return :some it-index
    }
    :none
  }

  fn position(self, needle: item): ?size where item: equals {
    let iter = self.iterator()
    iter.&.seek(needle)
  }

  fn contains(self, needle: item): bool where item: equals {
    self.position(needle).is-some()
  }

  fn forall(self, pred: some fn item -> bool): bool {
    for self { if not pred(it) return false }
    true
  }

  fn exists(self, pred: some fn item -> bool): bool {
    for self {
      if pred(it) return true
    }
    false
  }

  fn sum(self): item where item: add and zero {
    let acc = zero@(item)/zero()
    for self {
      acc = acc + it
    }
    acc
  }

  fn to-list(self): list[item] {
    let out = list/empty[item]()
    for self { out.push(it) }
    out
  }
}

impl[item, t: iterator[item = item]] iterable[item = item, i = t] for t {
  fn iterator(self): t { self }
}

// Every ability above this line, `enum` through `iterable`, has a
// hard-coded id dependent on declaration order (typer.rs ABILITY_ID_*).
// ------------------------------------------------------------------

ability from-string[impl e] {
  fn from-string(s: string): result[self, e]
}

ability zero { fn zero(): self }
ability one { fn one(): self }

ability index[impl key, impl t] {
  fn index-ref(self, key: key): *t
}

ability as-buffer[impl t] {
  fn as-buffer(self): buffer[t]

  fn swap(self, index-a: size, index-b: size) {
    self.as-buffer().swap(index-a, index-b)
  }
  fn reverse(self) {
    self.as-buffer().reverse()
  }
  fn fill(self, value: t) {
    self.as-buffer().fill(value)
  }
  fn sort(self) where t: comparable {
    self.as-buffer().sort()
  }
  fn first-ref(self): ?*t {
    self.as-buffer().first-ref()
  }
  fn first(self): ?t {
    self.as-buffer().first()
  }
  fn last-ref(self): ?*t {
    self.as-buffer().last-ref()
  }
  fn last(self): ?t {
    self.as-buffer().last()
  }
  fn ref-iter(self): buffer-ref-iterator[t] {
    self.as-buffer().ref-iter()
  }
}

ability as-span[impl t] {
  fn as-span(self): span[t]

  fn(inline) len(self): size {
    self.as-span().inner-buffer().len
  }
  fn(inline) is-empty(self): bool {
    self.as-span().inner-buffer().len == 0
  }
  fn(inline) non-empty(self): bool {
    self.as-span().inner-buffer().len != 0
  }
  fn(inline) index-opt(self, index: size): ?t {
    let b = self.as-span().inner-buffer()
    if index >= b.len :none
    else :some b.[index]
  }
  fn(inline) first(self): ?t {
    let b = self.as-span().inner-buffer()
    if b.len == 0 :none
    else :some b.[0]
  }
  fn(inline) last(self): ?t {
    let b = self.as-span().inner-buffer()
    if b.len == 0 :none
    else :some b.[b.len - 1]
  }
  fn(inline) slice(self, start: size, end: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().slice(start, end))
  }
  fn(inline) take(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().take(count))
  }
  fn(inline) drop(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().drop(count))
  }
  fn(inline) take-right(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().take-right(count))
  }
  fn(inline) drop-right(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().drop-right(count))
  }
  fn chunks(self, size: size): span[span[t]] {
    mem/bitcast(self.as-span().inner-buffer().chunks(size))
  }
  fn starts-with(self, other: span[t]): bool where t: equals {
    self.as-span().inner-buffer().starts-with(other.inner-buffer())
  }
  fn ends-with(self, other: span[t]): bool where t: equals {
    self.as-span().inner-buffer().ends-with(other.inner-buffer())
  }
  fn index-of-span(self, needle: span[t]): ?size where t: equals {
    self.as-span().inner-buffer().index-of-buffer(needle.inner-buffer())
  }
  fn contains-span(self, needle: span[t]): bool where t: equals {
    self.as-span().inner-buffer().index-of-buffer(needle.inner-buffer()).is-some()
  }
  fn first-diff(self, other: span[t]): ?size where t: equals {
    self.as-span().inner-buffer().first-diff(other.inner-buffer())
  }
  fn sorted(self): span[t] where t: comparable {
    let b = self.as-span().inner-buffer().cloned()
    b.sort()
    span/wrap-buffer(b)
  }
}

impl[t, c: as-buffer[t = t]] as-span[t = t] for c {
  fn(inline) as-span(self): span[t] { span/wrap-buffer(self.as-buffer()) }
}

/////////////////////////////////
// Code that we want to have available very early
// to enable basic comptime execution inside of builtin/core

ns for buffer {
  fn equals-bits[t](self: buffer[t], other: buffer[t]): bool {
    if self.len == 0 and other.len == 0 true
    else if self.len != other.len       false else {
      mem/equals(self.data-ptr(), other.data-ptr(), self.size-bytes())
    }
  }
}

ns for span {
  fn equals-bits[t](self: span[t], other: span[t]): bool {
    self.buffer.equals-bits(other.buffer)
  }
}

impl equals for buffer[u8] {
  fn equals(self: buffer[u8], other: buffer[u8]): bool {
    self.equals-bits(other)
  }
}

impl equals for buffer[char] {
  fn equals(self: buffer[char], other: buffer[char]): bool {
    self.equals-bits(other)
  }
}

impl equals for buffer[int] {
  fn equals(self: buffer[int], other: buffer[int]): bool {
    self.equals-bits(other)
  }
}

impl equals for buffer[bool] {
  fn equals(self: buffer[bool], other: buffer[bool]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[u8] {
  fn equals(self: span[u8], other: span[u8]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[char] {
  fn equals(self: span[char], other: span[char]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[int] {
  fn equals(self: span[int], other: span[int]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[bool] {
  fn equals(self: span[bool], other: span[bool]): bool {
    self.equals-bits(other)
  }
}

impl equals for string {
  fn equals(self: string, that: string): bool {
    self.span == that.span
  }
}

impl print for string {
  fn print-to[w: writer](self: string, w) { w.write-string(self) }
}

impl print-precise for string {
  fn print-precise-to[w: writer](self: string, w, precision: u32) {
    w.write-bytes(fmt/chars-prefix(self.span-bytes(), precision))
  }
}

impl print for {} {
  fn print-to[w: writer](self: {}, w) { w.write-string("{}") }
}


impl equals for {} {
  fn equals(_self: {}, _other: {}): bool { true }
}

ns mem {

  // Does not handle overlaps; memcpy
  fn(builtin) copy-memcpy(
    dst: ptr,
    src: ptr,
    count: size
  )
  // Handles overlaps; memmove
  fn(builtin) move-memmove(
    dst: ptr,
    src: ptr,
    count: size
  )
  fn(builtin) set-memset(
    dst: ptr,
    value: u8,
    count: size
  )
  fn(builtin) equals-memcmp(p1: ptr, p2: ptr, size: int): bool

  fn(builtin) bitcast[from, to](value: from): to

  fn(builtin) load-volatile[t](src: *t): t
  fn(builtin) store-volatile[t](dst: *t, value: t)

}

/////////////////////////////////
// Compiler builtins
ns k1 {

  type source-location = { filename: string, line: u32, span: u64, function: string }

  // Need some way to mark this and is-static as comptime only
  let capture-prints: bool = true

  // is-static is set to 'true' when executing K1 code statically, at compile-time
  let is-static: bool = builtin

  let test: bool = builtin
  let no-std: bool = builtin
  let debug: bool = builtin

  // Who provides `ns platform`: a posix flavor, WASI, or `bare` -- the
  // consumer of the emitted object provides the k1_platform_* symbols
  type platform = either { posix-linux, posix-macos, wasi, bare }
  let platform: platform = builtin
  // The platform the compiler runs on; static execution happens there, not on `platform`
  let host-platform: platform = builtin
  fn select-os[t](macos: some fn() -> t, linux: some fn() -> t): t {
    if is-static {
      #if host-platform is { :posix-macos -> macos(), :posix-linux or :wasi or :bare -> linux() }
    } else {
      #if platform is { :posix-macos -> macos(), :posix-linux or :wasi or :bare -> linux() }
    }
  }
  let platform-macos: bool = #if platform is { :posix-macos -> true, :posix-linux or :wasi or :bare -> false }
  let platform-linux: bool = #if platform is { :posix-linux -> true, :posix-macos or :wasi or :bare -> false }
  let platform-wasi: bool = #if platform is { :wasi -> true, :posix-linux or :posix-macos or :bare -> false }
  let platform-bare: bool = #if platform is { :bare -> true, :posix-linux or :posix-macos or :wasi -> false }
  let platform-posix: bool = #if platform is { :posix-linux or :posix-macos -> true, :wasi or :bare -> false }

  ns for platform {
    fn dylib-ext(self): string {
      if self is {
        :posix-macos -> "dylib",
        :posix-linux -> "so",
        :wasi or :bare -> crash("no dylibs on wasi or bare"),
      }
    }
  }

  type arch = either { intel64 = 0, arm64 = 1, wasm64 = 2 }
  let arch: arch = builtin

  // The widest SIMD register the target supports;
  let simd-bytes: size = builtin

  fn(builtin) location(): source-location

  fn(builtin) module-dir(): string

  fn(builtin) exit(code: i32): never

  fn program-exit(code: i32): never {
    sys/exit(code)
  }

  fn test-main(): i32 { core/test/run(test/suite()) }

  ns test {
    fn(builtin) expect-failure(needle: string)
    fn(builtin) suite(): core/test/suite
  }

  fn(builtin) emit-compiler-message(
    locn: k1/source-location,
    level: either(u8) { info, warn, error },
    msg: string
  )

  type link-kind = either(u8) { default, static, dynamic }

  type library-ref = {
    name: string,
    link-type: link-kind,
  }

  type target = either(u8) { intel64-linux, arm64-macos, wasm64-wasi, intel64-bare, arm64-bare, wasm64-bare }

  type command = either(u8) { check, build, run, test, server }

  type option = { name: string, value: string }

  type build-config = {
    target: target,
    cpu: string,
    features: string,
    optimize: bool,
    debug: bool,
    no-std: bool,
    sanitize: bool,
    filc: bool,
  }

  type build-request = {
    default: build-config,
    command: command,
    options: list[option],
    host: opt[target],
    editor: bool,
  }

  type editor-settings = { test-on-save: bool }

  type setup-ctx = { build: build-config }

  type module = {
    library: bool,
    depend: list[string],
    configure: code,
    submodules: list[submodule],
    ignore: list[string],
    link: list[library-ref],
    link-args: list[string],
    setup-inputs: list[string],
    setup-outputs: list[string],
  }

  type submodule = { dir: string, depend: list[string] }

  ns repl {
    // we can't quite do this yet
    // fn watch(value: $expr, );

    // we could just explicitly handle valid vs invalid pairs of (type, widget-kind)
    // Or we could do add-integer-widget() with an integer-widget-kind. 
    // type widget-kind = either { int-slider({ min: size, max: size }),  }
    // fn add-widget[t](value: t, kind: widget-kind)

    // Or we could use typeclasses (abilities).
    // fn add-widget-slider[t: numeric](value: t, min: size, max: size)

    // OR what about this? Am i a genius or losing it
    // fn add-slider[t](name: string, get: fn() -> u32, set: fn(u32) -> {})

    // lets name it 'checkbox' not 'add-checkbox', immediate-mode style, since
    // the user's code is totally immediate mode style
    fn(builtin) checkbox(name: string, get: *fn() -> bool, set: *fn(bool) -> {})

  }

}

/////////////////////////////////
// Core sizing intrinsics

ns sys {
  fn exit(code: i32): never {
    io/flush-stdout()
    platform/process/exit(code)
  }

  fn fork(child-fn: some fn() -> i32, stdin: ?platform/io/file-handle, stdout: ?platform/io/file-handle, stderr: ?platform/io/file-handle, extra-close: span[platform/io/file-handle]): result[i32, i32] {
    io/flush-stdout()
    let pid = platform/process/fork(stdin, stdout, stderr, extra-close).try
    if pid == 0 exit(child-fn())
    :ok pid
  }
}

ns for ptr {
  let null: ptr = mem/bitcast[u64, ptr](0)

  fn(inline) is-null(self: ptr): bool { self is null }

  fn(inline) ref[t](context locn: k1/source-location)(self: ptr): *t {
    if k1/debug or k1/is-static { if self is null crash("null ptr to reference") }
    mem/bitcast[ptr, *t](self)
  }

  fn(inline) ref-opt[t](self: ptr): optref[t] { .{ inner = self } }

  fn(inline) to-int(self: ptr): i64 { mem/bitcast[ptr, i64](self) }
  fn(inline) to-uint(self: ptr): u64 { mem/bitcast[ptr, u64](self) }
  fn(inline) to-size(self: ptr): size { mem/bitcast[ptr, size](self) }

  // This is an intrinsic so that we can codegen a getelementptr
  // instruction in LLVM rather than a pointer cast.
  // But we _could_ do it in userland using size-of and arithmetic which is neat!
  fn(builtin) ref-at[t](self: ptr, index: size): *t

  // ref-at compiles to gep, which preserves provenance
  fn(inline) add-bytes(self: ptr, offset: size): ptr {
    self.ref-at[u8](offset).as[ptr]
  }

  fn sub-bytes(self: ptr, offset: size): ptr {
    // getelementptr interprets the index as signed
    self.ref-at[u8](offset.negated()).as[ptr]
  }

  fn diff(self: ptr, other: ptr): size {
    self.to-size() - other.to-size()
  }

  fn get-align-offset(size: size, alignment: size): size {
    (alignment - size) & (alignment - 1)
  }

  fn aligned(self: ptr, alignment: size): ptr {
    self.add-bytes(get-align-offset(self.to-size(), alignment))
  }

}

impl equals for ptr {
  fn equals(self: ptr, other: ptr): bool {
    self.to-size() == other.to-size()
  }
}

ns for bool {
  fn(inline) as-u8(self: bool): u8 { mem/bitcast[bool, u8](self) }
  fn(inline) as-i8(self: bool): i8 { mem/bitcast[bool, i8](self) }

  fn(inline) from-u8(value: u8): bool { value != 0u8 }
}

impl neg for bool { fn(builtin) negated(self: bool): bool }
impl equals for bool {
  fn(builtin) equals(self: bool, other: bool): bool
  fn(builtin) not-equals(self: bool, other: bool): bool
}

impl equals for u8 {
  fn(builtin) equals(self: u8, other: u8): bool
  fn(builtin) not-equals(self: u8, other: u8): bool
}
impl equals for u16 {
  fn(builtin) equals(self: u16, other: u16): bool
  fn(builtin) not-equals(self: u16, other: u16): bool
}
impl equals for u32 {
  fn(builtin) equals(self: u32, other: u32): bool
  fn(builtin) not-equals(self: u32, other: u32): bool
}
impl equals for u64 {
  fn(builtin) equals(self: u64, other: u64): bool
  fn(builtin) not-equals(self: u64, other: u64): bool
}

impl equals for i8 {
  fn(builtin) equals(self: i8, other: i8): bool
  fn(builtin) not-equals(self: i8, other: i8): bool
}
impl equals for i16 {
  fn(builtin) equals(self: i16, other: i16): bool
  fn(builtin) not-equals(self: i16, other: i16): bool
}
impl equals for i32 {
  fn(builtin) equals(self: i32, other: i32): bool
  fn(builtin) not-equals(self: i32, other: i32): bool
}
impl equals for i64 {
  fn(builtin) equals(self: i64, other: i64): bool
  fn(builtin) not-equals(self: i64, other: i64): bool
}

impl equals for char {
  fn(builtin) equals(self: char, other: char): bool
  fn(builtin) not-equals(self: char, other: char): bool
}

fn(builtin) discard[t](_t: t): empty
fn(cold) enum-unknown-name[v: print](type-name: string, value: v): string { "${type-name}(${value})" }
fn phony[t](): t { crash("phony") }

ns array {
  fn(inline) data-ref[t, n](array: *array[t, n]): *t where n: static size {
    array.[0].&
  }
  fn(inline) data-ptr[t, n](array: *array[t, n]): ptr where n: static size {
    array.as[ptr]
  }
  fn(inline) size-bytes[t, n](_array: *array[t, n]): int where n: static size {
    types/size[array[t, n]]
  }

  fn zeroed[t, n: static size](): array[t, n] {
    .0
  }

  fn allocate[t, n: static size, a: allocator](alloc: a): *array[t, n] {
    alloc.alloc-t[array[t, n]]
  }

  fn memset[t, n](array: *array[t, n], value: u8) where n: static size {
    mem/set(dst = array.data-ptr(), value = value, count = array.size-bytes())
  }

  fn filled-in[t, n: static size, a: allocator](alloc: a, t: t, n: n): *array[t, n] {
    let array-uninit = allocate[t = t, n = n](alloc)
    let i = 0
    while i < n.from-static() {
      array-uninit.[i] = t
      i = i + 1
    }
    array-uninit
  }

  fn from-buffer[t, n: static size](buffer: buffer[t]): array[t, n] {
    let(returned) array: array[t, n] = uninit
    if buffer.len() != array.len() crash("array.from-buffer with mismatching length")

    buffer/copy(src = buffer, dst = array.as-buffer())

    array
  }

}

impl[t, n: static size] as-buffer[t = t] for *array[t, n] {
  fn(inline) as-buffer(self): buffer[t] {
    .{ len = self.len(), data = self.data-ptr() }
  }
}

impl[t, n: static size] as-span[t = t] for *array[t, n] {
  fn(inline) as-span(self): span[t] {
    span/wrap-raw(self.data-ptr(), self.len())
  }
}

impl[t: print, n: static size] print for array[t, n] {
  fn print-to[w: writer](self: array[t, n], w): empty {
    w.write-char('[')
    let i: size = 0
    while i < n {
      if i > 0 { w.write-char(',') }
      self.[i].print-to(w)
      i = i + 1
    }
    w.write-char(']')
  }
}

fn(inline) assert(context locn: k1/source-location)(value: bool) {
  if not value crash("ASSERT FAILED")
}

fn assertdbg(context locn: k1/source-location)(value: bool) {
  #if k1/debug { if not value crash("ASSERT FAILED") }
  else         { let _ = locn; let _ = value; .{} }
}

let(mutable) backtrace-on-crash: bool = true

fn print-backtrace() {
  #if k1/platform is {
    :posix-macos or :posix-linux -> k1rt/_k1_print_backtrace(frame_count = 128),
    :wasi or :bare -> .{}
  }
}

fn crash(context locn: k1/source-location)(msg: string): never {
  if k1/no-std {
    let s = "exiting (nostd)\n\0"
    let _ = platform/io/write(
      file = platform/io/STDOUT,
      data = s.data-ptr(),
      count = s.len() - 1,
    )
    sys/exit(1)
  } else if k1/is-static {
    k1/emit-compiler-message(locn, :error, msg)
    platform/process/abort()
  } else {
    io/flush-stdout()
    if backtrace-on-crash print-backtrace()

    // We print this way to avoid calling our format code
    eprint(msg)
    eprint(" at ")
    eprint(locn.filename)
    eprint(":")
    core/format-uint(context core/io/stderr)(locn.line.widen[u64], 10)
    eprint("\n")

    platform/process/abort()
  }
}

fn crash-bounds(context locn: k1/source-location)(size: size, index: size, msg: string): never {
  crash("$msg: $index >= $size")
}

fn(inline) checked-index(context locn: k1/source-location)(index: size, len: size): size {
  if index.unsigned() >= len.unsigned() crash-bounds(len, index, "Index out of bounds")
  index
}

ns k1 {
  fn crash-div(divisor-is-zero: bool): never {
    crash(if divisor-is-zero "Division by zero" else "Integer division overflow: min-value / -1")
  }

  // Called by the codegen-emitted stub of a reloadable fn when its slot is
  // still null; both args are NUL-terminated names baked into the stub
  fn crash-unloaded-ns(ns-name: *u8, fn-name: *u8): never {
    let loaded-ns = string/wrap-c(ns-name)
    crash("reloadable ns ${loaded-ns} not loaded; call ${loaded-ns}/load() (called: ${string/wrap-c(fn-name)})")
  }

  fn crash-missing-type-info(type-id: u64): never {
    crash("no type info for type id $type-id")
  }
}
