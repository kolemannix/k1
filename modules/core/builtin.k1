impl scalar-cmp for ptr {
  fn lt(self, other: self): bool { self.as[usize].lt(other.as[usize]) }
  fn le(self, other: self): bool { self.as[usize].le(other.as[usize]) }
  fn gt(self, other: self): bool { self.as[usize].gt(other.as[usize]) }
  fn ge(self, other: self): bool { self.as[usize].ge(other.as[usize]) }
}

ability comparable {
  fn compare(self, other: self): ordering
}

ability try[impl t, impl e] {
  // DO NOT REORDER `try` expects error to be first
  fn error(e: e): self
  fn value(t: t): self

  fn is-ok(self): bool
  fn get-error(self): e
  fn get-value(self): t
}

ability iterator[impl item] {
  fn next(self: *mut self): ?item
  fn size-hint(self: *self): { at-least: size, at-most: ?size } {
    .{ at-least = 0, at-most = :none }
  }
  fn advance-by(self: *mut self, n: size) {
    let i: size = 0
    while i < n {
      if self.next() is :none { break }
      i = i + 1
    }
  }
  fn nth(self: *mut self, n: size): ?item {
    self.advance-by(n)
    self.next()
  }
}

ability iterable[impl item, impl i: iterator[item = item]] {
  fn iterator(self): i
}

impl[item, t: iterator[item = item]] iterable[item = item, i = t] for t {
  fn iterator(self): t { self }
}

// Every ability above this line, `enum` through `iterable`, has a
// hard-coded id dependent on declaration order (typer.rs ABILITY_ID_*).
// ------------------------------------------------------------------

ability from-string[impl e] {
  fn from-string(s: string): result[self, e]
}

ability zero { fn zero(): self }
ability one { fn one(): self }

