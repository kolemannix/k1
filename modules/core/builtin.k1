impl scalar-cmp for ptr {
  fn lt(self, other: self): bool { self.to-uint().lt(other.to-uint()) }
  fn le(self, other: self): bool { self.to-uint().le(other.to-uint()) }
  fn gt(self, other: self): bool { self.to-uint().gt(other.to-uint()) }
  fn ge(self, other: self): bool { self.to-uint().ge(other.to-uint()) }
}

ability comparable {
  fn compare(self, other: self): ordering
}

ability try[impl t, impl e] {
  // DO NOT REORDER `try` expects error to be first
  fn error(e: e): self
  fn value(t: t): self

  fn is-ok(self): bool
  fn get-error(self): e
  fn get-value(self): t

  fn result(self): result[t, e] {
    if self.is-ok() :ok(self.get-value()) else :err(self.get-error())
  }
}

ability iterator[impl item] {
  fn next(self: *mut self): ?item
  fn size-hint(self: *self): { at-least: size, at-most: ?size } {
    .{ at-least = 0, at-most = :none }
  }
  fn advance-by(self: *mut self, n: size) {
    let i: size = 0
    while i < n {
      if self.next() is :none { break }
      i = i + 1
    }
  }
  fn nth(self: *mut self, n: size): ?item {
    self.advance-by(n)
    self.next()
  }
}

ability iterable[impl item, impl i: iterator[item = item]] {
  fn iterator(self): i

  fn find(self, pred: some fn item -> bool): ?item {
    for self {
      if pred(it) return :some it
    }
    :none
  }

  fn position(self, needle: item): ?size where item: equals {
    for self {
      if it == needle return :some it-index
    }
    :none
  }

  fn contains(self, needle: item): bool where item: equals {
    self.position(needle).is-some()
  }

  fn forall(self, pred: some fn item -> bool): bool {
    for self { if not pred(it) return false }
    true
  }

  fn exists(self, pred: some fn item -> bool): bool {
    for self {
      if pred(it) return true
    }
    false
  }

  fn sum(self): item where item: add and zero {
    let acc = zero@(item)/zero()
    for self {
      acc = acc + it
    }
    acc
  }

  fn to-list(self): list[item] {
    let out = list/empty[item]()
    for self { out.push(it) }
    out
  }
}

impl[item, t: iterator[item = item]] iterable[item = item, i = t] for t {
  fn iterator(self): t { self }
}

// Every ability above this line, `enum` through `iterable`, has a
// hard-coded id dependent on declaration order (typer.rs ABILITY_ID_*).
// ------------------------------------------------------------------

ability from-string[impl e] {
  fn from-string(s: string): result[self, e]
}

ability zero { fn zero(): self }
ability one { fn one(): self }

ability index[impl key, impl t] {
  fn index-ref(self, key: key): *t
}

ability as-buffer[impl t] {
  fn as-buffer(self): buffer[t]

  fn swap(self, index-a: size, index-b: size) {
    self.as-buffer().swap(index-a, index-b)
  }
  fn reverse(self) {
    self.as-buffer().reverse()
  }
  fn fill(self, value: t) {
    self.as-buffer().fill(value)
  }
  fn sort(self) where t: comparable {
    self.as-buffer().sort()
  }
  fn first-ref(self): ?*t {
    self.as-buffer().first-ref()
  }
  fn last-ref(self): ?*t {
    self.as-buffer().last-ref()
  }
  fn ref-iter(self): buffer-ref-iterator[t] {
    self.as-buffer().ref-iter()
  }
}

ability as-span[impl t] {
  fn as-span(self): span[t]

  fn len(self): size {
    self.as-span().inner-buffer().len
  }
  fn is-empty(self): bool {
    self.as-span().inner-buffer().len == 0
  }
  fn non-empty(self): bool {
    self.as-span().inner-buffer().len != 0
  }
  fn index-opt(self, index: size): ?t {
    let b = self.as-span().inner-buffer()
    if index >= b.len :none
    else :some b.[index]
  }
  fn first(self): ?t {
    let b = self.as-span().inner-buffer()
    if b.len == 0 :none
    else :some b.[0]
  }
  fn last(self): ?t {
    let b = self.as-span().inner-buffer()
    if b.len == 0 :none
    else :some b.[b.len - 1]
  }
  fn slice(self, start: size, end: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().slice(start, end))
  }
  fn take(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().take(count))
  }
  fn drop(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().drop(count))
  }
  fn take-right(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().take-right(count))
  }
  fn drop-right(self, count: size): span[t] {
    span/wrap-buffer(self.as-span().inner-buffer().drop-right(count))
  }
  fn chunks(self, size: size): span[span[t]] {
    mem/bitcast(self.as-span().inner-buffer().chunks(size))
  }
  fn starts-with(self, other: span[t]): bool where t: equals {
    self.as-span().inner-buffer().starts-with(other.inner-buffer())
  }
  fn ends-with(self, other: span[t]): bool where t: equals {
    self.as-span().inner-buffer().ends-with(other.inner-buffer())
  }
  fn index-of-span(self, needle: span[t]): ?size where t: equals {
    self.as-span().inner-buffer().index-of-buffer(needle.inner-buffer())
  }
  fn contains-span(self, needle: span[t]): bool where t: equals {
    self.as-span().inner-buffer().index-of-buffer(needle.inner-buffer()).is-some()
  }
  fn first-diff(self, other: span[t]): ?size where t: equals {
    self.as-span().inner-buffer().first-diff(other.inner-buffer())
  }
  fn sorted(self): span[t] where t: comparable {
    let b = self.as-span().inner-buffer().cloned()
    b.sort()
    span/wrap-buffer(b)
  }
}

impl[t, c: as-buffer[t = t]] as-span[t = t] for c {
  fn as-span(self): span[t] { span/wrap-buffer(self.as-buffer()) }
}

/////////////////////////////////
// Code that we want to have available very early
// to enable basic comptime execution inside of builtin/core

ns for buffer {
  fn equals-bits[t](self: buffer[t], other: buffer[t]): bool {
    if self.len == 0 and other.len == 0 true
    else if self.len != other.len       false else {
      mem/equals(self.data-ptr(), other.data-ptr(), self.size-bytes())
    }
  }
}

ns for span {
  fn equals-bits[t](self: span[t], other: span[t]): bool {
    self.buffer.equals-bits(other.buffer)
  }
}

impl equals for buffer[u8] {
  fn equals(self: buffer[u8], other: buffer[u8]): bool {
    self.equals-bits(other)
  }
}

impl equals for buffer[char] {
  fn equals(self: buffer[char], other: buffer[char]): bool {
    self.equals-bits(other)
  }
}

impl equals for buffer[int] {
  fn equals(self: buffer[int], other: buffer[int]): bool {
    self.equals-bits(other)
  }
}

impl equals for buffer[bool] {
  fn equals(self: buffer[bool], other: buffer[bool]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[u8] {
  fn equals(self: span[u8], other: span[u8]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[char] {
  fn equals(self: span[char], other: span[char]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[int] {
  fn equals(self: span[int], other: span[int]): bool {
    self.equals-bits(other)
  }
}

impl equals for span[bool] {
  fn equals(self: span[bool], other: span[bool]): bool {
    self.equals-bits(other)
  }
}

impl equals for string {
  fn equals(self: string, that: string): bool {
    self.span == that.span
  }
}

impl print for string {
  fn print-to[w: writer](self: string, w) { w.write-string(self) }
}

impl print for {} {
  fn print-to[w: writer](self: {}, w) { w.write-string("{}") }
}


impl equals for {} {
  fn equals(_self: {}, _other: {}): bool { true }
}

ns mem {

  // Does not handle overlaps; memcpy
  fn(intern) copy(
    dst: ptr,
    src: ptr,
    count: size
  )
  // Handles overlaps; memmove
  fn(intern) move(
    dst: ptr,
    src: ptr,
    count: size
  )
  fn(intern) set(
    dst: ptr,
    value: u8,
    count: size
  )
  fn(intern) equals(p1: ptr, p2: ptr, size: int): bool

  fn(intern) zeroed[t](): t

  fn(intern) bitcast[t, u](t: t): u

  fn(intern) load-volatile[t](src: *t): t
  fn(intern) store-volatile[t](dst: *t, value: t)

}

/////////////////////////////////
// Compiler builtins
ns k1 {

  type source-location = { filename: string, line: u64 }

  // Need some way to mark this and is-static as comptime only
  let capture-prints: bool = true

  // is-static is set to 'true' when executing K1 code statically, at compile-time
  let is-static: bool = builtin

  let test: bool = builtin
  let no-std: bool = builtin
  let debug: bool = builtin

  // Who provides `ns platform`: a posix flavor, WASI, or `bare` -- the
  // consumer of the emitted object provides the k1_platform_* symbols
  type platform = either { posix-linux, posix-macos, wasi, bare }
  let platform: platform = builtin
  // The platform the compiler runs on; static execution happens there, not on `platform`
  let host-platform: platform = builtin
  let platform-macos: bool = platform #is { :posix-macos -> true, :posix-linux or :wasi or :bare -> false }
  let platform-linux: bool = platform #is { :posix-linux -> true, :posix-macos or :wasi or :bare -> false }
  let platform-wasi: bool = platform #is { :wasi -> true, :posix-linux or :posix-macos or :bare -> false }
  let platform-bare: bool = platform #is { :bare -> true, :posix-linux or :posix-macos or :wasi -> false }
  let platform-posix: bool = platform #is { :posix-linux or :posix-macos -> true, :wasi or :bare -> false }

  // The widest SIMD register the target supports;
  let simd-bytes: size = builtin

  fn(intern) location(): source-location

  fn(intern) exit(code: i32): never

  fn program-exit(code: i32): never {
    sys/exit(code)
  }

  fn(intern) emit-compiler-message(
    locn: k1/source-location,
    level: either(u8) { info, warn, error },
    msg: string
  )

  type module-kind = either(u8) { library, executable }

  type link-kind = either(u8) { default, static, dynamic }

  type library-ref = {
    name: string,
    link-type: link-kind,
  }

  // params-expr-id is a parsed expression id captured by the compiler; 0 = none
  type dep-entry = { name: string, params-expr-id: u64 }

  type setup-decl = {
    outputs: list[string],
    inputs: list[string],
  }

  type setup-ctx = { module-dir: string }

  type module = {
    kind: opt[module-kind],
    deps: list[dep-entry],
    libs: list[library-ref],
    link-args: list[string],
    setup: opt[setup-decl],
  }

  ns for module {
    fn new(): module {
      .{
        kind = :none,
        deps = list/empty(),
        libs = list/empty(),
        link-args = list/empty(),
        setup = :none,
      }
    }

    fn executable(self: *mut module) {
      if self.kind.is-some() { crash("module kind set twice") }
      self.kind = :some(:executable)
    }

    fn library(self: *mut module) {
      if self.kind.is-some() { crash("module kind set twice") }
      self.kind = :some(:library)
    }

    fn dep(self: *mut module, name: string) {
      self.add-dep-impl(name, 0)
    }

    // The compiler rewrites `m.dep(name, .{ ... })` to target this fn, passing the
    // captured params expression id; not meant to be called directly
    fn add-dep-impl(self: *mut module, name: string, params-expr-id: u64) {
      if name.is-empty() { crash("empty dep name") }
      if not name.[0].is-ascii-lower() {
        crash("invalid dep name '$name': dep names start with a lowercase ascii letter")
      }
      for name {
        let ok = it.is-ascii-lower() or it.is-ascii-digit() or it == '-' or it == '_'
        if not ok {
          crash("invalid dep name '$name': dep names contain only lowercase ascii letters, digits, '-' and '_'")
        }
      }
      for self.deps { if it.name == name { crash("duplicate dep '$name'") } }
      self.deps.push(.{ name, params-expr-id })
    }

    fn lib(self: *mut module, name: string, link-type: link-kind) {
      self.libs.push(.{ name, link-type })
    }

    fn link-args(self: *mut module, args: span[string]) {
      for args { self.link-args.push(it) }
    }

    fn setup(self: *mut module, outputs: span[string], inputs: span[string]) {
      if self.setup.is-some() { crash("module setup declared twice") }
      let o: list[string] = list/with-capacity(outputs.len())
      for outputs { o.push(it) }
      let i: list[string] = list/with-capacity(inputs.len())
      for inputs { i.push(it) }
      self.setup = :some(.{ outputs = o, inputs = i })
    }
  }

  ns repl {
    // we can't quite do this yet
    // fn watch(value: $expr, );

    // we could just explicitly handle valid vs invalid pairs of (type, widget-kind)
    // Or we could do add-integer-widget() with an integer-widget-kind. 
    // type widget-kind = either { int-slider({ min: size, max: size }),  }
    // fn add-widget[t](value: t, kind: widget-kind)

    // Or we could use typeclasses (abilities).
    // fn add-widget-slider[t: numeric](value: t, min: size, max: size)

    // OR what about this? Am i a genius or losing it
    // fn add-slider[t](name: string, get: fn() -> u32, set: fn(u32) -> {})

    // lets name it 'checkbox' not 'add-checkbox', immediate-mode style, since
    // the user's code is totally immediate mode style
    fn(intern) checkbox(name: string, get: *fn() -> bool, set: *fn(bool) -> {})

  }

}

/////////////////////////////////
// Core sizing intrinsics

ns sys {
  fn exit(code: i32): never {
    io/flush-stdout()
    platform/process/exit(code)
  }
}

ns for ptr {
  let null: ptr = mem/bitcast[u64, ptr](0)

  fn is-null(self: ptr): bool { self is null }

  fn ref[t](self: ptr): *t { mem/bitcast[ptr, *t](self) }

  fn ref-opt[t](self: ptr): optref[t] {
    .{ inner = self.ref[t] }
  }

  fn to-int(self: ptr): i64 { mem/bitcast[ptr, i64](self) }
  fn to-uint(self: ptr): u64 { mem/bitcast[ptr, u64](self) }
  fn to-size(self: ptr): size { mem/bitcast[ptr, size](self) }

  // This is an intrinsic so that we can codegen a getelementptr
  // instruction in LLVM rather than a pointer cast.
  // But we _could_ do it in userland using size-of and arithmetic which is neat!
  fn(intern) ref-at[t](self: ptr, index: size): *mut t

  // ref-at compiles to gep, which preserves provenance
  fn add-bytes(self: ptr, offset: size): ptr {
    self.ref-at[u8](offset).as[ptr]
  }

  fn sub-bytes(self: ptr, offset: size): ptr {
    // getelementptr interprets the index as signed
    self.ref-at[u8](offset.negated()).as[ptr]
  }

  fn diff(self: ptr, other: ptr): size {
    self.to-size() - other.to-size()
  }

  fn get-align-offset(size: size, alignment: size): size {
    (alignment - size) & (alignment - 1)
  }

  fn aligned(self: ptr, alignment: size): ptr {
    self.add-bytes(get-align-offset(self.to-size(), alignment))
  }

}

impl equals for ptr {
  fn equals(self: ptr, other: ptr): bool {
    self.to-size() == other.to-size()
  }
}

ns for bool {
  fn as-u8(self: bool): u8 { mem/bitcast[bool, u8](self) }
  fn as-i8(self: bool): i8 { mem/bitcast[bool, i8](self) }

  fn from-u8(value: u8): bool { value != 0u8 }
}

impl neg for bool { fn(intern) negated(self: bool): bool }
impl equals for bool { fn(intern) equals(self: bool, other: bool): bool }

impl equals for u8 { fn(intern) equals(self: u8, other: u8): bool }
impl equals for u16 { fn(intern) equals(self: u16, other: u16): bool }
impl equals for u32 { fn(intern) equals(self: u32, other: u32): bool }
impl equals for u64 { fn(intern) equals(self: u64, other: u64): bool }

impl equals for i8 { fn(intern) equals(self: i8, other: i8): bool }
impl equals for i16 { fn(intern) equals(self: i16, other: i16): bool }
impl equals for i32 { fn(intern) equals(self: i32, other: i32): bool }
impl equals for i64 { fn(intern) equals(self: i64, other: i64): bool }

impl equals for char { fn(intern) equals(self: char, other: char): bool }

fn discard[t](_t: t): empty {}
fn phony[t](): t { crash("phony") }

ns array {
  fn get-base-read[t, n](array: *array[t, n]): *t where n: static size {
    array.[0].&
  }
  fn get-base[t, n](array: *mut array[t, n]): *mut t where n: static size {
    array.[0].&
  }
  fn base-ptr[t, n](array: *mut array[t, n]): ptr where n: static size {
    array.as[ptr]
  }
  fn size-bytes[t, n](_array: array[t, n]): int where n: static size {
    types/size[array[t, n]]
  }

  fn zeroed[t, n: static size](): array[t, n] {
    mem/zeroed[array[t, n]]
  }

  fn allocate[t, n: static size, a: allocator](alloc: a): *mut array[t, n] {
    alloc.alloc-t[array[t, n]]()
  }

  fn memset[t, n](array: *mut array[t, n], value: u8) where n: static size {
    mem/set(dst = array.base-ptr(), value = value, count = array.size-bytes())
  }

  fn filled-in[t, n: static size, a: allocator](alloc: a, t: t, n: n): *mut array[t, n] {
    let array-uninit = allocate[t, n, _](alloc)
    let i = 0
    while i < n.from-static() {
      array-uninit.[i] = t
      i = i + 1
    }
    array-uninit
  }

  fn from-buffer[t, n: static size](buffer: buffer[t]): array[t, n] {
    let(returned) array: array[t, n] = uninit
    if buffer.len() != array.len() crash("array.from-buffer with mismatching length")

    buffer/copy(src = buffer, dst = array.as-buffer())

    array
  }

}

impl[t, n: static size] as-buffer[t = t] for *mut array[t, n] {
  fn as-buffer(self): buffer[t] {
    .{ len = self.len(), data = self.get-base() }
  }
}

impl[t, n: static size] as-span[t = t] for *array[t, n] {
  fn as-span(self): span[t] {
    span/wrap-raw(self.get-base-read().as[ptr], self.len())
  }
}

impl[t: print, n: static size] print for array[t, n] {
  fn print-to[w: writer](self: array[t, n], w): empty {
    let count: size = core/meta/static-type-to-value[_, n]()
    w.write-char('[')
    let i: size = 0
    while i < count {
      if i > 0 { w.write-char(',') }
      self.[i].print-to(w)
      i = i + 1
    }
    w.write-char(']')
  }
}

fn assert(context locn: k1/source-location)(value: bool) {
  if not value crash("ASSERT FAILED")
}

fn assertdbg(context locn: k1/source-location)(value: bool) {
  #if k1/debug { if not value crash("ASSERT FAILED") }
  else         { let _ = locn; let _ = value; .{} }
}

fn print-backtrace() {
  k1/platform #is {
    :posix-macos or :posix-linux -> k1rt/_k1_print_backtrace(frame_count = 128),
    :wasi or :bare -> println("non-posix backtrace TODO")
  }
}

fn crash(context locn: k1/source-location)(msg: string): never {
  if k1/no-std {
    let s = "exiting (nostd)\n\0"
    let _ = platform/io/write(
      file = platform/io/STDOUT,
      data = s.data-ptr(),
      count = s.len() - 1,
    )
    sys/exit(1)
  } else if k1/is-static {
    k1/emit-compiler-message(locn, :error, msg)
    sys/exit(111)
  } else {
    io/flush-stdout()
    print-backtrace()

    // We print this way to avoid calling our format code
    eprint(msg)
    eprint(" at ")
    eprint(locn.filename)
    eprint(":")
    core/format-uint(context core/io/stderr)(locn.line, 10)
    eprint("\n")

    platform/process/abort()
  }
}

fn crash-bounds(context locn: k1/source-location)(size: size, index: size, msg: string): never {
  crash("$msg: $index >= $size")
}

ns k1 {
  // Called by the codegen-emitted stub of a reloadable fn when its slot is
  // still null; both args are NUL-terminated names baked into the stub
  fn crash-unloaded-ns(ns-name: ptr, fn-name: ptr): never {
    let loaded-ns = string/wrap-c(ns-name)
    crash("reloadable ns ${loaded-ns} not loaded; call ${loaded-ns}/load() (called: ${string/wrap-c(fn-name)})")
  }
}

macro for-each(binding, iterable, body) {
  `{
    let iter = ($iterable).iterator()
    let it-index-next: size = 0
    loop {
      if iter.next() is :some($binding) {
        let it-index = it-index-next
        it-index-next = it-index + 1
        // work around 'never' bodies for now
        $body
      } else break
    }
  }`
}
