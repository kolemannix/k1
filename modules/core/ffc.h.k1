ns ffc

type(alias) ffc_outcome = u32
let FFC_OUTCOME_OK           : ffc_outcome = 0
let FFC_OUTCOME_INVALID_INPUT: ffc_outcome = 1
let FFC_OUTCOME_OUT_OF_RANGE : ffc_outcome = 2
type ffc_result = {
  // Where parsing stopped
  ptr: ptr,
  // The outcome of the call
  outcome: ffc_outcome
}

fn(extern("ffc_parse_double"), lib("k1rt")) parse_double(len: size, c-str: ptr, out: *mut f64): ffc_result
fn(extern("ffc_parse_float"), lib("k1rt")) parse_float(len: size, c-str: ptr, out: *mut f32): ffc_result

fn result_is_ok(result: ffc_result): bool { result.outcome == FFC_OUTCOME_OK }
