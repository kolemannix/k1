type spill-list[t, n: static size] = union {
  inline: { len: u32, items: array[t, n] },
  spilled: { marker: u32, list: list[t] },
}

ns for spill-list {
  let SPILLED: u32 = 0xFFFFFFFF

  fn new[t, n](): spill-list[t, n] { .0 }

  fn(inline) cap[t, n](_self: *spill-list[t, n]): size { core/meta/static-type-to-value[_, n]() }

  fn(inline) is-spilled[t, n](self: *spill-list[t, n]): bool { self.inline.len == SPILLED }

  // Retains allocated memory, if we've already spilled, intended for re-use
  fn clear[t, n](self: *spill-list[t, n]) {
    if self.is-spilled() {
      self.spilled.list.clear()
    } else {
      self.inline.len = 0
    }
  }

  fn(inline) len[t, n](self: *spill-list[t, n]): size {
    if self.is-spilled() self.spilled.list.len else self.inline.len.widen[size]
  }

  fn(noinline) _spill[t, n](self: *spill-list[t, n], needed: size) {
    let items = self.inline.items.&.as-buffer().slice(0, self.len())
    let list = list/with-capacity-in[t, _](mem/current-arena(), needed.max(self.cap() * 2))
    list.append-buffer(items)
    self.spilled = .{ marker = SPILLED, list }
  }

  fn push[t, n](self: *spill-list[t, n], t: t) {
    if self.is-spilled() {
      self.spilled.list.push(t)
    } else {
      let len = self.len()
      if len < self.cap() {
        self.inline.items.[len] = t
        self.inline.len = self.inline.len + 1
      } else {
        self._spill(len + 1)
        self.spilled.list.push(t)
      }
    }
  }

  fn push-n[t, n](self: *spill-list[t, n], ts: span[t]) {
    if self.is-spilled() {
      self.spilled.list.append-span(ts)
    } else {
      let len = self.len()
      let needed = len + ts.len()
      if needed <= self.cap() {
        buffer/copy(src = ts.inner-buffer(), dst = self.inline.items.&.as-buffer().slice(len, needed))
        self.inline.len = needed.trunc[u32]
      } else {
        self._spill(needed)
        self.spilled.list.append-span(ts)
      }
    }
  }

  fn push-string[n](self: *spill-list[u8, n], s: string) {
    self.push-n[u8, n](s.span-bytes())
  }

}

impl[t, n: static size] as-buffer[t = t] for *spill-list[t, n] {
  fn as-buffer(self): buffer[t] {
    if self.is-spilled() self.spilled.list.as-buffer()
    else self.inline.items.&.as-buffer().slice(0, self.len())
  }
}

impl[t, n: static size] index[key = size, t = t] for *spill-list[t, n] {
  fn(inline) index-ref(self, key: size): *t { self.as-buffer().index-ref(key) }
}

impl[t, n: static size] as-span[t = t] for *spill-list[t, n] {
  fn as-span(self): span[t] {
    if self.is-spilled() self.spilled.list.as-span()
    else self.inline.items.&.as-span().slice(0, self.len())
  }
}

impl[t, n: static size] print for spill-list[t, n] {
  fn print-to[w: writer](self, w) {
    if self.inline.len == spill-list/SPILLED {
      w.write("spilled ")
      self.spilled.list.len.print-to(w)
    } else {
      w.write("inline ")
      self.inline.len.print-to(w)
    }
  }
}

impl[n: static size] writer for *spill-list[u8, n] {
  fn write-byte(self, b: u8) {
    self.push(b)
  }
  fn write-bytes(self, b: span[u8]) {
    self.push-n(b)
  }
}
