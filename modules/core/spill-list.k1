type spill-list[t, n: static size] = either {
  inline(fixlist[t, n]),
  spilled(list[t])
}
ns for spill-list {

  fn new[t, n](): spill-list[t, n] {
    :inline mem/zeroed[fixlist[t, n]]()
  }

  // Retains allocated memory, if we've already spilled, intended for re-use
  fn clear[t, n](self: *mut spill-list[t, n]) {
    self is {
      :inline fixlist* -> fixlist.clear(),
      :spilled list* -> list.clear()
    }
  }

  fn len[t, n](self: *spill-list[t, n]): size {
    self is {
      :inline fixlist* -> fixlist.len(),
      :spilled list* -> list.len,
    }
  }

  fn _spill[t, n](fixlist: *mut fixlist[t, n]): list[t] {
    let list = list/with-capacity-in[t, _](mem/current-arena(), fixlist.cap() * 2)

    let srcbuffer = fixlist.as-buffer()
    list.append-buffer(srcbuffer)

    list
  }

  fn push[t, n](self: *mut spill-list[t, n], t: t) {
    self is {
      :spilled list* -> { list.push(t) },
      :inline fixlist* -> {
        if fixlist.try-push(t) is :ok .{}
        else {
          let list = _spill(fixlist)
  
          list.push(t)
  
          self.* = :spilled list
        }
      }
    }
  }

  fn push-n[t, n](self: *mut spill-list[t, n], ts: span[t]) {
    self is {
      :spilled list* -> { list.append-span(ts) },
      :inline fixlist* -> {
        if fixlist.try-push-n(ts) is :ok .{}
        else {
          // Correctness: The only error case is the out of capacity one
          let list = _spill(fixlist)
  
          list.append-span(ts)
  
          self.* = :spilled list
        }
      }
    }
  }

  fn push-string[n](self: *mut spill-list[u8, n], s: string) {
    self.push-n[u8, n](s.span-bytes())
  }

}

impl[t, n: static size] as-buffer[t = t] for *mut spill-list[t, n] {
  fn as-buffer(self): buffer[t] {
    self is {
      :spilled list* -> list.as-buffer(),
      :inline fixlist* -> fixlist.as-buffer()
    }
  }
}

impl[t, n: static size] as-span[t = t] for *spill-list[t, n] {
  fn as-span(self): span[t] {
    self is {
      :spilled list* -> list.as-span(),
      :inline fixlist* -> fixlist.as-span()
    }
  }
}

impl[t, n: static size] print for spill-list[t, n] {
  fn print-to[w: writer](self, w) {
     self is {
       :inline fix -> {
         w.write("inline ")
         fix.used.as[size].print-to(w)
       },
       :spilled list -> {
         w.write("spilled ")
         list.len.print-to(w)
       }
     }
  }
}

impl[n: static size] writer for *mut spill-list[u8, n] {
  fn write-byte(self, b: u8) {
    self.push(b)
  }
  fn write-bytes(self, b: span[u8]) {
    self.push-n(b)
  }
}
