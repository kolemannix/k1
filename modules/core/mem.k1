ability allocator {
  // alloc must return zeroed memory
  fn alloc(self, size: size, align: size): ptr

  fn realloc(self, old-ptr: ptr, old-size: size, align: size, new-size: size): ptr

  // free may no-op
  fn free(self, ptr: ptr, size: size, align: size)

  fn(inline) alloc-t[t](self): *t { allocator/alloc(self, types/size[t], types/align[t]).ref[t] }
  fn(inline) free-t[t](self, t: *t) { allocator/free(self, t.as(), types/size[t], types/align[t]) }
  fn(inline) new[t](self, t: t): *t {
    let ref = self.alloc-t[t]()
    ref.* = t
    ref
  }
}

type heap = {}
impl allocator for heap {
  fn alloc(_self: heap, size: size, _align: size): ptr { platform/heap/alloc(size) }
  fn realloc(_self: heap, old-ptr: ptr, _old-size: size, _align: size, new-size: size): ptr {
    platform/heap/realloc(old-ptr, new-size)
  }
  fn free(_self: heap, ptr: ptr, _size: size, _align: size) { platform/heap/free(ptr) }
}

ns mem {

  fn(inline) new[t](t: t): *t { current-arena().new(t) }

  fn(inline) read-unaligned[t](src: ptr): t {
    let value: t = .0
    copy-memcpy(value.&.as[ptr], src, types/size[t])
    value
  }

  fn(inline) write-unaligned[t](dst: ptr, value: t) {
    let v = value
    copy-memcpy(dst, v.&.as[ptr], types/size[t])
  }

  fn(inline) copy(dst: ptr, src: ptr, count: size) {
    if k1/is-static {
      copy-memcpy(dst, src, count)
    } else if count <= 64 {
      _move-short(dst, src, count)
    } else {
      copy-memcpy(dst, src, count)
    }
  }

  fn(inline) move(dst: ptr, src: ptr, count: size) {
    if k1/is-static {
      move-memmove(dst, src, count)
    } else if count <= 64 {
      _move-short(dst, src, count)
    } else {
      move-memmove(dst, src, count)
    }
  }

  fn(inline) set(dst: ptr, value: u8, count: size) {
    if k1/is-static {
      set-memset(dst, value, count)
    } else if count <= 16 {
      let word = value.widen[u64] * 0x0101010101010101
      if count >= 8 {
        write-unaligned(dst, word)
        write-unaligned(dst.add-bytes(count - 8), word)
      } else if count >= 4 {
        write-unaligned(dst, word.trunc[u32])
        write-unaligned(dst.add-bytes(count - 4), word.trunc[u32])
      } else if count > 0 {
        write-unaligned(dst, value)
        write-unaligned(dst.add-bytes(count / 2), value)
        write-unaligned(dst.add-bytes(count - 1), value)
      }
    } else if count <= 32 {
      let v = vector/splat[u8, 16](value)
      vector/store-unchecked(v, dst)
      vector/store-unchecked(v, dst.add-bytes(count - 16))
    } else if count <= 64 {
      let v = vector/splat[u8, 16](value)
      vector/store-unchecked(v, dst)
      vector/store-unchecked(v, dst.add-bytes(16))
      vector/store-unchecked(v, dst.add-bytes(count - 32))
      vector/store-unchecked(v, dst.add-bytes(count - 16))
    } else {
      set-memset(dst, value, count)
    }
  }

  fn(inline) _move-short(dst: ptr, src: ptr, count: size) {
    if count <= 16 {
      if count >= 8 {
        let a = read-unaligned[u64](src)
        let b = read-unaligned[u64](src.add-bytes(count - 8))
        write-unaligned(dst, a)
        write-unaligned(dst.add-bytes(count - 8), b)
      } else if count >= 4 {
        let a = read-unaligned[u32](src)
        let b = read-unaligned[u32](src.add-bytes(count - 4))
        write-unaligned(dst, a)
        write-unaligned(dst.add-bytes(count - 4), b)
      } else if count > 0 {
        let a = read-unaligned[u8](src)
        let b = read-unaligned[u8](src.add-bytes(count / 2))
        let c = read-unaligned[u8](src.add-bytes(count - 1))
        write-unaligned(dst, a)
        write-unaligned(dst.add-bytes(count / 2), b)
        write-unaligned(dst.add-bytes(count - 1), c)
      }
    } else if count <= 32 {
      let a = vector/load-unchecked[u8, 16](src)
      let b = vector/load-unchecked[u8, 16](src.add-bytes(count - 16))
      vector/store-unchecked(a, dst)
      vector/store-unchecked(b, dst.add-bytes(count - 16))
    } else {
      let a = vector/load-unchecked[u8, 16](src)
      let b = vector/load-unchecked[u8, 16](src.add-bytes(16))
      let c = vector/load-unchecked[u8, 16](src.add-bytes(count - 32))
      let d = vector/load-unchecked[u8, 16](src.add-bytes(count - 16))
      vector/store-unchecked(a, dst)
      vector/store-unchecked(b, dst.add-bytes(16))
      vector/store-unchecked(c, dst.add-bytes(count - 32))
      vector/store-unchecked(d, dst.add-bytes(count - 16))
    }
  }

  macro new-in-place[t](expr: code) {
    let type-id = types/id[t]
    `
    let addr = mem/alloc-t[${type-id.spell()}];
    addr.* = $expr
    addr
    `
  }

  macro with-arena(arena: code, expr: code) {
    `
    let start-len = mem/arena-stack-len()
    mem/push-arena($arena)
    defer {
      mem/pop-arena()
      assert-equals[size](mem/arena-stack-len(), start-len)
    }
    ($expr)
    `
  }

  fn(inline) alloc-layout(size: size, align: size): ptr { current-arena().alloc(size, align) }
  fn(inline) alloc-t[t](): *t { current-arena().alloc-t() }

  let(mutable, tls) arena-tmp: ptr = ptr/null

  type(alias) ALLOC_STACK_MAX = 64
  // Empty stack means "the tmp arena"; tmp is lazily initialized, so it
  // cannot be pushed here eagerly at thread start. Elements are raw ptrs:
  // reference-typed slots in global initializers do not serialize yet.
  let(mutable, tls) arena-stack: fixlist[ptr, ALLOC_STACK_MAX] = .0
  let(mutable, tls) arena-current: ptr = ptr/null

  fn push-arena(a: *arena) {
    arena-stack.push(a.as[ptr])
    arena-current = a.as[ptr]
  }
  fn pop-arena(): *arena {
    let popped = arena-stack.pop().!.ref[arena]
    arena-current = if arena-stack.last() is {
      :some a -> a,
      :none -> arena-tmp
    }
    popped
  }
  fn arena-stack-len(): size { arena-stack.len() }
  fn current-arena(): *arena {
    if arena-current is null { arena-current = tmp().as[ptr] }
    arena-current.ref[arena]
  }

  fn set-tmp-arena(arena: *arena) {
    arena-tmp = arena.as[ptr]
    if arena-stack.len() == 0 { arena-current = arena-tmp }
  }

  fn tmp(): *arena {
    if arena-tmp is null { init-tmp() }
    arena-tmp.ref[arena]
  }

  fn(cold) init-tmp() {
    arena-tmp = if k1/is-static arena/init-fixed(1073741824).as[ptr]
    else #if k1/platform is {
      :posix-macos or :posix-linux or :wasi -> arena/init-fixed(1073741824).as[ptr],
      :bare -> arena/init(1024 * 8).as[ptr]
    }
  }


  fn(inline) eq-blocks-at(buffer1: ptr, buffer2: ptr, offset-a: size, offset-b: size): bool {
    let lhs-a = vector/load-simd-bytes(buffer1.add-bytes(offset-a))
    let rhs-a = vector/load-simd-bytes(buffer2.add-bytes(offset-a))
    let lhs-b = vector/load-simd-bytes(buffer1.add-bytes(offset-b))
    let rhs-b = vector/load-simd-bytes(buffer2.add-bytes(offset-b))
    let a-eq = lhs-a.eq-lanes(rhs-a) 
    let b-eq = lhs-b.eq-lanes(rhs-b)
    let equal-lanes = a-eq & b-eq

    equal-lanes.to-mask() == u64/bitmask-low(k1/simd-bytes)
  }

  fn equals(p1: ptr, p2: ptr, len: size): bool {
    if k1/is-static return equals-memcmp(p1, p2, len)
    let w: size = k1/simd-bytes
    if len < 8 {
      let i = 0: size
      while i < len {
        if p1.add-bytes(i).ref[u8].* != p2.add-bytes(i).ref[u8].* return false
        i = i + 1
      }
      return true
    }
    if len < w {
      let t = len - 8
      let head = vector/load-word(p1) == vector/load-word(p2)
      let tail = vector/load-word(p1.add-bytes(t)) == vector/load-word(p2.add-bytes(t))
      return head and tail
    }
    if len < 2 * w return eq-blocks-at(p1, p2, 0, len - w)
    let i = 0: size
    while i + 2 * w <= len {
      if not eq-blocks-at(p1, p2, i, i + w) return false
      i = i + 2 * w
    }
    i == len or eq-blocks-at(p1, p2, len - 2 * w, len - w)
  }
}

// Positioned after the tls arena globals: global initializers run in decl
// order through the VM, which needs the tmp arena machinery evaluated first.
let heap: heap = .{}
