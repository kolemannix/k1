ability allocator {
  // alloc must return zeroed memory
  fn alloc(self, size: size, align: size): ptr

  fn realloc(self, old-ptr: ptr, old-size: size, align: size, new-size: size): ptr

  // free may no-op
  fn free(self, ptr: ptr, size: size, align: size)

  fn(inline) alloc-t[t](self): *mut t { allocator/alloc(self, types/size[t], types/align[t]).ref[t] }
  fn(inline) free-t[t](self, t: *mut t) { allocator/free(self, t.as(), types/size[t], types/align[t]) }
  fn(inline) new[t](self, t: t): *mut t {
    let ref = self.alloc-t[t]()
    ref.* = t
    ref
  }
}

type heap = {}
impl allocator for heap {
  fn alloc(_self: heap, size: size, _align: size): ptr { platform/heap/alloc(size) }
  fn realloc(_self: heap, old-ptr: ptr, _old-size: size, _align: size, new-size: size): ptr {
    platform/heap/realloc(old-ptr, new-size)
  }
  fn free(_self: heap, ptr: ptr, _size: size, _align: size) { platform/heap/free(ptr) }
}

ns mem {

  fn(inline) new[t](t: t): *t { current-arena().new(t) }

  macro new-in-place[t](expr) {
    let type-id = types/id[t]
    `
    let addr = mem/alloc-t[${type-id.spell()}];
    addr.* = $expr
    addr
    `
  }

  macro with-arena(arena, expr) {
    `
    let start-len = mem/arena-stack-len()
    mem/push-arena($arena)
    defer {
      mem/pop-arena()
      assert-equals[size](mem/arena-stack-len(), start-len)
    }
    ($expr)
    `
  }

  fn(inline) alloc-layout(size: size, align: size): ptr { current-arena().alloc(size, align) }
  fn(inline) alloc-t[t](): *t { current-arena().alloc-t() }

  let(mutable, tls) arena-tmp: *arena = ptr/null.ref[arena]

  type(alias) ALLOC_STACK_MAX = 64
  // Empty stack means "the tmp arena"; tmp is lazily initialized, so it
  // cannot be pushed here eagerly at thread start. Elements are raw ptrs:
  // reference-typed slots in global initializers do not serialize yet.
  let(mutable, tls) arena-stack: fixlist[ptr, ALLOC_STACK_MAX] =
    zeroed[fixlist[ptr, ALLOC_STACK_MAX]]
  let(mutable, tls) arena-current: *arena = ptr/null.ref[arena]

  fn push-arena(a: *arena) {
    arena-stack.push(a.as[ptr])
    arena-current = a
  }
  fn pop-arena(): *arena {
    let popped = arena-stack.pop().!.ref[arena]
    arena-current = if arena-stack.last() is {
      :some a -> a.ref[arena],
      :none -> arena-tmp
    }
    popped
  }
  fn arena-stack-len(): size { arena-stack.len() }
  fn current-arena(): *arena {
    if arena-current is null { arena-current = tmp() }
    arena-current
  }

  fn set-tmp-arena(arena: *arena) {
    arena-tmp = arena
    if arena-stack.len() == 0 { arena-current = arena }
  }

  fn tmp(): *arena {
    if arena-tmp is null { init-tmp() }
    arena-tmp
  }

  fn(cold) init-tmp() {
    #if k1/platform is {
      :posix-macos or :posix-linux or :wasi -> {
        arena-tmp = arena/init-fixed(1073741824)
      },
      :bare -> {
        arena-tmp = arena/init(1024 * 8)
      }
    }
  }

}

// Positioned after the tls arena globals: global initializers run in decl
// order through the VM, which needs the tmp arena machinery evaluated first.
let heap: heap = .{}
