// Represents a contiguously allocated segment of memory that
// stores values of type t.

// spans are read-only.

// You should never modify the contents
// of the data pointed to by a span unless you know you have
// exclusive access to the data (e.g., just created it) 
// and never break the contract that no observable
// span contents should ever change
ns for span {
  
  ////////////////////////
  // Constructor functions

  // Only safe if you have exclusive access to buffer
  fn(inline) wrap-buffer[t](buffer: buffer[t]): span[t] {
    .{ buffer }
  }

  fn(inline) wrap-raw[t](ptr, len: size): span[t] {
    .{ buffer = buffer/wrap-raw(ptr, len) }
  }

  fn(inline) wrap-ref[t](base: *t, len: size): span[t] {
    .{ buffer = buffer/wrap-ref(base, len) }
  }

  fn(inline) inner-buffer[t](self: span[t]): buffer[t] {
    self.buffer
  }

  fn(inline) data-ptr[t](self: span[t]): ptr {
    self.buffer.data-ptr()
  }
  fn data-ref[t](self: span[t]): *t {
    self.buffer.data-ref()
  }

  fn(inline) empty[t](): span[t] { .0 }

  fn from-array[t, n: static size](array: *array[t, n]): span[t] {
    let buffer = buffer/from-array[t, n](array)
    .{ buffer }
  }

  fn single[t](t): span[t] {
    let buf = buffer/allocate[t](1)
    buf.[0] = t
    wrap-buffer(buf)
  }
  
  macro single-on-stack[t](value: code) {
    let type-id = types/id[t]
    `
    let data: array[${type-id.spell()}, 1] = uninit
    data.[0] = $value
    data.as-span()
    `
  }

  fn wrap-single[t](*t): span[t] {
    wrap-raw(t.as[ptr], 1)
  }

  fn(inline) cloned[t](self: span[t]): span[t] {
    .{ buffer = self.buffer.cloned() }
  }

  fn(inline) cloned-in[t, a: allocator](self: span[t], a): span[t] {
    .{ buffer = self.buffer.cloned-in(a) }
  }

  fn to-array[t, n: static size](self: span[t]): array[t, n] {
    array/from-buffer[t, n](self.buffer)
  }

  fn(inline) slice[t](self: span[t], start: size, end: size): span[t] {
    .{ buffer = self.buffer.slice(start, end) }
  }
  fn(inline) take[t](self: span[t], count: size): span[t] { .{ buffer = self.buffer.take(count) } }
  fn(inline) drop[t](self: span[t], count: size): span[t] { .{ buffer = self.buffer.drop(count) } }

  fn map[t, u](self: span[t], f: some fn t -> u): span[u] {
    let buf = buffer/allocate[u](self.len())
    for x in self { buf.[it-index] = f(x) }
    wrap-buffer(buf)
  }

  fn first-ref[t](self: span[t]): ?*t {
    if self.non-empty() {
      :some self.[0].&
    } else {
      :none
    }
  }

  fn last-ref[t](self: span[t]): ?*t {
    if self.non-empty() {
      :some self.[self.len() - 1].&
    } else {
      :none
    }
  }

  fn concat[t](self: span[t], other: span[t]): span[t] {
    let concated-buffer = self.inner-buffer().concat(other.inner-buffer())
    wrap-buffer(concated-buffer)
  }

  fn join[t, c: as-span[t = span[t]]](items: c, separator: span[t]): span[t] {
    let spans = items.as-span()
    if spans.is-empty() return empty()
    let total = separator.len() * (spans.len() - 1)
    for s in spans { total = total + s.len() }
    let buf = buffer/allocate[t](total)
    let pos: size = 0
    for s in spans {
      if it-index > 0 {
        buffer/copy(src = separator.inner-buffer(), dst = buf.slice(pos, pos + separator.len()))
        pos = pos + separator.len()
      }
      buffer/copy(src = s.inner-buffer(), dst = buf.slice(pos, pos + s.len()))
      pos = pos + s.len()
    }
    wrap-buffer(buf)
  }

  fn write-hex[w: writer](self: span[u8], w, upper: bool) {
    for b in self { b.write-hex(w, upper) }
  }

  fn to-hex(self: span[u8]): string {
    let sb = string-builder/with-capacity(self.len() * 2)
    self.write-hex(sb.&, upper = false)
    sb.build()
  }

  fn from-hex(s: string): ?span[u8] {
    if s.len() % 2 != 0 return :none
    let buf = buffer/allocate[u8](s.len() / 2)
    let i: size = 0
    while i < s.len() {
      require s.[i].to-ascii-hex-digit() is :some hi else return :none
      require s.[i + 1].to-ascii-hex-digit() is :some lo else return :none
      buf.[i / 2] = hi * 16 + lo
      i = i + 2
    }
    :some wrap-buffer(buf)
  }

  fn write-base64[w: writer](self: span[u8], w) {
    let digits = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let i: size = 0
    while i < self.len() {
      let b0 = self.[i].as-size()
      let b1 = if i + 1 < self.len() self.[i + 1].as-size() else 0
      let b2 = if i + 2 < self.len() self.[i + 2].as-size() else 0
      w.write-char(digits.[b0 >> 2])
      w.write-char(digits.[((b0 & 3) << 4) + (b1 >> 4)])
      w.write-char(if i + 1 < self.len() digits.[((b1 & 15) << 2) + (b2 >> 6)] else '=')
      w.write-char(if i + 2 < self.len() digits.[b2 & 63] else '=')
      i = i + 3
    }
  }

  fn to-base64(self: span[u8]): string {
    let sb = string-builder/with-capacity((self.len() + 2) / 3 * 4)
    self.write-base64(sb.&)
    sb.build()
  }

  fn from-base64(s: string): ?span[u8] {
    if s.len() % 4 != 0 return :none
    let padding: size = if s.ends-with("==") 2 else if s.ends-with("=") 1 else 0
    let buf = buffer/allocate[u8](s.len() / 4 * 3 - padding)
    let bits: size = 0
    let bit-count: u32 = 0
    let written: size = 0
    for s.take(s.len() - padding) {
      require it.to-base64-digit() is :some digit else return :none
      bits = ((bits & 4095) << 6) + digit.as-size()
      bit-count = bit-count + 6
      if bit-count >= 8 {
        bit-count = bit-count - 8
        buf.[written] = ((bits >> bit-count) & 255).low[u8]
        written = written + 1
      }
    }
    :some wrap-buffer(buf)
  }

  fn as-char-span(self: span[byte]): span[char] {
    .{ buffer = self.buffer.as-char-buffer() }
  }

  fn as-byte-span(self: span[char]): span[byte] {
    .{ buffer = self.buffer.as-byte-buffer() }
  }

  fn(inline) ref-iter[t](self: span[t]): buffer-ref-iterator[t] {
    buffer-ref-iterator/from-buffer(self.buffer)
  }

}

impl[t] as-span[t = t] for span[t] {
  fn(inline) as-span(self): span[t] { self }
}

impl[t] index[key = size, t = t] for span[t] {
  fn(inline) index-ref(self, key: size): *t { self.buffer.data.ref-at[t](checked-index(key, self.buffer.len)) }
}

impl[t] iterable[item = t, i = buffer-iterator[t]] for span[t] {
  fn(inline) iterator(self): i { .{ buf = self.buffer, pos = 0 } }
}

impl[t: print] print for span[t] {
  fn print-to[w: writer](self, w): empty {
    w.write-char('[')
    w.join(self, ",")
    w.write-char(']')
  }
}

impl[t: equals] equals for span[t] {
  fn equals(self: span[t], other: span[t]): bool {
    self.buffer == other.buffer
  }
}

