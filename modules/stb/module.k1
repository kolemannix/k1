ns build {
  use std/process

  fn module(): k1/module {
    let m = k1/module/new()
    m.lib("stb", :static)
    m.setup(["libs/libstb.a", "c.k1"], ["stb.c", "vendor"])
    m
  }

  fn setup(_ctx: k1/setup-ctx) {
    let minver = if k1/platform-macos "-mmacosx-version-min=15.0.0" else ""
    let script = `
      set -e
      mkdir -p libs .k1-out/stb
      cc -O2 ${minver} -c stb.c -o .k1-out/stb/stb.o
      ar rcs libs/libstb.a .k1-out/stb/stb.o
      `
    process/run-command("/bin/sh", ["-c", script], :inherit).!

    let bindgen-args: list[string] = [
      "-in-path", "vendor/stb_truetype.h",
      "-out-path", "c.k1",
      "-lib-name", "stb",
      "-ns-name", "c",
      "+strip-prefix", "stbtt_",
    ]
    if k1/platform-macos {
      let sdk = process/run("/bin/sh", ["-c", "printf %s $(xcrun --sdk macosx --show-sdk-path)"]).!
      bindgen-args.push("+clangarg")
      bindgen-args.push("-isysroot")
      bindgen-args.push("+clangarg")
      bindgen-args.push(sdk)
    }
    let _ = process/run-command("k1bindgen", bindgen-args.as-span(), :inherit).!
  }
}
