use std/process

fn module(): k1/module {
  .0 | .{
    link = [.{ name = "stb", link-type = :static }],
    setup-inputs = ["stb.c", "vendor"],
    setup-outputs = ["libs/libstb.a", "c.k1"],
  }
}

fn setup(ctx: k1/setup-ctx) {
  let minver = if (ctx.build.target is :arm64-macos) "-mmacosx-version-min=15.0.0" else ""
  process/sh-verbose(`
    mkdir -p libs .k1-out/stb
    cc -O2 ${minver} -c stb.c -o .k1-out/stb/stb.o
    ar rcs libs/libstb.a .k1-out/stb/stb.o
    `).!

  let bindgen-args: list[string] = [
    "-in-path", "vendor/stb_truetype.h",
    "-out-path", "c.k1",
    "-lib-name", "stb",
    "-ns-name", "c",
    "+strip-prefix", "stbtt_",
  ]
  let _ = process/run-verbose("k1bindgen", bindgen-args.as-span()).!
}
