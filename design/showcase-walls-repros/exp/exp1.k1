let fifteen: int = { 3 * 5 }
let name: string = {
  let a = "k"
  a.concat("1")
}
#static {
  assert-equals(types/id[fifteen], types/id[15])
  assert-equals(types/id[name], types/id["k1"])
}

fn main(): i32 {
  println(types/id[fifteen].name())
  println(types/id[name].name())
  let point = #static .{ x = 3 * 4, y = 5 - 3 }
  (point.x: 12)
  (point.y: 2)
  println(types/id[type-of(point)].name())
  0
}
