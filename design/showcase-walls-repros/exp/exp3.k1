fn crc32-table(): array[u32, 256] {
  let table: array[u32, 256] = .0
  for n in 0.until(256) {
    let c = n.trunc[u32]
    for 0.until(8) {
      c = if (c & 1) == 1 0xEDB88320 ^ (c >> 1) else c >> 1
    }
    table.[n] = c
  }
  table
}

let CRC_TABLE: array[u32, 256] = #static crc32-table()

fn crc32(bytes: span[u8]): u32 {
  let c = 0xFFFFFFFF: u32
  for b in bytes {
    c = CRC_TABLE.[((c ^ b.widen[u32]) & 0xFF)] ^ (c >> 8)
  }
  c ^ 0xFFFFFFFF
}

#static assert-equals(crc32("123456789".span-bytes()), 0xCBF43926)

fn main(argc: core/c-int, argv: ptr): i32 {
  let check: 0xCBF43926 = #static crc32("123456789".span-bytes())
  let args = std/sys/parse-main-args(argc, argv)
  for a in args.drop(1) {
    println("crc32(\"$a\") = ${crc32(a.span-bytes())}")
  }
  println("is-static: ${core/k1/is-static}, table.[1] = ${CRC_TABLE.[1]}")
  0
}
