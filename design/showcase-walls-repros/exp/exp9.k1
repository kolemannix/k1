fn pow[n: static int](x: int): int {
  let n: int = core/meta/static-type-to-value[_, n]()
  let acc = 1
  for 0.until(n) {
    acc = acc * x
  }
  acc
}

fn where-am-i(): string {
  if core/k1/is-static "compile time" else "run time"
}

fn main(): i32 {
  println("${pow[3](2)}")
  let a: "compile time" = #static where-am-i()
  println(a.from-static())
  println(where-am-i())
  #static println("printed while compiling")
  0
}
