let fifteen: int = { 3 * 5 }
let name: string = {
  let a = "k"
  a.concat("1")
}
#static {
  assert-equals(types/id[fifteen], types/id[15])
  assert-equals(types/id[name], types/id["k1"])
}

fn main(): i32 {
  println("a")
  println(types/id[fifteen].name())
  println("b")
  println(types/id[name].name())
  println("c")
  0
}
