$pre/gen/define(hi, "abc")

fn main(): i32 {
  println(hi())
  println(pre/gen/emit("tiny", "xyz").text())
  let f: f64 = 12345.0 / 7.0
  println("f = $f")
  0
}

ns pre { ns gen {
  fn emit(name: string, body: string): code {
    let cb-storage = code-builder/new()
    let cb = cb-storage.&
    cb.block("fn $name(): string", fn[cb, body]. {
      cb.line("${core/meta/str-lit(body)}")
    })
    cb.build()
  }
  #debug macro define(name, body: string) {
    emit(name.text(), body)
  }
}}
