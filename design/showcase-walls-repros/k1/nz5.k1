type empty-marker = {}
fn main(): i32 {
  println("size of {}: ${types/size[{}]}, empty-marker: ${types/size[empty-marker]}, array[{}, 1000]: ${types/size[array[{}, 1000]]}")
  println("size of result[{}, {}]: ${types/size[result[{}, {}]]}, ?{}: ${types/size[?{}]}")
  println("size of result[u32, string]: ${types/size[result[u32, string]]}, result[u32, never]: ${types/size[result[u32, never]]}, result[u32, {}]: ${types/size[result[u32, {}]]}")
  println("size of never: ${types/size[never]}, *never: ${types/size[*never]}, string: ${types/size[string]}")
  println("${types/schema[never] is :never} ${types/name[never]} ${types/name[result[u32, never]]}")
  let markers: array[empty-marker, 4] = [.{}, .{}, .{}, .{}]
  println("${markers.len()} markers in ${types/size[array[empty-marker, 4]]} bytes")
  0
}
