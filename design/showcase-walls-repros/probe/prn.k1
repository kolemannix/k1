$pre/regex/define(ident, "[A-Za-z_][A-Za-z0-9_]*")
$pre/regex/define(number, "[0-9]+([.][0-9]+)?")
$pre/regex/define(email, "[a-z0-9._+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z][a-z]+")

fn report(name: string, hit: bool, s: string) {
  let verdict = if hit "match   " else "no match"
  println("$name $verdict \"$s\"")
}

fn main(): i32 {
  for s in ["foo_bar", "x9", "_", "9x", "", "a-b"] { report("ident ", ident(s), s) }
  for s in ["42", "3.14", "0.0", "3.", ".5", "1e5"] { report("number", number(s), s) }
  for s in ["a.b@c.io", "x+y@mail.example.org", "no-at.com", "a@b", "a@b.c"] { report("email ", email(s), s) }

  let line = "total: 12.5 units, 3 left"
  if number-find(line) is :some m {
    println("first number in \"$line\": ${line.slice(m.start, m.end)} at ${m.start}..${m.end}")
  }
  println("ident-find in \"  42abc\": ${ident-find("  42abc")}")
  println("email-find in \"nothing here\": ${email-find("nothing here")}")
  0
}

ns pre { ns regex {

type edge = { lo: size, hi: size, next: size }
type nstate = { eps: list[size], edge: ?edge }
type frag = { start: size, end: size }
type parser = { pat: string, pos: size, nfa: list[nstate] }

ns for parser {
  fn peek(self: parser): ?char { self.pat.index-opt(self.pos) }

  fn next(self: *parser): char {
    require self.peek() is :some c else self.fail("unexpected end of pattern")
    self.pos = self.pos + 1
    c
  }

  fn eat(self: *parser, c: char): bool {
    if self.peek() is :some x and x == c { self.pos = self.pos + 1; true } else false
  }

  fn fail(self: parser, msg: string): never {
    crash("regex `${self.pat}` at offset ${self.pos}: $msg")
  }

  fn state(self: *parser): size {
    self.nfa.push(.{ eps = [], edge = :none })
    self.nfa.len() - 1
  }

  fn eps(self: *parser, from: size, to: size) { self.nfa.[from].eps.push(to) }

  fn range(self: *parser, lo: size, hi: size): frag {
    if lo > hi self.fail("bad range")
    let end = self.state()
    self.nfa.push(.{ eps = [], edge = :some .{ lo, hi, next = end } })
    .{ start = end + 1, end }
  }

  fn alt(self: *parser): frag {
    let f = self.concat()
    while self.eat('|') {
      let g = self.concat()
      let s = self.state()
      let e = self.state()
      self.eps(s, f.start)
      self.eps(s, g.start)
      self.eps(f.end, e)
      self.eps(g.end, e)
      f = .{ start = s, end = e }
    }
    f
  }

  fn concat(self: *parser): frag {
    let start = self.state()
    let end = start
    while self.peek() is :some c and c != '|' and c != ')' {
      let g = self.repeat()
      self.eps(end, g.start)
      end = g.end
    }
    .{ start, end }
  }

  fn repeat(self: *parser): frag {
    let f = self.atom()
    loop {
      if self.eat('*') {
        let s = self.state()
        self.eps(s, f.start)
        self.eps(f.end, s)
        f = .{ start = s, end = s }
      } else if self.eat('+') self.eps(f.end, f.start)
      else if self.eat('?') self.eps(f.start, f.end)
      else break
    }
    f
  }

  fn atom(self: *parser): frag {
    let c = self.next()
    if c is {
      '(' -> {
        let f = self.alt()
        if not self.eat(')') self.fail("expected `)`")
        f
      },
      '[' -> self.class(),
      '.' -> self.range(0, 255),
      '\\' -> { let e = self.next(); self.range(e.as-u8(), e.as-u8()) },
      '*' or '+' or '?' -> self.fail("nothing to repeat"),
      _ -> self.range(c.as-u8(), c.as-u8()),
    }
  }

  fn class(self: *parser): frag {
    let s = self.state()
    let e = self.state()
    while not self.eat(']') {
      let lo = self.next()
      let ranged = self.peek() is :some '-' and self.pat.index-opt(self.pos + 1) != :some ']'
      let hi = if ranged { self.pos = self.pos + 1; self.next() } else lo
      let r = self.range(lo.as-u8(), hi.as-u8())
      self.eps(s, r.start)
      self.eps(r.end, e)
    }
    .{ start = s, end = e }
  }
}

type dfa = { rows: list[list[?size]], accept: list[bool] }

fn closure(nfa: list[nstate], seed: list[size]): list[size] {
  let set = seed
  let i = 0
  while i < set.len() {
    for t in nfa.[set.[i]].eps { if not set.contains(t) set.push(t) }
    i = i + 1
  }
  set.sort()
  set
}

fn build(nfa: list[nstate], start: size, accept: size): dfa {
  let sets: list[list[size]] = [closure(nfa, [start])]
  let d: dfa = .{ rows = [], accept = [] }
  let i = 0
  while i < sets.len() {
    let set = sets.[i]
    d.accept.push(set.contains(accept))
    let row = list/with-capacity[?size](256)
    for b in 0.until(256) {
      let moved = list/empty[size]()
      for n in set {
        if nfa.[n].edge is :some e and b >= e.lo and b <= e.hi { moved.push(e.next) }
      }
      row.push(if moved.is-empty() :none else {
        let target = closure(nfa, moved)
        :some(sets.position(target) ? { sets.push(target); sets.len() - 1 })
      })
    }
    d.rows.push(row)
    i = i + 1
  }
  d
}

fn relabel(row: list[?size], group: list[size]): list[?size] {
  let out = list/with-capacity[?size](row.len())
  for t in row { out.push(t.map(fn[group] j. group.[j])) }
  out
}

fn minimize(d: dfa): dfa {
  let n = d.rows.len()
  let group = list/filled(n, 0: size)
  let count: size = 1
  loop {
    let sigs = list/empty[list[?size]]()
    let next = list/empty[size]()
    for i in 0.until(n) {
      let sig = relabel(d.rows.[i], group)
      sig.push(:some(group.[i]))
      sig.push(if d.accept.[i] :some 1 else :none)
      next.push(sigs.position(sig) ? { sigs.push(sig); sigs.len() - 1 })
    }
    group = next
    if sigs.len() == count break
    count = sigs.len()
  }
  let m: dfa = .{ rows = list/filled(count, []), accept = list/filled(count, false) }
  for i in 0.until(n) {
    let k = group.[i]
    if m.rows.[k].is-empty() {
      m.rows.[k] = relabel(d.rows.[i], group)
      m.accept.[k] = d.accept.[i]
    }
  }
  m
}

fn compile(pat: string): dfa {
  let p: parser = .{ pat, pos = 0, nfa = [] }
  let f = p.alt()
  if p.pos < pat.len() p.fail("unbalanced `)`")
  let d = minimize(build(p.nfa, f.start, f.end))
  if not d.accept.contains(true) p.fail("matches nothing")
  d
}

fn char-lit(b: size): string {
  let c = b.trunc[u8].as-char()
  if c is {
    '\'' -> "'\\''",
    '\\' -> "'\\\\'",
    '\n' -> "'\\n'",
    '\t' -> "'\\t'",
    '\r' -> "'\\r'",
    _ -> if b >= 32 and b < 127 "'$c'" else "($b: u8).as-char()",
  }
}

fn cond(lo: size, hi: size): string {
  if lo == hi "c == ${char-lit(lo)}"
  else if lo == 0 "c <= ${char-lit(hi)}"
  else if hi == 255 "c >= ${char-lit(lo)}"
  else "(c >= ${char-lit(lo)} and c <= ${char-lit(hi)})"
}

fn cover(row: list[?size], j: size): string {
  let conds = list/empty[string]()
  let b: size = 0
  while b < 256 {
    let lo = b
    while b < 256 and row.[b] == row.[lo] { b = b + 1 }
    if row.[lo] == :some j conds.push(cond(lo, b - 1))
  }
  string/join(conds, " or ")
}

fn arm(row: list[?size]): string {
  let targets = list/empty[size]()
  for t in row { if t is :some j and not targets.contains(j) targets.push(j) }
  let full = not row.contains(:none)
  let sb = string-builder/new()
  for j in targets {
    let last = it-index + 1 == targets.len()
    if full and last sb.write("$j") else sb.write("if ${cover(row, j)} $j else ")
  }
  if not full sb.write("break")
  sb.build()
}

fn emit(name: string, d: dfa): code {
  let accepting = list/empty[string]()
  for a in d.accept { if a accepting.push("state == ${it-index}") }
  let init = if d.accept.[0] ":some 0" else ":none"
  let cb-storage = code-builder/new()
  let cb = cb-storage.&
  cb.block("fn ${name}-scan(s: string): ?size", fn[cb, d, accepting, init]. {
    cb.line("let state = 0")
    cb.line("let end: ?size = $init")
    cb.block("for c in s", fn[cb, d, accepting]. {
      cb.block-close("state = if state is", "}", fn[cb, d]. {
        for row in d.rows { cb.line("${it-index} -> ${arm(row)},") }
        cb.line("_ -> break,")
      })
      cb.line("if ${string/join(accepting, " or ")} { end = :some(it-index + 1) }")
    })
    cb.line("end")
  })
  cb.block("fn $name(s: string): bool", fn[cb, name]. {
    cb.line("${name}-scan(s) is :some n and n == s.len()")
  })
  cb.block("fn ${name}-find(s: string): ?{ start: size, end: size }", fn[cb, name]. {
    cb.block("for start in 0.until(s.len() + 1)", fn[cb, name]. {
      cb.line("if ${name}-scan(s.drop(start)) is :some n { return :some .{ start, end = start + n } }")
    })
    cb.line(":none")
  })
  cb.build()
}

macro define(name: code, pattern: string) {
  let c = emit(name.text(), compile(pattern))
  println(c.text())
  c
}

}}
