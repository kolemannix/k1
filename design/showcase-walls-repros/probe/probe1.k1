type nstate = { eps: list[size], set: array[bool, 256], next: size }

fn scan(s: string): ?size {
  let state = 0
  let end: ?size = :none
  for c in s {
    state = if state is {
      0 -> if (c >= 'A' and c <= 'Z') or c == '_' or (c >= 'a' and c <= 'z') 1 else break,
      1 -> if (c >= '0' and c <= '9') or c == '_' or (c >= 'a' and c <= 'z') 1 else break,
      _ -> break,
    }
    if state == 1 { end = :some(it-index + 1) }
  }
  end
}

fn main(): i32 {
  let st: nstate = .{ eps = [], set = .0, next = 0 }
  st.set.[97] = true
  let states: list[nstate] = [st]
  states.[0].set.[98] = true
  let b: size = 98
  println("${states.[0].set.[b]} ${states.[0].set.[99]}")
  for i in 0.until(256) {
    if states.[0].set.[i] { println("set $i") }
  }
  let sets: list[list[size]] = [[1, 2], [3]]
  let key: list[size] = [3]
  let j = sets.position(key) ? { sets.push(key); sets.len() - 1 }
  println("j=$j")
  let k = sets.position([9]) ? { sets.push([9]); sets.len() - 1 }
  println("k=$k ${sets.len()}")
  let xs: list[size] = [5, 2, 9]
  xs.sort()
  println("${xs}")
  println("${scan("abc_1")} ${scan("1abc")} ${scan("ab-")} ${scan("")}")
  let os: ?size = :some 3
  println("${os == :some 3}")
  0
}
