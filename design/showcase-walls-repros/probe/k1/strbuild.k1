let N: int = 10000
let COMPTIME: bool = true

fn fnv1a(s: string): u32 {
  let h: u32 = 2166136261
  for c in s {
    h = (h ^ c.as-u8().widen[u32]) * 16777619
  }
  h
}

fn build(): { len: int, sum: u32 } {
  let sb = string-builder/new()
  for i in 0.until(N) {
    if i > 0 sb.write(",")
    sb.write("${}", i)
  }
  let s = sb.build()
  .{ len = s.len(), sum = fnv1a(s) }
}

fn main(): i32 {
  let r: { len: int, sum: u32 } = #if COMPTIME { #static build() } else { build() }
  println("${r.len} ${r.sum}")
  0
}
