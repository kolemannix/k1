[core.k1:26 info] fn ident-scan(s: string): ?size {
  let state = 0
  let end: ?size = :none
  for c in s {
    state = if state is {
      0 -> if (c >= 'A' and c <= 'Z') or c == '_' or (c >= 'a' and c <= 'z') 1 else break,
      1 -> if (c >= '0' and c <= '9') or (c >= 'A' and c <= 'Z') or c == '_' or (c >= 'a' and c <= 'z') 1 else break,
      _ -> break,
    }
    if state == 1 { end = :some(it-index + 1) }
  }
  end
}
fn ident(s: string): bool {
  ident-scan(s) is :some n and n == s.len()
}
fn ident-find(s: string): ?{ start: size, end: size } {
  for start in 0.until(s.len() + 1) {
    if ident-scan(s.drop(start)) is :some n { return :some .{ start, end = start + n } }
  }
  :none
}

