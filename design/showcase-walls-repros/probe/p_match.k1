type shape = either { circle(f64), square(f64), tri({ a: f64, b: f64, c: f64 }) }

fn classify(s: shape): string {
  if s is {
    :circle r if r > 10.0 -> "big circle",
    :circle _ -> "circle",
    :square _ or :tri _ -> "polygon",
  }
}

fn inspect[t](v: t): string {
  if v is {
    type[int](0) -> "zero",
    type[int](n) -> "int $n",
    type[string](s) -> "str $s",
    _ -> "other",
  }
}

fn main(): i32 {
  println(classify(:circle 12.0))
  println(classify(:tri .{ a = 1.0, b = 1.0, c = 1.0 }))
  println(inspect(0)); println(inspect(9)); println(inspect("hi")); println(inspect(true))
  let r: result[int, string] = :ok 1
  let rr = r.&
  if rr is :ok(v)* { v.* = v.* + 41 }
  println(r)
  let b: ***bool = mem/new(mem/new(mem/new(true)))
  println(b is true***)
  require r is :ok n else { crash("no") }
  println(n)
  0
}
