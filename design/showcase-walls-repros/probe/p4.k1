type node = { name: string, children: list[node] }

fn do-it(input: string, count: u32): bool { count > 0 and input.len() > 0 }

fn count[t](v: t): int {
  #meta {
    let cb = code-builder/new()
    if types/schema[t] is {
      :struct .{ fields } -> {
        cb.line("let n = 1")
        for f in fields { cb.line(`n = n + count(v.${f.name})`) }
        cb.line("n")
      },
      :string -> cb.line("0"),
      _ -> {
        if types/id[t].is-instance-of(types/id[list]) {
          cb.line("let n = 0")
          cb.line("for v { n = n + count(it) }")
          cb.line("n")
        } else crash("unsupported")
      }
    }
    k1/emit-compiler-message(k1/location(), :info, "count[${types/name[t]}]:\n${cb.build().text()}")
    cb.build()
  }
}

fn main(): i32 {
  let tree: node = .{ name = "root", children = [.{ name = "a", children = [] }, .{ name = "b", children = [] }] }
  println("${count(tree)}")
  let s = types/schema[do-it]
  require s is :function .{ params, return-type-id } else crash("not fn")
  for p in params { println("${p.name}: ${p.type-id.name()}") }
  println("-> ${return-type-id.name()}")
  println(types/id[node].name())
  println("${types/schema[node].as-struct().!.fields.[1].type-id.name()}")
  0
}
