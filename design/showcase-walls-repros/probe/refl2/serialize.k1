fn write-json-of(code: *string-builder, name: string, type-id: types/type-id) {
  if type-id == types/id[string] {
    code.writeln(`w.write-char('"'); w.write($name); w.write-char('"');`)
    return
  }
  if type-id.schema() is {
    :struct s -> {
      code.writeln("w.write-char('{');")
      for f in s.fields {
        if it-index > 0 code.writeln(`w.write(",");`)
        code.writeln(`w.write("\"${f.name}\":");`)
        write-json-of(code, `$name.${f.name}`, f.type-id)
      }
      code.writeln("w.write-char('}');")
    },
    :bool -> code.writeln(`w.write(if $name "true": string else "false");`),
    :int _ -> code.writeln(`$name.print-to(w);`),
    _ -> crash("unsupported type ${type-id.name()}")
  }
}

fn write-json[t, w: writer](context w)(t: t) {
  #meta {
    let code = string-builder/new()
    write-json-of(code.&, "t", types/id[t]())
    code/from-string(code.build())
  }
}

fn to-json[t](t: t): string {
  let sb = string-builder/new()
  write-json(context sb.&)(t)
  sb.build()
}

fn main(): i32 {
  println("${serialize-all()}")
  0
}


type t0 = { f0: i32, f1: u8, f2: bool, f3: string, f4: i64, f5: u16, f6: u32, f7: i8 }
type t1 = { f0: u8, f1: bool, f2: string, f3: i64, f4: u16, f5: u32, f6: i8, f7: i32 }

fn serialize-all(): int {
  let total = 0
  total = total + to-json(t0.{ f0 = 0, f1 = 1, f2 = true, f3 = "s0_3", f4 = 4, f5 = 5, f6 = 6, f7 = 7 }).len()
  total = total + to-json(t1.{ f0 = 8, f1 = true, f2 = "s1_2", f3 = 11, f4 = 12, f5 = 13, f6 = 14, f7 = 15 }).len()
  total
}
