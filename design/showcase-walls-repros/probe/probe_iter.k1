let RAMP: array[int, 3] = #static {
  let r: array[int, 3] = .0
  for i in 0.until(3) { r.[i] = i * 2 }
  r
}

let PAIRS: span[{ name: string, v: int }] = [.{ name = "a", v = 1 }, .{ name = "b", v = 2 }]

#static for PAIRS {
  if it.v > 5 crash("${it.name} too big")
}

fn main(): i32 {
  for RAMP { println("val $it") }
  for RAMP.& { println("ref $it") }
  0
}
