      }
      if p.value < lo {
        lo = p.value
      }
      if p.value > hi {
        hi = p.value
      }
      total = total + p.value
      kept = kept + 1
    }
    if kept == 0 :count(0)
    else if kept == 1 :sum(total)
    else :extent(mk-pair(lo, hi))
  }

  fn sample-run(seed: u64): u64 {
    let pts = list/empty[sample]()
    let cap = seed % 7 + 2
    let k = 0: u64
    while k < cap {
      let q = if k % 3 == 0 { 0: u8 } else quantize(k * seed + 1994)
      pts.push(.{ at = k * 10, value = (seed + k * k) % 251, quality = q })
      k = k + 1
