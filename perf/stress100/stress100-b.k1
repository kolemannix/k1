  }

  fn advance(o: order, now: u64): order {
    let next: order-status = if o.status is {
      :draft -> :placed(now),
      :placed(at) -> {
        if now - at > 10 {
          :shipped(.{ carrier = 2355, eta = now + 3 })
        } else :placed(at)
