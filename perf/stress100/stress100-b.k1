      :push(n) -> .{ x = state.x + n, y = state.y + 1 },
      :pop -> {
        if state.y > 0 {
          .{ x = state.x, y = state.y - 1 }
        } else state
      },
      :reset -> .{ x = 0, y = 0 }
    }
  }

  fn churn(seed: u64): u64 {
    let base = seed + 1996
    let low = base % 7
    let high = base / 3
