      :some(:credit(n)) -> n,
      :some(_) -> 1,
      :none -> 0
    }
    let late = if o.status is { :delivered(at) -> at % 13, _ -> 0 }
    acct.balance + bonus + late
  }

  fn quantize(v: u64): u8 {
    if v < 10 0: u8
    else if v < 100 1
    else if v < 1000 2
    else 3
  }

  fn summarize(s: series): stat {
    if s.points.len == 0 {
      return :empty
    }
    let lo = s.points.[0].value
    let hi = lo
    let total = 0: u64
    let kept = 0: u64
    for p in s.points {
