    acct.balance + bonus + late
  }

  fn quantize(v: u64): u8 {
    if v < 10 0: u8
    else if v < 100 1
    else if v < 1000 2
    else 3
  }

  fn summarize(s: series): stat {
    if s.points.len == 0 {
      return :empty
    }
