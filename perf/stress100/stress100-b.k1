  let p0 = swap(mk-pair(zero[u8](), zero[u16]()))
  acc = acc + measure(p0.first) + measure(p0.second)
  let p1 = swap(mk-pair(zero[u16](), zero[u32]()))
  acc = acc + measure(p1.first) + measure(p1.second)
  let p2 = swap(mk-pair(zero[u32](), zero[u64]()))
  acc = acc + measure(p2.first) + measure(p2.second)
  let p3 = swap(mk-pair(zero[u64](), zero[bool]()))
  acc = acc + measure(p3.first) + measure(p3.second)
  let p4 = swap(mk-pair(zero[bool](), zero[string]()))
  acc = acc + measure(p4.first) + measure(p4.second)
  let p5 = swap(mk-pair(zero[string](), zero[f32]()))
  acc = acc + measure(p5.first) + measure(p5.second)
  let p6 = swap(mk-pair(zero[f32](), zero[f64]()))
  acc = acc + measure(p6.first) + measure(p6.second)
  let p7 = swap(mk-pair(zero[f64](), zero[u8]()))
  acc = acc + measure(p7.first) + measure(p7.second)
  acc = acc + encode(1: u32)
  acc = acc + encode(2: u64)
  let probe: item = .{ sku = 2009, qty = 2, unit-price = 40, discount = :none, note = :some("x") }
  let probe2: sample = .{ at = 1, value = acc % 5, quality = 1 }
  acc = acc + total(probe) + encode(probe) + total(mk(probe)) + total(probe2)
  acc = acc + churn(acc)
  acc = acc + churn(acc % 97)
  acc = acc + settle(acc % 61)
  acc = acc + settle(2009 + 7)
  acc = acc + sample-run(acc % 43)
  acc = acc + sample-run(2009 + 11)
  acc
  }
}

ns u2010 {
  type bx[t] = { value: t, tag: u64 }
  type duo[a, b] = { first: a, second: b }
  type vec2 = { x: u64, y: u64 }
  type shape = either { dot, line(u64), rect(vec2) }
  type op = either { push(u64), pop, reset }

  type item = { sku: u64, qty: u32, unit-price: u64, discount: ?u64, note: ?string }
  type order-status = either {
    draft,
    placed(u64),
    shipped({ carrier: u64, eta: u64 }),
    delivered(u64),
    canceled(string)
  }
  type order = { id: u64, status: order-status, lines: list[item], shipping: duo[u64, u64], paid: bool }
  type event = either { credit(u64), debit(u64), hold(duo[u64, u64]), release, note(string) }
  type account = { id: u64, balance: u64, held: u64, tier: u8, closed: bool, last-event: ?event }
  type sample = { at: u64, value: u64, quality: u8 }
  type series = { name: string, points: list[sample], window: duo[u64, u64] }
  type stat = either { count(u64), sum(u64), extent(duo[u64, u64]), empty }

  fn area(s: shape): u64 {
    if s is {
      :dot -> 1,
      :line(len) -> len,
      :rect(d) -> d.x * d.y
    }
  }

  fn step(state: vec2, o: op): vec2 {
    if o is {
      :push(n) -> .{ x = state.x + n, y = state.y + 1 },
      :pop -> {
        if state.y > 0 {
          .{ x = state.x, y = state.y - 1 }
        } else state
      },
      :reset -> .{ x = 0, y = 0 }
    }
  }

  fn churn(seed: u64): u64 {
    let base = seed + 2010
    let low = base % 7
    let high = base / 3
    let start: vec2 = .{ x = low, y = high }
    let s: shape = if low > high :rect(start) else if low == 0 :dot else :line(high)
    let a = area(s)
    let cur = start
    cur = step(cur, :push(a))
    cur = step(cur, :push(low))
    cur = step(cur, :pop)
    cur = if cur.x > 100 step(cur, :reset) else cur
    let k = 0: u64
    let sum = 0: u64
    while k < low {
      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = if cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
    }
    if verdict > sum verdict - sum else sum - verdict + a
  }

  fn line-cost(line: item): u64 {
    let gross = line.unit-price * line.qty.widen[u64]
    let disc = line.discount ? 0
    let cut = if line.note is :some(_) 1: u64 else 0
    if disc + cut >= gross 0: u64 else gross - disc - cut
  }

  fn order-total(o: order): u64 {
    let sum = 0: u64
    for line in o.lines {
      sum = sum + line-cost(line)
    }
    let ship = o.shipping.first + o.shipping.second
    if o.paid sum else sum + ship
  }

  fn advance(o: order, now: u64): order {
    let next: order-status = if o.status is {
      :draft -> :placed(now),
      :placed(at) -> {
        if now - at > 10 {
          :shipped(.{ carrier = 2010, eta = now + 3 })
        } else :placed(at)
      },
      :shipped(s) -> if now >= s.eta :delivered(now) else :shipped(s),
      :delivered(at) -> :delivered(at),
      :canceled(why) -> :canceled(why)
    }
    o | .{ status = next }
  }

  fn apply-event(a: account, e: event): account {
    if a.closed {
      return a
    }
    let next = if e is {
      :credit(n) -> a | .{ balance = a.balance + n },
      :debit(n) -> {
        if n > a.balance {
          a | .{ closed = true }
        } else {
          a | .{ balance = a.balance - n }
        }
      },
      :hold(h) -> a | .{ held = a.held + h.first + h.second },
      :release -> a | .{ balance = a.balance + a.held, held = 0 },
      :note(_) -> a
    }
    next | .{ last-event = :some(e) }
  }

  fn settle(seed: u64): u64 {
    let lines = list/empty[item]()
    let count = seed % 5 + 1
    for k in (0: u64).until(count) {
      lines.push(.{
        sku = seed * 31 + k,
        qty = (k + 1).trunc[u32],
        unit-price = 100 + k * 7,
        discount = if k % 2 == 0 :some(k * 3) else :none,
        note = :none
      })
    }
    let o: order = .{
      id = seed,
      status = :draft,
      lines,
      shipping = mk-pair(5: u64, seed % 9),
      paid = seed % 3 == 0
    }
    let t = 0: u64
    while t < 4 {
      o = advance(o, seed + t * 6)
      t = t + 1
    }
    let due = order-total(o)
    let acct: account = .{
      id = seed,
      balance = due,
      held = 0,
      tier = (seed % 4).trunc[u8],
      closed = false,
      last-event = :none
    }
    acct = apply-event(acct, :hold(mk-pair(due / 2, 1: u64)))
    acct = apply-event(acct, :debit(seed % 50))
    acct = apply-event(acct, :release)
    acct = apply-event(acct, :credit(3))
    let bonus = if acct.last-event is {
      :some(:credit(n)) -> n,
      :some(_) -> 1,
      :none -> 0
    }
    let late = if o.status is { :delivered(at) -> at % 13, _ -> 0 }
    acct.balance + bonus + late
  }

  fn quantize(v: u64): u8 {
    if v < 10 0: u8
    else if v < 100 1
    else if v < 1000 2
    else 3
  }

  fn summarize(s: series): stat {
    if s.points.len == 0 {
      return :empty
    }
    let lo = s.points.[0].value
    let hi = lo
    let total = 0: u64
    let kept = 0: u64
    for p in s.points {
      if p.quality == 0 {
        continue
      }
      if p.at < s.window.first or p.at > s.window.second {
        continue
      }
      if p.value < lo {
        lo = p.value
      }
      if p.value > hi {
        hi = p.value
      }
      total = total + p.value
      kept = kept + 1
    }
    if kept == 0 :count(0)
    else if kept == 1 :sum(total)
    else :extent(mk-pair(lo, hi))
  }

  fn sample-run(seed: u64): u64 {
    let pts = list/empty[sample]()
    let cap = seed % 7 + 2
    let k = 0: u64
    while k < cap {
      let q = if k % 3 == 0 { 0: u8 } else quantize(k * seed + 2010)
      pts.push(.{ at = k * 10, value = (seed + k * k) % 251, quality = q })
      k = k + 1
    }
    let s: series = .{ name = "run", points = pts, window = mk-pair(0: u64, 900 + seed) }
    let verdict = if summarize(s) is {
      :empty -> 0: u64,
      :count(n) -> n,
      :sum(n) -> n % 100,
      :extent(e) -> e.second - e.first
    }
    verdict + k
  }

  ability sz { fn sz(self): u64 }
  ability enc[o] { fn enc(self): o }

  impl sz for u32 { fn sz(self): u64 { self.widen[u64] + 1 } }
  impl sz for u64 { fn sz(self): u64 { self + 2 } }
  impl sz for item { fn sz(self): u64 { self.sku % 1000 + self.qty.widen[u64] } }
  impl sz for sample { fn sz(self): u64 { self.at + self.value } }
  impl[t: sz] sz for bx[t] { fn sz(self): u64 { self.value.sz() + 1 } }
  impl enc[o = u64] for u32 { fn enc(self): u64 { self.widen[u64] } }
  impl enc[o = u64] for u64 { fn enc(self): u64 { self } }
  impl enc[o = u64] for item { fn enc(self): u64 { self.sku * 31 + self.unit-price } }

  fn mk[t](value: t): bx[t] { .{ value, tag = 2010 } }
  fn get[t](b: bx[t]): t { b.value }
  fn wrap2[t](value: t): bx[bx[t]] { mk(mk(value)) }
  fn mk-pair[a, b](first: a, second: b): duo[a, b] { .{ first, second } }
  fn swap[a, b](p: duo[a, b]): duo[b, a] { .{ first = p.second, second = p.first } }
  fn zero[t](): ?t { :none }
  fn measure[t](v: ?t): u64 { if v is :some(_) 1 else 0 }
  fn total[t: sz](v: t): u64 { v.sz() }
  fn encode[t: enc[o = u64]](v: t): u64 { v.enc() }

  fn test(): u64 {
  let acc = 2010: u64
  acc = acc + get(mk(1: u8)).widen[u64]
  acc = acc + get(mk(2: u16)).widen[u64]
  acc = acc + get(mk(3: u32)).widen[u64]
  acc = acc + get(mk(4: u64))
  acc = acc + total(mk(1: u32))
  acc = acc + total(mk(2: u64))
  acc = acc + get(get(wrap2(1: u8))).widen[u64]
  acc = acc + get(get(wrap2(2: u16))).widen[u64]
  acc = acc + get(get(wrap2(3: u32))).widen[u64]
  acc = acc + get(get(wrap2(4: u64)))
  let p0 = swap(mk-pair(zero[u8](), zero[u16]()))
  acc = acc + measure(p0.first) + measure(p0.second)
  let p1 = swap(mk-pair(zero[u16](), zero[u32]()))
  acc = acc + measure(p1.first) + measure(p1.second)
  let p2 = swap(mk-pair(zero[u32](), zero[u64]()))
  acc = acc + measure(p2.first) + measure(p2.second)
  let p3 = swap(mk-pair(zero[u64](), zero[bool]()))
  acc = acc + measure(p3.first) + measure(p3.second)
  let p4 = swap(mk-pair(zero[bool](), zero[string]()))
  acc = acc + measure(p4.first) + measure(p4.second)
  let p5 = swap(mk-pair(zero[string](), zero[f32]()))
  acc = acc + measure(p5.first) + measure(p5.second)
  let p6 = swap(mk-pair(zero[f32](), zero[f64]()))
  acc = acc + measure(p6.first) + measure(p6.second)
  let p7 = swap(mk-pair(zero[f64](), zero[u8]()))
  acc = acc + measure(p7.first) + measure(p7.second)
  acc = acc + encode(1: u32)
  acc = acc + encode(2: u64)
  let probe: item = .{ sku = 2010, qty = 2, unit-price = 40, discount = :none, note = :some("x") }
  let probe2: sample = .{ at = 1, value = acc % 5, quality = 1 }
  acc = acc + total(probe) + encode(probe) + total(mk(probe)) + total(probe2)
  acc = acc + churn(acc)
  acc = acc + churn(acc % 97)
  acc = acc + settle(acc % 61)
  acc = acc + settle(2010 + 7)
  acc = acc + sample-run(acc % 43)
  acc = acc + sample-run(2010 + 11)
  acc
  }
}

ns u2011 {
  type bx[t] = { value: t, tag: u64 }
  type duo[a, b] = { first: a, second: b }
  type vec2 = { x: u64, y: u64 }
  type shape = either { dot, line(u64), rect(vec2) }
  type op = either { push(u64), pop, reset }

  type item = { sku: u64, qty: u32, unit-price: u64, discount: ?u64, note: ?string }
  type order-status = either {
    draft,
    placed(u64),
    shipped({ carrier: u64, eta: u64 }),
    delivered(u64),
    canceled(string)
  }
  type order = { id: u64, status: order-status, lines: list[item], shipping: duo[u64, u64], paid: bool }
  type event = either { credit(u64), debit(u64), hold(duo[u64, u64]), release, note(string) }
  type account = { id: u64, balance: u64, held: u64, tier: u8, closed: bool, last-event: ?event }
  type sample = { at: u64, value: u64, quality: u8 }
  type series = { name: string, points: list[sample], window: duo[u64, u64] }
  type stat = either { count(u64), sum(u64), extent(duo[u64, u64]), empty }

  fn area(s: shape): u64 {
    if s is {
      :dot -> 1,
      :line(len) -> len,
      :rect(d) -> d.x * d.y
    }
  }

  fn step(state: vec2, o: op): vec2 {
    if o is {
      :push(n) -> .{ x = state.x + n, y = state.y + 1 },
      :pop -> {
        if state.y > 0 {
          .{ x = state.x, y = state.y - 1 }
        } else state
      },
      :reset -> .{ x = 0, y = 0 }
    }
  }

  fn churn(seed: u64): u64 {
    let base = seed + 2011
    let low = base % 7
    let high = base / 3
    let start: vec2 = .{ x = low, y = high }
    let s: shape = if low > high :rect(start) else if low == 0 :dot else :line(high)
    let a = area(s)
    let cur = start
    cur = step(cur, :push(a))
    cur = step(cur, :push(low))
    cur = step(cur, :pop)
    cur = if cur.x > 100 step(cur, :reset) else cur
    let k = 0: u64
    let sum = 0: u64
    while k < low {
      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = if cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
    }
    if verdict > sum verdict - sum else sum - verdict + a
  }

  fn line-cost(line: item): u64 {
    let gross = line.unit-price * line.qty.widen[u64]
    let disc = line.discount ? 0
    let cut = if line.note is :some(_) 1: u64 else 0
    if disc + cut >= gross 0: u64 else gross - disc - cut
  }

  fn order-total(o: order): u64 {
    let sum = 0: u64
    for line in o.lines {
      sum = sum + line-cost(line)
    }
    let ship = o.shipping.first + o.shipping.second
    if o.paid sum else sum + ship
  }

  fn advance(o: order, now: u64): order {
    let next: order-status = if o.status is {
      :draft -> :placed(now),
      :placed(at) -> {
        if now - at > 10 {
          :shipped(.{ carrier = 2011, eta = now + 3 })
        } else :placed(at)
      },
      :shipped(s) -> if now >= s.eta :delivered(now) else :shipped(s),
      :delivered(at) -> :delivered(at),
      :canceled(why) -> :canceled(why)
    }
    o | .{ status = next }
  }

  fn apply-event(a: account, e: event): account {
    if a.closed {
      return a
    }
    let next = if e is {
      :credit(n) -> a | .{ balance = a.balance + n },
      :debit(n) -> {
        if n > a.balance {
          a | .{ closed = true }
        } else {
          a | .{ balance = a.balance - n }
        }
      },
      :hold(h) -> a | .{ held = a.held + h.first + h.second },
      :release -> a | .{ balance = a.balance + a.held, held = 0 },
      :note(_) -> a
    }
    next | .{ last-event = :some(e) }
  }

  fn settle(seed: u64): u64 {
    let lines = list/empty[item]()
    let count = seed % 5 + 1
    for k in (0: u64).until(count) {
      lines.push(.{
        sku = seed * 31 + k,
        qty = (k + 1).trunc[u32],
        unit-price = 100 + k * 7,
        discount = if k % 2 == 0 :some(k * 3) else :none,
        note = :none
      })
    }
    let o: order = .{
      id = seed,
      status = :draft,
      lines,
      shipping = mk-pair(5: u64, seed % 9),
      paid = seed % 3 == 0
    }
    let t = 0: u64
    while t < 4 {
      o = advance(o, seed + t * 6)
      t = t + 1
    }
    let due = order-total(o)
    let acct: account = .{
      id = seed,
      balance = due,
      held = 0,
      tier = (seed % 4).trunc[u8],
      closed = false,
      last-event = :none
    }
    acct = apply-event(acct, :hold(mk-pair(due / 2, 1: u64)))
    acct = apply-event(acct, :debit(seed % 50))
    acct = apply-event(acct, :release)
    acct = apply-event(acct, :credit(3))
    let bonus = if acct.last-event is {
      :some(:credit(n)) -> n,
      :some(_) -> 1,
      :none -> 0
    }
    let late = if o.status is { :delivered(at) -> at % 13, _ -> 0 }
    acct.balance + bonus + late
  }

  fn quantize(v: u64): u8 {
    if v < 10 0: u8
    else if v < 100 1
    else if v < 1000 2
    else 3
  }

  fn summarize(s: series): stat {
    if s.points.len == 0 {
      return :empty
    }
    let lo = s.points.[0].value
    let hi = lo
    let total = 0: u64
    let kept = 0: u64
    for p in s.points {
      if p.quality == 0 {
        continue
      }
      if p.at < s.window.first or p.at > s.window.second {
        continue
      }
      if p.value < lo {
        lo = p.value
      }
      if p.value > hi {
        hi = p.value
      }
      total = total + p.value
      kept = kept + 1
    }
    if kept == 0 :count(0)
    else if kept == 1 :sum(total)
    else :extent(mk-pair(lo, hi))
  }

  fn sample-run(seed: u64): u64 {
    let pts = list/empty[sample]()
    let cap = seed % 7 + 2
    let k = 0: u64
    while k < cap {
      let q = if k % 3 == 0 { 0: u8 } else quantize(k * seed + 2011)
      pts.push(.{ at = k * 10, value = (seed + k * k) % 251, quality = q })
      k = k + 1
    }
    let s: series = .{ name = "run", points = pts, window = mk-pair(0: u64, 900 + seed) }
    let verdict = if summarize(s) is {
      :empty -> 0: u64,
      :count(n) -> n,
      :sum(n) -> n % 100,
      :extent(e) -> e.second - e.first
    }
    verdict + k
  }

  ability sz { fn sz(self): u64 }
  ability enc[o] { fn enc(self): o }

  impl sz for u32 { fn sz(self): u64 { self.widen[u64] + 1 } }
  impl sz for u64 { fn sz(self): u64 { self + 2 } }
  impl sz for item { fn sz(self): u64 { self.sku % 1000 + self.qty.widen[u64] } }
  impl sz for sample { fn sz(self): u64 { self.at + self.value } }
  impl[t: sz] sz for bx[t] { fn sz(self): u64 { self.value.sz() + 1 } }
  impl enc[o = u64] for u32 { fn enc(self): u64 { self.widen[u64] } }
  impl enc[o = u64] for u64 { fn enc(self): u64 { self } }
  impl enc[o = u64] for item { fn enc(self): u64 { self.sku * 31 + self.unit-price } }

  fn mk[t](value: t): bx[t] { .{ value, tag = 2011 } }
  fn get[t](b: bx[t]): t { b.value }
  fn wrap2[t](value: t): bx[bx[t]] { mk(mk(value)) }
  fn mk-pair[a, b](first: a, second: b): duo[a, b] { .{ first, second } }
  fn swap[a, b](p: duo[a, b]): duo[b, a] { .{ first = p.second, second = p.first } }
  fn zero[t](): ?t { :none }
  fn measure[t](v: ?t): u64 { if v is :some(_) 1 else 0 }
  fn total[t: sz](v: t): u64 { v.sz() }
  fn encode[t: enc[o = u64]](v: t): u64 { v.enc() }

  fn test(): u64 {
  let acc = 2011: u64
  acc = acc + get(mk(1: u8)).widen[u64]
  acc = acc + get(mk(2: u16)).widen[u64]
  acc = acc + get(mk(3: u32)).widen[u64]
  acc = acc + get(mk(4: u64))
  acc = acc + total(mk(1: u32))
  acc = acc + total(mk(2: u64))
  acc = acc + get(get(wrap2(1: u8))).widen[u64]
  acc = acc + get(get(wrap2(2: u16))).widen[u64]
  acc = acc + get(get(wrap2(3: u32))).widen[u64]
  acc = acc + get(get(wrap2(4: u64)))
  let p0 = swap(mk-pair(zero[u8](), zero[u16]()))
  acc = acc + measure(p0.first) + measure(p0.second)
  let p1 = swap(mk-pair(zero[u16](), zero[u32]()))
  acc = acc + measure(p1.first) + measure(p1.second)
  let p2 = swap(mk-pair(zero[u32](), zero[u64]()))
  acc = acc + measure(p2.first) + measure(p2.second)
  let p3 = swap(mk-pair(zero[u64](), zero[bool]()))
  acc = acc + measure(p3.first) + measure(p3.second)
  let p4 = swap(mk-pair(zero[bool](), zero[string]()))
  acc = acc + measure(p4.first) + measure(p4.second)
  let p5 = swap(mk-pair(zero[string](), zero[f32]()))
  acc = acc + measure(p5.first) + measure(p5.second)
  let p6 = swap(mk-pair(zero[f32](), zero[f64]()))
  acc = acc + measure(p6.first) + measure(p6.second)
  let p7 = swap(mk-pair(zero[f64](), zero[u8]()))
  acc = acc + measure(p7.first) + measure(p7.second)
  acc = acc + encode(1: u32)
  acc = acc + encode(2: u64)
  let probe: item = .{ sku = 2011, qty = 2, unit-price = 40, discount = :none, note = :some("x") }
  let probe2: sample = .{ at = 1, value = acc % 5, quality = 1 }
  acc = acc + total(probe) + encode(probe) + total(mk(probe)) + total(probe2)
  acc = acc + churn(acc)
  acc = acc + churn(acc % 97)
  acc = acc + settle(acc % 61)
  acc = acc + settle(2011 + 7)
  acc = acc + sample-run(acc % 43)
  acc = acc + sample-run(2011 + 11)
  acc
  }
}

ns u2012 {
  type bx[t] = { value: t, tag: u64 }
  type duo[a, b] = { first: a, second: b }
  type vec2 = { x: u64, y: u64 }
  type shape = either { dot, line(u64), rect(vec2) }
  type op = either { push(u64), pop, reset }

  type item = { sku: u64, qty: u32, unit-price: u64, discount: ?u64, note: ?string }
  type order-status = either {
    draft,
    placed(u64),
    shipped({ carrier: u64, eta: u64 }),
    delivered(u64),
    canceled(string)
  }
  type order = { id: u64, status: order-status, lines: list[item], shipping: duo[u64, u64], paid: bool }
  type event = either { credit(u64), debit(u64), hold(duo[u64, u64]), release, note(string) }
  type account = { id: u64, balance: u64, held: u64, tier: u8, closed: bool, last-event: ?event }
  type sample = { at: u64, value: u64, quality: u8 }
  type series = { name: string, points: list[sample], window: duo[u64, u64] }
  type stat = either { count(u64), sum(u64), extent(duo[u64, u64]), empty }

  fn area(s: shape): u64 {
    if s is {
      :dot -> 1,
      :line(len) -> len,
      :rect(d) -> d.x * d.y
    }
  }

  fn step(state: vec2, o: op): vec2 {
    if o is {
      :push(n) -> .{ x = state.x + n, y = state.y + 1 },
      :pop -> {
        if state.y > 0 {
          .{ x = state.x, y = state.y - 1 }
        } else state
      },
      :reset -> .{ x = 0, y = 0 }
    }
  }

  fn churn(seed: u64): u64 {
    let base = seed + 2012
    let low = base % 7
    let high = base / 3
    let start: vec2 = .{ x = low, y = high }
    let s: shape = if low > high :rect(start) else if low == 0 :dot else :line(high)
    let a = area(s)
    let cur = start
    cur = step(cur, :push(a))
    cur = step(cur, :push(low))
    cur = step(cur, :pop)
    cur = if cur.x > 100 step(cur, :reset) else cur
    let k = 0: u64
    let sum = 0: u64
    while k < low {
      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = if cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
    }
    if verdict > sum verdict - sum else sum - verdict + a
  }

  fn line-cost(line: item): u64 {
    let gross = line.unit-price * line.qty.widen[u64]
    let disc = line.discount ? 0
    let cut = if line.note is :some(_) 1: u64 else 0
    if disc + cut >= gross 0: u64 else gross - disc - cut
  }

  fn order-total(o: order): u64 {
    let sum = 0: u64
    for line in o.lines {
      sum = sum + line-cost(line)
    }
    let ship = o.shipping.first + o.shipping.second
    if o.paid sum else sum + ship
  }

  fn advance(o: order, now: u64): order {
    let next: order-status = if o.status is {
      :draft -> :placed(now),
      :placed(at) -> {
        if now - at > 10 {
          :shipped(.{ carrier = 2012, eta = now + 3 })
        } else :placed(at)
      },
      :shipped(s) -> if now >= s.eta :delivered(now) else :shipped(s),
      :delivered(at) -> :delivered(at),
      :canceled(why) -> :canceled(why)
    }
    o | .{ status = next }
  }

  fn apply-event(a: account, e: event): account {
    if a.closed {
      return a
    }
    let next = if e is {
      :credit(n) -> a | .{ balance = a.balance + n },
      :debit(n) -> {
        if n > a.balance {
          a | .{ closed = true }
        } else {
          a | .{ balance = a.balance - n }
        }
      },
      :hold(h) -> a | .{ held = a.held + h.first + h.second },
      :release -> a | .{ balance = a.balance + a.held, held = 0 },
      :note(_) -> a
    }
    next | .{ last-event = :some(e) }
  }

  fn settle(seed: u64): u64 {
    let lines = list/empty[item]()
    let count = seed % 5 + 1
    for k in (0: u64).until(count) {
      lines.push(.{
        sku = seed * 31 + k,
        qty = (k + 1).trunc[u32],
        unit-price = 100 + k * 7,
        discount = if k % 2 == 0 :some(k * 3) else :none,
        note = :none
      })
    }
    let o: order = .{
      id = seed,
      status = :draft,
      lines,
      shipping = mk-pair(5: u64, seed % 9),
      paid = seed % 3 == 0
    }
    let t = 0: u64
    while t < 4 {
      o = advance(o, seed + t * 6)
      t = t + 1
    }
    let due = order-total(o)
    let acct: account = .{
      id = seed,
      balance = due,
      held = 0,
      tier = (seed % 4).trunc[u8],
      closed = false,
      last-event = :none
    }
    acct = apply-event(acct, :hold(mk-pair(due / 2, 1: u64)))
    acct = apply-event(acct, :debit(seed % 50))
    acct = apply-event(acct, :release)
    acct = apply-event(acct, :credit(3))
    let bonus = if acct.last-event is {
      :some(:credit(n)) -> n,
      :some(_) -> 1,
      :none -> 0
    }
    let late = if o.status is { :delivered(at) -> at % 13, _ -> 0 }
    acct.balance + bonus + late
  }

  fn quantize(v: u64): u8 {
    if v < 10 0: u8
    else if v < 100 1
    else if v < 1000 2
    else 3
  }

  fn summarize(s: series): stat {
    if s.points.len == 0 {
      return :empty
    }
    let lo = s.points.[0].value
    let hi = lo
    let total = 0: u64
    let kept = 0: u64
    for p in s.points {
      if p.quality == 0 {
        continue
      }
      if p.at < s.window.first or p.at > s.window.second {
        continue
      }
      if p.value < lo {
        lo = p.value
      }
      if p.value > hi {
        hi = p.value
      }
      total = total + p.value
      kept = kept + 1
    }
    if kept == 0 :count(0)
    else if kept == 1 :sum(total)
    else :extent(mk-pair(lo, hi))
  }

  fn sample-run(seed: u64): u64 {
    let pts = list/empty[sample]()
    let cap = seed % 7 + 2
    let k = 0: u64
    while k < cap {
      let q = if k % 3 == 0 { 0: u8 } else quantize(k * seed + 2012)
      pts.push(.{ at = k * 10, value = (seed + k * k) % 251, quality = q })
      k = k + 1
    }
    let s: series = .{ name = "run", points = pts, window = mk-pair(0: u64, 900 + seed) }
    let verdict = if summarize(s) is {
      :empty -> 0: u64,
      :count(n) -> n,
      :sum(n) -> n % 100,
      :extent(e) -> e.second - e.first
    }
    verdict + k
  }

  ability sz { fn sz(self): u64 }
  ability enc[o] { fn enc(self): o }

  impl sz for u32 { fn sz(self): u64 { self.widen[u64] + 1 } }
  impl sz for u64 { fn sz(self): u64 { self + 2 } }
  impl sz for item { fn sz(self): u64 { self.sku % 1000 + self.qty.widen[u64] } }
  impl sz for sample { fn sz(self): u64 { self.at + self.value } }
  impl[t: sz] sz for bx[t] { fn sz(self): u64 { self.value.sz() + 1 } }
  impl enc[o = u64] for u32 { fn enc(self): u64 { self.widen[u64] } }
  impl enc[o = u64] for u64 { fn enc(self): u64 { self } }
  impl enc[o = u64] for item { fn enc(self): u64 { self.sku * 31 + self.unit-price } }

  fn mk[t](value: t): bx[t] { .{ value, tag = 2012 } }
  fn get[t](b: bx[t]): t { b.value }
  fn wrap2[t](value: t): bx[bx[t]] { mk(mk(value)) }
  fn mk-pair[a, b](first: a, second: b): duo[a, b] { .{ first, second } }
  fn swap[a, b](p: duo[a, b]): duo[b, a] { .{ first = p.second, second = p.first } }
  fn zero[t](): ?t { :none }
  fn measure[t](v: ?t): u64 { if v is :some(_) 1 else 0 }
  fn total[t: sz](v: t): u64 { v.sz() }
  fn encode[t: enc[o = u64]](v: t): u64 { v.enc() }

  fn test(): u64 {
  let acc = 2012: u64
  acc = acc + get(mk(1: u8)).widen[u64]
  acc = acc + get(mk(2: u16)).widen[u64]
  acc = acc + get(mk(3: u32)).widen[u64]
  acc = acc + get(mk(4: u64))
  acc = acc + total(mk(1: u32))
  acc = acc + total(mk(2: u64))
  acc = acc + get(get(wrap2(1: u8))).widen[u64]
  acc = acc + get(get(wrap2(2: u16))).widen[u64]
  acc = acc + get(get(wrap2(3: u32))).widen[u64]
  acc = acc + get(get(wrap2(4: u64)))
  let p0 = swap(mk-pair(zero[u8](), zero[u16]()))
  acc = acc + measure(p0.first) + measure(p0.second)
  let p1 = swap(mk-pair(zero[u16](), zero[u32]()))
  acc = acc + measure(p1.first) + measure(p1.second)
  let p2 = swap(mk-pair(zero[u32](), zero[u64]()))
  acc = acc + measure(p2.first) + measure(p2.second)
  let p3 = swap(mk-pair(zero[u64](), zero[bool]()))
  acc = acc + measure(p3.first) + measure(p3.second)
  let p4 = swap(mk-pair(zero[bool](), zero[string]()))
  acc = acc + measure(p4.first) + measure(p4.second)
  let p5 = swap(mk-pair(zero[string](), zero[f32]()))
  acc = acc + measure(p5.first) + measure(p5.second)
  let p6 = swap(mk-pair(zero[f32](), zero[f64]()))
  acc = acc + measure(p6.first) + measure(p6.second)
  let p7 = swap(mk-pair(zero[f64](), zero[u8]()))
  acc = acc + measure(p7.first) + measure(p7.second)
  acc = acc + encode(1: u32)
  acc = acc + encode(2: u64)
  let probe: item = .{ sku = 2012, qty = 2, unit-price = 40, discount = :none, note = :some("x") }
  let probe2: sample = .{ at = 1, value = acc % 5, quality = 1 }
  acc = acc + total(probe) + encode(probe) + total(mk(probe)) + total(probe2)
  acc = acc + churn(acc)
  acc = acc + churn(acc % 97)
  acc = acc + settle(acc % 61)
  acc = acc + settle(2012 + 7)
  acc = acc + sample-run(acc % 43)
  acc = acc + sample-run(2012 + 11)
  acc
  }
}

ns u2013 {
  type bx[t] = { value: t, tag: u64 }
  type duo[a, b] = { first: a, second: b }
  type vec2 = { x: u64, y: u64 }
  type shape = either { dot, line(u64), rect(vec2) }
  type op = either { push(u64), pop, reset }

  type item = { sku: u64, qty: u32, unit-price: u64, discount: ?u64, note: ?string }
  type order-status = either {
    draft,
    placed(u64),
    shipped({ carrier: u64, eta: u64 }),
    delivered(u64),
    canceled(string)
  }
  type order = { id: u64, status: order-status, lines: list[item], shipping: duo[u64, u64], paid: bool }
  type event = either { credit(u64), debit(u64), hold(duo[u64, u64]), release, note(string) }
  type account = { id: u64, balance: u64, held: u64, tier: u8, closed: bool, last-event: ?event }
  type sample = { at: u64, value: u64, quality: u8 }
  type series = { name: string, points: list[sample], window: duo[u64, u64] }
  type stat = either { count(u64), sum(u64), extent(duo[u64, u64]), empty }

  fn area(s: shape): u64 {
    if s is {
      :dot -> 1,
      :line(len) -> len,
      :rect(d) -> d.x * d.y
    }
  }

  fn step(state: vec2, o: op): vec2 {
    if o is {
      :push(n) -> .{ x = state.x + n, y = state.y + 1 },
      :pop -> {
        if state.y > 0 {
          .{ x = state.x, y = state.y - 1 }
        } else state
      },
      :reset -> .{ x = 0, y = 0 }
    }
  }

  fn churn(seed: u64): u64 {
    let base = seed + 2013
    let low = base % 7
    let high = base / 3
    let start: vec2 = .{ x = low, y = high }
    let s: shape = if low > high :rect(start) else if low == 0 :dot else :line(high)
    let a = area(s)
    let cur = start
    cur = step(cur, :push(a))
    cur = step(cur, :push(low))
    cur = step(cur, :pop)
    cur = if cur.x > 100 step(cur, :reset) else cur
    let k = 0: u64
    let sum = 0: u64
    while k < low {
      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = if cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
    }
    if verdict > sum verdict - sum else sum - verdict + a
  }

  fn line-cost(line: item): u64 {
    let gross = line.unit-price * line.qty.widen[u64]
    let disc = line.discount ? 0
    let cut = if line.note is :some(_) 1: u64 else 0
    if disc + cut >= gross 0: u64 else gross - disc - cut
  }

  fn order-total(o: order): u64 {
    let sum = 0: u64
    for line in o.lines {
      sum = sum + line-cost(line)
    }
    let ship = o.shipping.first + o.shipping.second
    if o.paid sum else sum + ship
  }

  fn advance(o: order, now: u64): order {
    let next: order-status = if o.status is {
      :draft -> :placed(now),
      :placed(at) -> {
        if now - at > 10 {
          :shipped(.{ carrier = 2013, eta = now + 3 })
        } else :placed(at)
      },
      :shipped(s) -> if now >= s.eta :delivered(now) else :shipped(s),
      :delivered(at) -> :delivered(at),
      :canceled(why) -> :canceled(why)
    }
    o | .{ status = next }
  }

  fn apply-event(a: account, e: event): account {
    if a.closed {
      return a
    }
    let next = if e is {
      :credit(n) -> a | .{ balance = a.balance + n },
      :debit(n) -> {
        if n > a.balance {
          a | .{ closed = true }
        } else {
          a | .{ balance = a.balance - n }
        }
      },
      :hold(h) -> a | .{ held = a.held + h.first + h.second },
      :release -> a | .{ balance = a.balance + a.held, held = 0 },
      :note(_) -> a
    }
    next | .{ last-event = :some(e) }
  }

  fn settle(seed: u64): u64 {
    let lines = list/empty[item]()
    let count = seed % 5 + 1
    for k in (0: u64).until(count) {
      lines.push(.{
        sku = seed * 31 + k,
        qty = (k + 1).trunc[u32],
        unit-price = 100 + k * 7,
        discount = if k % 2 == 0 :some(k * 3) else :none,
        note = :none
      })
