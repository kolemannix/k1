    let k = 0: u64
    let sum = 0: u64
    while k < low {
      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = if cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
