    let cap = seed % 7 + 2
    let k = 0: u64
    while k < cap {
      let q = if k % 3 == 0 { 0: u8 } else quantize(k * seed + 1198)
      pts.push(.{ at = k * 10, value = (seed + k * k) % 251, quality = q })
      k = k + 1
