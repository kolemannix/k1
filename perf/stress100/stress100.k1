      id = seed,
      status = :draft,
      lines,
      shipping = mk-pair(5: u64, seed % 9),
      paid = seed % 3 == 0
    }
    let t = 0: u64
    while t < 4 {
      o = advance(o, seed + t * 6)
      t = t + 1
    }
    let due = order-total(o)
    let acct: account = .{
      id = seed,
      balance = due,
