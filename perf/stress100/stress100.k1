      return :empty
    }
    let lo = s.points.[0].value
    let hi = lo
    let total = 0: u64
    let kept = 0: u64
    for p in s.points {
      if p.quality == 0 {
        continue
      }
      if p.at < s.window.first or p.at > s.window.second {
        continue
      }
