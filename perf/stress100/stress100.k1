      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
    }
    if verdict > sum verdict - sum else sum - verdict + a
  }

