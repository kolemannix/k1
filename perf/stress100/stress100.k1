  type op = either { push(u64), pop, reset }

  fn area(s: shape): u64 {
    s is {
      :dot -> 1,
      :line(len) -> len,
      :rect(d) -> d.x * d.y
    }
  }

  fn step(state: vec2, o: op): vec2 {
    o is {
      :push(n) -> .{ x = state.x + n, y = state.y + 1 },
      :pop -> {
        if state.y > 0 {
          .{ x = state.x, y = state.y - 1 }
        } else state
      },
      :reset -> .{ x = 0, y = 0 }
    }
  }

  fn churn(seed: u64): u64 {
    let base = seed + 45
    let low = base % 7
    let high = base / 3
