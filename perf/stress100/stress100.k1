  }

  fn sample-run(seed: u64): u64 {
    let pts = list/empty[sample]()
    let cap = seed % 7 + 2
    let k = 0: u64
    while k < cap {
      let q = if k % 3 == 0 { 0: u8 } else quantize(k * seed + 948)
