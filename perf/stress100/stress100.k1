    cur = step(cur, :push(low))
    cur = step(cur, :pop)
    cur = if cur.x > 100 step(cur, :reset) else cur
    let k = 0: u64
    let sum = 0: u64
    while k < low {
      sum = sum + k * 2 + cur.x
      k = k + 1
    }
    let verdict = cur is {
      .{ x = 0, y } -> y,
      .{ x, y } if x == y -> x + y,
      .{ x, y } -> x * 2 + y
    }
    if verdict > sum verdict - sum else sum - verdict + a
