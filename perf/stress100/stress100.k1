  acc = acc + churn(acc)
  acc = acc + churn(acc % 97)
  acc = acc + settle(acc % 61)
  acc = acc + settle(1028 + 7)
  acc = acc + sample-run(acc % 43)
  acc = acc + sample-run(1028 + 11)
  acc
  }
}

