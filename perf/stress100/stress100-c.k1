    for k in (0: u64).until(count) {
      lines.push(.{
        sku = seed * 31 + k,
        qty = (k + 1).trunc[u32],
        unit-price = 100 + k * 7,
        discount = if k % 2 == 0 :some(k * 3) else :none,
        note = :none
      })
    }
    let o: order = .{
      id = seed,
      status = :draft,
      lines,
      shipping = mk-pair(5: u64, seed % 9),
      paid = seed % 3 == 0
    }
