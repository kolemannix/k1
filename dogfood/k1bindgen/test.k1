fn test(): i32 {
  let core-args: span[string] = [
    "k1bindgen",
    "-lib-name",     "testlib",
    "-system",       "false",
    "-out-path",     "test/output.k1",
    "-in-path",      "test/input.c",
    "+opaque",       "opaq",
    "+exclude",      "Color_Blue",
    "+exclude",      "__",
    "+strip-suffix", "_t",      
    "+strip-suffix", "_u",      
    "+strip-prefix", "cinput_", 
    "+rename"      , "cinput_custom_name:my-custom-name"
  ]
  // libclang derives its resource dir from the running executable, not from
  // libclang itself, so we have to point it at the builtin headers ourselves
  let llvm-prefix = core/sys/env("LLVM_SYS_231_PREFIX") ?
    crash("k1bindgen's test needs LLVM_SYS_231_PREFIX set to an LLVM install prefix")
  let clang-include = std/process/run("/bin/sh", ["-c", "printf %s $($llvm-prefix/bin/clang -print-resource-dir)/include"]).!
  let args = core-args.concat([
    "+clangarg", "-isystem",
    "+clangarg", clang-include,
  ])
  // TODO: Use 'diff' instead sys/cmd("diff", "input.c", "test/output.k1")
  let expected = core/files/read-to-string("test/expected.k1").!
  if start(args) is {
    :err msg -> { eprintln("FAIL: $msg"); 1 },
    :ok output -> { assert-equals(output, expected); 0 }
  }
}
