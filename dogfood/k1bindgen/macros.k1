// Sorry for the slop, but it is useful
// Transpile macro bodies to k1

type c-token = { kind: clang/CXTokenKind, text: string }

fn macro-body-tokens(unit: clang/CXTranslationUnit, cursor: clang/CXCursor): list[c-token] {
  let extent = clang/getCursorExtent(cursor)
  let toks-ptr: *mut clang/CXToken = ptr/null.narrow()
  let count: u32 = 0
  clang/tokenize(unit, extent, &toks-ptr, &count)
  let body: list[c-token] = list/with-capacity(count.widen[size])
  let toks = buffer/wrap-raw[clang/CXToken](toks-ptr.as[ptr], count.widen[size])
  // Token 0 is the macro's own name
  let i: size = 1
  while i < toks.len() {
    let tok = toks.[i]
    i = i + 1
    let kind = clang/getTokenKind(tok)
    if kind is :Comment { continue }
    body.push(.{ kind, text = clang/getTokenSpelling(unit, tok).to-string() })
  }
  clang/disposeTokens(unit, toks-ptr, count)
  body
}

type macro-value = { type: string, text: string }

fn transpile-macro-body(names: name-config, emitted: map[string, string], body: span[c-token]): result[macro-value, string] {
  if body.is-empty() return :err "empty body"

  let all-strings = true
  for body {
    let is-string = it.kind is :Literal and it.text.[0] == '"'
    if not is-string { all-strings = false }
  }
  if all-strings return string-macro-value(body)

  let t: macro-transpile = .{ toks = body, pos = 0, names, emitted, ty = "i64" }
  let text = transpile-expr(&t).try
  if t.pos != body.len() return :err "trailing tokens after expression"
  :ok .{ type = t.ty, text }
}

type macro-transpile = {
  toks: span[c-token],
  pos: size,
  names: name-config,
  emitted: map[string, string],
  ty: string,
}

fn transpile-expr(t: *mut macro-transpile): result[string, string] {
  let s = transpile-primary(t).try
  loop {
    if t.pos >= t.toks.len() break
    let tok = t.toks.[t.pos]
    if tok.text == ")" break
    let is-op = tok.kind is :Punctuation and is-binary-op(tok.text)
    if not is-op { return :err "unsupported token '${tok.text}'" }
    t.pos = t.pos + 1
    let rhs = transpile-primary(t).try
    s = "$s ${tok.text} $rhs"
  }
  :ok s
}

fn is-binary-op(op: string): bool {
  op is {
    "*" or "/" or "%" or "+" or "-" or "<<" or ">>" or "&" or "^" or "|" -> true,
    _ -> false
  }
}

fn transpile-primary(t: *mut macro-transpile): result[string, string] {
  if t.pos >= t.toks.len() return :err "unexpected end of expression"
  let tok = t.toks.[t.pos]
  t.pos = t.pos + 1
  tok.kind is {
    :Literal -> transpile-literal(t, tok.text),
    :Identifier -> {
      let ty = t.emitted.get(tok.text) is {
        :some ty -> ty,
        :none -> return :err "references '${tok.text}', which is not an emitted macro"
      }
      if ty == "string" {
        // Referencing a string macro only works as a whole-body alias
        if t.toks.len() != 1 return :err "string macro '${tok.text}' in expression"
        t.ty = "string"
      } else if ty != "i64" {
        t.ty = ty
      }
      :ok (t.names.transformed-name(tok.text))
    },
    :Punctuation -> tok.text is {
      "(" -> {
        let inner = transpile-expr(t).try
        if t.pos >= t.toks.len() return :err "missing closing paren"
        if t.toks.[t.pos].text != ")" return :err "expected closing paren"
        t.pos = t.pos + 1
        :ok "($inner)"
      },
      "-" -> {
        // k1 has no unary minus; fuse into a negative literal when possible
        let next-is-literal = t.pos < t.toks.len() and t.toks.[t.pos].kind is :Literal
        if next-is-literal {
          let text = t.toks.[t.pos].text
          t.pos = t.pos + 1
          let lit = transpile-literal(t, text).try
          :ok "-$lit"
        } else {
          let p = transpile-primary(t).try
          :ok "(0 - $p)"
        }
      },
      "+" -> transpile-primary(t),
      "~" -> {
        let p = transpile-primary(t).try
        :ok "$p.bit-not()"
      },
      other -> :err "unsupported token '$other'"
    },
    _ -> :err "unsupported token '${tok.text}'"
  }
}

fn transpile-literal(t: *mut macro-transpile, text: string): result[string, string] {
  let first = text.[0]
  if first == '"' return :err "string literal in expression"
  if first == '\'' {
    let v = parse-char-literal(text).try
    return :ok (v.show())
  }
  if is-float-literal(text) return transpile-float-literal(t, text)
  let digits = strip-int-suffix(text)
  if digits.is-empty() or digits.len() > 18 return :err "unsupported literal $text"
  if digits.starts-with("0x") or digits.starts-with("0X") {
    let hex = digits.drop(2)
    if hex.is-empty() or hex.len() > 16 return :err "unsupported hex literal $text"
    for c in hex { if not is-hex-digit(c) { return :err "unsupported hex literal $text" } }
    if hex.len() == 16 and hex.[0].u8() > '7'.u8() { t.ty = "u64" }
    return :ok "0x$hex"
  }
  if digits.[0] == '0' and digits.len() > 1 {
    // k1 has no octal literals
    let value: i64 = 0
    for c in digits {
      let d = c.to-ascii-digit() is { :some d -> d.widen[i64], :none -> return :err "unsupported literal $text" }
      if d >= 8 return :err "unsupported literal $text"
      value = value * 8 + d
    }
    return :ok (value.show())
  }
  for c in digits { if not c.is-ascii-digit() { return :err "unsupported literal $text" } }
  :ok digits
}

fn is-float-literal(text: string): bool {
  if text.starts-with("0x") or text.starts-with("0X") return false
  let last = text.[text.len() - 1]
  if last == 'f' or last == 'F' return true
  text.contains-string(".")
}

fn transpile-float-literal(t: *mut macro-transpile, text: string): result[string, string] {
  let s = text
  let last = s.[s.len() - 1]
  t.ty = "f64"
  if last == 'f' or last == 'F' { t.ty = "f32"; s = s.drop-right(1) }
  if last == 'l' or last == 'L' { s = s.drop-right(1) }
  if s.is-empty() return :err "unsupported float literal $text"
  for c in s {
    let ok = c.is-ascii-digit() or c == '.'
    if not ok return :err "unsupported float literal $text"
  }
  if not s.contains-string(".") return :err "unsupported float literal $text"
  let s = if s.[0] == '.' "0$s" else s
  let s = if s.[s.len() - 1] == '.' "${s}0" else s
  :ok s
}

fn string-macro-value(body: span[c-token]): result[macro-value, string] {
  let out = string-builder/new()
  for body {
    let text = it.text
    if text.len() < 2 or text.[0] != '"' or text.[text.len() - 1] != '"' {
      return :err "unsupported string literal $text"
    }
    // C's basic escapes are k1's; validate them and pass the text through
    let inner = text.drop(1).drop-right(1)
    let i: size = 0
    while i < inner.len() {
      let c = inner.[i]
      if c == '$' { return :err "unsupported string literal $text" }
      if c == '\\' {
        let esc = if i + 1 < inner.len() inner.[i + 1] else ' '
        let ok = esc == 'n' or esc == 't' or esc == 'r' or esc == '0' or esc == '\\' or esc == '"'
        if not ok { return :err "unsupported string escape in $text" }
        i = i + 2
      } else {
        i = i + 1
      }
    }
    out.write(inner)
  }
  let content = out.build()
  :ok .{ type = "string", text = `"$content"` }
}

fn strip-int-suffix(text: string): string {
  let end = text.len()
  while end > 0 {
    let c = text.[end - 1]
    if c == 'u' or c == 'U' or c == 'l' or c == 'L' { end = end - 1 } else break
  }
  text.take(end)
}

fn is-hex-digit(c: char): bool {
  let b = c.to-ascii-lower().u8()
  c.is-ascii-digit() or (b >= 'a'.u8() and b <= 'f'.u8())
}

fn parse-char-literal(text: string): result[i64, string] {
  if text.len() == 3 and text.[0] == '\'' and text.[2] == '\'' {
    return :ok text.[1].u8().widen[i64]
  }
  if text.len() == 4 and text.[0] == '\'' and text.[1] == '\\' and text.[3] == '\'' {
    let v: i64 = text.[2] is {
      'n' -> 10,
      't' -> 9,
      'r' -> 13,
      '0' -> 0,
      '\\' -> 92,
      '\'' -> 39,
      '"' -> 34,
      _ -> return :err "unsupported char escape in $text"
    }
    return :ok v
  }
  :err "unsupported char literal $text"
}
