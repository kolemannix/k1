ns build {
  fn module(): k1/module {
    let llvm-prefix = core/sys/env("LLVM_SYS_211_PREFIX") ?
      crash("k1bindgen needs LLVM_SYS_211_PREFIX set to an LLVM install prefix")
    let llvm-path = "$llvm-prefix/lib"
    let m = k1/module/new()
    m.lib("clang", :default)
    m.link-args(["-L$llvm-path", "-Wl,-rpath,$llvm-path"])
    m
  }
}

use clang/CXIndex
use clang/CXTranslationUnit
use clang/CXCursor
use clang/CXString
use std/map
use std/set

// TODO:
// - [x] Extract fn param names by traversing the children, not just cheating by only looking at its 'cx-type' like we are now
// - [ ] Detect varargs and emit error
// - [ ] support bitfields (track bitfield start/end; if possible emit a std/bitfield call
// - [x] Use derived cli arg parser
// - [x] Embed sizeof / alignof / offsetof assertions
// - [x] Support Unions
fn main(argc: c-int, argv: ptr): i32 { 
  #if k1/test
    test()
  else {
    let output = start(std/sys/parse-main-args(argc, argv))
    if output is :err msg { eprintln("ERROR: $msg"); return 1 }
    0
  }
}
type dl-info = { fname: ptr, fbase: ptr, sname: ptr, saddr: ptr }
fn(extern("dlsym")) dlsym(handle: ptr, symbol: ptr): ptr
fn(extern("dladdr")) dladdr(addr: ptr, info: *dl-info): c-int

fn dirname(path: string): string {
  let last: ?size = :none
  let from: size = 0
  while path.drop(from).position('/') is :some rel {
    last = :some (from + rel)
    from = from + rel + 1
  }
  if last is :some i and i > 0 path.take(i) else "/"
}

// "clang version 21.1.7 (...)" -> "21"
fn clang-major-version(version-string: string): ?string {
  for tok in version-string.split-by-char(' ') {
    if (not tok.is-empty()) and tok.[0].is-ascii-digit() {
      return :some tok.split-by-char('.').[0]
    }
  }
  :none
}

// libclang is supposed to find its builtin headers (stdbool.h etc.) relative to
// its own load path, but its dladdr-based lookup yields a relative resource dir
// here, so nothing resolves. Locate the loaded libclang ourselves and pass
// -resource-dir explicitly.
fn clang-resource-dir(): ?string {
  let rtld-default: i64 = if k1/platform-macos { -2 } else { 0 }
  let sym = dlsym(rtld-default.to-ptr(), "clang_createIndex".to-c-tmp().ptr)
  if sym.is-null() return :none
  let info: dl-info = uninit
  if dladdr(sym, &info) == 0 return :none
  let lib-dir = dirname(string/from-c(info.fname))
  let major = if clang-major-version(clang/getClangVersion().to-string()) is {
    :some m -> m,
    :none -> return :none
  }
  :some "$lib-dir/clang/$major"
}

type bindgen-args = {
  lib-name: string,
  ns-name: ?string,
  in-path: string,
  out-path: ?string,
  clangarg: list[string],
  system: ?string,
  prelude-file: ?string,
  exclude: list[string],
  include: list[string],
  opaque: list[string],
  strip-suffix: list[string],
  strip-prefix: list[string],
  rename: list[string],
}
fn start(args: span[string]): result[string, string] {
  let args = if std/sys/parse-args[bindgen-args](args, []) is { :ok args -> args, :err msg -> return :err "Failed to parse arguments: $msg" }


  let index: CXIndex = clang/createIndex(1, 1)
  let unit: CXTranslationUnit = uninit

  // Ours goes first so a caller-supplied -resource-dir wins
  let clang-args: list[string] = list/empty()
  if clang-resource-dir() is :some dir {
    clang-args.push("-resource-dir")
    clang-args.push(dir)
  }
  for args.clangarg { clang-args.push(it) }
  let clang-args-c-strs: list[ptr] = clang-args.map(fn s. s.to-c-tmp().ptr)

  let err = clang/parseTranslationUnit2(
    index,
    source_filename = args.in-path.to-c().ptr,
    command_line_args = clang-args-c-strs.data-ptr(),
    command_line_args_len = clang-args-c-strs.len().trunc[i32],
    ptr/null.narrow(), 0,
    clang/tu-flag/DetailedPreprocessingRecord.bit-or(clang/tu-flag/SkipFunctionBodies), &unit
  )
  if err != 0 {
    crash("clang failed on ${args.lib-name}")
  }

  let num-diagnostics = clang/getNumDiagnostics(unit)
  for 0.until(num-diagnostics) {
    let d = clang/getDiagnostic(unit, it.trunc[u32])
    let severity = clang/getDiagnosticSeverity(d)
    eprintln("diag: ${severity.enum-name()}")
  }

  let cursor: clang/CXCursor = clang/getTranslationUnitCursor(unit)
  let parsed-renames = map/with-capacity-in[string, string, _](mem/tmp(), args.rename.len())
  for s in args.rename {
    let parts = s.split-by-char(':')
    if parts.len() != 2 eprintln("Bad rename: $s")
    parsed-renames.insert-in(mem/tmp(), parts.[0], parts.[1])
  }
  let state: bindgen-state = .{
    out-path = args.out-path,
    unit,
    defns = list/empty(),
    macro-names = set/new(),
    emitted-macros = map/new(),
    skip-system-defns = args.system != :some "true",
    exclude-substrings = args.exclude,
    include-names = set/from-span-in(mem/tmp(), args.include.as-span()),
    opaque-names = set/from-span-in(mem/tmp(), args.opaque.as-span()),
    name-config = .{ suffix-strips = args.strip-suffix, prefix-strips = args.strip-prefix, renames = parsed-renames },
  }
  clang/visitChildren(
    parent = cursor,
    visitor = visit-root,
    client_data = (&state).as[ptr]
  )

  info("Found ${state.defns.len()} definitions in ${args.in-path}. Emitting to ${args.out-path ? "stdout"}")

  let out = string-builder/new()
  let(context) out-writer = &out
  let(context) name-config = state.name-config
  out.writeln(`ns(lib("${args.lib-name}")) ${args.ns-name ? args.lib-name} // generated by k1-bindgen`)
  out.writeln("")
  out.writeln("use types/assert-layout")
  if args.prelude-file is :some prelude-file {
    let prelude-string = core/files/read-to-string(prelude-file)
    out.writeln("// contents of $prelude-file")
    out.write(prelude-string)
    out.writeln("// end contents of $prelude-file")
  }
  for state.defns {
    let raw-name = it.name
    if it.error is :some e {
      info("BINDGEN ERROR (todo location): $e")
      out.writeln("// BINDGEN ERROR: $e")
    }
    if state.should-include-name(raw-name) {
      let name = state.name-config.transformed-name(raw-name)
      if name != it.name debug("mapped ${it.name} to $name")
      if it.kind is {
        :typedef typedef -> {
          let skip = false
          if typedef.alias {
            if typedef.type is :name target-name and state.name-config.transformed-name(target-name) == name {
              skip = true
            }
          }
          if not skip {
            out.write("type${if typedef.alias "(alias) " else " "}$name = ")
            write-k1-type(typedef.type, indent = 0)
            out.write("\n")
            let is-opaque = typedef.type is :opaque _
            if (not is-opaque) and it.error is :none { write-layout-assertions(name, typedef.type, it.layout) }
          }
        },
        :constant constant -> {
          out.write("let ")
          out.write(name)
          out.write(": ")
          write-k1-type(constant.type, indent = 0)
          out.write(" = ")
          out.write(constant.value)
          out.writeln("")
        },
        :global global -> {
          out.write(`let(extern("$raw-name")`)
          if global.mutable out.write(", mutable")
          if global.tls out.write(", tls")
          out.write(") ")
          out.write(name)
          out.write(": ")
          write-k1-type(global.type, indent = 0)
          out.writeln("")
        },
        :function function -> {
          out.write(`fn(extern("$raw-name")) $name(`)
          if function.fn-type.params.is-empty() {
            out.write(`): `)
          } else {
            out.writeln("")
            for function.fn-type.params {
              if it-index > 0 out.writeln("")
              out.write("  ")
              out.write(if it.name is :some(name) mangle-name(name) else "p$it-index")
              out.write(": ")
              write-k1-type(it.type, indent = 1)
              out.write(",")
            }
            out.writeln("")
            out.write(`): `)
          }
          write-k1-type(function.fn-type.return-type, indent = 0)
          out.write("\n")
        }
      }
    }
  }

  let s = out.build()
  if state.out-path is {
    :none -> { print(s) },
    :some path -> { core/files/write-entire-file(out-path = path, contents = s) }
  }
  :ok s
}

fn write-layout-assertions(context w: *mut string-builder)(name: string, type: k1-type, layout: ?layout) {
  if layout is :some layout {
    w.write("#static assert-layout[$name](${layout.size}, ${layout.align}, [")
    if type is :struct .{ fields, kind = :struct } {
      for fields {
        w.write("${it.offset ? 0}, ")
      }
    }
    w.writeln("])")
  }
}

type layout = {
  size: size,
  align: size,
}

type k1-defn = { 
  name: string,
  kind: either { 
    typedef({ type: k1-type, alias: bool }),
    constant({ type: k1-type, value: string }),
    global({ type: k1-type, mutable: bool, tls: bool }),
    function({ fn-type: fn-type })
  },
  error: ?string,
  layout: ?layout,
}

type fn-type = {
  return-type: k1-type, params: list[{ name: ?string, type: k1-type }]
}
type k1-type = either {
  error-c(string),
  k1(string),
  name(string),
  struct({ fields: list[{ name: string, type: k1-type, offset: ?size }], kind: either { struct, union } }),
  enum({ int-type: string, members: list[{ name: string, explicit-value: string }] }),
  fn-type({ fn-type: *fn-type }),
  ref({ inner: *k1-type }),
  array({ elem-type: *k1-type, size: size }),
  opaque({ size: size, align: size })
}

let k1-keywords: span[string] = [
  "fn", "let", "mut", "and", "or", "if", "else", "while", "loop", "ns",
  "intern", "for", "in", "ability", "impl", "not", "is", "builtin", "where",
  "context", "use", "require", "defer",
]
fn mangle-name(name: string): string {
  for k1-keywords {
    if name == it { return "${name}_c" }
  }
  name
}

fn write-named-type(context w: *mut string-builder, name-config)(name: string, k1-type, indent: size) {
  w.write("${}: ", mangle-name(name))
  write-k1-type[w](k1-type, indent)
}

fn write-k1-type(context w: *mut string-builder, name-config)(k1-type, indent: size) {
  if k1-type is {
    :error-c msg -> w.write("ERROR: $msg"),
    :k1 s -> w.write(s),
    :name name -> {
      let transformed-name = name-config.transformed-name(name)
      w.write(transformed-name)
    },
    :struct s -> {
      if s.kind is :union { w.write("union ") }
      w.write("{")
      if s.fields.non-empty() w.writeln("")
      for s.fields {
        w.repeat("  ", indent + 1)
        write-named-type(it.name, it.type, indent + 1)
        w.writeln(",")
      }
      w.repeat("  ", indent)
      w.write("}")
    },
    :enum e -> {
      w.writeln("either(${e.int-type}) {")
      for e.members {
        w.repeat("  ", indent + 1)
        let transformed-name = name-config.transformed-name(it.name)
        w.writeln("$transformed-name = ${it.explicit-value},")
      }
      w.write("}")
    },
    :fn-type f -> {
      w.writeln("fn(")
      for f.fn-type.params {
        if it-index > 0 w.writeln("")
        w.repeat("  ", indent + 1)
        if it.name is {
          :none -> write-k1-type(it.type, indent + 1),
          :some name -> write-named-type(name, it.type, indent + 1),
        }
        if it-index != f.fn-type.params.len() - 1 { w.write(",") }
      }

      w.writeln("")
      w.repeat("  ", indent)
      w.write(") -> ")
      write-k1-type(f.fn-type.return-type, indent)
    },
    :ref ref -> {
      if ref.inner is :fn-type(_)* w.write("*")
      else w.write("*mut ")
      write-k1-type(ref.inner, indent)
    },
    :array a -> {
      w.write("array[")
      write-k1-type(a.elem-type, indent)
      w.write(", ")
      a.size.print-to(w)
      w.write("]")
    },
    :opaque opaque -> {
      w.write("opaque[$size, $align]", opaque)
    }
  }
}

type name-config = {
  suffix-strips: list[string],
  prefix-strips: list[string],
  renames: map[string, string],
}
ns for name-config {
  fn strip-prefix(self: name-config, name: string): string {
    for self.prefix-strips {
      if name.starts-with(it) {
        let stripped = name.drop(it.len())
        return stripped
      }
    }
    name
  }
  fn strip-suffix(self: name-config, name: string): string {
    for self.suffix-strips {
      if name.ends-with(it) {
        let stripped = name.drop-right(it.len())
        return stripped
      }
    }
    name
  }
  fn transformed-name(self: name-config, name: string): string {
    if self.renames.get(name) is :some(to) return to

    let name = self.strip-prefix(name)
    let name = self.strip-suffix(name)
    let name = mangle-name(name)
    name
  }
}
type bindgen-state = {
  out-path: ?string,
  unit: CXTranslationUnit,
  // state / output
  defns: list[k1-defn],
  macro-names: set[string],
  emitted-macros: map[string, string],

  // Inclusion config
  skip-system-defns: bool,
  exclude-substrings: list[string],
  include-names: set[string],
  opaque-names: set[string],

  name-config: name-config
}

ns for bindgen-state {
  fn is-opaque-name(self: *bindgen-state, name: string): bool {
    let result = self.opaque-names.contains(name)
    debug("is-opaque-name $name? $result")
    result
  }
  // +include names are always in. Alone they form a whitelist; alongside
  // +exclude they override it
  fn should-include-name(self: *bindgen-state, name: string): bool {
    if self.include-names.contains(name) return true
    if self.exclude-substrings.is-empty() and not self.include-names.is-empty() return false
    for exclude in self.exclude-substrings {
      if exclude.ends-with("$") {
        if name.ends-with(exclude.drop-right(1)) return false
      } else {
        if name.contains-string(exclude) return false
      }
    }
    true
  }
}

fn visit-struct(struct-root: CXCursor): { fields: k1-type:struct.fields, pending-anon-decl: ?k1-type, error: ?string } {
  let(returned) result = zeroed()
  debug("Handling struct decl")
  clang/visitChildren(
    parent = struct-root,
    visitor = visit-struct-member,
    client_data = (&result).as[ptr]
  )
  result
}

fn visit-struct-member(
  current: CXCursor,
  _parent: CXCursor,
  data: clang/CXClientData,
): clang/CXChildVisitResult {
  let result = data.narrow[*mut visit-struct.return]
  let cursor-display-name = clang/getCursorDisplayName(current).to-string()
  let cursor-spelling = clang/getCursorSpelling(current).to-string()
  debug("visit-struct-member $cursor-display-name")
  let cursor-kind = clang/getCursorKind(current)
  if cursor-kind is {
    :FieldDecl -> {
      let field-name = cursor-spelling
      let typ = if result.pending-anon-decl is {
        :none -> {
          let cx-type = clang/getCursorType(current)
          let is-bitfield = clang/Cursor_isBitField(current).as-bool()
          if is-bitfield {
            result.error = :some "bitfields are not supported yet"
            return :Break
          }
          if map-type(cx-type) is {
            :error-c msg -> {
              result.error = :some "Failed to map type of struct field '$field-name': $msg"
              return :Break
            },
            other -> other
          }
        },
        :some pending -> pending
      }
      result.pending-anon-decl = :none
      let offset-bits = clang/Cursor_getOffsetOfField(current)
      let offset: ?size = if offset-bits >= 0 :some(offset-bits / 8) else :none
      result.fields.push(.{ name = field-name, type = typ, offset })
      :Continue
    },
    :StructDecl or :UnionDecl -> {
      // Anonymous member
      let kind: k1-type:struct.kind = if cursor-kind is :StructDecl { :struct } else :union
      let is-anon = clang/Cursor_isAnonymous(current).as-bool()
      if is-anon {
        debug("recursing into struct member $cursor-spelling")
        let anon-result = visit-struct(current)
        if anon-result.error is :some msg {
          result.error = :some msg
          :Break
        } else {
           result.pending-anon-decl = :some :struct .{ fields = anon-result.fields, kind }
          :Continue
        }
      } else {
        let field-name = cursor-spelling
        let cx-type = clang/getCursorType(current)
        let type = map-type(cx-type)
        
        result.fields.push(.{ name = field-name, type, offset = :none })
        :Continue
      }
    },
    _ -> {
      result.error = :some "Encountered unexpected cursor kind in struct member: ${cursor-kind.enum-name()} $cursor-display-name"
      :Break
    }
  }
}

fn visit-enum(enum-root: CXCursor): { enum: k1-type:enum, error: ?string } {
  let(returned) result = zeroed()
  let int-cx-type = clang/getEnumDeclIntegerType(enum-root)
  let int-type = if map-type(int-cx-type) is {
    :error-c c-type -> { result.error = :some "Failed to map type: $c-type"; return result },
    :k1 t -> t,
    other -> { result.error = :some "bad int type"; return result },
  }
  result.enum.int-type = int-type
  let visit-enum-member = fn(
    current: CXCursor,
    _parent: CXCursor,
    data: clang/CXClientData -> clang/CXChildVisitResult
  ) {
    let result = data.narrow[*mut visit-enum.return]
    let cursor-display-name = clang/getCursorDisplayName(current).to-string()
    let cursor-spelling = clang/getCursorSpelling(current).to-string()
    let cursor-kind = clang/getCursorKind(current)
    if clang/isAttribute(cursor-kind).as-bool() return :Continue
    if cursor-kind is {
      :EnumConstantDecl -> {
        let member-name = cursor-spelling
        let value-i64 = clang/getEnumConstantDeclValue(current)
        let value: string = value-i64.show()
        let dup = false
        for result.enum.members { if it.explicit-value == value { dup = true } }
        if not dup {
          result.enum.members.push(.{ name = member-name, explicit-value = value })
        }
        :Continue
      },
      _ -> {
        result.error = :some "Encountered unexpected cursor kind in enum: ${cursor-kind.enum-name()} $cursor-display-name"
        :Break
      }
    }
  }
  clang/visitChildren(
    parent = enum-root,
    visitor = visit-enum-member,
    client_data = (&result).as[ptr]
  )
  result
}

fn get-location(cursor: CXCursor): { location: clang/CXSourceLocation, filename: string, line: u32 } {
  let location = clang/getCursorLocation(cursor)
  let nulllocn = clang/getNullLocation()
  if clang/equalLocations(location, nulllocn).as-bool() {
    info("ERROR: got null location, but We Continue")
  }
  let file: clang/CXFile = uninit
  let line: u32 = uninit
  clang/getFileLocation(location, &file, &line, ptr/null.narrow(), ptr/null.narrow())
  // Compiler-predefined macros have no file
  let filename = if file.is-null() "" else clang/getFileName(file).to-string()
  .{ location, filename, line }
}

fn visit-root(
  current: CXCursor,
  _parent: CXCursor,
  client-data: clang/CXClientData,
): clang/CXChildVisitResult {
  let bg = client-data.narrow[*mut bindgen-state]
  let cursor-kind = clang/getCursorKind(current)

  let display-name = clang/getCursorDisplayName(current).to-string()
  let locn = get-location(current)
  let is-system = clang/Location_isInSystemHeader(locn.location).as-bool()
  debug("visiting definition: `$display-name` is-system=$is-system")
  if is-system and bg.skip-system-defns {
    debug("  skipping system defn")
    return :Continue
  }

  if cursor-kind is {
    :StructDecl or :UnionDecl -> {
      let name = clang/getCursorSpelling(current).to-string()
      let kind = if cursor-kind is :StructDecl { :struct: k1-type:struct.kind } else :union
      if clang/isCursorDefinition(current).as-bool() {

        if bg.is-opaque-name(name) {
          let opaque = visit-opaque(bg, current)
          bg.defns.push(.{
            name,
            error = :none,
            kind = :typedef .{ type = opaque, alias = false },
            layout = layout-for-cursor(current)
          })
          return :Continue
        }

        let struct-decl-result = visit-struct(current)

        bg.defns.push(.{
          name,
          error = struct-decl-result.error,
          kind = :typedef .{ type = :struct .{ fields = struct-decl-result.fields, kind }, alias = false },
          layout = layout-for-cursor(current),
        })
      }
      :Continue
    },
    :EnumDecl -> {
      let is-anon = clang/Cursor_isAnonymous(current).as-bool()
      if is-anon { return :Continue }
      let name = clang/getCursorSpelling(current).to-string()
      let enum-decl-result = visit-enum(current)
      enum-decl-result.enum.members.filter-in-place(fn[bg] m. bg.should-include-name(m.name))

      bg.defns.push(.{
        name,
        error = enum-decl-result.error,
        kind = :typedef .{ type = :enum enum-decl-result.enum, alias = false },
        layout = layout-for-cursor(current)
      })
      :Continue
    },
    :TypedefDecl -> {
      let name = clang/getCursorSpelling(current).to-string()

      if bg.is-opaque-name(name) {
        let opaque = visit-opaque(bg, current)
        bg.defns.push(.{
          name,
          error = :none,
          kind = :typedef .{ type = opaque, alias = false },
          layout = layout-for-cursor(current)
        })
        return :Continue
      }

      let cx-type = clang/getTypedefDeclUnderlyingType(current)
      stub-undefined-record(bg, cx-type)
      let type = map-type(cx-type)
      bg.defns.push(.{
        name,
        error = :none,
        kind = :typedef .{ type, alias = true },
        layout = layout-for-cursor(current)
      })
      :Continue
    },
    :MacroDefinition -> {
      if locn.filename.is-empty() return :Continue // compiler-predefined
      if clang/Cursor_isMacroFunctionLike(current).as-bool() return :Continue
      if clang/Cursor_isMacroBuiltin(current).as-bool() return :Continue
      let name = clang/getCursorSpelling(current).to-string()
      if not bg.macro-names.add(name) return :Continue
      let body = macro-body-tokens(bg.unit, current)
      if transpile-macro-body(bg.name-config, bg.emitted-macros, body.as-span()) is {
        :ok value -> {
          bg.emitted-macros.insert(name, value.type)
          bg.defns.push(.{
            name,
            kind = :constant .{ type = :k1 (value.type), value = value.text },
            error = :none,
            layout = :none,
          })
        },
        :err msg -> { debug("skipping macro $name: $msg") }
      }
      :Continue
    },
    :VarDecl -> {
      let name = clang/getCursorSpelling(current).to-string()
      if not (clang/getCursorLinkage(current) is :External) {
        debug("skipping VarDecl $name: not externally linked")
        return :Continue
      }
      let cx-type = clang/getCursorType(current)
      let mutable = clang/isConstQualifiedType(cx-type) == 0
      let tls = not (clang/getCursorTLSKind(current) is :None)
      let type = map-type(cx-type)
      bg.defns.push(.{
        name,
        kind = :global .{ type, mutable, tls },
        error = :none,
        layout = :none,
      })
      :Continue
    },
    :FunctionDecl -> {
      let name = clang/getCursorSpelling(current).to-string()
      let cx-type = clang/getCursorType(current)
      debug("FunctionDecl $name ${cx-type.kind.enum-name()}")
      let fn-decl = map-fn-decl(current)

      bg.defns.push(.{
        name,
        error = fn-decl.error,
        kind = :function .{ fn-type = fn-decl.fn-type },
        layout = :none,
      })

      :Continue
    },
    _ -> {
      let cursor-kind-name = clang/getCursorKindSpelling(cursor-kind).to-string()
      debug("Skipping CXCursorKind: $cursor-kind-name")
      :Continue
    }
  }
}

fn layout-for-cursor(cursor: CXCursor): ?layout {
  let cx-type = clang/getCursorType(cursor)
  let size = clang/Type_getSizeOf(cx-type)
  let align = clang/Type_getAlignOf(cx-type)
  if size < 0 or align < 0 return :none
  :some .{ size, align }
}

fn stub-undefined-record(bg: *mut bindgen-state, cx-type: clang/CXType) {
  let t = cx-type
  loop {
    if t.kind is {
      :Elaborated -> { t = clang/Type_getNamedType(t) },
      :Pointer -> { t = clang/getPointeeType(t) },
      :Record -> {
        let decl = clang/getTypeDeclaration(t)
        if clang/Cursor_isNull(clang/getCursorDefinition(decl)) == 0 { return }
        let name = clang/getCursorSpelling(decl).to-string()
        if name.is-empty() { return }
        for bg.defns { if it.name == name { return } }
        bg.defns.push(.{
          name,
          error = :none,
          kind = :typedef .{ type = :opaque .{ size = 0, align = 1 }, alias = false },
          layout = :none,
        })
        return
      },
      _ -> { return },
    }
  }
}

fn visit-opaque(_bg: *mut bindgen-state, cursor: CXCursor): k1-type {
  let size = clang/Type_getSizeOf(clang/getCursorType(cursor))
  let align = clang/Type_getAlignOf(clang/getCursorType(cursor))
  :opaque .{ size, align }
}

fn map-fn-decl(cursor: CXCursor): { fn-type: fn-type, error: ?string } {
  let(returned) result = {
    let cx-type = clang/getCursorType(cursor)
    let ret-cx-type = clang/getResultType(cx-type)
    let return-type = map-type(ret-cx-type)
    .{
      fn-type = .{
        params = list/empty(),
        return-type,
      },
      error = :none
    }
  }

  clang/visitChildren(
    parent = cursor,
    visitor = visit-fn-param,
    client_data = (&result).as[ptr]
  )

  result
}

fn visit-fn-param(
  current: CXCursor,
  _parent: CXCursor,
  data: clang/CXClientData,
): clang/CXChildVisitResult {
  let result = data.narrow[*mut map-fn-decl.return]
  let cursor-kind = clang/getCursorKind(current)
  if cursor-kind is {
    :ParmDecl -> {
      let name-spelling = clang/getCursorSpelling(current).to-string()
      let name: ?string = if name-spelling.is-empty() :none else :some name-spelling
      let cx-type = clang/getCursorType(current)
      let arg-type = map-type-ext(cx-type, :fn-param)
      result.fn-type.params.push(.{ name, type = arg-type })
      :Continue
    },
    _ -> :Continue
  }
}

fn map-fn-type(cx-type: clang/CXType): fn-type {
  if cx-type.kind != :FunctionProto {
    info("map-fn-type on unexpected type: ${cx-type.kind.enum-name()}")
  }
  let ret-type = clang/getResultType(cx-type)
  let arg-count = clang/getNumArgTypes(cx-type)
  let args = list/empty[fn-type.params.t]()
  for 0.until(arg-count) {
    let arg-cx-type = clang/getArgType(cx-type, it.trunc[u32])
    let arg-type = map-type-ext(arg-cx-type, :fn-param)
    let name: ?string = :none
    args.push(.{ name, type = arg-type })
  }

  let ret-type = map-type(ret-type)
  .{ return-type = ret-type, params = args }
}

// Experimenting with an 'error free' style, where
// we just have a failure variant in k1-type, simplifies
// this program massively. But how much complexity do we give back
// to handle these failed type mappings later?
// fn map-type(cx-type: clang/CXType): result[k1-type, string]
// fn map-type(cx-type: clang/CXType): k1-type

fn map-type(cx-type: clang/CXType): k1-type {
  map-type-ext(cx-type, :default)
}
fn map-type-ext(cx-type: clang/CXType, c-context: either { default, fn-param }): k1-type {
  // debug("  map-type {cx-type.kind.enum-name()}");
  let s: k1-type = if cx-type.kind is {
    :Void      -> :k1 "{}",
    :Bool      -> :k1 "bool",
    :Char_U    -> :k1 "u8",
    :UChar     -> :k1 "u8",
    :Char16    -> :k1 "i16",
    :Char32    -> :k1 "i32",
    :UShort    -> :k1 "u16",
    :UInt      -> :k1 "u32",
    :ULong     -> :k1 "u64",
    :ULongLong -> :k1 "u64",
    :UInt128   -> :k1 "u128 unsupported",
    :Char_S    -> :k1 "u8",
    :SChar     -> :k1 "i8",
    :WChar     -> :k1 "i32",
    :Short     -> :k1 "i16",
    :Int       -> :k1 "i32",
    :Pointer   -> {
      let inner = clang/getPointeeType(cx-type)
      let inner-mapped = map-type(inner)
      if inner-mapped is :k1 "{}" {
        :k1 "ptr"
      } else {
        let inner: *k1-type = mem/new(inner-mapped)
        :ref .{ inner }
      }
    },
    :Float     -> :k1 "f32",
    :Double    -> :k1 "f64",
    :LongDouble    -> :k1 "f64",
    :LongLong  -> :k1 "i64",
    :Long      -> :k1 "i64",
    :Elaborated -> {
      let named-type = clang/Type_getNamedType(cx-type)
      map-type(named-type)
    },
    :Typedef -> {
      let name = clang/getTypedefName(cx-type).to-string()
      if name is {
        "uintptr_t" -> :k1 "ptr",
        "intptr_t"  -> :k1 "ptr",
        "ptrdiff_t" -> :k1 "size",
        "size_t"    -> :k1 "usize",
        "ssize_t"   -> :k1 "size",
        "wchar_t"   -> :k1 "i32",
        "va_list"   -> :k1 "ptr",
        "int8_t"    -> :k1 "i8",
        "__int8_t"    -> :k1 "i8",
        "int16_t"   -> :k1 "i16",
        "__int16_t"   -> :k1 "i16",
        "int32_t"   -> :k1 "i32",
        "__int32_t" -> :k1 "i32",
        "int64_t"   -> :k1 "i64",
        "__int64_t"   -> :k1 "i64",
        "uint8_t"   -> :k1 "u8",
        "__uint8_t"   -> :k1 "u8",
        "uint16_t"  -> :k1 "u16",
        "__uint16_t"  -> :k1 "u16",
        "uint32_t"  -> :k1 "u32",
        "__uint32_t"-> :k1 "u32",
        "uint64_t"  -> :k1 "u64",
        "__uint64_t"  -> :k1 "u64",
        _ -> :name name
      }
    },
    :Record -> {
      let decl-cursor = clang/getTypeDeclaration(cx-type)
      let is-anon = clang/Cursor_isAnonymousRecordDecl(decl-cursor).as-bool()
      if is-anon {
        return :error-c "anon record (struct/union)"
      } else {
        let name = clang/getCursorSpelling(decl-cursor).to-string()
        :name name
      }
    },
    :ConstantArray -> {
      let elem-type = clang/getArrayElementType(cx-type)
      let elem-type-mapped = mem/new(map-type(elem-type))
      let size = clang/getArraySize(cx-type)
      :array .{ elem-type = elem-type-mapped, size }
    },
    :IncompleteArray -> {
      let elem-type = clang/getArrayElementType(cx-type)
      let elem-mapped = mem/new(map-type(elem-type))
      if c-context is {
        :default -> {
          // Typically, an IncompleteArray means a Flexible Array member
          // Which we can model very nicely as 0-sized array
          :array .{ elem-type = elem-mapped, size = 0 }
        },
        :fn-param -> {
          // If it occurs in a function param, it just decays to a pointer
          :ref .{ inner = elem-mapped }
        }
      }
    },
    :Invalid -> {
      return :error-c "Encountered an Invalid type TODO locn"
    },
    :Enum -> {
      // enum CXCursorKind kind;
      let decl-cursor = clang/getTypeDeclaration(cx-type)
      let name = clang/getCursorSpelling(decl-cursor).to-string()
      :name name
    },
    :FunctionProto -> {
      // typedef struct {
      //   int (*abortQuery)(CXClientData client_data, void *reserved);
      // }
      :fn-type .{ fn-type = mem/new(map-fn-type(cx-type)) }
    },
    o -> {
      :error-c "other type: ${o.enum-name()} (${cx-type.kind.value})"
    }
  }
  s
}

// TODO: finish basic log solution; put it in std
// - need lazy eval of the messages
// - need push/pop verbosity
// - need 'tags' we can switch on/off to target things like
//   for example 'struct', 'enum', 'root'
let(mutable) log-level: either { debug, info } = :info
fn info(msg: string) {
  eprintln("INFO $msg")
}
fn debug(msg: string) {
  if log-level == :debug { eprintln(msg) }
}
