// The q0 (one-pass) brotli encoder, ported from the C's compress_fragment.c
// and encode.c's fast streaming path. Emits complete metablocks per fragment;
// stream state between fragments is the partial last byte plus the adaptive
// command prefix code.

let MAX-DISTANCE: size = (1 << 18) - 16 // BROTLI_MAX_BACKWARD_LIMIT(18)
let FIRST-BLOCK-SIZE: size = 3 << 15
let MERGE-BLOCK-SIZE: size = 1 << 16
let INPUT-MARGIN: size = 16
let MIN-MATCH: size = 5
let MAX-TABLE-SIZE: size = 1 << 15
let FRAGMENT-SIZE: size = 1 << 18 // block_size_limit for lgwin 18
let HASH-MUL32: u64 = 0x1E35A7BD
let MIN-RATIO: size = 980

type one-pass-arena = {
  lit-depth: array[u8, 256],
  lit-bits: array[u16, 256],
  // Command and distance prefix codes over the reordered 64+64 symbol
  // alphabet; see compress_fragment.h in the vendored C for the layout.
  cmd-depth: array[u8, 128],
  cmd-bits: array[u16, 128],
  cmd-histo: array[u32, 128],
  cmd-code: array[u8, 512],
  cmd-code-numbits: size,
  tree: array[huffman-tree, 513],
  histogram: array[u32, 256],
  tmp-depth: array[u8, 704],
  tmp-bits: array[u16, 64],
}

fn min-size(a: size, b: size): size { if a < b a else b }

fn hash-bytes(p: ptr, shift: u32): size {
  (((load64-le(p) << 24) * HASH-MUL32) >> shift).signed()
}

fn hash-bytes-at-offset(v: u64, offset: u32, shift: u32): size {
  ((((v >> (8 * offset)) << 24) * HASH-MUL32) >> shift).signed()
}

fn is-match(p1: ptr, p2: ptr): bool {
  load32-le(p1) == load32-le(p2) and
  p1.add-bytes(4).ref[u8].* == p2.add-bytes(4).ref[u8].*
}

fn find-match-length(s1: ptr, s2: ptr, limit: size): size {
  let p1 = s1
  let p2 = s2
  let lim = limit
  while lim >= 8 {
    let x = load64-le(p2) ^ load64-le(p1)
    if x != 0 {
      return p1.diff(s1) + (x.trailing-zeros() >> 3).signed()
    }
    p1 = p1.add-bytes(8)
    p2 = p2.add-bytes(8)
    lim = lim - 8
  }
  while lim > 0 and p1.ref[u8].* == p2.ref[u8].* {
    p1 = p1.add-bytes(1)
    p2 = p2.add-bytes(1)
    lim = lim - 1
  }
  p1.diff(s1)
}

fn emit-insert-len(insertlen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: *mut bit-writer) {
  if insertlen < 6 {
    let code = insertlen + 40
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else if insertlen < 130 {
    let tail = insertlen - 2
    let nbits = log2-floor-nonzero(tail.unsigned()) - 1
    let prefix = tail >> nbits.trunc[u32]
    let inscode = (nbits << 1) + prefix + 42
    bw.write-bits(depth.index-unchecked(inscode).*.widen[size], bits.index-unchecked(inscode).*.widen[u64])
    bw.write-bits(nbits, (tail - (prefix << nbits.trunc[u32])).unsigned())
    histo.index-unchecked(inscode).* = histo.index-unchecked(inscode).* + 1
  } else if insertlen < 2114 {
    let tail = insertlen - 66
    let nbits = log2-floor-nonzero(tail.unsigned())
    let code = nbits + 50
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    let pow2: size = 1 << nbits.trunc[u32]
    bw.write-bits(nbits, (tail - pow2).unsigned())
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else {
    bw.write-bits(depth.index-unchecked(61).*.widen[size], bits.index-unchecked(61).*.widen[u64])
    bw.write-bits(12, (insertlen - 2114).unsigned())
    histo.index-unchecked(61).* = histo.index-unchecked(61).* + 1
  }
}

fn emit-long-insert-len(insertlen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: *mut bit-writer) {
  if insertlen < 22594 {
    bw.write-bits(depth.index-unchecked(62).*.widen[size], bits.index-unchecked(62).*.widen[u64])
    bw.write-bits(14, (insertlen - 6210).unsigned())
    histo.index-unchecked(62).* = histo.index-unchecked(62).* + 1
  } else {
    bw.write-bits(depth.index-unchecked(63).*.widen[size], bits.index-unchecked(63).*.widen[u64])
    bw.write-bits(24, (insertlen - 22594).unsigned())
    histo.index-unchecked(63).* = histo.index-unchecked(63).* + 1
  }
}

fn emit-copy-len(copylen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: *mut bit-writer) {
  if copylen < 10 {
    let code = copylen + 14
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else if copylen < 134 {
    let tail = copylen - 6
    let nbits = log2-floor-nonzero(tail.unsigned()) - 1
    let prefix = tail >> nbits.trunc[u32]
    let code = (nbits << 1) + prefix + 20
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    bw.write-bits(nbits, (tail - (prefix << nbits.trunc[u32])).unsigned())
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else if copylen < 2118 {
    let tail = copylen - 70
    let nbits = log2-floor-nonzero(tail.unsigned())
    let code = nbits + 28
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    let pow2: size = 1 << nbits.trunc[u32]
    bw.write-bits(nbits, (tail - pow2).unsigned())
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else {
    bw.write-bits(depth.index-unchecked(39).*.widen[size], bits.index-unchecked(39).*.widen[u64])
    bw.write-bits(24, (copylen - 2118).unsigned())
    histo.index-unchecked(39).* = histo.index-unchecked(39).* + 1
  }
}

fn emit-copy-len-last-distance(copylen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: *mut bit-writer) {
  if copylen < 12 {
    let code = copylen - 4
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else if copylen < 72 {
    let tail = copylen - 8
    let nbits = log2-floor-nonzero(tail.unsigned()) - 1
    let prefix = tail >> nbits.trunc[u32]
    let code = (nbits << 1) + prefix + 4
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    bw.write-bits(nbits, (tail - (prefix << nbits.trunc[u32])).unsigned())
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  } else if copylen < 136 {
    let tail = copylen - 8
    let code = (tail >> 5) + 30
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    bw.write-bits(5, (tail & 31).unsigned())
    bw.write-bits(depth.index-unchecked(64).*.widen[size], bits.index-unchecked(64).*.widen[u64])
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
    histo.index-unchecked(64).* = histo.index-unchecked(64).* + 1
  } else if copylen < 2120 {
    let tail = copylen - 72
    let nbits = log2-floor-nonzero(tail.unsigned())
    let code = nbits + 28
    bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
    let pow2: size = 1 << nbits.trunc[u32]
    bw.write-bits(nbits, (tail - pow2).unsigned())
    bw.write-bits(depth.index-unchecked(64).*.widen[size], bits.index-unchecked(64).*.widen[u64])
    histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
    histo.index-unchecked(64).* = histo.index-unchecked(64).* + 1
  } else {
    bw.write-bits(depth.index-unchecked(39).*.widen[size], bits.index-unchecked(39).*.widen[u64])
    bw.write-bits(24, (copylen - 2120).unsigned())
    bw.write-bits(depth.index-unchecked(64).*.widen[size], bits.index-unchecked(64).*.widen[u64])
    histo.index-unchecked(39).* = histo.index-unchecked(39).* + 1
    histo.index-unchecked(64).* = histo.index-unchecked(64).* + 1
  }
}

fn emit-distance(distance: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: *mut bit-writer) {
  let d = distance + 3
  let nbits = log2-floor-nonzero(d.unsigned()) - 1
  let prefix = (d >> nbits.trunc[u32]) & 1
  let offset = (2 + prefix) << nbits.trunc[u32]
  let distcode = 2 * (nbits - 1) + prefix + 80
  bw.write-bits(depth.index-unchecked(distcode).*.widen[size], bits.index-unchecked(distcode).*.widen[u64])
  bw.write-bits(nbits, (d - offset).unsigned())
  histo.index-unchecked(distcode).* = histo.index-unchecked(distcode).* + 1
}

fn emit-literals(input: ptr, len: size, depth: buffer[u8], bits: buffer[u16], bw: *mut bit-writer) {
  let j: size = 0
  while j < len {
    let lit = input.add-bytes(j).ref[u8].*
    bw.write-bits(depth.index-unchecked(lit).*.widen[size], bits.index-unchecked(lit).*.widen[u64])
    j = j + 1
  }
}

// REQUIRES: len <= 1 << 24
fn store-metablock-header(len: size, is-uncompressed: bool, bw: *mut bit-writer) {
  let nibbles: size = 6
  bw.write-bits(1, 0) // ISLAST
  if len <= (1 << 16) {
    nibbles = 4
  } else if len <= (1 << 20) {
    nibbles = 5
  }
  bw.write-bits(2, (nibbles - 4).unsigned())
  bw.write-bits(nibbles * 4, (len - 1).unsigned())
  bw.write-bits(1, if is-uncompressed 1 else 0) // ISUNCOMPRESSED
}

// Byte-aligns, copies the raw bytes, and re-establishes the bit writer's
// zero-ahead invariant. The metablock header goes out separately first.
fn emit-uncompressed-body(src: ptr, len: size, bw: *mut bit-writer) {
  bw.pos = ((bw.pos + 7) >> 3) << 3
  mem/copy(dst = bw.storage.add-bytes(bw.pos >> 3), src = src, count = len)
  bw.pos = bw.pos + (len << 3)
  bw.storage.add-bytes(bw.pos >> 3).ref[u8].* = 0
}

fn emit-uncompressed-meta-block(begin: ptr, end: ptr, storage-ix-start: size, bw: *mut bit-writer) {
  let len = end.diff(begin)
  bw.rewind(storage-ix-start)
  store-metablock-header(len, true, bw)
  emit-uncompressed-body(begin, len, bw)
}

fn should-use-uncompressed-mode(metablock-start: ptr, next-emit: ptr, insertlen: size, literal-ratio: size): bool {
  let compressed = next-emit.diff(metablock-start)
  if compressed * 50 > insertlen {
    false
  } else {
    literal-ratio > MIN-RATIO
  }
}

fn should-merge-block(s: *mut one-pass-arena, data: ptr, len: size, depths: buffer[u8]): bool {
  let histo = s.histogram.&.as-buffer()
  let SAMPLE-RATE: size = 43
  histo.memset(0)
  let i: size = 0
  while i < len {
    let b = data.add-bytes(i).ref[u8].*
    histo.index-unchecked(b).* = histo.index-unchecked(b).* + 1
    i = i + SAMPLE-RATE
  }
  let total = (len + SAMPLE-RATE - 1) / SAMPLE-RATE
  let r = (fast-log2(total) + 0.5) * total.as[f64] + 200.0
  i = 0
  while i < 256 {
    let h = histo.index-unchecked(i).*.widen[size]
    r = r - h.as[f64] * (depths.index-unchecked(i).*.widen[i64].as[f64] + fast-log2(h))
    i = i + 1
  }
  r >= 0.0
}

// Builds the literal prefix code from (a sample of) the input and stores it.
// Returns the estimated encoding ratio in millibytes per symbol.
fn build-and-store-literal-prefix-code(
  s: *mut one-pass-arena, input: ptr, input-size: size,
  depths: buffer[u8], bits: buffer[u16], bw: *mut bit-writer,
): size {
  let histogram = s.histogram.&.as-buffer()
  let tree = s.tree.&.as-buffer()
  histogram.memset(0)
  let histogram-total: size = uninit
  if input-size < (1 << 15) {
    let i: size = 0
    while i < input-size {
      let b = input.add-bytes(i).ref[u8].*
      histogram.index-unchecked(b).* = histogram.index-unchecked(b).* + 1
      i = i + 1
    }
    histogram-total = input-size
    i = 0
    while i < 256 {
      // Weigh the first 11 samples with weight 3 to account for the balancing
      // effect of the LZ77 phase on the histogram.
      let h = histogram.index-unchecked(i).*
      let adjust: u32 = 2 * (if h < 11 h else 11)
      histogram.index-unchecked(i).* = h + adjust
      histogram-total = histogram-total + adjust.widen[size]
      i = i + 1
    }
  } else {
    let SAMPLE-RATE: size = 29
    let i: size = 0
    while i < input-size {
      let b = input.add-bytes(i).ref[u8].*
      histogram.index-unchecked(b).* = histogram.index-unchecked(b).* + 1
      i = i + SAMPLE-RATE
    }
    histogram-total = (input-size + SAMPLE-RATE - 1) / SAMPLE-RATE
    i = 0
    while i < 256 {
      // As above, plus 1 to each count so no sampled-out symbol gets depth 0.
      let h = histogram.index-unchecked(i).*
      let adjust: u32 = 1 + 2 * (if h < 11 h else 11)
      histogram.index-unchecked(i).* = h + adjust
      histogram-total = histogram-total + adjust.widen[size]
      i = i + 1
    }
  }
  build-and-store-huffman-tree-fast(tree, histogram, histogram-total, 8, depths, bits, bw)
  let literal-ratio: size = 0
  let i: size = 0
  while i < 256 {
    let h = histogram.index-unchecked(i).*
    if h != 0 {
      literal-ratio = literal-ratio + (h.widen[size] * depths.index-unchecked(i).*.widen[size])
    }
    i = i + 1
  }
  (literal-ratio * 125) / histogram-total
}

// Builds the command+distance prefix codes (64 symbols each) from cmd-histo
// and stores them; the symbol reorder saves branches in the emit fns.
fn build-and-store-command-prefix-code(s: *mut one-pass-arena, bw: *mut bit-writer) {
  let histogram = s.cmd-histo.&.as-buffer()
  let depth = s.cmd-depth.&.as-buffer()
  let bits = s.cmd-bits.&.as-buffer()
  let tree = s.tree.&.as-buffer()
  let tmp-depth = s.tmp-depth.&.as-buffer()
  let tmp-bits = s.tmp-bits.&.as-buffer()
  tmp-depth.memset(0)

  create-huffman-tree(histogram, 64, 15, tree, depth)
  create-huffman-tree(histogram.drop(64), 64, 14, tree, depth.drop(64))

  copy-u8(tmp-depth, 0, depth, 0, 24)
  copy-u8(tmp-depth, 24, depth, 40, 8)
  copy-u8(tmp-depth, 32, depth, 24, 8)
  copy-u8(tmp-depth, 40, depth, 48, 8)
  copy-u8(tmp-depth, 48, depth, 32, 8)
  copy-u8(tmp-depth, 56, depth, 56, 8)
  convert-bit-depths-to-symbols(tmp-depth, 64, tmp-bits)
  copy-u16(bits, 0, tmp-bits, 0, 24)
  copy-u16(bits, 24, tmp-bits, 32, 8)
  copy-u16(bits, 32, tmp-bits, 48, 8)
  copy-u16(bits, 40, tmp-bits, 24, 8)
  copy-u16(bits, 48, tmp-bits, 40, 8)
  copy-u16(bits, 56, tmp-bits, 56, 8)
  convert-bit-depths-to-symbols(depth.drop(64), 64, bits.drop(64))

  // Serialized form uses the full 704-symbol command alphabet.
  let i: size = 0
  while i < 64 {
    tmp-depth.index-unchecked(i).* = 0
    i = i + 1
  }
  copy-u8(tmp-depth, 0, depth, 0, 8)
  copy-u8(tmp-depth, 64, depth, 8, 8)
  copy-u8(tmp-depth, 128, depth, 16, 8)
  copy-u8(tmp-depth, 192, depth, 24, 8)
  copy-u8(tmp-depth, 384, depth, 32, 8)
  i = 0
  while i < 8 {
    tmp-depth.index-unchecked(128 + 8 * i).* = depth.index-unchecked(40 + i).*
    tmp-depth.index-unchecked(256 + 8 * i).* = depth.index-unchecked(48 + i).*
    tmp-depth.index-unchecked(448 + 8 * i).* = depth.index-unchecked(56 + i).*
    i = i + 1
  }
  store-huffman-tree(tmp-depth, NUM_COMMAND_SYMBOLS, tree, bw)
  store-huffman-tree(depth.drop(64), 64, tree, bw)
}

fn copy-u8(dst: buffer[u8], dst-off: size, src: buffer[u8], src-off: size, count: size) {
  mem/copy(
    dst = dst.data-ptr().add-bytes(dst-off),
    src = src.data-ptr().add-bytes(src-off),
    count = count)
}

fn copy-u16(dst: buffer[u16], dst-off: size, src: buffer[u16], src-off: size, count: size) {
  mem/copy(
    dst = dst.data-ptr().add-bytes(dst-off * 2),
    src = src.data-ptr().add-bytes(src-off * 2),
    count = count * 2)
}

fn compress-fragment-impl(
  s: *mut one-pass-arena, input-start: ptr, fragment-size: size, is-last: bool,
  table: buffer[i32], table-bits: size, bw: *mut bit-writer,
) {
  let cmd-depth = s.cmd-depth.&.as-buffer()
  let cmd-bits = s.cmd-bits.&.as-buffer()
  let cmd-histo = s.cmd-histo.&.as-buffer()
  let lit-depth = s.lit-depth.&.as-buffer()
  let lit-bits = s.lit-bits.&.as-buffer()

  let input = input-start
  let input-size = fragment-size
  let base-ip = input-start
  let next-emit = input-start
  let shift = (64 - table-bits).trunc[u32]

  let metablock-start = input
  let block-size = min-size(input-size, FIRST-BLOCK-SIZE)
  let total-block-size = block-size
  // Bit position of the MLEN field, so the meta-block can be extended.
  let mlen-storage-ix = bw.pos + 3

  store-metablock-header(block-size, false, bw)
  bw.write-bits(13, 0) // no block splits, no contexts

  let literal-ratio = build-and-store-literal-prefix-code(s, input, block-size, lit-depth, lit-bits, bw)

  let ci: size = 0
  while ci + 7 < s.cmd-code-numbits {
    bw.write-bits(8, s.cmd-code.get(ci >> 3).widen[u64])
    ci = ci + 8
  }
  bw.write-bits(s.cmd-code-numbits & 7, s.cmd-code.get(s.cmd-code-numbits >> 3).widen[u64])

  loop { // emit_commands
    let hi: size = 0
    while hi < 128 {
      s.cmd-histo.get(hi) = k-cmd-histo-seed.get(hi)
      hi = hi + 1
    }

    let ip = input
    let last-distance: i64 = -1
    let ip-end = input.add-bytes(block-size)
    let goto-next-block = false

    if block-size >= INPUT-MARGIN {
      // For the last block keep a margin of 16 bytes so distances stay in
      // window; otherwise 5 bytes so a copy never overruns the block.
      let len-limit = min-size(block-size - MIN-MATCH, input-size - INPUT-MARGIN)
      let ip-limit = input.add-bytes(len-limit)

      ip = ip.add-bytes(1)
      let next-hash = hash-bytes(ip, shift)
      let done = false
      while not done {
        let skip: u32 = 32
        let next-ip = ip
        let candidate = ptr/null

        // Scan for a 5-byte match, with heuristic skipping on incompressible
        // stretches: every 32 misses widens the stride by one byte.
        loop {
          let h = next-hash
          let bytes-between = (skip >> 5).widen[size]
          skip = skip + 1
          ip = next-ip
          next-ip = ip.add-bytes(bytes-between)
          if next-ip > ip-limit {
            done = true
            break
          }
          next-hash = hash-bytes(next-ip, shift)
          let found = false
          candidate = ip.sub-bytes(last-distance)
          if is-match(ip, candidate) and candidate < ip {
            table.index-unchecked(h).* = ip.diff(base-ip).trunc[i32]
            found = true
          } else {
            candidate = base-ip.add-bytes(table.index-unchecked(h).*.widen[size])
            table.index-unchecked(h).* = ip.diff(base-ip).trunc[i32]
            found = is-match(ip, candidate)
          }
          if found and ip.diff(candidate) <= MAX-DISTANCE {
            break
          }
        }
        if done break

        // Emit the literal run then the match; keep matching greedily from
        // the new position until a gap forces another scan.
        {
          let base = ip
          let matched = 5 + find-match-length(candidate.add-bytes(5), ip.add-bytes(5), ip-end.diff(ip) - 5)
          let distance = base.diff(candidate)
          let insert = base.diff(next-emit)
          ip = ip.add-bytes(matched)
          if insert < 6210 {
            emit-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          } else if should-use-uncompressed-mode(metablock-start, next-emit, insert, literal-ratio) {
            emit-uncompressed-meta-block(metablock-start, base, mlen-storage-ix - 3, bw)
            input-size = input-size - base.diff(input)
            input = base
            next-emit = input
            goto-next-block = true
            break
          } else {
            emit-long-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          }
          emit-literals(next-emit, insert, lit-depth, lit-bits, bw)
          if distance == last-distance {
            bw.write-bits(cmd-depth.index-unchecked(64).*.widen[size], cmd-bits.index-unchecked(64).*.widen[u64])
            cmd-histo.index-unchecked(64).* = cmd-histo.index-unchecked(64).* + 1
          } else {
            emit-distance(distance, cmd-depth, cmd-bits, cmd-histo, bw)
            last-distance = distance
          }
          emit-copy-len-last-distance(matched, cmd-depth, cmd-bits, cmd-histo, bw)

          next-emit = ip
          if ip >= ip-limit {
            break
          }
          // Hash positions inside the copy before moving on.
          let input-bytes = load64-le(ip.sub-bytes(3))
          let pos = ip.diff(base-ip)
          table.index-unchecked(hash-bytes-at-offset(input-bytes, 0, shift)).* = (pos - 3).trunc[i32]
          table.index-unchecked(hash-bytes-at-offset(input-bytes, 1, shift)).* = (pos - 2).trunc[i32]
          table.index-unchecked(hash-bytes-at-offset(input-bytes, 2, shift)).* = (pos - 1).trunc[i32]
          let cur-hash = hash-bytes-at-offset(input-bytes, 3, shift)
          candidate = base-ip.add-bytes(table.index-unchecked(cur-hash).*.widen[size])
          table.index-unchecked(cur-hash).* = pos.trunc[i32]
        }

        while is-match(ip, candidate) {
          // A match right at ip: no literals to emit.
          let base = ip
          let matched = 5 + find-match-length(candidate.add-bytes(5), ip.add-bytes(5), ip-end.diff(ip) - 5)
          if ip.diff(candidate) > MAX-DISTANCE break
          ip = ip.add-bytes(matched)
          last-distance = base.diff(candidate)
          emit-copy-len(matched, cmd-depth, cmd-bits, cmd-histo, bw)
          emit-distance(last-distance, cmd-depth, cmd-bits, cmd-histo, bw)

          next-emit = ip
          if ip >= ip-limit {
            done = true
            break
          }
          let input-bytes = load64-le(ip.sub-bytes(3))
          let pos = ip.diff(base-ip)
          table.index-unchecked(hash-bytes-at-offset(input-bytes, 0, shift)).* = (pos - 3).trunc[i32]
          table.index-unchecked(hash-bytes-at-offset(input-bytes, 1, shift)).* = (pos - 2).trunc[i32]
          table.index-unchecked(hash-bytes-at-offset(input-bytes, 2, shift)).* = (pos - 1).trunc[i32]
          let cur-hash = hash-bytes-at-offset(input-bytes, 3, shift)
          candidate = base-ip.add-bytes(table.index-unchecked(cur-hash).*.widen[size])
          table.index-unchecked(cur-hash).* = pos.trunc[i32]
        }
        if done break

        ip = ip.add-bytes(1)
        next-hash = hash-bytes(ip, shift)
      }
    }

    // C's goto web bottoms out here: merged blocks restart emit_commands
    // directly; otherwise trailing literals go out and, if input remains, a
    // fresh meta-block header starts the next round.
    if not goto-next-block {
      // emit_remainder
      input = input.add-bytes(block-size)
      input-size = input-size - block-size
      block-size = min-size(input-size, MERGE-BLOCK-SIZE)

      // Extend the current meta-block if the next block's histogram still
      // fits its literal code (both sizes have 5 nibbles once merged).
      if input-size > 0 and
        total-block-size + block-size <= (1 << 20) and
        should-merge-block(s, input, block-size, lit-depth) {
        total-block-size = total-block-size + block-size
        bw.update-bits(20, (total-block-size - 1).trunc[u32], mlen-storage-ix)
        continue
      }

      if next-emit < ip-end {
        let insert = ip-end.diff(next-emit)
        if insert < 6210 {
          emit-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          emit-literals(next-emit, insert, lit-depth, lit-bits, bw)
        } else if should-use-uncompressed-mode(metablock-start, next-emit, insert, literal-ratio) {
          emit-uncompressed-meta-block(metablock-start, ip-end, mlen-storage-ix - 3, bw)
        } else {
          emit-long-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          emit-literals(next-emit, insert, lit-depth, lit-bits, bw)
        }
      }
      next-emit = ip-end
    }

    // next_block
    if input-size == 0 break
    metablock-start = input
    block-size = min-size(input-size, FIRST-BLOCK-SIZE)
    total-block-size = block-size
    mlen-storage-ix = bw.pos + 3
    store-metablock-header(block-size, false, bw)
    bw.write-bits(13, 0)
    literal-ratio = build-and-store-literal-prefix-code(s, input, block-size, lit-depth, lit-bits, bw)
    build-and-store-command-prefix-code(s, bw)
  }

  if not is-last {
    // Store the updated command prefix code for the next fragment.
    s.cmd-code.get(0) = 0
    s.cmd-code-numbits = 0
    let code-bw: bit-writer = .{ storage = s.cmd-code.&.as-span().data-ptr(), pos = 0 }
    build-and-store-command-prefix-code(s, code-bw.&)
    s.cmd-code-numbits = code-bw.pos
  }
}

fn compress-fragment-fast(
  s: *mut one-pass-arena, input: ptr, input-size: size, is-last: bool,
  table: buffer[i32], table-size: size, bw: *mut bit-writer,
) {
  let initial-pos = bw.pos
  let table-bits = log2-floor-nonzero(table-size.unsigned())

  if input-size == 0 {
    assert(is-last)
    bw.write-bits(1, 1) // islast
    bw.write-bits(1, 1) // isempty
    bw.pos = ((bw.pos + 7) >> 3) << 3
    return
  }

  compress-fragment-impl(s, input, input-size, is-last, table, table-bits, bw)

  // If the output would be larger than one uncompressed metablock, rewrite it.
  if bw.pos - initial-pos > 31 + (input-size << 3) {
    emit-uncompressed-meta-block(input, input.add-bytes(input-size), initial-pos, bw)
  }

  if is-last {
    bw.write-bits(1, 1) // islast
    bw.write-bits(1, 1) // isempty
    bw.pos = ((bw.pos + 7) >> 3) << 3
  }
}

fn init-command-prefix-codes(s: *mut one-pass-arena) {
  let i: size = 0
  while i < 128 {
    s.cmd-depth.get(i) = k-default-command-depths.get(i)
    s.cmd-bits.get(i) = k-default-command-bits.get(i)
    i = i + 1
  }
  i = 0
  while i < 57 {
    s.cmd-code.get(i) = k-default-command-code.get(i)
    i = i + 1
  }
  s.cmd-code-numbits = 448
}

// Streaming encoder at quality 0 (one-pass, adaptive command code) or 1
// (two-pass, real histograms). Every process() call emits complete metablocks
// for its input (fragments of up to 256KB); only a partial byte — plus at q0
// the adaptive command code — carries over. flush() byte-aligns so everything
// emitted so far is decodable. lgwin is fixed at 18, matching the fragment
// distance limit.
type encoder = {
  quality: size,
  arena: one-pass-arena,
  arena2: *mut two-pass-arena, // q1 only
  cmd-buf: buffer[u32],        // q1 only
  lit-buf: buffer[u8],         // q1 only
  table: buffer[i32],
  storage: buffer[u8],
  last-bytes: u16,
  last-bytes-bits: u8,
  finished: bool,
}

ns for encoder {
  fn new-with-quality-in[a: allocator](alloc: a, quality: size): *mut encoder {
    let e: *mut encoder = alloc.alloc-t[encoder]()
    e.quality = quality
    if quality == 0 {
      e.table = buffer/allocate-in[i32, _](alloc, MAX-TABLE-SIZE)
    } else if quality == 1 {
      e.table = buffer/allocate-in[i32, _](alloc, Q1-MAX-TABLE-SIZE)
      e.arena2 = alloc.alloc-t[two-pass-arena]()
      e.cmd-buf = buffer/allocate-in[u32, _](alloc, TWO-PASS-BLOCK-SIZE)
      e.lit-buf = buffer/allocate-in[u8, _](alloc, TWO-PASS-BLOCK-SIZE)
    } else {
      crash("brotli encoder: only qualities 0 and 1 are implemented")
    }
    // Fragment output bound plus slack for the bit writer's 8-byte stores.
    e.storage = buffer/allocate-in[u8, _](alloc, 2 * FRAGMENT-SIZE + 503 + 8)
    e.reset()
    e
  }

  fn new-in[a: allocator](alloc: a): *mut encoder { new-with-quality-in(alloc, 0) }
  fn new(): *mut encoder { new-in(mem/current-arena()) }
  fn new-q1(): *mut encoder { new-with-quality-in(mem/current-arena(), 1) }

  // Makes the encoder ready for a fresh stream, reusing its buffers.
  fn reset(self: *mut encoder) {
    // Stream header: window bits 18 -> ((18 - 17) << 1) | 1, 4 bits.
    self.last-bytes = 3
    self.last-bytes-bits = 4
    self.finished = false
    if self.quality == 0 {
      init-command-prefix-codes(self.arena.&)
    }
  }

  fn hash-table-size(input-size: size, quality: size): size {
    let max-table-size = if quality == 0 MAX-TABLE-SIZE else Q1-MAX-TABLE-SIZE
    let htsize: size = 256
    while htsize < max-table-size and htsize < input-size {
      htsize = htsize << 1
    }
    // Only odd table-bits are supported by the one-pass hasher.
    if quality == 0 and (htsize & 0xAAAAA) == 0 {
      htsize = htsize << 1
    }
    htsize
  }

  fn compress-block(self: *mut encoder, input: ptr, len: size, is-last: bool, out: *mut list[u8]) {
    let table-size = hash-table-size(len, self.quality)
    mem/set(dst = self.table.data-ptr(), value = 0, count = table-size * 4)

    self.storage.index-unchecked(0).* = (self.last-bytes & 0xFF).trunc[u8]
    self.storage.index-unchecked(1).* = (self.last-bytes >> 8).trunc[u8]
    let bw: bit-writer = .{
      storage = self.storage.data-ptr(),
      pos = self.last-bytes-bits,
    }
    if self.quality == 0 {
      compress-fragment-fast(
        self.arena.&, input, len, is-last,
        self.table.slice(0, table-size), table-size, bw.&)
    } else {
      compress-fragment-two-pass(
        self.arena2, input, len, is-last, self.cmd-buf, self.lit-buf,
        self.table.slice(0, table-size), table-size, bw.&)
    }

    let out-bytes = bw.pos >> 3
    out.append-span(span/wrap-buffer(self.storage.slice(0, out-bytes)))
    self.last-bytes = self.storage.index-unchecked(out-bytes).*.widen[u16]
    self.last-bytes-bits = (bw.pos & 7).trunc[u8]
  }

  fn process(self: *mut encoder, input: span[u8], out: *mut list[u8]) {
    if self.finished crash("brotli encoder: process after finish")
    let pos: size = 0
    while pos < input.len() {
      let block = min-size(FRAGMENT-SIZE, input.len() - pos)
      self.compress-block(input.data-ptr().add-bytes(pos), block, false, out)
      pos = pos + block
    }
  }

  // Byte-aligns the stream (empty metadata block) so all input processed so
  // far is decodable from the bytes emitted so far.
  fn flush(self: *mut encoder, out: *mut list[u8]) {
    if self.finished crash("brotli encoder: flush after finish")
    if self.last-bytes-bits == 0 return
    // is_last = 0, MNIBBLES = 3 (metadata), reserved = 0, MSKIPBYTES = 0
    let seal = self.last-bytes.widen[u32] | (0x6u32 << self.last-bytes-bits.widen[u32])
    let seal-bits = self.last-bytes-bits + 6
    self.last-bytes = 0
    self.last-bytes-bits = 0
    let n = (seal-bits + 7) >> 3
    let i: size = 0
    while i < n {
      out.push((seal >> (8 * i.trunc[u32])).trunc[u8])
      i = i + 1
    }
  }

  // Emits the final empty metablock and the last partial byte.
  fn finish(self: *mut encoder, out: *mut list[u8]) {
    if self.finished crash("brotli encoder: finish after finish")
    self.compress-block(ptr/null, 0, true, out)
    self.finished = true
  }

  // One-shot: complete brotli stream for input, marking the last fragment
  // is-last exactly like the C streaming encoder given a single FINISH call.
  fn compress(self: *mut encoder, input: span[u8], out: *mut list[u8]) {
    if self.finished crash("brotli encoder: compress after finish")
    let pos: size = 0
    loop {
      let remaining = input.len() - pos
      let block = min-size(FRAGMENT-SIZE, remaining)
      let is-last = remaining == block
      self.compress-block(input.data-ptr().add-bytes(pos), block, is-last, out)
      pos = pos + block
      if is-last break
    }
    self.finished = true
  }
}
