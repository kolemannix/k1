let MAX-DISTANCE: size = (1 << 18) - 16
let FIRST-BLOCK-SIZE: size = 3 << 15
let MERGE-BLOCK-SIZE: size = 1 << 16
let INPUT-MARGIN: size = 16
let MIN-MATCH: size = 5
let MAX-TABLE-SIZE: size = 1 << 15
let FRAGMENT-SIZE: size = 1 << 18
let HASH-MUL32: u64 = 0x1E35A7BD
let MIN-RATIO: size = 980

type one-pass-arena = {
  lit-depth: array[u8, 256],
  lit-bits: array[u16, 256],
  cmd-depth: array[u8, 128],
  cmd-bits: array[u16, 128],
  cmd-histo: array[u32, 128],
  cmd-code: array[u8, 512],
  cmd-code-numbits: size,
  tree: array[huffman-tree, 513],
  histogram: array[u32, 256],
  tmp-depth: array[u8, 704],
  tmp-bits: array[u16, 64],
}

fn(inline) hash-bytes(p: ptr, shift: u32): size {
  (((load64-le(p) << 24) * HASH-MUL32) >> shift).signed()
}

fn(inline) hash-bytes-at-offset(v: u64, offset: u32, shift: u32): size {
  ((((v >> (8 * offset)) << 24) * HASH-MUL32) >> shift).signed()
}

fn(inline) is-match(p1: ptr, p2: ptr): bool {
  load32-le(p1) == load32-le(p2) and
  p1.add-bytes(4).ref[u8].* == p2.add-bytes(4).ref[u8].*
}

fn(inline) find-match-length(s1: ptr, s2: ptr, limit: size): size {
  let p1 = s1
  let p2 = s2
  let lim = limit
  while lim >= 8 {
    let x = load64-le(p2) ^ load64-le(p1)
    if x != 0 {
      return p1.diff(s1) + (x.trailing-zeros() >> 3).signed()
    }
    p1 = p1.add-bytes(8)
    p2 = p2.add-bytes(8)
    lim = lim - 8
  }
  while lim > 0 and p1.ref[u8].* == p2.ref[u8].* {
    p1 = p1.add-bytes(1)
    p2 = p2.add-bytes(1)
    lim = lim - 1
  }
  p1.diff(s1)
}

fn(inline) emit-code(code: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: bit-writer): bit-writer {
  histo.index-unchecked(code).* = histo.index-unchecked(code).* + 1
  bw.write-bits(depth.index-unchecked(code).*.widen[size], bits.index-unchecked(code).*.widen[u64])
}

fn(inline) emit-insert-len(insertlen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: bit-writer): bit-writer {
  if insertlen < 6 {
    emit-code(insertlen + 40, depth, bits, histo, bw)
  } else if insertlen < 130 {
    let tail = insertlen - 2
    let nbits = log2-floor-nonzero(tail.unsigned()) - 1
    let prefix = tail >> nbits.trunc[u32]
    emit-code((nbits << 1) + prefix + 42, depth, bits, histo, bw)
      .write-bits(nbits, (tail - (prefix << nbits.trunc[u32])).unsigned())
  } else if insertlen < 2114 {
    let tail = insertlen - 66
    let nbits = log2-floor-nonzero(tail.unsigned())
    emit-code(nbits + 50, depth, bits, histo, bw)
      .write-bits(nbits, (tail - (1 << nbits.trunc[u32])).unsigned())
  } else {
    emit-code(61, depth, bits, histo, bw).write-bits(12, (insertlen - 2114).unsigned())
  }
}

fn(inline) emit-long-insert-len(insertlen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: bit-writer): bit-writer {
  if insertlen < 22594 {
    emit-code(62, depth, bits, histo, bw).write-bits(14, (insertlen - 6210).unsigned())
  } else {
    emit-code(63, depth, bits, histo, bw).write-bits(24, (insertlen - 22594).unsigned())
  }
}

fn(inline) emit-copy-len(copylen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: bit-writer): bit-writer {
  if copylen < 10 {
    emit-code(copylen + 14, depth, bits, histo, bw)
  } else if copylen < 134 {
    let tail = copylen - 6
    let nbits = log2-floor-nonzero(tail.unsigned()) - 1
    let prefix = tail >> nbits.trunc[u32]
    emit-code((nbits << 1) + prefix + 20, depth, bits, histo, bw)
      .write-bits(nbits, (tail - (prefix << nbits.trunc[u32])).unsigned())
  } else if copylen < 2118 {
    let tail = copylen - 70
    let nbits = log2-floor-nonzero(tail.unsigned())
    emit-code(nbits + 28, depth, bits, histo, bw)
      .write-bits(nbits, (tail - (1 << nbits.trunc[u32])).unsigned())
  } else {
    emit-code(39, depth, bits, histo, bw).write-bits(24, (copylen - 2118).unsigned())
  }
}

fn(inline) emit-copy-len-last-distance(copylen: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: bit-writer): bit-writer {
  if copylen < 12 {
    emit-code(copylen - 4, depth, bits, histo, bw)
  } else if copylen < 72 {
    let tail = copylen - 8
    let nbits = log2-floor-nonzero(tail.unsigned()) - 1
    let prefix = tail >> nbits.trunc[u32]
    emit-code((nbits << 1) + prefix + 4, depth, bits, histo, bw)
      .write-bits(nbits, (tail - (prefix << nbits.trunc[u32])).unsigned())
  } else if copylen < 136 {
    let tail = copylen - 8
    let bw = emit-code((tail >> 5) + 30, depth, bits, histo, bw).write-bits(5, (tail & 31).unsigned())
    emit-code(64, depth, bits, histo, bw)
  } else if copylen < 2120 {
    let tail = copylen - 72
    let nbits = log2-floor-nonzero(tail.unsigned())
    let bw = emit-code(nbits + 28, depth, bits, histo, bw)
      .write-bits(nbits, (tail - (1 << nbits.trunc[u32])).unsigned())
    emit-code(64, depth, bits, histo, bw)
  } else {
    let bw = emit-code(39, depth, bits, histo, bw).write-bits(24, (copylen - 2120).unsigned())
    emit-code(64, depth, bits, histo, bw)
  }
}

fn(inline) emit-distance(distance: size, depth: buffer[u8], bits: buffer[u16], histo: buffer[u32], bw: bit-writer): bit-writer {
  let d = distance + 3
  let nbits = log2-floor-nonzero(d.unsigned()) - 1
  let prefix = (d >> nbits.trunc[u32]) & 1
  let offset = (2 + prefix) << nbits.trunc[u32]
  emit-code(2 * (nbits - 1) + prefix + 80, depth, bits, histo, bw)
    .write-bits(nbits, (d - offset).unsigned())
}

fn(inline) emit-literals(input: ptr, len: size, depth: buffer[u8], bits: buffer[u16], bw: bit-writer): bit-writer {
  let bw = bw
  let j: size = 0
  while j < len {
    let lit = input.add-bytes(j).ref[u8].*
    bw = bw.write-bits(depth.index-unchecked(lit).*.widen[size], bits.index-unchecked(lit).*.widen[u64])
    j = j + 1
  }
  bw
}

fn store-metablock-header(len: size, is-uncompressed: bool, bw: bit-writer): bit-writer {
  let nibbles: size = if len <= (1 << 16) 4 else if len <= (1 << 20) 5 else 6
  bw.write-bits(1, 0)
    .write-bits(2, (nibbles - 4).unsigned())
    .write-bits(nibbles * 4, (len - 1).unsigned())
    .write-bits(1, if is-uncompressed 1 else 0)
}

fn emit-uncompressed-body(src: ptr, len: size, bw: bit-writer): bit-writer {
  let bw = bw.align-to-byte()
  mem/copy(dst = bw.storage.add-bytes(bw.pos >> 3), src = src, count = len)
  bw = bw | .{ pos = bw.pos + (len << 3) }
  bw.storage.add-bytes(bw.pos >> 3).ref[u8].* = 0
  bw
}

fn emit-uncompressed-meta-block(begin: ptr, end: ptr, storage-ix-start: size, bw: bit-writer): bit-writer {
  let len = end.diff(begin)
  emit-uncompressed-body(begin, len, store-metablock-header(len, true, bw.rewind(storage-ix-start)))
}

fn should-use-uncompressed-mode(metablock-start: ptr, next-emit: ptr, insertlen: size, literal-ratio: size): bool {
  let compressed = next-emit.diff(metablock-start)
  if compressed * 50 > insertlen {
    false
  } else {
    literal-ratio > MIN-RATIO
  }
}

fn should-merge-block(s: *mut one-pass-arena, data: ptr, len: size, depths: buffer[u8]): bool {
  let histo = s.histogram.&.as-buffer()
  let SAMPLE-RATE: size = 43
  histo.memset(0)
  let i: size = 0
  while i < len {
    let b = data.add-bytes(i).ref[u8].*
    histo.index-unchecked(b).* = histo.index-unchecked(b).* + 1
    i = i + SAMPLE-RATE
  }
  let total = (len + SAMPLE-RATE - 1) / SAMPLE-RATE
  let r = (fast-log2(total) + 0.5) * total.as[f64] + 200.0
  i = 0
  while i < 256 {
    let h = histo.index-unchecked(i).*.widen[size]
    r = r - h.as[f64] * (depths.index-unchecked(i).*.widen[i64].as[f64] + fast-log2(h))
    i = i + 1
  }
  r >= 0.0
}

fn build-and-store-literal-prefix-code(
  s: *mut one-pass-arena, input: ptr, input-size: size,
  depths: buffer[u8], bits: buffer[u16], bw: bit-writer,
): { bw: bit-writer, literal-ratio: size } {
  let histogram = s.histogram.&.as-buffer()
  let tree = s.tree.&.as-buffer()
  histogram.memset(0)
  let histogram-total: size = uninit
  if input-size < (1 << 15) {
    let i: size = 0
    while i < input-size {
      let b = input.add-bytes(i).ref[u8].*
      histogram.index-unchecked(b).* = histogram.index-unchecked(b).* + 1
      i = i + 1
    }
    histogram-total = input-size
    i = 0
    while i < 256 {
      let h = histogram.index-unchecked(i).*
      let adjust: u32 = 2 * (if h < 11 h else 11)
      histogram.index-unchecked(i).* = h + adjust
      histogram-total = histogram-total + adjust.widen[size]
      i = i + 1
    }
  } else {
    let SAMPLE-RATE: size = 29
    let i: size = 0
    while i < input-size {
      let b = input.add-bytes(i).ref[u8].*
      histogram.index-unchecked(b).* = histogram.index-unchecked(b).* + 1
      i = i + SAMPLE-RATE
    }
    histogram-total = (input-size + SAMPLE-RATE - 1) / SAMPLE-RATE
    i = 0
    while i < 256 {
      let h = histogram.index-unchecked(i).*
      let adjust: u32 = 1 + 2 * (if h < 11 h else 11)
      histogram.index-unchecked(i).* = h + adjust
      histogram-total = histogram-total + adjust.widen[size]
      i = i + 1
    }
  }
  let bw = build-and-store-huffman-tree-fast(tree, histogram, histogram-total, 8, depths, bits, bw)
  let literal-ratio: size = 0
  let i: size = 0
  while i < 256 {
    let h = histogram.index-unchecked(i).*
    if h != 0 {
      literal-ratio = literal-ratio + (h.widen[size] * depths.index-unchecked(i).*.widen[size])
    }
    i = i + 1
  }
  .{ bw, literal-ratio = (literal-ratio * 125) / histogram-total }
}

fn build-and-store-command-prefix-code(s: *mut one-pass-arena, bw: bit-writer): bit-writer {
  let histogram = s.cmd-histo.&.as-buffer()
  let depth = s.cmd-depth.&.as-buffer()
  let bits = s.cmd-bits.&.as-buffer()
  let tree = s.tree.&.as-buffer()
  let tmp-depth = s.tmp-depth.&.as-buffer()
  let tmp-bits = s.tmp-bits.&.as-buffer()
  tmp-depth.memset(0)

  create-huffman-tree(histogram, 64, 15, tree, depth)
  create-huffman-tree(histogram.drop(64), 64, 14, tree, depth.drop(64))

  copy-u8(tmp-depth, 0, depth, 0, 24)
  copy-u8(tmp-depth, 24, depth, 40, 8)
  copy-u8(tmp-depth, 32, depth, 24, 8)
  copy-u8(tmp-depth, 40, depth, 48, 8)
  copy-u8(tmp-depth, 48, depth, 32, 8)
  copy-u8(tmp-depth, 56, depth, 56, 8)
  convert-bit-depths-to-symbols(tmp-depth, 64, tmp-bits)
  copy-u16(bits, 0, tmp-bits, 0, 24)
  copy-u16(bits, 24, tmp-bits, 32, 8)
  copy-u16(bits, 32, tmp-bits, 48, 8)
  copy-u16(bits, 40, tmp-bits, 24, 8)
  copy-u16(bits, 48, tmp-bits, 40, 8)
  copy-u16(bits, 56, tmp-bits, 56, 8)
  convert-bit-depths-to-symbols(depth.drop(64), 64, bits.drop(64))

  let i: size = 0
  while i < 64 {
    tmp-depth.index-unchecked(i).* = 0
    i = i + 1
  }
  copy-u8(tmp-depth, 0, depth, 0, 8)
  copy-u8(tmp-depth, 64, depth, 8, 8)
  copy-u8(tmp-depth, 128, depth, 16, 8)
  copy-u8(tmp-depth, 192, depth, 24, 8)
  copy-u8(tmp-depth, 384, depth, 32, 8)
  i = 0
  while i < 8 {
    tmp-depth.index-unchecked(128 + 8 * i).* = depth.index-unchecked(40 + i).*
    tmp-depth.index-unchecked(256 + 8 * i).* = depth.index-unchecked(48 + i).*
    tmp-depth.index-unchecked(448 + 8 * i).* = depth.index-unchecked(56 + i).*
    i = i + 1
  }
  let bw = store-huffman-tree(tmp-depth, NUM_COMMAND_SYMBOLS, tree, bw)
  store-huffman-tree(depth.drop(64), 64, tree, bw)
}

fn copy-u8(dst: buffer[u8], dst-off: size, src: buffer[u8], src-off: size, count: size) {
  mem/copy(
    dst = dst.data-ptr().add-bytes(dst-off),
    src = src.data-ptr().add-bytes(src-off),
    count = count)
}

fn copy-u16(dst: buffer[u16], dst-off: size, src: buffer[u16], src-off: size, count: size) {
  mem/copy(
    dst = dst.data-ptr().add-bytes(dst-off * 2),
    src = src.data-ptr().add-bytes(src-off * 2),
    count = count * 2)
}

fn(inline) update-table-after-copy-1p(ip: ptr, base-ip: ptr, table: buffer[i32], shift: u32): ptr {
  let input-bytes = load64-le(ip.sub-bytes(3))
  let pos = ip.diff(base-ip)
  table.index-unchecked(hash-bytes-at-offset(input-bytes, 0, shift)).* = (pos - 3).trunc[i32]
  table.index-unchecked(hash-bytes-at-offset(input-bytes, 1, shift)).* = (pos - 2).trunc[i32]
  table.index-unchecked(hash-bytes-at-offset(input-bytes, 2, shift)).* = (pos - 1).trunc[i32]
  let cur-hash = hash-bytes-at-offset(input-bytes, 3, shift)
  let candidate = base-ip.add-bytes(table.index-unchecked(cur-hash).*.widen[size])
  table.index-unchecked(cur-hash).* = pos.trunc[i32]
  candidate
}

fn compress-fragment-impl(
  s: *mut one-pass-arena, input-start: ptr, fragment-size: size, is-last: bool,
  table: buffer[i32], table-bits: size, bw: bit-writer,
): bit-writer {
  let bw = bw
  let cmd-depth = s.cmd-depth.&.as-buffer()
  let cmd-bits = s.cmd-bits.&.as-buffer()
  let cmd-histo = s.cmd-histo.&.as-buffer()
  let lit-depth = s.lit-depth.&.as-buffer()
  let lit-bits = s.lit-bits.&.as-buffer()

  let input = input-start
  let input-size = fragment-size
  let base-ip = input-start
  let next-emit = input-start
  let shift = (64 - table-bits).trunc[u32]

  let metablock-start = input
  let block-size = input-size.min(FIRST-BLOCK-SIZE)
  let total-block-size = block-size
  let mlen-storage-ix = bw.pos + 3

  bw = store-metablock-header(block-size, false, bw).write-bits(13, 0)

  let lit = build-and-store-literal-prefix-code(s, input, block-size, lit-depth, lit-bits, bw)
  bw = lit.bw
  let literal-ratio = lit.literal-ratio

  let ci: size = 0
  while ci + 7 < s.cmd-code-numbits {
    bw = bw.write-bits(8, s.cmd-code.[ci >> 3].widen[u64])
    ci = ci + 8
  }
  bw = bw.write-bits(s.cmd-code-numbits & 7, s.cmd-code.[s.cmd-code-numbits >> 3].widen[u64])

  loop {
    let hi: size = 0
    while hi < 128 {
      s.cmd-histo.[hi] = k-cmd-histo-seed.[hi]
      hi = hi + 1
    }

    let ip = input
    let last-distance: i64 = -1
    let ip-end = input.add-bytes(block-size)
    let goto-next-block = false

    if block-size >= INPUT-MARGIN {
      let len-limit = (block-size - MIN-MATCH).min(input-size - INPUT-MARGIN)
      let ip-limit = input.add-bytes(len-limit)

      ip = ip.add-bytes(1)
      let next-hash = hash-bytes(ip, shift)
      loop @scan {
        let skip: u32 = 32
        let next-ip = ip
        let candidate = ptr/null

        loop {
          let h = next-hash
          let bytes-between = (skip >> 5).widen[size]
          skip = skip + 1
          ip = next-ip
          next-ip = ip.add-bytes(bytes-between)
          if next-ip > ip-limit break @scan
          next-hash = hash-bytes(next-ip, shift)
          let found = false
          candidate = ip.sub-bytes(last-distance)
          if is-match(ip, candidate) and candidate < ip {
            table.index-unchecked(h).* = ip.diff(base-ip).trunc[i32]
            found = true
          } else {
            candidate = base-ip.add-bytes(table.index-unchecked(h).*.widen[size])
            table.index-unchecked(h).* = ip.diff(base-ip).trunc[i32]
            found = is-match(ip, candidate)
          }
          if found and ip.diff(candidate) <= MAX-DISTANCE {
            break
          }
        }

        {
          let base = ip
          let matched = 5 + find-match-length(candidate.add-bytes(5), ip.add-bytes(5), ip-end.diff(ip) - 5)
          let distance = base.diff(candidate)
          let insert = base.diff(next-emit)
          ip = ip.add-bytes(matched)
          if insert < 6210 {
            bw = emit-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          } else if should-use-uncompressed-mode(metablock-start, next-emit, insert, literal-ratio) {
            bw = emit-uncompressed-meta-block(metablock-start, base, mlen-storage-ix - 3, bw)
            input-size = input-size - base.diff(input)
            input = base
            next-emit = input
            goto-next-block = true
            break
          } else {
            bw = emit-long-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          }
          bw = emit-literals(next-emit, insert, lit-depth, lit-bits, bw)
          if distance == last-distance {
            bw = emit-code(64, cmd-depth, cmd-bits, cmd-histo, bw)
          } else {
            bw = emit-distance(distance, cmd-depth, cmd-bits, cmd-histo, bw)
            last-distance = distance
          }
          bw = emit-copy-len-last-distance(matched, cmd-depth, cmd-bits, cmd-histo, bw)

          next-emit = ip
          if ip >= ip-limit {
            break
          }
          candidate = update-table-after-copy-1p(ip, base-ip, table, shift)
        }

        while is-match(ip, candidate) {
          let base = ip
          let matched = 5 + find-match-length(candidate.add-bytes(5), ip.add-bytes(5), ip-end.diff(ip) - 5)
          if ip.diff(candidate) > MAX-DISTANCE break
          ip = ip.add-bytes(matched)
          last-distance = base.diff(candidate)
          bw = emit-copy-len(matched, cmd-depth, cmd-bits, cmd-histo, bw)
          bw = emit-distance(last-distance, cmd-depth, cmd-bits, cmd-histo, bw)

          next-emit = ip
          if ip >= ip-limit break @scan
          candidate = update-table-after-copy-1p(ip, base-ip, table, shift)
        }

        ip = ip.add-bytes(1)
        next-hash = hash-bytes(ip, shift)
      }
    }

    if not goto-next-block {
      input = input.add-bytes(block-size)
      input-size = input-size - block-size
      block-size = input-size.min(MERGE-BLOCK-SIZE)

      if input-size > 0 and
        total-block-size + block-size <= (1 << 20) and
        should-merge-block(s, input, block-size, lit-depth) {
        total-block-size = total-block-size + block-size
        bw.update-bits(20, (total-block-size - 1).trunc[u32], mlen-storage-ix)
        continue
      }

      if next-emit < ip-end {
        let insert = ip-end.diff(next-emit)
        if insert < 6210 {
          bw = emit-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          bw = emit-literals(next-emit, insert, lit-depth, lit-bits, bw)
        } else if should-use-uncompressed-mode(metablock-start, next-emit, insert, literal-ratio) {
          bw = emit-uncompressed-meta-block(metablock-start, ip-end, mlen-storage-ix - 3, bw)
        } else {
          bw = emit-long-insert-len(insert, cmd-depth, cmd-bits, cmd-histo, bw)
          bw = emit-literals(next-emit, insert, lit-depth, lit-bits, bw)
        }
      }
      next-emit = ip-end
    }

    if input-size == 0 break
    metablock-start = input
    block-size = input-size.min(FIRST-BLOCK-SIZE)
    total-block-size = block-size
    mlen-storage-ix = bw.pos + 3
    bw = store-metablock-header(block-size, false, bw).write-bits(13, 0)
    let next = build-and-store-literal-prefix-code(s, input, block-size, lit-depth, lit-bits, bw)
    literal-ratio = next.literal-ratio
    bw = build-and-store-command-prefix-code(s, next.bw)
  }

  if not is-last {
    s.cmd-code.[0] = 0
    let code-bw: bit-writer = .{ storage = s.cmd-code.&.as-span().data-ptr(), pos = 0 }
    s.cmd-code-numbits = build-and-store-command-prefix-code(s, code-bw).pos
  }
  bw
}

fn compress-fragment-fast(
  s: *mut one-pass-arena, input: ptr, input-size: size, is-last: bool,
  table: buffer[i32], table-size: size, bw: bit-writer,
): bit-writer {
  let initial-pos = bw.pos
  let table-bits = log2-floor-nonzero(table-size.unsigned())

  if input-size == 0 {
    assert(is-last)
    return bw.write-bits(1, 1).write-bits(1, 1).align-to-byte()
  }

  let bw = compress-fragment-impl(s, input, input-size, is-last, table, table-bits, bw)

  if bw.pos - initial-pos > 31 + (input-size << 3) {
    bw = emit-uncompressed-meta-block(input, input.add-bytes(input-size), initial-pos, bw)
  }

  if is-last {
    bw = bw.write-bits(1, 1).write-bits(1, 1).align-to-byte()
  }
  bw
}

fn init-command-prefix-codes(s: *mut one-pass-arena) {
  let i: size = 0
  while i < 128 {
    s.cmd-depth.[i] = k-default-command-depths.[i]
    s.cmd-bits.[i] = k-default-command-bits.[i]
    i = i + 1
  }
  i = 0
  while i < 57 {
    s.cmd-code.[i] = k-default-command-code.[i]
    i = i + 1
  }
  s.cmd-code-numbits = 448
}

type encoder = {
  quality: size,
  arena: one-pass-arena,
  arena2: *mut two-pass-arena,
  cmd-buf: buffer[u32],
  lit-buf: buffer[u8],
  table: buffer[i32],
  storage: buffer[u8],
  last-bytes: u16,
  last-bytes-bits: u8,
  finished: bool,
}

ns for encoder {
  fn new-with-quality-in[a: allocator](alloc: a, quality: size): *mut encoder {
    let e: *mut encoder = alloc.alloc-t[encoder]()
    e.quality = quality
    if quality == 0 {
      e.table = buffer/allocate-in[i32, _](alloc, MAX-TABLE-SIZE)
    } else if quality == 1 {
      e.table = buffer/allocate-in[i32, _](alloc, Q1-MAX-TABLE-SIZE)
      e.arena2 = alloc.alloc-t[two-pass-arena]()
      e.cmd-buf = buffer/allocate-in[u32, _](alloc, TWO-PASS-BLOCK-SIZE)
      e.lit-buf = buffer/allocate-in[u8, _](alloc, TWO-PASS-BLOCK-SIZE)
    } else {
      crash("brotli encoder: only qualities 0 and 1 are implemented")
    }
    e.storage = buffer/allocate-in[u8, _](alloc, 2 * FRAGMENT-SIZE + 503 + 8)
    e.reset()
    e
  }

  fn new-in[a: allocator](alloc: a): *mut encoder { new-with-quality-in(alloc, 0) }
  fn new(): *mut encoder { new-in(mem/current-arena()) }
  fn new-q1(): *mut encoder { new-with-quality-in(mem/current-arena(), 1) }

  fn reset(self: *mut encoder) {
    self.last-bytes = 3
    self.last-bytes-bits = 4
    self.finished = false
    if self.quality == 0 {
      init-command-prefix-codes(self.arena.&)
    }
  }

  fn hash-table-size(input-size: size, quality: size): size {
    let max-table-size = if quality == 0 MAX-TABLE-SIZE else Q1-MAX-TABLE-SIZE
    let htsize: size = 256
    while htsize < max-table-size and htsize < input-size {
      htsize = htsize << 1
    }
    if quality == 0 and (htsize & 0xAAAAA) == 0 {
      htsize = htsize << 1
    }
    htsize
  }

  fn compress-block(self: *mut encoder, input: ptr, len: size, is-last: bool, out: *mut list[u8]) {
    let table-size = hash-table-size(len, self.quality)
    mem/set(dst = self.table.data-ptr(), value = 0, count = table-size * 4)

    self.storage.index-unchecked(0).* = (self.last-bytes & 0xFF).trunc[u8]
    self.storage.index-unchecked(1).* = (self.last-bytes >> 8).trunc[u8]
    let bw: bit-writer = .{
      storage = self.storage.data-ptr(),
      pos = self.last-bytes-bits,
    }
    bw = if self.quality == 0 {
      compress-fragment-fast(
        self.arena.&, input, len, is-last,
        self.table.slice(0, table-size), table-size, bw)
    } else {
      compress-fragment-two-pass(
        self.arena2, input, len, is-last, self.cmd-buf, self.lit-buf,
        self.table.slice(0, table-size), table-size, bw)
    }

    let out-bytes = bw.pos >> 3
    out.append-span(span/wrap-buffer(self.storage.slice(0, out-bytes)))
    self.last-bytes = self.storage.index-unchecked(out-bytes).*.widen[u16]
    self.last-bytes-bits = (bw.pos & 7).trunc[u8]
  }

  fn process(self: *mut encoder, input: span[u8], out: *mut list[u8]) {
    if self.finished crash("brotli encoder: process after finish")
    let pos: size = 0
    while pos < input.len() {
      let block = FRAGMENT-SIZE.min(input.len() - pos)
      self.compress-block(input.data-ptr().add-bytes(pos), block, false, out)
      pos = pos + block
    }
  }

  fn flush(self: *mut encoder, out: *mut list[u8]) {
    if self.finished crash("brotli encoder: flush after finish")
    if self.last-bytes-bits == 0 return
    let seal = self.last-bytes.widen[u32] | (0x6u32 << self.last-bytes-bits.widen[u32])
    let seal-bits = self.last-bytes-bits + 6
    self.last-bytes = 0
    self.last-bytes-bits = 0
    let n = (seal-bits + 7) >> 3
    let i: size = 0
    while i < n {
      out.push((seal >> (8 * i.trunc[u32])).trunc[u8])
      i = i + 1
    }
  }

  fn finish(self: *mut encoder, out: *mut list[u8]) {
    if self.finished crash("brotli encoder: finish after finish")
    self.compress-block(ptr/null, 0, true, out)
    self.finished = true
  }

  fn compress(self: *mut encoder, input: span[u8], out: *mut list[u8]) {
    if self.finished crash("brotli encoder: compress after finish")
    let pos: size = 0
    loop {
      let remaining = input.len() - pos
      let block = FRAGMENT-SIZE.min(remaining)
      let is-last = remaining == block
      self.compress-block(input.data-ptr().add-bytes(pos), block, is-last, out)
      pos = pos + block
      if is-last break
    }
    self.finished = true
  }
}
