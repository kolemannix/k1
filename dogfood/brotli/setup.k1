// Regenerates tables.k1 from vendor/
let VENDOR: string = "vendor"

fn is-space(c: char): bool {
  c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

fn trim(s: string): string {
  let start: size = 0
  let end = s.len()
  while start < end and is-space(s.get(start)) { start = start + 1 }
  while end > start and is-space(s.get(end - 1)) { end = end - 1 }
  s.slice(start, end)
}

// Number of elements a C size declarator names; initializer lists shorter
// than this are zero-filled by C.
fn declared-count(decl: string, initializer-count: size): size {
  if decl == "" initializer-count
  else if decl == "BROTLI_NUM_COMMAND_SYMBOLS" 704
  else if decl == "BROTLI_LOG2_TABLE_SIZE" 256
  else u64/from-string(decl).!.as[size]
}

fn parse-u64-c(token: string): u64 {
  if token.starts-with("0x") {
    let v: u64 = 0
    let i: size = 2
    while i < token.len() {
      let c = token.get(i)
      let d: u64 = if c >= '0' and c <= '9' (c.as[u8] - '0'.as[u8]).as[u64]
        else if c >= 'a' and c <= 'f' (c.as[u8] - 'a'.as[u8]).as[u64] + 10
        else if c >= 'A' and c <= 'F' (c.as[u8] - 'A'.as[u8]).as[u64] + 10
        else crash("bad hex digit in '$token'")
      v = (v << 4) | d
      i = i + 1
    }
    v
  } else {
    u64/from-string(token).!
  }
}

// Finds `name[<decl>] = { <body> };` and returns the initializer tokens plus
// the declared element count.
fn parse-c-array(src: string, name: string): { tokens: list[string], declared: size } {
  let from: size = 0
  loop {
    require src.slice(from, src.len()).index-of-string(name) is :some rel else {
      crash("table $name not found")
    }
    let at = from + rel
    from = at + name.len()
    let i = from
    if src.get(i) == '[' {
      require src.drop(i).position(']') is :some rel else crash("unterminated [ for $name")
      let close = i + rel
      let decl = trim(src.slice(i + 1, close))
      let j = close + 1
      while is-space(src.get(j)) { j = j + 1 }
      if src.get(j) == '=' {
        j = j + 1
        while is-space(src.get(j)) { j = j + 1 }
        if src.get(j) == '{' {
          require src.slice(j, src.len()).index-of-string("};") is :some end-rel else {
            crash("unterminated initializer for $name")
          }
          let body = src.slice(j + 1, j + end-rel)
          let tokens: list[string] = list/empty()
          for part in body.split-by-char(',') {
            let t = trim(part)
            if t.len() > 0 tokens.push(t)
          }
          return .{ tokens, declared = declared-count(decl, tokens.len()) }
        }
      }
    }
  }
}

fn emit-int-table(
  w: *mut string-builder, src: string, c-name: string,
  k1-name: string, elem-type: string, limit: size, per-line: size,
) {
  let parsed = parse-c-array(src, c-name)
  let values: list[u64] = list/empty()
  for t in parsed.tokens { values.push(parse-u64-c(t)) }
  while values.len() < parsed.declared { values.push(0) }
  let count = if limit != 0 and limit < values.len() limit else values.len()

  w.writeln("let $k1-name: array[$elem-type, $count] = [")
  let i: size = 0
  while i < count {
    w.write("  ")
    let row-end = min-size(i + per-line, count)
    while i < row-end {
      w.write("${values.get(i)},")
      if i + 1 < row-end w.write(" ")
      i = i + 1
    }
    w.writeln("")
  }
  w.writeln("]")
  w.writeln("")
}

// The C table is double but its literals carry an 'f' suffix, so every value
// is float-rounded; reproduce that exactly and print with full precision.
fn emit-float-table(
  w: *mut string-builder, src: string, c-name: string,
  k1-name: string, per-line: size,
) {
  let parsed = parse-c-array(src, c-name)
  let values: list[f64] = list/empty()
  for t in parsed.tokens {
    let lit = if t.ends-with("f") t.drop-right(1) else t
    values.push(f64/from-string(lit).!.as[f32].as[f64])
  }
  assert-equals(values.len(), parsed.declared)

  w.writeln("let $k1-name: array[f64, ${values.len()}] = [")
  let i: size = 0
  while i < values.len() {
    w.write("  ")
    let row-end = min-size(i + per-line, values.len())
    while i < row-end {
      values.get(i).format(w, 17)
      w.write(",")
      if i + 1 < row-end w.write(" ")
      i = i + 1
    }
    w.writeln("")
  }
  w.writeln("]")
  w.writeln("")
}

fn min-size(a: size, b: size): size { if a < b a else b }

fn setup(_ctx: k1/setup-ctx) {
  let ees = files/read-to-string("$VENDOR/entropy_encode_static.h")
  let enc = files/read-to-string("$VENDOR/encode.c")
  let cf = files/read-to-string("$VENDOR/compress_fragment.c")
  let cf2 = files/read-to-string("$VENDOR/compress_fragment_two_pass.c")
  let fl = files/read-to-string("$VENDOR/fast_log.c")

  let w = string-builder/new()
  w.writeln("// Static tables for the q0/q1 encoders, extracted by setup.k1 from this")
  w.writeln("// module's vendored google/brotli enc/ sources (vendor/). The reps tables")
  w.writeln("// are truncated to 257 entries: the fast literal-tree store only sees runs")
  w.writeln("// within a 256-symbol alphabet.")
  w.writeln("")
  emit-int-table(w.&, ees, "kCodeLengthDepth", "k-code-length-depth", "u8", 0, 18)
  emit-int-table(w.&, ees, "kCodeLengthBits", "k-code-length-bits", "u32", 0, 18)
  emit-int-table(w.&, ees, "kZeroRepsDepth", "k-zero-reps-depth", "u32", 257, 16)
  emit-int-table(w.&, ees, "kZeroRepsBits", "k-zero-reps-bits", "u64", 257, 8)
  emit-int-table(w.&, ees, "kNonZeroRepsDepth", "k-non-zero-reps-depth", "u32", 257, 16)
  emit-int-table(w.&, ees, "kNonZeroRepsBits", "k-non-zero-reps-bits", "u64", 257, 8)
  emit-int-table(w.&, enc, "kDefaultCommandDepths", "k-default-command-depths", "u8", 0, 16)
  emit-int-table(w.&, enc, "kDefaultCommandBits", "k-default-command-bits", "u16", 0, 16)
  emit-int-table(w.&, enc, "kDefaultCommandCode", "k-default-command-code", "u8", 0, 12)
  emit-int-table(w.&, cf, "kCmdHistoSeed", "k-cmd-histo-seed", "u32", 0, 24)
  emit-int-table(w.&, cf2, "kNumExtraBits", "k-num-extra-bits", "u32", 0, 16)
  emit-int-table(w.&, cf2, "kInsertOffset", "k-insert-offset", "u32", 0, 12)
  emit-float-table(w.&, fl, "kBrotliLog2Table", "k-log2-table", 6)

  files/write-entire-file("tables.k1", w.build())
}
