// Topic-based publish/subscribe: an mpsc ingress, a topic router, and a
// channel per subscriber.
//
//   pubsub/create(uv-loop)          the bus; owned by whoever runs the loop
//   bus.publisher()                 thread-safe handle carrying publish + subscribe
//   publisher.publish(topic, data)  from any thread; one copy, into an rc-bytes
//   publisher.subscribe(topic)      a dyn-source[u8] of raw payloads, one event per pull

use std/mpsc
use std/notify
use std/channel
use std/rc
use std/rc-bytes
use std/rc-byte-stream
use std/dyn-source
use std/source
use std/source-async
use std/pull
use std/waker

ns pubsub {

  // Declared before bus: instantiating the (recursive-generic-backed) mpsc
  // with a forward-declared type overflows the typer (repro in sandbox/main.k1)
  type event = {
    // topic is a system-heap copy freed after dispatch; data is an rc-bytes
    // reference retained per matching subscriber during dispatch
    topic: string,
    data: rc-bytes,
  }

  type bus = {
    async-handle: *mut uv/async,
    ingress: *mut mpsc[event],
    // main thread: reused drain buffer
    scratch: list[event],
    // main thread only
    subscribers: list[*mut subscription],
  }

  fn create(uv-loop: *mut uv-loop): *mut bus {
    let async-handle = system-heap.alloc-t[uv/async]
    let bus: *mut bus = system-heap.new(.{
      async-handle,
      ingress = mpsc/make[event](.{ state = async-handle.as[ptr], notify-fn = send-async }),
      scratch = list/empty[event](),
      subscribers = list/empty[*mut subscription](),
    })
    if uv/async_init(uv-loop, async-handle, dispatch-pending) != 0 crash("uv_async_init for pubsub failed")
    bus.async-handle.set-data(bus)
    bus
  }

  fn send-async(state: ptr) {
    let rc = uv/async_send(state.rw[uv/async]())
    if rc < 0 crash("uv_async_send for pubsub failed: $rc")
  }

  ns for bus {
    fn publisher(self: *mut bus): publisher { .{ bus = self } }
  }

  type publisher = { bus: *mut bus }

  ns for publisher {
    // Thread-safe: the topic is copied and the data lands in a fresh
    // rc-bytes, so the caller's memory can be reclaimed immediately.
    fn publish(self: publisher, topic: string, data: string) {
      self.bus.ingress.send(.{
        topic = topic.cloned-in(context :system-heap)(),
        data = rc/of-bytes(data.span-bytes()),
      })
    }

    // May run on a worker thread: only allocates; the bus learns about the
    // subscription when the harness start()s the stream on the main thread.
    fn subscribe(self: publisher, topic: string): dyn-source[u8] {
      let chan = channel/make[rc-bytes](
        cap-weight = max-queued-bytes,
        weight-fn = fn(payload: rc-bytes) payload.bytes().len(),
        drop-fn = fn(payload: rc-bytes) payload.release(),
      )
      let sub: *mut subscription = system-heap.new(.{
        bus = self.bus.as[ptr],
        topic = topic.cloned-in(context :system-heap)(),
        chan,
      })
      dyn-source/erase-async(sub) || rc-byte-stream
    }
  }

  // -- Harness-driven stream side -------------------------------------------

  // Fail a subscriber once this much payload is queued and undelivered: a
  // client that isn't draining its socket would otherwise grow it forever.
  let max-queued-bytes: size = 1048576

  // The channel receiver wearing a topic: registers with the bus in start(),
  // detaches and frees everything it owns in stop().
  type subscription = {
    // *mut bus, erased: a typed back-pointer closes a struct cycle around the
    // mpsc's recursive generic, which overflows the typer (sandbox/main.k1)
    bus: ptr,
    topic: string,
    chan: *mut channel[rc-bytes],
  }

  impl source[t = rc-bytes] for subscription {
    fn next(self: *mut subscription): pull[rc-bytes] {
      source@(channel[rc-bytes])/next(self.chan)
    }
  }

  impl source-async for subscription {
    fn start(self: *mut subscription, waker: waker) {
      source-async@(channel[rc-bytes])/start(self.chan, waker)
      self.bus.rw[bus]().subscribers.push-in(context :system-heap)(self)
      tprintln("pubsub: subscribed to `${self.topic}`")
    }

    fn stop(self: *mut subscription) {
      let bus = self.bus.rw[bus]()
      let sub-ptr = self.as[ptr]
      let i: size = 0
      while i < bus.subscribers.len() {
        if bus.subscribers.get(i).as[ptr] == sub-ptr {
          bus.subscribers.remove(i)
        } else {
          i = i + 1
        }
      }
      tprintln("pubsub: unsubscribed from `${self.topic}`")
      self.chan.close-and-free()
      free-heap-string(self.topic)
      system-heap.free-t(self)
    }
  }

  // -- Bus internals --------------------------------------------------------

  // uv_async callback, main thread
  fn dispatch-pending(handle: *mut uv/async) {
    let bus = handle.get-data[bus]()
    bus.scratch.clear()
    bus.ingress.take(bus.scratch.&)
    for event in bus.scratch {
      for sub in bus.subscribers {
        if sub.topic == event.topic {
          let payload = event.data.retain()
          if not sub.chan.push(payload) {
            tprintln("pubsub: `${sub.topic}` subscriber is over its backlog cap; failing it")
            payload.release()
            sub.chan.fail("subscriber exceeded backlog cap")
          }
        }
      }
      free-heap-string(event.topic)
      event.data.release()
    }
    bus.scratch.clear()

    // Flush after dispatch, on a snapshot: a woken stream can fail
    // synchronously and detach its subscription from bus.subscribers, so
    // never wake while iterating that list. One flush per subscriber also
    // coalesces multi-event batches.
    mem/push-mode(:tmp)
    let to-flush = bus.subscribers.cloned()
    mem/pop-mode()
    for sub in to-flush { sub.chan.flush() }
  }

  fn free-heap-string(s: string) {
    system-heap.free(s.data-ptr(), s.len(), 1)
  }
}
