// The HTTP/1.1 response model and the event-loop driver that delivers one.
// A strict body is just a one-group stream with a known Content-Length; a
// streamed body goes out chunked-transfer-encoded.

use std/dyn-source
use std/source
use std/source-async
use std/pull
use std/waker

type http-response = {
  status: u16,
  content-type: string,
  extra-headers: span[string],
  body: either { complete(span[span[u8]]), stream(dyn-source[u8]) },
}

ns response {
  fn complete(status: u16, content-type: string, body: string): http-response {
    .{ status, content-type, extra-headers = [], body = :complete span/single(body.span-bytes()) }
  }
  fn html(body: string): http-response { complete(200, "text/html", body) }
  fn text(body: string): http-response { complete(200, "text/plain", body) }
  fn not-found(): http-response { complete(404, "text/plain", "Not Found\n") }
  fn status(status: u16, msg: string): http-response { complete(status, "text/plain", msg) }
  fn method-not-allowed(allowed: span[string]): http-response {
    let allow = string-builder/new()
    allow.write("Allow: ")
    for m in allowed { if it-index > 0 { allow.write(", ") }; allow.write(m) }
    .{
      status = 405,
      content-type = "text/plain",
      extra-headers = span/single(allow.build()),
      body = :complete span/single("Method Not Allowed\n".span-bytes()),
    }
  }
  fn stream(content-type: string, source: dyn-source[u8]): http-response {
    .{ status = 200, content-type, extra-headers = [], body = :stream source }
  }

  fn status-text(status: u16): string {
    if status == 200 "OK"
    else if status == 400 "Bad Request"
    else if status == 404 "Not Found"
    else if status == 405 "Method Not Allowed"
    else if status == 500 "Internal Server Error"
    else "Status"
  }
}

// A strict body as a source: its segments as one group, once
type group-source = { group: span[span[u8]], done: bool }

impl source[t = u8] for group-source {
  fn next(self: *mut group-source): pull[u8] {
    if self.done { return :done }
    self.done = true
    :chunk self.group
  }
}

// Chunked transfer framing as a pipe: wraps each upstream group in a
// hex-size prefix and CRLF trailer without touching the payload segments,
// then emits the terminal "0\r\n\r\n". The prefix and segment list are
// reusable buffers overwritten on each next(), so long-lived streams don't
// grow the request arena.
type chunked-encoder = {
  upstream: dyn-source[u8],
  prefix: list[u8],
  parts: list[span[u8]],
  finished: bool,
}

fn chunked(upstream: dyn-source[u8]): dyn-source[u8] {
  let state: *mut chunked-encoder = mem/new(.{
    upstream,
    prefix = list/empty[u8](),
    parts = list/empty[span[u8]](),
    finished = false,
  })
  dyn-source/erase-async(state)
}

impl source[t = u8] for chunked-encoder {
  fn next(self: *mut chunked-encoder): pull[u8] {
    if self.finished { return :done }
    self.upstream.next() is {
      :chunk group -> {
        let total: size = 0
        for seg in group { total = total + seg.len() }
        self.prefix.clear()
        push-hex(self.prefix.&, total)
        self.prefix.append-span("\r\n".span-bytes())
        self.parts.clear()
        self.parts.push(self.prefix.as-span())
        for seg in group { self.parts.push(seg) }
        self.parts.push("\r\n".span-bytes())
        :chunk self.parts.as-span()
      },
      :pending -> :pending,
      :done -> {
        self.finished = true
        self.parts.clear()
        self.parts.push("0\r\n\r\n".span-bytes())
        :chunk self.parts.as-span()
      },
      :fail message -> :fail message,
    }
  }
}

impl source-async for chunked-encoder {
  fn start(self: *mut chunked-encoder, waker: waker) { self.upstream.start(waker) }
  fn stop(self: *mut chunked-encoder) { self.upstream.stop() }
}

let hex-digits: string = "0123456789abcdef"
fn push-hex(out: *mut list[u8], value: size) {
  if value >= 16 { push-hex(out, value / 16) }
  out.push(hex-digits.span-bytes().get(value % 16))
}

// The event-loop sink: drives a response's body into the connection's socket
// — status line and headers first, then the body, one vectored write per
// pull. A :pending pull parks the driver until the source wakes it. One
// write is in flight at a time, so the driver reuses a single uv/write
// request and buf list for the response's lifetime.
ns response-writer {

  type driver = {
    connection: *mut connection,
    stream: dyn-source[u8],
    write-req: *mut uv/write,
    bufs: list[uv/buf],
    parked: bool,
  }

  fn begin(connection: *mut connection, resp: http-response) {
    mem/push-mode(:custom-arena connection.request-arena)
    defer mem/pop-mode()
    let out = string-builder/new()
    out.write("HTTP/1.1 ${resp.status} ${response/status-text(resp.status)}\r\nContent-Type: ${resp.content-type}\r\n")
    for h in resp.extra-headers { out.write("$h\r\n") }
    let body = resp.body is {
      :complete segments -> {
        let total: size = 0
        for seg in segments { total = total + seg.len() }
        out.write("Content-Length: $total\r\n\r\n")
        let group: *mut group-source = mem/new(.{ group = segments, done = false })
        dyn-source/erase(group)
      },
      :stream source -> {
        out.write("Transfer-Encoding: chunked\r\n\r\n")
        source || chunked
      },
    }
    let headers = out.build()

    let driver: *mut driver = connection.request-arena.push(.{
      connection,
      stream = body,
      write-req = connection.request-arena.alloc[uv/write](),
      bufs = list/empty[uv/buf](),
      parked = false,
    })
    driver.write-req.set-data(driver)
    connection.active-stream = :some body
    body.start(.{ state = driver.as[ptr], wake-fn = on-wake })

    // The first write carries the headers, coalescing the first body group
    // when it's already available — a strict response is one vectored write
    let first = list/empty[span[u8]]()
    first.push(headers.span-bytes())
    body.next() is {
      :chunk group -> for seg in group { first.push(seg) },
      // the headers write is about to be in flight; its completion pumps
      :pending -> .{},
      :done -> .{},
      :fail message -> {
        tprintln("stream failed before headers: $message")
        close-connection(connection)
        return
      },
    }
    write-group(driver, first.as-span())
    .{}
  }

  fn write-group(driver: *mut driver, group: span[span[u8]]) {
    let connection = driver.connection
    driver.bufs.clear()
    for seg in group { driver.bufs.push(uv/buf/wrap-span(seg)) }
    let rc = uv/write(
      driver.write-req,
      connection.client().as-stream(),
      driver.bufs.as-buffer().data-ptr().as(),
      driver.bufs.len().as[u32],
      on-write-complete)
    if rc != 0 {
      tprintln("response uv_write failed: $rc")
      close-connection(connection)
    }
  }

  fn on-write-complete(req: *mut uv/write, status: i32) {
    let driver: *mut driver = req.get-data()
    let connection = driver.connection
    // Main thread; direct close-state access is fine
    if connection.close-state.is-closing { return }
    if connection.close-state.should-close { close-connection(connection); return }
    if status != 0 {
      let errno = uv/errno/from-i32(status)
      tprintln("response write failed: ${errno.enum-name()}")
      close-connection(connection)
      return
    }
    pump(driver)
  }

  // The waker target: a parked source has data again (loop thread only)
  fn on-wake(state: ptr) {
    let driver: *mut driver = state.rw[driver]()
    if driver.connection.close-state.is-closing { return }
    // A write is in flight; its completion will pump
    if not driver.parked { return }
    driver.parked = false
    pump(driver)
  }

  fn pump(driver: *mut driver) {
    let connection = driver.connection
    mem/push-mode(:custom-arena connection.request-arena)
    defer mem/pop-mode()
    driver.stream.next() is {
      :chunk group -> write-group(driver, group),
      :pending -> { driver.parked = true },
      :done -> {
        if connection.active-stream is :some s {
          connection.active-stream = :none
          s.stop()
        }
        connection.finish-request()
      },
      :fail message -> {
        tprintln("stream failed: $message")
        close-connection(connection)
      },
    }
    .{}
  }
}
