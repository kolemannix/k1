use http/server
use uv/libuv
use std/rc-bytes
use std/sys

type args = { port: ?string, db: ?string }

fn main(argc: i32, argv: ptr): i32 {
  let args = if sys/parse-args-c[args](argc, argv) is {
    :ok a -> a,
    :err msg -> { eprintln(msg); eprintln(sys/gen-help-text[args]("k1 datastar demo server")); return 1 },
  }
  let port: u16 = if args.port is :some p u64/from-string(p).!.trunc[u16] else 3000
  app/db-path = args.db ? "httpapp.sqlite"

  let config: server/config = .{
    host = "0.0.0.0",
    port,
    accept-queue-len = 128,
    max-connections = 1024,
    max-body-size = 16 * 1024 * 1024,
    header-timeout-ms = 10000,
    body-timeout-ms = 30000,
    write-timeout-ms = 30000,
    idle-timeout-ms = 60000,
    drain-timeout-ms = 5000,
    handle-signals = true,
  }
  let bus = uv/bus/create[span[u8]](
    libuv/default_loop().get(),
    subscriber-cap-weight = 1048576,
    weight-fn = fn(payload: rc-bytes) payload.bytes().len(),
  )
  let server = server/start(config, (fn[bus](req: http/request) app/handle(req, bus)).to-dyn()).!
  app/spawn-tick-publisher-thread(bus)
  eprintln("listening on ${server.port}...")
  server.run()
  0
}
