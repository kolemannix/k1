  try-add(:again)
  try-add(:again)
  g.active = 2
  try-add(:name(0))
}

fn solve-by-name(context g: *mut game)(name: string): bool {
  if name == "pack" { solve-pack() }
  else if name == "prune" { solve-prune() }
  else if name == "wrapper" { solve-wrapper() }
  else if name == "onion" { solve-onion() }
  else if name == "canon" { solve-canon() }
  else if name == "reflection" { solve-reflection() }
  else if name == "rainbow" { solve-rainbow() }
  else if name == "nesting" { solve-nesting() }
  else if name == "steps" { solve-steps() }
  else if name == "staircase" { solve-staircase() }
  else if name == "stripes" { solve-stripes() }
  else if name == "sunset" { solve-sunset() }
  else if name == "topiary" { solve-topiary() }
  else if name == "fork" { solve-fork() }
  else if name == "thicket" { solve-thicket() }
  else if name == "reed" { solve-reed() }
  else if name == "coastline" { solve-coastline() }
  else if name == "arch" { solve-arch() }
  else if name == "island" { solve-island() }
  else if name == "tendril" { solve-tendril() }
  else if name == "maze" { solve-maze() }
  else if name == "blossom" { solve-blossom() }
  else if name == "bonsai" { solve-bonsai() }
  else if name == "dragon" { solve-dragon() }
  else if name == "bracken" { solve-bracken() }
  else if name == "fern" { solve-fern() }
  else { return false }
  true
}

fn main(): i32 {
  let perm = core/arena/init-default()
  let st: game = .{
    perm,
    level = 0,
    active = 2,
    view = VIEW-OVERLAY,
    preview-growth = 4,
    grow-t = 0.0,
    play = PLAY-IDLE,
    play-src = SRC-NONE,
    sel-a = SEL-NONE,
    sel-b = SEL-NONE,
    sel-anchor = 0,
    sel-live = false,
    anim-t = 1.0,
    anim-row = 2,
    anim-len = 0,
    anim-repl = :none,
    anim-before = fixlist/uninit(),
    anim-hits = fixlist/uninit(),
    def-a = list/with-capacity-in(perm, MAX-ROW-TOKENS),
    def-b = list/with-capacity-in(perm, MAX-ROW-TOKENS),
    out = list/with-capacity-in(perm, MAX-ROW-TOKENS),
  }
  let(context) g = st.&
  view/watch().!
  self-test()

  if sys/env("GENGAME_LEVEL") is :some(ls) and u64/from-string(ls) is :ok(n) and n.signed() < LEVELS.len() {
    load-level(n.signed())
  }
  if sys/env("GENGAME_DUMP").is-some() {
    for li in 0.until(LEVELS.len()) {
      let lv = LEVELS.[li]
      let e = expand-target(lv, lv.growth.widen[size])
      let sum: size = 0
      let head = ""
      for s in e.syms.& {
        sum = sum + (s.widen[size] + 1) * (it-index + 1)
        if it-index < 40 { head = "$head${s.widen[size]}" }
      }
      println("${lv.name} len=${e.syms.len()} sum=$sum $head")
    }
    return 0
  }
  if sys/env("GENGAME_SOLVE") is :some(nm) and solve-by-name(nm) {
    g.preview-growth = cur-level().growth
    g.active = 2
  }
  if sys/env("GENGAME_VIEW") is :some(vs) and u64/from-string(vs) is :ok(v) and v <= 2 { g.view = v.trunc[u8] }
  let shot = sys/env("GENGAME_SHOT")

  rl/init(W, H, "gengame".to-c-tmp().ptr)
  rl/set-target-fps(60)

  let frame = core/arena/init-default()
  mem/push-arena(frame)
  let tap-env = sys/env("GENGAME_TAP")
  let frames: u64 = 0
  let shot-frame: u64 = if sys/env("GENGAME_FRAME") is :some(fs) and u64/from-string(fs) is :ok(n) { n } else { 30 }
  while not rl/window-should-close() {
    handle-input()
    tick()
    if frames >= 10 and tap-env is :some(taps) {
      let ti = (frames - 10).signed()
      let rest = taps
      let skipped: size = 0
      while skipped < ti and rest.position(';') is :some semi {
        rest = rest.drop(semi + 1)
        skipped = skipped + 1
      }
      if skipped == ti and rest.len() > 0 {
        let one = if rest.position(';') is :some semi rest.take(semi) else rest
        require one.position(',') is :some comma else crash("tap needs x,y")
        let tx = u64/from-string(one.take(comma)).!
        let ty = u64/from-string(one.drop(comma + 1)).!
        tap(tx.trunc[i32], ty.trunc[i32])
      }
    }
    rl/begin-drawing()
    view/draw-frame()
    rl/end-drawing()
    frames = frames + 1
    if frames == shot-frame and shot is :some(name) {
      rl/take-screenshot(name.to-c().ptr)
      break
    }
    frame.reset(false)
  }
  rl/close-window()
  0
}
