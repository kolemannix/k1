// idea: sound — tiles as notes, reps = rhythm, shift = transposition (drift is a canon,
// interference a phase pattern); space plays target melody then yours, hear the diff
// before you see it; synth PCM into a raylib audio stream, render-layer only

// Adding parameter-taking 'functions' to the seq world could be a great mechanic
// - will teach parameterization and abstraction in a neat way

fn module(): k1/module {
  let m = k1/module/new()
  m.lib("raylib", :static)
  for ["Cocoa", "OpenGL", "IOKit", "CoreAudio", "CoreVideo", "AudioToolbox"] {
    m.link-args(["-framework", it])
  }
  m
}

ns(lib("raylib")) rl {
  type color = { r: u8, g: u8, b: u8, a: u8 }
  type vec2 = { x: f32, y: f32 }

  fn(extern("InitWindow")) init(width: i32, height: i32, name: ptr)
  fn(extern("CloseWindow")) close-window()
  fn(extern("WindowShouldClose")) window-should-close(): bool

  fn(extern("BeginDrawing")) begin-drawing()
  fn(extern("EndDrawing")) end-drawing()
  fn(extern("ClearBackground")) clear-background(color: color)

  fn(extern("DrawText")) draw-text(text: ptr, pos-x: i32, pos-y: i32, font-size: i32, color: color)
  fn(extern("MeasureText")) measure-text(text: ptr, font-size: i32): i32
  fn(extern("DrawCircle")) draw-circle(center-x: i32, center-y: i32, radius: f32, color: color)
  fn(extern("DrawCircleLines")) draw-circle-lines(center-x: i32, center-y: i32, radius: f32, color: color)
  fn(extern("DrawRectangle")) draw-rectangle(x: i32, y: i32, w: i32, h: i32, color: color)
  fn(extern("DrawRectangleLines")) draw-rectangle-lines(x: i32, y: i32, w: i32, h: i32, color: color)
  fn(extern("DrawPoly")) draw-poly(center: vec2, sides: i32, radius: f32, rotation: f32, color: color)
  fn(extern("DrawLineEx")) draw-line-ex(start: vec2, end: vec2, thick: f32, color: color)

  fn(extern("TakeScreenshot")) take-screenshot(name: ptr)
  fn(extern("SetTargetFPS")) set-target-fps(fps: i32)
  fn(extern("IsKeyPressed")) is-key-pressed(key: i32): bool
  fn(extern("IsMouseButtonPressed")) is-mouse-button-pressed(button: i32): bool
  fn(extern("GetMouseX")) get-mouse-x(): i32
  fn(extern("GetMouseY")) get-mouse-y(): i32
}

ns libm {
  fn(extern("sinf")) sin(x: f32): f32
  fn(extern("cosf")) cos(x: f32): f32
}

use core/fixlist

let KEY-N: i32 = 78
let KEY-P: i32 = 80
let KEY-R: i32 = 82
let KEY-TAB: i32 = 258
let KEY-BACKSPACE: i32 = 259
let KEY-UP: i32 = 265
let KEY-DOWN: i32 = 264
let MOUSE-LEFT: i32 = 0

let W: i32 = 1100
let H: i32 = 900

let MAX-ROW-TOKENS: size = 26
let MAX-EXPAND: size = 8192
let MAX-DEPTH: size = 40
let MAX-STACK: size = 64
let MAX-BUDS: size = 256

let ROW-Y0: i32 = 630
let ROW-STEP: i32 = 54
let ROW-H: i32 = 48
let PALETTE-Y: i32 = 800
let CHIP-W: i32 = 42
let CHIP-H: i32 = 52

let PLANT-X: i32 = 280
let PLANT-Y: i32 = 64
let PLANT-W: i32 = 540
let PLANT-H: i32 = 540

fn hsva(h: f32, s: f32, v: f32, a: u8): rl/color {
  let hh = h / 60.0
  let sector = hh.as[i32] % 6
  let f = hh - hh.as[i32].as[f32]
  let p = v * (1.0 - s)
  let q = v * (1.0 - s * f)
  let t = v * (1.0 - s * (1.0 - f))
  let r: f32 = 0.0
  let gg: f32 = 0.0
  let b: f32 = 0.0
  if sector == 0 { r = v; gg = t; b = p }
  else if sector == 1 { r = q; gg = v; b = p }
  else if sector == 2 { r = p; gg = v; b = t }
  else if sector == 3 { r = p; gg = q; b = v }
  else if sector == 4 { r = t; gg = p; b = v }
  else { r = v; gg = p; b = q }
  .{
    r = (r * 255.0 + 0.5).as[i32].as[u8],
    g = (gg * 255.0 + 0.5).as[i32].as[u8],
    b = (b * 255.0 + 0.5).as[i32].as[u8],
    a,
  }
}

