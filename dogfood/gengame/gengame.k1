fn hsva(h: f32, s: f32, v: f32, a: u8): rl/color {
  let hh = h / 60.0
  let sector = hh.as[i32] % 6
  let f = hh - hh.as[i32].as[f32]
  let p = v * (1.0 - s)
  let q = v * (1.0 - s * f)
  let t = v * (1.0 - s * (1.0 - f))
  let r: f32 = 0.0
  let gg: f32 = 0.0
  let b: f32 = 0.0
  if sector == 0 { r = v; gg = t; b = p }
  else if sector == 1 { r = q; gg = v; b = p }
  else if sector == 2 { r = p; gg = v; b = t }
  else if sector == 3 { r = p; gg = q; b = v }
  else if sector == 4 { r = t; gg = p; b = v }
  else { r = v; gg = p; b = q }
  .{
    r = (r * 255.0 + 0.5).as[i32].trunc[u8],
    g = (gg * 255.0 + 0.5).as[i32].trunc[u8],
    b = (b * 255.0 + 0.5).as[i32].trunc[u8],
    a,
  }
}

