use core/arena
use core/platform/io

let DEFAULT_HASH_MB: size = 16
let MAX_HASH_MB: size = 1024

type engine = {
  input: input,
  session: *arena,
  game: *arena,
  command: *arena,
  ply: *arena,
  tt: transposition-table,
  root: position,
  keys: list[u64],
}

ns for engine {
  fn new(): engine {
    let session = arena/init(arena/mb)
    let game = arena/init(arena/mb)
    let root = position/from-fen(START_FEN).!
    let keys: list[u64] = list/with-capacity-in(game, 1)
    keys.push-in(game, root.key)
    .{
      input = input/new(session, io/STDIN, 64 * arena/kb),
      session,
      game,
      command = arena/init(arena/mb),
      ply = arena/init-fixed(arena/mb),
      tt = transposition-table/new(DEFAULT_HASH_MB),
      root,
      keys,
    }
  }

  fn handle(self: *engine, line: string): bool {
    let tokens = words(line).as-span()
    if tokens.len() == 0 return true
    let args = tokens.drop(1)
    if tokens.[0] is {
      "uci" -> {
        println("id name refchess")
        println("id author Koleman Nix")
        println("option name Hash type spin default $DEFAULT_HASH_MB min 1 max $MAX_HASH_MB")
        println("uciok")
      },
      "isready" -> println("readyok"),
      "ucinewgame" -> self.tt.&.clear(),
      "position" -> self.set-position(args),
      "go" -> self.go(args),
      "setoption" -> self.set-option(args),
      "d" -> {
        println(self.root.&.diagram())
        println(self.memory-report())
      },
      "quit" -> return false,
      "stop" or "ponderhit" or "debug" or "register" -> {},
      _ -> println("info string unknown command: ${tokens.[0]}")
    }
    true
  }

  fn memory-report(self: *engine): string {
    let sb = string-builder/new()
    sb.write("arenas:")
    for a in [.{ name = "session", a = self.session }, .{ name = "game", a = self.game }, .{ name = "command", a = self.command }, .{ name = "ply", a = self.ply }, .{ name = "tt", a = self.tt.store }] {
      sb.write(" ${a.name} ${a.a.used-bytes()}b")
    }
    sb.build()
  }

  fn set-position(self: *engine, args: span[string]): {} {
    let moves-at = args.position("moves") ? args.len()
    let setup = args.take(moves-at)
    let fen = if setup.len() > 0 and setup.[0] == "startpos" START_FEN
      else if setup.len() > 1 and setup.[0] == "fen" string/join(setup.drop(1), " ")
      else return println("info string position needs startpos or fen")
    let root = if position/from-fen(fen) is {
      :ok p -> p,
      :err msg -> return println("info string $msg")
    }
    self.game.reset()
    self.root = root
    self.keys = list/with-capacity-in(self.game, 256)
    self.keys.push-in(self.game, root.key)
    let(context) ply: *arena = self.ply
    for text in args.drop(moves-at + 1) {
      let mark = ply.mark()
      let found = gen-moves(self.root.&, :all).find(fn[text] m. m.to-uci() == text)
      ply.pop-to-mark(mark)
      require found is :some m else return println("info string illegal move: $text")
      self.root.&.make(m)
      self.keys.push-in(self.game, self.root.key)
    }
  }

  fn set-option(self: *engine, args: span[string]) {
    let name-at = args.position("name") ? args.len()
    let value-at = args.position("value") ? args.len()
    let name = string/join(args.slice(name-at + 1, value-at), " ")
    let value = string/join(args.drop(value-at + 1), " ")
    if name.to-ascii-upper() == "HASH" {
      require u64/from-string(value) is :ok mb else return println("info string bad Hash value: $value")
      self.tt.&.release()
      self.tt = transposition-table/new(mb.signed().max(1).min(MAX_HASH_MB))
    } else {
      println("info string unknown option: $name")
    }
  }

  fn go(self: *engine, args: span[string]) {
    let lim = limits/NONE
    let clock: array[u64, 2] = .0
    let increment: array[u64, 2] = .0
    let moves-to-go: u64 = 0
    let timed = false
    for key in args {
      let value: u64 = if args.index-opt(it-index + 1) is :some v and i64/from-string(v) is :ok n n.max(0).unsigned() else 0
      if key is {
        "perft" -> {
          let(context) ply: *arena = self.ply
          let t = std/time/read-cpu-counter()
          let nodes = divide(self.root.&, value.trunc[u32])
          println("info string perft ${value} nodes $nodes time ${std/time/elapsed-ms(t)}ms")
          return
        },
        "depth" -> { lim.depth = value.trunc[u32].max(1).min(MAX_PLY - 1) },
        "nodes" -> { lim.nodes = value },
        "movetime" -> { lim.soft-ms = value; lim.hard-ms = value },
        "wtime" -> { clock.[0] = value; timed = true },
        "btime" -> { clock.[1] = value; timed = true },
        "winc" -> { increment.[0] = value },
        "binc" -> { increment.[1] = value },
        "movestogo" -> { moves-to-go = value },
        "infinite" -> { lim.infinite = true },
        _ -> {}
      }
    }
    if timed and lim.hard-ms == 0 {
      let us = self.root.side.value
      let left = clock.[us]
      let inc = increment.[us]
      let horizon: u64 = if moves-to-go == 0 30 else moves-to-go
      let hard = (left - left.min(50)) / 2
      lim.soft-ms = (left / horizon + inc * 3 / 4).min(hard).max(1)
      lim.hard-ms = hard.max(1)
    }

    let s = searcher/new(self.ply, self.game, self.tt.&, self.keys.&, :some self.input.&, lim)
    let best = s.&.run(self.root.&)
    println("bestmove ${if best.bits == move/NONE.bits "0000" else best.to-uci()}")
  }
}

fn uci-loop(): i32 {
  let engine = engine/new()
  loop {
    require engine.input.next-line() is :some line else break
    let keep-going = mem/with-arena(engine.command, engine.&.handle(line))
    engine.command.reset()
    core/io/flush-stdout()
    if not keep-going break
  }
  0
}
