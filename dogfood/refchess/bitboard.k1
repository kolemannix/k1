fn build-slider-table(steps: array[step, 4], factors: array[u64, 64]): slider-table {
  let magics: array[magic, 64] = .0
  let table-len: u32 = 0
  for sq in 0u32.until(64) {
    let mask = relevant-mask(sq, steps)
    let bits = mask.count-ones().trunc[u32]
    magics.[sq] = .{ mask, factor = factors.[sq], shift = 64 - bits, offset = table-len }
    table-len = table-len + (1u32 << bits)
  }
  let attacks = buffer/allocate[bitboard](table-len.widen[size])
  for sq in 0u32.until(64) {
    let m = magics.[sq]
    let subset: bitboard = 0
    loop {
      let slot = m.offset + (subset * m.factor >> m.shift).trunc[u32]
      let reach = slide(sq, subset, steps)
      if attacks.[slot] != 0 and attacks.[slot] != reach crash("magic for ${square-name(sq)} collides")
      attacks.[slot] = reach
      subset = (subset - m.mask) & m.mask
      if subset == 0 break
    }
  }
  .{ magics, attacks }
}

let ROOK_TABLE: slider-table = build-slider-table(ROOK_STEPS, ROOK_MAGICS)
let BISHOP_TABLE: slider-table = build-slider-table(BISHOP_STEPS, BISHOP_MAGICS)

fn(inline) rook-attacks(sq: square, occ: bitboard): bitboard { ROOK_TABLE.&.attacks-from(sq, occ) }
fn(inline) bishop-attacks(sq: square, occ: bitboard): bitboard { BISHOP_TABLE.&.attacks-from(sq, occ) }

fn square-pair-table(include-ends: bool): array[array[bitboard, 64], 64] {
  let out: array[array[bitboard, 64], 64] = .0
  for a in 0u32.until(64) {
    for b in 0u32.until(64) {
      if a == b continue
      for steps in [ROOK_STEPS, BISHOP_STEPS] {
        if slide(a, 0, steps) & bit(b) == 0 continue
        out.[a].[b] = if include-ends {
          (slide(a, 0, steps) & slide(b, 0, steps)) | bit(a) | bit(b)
        } else {
          slide(a, bit(b), steps) & slide(b, bit(a), steps)
        }
      }
    }
  }
  out
}

let BETWEEN: array[array[bitboard, 64], 64] = square-pair-table(false)
let LINE: array[array[bitboard, 64], 64] = square-pair-table(true)
