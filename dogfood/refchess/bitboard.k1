type(alias) bitboard = u64
type(alias) square = u32

let NO_SQUARE: square = 64

let RANK_1: bitboard = 0x00000000000000FF
let RANK_2: bitboard = 0x000000000000FF00
let RANK_7: bitboard = 0x00FF000000000000
let RANK_8: bitboard = 0xFF00000000000000

fn(inline) bit(sq: square): bitboard { 1u64 << sq }
fn(inline) lsb(b: bitboard): square { b.trailing-zeros().trunc[u32] }
fn(inline) more-than-one(b: bitboard): bool { b & (b - 1) != 0 }
fn(inline) file-of(sq: square): u32 { sq & 7 }
fn(inline) rank-of(sq: square): u32 { sq >> 3 }

type square-iter = { rest: bitboard }

fn(inline) squares(b: bitboard): square-iter { .{ rest = b } }

impl iterator[item = square] for square-iter {
  fn(inline) next(self: *square-iter): ?square {
    if self.rest == 0 return :none
    let sq = lsb(self.rest)
    self.rest = self.rest & (self.rest - 1)
    :some sq
  }
}

impl iterable[item = square, i = square-iter] for square-iter {
  fn(inline) iterator(self): square-iter { self }
}

fn square-name(sq: square): string {
  let file = ('a'.as-u8() + file-of(sq).trunc[u8]).as-char()
  let rank = ('1'.as-u8() + rank-of(sq).trunc[u8]).as-char()
  "$file$rank"
}

fn parse-square(s: string): ?square {
  if s.len() != 2 return :none
  let file = s.[0].as-u8()
  let rank = s.[1].as-u8()
  if file < 'a'.as-u8() or file > 'h'.as-u8() or rank < '1'.as-u8() or rank > '8'.as-u8() return :none
  :some ((rank - '1'.as-u8()).widen[u32] * 8 + (file - 'a'.as-u8()).widen[u32])
}

type step = { df: i32, dr: i32 }

fn(inline) shifted(sq: square, s: step): ?square {
  let f = file-of(sq).signed() + s.df
  let r = rank-of(sq).signed() + s.dr
  if f < 0 or f > 7 or r < 0 or r > 7 :none else :some((r * 8 + f).unsigned())
}

fn leaper-table(steps: span[step]): array[bitboard, 64] {
  let out: array[bitboard, 64] = .0
  for sq in 0u32.until(64) {
    for s in steps {
      if shifted(sq, s) is :some to { out.[sq] = out.[sq] | bit(to) }
    }
  }
  out
}

let KNIGHT_ATTACKS: array[bitboard, 64] = leaper-table([
  .{ df = 1, dr = 2 }, .{ df = 2, dr = 1 }, .{ df = 2, dr = -1 }, .{ df = 1, dr = -2 },
  .{ df = -1, dr = -2 }, .{ df = -2, dr = -1 }, .{ df = -2, dr = 1 }, .{ df = -1, dr = 2 },
])

let KING_ATTACKS: array[bitboard, 64] = leaper-table([
  .{ df = 1, dr = 0 }, .{ df = 1, dr = 1 }, .{ df = 0, dr = 1 }, .{ df = -1, dr = 1 },
  .{ df = -1, dr = 0 }, .{ df = -1, dr = -1 }, .{ df = 0, dr = -1 }, .{ df = 1, dr = -1 },
])

let PAWN_ATTACKS: array[array[bitboard, 64], 2] = [
  leaper-table([.{ df = -1, dr = 1 }, .{ df = 1, dr = 1 }]),
  leaper-table([.{ df = -1, dr = -1 }, .{ df = 1, dr = -1 }]),
]

let ROOK_STEPS: array[step, 4] = [.{ df = 1, dr = 0 }, .{ df = -1, dr = 0 }, .{ df = 0, dr = 1 }, .{ df = 0, dr = -1 }]
let BISHOP_STEPS: array[step, 4] = [.{ df = 1, dr = 1 }, .{ df = -1, dr = 1 }, .{ df = 1, dr = -1 }, .{ df = -1, dr = -1 }]

fn slide(sq: square, occ: bitboard, steps: array[step, 4]): bitboard {
  let out: bitboard = 0
  for s in steps {
    let at = sq
    while shifted(at, s) is :some to {
      out = out | bit(to)
      if occ & bit(to) != 0 break
      at = to
    }
  }
  out
}

fn relevant-mask(sq: square, steps: array[step, 4]): bitboard {
  let out: bitboard = 0
  for s in steps {
    let at = sq
    while shifted(at, s) is :some to and shifted(to, s).is-some() {
      out = out | bit(to)
      at = to
    }
  }
  out
}

type magic = { mask: bitboard, factor: u64, shift: u32, offset: u32 }

type slider-table = { magics: array[magic, 64], attacks: buffer[bitboard] }

ns for slider-table {
  fn(inline) attacks-from(self: *slider-table, sq: square, occ: bitboard): bitboard {
    let m = self.magics.[sq]
    self.attacks.[m.offset + ((occ & m.mask) * m.factor >> m.shift).trunc[u32]]
  }
}

