  .{ fen = "8/Pk6/8/8/8/8/6Kp/8 w - - 0 1", depth = 6, nodes = 1030499 },
]

type search-case = { fen: string, depth: u32, best: string }

let SEARCH_SUITE: array[search-case, 4] = [
  .{ fen = "6k1/5ppp/8/8/8/8/5PPP/3R2K1 w - - 0 1", depth = 4, best = "d1d8" },
  .{ fen = "r1bqkb1r/pppp1ppp/2n2n2/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 4 4", depth = 3, best = "h5f7" },
  .{ fen = "4k3/8/8/3q4/8/8/8/3RK3 w - - 0 1", depth = 5, best = "d1d5" },
  .{ fen = "7k/5Q2/6K1/8/8/8/8/8 b - - 0 1", depth = 4, best = "0000" },
]

fn test(): i32 {
  let(context) ply: *arena = arena/init(arena/mb)
  let failures: i32 = 0
  for c in PERFT_SUITE {
    let pos = position/from-fen(c.fen).!
    let t = std/time/read-cpu-counter()
    let nodes = perft(pos.&, c.depth)
    let ok = nodes == c.nodes
    if not ok { failures = failures + 1 }
    println("${if ok "ok  " else "FAIL"} perft ${c.depth} = $nodes (want ${c.nodes}) ${std/time/elapsed-ms(t)}ms  ${c.fen}")
    assert-equals(ply.used-bytes(), 0)
    check-fen-roundtrip(pos.&, 3)
  }

  let game = arena/init(64 * arena/kb)
  let tt = transposition-table/new(1)
  for c in SEARCH_SUITE {
    game.reset()
    tt.&.clear()
    let pos = position/from-fen(c.fen).!
    let keys: list[u64] = list/with-capacity-in(game, 8)
    keys.push-in(game, pos.key)
    let lim = limits/NONE
    lim.depth = c.depth
    let s = searcher/new(ply, game, tt.&, keys.&, :none, lim)
    let best = s.&.run(pos.&)
    let got = if best.bits == move/NONE.bits "0000" else best.to-uci()
    let ok = got == c.best
    if not ok { failures = failures + 1 }
    println("${if ok "ok  " else "FAIL"} search depth ${c.depth} = $got (want ${c.best})  ${c.fen}")
    assert-equals(ply.used-bytes(), 0)
    assert-equals(keys.len(), 1)
  }
  failures
}

fn check-fen-roundtrip(context ply: *arena)(pos: *position, depth: u32) {
  let fen = pos.to-fen()
  let parsed = position/from-fen(fen).!
  assert-equals(parsed.&.to-fen(), fen)
  assert-equals(parsed.key, pos.key)
  if depth == 0 return
  let mark = ply.mark()
  defer ply.pop-to-mark(mark)
  for m in gen-moves(pos, :all) {
    let child = pos.*
    child.make(m)
    check-fen-roundtrip(child.&, depth - 1)
  }
}
