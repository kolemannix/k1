// `code` is source text as a sequence of chunks; metaprograms return it so
// diagnostics in compiled output can point back at the original source.
// `source` is a compiler span id, widened to u64; 0 means no source.

type code-chunk = { text: string, source: u64 }

type code = { chunks: list[code-chunk] }

#static types/assert-layout[code-chunk](24, 8, [0, 16].as-span())
#static types/assert-layout[code](24, 8, [0].as-span())

ns for code {
  fn from-string(s: string): code {
    .{ chunks = [.{ text = s, source = 0 }] }
  }

  fn text(self: code): string {
    let sb = string-builder/new()
    for c in self.chunks { sb.write(c.text) }
    sb.build()
  }
}

// Bytes written via `writer` accumulate in `pending` until a chunk boundary
// seals them into a sourceless chunk.
type code-builder = { chunks: list[code-chunk], pending: list[u8], indent-level: size }

ns for code-builder {
  fn new(): code-builder {
    .{ chunks = list/with-capacity(8), pending = list/empty(), indent-level = 0 }
  }

  fn seal(self: *mut code-builder) {
    if self.pending.is-empty() return
    self.chunks.push(.{ text = string/wrap-bytes(self.pending.as-span()).cloned(), source = 0 })
    self.pending.clear()
  }

  fn code(self: *mut code-builder, c: code) {
    self.seal()
    self.chunks.append-list(c.chunks)
  }

  fn build(self: *mut code-builder): code {
    self.seal()
    .{ chunks = self.chunks }
  }

  fn indent(self: *mut code-builder) { self.indent-level = self.indent-level + 1 }
  fn dedent(self: *mut code-builder) {
    if self.indent-level == 0 crash("code-builder/dedent below zero")
    self.indent-level = self.indent-level - 1
  }
  fn pad(self: *mut code-builder) { self.repeat("  ", self.indent-level) }

  fn line(self: *mut code-builder, c: code) {
    self.pad()
    self.code(c)
    self.write-char('\n')
  }

  fn block(self: *mut code-builder, header: code, body: some fn() -> {}) {
    self.pad()
    self.code(header)
    self.write(" {\n")
    self.indent()
    body()
    self.dedent()
    self.pad()
    self.write("}\n")
  }

  fn block-close(self: *mut code-builder, header: code, close: string, body: some fn() -> {}) {
    self.pad()
    self.code(header)
    self.write(" {\n")
    self.indent()
    body()
    self.dedent()
    self.pad()
    self.write(close)
    self.write-char('\n')
  }

  fn sep[t, iter, i](self: *mut code-builder, items: i, separator: string, each: some fn t -> {})
    where iter: iterator[item = t], i: iterable[item = t, i = iter] {
    for x in items {
      if it-index > 0 { self.write(separator) }
      each(x)
    }
  }
}

impl writer for *code-builder {
  fn write-byte(self, b: u8): empty {
    self.pending.push(b)
  }
  fn write-bytes(self, b: span[u8]): empty {
    self.pending.append-span(b)
  }
}
