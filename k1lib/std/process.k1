// Running short-lived commands, from runtime or comptime code; catered to the
// needs of build() and scripting as first consumers

#if k1/os-posix ns posix-process {

  use core/posix
  use core/libc

  // argv for exec-family calls: program, args, null terminator, all in tmp
  fn make-argv(program: string, args: span[string]): list[ptr] {
    mem/push-mode(:tmp)
    let argv = list/with-capacity[ptr](args.len() + 2)
    argv.push(program.to-c().ptr)
    for arg in args {
      argv.push(arg.to-c().ptr)
    }
    argv.push(ptr/null)
    let _ = mem/pop-mode()
    argv
  }

  fn run(program: string, args: span[string], mode: process/output-mode): result[process/run-output, string] {
    let argv = make-argv(program, args)

    // posix_spawn_file_actions_t is opaque: 8 bytes on darwin, 80 on glibc
    let fa-buf = buffer/allocate-in[u8](context :tmp)(128)
    let fa = fa-buf.data.as[ptr]
    let _ = posix/posix_spawn_file_actions_init(fa)

    let pipe-fds = buffer/allocate-in[i32](context :tmp)(2)
    let child-out: i32 = if mode is :capture {
      if posix/pipe(pipe-fds.data.as[ptr]) != 0 {
        let _ = posix/posix_spawn_file_actions_destroy(fa)
        return :err "pipe failed: ${libc/errno-k1-string()}"
      }
      pipe-fds.get(1)
    } else {
      let dev-null = posix/open("/dev/null".to-c-tmp().ptr, posix/O_WRONLY)
      if dev-null < 0 {
        let _ = posix/posix_spawn_file_actions_destroy(fa)
        return :err "open /dev/null failed: ${libc/errno-k1-string()}"
      }
      dev-null
    }

    let _ = posix/posix_spawn_file_actions_adddup2(fa, child-out, 1)
    let _ = posix/posix_spawn_file_actions_adddup2(fa, child-out, 2)
    let _ = posix/posix_spawn_file_actions_addclose(fa, child-out)
    if mode is :capture {
      let _ = posix/posix_spawn_file_actions_addclose(fa, pipe-fds.get(0))
    }

    let pid: i32 = 0
    let spawn-rc = posix/posix_spawnp(
      &pid,
      program.to-c-tmp().ptr,
      fa,
      ptr/null,
      argv.base-ptr(),
      posix/environ-ptr()
    )
    let _ = posix/posix_spawn_file_actions_destroy(fa)
    let _ = posix/close(child-out)
    if spawn-rc != 0 {
      if mode is :capture { let _ = posix/close(pipe-fds.get(0)) }
      return :err "spawn '$program' failed: ${libc/strerror-string(spawn-rc)}"
    }

    let output = if mode is :capture {
      let read-fd = pipe-fds.get(0)
      mem/push-mode(:tmp)
      let sb = string-builder/new()
      let chunk = buffer/allocate[u8](4096)
      let read-errno: i32 = 0
      loop {
        let n = posix/read(read-fd, chunk.data.as[ptr], chunk.len.as[u64])
        if n > 0 {
          let n-bytes: size = n
          sb.write-bytes(span/wrap-buffer(chunk.slice(0, n-bytes)))
        } else if n == 0 {
          break
        } else {
          let e = libc/errno()
          if e != libc/EINTR {
            read-errno = e
            break
          }
        }
      }
      let _ = mem/pop-mode()
      let _ = posix/close(read-fd)
      if read-errno != 0 {
        // Reap before reporting so we never leave a zombie behind
        let status: i32 = 0
        let _ = posix/waitpid(pid, &status, 0)
        return :err "read from '$program' pipe failed: ${libc/strerror-string(read-errno)}"
      }
      sb.build()
    } else ""

    let status: i32 = 0
    let wait-rc = posix/waitpid(pid, &status, 0)
    while wait-rc < 0 and libc/errno() == libc/EINTR {
      wait-rc = posix/waitpid(pid, &status, 0)
    }
    if wait-rc < 0 {
      return :err "waitpid for '$program' failed: ${libc/errno-k1-string()}"
    }

    if status.bit-and(0x7f) == 0 {
      :ok .{ exit-code = status.shift-right(8).bit-and(0xff), signal = 0, output = output }
    } else {
      :ok .{ exit-code = -1, signal = status.bit-and(0x7f), output = output }
    }
  }

}

ns process {

  // No inherit mode: this is about running short-lived commands, not spawning
  // long-running processes
  type output-mode = either { drop, capture }

  // signal == 0 means normal exit; when killed by a signal, exit-code is -1
  type run-output = { exit-code: i32, signal: i32, output: string }

  ns for run-output {
    fn succeeded(self: run-output): bool {
      self.exit-code == 0 and self.signal == 0
    }
  }

  // Spawn failure (e.g. command not found) is the err; a nonzero exit is data,
  // reported in run-output
  fn run-command(program: string, args: span[string], mode: output-mode): result[run-output, string] {
    #if k1/os-posix posix-process/run(program, args, mode)
    else crash("process/run-command: unimplemented platform")
  }

  // Runs `program`, resolved via PATH, with stdout and stderr merged into output
  fn run(program: string, args: span[string]): result[run-output, string] {
    run-command(program, args, :capture)
  }

  fn sh(command: string): result[run-output, string] {
    run("/bin/sh", ["-c", command])
  }

}
