fn(test-runtime) test() {
  let core-args: span[string] = [
    "k1bindgen",
    "-lib-name",     "testlib",
    "-system",       "false",
    "-out-path",     "test/output.k1",
    "-in-path",      "test/input.c",
    "+opaque",       "opaq",
    "+exclude",      "Color_Blue",
    "+exclude",      "__",
    "+strip-suffix", "_t",      
    "+strip-suffix", "_u",      
    "+strip-prefix", "cinput_", 
    "+rename"      , "cinput_custom_name:my-custom-name"
  ]
  // TODO: Use 'diff' instead sys/cmd("diff", "input.c", "test/output.k1")
  let expected = std/files/read-to-string("test/expected.k1").!
  if start(core-args) is {
    :err msg -> crash("FAIL: $msg"),
    :ok output -> assert-equals(output, expected)
  }
}
