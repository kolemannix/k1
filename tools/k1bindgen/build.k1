fn module(): k1/module {
  let llvm-prefix = core/sys/env("LLVM_SYS_231_PREFIX") ?
    crash("k1bindgen needs LLVM_SYS_231_PREFIX set to an LLVM install prefix")
  let llvm-path = "$llvm-prefix/lib"
  .0 | .{
    link = [.{ name = "clang", link-type = :default }],
    link-args = ["-L$llvm-path", "-Wl,-rpath,$llvm-path"],
    ignore = ["test"],
  }
}
