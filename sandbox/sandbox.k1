// can't use list! the allocation will always point to a destroyed vm. Unless we let you clone into metascratch
// but then what are we even doing
let(metascratch) foo: { db: *sqlite3, block-count: int, all-fns: fixlist[string] } 

fn(metaend) close-db() {
  sqlite3/close(foo.db)
}

fn main(): i32 {

  0
}
