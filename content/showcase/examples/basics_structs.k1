type point = { x: int, y: int }

ns for point {
  fn shifted(self, dx: int, dy: int): point {
    .{ x = self.x + dx, y = self.y + dy }
  }
}

fn main() {
  let p = point.{ x = 1, y = 2 }
  println(p.shifted(dx = 10, dy = 10))
  let origin = point.0
  let up = origin | .{ y = 5 }
  println("$origin $up")
}
