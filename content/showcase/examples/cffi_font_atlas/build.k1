use std/process

fn module(): k1/module {
  .0 | .{
    setup-inputs = ["atlas.c"],
    setup-outputs = ["libs/libatlas.${k1/host-platform.dylib-ext()}"],
  }
}

fn setup() {
  let _ = process/sh-verbose(`
    cd "${k1/module-dir()}"
    mkdir -p libs
    cc -O2 -shared -I../../../../modules/stb/vendor atlas.c -o libs/libatlas.${k1/host-platform.dylib-ext()}
    `).!
}
