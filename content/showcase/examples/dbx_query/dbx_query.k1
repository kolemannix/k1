use dbx/query
use dbx/update

let schema: dbx/schema = dbx/make-schema("dbx_query", [`
  create table plan (
    id      integer primary key,
    name    text not null,
    is_main integer not null,
    note    text
  ) strict;`]) | .{ column-types = [.{ column = "plan.is_main", type-id = types/id[bool] }] }
$dbx/define([schema])

type plan-line = { id: i64, name: string, is-main: bool, note: ?string }

fn main(): i32 {
  let conn = dbx/open-memory().!
  migrate-db(conn).!

  update("insert into plan (name, is_main, note) values (${"Budget"}, ${true}, null)").run(conn).!
  update("insert into plan (name, is_main, note) values (${"What if"}, ${false}, ${"draft"})").run(conn).!

  let main-only = false
  let plans = query[plan-line]("select id, name, is_main, note from plan where is_main or not $main-only order by id").list(conn).!
  for plans { println("${it.id} ${it.name} main=${it.is-main} note=${it.note}") }
  0
}
