fn fnv1a(seed: u32, s: string): u32 {
  let h = seed
  for b in s.span-bytes() {
    h = (h ^ b.as[u32]) * 16777619
  }
  h
}

fn write-json-template(code: *string-builder, scope: string, name: string, type-id: types/type-id) {
  if type-id == types/id[string] {
    code.write(`\\"\${$scope$name}\\"`)
    return
  }
  if type-id.schema() is {
    :struct s -> {
      let h: u32 = 2166136261
      for f in s.fields {
        let kind = if f.type-id == types/id[string] ":str," else if f.type-id == types/id[bool] ":bool," else ":int,"
        h = h || fnv1a(f.name) || fnv1a(kind)
      }
      code.write(`{\\"schema\\":$h`)
      let fields = `$scope$name.`
      for f in s.fields {
        code.write(`,\\"${f.name}\\":`)
        write-json-template(code, fields, f.name, f.type-id)
      }
      code.write-char('}')
    },
    :bool or :int _ -> code.write(`\${$scope$name}`),
    _ -> crash("unsupported type ${type-id.name()}")
  }
}

fn write-json-code(type-id: types/type-id): code {
  let code = string-builder/new()
  code.write("w.write(\"")
  write-json-template(code.&, "", "t", type-id)
  code.write("\")")
  code/from-string(code.build())
}

fn write-json[t, w: writer](w: w, t: t) {
  #meta write-json-code(types/id[t])
}

fn to-json[t](t: t): string {
  let sb = string-builder/new()
  write-json(sb.&, t)
  sb.build()
}

fn main(): i32 {
  println("${serialize-all()}")
  0
}
