use std/time

fn main(): i32 {
  let buf = buffer/allocate[u8](256 * 1024 * 1024)
  buf.fill(65)
  let t0 = time/read-cpu-counter()
  let via-buffer = buf.contains(0)
  let buffer-ms = time/elapsed-ms(t0)
  let t1 = time/read-cpu-counter()
  let via-span = span/wrap-buffer(buf).contains(0)
  let span-ms = time/elapsed-ms(t1)
  println("buffer.contains: $via-buffer in $buffer-ms ms; span.contains: $via-span in $span-ms ms")
  0
}
