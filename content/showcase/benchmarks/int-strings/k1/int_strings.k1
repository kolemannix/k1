use core/arena
use std/spill-string
use std/time

let N: u64 = 100_000_000
let RUNS: int = 5
let BLOCK: u64 = 4096

fn(noinline) from-int(slots: *array[string, 1024], arenas: array[*arena, 2], n: u64) {
  let i: u64 = 0
  while i < n {
    let strings = arenas.[((i / BLOCK) & 1).signed()]
    strings.reset()
    let end = (i + BLOCK).min(n)
    mem/with-arena(strings, {
      while i < end {
        slots.[(i & 1023).signed()] = i.show()
        i = i + 1
      }
    })
  }
}

fn(noinline) from-int-spill(slots: *array[spill-string[22], 1024], n: u64) {
  for i in (0: u64).until(n) {
    let s = spill-string/new[22]()
    i.print-to(s.&)
    slots.[(i & 1023).signed()] = s
  }
}

fn timed(run: some fn() -> {}): u64 {
  let start = time/read-cpu-counter()
  run()
  time/elapsed-nanos(start)
}

fn report(name: string, nanos: u64) {
  let sb = string-builder/new()
  f64/format(N.as[f64] * 1000.0 / nanos.as[f64], sb.&, places = 1)
  println("$name: ${sb.build()} million strings per second")
}

fn main(): i32 {
  let slots = mem/alloc-t[array[string, 1024]]
  let arenas: array[*arena, 2] = [arena/init-default(), arena/init-default()]
  let best: u64 = u64/max-value
  for 0.until(RUNS) {
    best = best.min(timed(fn[slots, arenas]. from-int(slots, arenas, N)))
  }
  assert-equals(slots.[((N - 1) & 1023).signed()], (N - 1).show())
  report("k1 string show()", best)

  let spill-slots = mem/alloc-t[array[spill-string[22], 1024]]
  best = u64/max-value
  for 0.until(RUNS) {
    best = best.min(timed(fn[spill-slots]. from-int-spill(spill-slots, N)))
  }
  assert-equals(spill-slots.[((N - 1) & 1023).signed()].&.as-string(), (N - 1).show())
  report("k1 spill-string[22] print-to", best)
  0
}
