ability marky {
  fn marky-tag(self): i64
}

ability gated[impl t] {
  fn the-item(self): t
  fn item-tag(self): i64 where t: marky {
    self.the-item().marky-tag()
  }
}

type plain-box = { v: i64 }
impl gated[t = i64] for plain-box {
  fn the-item(self): i64 { self.v }
}

fn main(): i32 {
  let p: plain-box = .{ v = 3 }
  p.item-tag()
  0
}
//errmsg: item-tag is not available for plain-box
