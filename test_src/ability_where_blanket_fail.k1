ability marky {
  fn marky-tag(self): i64
}

ability gated[impl t] {
  fn the-item(self): t
  fn item-tag(self): i64 where t: marky {
    self.the-item().marky-tag()
  }
}

type holder[t] = { v: t }
impl[t] gated[t = t] for holder[t] {
  fn the-item(self): t { self.v }
}

fn main(): i32 {
  let h: holder[i64] = .{ v = 3 }
  h.item-tag()
  0
}
//errmsg: item-tag is not available for holder[i64]
