ns watch_test

use std/watch

fn(test-runtime) wait-reports-file-write() {
  let dir = "/tmp/k1-watch-test-${std/time/unix-nanos()}"
  let file = "$dir/f.txt"
  files/make-dir(dir).!
  files/write-entire-file(file, "orig").!

  let w = watch/create().!
  w.add(dir).!
  w.add(file).!
  files/write-entire-file(file, "changed").!

  let events = w.wait().!
  assert(events.non-empty())
  for e in events.as-span() {
    assert(e.path == file or e.path == dir)
  }
  w.close()
  files/remove(file).!
  files/remove-dir(dir).!
}
