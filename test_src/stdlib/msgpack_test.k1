ns msgpack_test
use std/msgpack
use std/json
use std/codec

let suite: string = files/read-to-string("${k1/module-dir()}/msgpack-test-suite/msgpack-test-suite.json").!

type contact = either { none, email(string) }
type user = { name: string, age: u32, nick: ?string, contact: contact, scores: list[i64] }
type tree = either { leaf, node(*tree) }
type forest = either { leaf, node(list[forest]) }

fn repeat(s: string, n: size): string {
  let sb = string-builder/new()
  sb.repeat(s, n)
  sb.build()
}

fn reject-prefixes[t: codec/decode](bytes: span[byte]) {
  for n in 0.until(bytes.len()) {
    if not (msgpack/parse[t](bytes.take(n)) is :err e and e.kind is :unexpected-end) { crash("prefix ${bytes.take(n).to-hex()}") }
  }
}

fn(test) passes-the-msgpack-test-suite() {
  for group in json/parse[json/json](suite).!.as-object().! {
    for c in group.value.as-array().! {
      let encodings: list[string] = []
      let expected: ?json/json = :none
      for m in c.as-object().! {
        if m.key is {
          "msgpack" -> { for m.value.as-array().! { encodings.push(string/join(it.as-str().!.split-by-char('-'), "")) } },
          "bignum" -> { expected = :some json/parse[json/json](m.value.as-str().!).! },
          "binary" or "timestamp" or "ext" -> {},
          _ -> { expected = :some m.value },
        }
      }
      for hex in encodings {
        let field = span/from-hex("81a178$hex").!
        if msgpack/parse[{}](field) is :err e { crash("${group.key} skip $hex: $e") }
        reject-prefixes[{}](field)
        require expected is :some want else { continue }
        let bytes = span/from-hex(hex).!
        require msgpack/parse[json/json](bytes) is :ok got else { crash("${group.key} decode $hex") }
        if not (if got is :float f json/from-value[f64](want) is :ok w and f == w else got == want) {
          crash("${group.key} decode $hex: ${json/to-string(got)}")
        }
        reject-prefixes[json/json](bytes)
      }
      if expected is :some want {
        let out = msgpack/to-bytes(want).to-hex()
        if not encodings.contains(out) { crash("${group.key} encode ${json/to-string(want)}: $out") }
      }
    }
  }
}

fn(test) encodes-records-and-long-headers() {
  let u: user = .{ name = "Ada", age = 36, nick = :none, contact = :email "a", scores = [1, -1, 300] }
  assert-equals(msgpack/to-bytes(u).to-hex(), "85a46e616d65a3416461a361676524a46e69636bc0a7636f6e7461637481a5656d61696ca161a673636f7265739301ffcd012c")
  assert-equals(msgpack/to-bytes(repeat("x", 256)).take(3).to-hex(), "da0100")
}

fn(test) round-trips() {
  let u: user = .{ name = "Ada", age = 36, nick = :some "ad", contact = :none, scores = [i64/min-value, -129, 0, 255, i64/max-value] }
  require msgpack/parse[user](msgpack/to-bytes(u)) is :ok back else { crash("user") }
  assert(back.nick is :some "ad" and back.contact is :none and back.scores == u.scores)
  assert(msgpack/parse[u64](msgpack/to-bytes(u64/max-value)) is :ok v and v == u64/max-value)
  assert(msgpack/parse[f32](msgpack/to-bytes(2.5: f32)) is :ok 2.5)
  assert(msgpack/parse[{ age: u8 }](msgpack/to-bytes(u)) is :ok a and a.age == 36)
}

fn(test) rejects-bad-input() {
  let bytes = msgpack/to-bytes(.{ name = "n", age = 300 })
  assert(msgpack/parse[{ name: string, age: u8 }](bytes) is :err e and e.kind is :overflow)
  assert(msgpack/parse[user](bytes) is :err e and "$e" == "missing field contact")
  assert(msgpack/parse[string](bytes.take(3)) is :err e and e.kind is :wrong-type "string")
  assert(msgpack/parse[int](msgpack/to-bytes([1, 2])) is :err e and e.kind is :wrong-type "number")
  assert(msgpack/parse[bool](span/from-hex("c3c3").!) is :err e and e.kind is :trailing)
  assert(msgpack/parse[string](span/from-hex("a1ff").!) is :err e and e.kind is :invalid-utf8)
  assert(msgpack/parse[contact](span/from-hex("a3626f62").!) is :err e and e.kind is :unknown-variant "bob")
  let deep = repeat("91", codec/max-depth + 1)
  assert(msgpack/parse[json/json](span/from-hex("${deep}c0").!) is :err e and e.kind is :depth)
  assert(msgpack/parse[{}](span/from-hex("81a162${deep}c0").!) is :err e and e.kind is :depth)
  let nodes = repeat("81a46e6f6465", codec/max-depth + 1)
  assert(msgpack/parse[tree](span/from-hex("${nodes}a46c656166").!) is :err e and e.kind is :depth)
  let hostile = span/from-hex("${repeat("81a46e6f6465dcffff", 100)}${repeat("c0", 1000)}").!
  let used = mem/current-arena().used-bytes()
  assert(msgpack/parse[forest](hostile) is :err _)
  assert(mem/current-arena().used-bytes() - used < 2 * hostile.len() * types/stride[forest])
}
