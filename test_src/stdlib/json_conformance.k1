ns json_conformance
use std/json

type verdict = either { accept, reject, any }

fn check(name: string, text: string, v: verdict) { check-bytes(name, text.span-bytes(), v) }

fn check-bytes(name: string, bytes: span[u8], v: verdict) {
  let r = json/parse[json/json](string/wrap-bytes(bytes))
  if v is {
    :accept -> if r is :err e { crash("$name should parse: $e") },
    :reject -> if r is :ok _ { crash("$name should be rejected") },
    :any -> {},
  }
}

fn test() {
  check("i_number_double_huge_neg_exp", "[123.456e-789]", :any)
  check("i_number_huge_exp", "[0.4e00669999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999969999999006]", :any)
  check("i_number_neg_int_huge_exp", "[-1e+9999]", :any)
  check("i_number_pos_double_huge_exp", "[1.5e+9999]", :any)
  check("i_number_real_neg_overflow", "[-123123e100000]", :any)
  check("i_number_real_pos_overflow", "[123123e100000]", :any)
  check("i_number_real_underflow", "[123e-10000000]", :any)
