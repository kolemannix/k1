ns crypto_test
use std/crypto

let NIST56: string = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
let NIST56_HASH: string = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"

fn hex-of(data: string): string {
  let d = crypto/sha256/hash(data.span-bytes())
  d.as-span().to-hex()
}

fn hmac-hex(key: span[u8], data: string): string {
  let d = crypto/hmac-sha256/hash(key, data.span-bytes())
  d.as-span().to-hex()
}

fn repeated(b: u8, n: size): list[u8] {
  let out = list/with-capacity[u8](n)
  let i: size = 0
  while i < n {
    out.push(b)
    i = i + 1
  }
  out
}

fn(test) sha256-known-vectors() {
  assert-equals(hex-of(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  assert-equals(hex-of("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  assert-equals(hex-of(NIST56), NIST56_HASH)
  assert-equals(
    hex-of("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
    "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
  )
}

fn(test) sha256-incremental-update() {
  let bytes = NIST56.span-bytes()
  let h = crypto/sha256/new()
  h.&.update(bytes.take(3))
  h.&.update(bytes.slice(3, 50))
  h.&.update(bytes.drop(50))
  let d = h.&.finish()
  assert-equals(d.as-span().to-hex(), NIST56_HASH)
}

fn(test) hmac-sha256-known-vectors() {
  assert-equals(hmac-hex(repeated(0x0b, 20).as-span(), "Hi There"), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
  assert-equals(hmac-hex("Jefe".span-bytes(), "what do ya want for nothing?"), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  assert-equals(
    hmac-hex(repeated(0xaa, 131).as-span(), "Test Using Larger Than Block-Size Key - Hash Key First"),
    "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
  )
}
