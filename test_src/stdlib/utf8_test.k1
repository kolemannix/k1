ns utf8_test
use std/utf8

fn decodes-losslessly(bytes: span[u8]): bool {
  let encoded = string-builder/new()
  for utf8/code-points(string/wrap-bytes(bytes)) { utf8/write-codepoint(encoded.&, it) }
  encoded.&.peek() == string/wrap-bytes(bytes)
}

fn(test) is-valid-matches-decoder-on-random-bytes() {
  let seed: u64 = 0x9E3779B97F4A7C15
  let buf = list/empty[u8]()
  for 0.until(3000) {
    buf.clear()
    seed = seed * 6364136223846793005 + 1442695040888963407
    let len = ((seed >> 33) % 40).signed()
    for 0.until(len) {
      seed = seed * 6364136223846793005 + 1442695040888963407
      let r = (seed >> 24).trunc[u8]
      let b: u8 = if r < 96 (r % 128) else if r < 160 (0x80 + r % 64) else if r < 200 (0xC2 + r % 30) else if r < 230 (0xE0 + r % 16) else (0xF0 + r % 8)
      buf.push(b)
    }
    let bytes = buf.as-span()
    if utf8/is-valid(bytes) != decodes-losslessly(bytes) {
      let sb = string-builder/new()
      for bytes { sb.write(" "); core/format-uint(sb.&, it.widen[u64], 16) }
      crash("utf8 mismatch, simd=${utf8/is-valid(bytes)}:${sb.build()}")
    }
  }
}

fn(test) code-points-replace-each-maximal-invalid-subpart() {
  assert-equals(utf8/count-code-points("aÄ€😀"), 4)
  assert-equals(utf8/code-points("aÄ€😀").to-list(), [0x61, 0xC4, 0x20AC, 0x1F600])
  let invalid: span[u8] = [0x61, 0xF1, 0x80, 0x80, 0xE1, 0x80, 0xC2, 0x62, 0x80, 0x63, 0x80, 0xBF, 0x64]
  assert-equals(utf8/code-points(string/wrap-bytes(invalid)).to-list(), [0x61, 0xFFFD, 0xFFFD, 0xFFFD, 0x62, 0xFFFD, 0x63, 0xFFFD, 0xFFFD, 0x64])
  let overlong: span[u8] = [0xC0, 0x80, 0xE0, 0x80, 0x80, 0xF0, 0x80, 0x80, 0x80]
  assert-equals(utf8/code-points(string/wrap-bytes(overlong)).to-list(), list/filled[u32](9, 0xFFFD))
}

fn(test) count-code-points-across-vector-chunks() {
  let text = string-builder/new()
  for reps in 0.until(8) {
    for ascii in 0.until(33) {
      text.&.reset()
      for 0.until(reps) { text.write("aÄ€😀") }
      for 0.until(ascii) { text.write("x") }
      assert-equals(utf8/count-code-points(text.&.peek()), 4 * reps + ascii)
    }
  }
  assert-equals(utf8/count-code-points(string/wrap-bytes(list/filled[u8](40, 0x80).as-span())), 0)
}

fn(test) is-valid-matches-decoder-on-edge-cases() {
  let edges: span[span[u8]] = [
    [0xE2, 0x82], [0xE2, 0x82, 0xAC], [0xF0, 0x9F, 0x98], [0xF0, 0x9F, 0x98, 0x80], [0xC0, 0x80], [0xED, 0xA0, 0x80],
    [0xF4, 0x90, 0x80, 0x80], [0xF4, 0x8F, 0xBF, 0xBF], [0x80], [0xC2], [0x61, 0xC3, 0xA9],
    [0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0xE2],
    [0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0xE2, 0x82],
    [0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0xC3, 0xA9],
    [0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0xE2, 0x82],
  ]
  for edges { assert-equals(utf8/is-valid(it), decodes-losslessly(it)) }
}
