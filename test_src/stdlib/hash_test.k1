ns hash_test

use std/hash
use std/map
use std/set
use std/fixmap
use std/fixset
use std/heap-string
use std/spill-string

fn(test) lookup-by-view() {
  let m = map/new[heap-string, int]()
  m.insert(heap-string/cloned("a"), 1)
  assert-equals(m.get("a"), :some 1)
  assert-equals(m.get(heap-string/cloned("a")), :some 1)
  assert(m.contains("a"))
  let f: fixmap[heap-string, int, 16] = fixmap/new()
  f.insert(heap-string/cloned("b"), 2)
  assert-equals(f.remove("b"), :some 2)
  let s = set/new[heap-string]()
  s.add(heap-string/cloned("c"))
  assert(s.contains("c"))
  let inline = map/new[spill-string[16], int]()
  inline.insert(spill-string/from-string("d"), 3)
  assert-equals(inline.get("d"), :some 3)
  let ids = map/new[u32, int]()
  ids.insert(7, 1)
  assert-equals(ids.get(7), :some 1)
}

type fixmap-holder = { pad: u64, m: fixmap[int, int, 16], tail: u64 }

fn(test) fixmap-full() {
  let h: fixmap-holder = .{ pad = 1, m = .0, tail = 2 }
  for i in 0.until(15) { assert(h.m.try-insert(i, i * 10) is :ok) }
  assert(h.m.is-full())
  assert(h.m.try-insert(99, 1) is :err)
  assert(h.m.get-or-insert(99, fn. 1) is :none)
  assert(h.m.try-insert(3, 31) is :ok)
  assert-equals(h.m.get(3), :some 31)
  assert-equals(h.m.get(14), :some 140)
  assert-equals(h.m.get(15), :none)
  assert-equals(h.m.remove(3), :some 31)
  assert(h.m.try-insert(99, 1) is :ok)
  assert-equals(h.m.get(99), :some 1)
  let total = 0
  let seen = 0
  for kv in h.m {
    total = total + kv.value
    seen = seen + 1
  }
  assert-equals(seen, 15)
  assert-equals(total, 10 * 105 - 30 + 1)
  assert-equals(h.pad, 1)
  assert-equals(h.tail, 2)
}

fn(test) fixmap-remove-in-scrambled-order() {
  let m = fixmap/new[int, int, 16]()
  for i in 0.until(15) { m.insert(i * 7919, i) }
  let removed = fixset/new[int, 16]()
  for i in 0.until(15) {
    let victim = (i * 7) % 15
    assert-equals(m.remove(victim * 7919), :some victim)
    assert-equals(m.remove(victim * 7919), :none)
    removed.add(victim)
    for j in 0.until(15) {
      let expected: ?int = if removed.contains(j) :none else :some j
      assert-equals(m.get(j * 7919), expected)
    }
    assert-equals(m.len(), 14 - i)
  }
  assert(m.is-empty())
}

fn(test) map-tombstones() {
  let m = map/with-capacity[int, int](14)
  assert-equals(m.cap(), 14)
  let kept: list[int] = []
  for round in 0.until(200) {
    for i in 0.until(10) {
      let key = round * 100 + i
      m.insert(key, key * 2)
      if i % 3 == 0 kept.push(key) else { assert-equals(m.remove(key), :some (key * 2)) }
    }
    if round % 4 == 3 {
      for key in kept { assert-equals(m.remove(key), :some (key * 2)) }
      kept.clear()
    }
    assert-equals(m.len(), kept.len)
    for key in kept { assert-equals(m.get(key), :some (key * 2)) }
    assert(m.get(round * 100 + 1) is :none)
  }
  assert(m.cap() <= 56)
}

fn(test) spans-hash-their-lengths() {
  let nested: span[span[int]] = [[1], [2, 3]]
  let regrouped: span[span[int]] = [[1, 2], [3]]
  assert(nested.hash() != regrouped.hash())
  assert("ab".hash() != "abb".hash())
}
