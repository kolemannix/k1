ns process_test

use std/fd
use std/process

fn write-line(child: *mut process/child, line: string) {
  fd/write-all(child.stdin-fd, "${line}\n".span-bytes()).!
}

fn test() {
  // PATH lookup + argument passing; ok is the captured output
  assert-equals(process/run("echo", ["hello", "world"]).!, "hello world\n")

  // stdout and stderr are merged, in order
  assert-equals(process/sh("echo out; echo err 1>&2").!, "out\nerr\n")

  // A nonzero exit is the err, carrying the full status
  process/sh("exit 3") is {
    :err :failed f -> {
      assert-equals(f.status.exit-code, 3)
      assert-equals(f.status.signal, 0)
    },
    _ -> crash("expected :err :failed")
  }

  // run-status keeps exit status as data
  let failed = process/run-status("/bin/sh", ["-c", "exit 3"], :capture).!
  assert-equals(failed.exit-code, 3)
  assert-equals(failed.signal, 0)

  // Death by signal
  let signaled = process/run-status("/bin/sh", ["-c", "kill -9 $$"], :capture).!
  assert-equals(signaled.exit-code, -1)
  assert-equals(signaled.signal, 9)

  // Spawn failure is the err for both flavors
  assert(process/run("definitely-not-a-real-cmd-k1", []) is :err :spawn _)
  assert(process/run-status("definitely-not-a-real-cmd-k1", [], :capture) is :err :spawn _)

  // :drop discards output
  assert-equals(process/run-command("echo", ["ignored"], :drop).!, "")

  // :inherit streams to our stdout/stderr; nothing is captured
  assert-equals(process/run-command("true", [], :inherit).!, "")

  // Output larger than the pipe buffer exercises the read loop
  assert-equals(process/sh("head -c 131072 /dev/zero | tr '\\0' 'a'").!.len(), 131072)

  // Interactive child: lines flow both ways, EOF on close, clean reap
  let cat = process/spawn("cat", []).!
  write-line(cat.&, "first")
  assert-equals(cat.stdout.read-line().!, "first")
  write-line(cat.&, "second")
  write-line(cat.&, "third")
  assert-equals(cat.stdout.read-line().!, "second")
  assert-equals(cat.stdout.read-line().!, "third")
  let cat-status = cat.wait().!
  assert-equals(cat-status.exit-code, 0)

  // read-line returns :none at EOF; a last line without a newline still arrives
  let printer = process/spawn("/bin/sh", ["-c", "printf 'no-newline'"]).!
  assert-equals(printer.stdout.read-line().!, "no-newline")
  assert(printer.stdout.read-line() is :none)
  printer.wait().!

  // kill: the child dies by signal
  let sleeper = process/spawn("sleep", ["100"]).!
  sleeper.kill()
  let sleeper-status = sleeper.wait().!
  assert-equals(sleeper-status.signal, 9)
}
