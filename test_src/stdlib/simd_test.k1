ns simd_test

$std/simd/map[u8](scale-add, x, [std/simd/c("k", 3)], x * k + x)
$std/simd/reduce[u8](sum-wrapping, a, b, a + b, 0)
$std/simd/first-of(json-delims, [',', ':', '"'])
$std/simd/first-of(commas, [','])

fn assert-map-matches(input: list[u8]) {
  let dst = list/filled(input.len, 0: u8)
  scale-add(dst.as-buffer(), input.as-span())
  for input {
    // x * 3 + x == 4x, wrapping in u8
    assert-equals(dst.[it-index], it * 4)
  }
}

fn test-map() {
  // Boundary lengths around the 16-lane chunk size
  let lengths: span[size] = [0, 1, 15, 16, 17, 31, 32, 33]
  for len in lengths {
    let input = list/with-capacity[u8](len)
    for 0.until(len) {
      input.push((it % 251).trunc[u8])
    }
    assert-map-matches(input)
  }
}

fn test-reduce() {
  let input = list/with-capacity[u8](33)
  let expected = 0: u8
  for 0.until(33) {
    input.push(it.trunc[u8])
    expected = expected + it.trunc[u8]
  }
  assert-equals(sum-wrapping(input.as-span()), expected)
  assert-equals(sum-wrapping(input.slice(0, 16)), 120)
  assert-equals(sum-wrapping(input.slice(0, 0)), 0)
  assert-equals(sum-wrapping(input.slice(0, 1)), 0)
  assert-equals(sum-wrapping(input.slice(1, 3)), 3)
}

fn scan-str(s: string, from: size): { index: i64, which: i64 } {
  json-delims/scan(s.span-bytes(), from)
}

fn test-first-of() {
  let r1 = scan-str("{\"name\": \"a longer value here\"}", 0)
  assert-equals(r1.index, 1)
  assert-equals(r1.which, 2) // the '"'
  let r2 = scan-str("aaaaaaaaaaaaaaaaaaaaaaaaaa:b", 0)
  assert-equals(r2.index, 26) // found past the first chunk
  assert-equals(r2.which, 1)
  let r3 = scan-str("aaaaaaaaaaaaaaaaaaaaaaaaaa:b", 27)
  assert-equals(r3.index, -1) // scan from past the match, short tail
  let r4 = scan-str("no delimiters in this string at all", 0)
  assert-equals(r4.index, -1)
  assert-equals(r4.which, -1)
  let r5 = scan-str("xy,", 0)
  assert-equals(r5.index, 2) // scalar-tail-only path
  assert-equals(r5.which, 0)
  let r6 = scan-str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"", 0)
  assert-equals(r6.index, 70)
  assert-equals(r6.which, 2)
  let r7 = scan-str("abc:de,fgh", 0)
  assert-equals(r7.index, 3)
  assert-equals(r7.which, 1)
  assert-equals(scan-str("abc", 99).index, -1)

  let marks: span[u8] = [','.as-u8(), ':'.as-u8(), '"'.as-u8()]
  for len in 0.until(3 * k1/simd-bytes + 2) {
    let buf = buffer/filled[u8](len, 'a'.as-u8())
    assert-equals(json-delims/scan(buf.as-span(), 0).index, -1)
    for at in 0.until(len) {
      let which = at % 3
      buf.[at] = marks.[which]
      buf.[len - 1] = ','.as-u8()
      let r = json-delims/scan(buf.as-span(), 0)
      assert-equals(r.index, at)
      assert-equals(r.which, if at == len - 1 0 else which)
      buf.[at] = 'a'.as-u8()
      buf.[len - 1] = 'a'.as-u8()
    }
  }

  let c1 = commas/scan("ab,cd,".span-bytes(), 0)
  assert-equals(c1.index, 2)
  assert-equals(c1.which, 0)
  assert-equals(commas/scan("ab,cd,".span-bytes(), 3).index, 5)
  assert-equals(commas/scan("ab,cd,".span-bytes(), 6).which, -1)
  assert-equals(commas/scan("ab,cd,".span-bytes(), 60).index, -1)
}

fn test() {
  test-map()
  test-reduce()
  test-first-of()
}
