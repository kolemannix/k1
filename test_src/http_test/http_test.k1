use uv/libuv
use uv/req
use uv/handle
use uv/stream
use http/http-response
use http/response
use http/server
use std/pubsub
use std/rc-bytes
use http/datastar
use std/url
use std/url/pair
use http/cookie
use std/rc-byte-stream
use std/source
use std/collect-sink
use std/byte-source
use http/chunked
use http/sse-events
use std/waker
use std/pull
use uv/worker-pool
use http/task

$http/routing/define(route, \{
  get  events     "/events"
  get  files      "/files/*path"
  post game-poke  "/game/{id: u64}/poke"
  get  grade-rate "/cmd/grade-rate/{who: string}" ?{ plan-id: int, item-id: u64, note: ?string }
})

fn route-of(method: http/llhttp/method, target: string): result[route, http/routing/route-error] {
  route/parse(method, url/parse(target).!)
}

fn(test) test-routing() {
  assert(route/parse-request(http/header/get("/game/42/poke")) is :err :bad-method _)
  assert((route:game-poke .{ id = 42 }).to-string() == "/game/42/poke")
  assert("${route:files .{ path = "a b/c" }}" == "/files/a%20b/c")

  assert(route-of(:HEAD, "/events?foo=1") is :ok :events)
  assert(route-of(:GET, "http://h/%65vents") is :ok :events)
  assert(route-of(:GET, "/files/a%20b/c") is :ok :files f and f.path == "a b/c")
  assert(route-of(:POST, "/game/42/poke/") is :ok :game-poke p and p.id == 42)
  assert(route-of(:GET, "/game/42/poke") is :err :bad-method _)
  assert(route-of(:POST, "/game/18446744073709551617/poke") is :err :bad-param _)
  assert(route-of(:GET, "/game/42/zzz") is :err :not-found)
  assert(route-of(:POST, "/game/%zz/poke") is :err :bad-param _)
  assert(route-of(:OPTIONS, "*") is :err :not-found)

  let g = route:grade-rate .{ who = "a b", plan-id = -3, item-id = 9, note = :some "x&y=1+z" }
  assert-equals(g.to-string(), "/cmd/grade-rate/a%20b?plan-id=-3&item-id=9&note=x%26y%3D1%2Bz")
  assert-equals((route:grade-rate .{ who = "a/b", plan-id = 1, item-id = 2, note = :some "x y" }).to-string(), "/cmd/grade-rate/a%2Fb?plan-id=1&item-id=2&note=x+y")
  assert(route-of(:GET, g.to-string()) is :ok :grade-rate r and r.who == "a b" and r.plan-id == -3 and r.item-id == 9 and r.note is :some nt and nt == "x&y=1+z")
  assert(route-of(:GET, "/cmd/grade-rate/x?zz=1&note=a+b&item-id=2&&plan-id=1") is :ok :grade-rate r2 and r2.note is :some nn and nn == "a b")
  assert(route-of(:GET, "/cmd/grade-rate/x?item-id=2&plan-id=1") is :ok :grade-rate r3 and r3.note is :none)
  assert-equals((route:grade-rate .{ who = "x", plan-id = 1, item-id = 2, note = :none }).to-string(), "/cmd/grade-rate/x?plan-id=1&item-id=2")
  assert(route-of(:GET, "/cmd/grade-rate/x?plan-id=1") is :err :missing-param m and m.name == "item-id")
  assert(route-of(:GET, "/cmd/grade-rate/x?plan-id=one&item-id=2") is :err :bad-param b and b.got == "one")
  assert(route-of(:GET, "/cmd/grade-rate/x?plan-id=1&item-id=2&plan-id=1") is :err :bad-param b2 and b2.name == "plan-id")
}

fn(test) test-parsers() {
  let c = cookie/parse("who=bob;junk ; x=a=b; enc=a%20b%3B; plus=a+b; empty=; raw=%zz")
  assert-equals(c.len(), 6)
  assert(pair/find(c.as-span(), "who") == :some "bob")
  assert(pair/find(c.as-span(), "x") == :some "a=b")
  assert(pair/find(c.as-span(), "enc") == :some "a b;")
  assert(pair/find(c.as-span(), "plus") == :some "a+b")
  assert(pair/find(c.as-span(), "empty") == :some "")
  assert(pair/find(c.as-span(), "raw") == :some "%zz")
  assert-equals(
    cookie/set-header("who", "bob smith;", cookie/attrs/default() | .{ max-age = :some 60, secure = true, same-site = :strict }),
    "Set-Cookie: who=bob%20smith%3B; Path=/; Max-Age=60; HttpOnly; Secure; SameSite=Strict")
  assert-equals(cookie/set-header("k", "v", cookie/attrs/default()), "Set-Cookie: k=v; Path=/; HttpOnly; SameSite=Lax")

  let h = http/header/make(:POST, "/login?next=%2Fhome")
  h.headers.push(.{ field = "content-type", value = "application/x-www-form-urlencoded; charset=utf-8" })
  h.headers.push(.{ field = "Cookie", value = "who=bob" })
  let req: http/request = .{ header = h, body = "who=alice".span-bytes() }
  assert(pair/find(req.header.url.query-pairs(), "next") == :some "/home")
  assert(pair/find(req.form().!, "who") == :some "alice")
  assert(pair/find(req.cookies(), "who") == :some "bob")
  let plain: http/request = .{ header = http/header/make(:GET, "/"), body = [] }
  assert(plain.form() is :none)
  assert(plain.cookies().is-empty())
  assert(not plain.accepts-encoding("br"))
  plain.header.headers.push(.{ field = "accept-encoding", value = "gzip, BR;q=0.5, zstd;q=0.0" })
  assert(plain.accepts-encoding("br"))
  assert(not plain.accepts-encoding("zstd"))
  assert(not plain.accepts-encoding("deflate"))
  let moved = response/redirect(:see-other, "/a?b=1", ["Set-Cookie: k=v"])
  assert-equals(moved.extra-headers.[0], "Location: /a?b=1")
  assert-equals(moved.status.to-string(), "303 See Other")
  assert(moved.status.may-have-content())
  assert(not response/no-content().status.may-have-content())
}

fn drain(src: byte-source): string {
  let sink: collect-sink[u8] = .{ items = list/empty() }
  string/wrap-bytes(source/run-to(src, sink.&))
}

fn sse(src: byte-source, event-name: string, data-prefix: string): string {
  drain(src || sse-events(event-name, data-prefix))
}

fn(test) test-encoders() {
  assert-equals(drain(source/from-printed(["0123456789abcdefg"]) || chunked), "11\r\n0123456789abcdefg\r\n0\r\n\r\n")
  assert-equals(drain(source/once(["".span-bytes()]) || chunked), "0\r\n\r\n")

  assert-equals(
    sse(source/from-printed(["<div id=\"x\">\n  hi\n</div>"]), "datastar-patch-elements", "elements"),
    "event: datastar-patch-elements\ndata: elements <div id=\"x\">\ndata: elements   hi\ndata: elements </div>\n\n")
  assert-equals(
    sse(source/from-printed(["{\"cells_0_tab\": \"output\"}"]), "datastar-patch-signals", "signals"),
    "event: datastar-patch-signals\ndata: signals {\"cells_0_tab\": \"output\"}\n\n")
  assert-equals(sse(source/once(["ab".span-bytes(), "\n".span-bytes(), "c".span-bytes()]), "e", "p"), "event: e\ndata: p ab\ndata: p c\n\n")
  assert-equals(sse(source/from-printed(["line\n"]), "e", "p"), "event: e\ndata: p line\n\n")
  assert-equals(sse(source/from-printed(["a", "b"]), "n", ""), "event: n\ndata: a\n\nevent: n\ndata: b\n\n")
  assert-equals(sse(source/from-printed(["x\n\ny"]), "e", "p"), "event: e\ndata: p x\ndata: p \ndata: p y\n\n")
  assert-equals(sse(source/once(["a\rb\r".span-bytes(), "\nc\r\n".span-bytes()]), "e", "p"), "event: e\ndata: p a\ndata: p b\ndata: p c\n\n")
}

type worker-woken = { pool: *worker-pool, waker: waker, state: uv/mutex[{ stopped: bool, ready: bool }], sent: bool }

impl source[t = u8] for worker-woken {
  fn start(self: *worker-woken, waker: waker) {
    self.waker = waker
    self.state.init(.{ stopped = false, ready = false })
    let _ = self.pool.submit(self, fn(src: *worker-woken) {
      libuv/sleep(50)
      uv/locked(src.state, state, {
        if not state.stopped {
          state.ready = true
          src.waker.wake()
        }
      })
    }).!
  }
  fn pull(self: *worker-woken): pull[u8] {
    if self.sent return :done
    require uv/locked(self.state, state, state.ready) else return :pending
    self.sent = true
    :chunk ["woken".span-bytes()]
  }
  fn stop(self: *worker-woken) { uv/locked(self.state, state, { state.stopped = true }) }
}

fn handle(req: http/request, bus: *pubsub/bus[span[u8]], pool: *worker-pool): http-response {
  let url = req.header.url.text
  if url == "/hello" response/text(:ok, "hi")
  else if url == "/slow" { libuv/sleep(300); response/text(:ok, "slow-done") }
  else if url == "/len" response/text(:ok, "len ${req.body.len()} ${string/wrap-bytes(req.body)}")
  else if url == "/stall" { libuv/sleep(2000); response/text(:ok, "stall-done") }
  else if url == "/outlast" { libuv/sleep(2600); response/text(:ok, "outlast-done") }
  else if url == "/events" datastar/patch-signals(bus.subscribe("t") || rc-byte-stream)
  else if url == "/worker-woken" {
    let src: *worker-woken = mem/new(.{ pool, waker = waker/noop(), state = uninit, sent = false })
    .{ status = :ok, content-type = "text/plain", extra-headers = [], body = :stream src.to-dyn[source[t = u8]] }
  }
  else response/not-found()
}

type client = {
  tcp: libuv/tcp,
  connect-req: libuv/connect,
  write-req: libuv/write,
  rest-req: libuv/write,
  rest-timer: libuv/timer,
  buf: libuv/buf,
  read-buf: array[u8, 4096],
  send: string,
  rest: string,
  received: list[u8],
  started: u64,
  elapsed-ms: u64,
  eof: bool,
  hang-up: bool,
  on-eof: *fn(*client) -> {},
}

ns for client {
  fn start(port: u16, send: string, on-eof: *fn(*client) -> {}) { open(port, send, "", on-eof, hang-up = false) }

  fn start-split(port: u16, send: string, rest: string, on-eof: *fn(*client) -> {}) { open(port, send, rest, on-eof, hang-up = false) }

  fn start-and-hang-up(port: u16, send: string) { open(port, send, "", fn _c. .{}, hang-up = true) }

  fn open(port: u16, send: string, rest: string, on-eof: *fn(*client) -> {}, hang-up: bool) {
    let c: *client = heap.new(.{
      tcp = uninit, connect-req = uninit, write-req = uninit, rest-req = uninit, rest-timer = uninit, buf = uninit, read-buf = uninit,
      send, rest, received = list/empty(), started = libuv/now(libuv/default_loop().get()), elapsed-ms = 0, eof = false, hang-up, on-eof,
    })
    let l = libuv/default_loop().get()
    uv/check(libuv/tcp_init(l, c.tcp.&)).!
    uv/check(libuv/timer_init(l, c.rest-timer.&)).!
    c.tcp.&.set-data(c)
    c.connect-req.&.set-data(c)
    c.write-req.&.set-data(c)
    c.rest-req.&.set-data(c)
    c.rest-timer.&.set-data(c)
    let addr: libuv/sockaddr_in = uninit
    uv/check(libuv/ip4_addr("127.0.0.1\0".data-ref-byte(), port.widen[i32], addr.&)).!
    uv/check(libuv/tcp_connect(c.connect-req.&, c.tcp.&, addr.&.as[ptr].narrow(), on-connect.&)).!
  }

  fn text(self: *client): string { string/wrap-bytes(self.received.as-span()) }
}

fn on-connect(req: *libuv/connect, status: i32) {
  let c = req.get-data[client]
  if status != 0 crash("client connect failed: $status")
  c.buf = libuv/buf/wrap-span(c.send.span-bytes())
  uv/check(libuv/write(c.write-req.&, c.tcp.&.as-stream(), c.buf.&, 1, fn(req, status) {
    uv/check(status).!
    let c = req.get-data[client]
    if c.hang-up { libuv/close(c.tcp.&.as-handle(), fn _h. .{}) }
    if c.rest.non-empty() {
      c.rest-timer.&.start(fn t. {
        let c = t.get-data[client]
        libuv/close(t.as-handle(), fn _h. .{})
        c.buf = libuv/buf/wrap-span(c.rest.span-bytes())
        uv/check(libuv/write(c.rest-req.&, c.tcp.&.as-stream(), c.buf.&, 1, fn(_req, status) { uv/check(status).! })).!
      }, 50, 0)
    }
  })).!
  if c.hang-up return
  if libuv/read_start(c.tcp.&.as-stream(), fn(h, _size, buf) {
    let c = h.get-data[client]
    buf.* = libuv/buf/wrap-span(c.read-buf.&.as-span())
  }, on-read.&) != 0 crash("client read_start")
}

fn on-read(stream: *libuv/stream, nread: size, buf: *libuv/buf) {
  let c = stream.get-data[client]
  if nread > 0 {
    c.received.append-span-in(heap, span/wrap-raw[u8](buf.base.inner, nread))
  } else if nread < 0 {
    c.eof = true
    c.elapsed-ms = libuv/now(libuv/default_loop().get()) - c.started
    libuv/close(c.tcp.&.as-handle(), fn h. {
      let c = h.get-data[client]
      (c.on-eof)(c)
    })
  }
}

let(mutable) srv: ptr = ptr/null
let(mutable) startup-state: string = ""
let(mutable) phase1-done: u32 = 0
let(mutable) slowloris-cut: bool = false
let(mutable) hello-idle-cut: bool = false
let(mutable) events-cut: bool = false
let(mutable) slow-finished: bool = false
let(mutable) stall-cut: bool = false
let(mutable) over-cap-rejected: bool = false
let(mutable) body-limits-checked: bool = false
let(mutable) worker-woke-stream: bool = false

fn get-server(): *server { srv.ref[server] }

fn on-slowloris-eof(c: *client) {
  assert(c.received.is-empty())
  assert(c.elapsed-ms >= 200)
  slowloris-cut = true
  client/start(get-server().port, "POST /len HTTP/1.1\r\nHost: x\r\nContent-Length: 5000\r\n\r\n", fn c. {
    assert(c.text().starts-with("HTTP/1.1 413 Content Too Large\r\n"))
    let chunked = list/empty[u8]()
    chunked.append-span-in(heap, "POST /len HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n7d0\r\n".span-bytes())
    for _ in 0.until(2000) { chunked.push-in(heap, 'a'.as-u8()) }
    chunked.append-span-in(heap, "\r\n0\r\n\r\n".span-bytes())
    client/start(get-server().port, string/wrap-bytes(chunked.as-span()), fn c. {
      assert(c.text().starts-with("HTTP/1.1 413 Content Too Large\r\n"))
      client/start(get-server().port, "GET http://h:99999/ HTTP/1.1\r\nHost: x\r\n\r\n", fn c. {
        assert(c.text().starts-with("HTTP/1.1 400 Bad Request\r\n"))
        client/start(get-server().port, "POST /len HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello", fn c. {
          assert(c.text().ends-with("\r\n\r\nlen 5 hello"))
          client/start(get-server().port, "POST /len HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n", fn c. {
            assert(c.text().ends-with("\r\n\r\nlen 5 hello"))
            client/start-split(get-server().port, "POST /len HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhel", "lo", fn c. {
              assert(c.text().ends-with("\r\n\r\nlen 5 hello"))
              body-limits-checked = true
              client/start(get-server().port, "GET /worker-woken HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n", fn c. {
                assert(c.text().ends-with("\r\n\r\n5\r\nwoken\r\n0\r\n\r\n"))
                worker-woke-stream = true
                phase1-step()
              })
            })
          })
        })
      })
    })
  })
  phase1-step()
}

fn phase1-step() {
  phase1-done = phase1-done + 1
  if phase1-done == 3 { phase2() }
}

fn on-hello-eof(c: *client) {
  let t = c.text()
  assert(t.starts-with("HTTP/1.1 200 OK\r\n"))
  assert(t.ends-with("\r\n\r\nhi"))
  assert(c.elapsed-ms >= 300)
  hello-idle-cut = true
  phase1-step()
}

fn phase2() {
  assert(startup-state == "startup-lifetime")
  client/start(get-server().port, "GET /events HTTP/1.1\r\nHost: x\r\n\r\n", fn c. {
    let t = c.text()
    assert(t.starts-with("HTTP/1.1 200 OK\r\n"))
    assert(t.contains-string("Content-Type: text/event-stream\r\n"))
    events-cut = true
  })
  client/start(get-server().port, "GET /slow HTTP/1.1\r\nHost: x\r\n\r\n", fn c. {
    let t = c.text()
    assert(t.starts-with("HTTP/1.1 200 OK\r\n"))
    assert(t.ends-with("\r\n\r\nslow-done"))
    slow-finished = true
  })

  let t: *libuv/timer = heap.alloc-t()
  uv/check(libuv/timer_init(libuv/default_loop().get(), t)).!
  let _ = libuv/timer_start(t, fn t. {
    get-server().stop()
    libuv/close(t.as-handle(), fn _h. .{})
  }, 100, 0)
}

fn(test-runtime) test-server() {
  let config: server/config = .{
    host = "127.0.0.1", port = 0, accept-queue-len = 128, max-connections = 4, max-body-size = 1024,
    header-timeout-ms = 200, body-timeout-ms = 30000, write-timeout-ms = 30000,
    idle-timeout-ms = 300, drain-timeout-ms = 500, handle-signals = false,
  }
  startup-state = "startup-lifetime".cloned()
  let bus = uv/bus/create[span[u8]](libuv/default_loop().get(), 1048576, fn(payload: rc-bytes) payload.bytes().len())
  let pool = uv/worker-pool/start(target-free-count = 4, max-worker-count = 8, capacity = 64)
  let s = server/start(config, pool, (fn[bus, pool](req: http/request) handle(req, bus, pool)).to-dyn()).!
  srv = s.as[ptr]
  assert(s.port != 0)
  client/start(s.port, "GET / HTTP/1.1\r\nHost: x\r\n", on-slowloris-eof.&)
  client/start(s.port, "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n", on-hello-eof.&)
  client/start-and-hang-up(s.port, "GET /outlast HTTP/1.1\r\nHost: x\r\n\r\n")
  client/start(s.port, "GET /stall HTTP/1.1\r\nHost: x\r\n\r\n", fn c. {
    assert(c.received.is-empty())
    assert(c.elapsed-ms >= 2000)
    stall-cut = true
  })
  let t: *libuv/timer = heap.alloc-t()
  uv/check(libuv/timer_init(libuv/default_loop().get(), t)).!
  let _ = libuv/timer_start(t, fn t. {
    client/start(get-server().port, "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n", fn c. {
      assert(c.text().starts-with("HTTP/1.1 503 Service Unavailable\r\n"))
      over-cap-rejected = true
    })
    libuv/close(t.as-handle(), fn _h. .{})
  }, 50, 0)
  s.run()
  pool.join()
  assert(startup-state == "startup-lifetime")
  assert(slowloris-cut)
  assert(hello-idle-cut)
  assert(events-cut)
  assert(slow-finished)
  assert(stall-cut)
  assert(body-limits-checked)
  assert(worker-woke-stream)
  assert(over-cap-rejected)
  assert(s.connections.is-empty())
}

fn add-one(x: i32): i32 { x + 1 }

fn await-on-own-pool(pool: *worker-pool): i32 {
  task/spawn(pool, add-one.&, 41).!.await()
}

fn wait-for-flag(flag: *uv/monitor[bool]) {
  let guard = flag.lock()
  while not guard.value.* { guard.wait() }
  guard.unlock()
}

fn set-flag(flag: *uv/monitor[bool]) {
  let guard = flag.lock()
  guard.value.* = true
  guard.signal()
  guard.unlock()
}

fn(test-runtime) test-pool() {
  let inline-only = worker-pool/start(target-free-count = 1, max-worker-count = 1, capacity = 8)
  assert-equals(task/spawn(inline-only, await-on-own-pool.&, inline-only).!.await(), 42)
  inline-only.close()
  inline-only.join()

  let elastic = worker-pool/start(target-free-count = 1, max-worker-count = 2, capacity = 8)
  let flag: uv/monitor[bool] = uninit
  flag.init(false)
  let _ = elastic.submit-blocking(flag.&, wait-for-flag.&).!
  let _ = elastic.submit(flag.&, set-flag.&).!
  elastic.close()
  elastic.join()
  flag.destroy()
}
