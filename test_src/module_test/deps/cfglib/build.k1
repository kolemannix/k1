let cfg: { backlog: u32, tls: bool, dir: string } =
  k1/module-params(.{ backlog = 128, tls = false, dir = k1/module-dir() })

fn module(): k1/module {
  .0 | .{ setup-outputs = ["gen.k1"] }
}

fn setup(_ctx: k1/setup-ctx) {
  let text = "fn setup-backlog(): u32 { ${cfg.backlog} }\n"
  core/files/write-entire-file("${cfg.dir}/gen.k1", text).!
}
