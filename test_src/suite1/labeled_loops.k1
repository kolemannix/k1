ns labeled_loops

fn break-outer-from-for() {
  let count = 0
  let found-r = -1
  let found-c = -1
  for @rows r in 0.until(5) {
    for c in 0.until(5) {
      count = count + 1
      if r * c == 6 {
        found-r = r
        found-c = c
        break @rows
      }
    }
  }
  assert-equals(count, 14)
  assert-equals(found-r, 2)
  assert-equals(found-c, 3)
}

fn break-outer-with-value() {
  let x: int = loop @search {
    let i = 0
    loop {
      i = i + 1
      if i == 7 break @search i * 10
    }
  }
  assert-equals(x, 70)
}

fn continue-outer-from-while() {
  let i = 0
  let visits = 0
  while @outer i < 5 {
    i = i + 1
    let j = 0
    while j < 5 {
      j = j + 1
      if j == 2 continue @outer
      visits = visits + 1
    }
    visits = visits + 100
  }
  assert-equals(i, 5)
  assert-equals(visits, 5)
}

fn break-outer-runs-defers() {
  let log = list/empty[string]()
  loop @outer {
    defer log.push("outer")
    for i in 0.until(3) {
      defer log.push("d$i")
      if i == 1 break @outer
      log.push("b$i")
    }
  }
  assert-equals(log.join(","), "b0,d0,d1,outer")
}

fn inner-label-shadows() {
  let n = 0
  loop @l {
    loop @l {
      n = n + 1
      break @l
    }
    n = n + 10
    break
  }
  assert-equals(n, 11)
}

fn test() {
  break-outer-from-for()
  break-outer-with-value()
  continue-outer-from-while()
  break-outer-runs-defers()
  inner-label-shadows()
}
