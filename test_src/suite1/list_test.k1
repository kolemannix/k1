ns list_test

fn list-fill(): int {
  let xs = list/empty[int]()
  assert(xs.cap() == 0)
  assert(xs.len == 0)

  let i = 0
  while i < 5 {
    assert(xs.len == i)
    xs.push(i)
    i = i + 1
  }
  assert(xs.len == 5)
  assert(xs.first().! == 0)
  assert(xs.last().! == 4)

  let exp = [0,1,2,3,4]
  assert(xs == exp)

  let xs2 = xs.cloned()
  assert(xs2 == xs)

  let empty = []: list[byte]
  let empty-cloned = empty.cloned()
  assert(empty.len == empty-cloned.len)
  assert(empty.cloned() == empty)

  xs.remove(0)
  xs.remove(3)
  assert(xs == [1,2,3])

  0
}

fn list-slice() {
  let a = [1,2,3]
  assert(a.slice(0,2) == [1,2].as-span())
  assert(a.slice(0,3) == a.as-span())

  let empty-list = []: list[int]
  assert(empty-list.slice(0,0).len() == 0)
}

type point = {
  x: int,
  y: int,
  z: int,
}

fn list-of-structs(): int {
  let xs = [.{ x = 1, y = 2, z = 3}: point]
  let i = 0
  while i < 100 {
    xs.push(.{ x = 1, y = 2, z = 3})
    i = i + 1
  }

  assert(xs.len == 101)
  assert(xs.cap() == 128)

  0
}

fn list-equality(): int {
  let empty: list[int] = []
  assert(empty != [1])
  assert(empty == empty)
  assert([3] == [3])
  assert(["asdf", "2"] != ["asdf", "3"])
  0
}

// Begin sort stuff

impl show for { rank: int, payload: string } {
  fn show(self): string {
    let rank = self.rank
    let payload = self.payload
    "Payload: $payload (rank=$rank)"
  }
}

impl comparable for { rank: int, payload: string } {
  fn compare(self, other: self): ordering {
    self.rank.compare(other.rank)
  }
}

impl equals for { rank: int, payload: string } {
  fn equals(self, other: self): bool {
    self.rank == other.rank and self.payload == other.payload
  }
}

fn test-sort-int(input: list[int], expected: list[int]) {
  let sorted = input.sorted()
  assert(sorted == expected.as-span())
}

fn test-sort-other(input: list[{ rank: int, payload: string }], expected: list[{ rank: int, payload: string }]) {
  let sorted = input.sorted()
  assert(sorted == expected.as-span())
}

fn test-sort() {
  test-sort-int([], [])
  test-sort-int([0], [0])
  test-sort-int([5,4], [4,5])
  test-sort-int([5,3,1], [1,3,5])
  test-sort-other([
    .{ rank = 1, payload = "third" },
    .{ rank = 0, payload = "first" },
    .{ rank = 0, payload = "second" }
  ], [
    .{ rank = 0, payload = "first" },
    .{ rank = 0, payload = "second" },
    .{ rank = 1, payload = "third" }
  ])
}

type sort-rec = { key: int, ord: int }
impl comparable for sort-rec {
  fn compare(self: sort-rec, other: sort-rec): ordering { self.key.compare(other.key) }
}

fn assert-ascending(values: list[int]) {
  for i in 1.until(values.len()) {
    assert(values.get(i - 1) <= values.get(i))
  }
}

fn test-sort-shapes() {
  let n = 1000
  let ascending = list/empty[int]()
  let descending = list/empty[int]()
  let organ-pipe = list/empty[int]()
  let scattered = list/empty[int]()
  for i in 0.until(n) {
    ascending.push(i)
    descending.push(n - i)
    organ-pipe.push(if i < (n / 2) i else n - i)
    scattered.push((i * 2654435761) % 1000)
  }
  for shape in [ascending, descending, organ-pipe, scattered] {
    let values = shape
    values.sort()
    assert-equals(values.len(), n)
    assert-ascending(values)
  }
}

fn test-sort-stable() {
  let records = list/empty[sort-rec]()
  for i in 0.until(100) { records.push(.{ key = i % 7, ord = i }) }
  records.sort()
  for i in 1.until(records.len()) {
    let a = records.get(i - 1)
    let b = records.get(i)
    assert(a.key <= b.key)
    if a.key == b.key { assert(a.ord < b.ord) }
  }
}

fn test-filter-in-place() {
  let values: list[int] = [1, 2, 3, 4, 5, 6]
  values.filter-in-place(fn v. v % 2 == 0)
  assert-equals(values.show(), "[2,4,6]")

  values.filter-in-place(fn v. v > 100)
  assert(values.is-empty())

  let kept: list[int] = [1, 2, 3]
  kept.filter-in-place(fn v. v > 0)
  assert-equals(kept.show(), "[1,2,3]")

  values.push(9)
  assert-equals(values.show(), "[9]")
}

fn test-swap() {
  let a = [1,2]
  a.swap(0,1)
  assert(a == [2,1])
  a.swap(1,0)
  assert(a == [1,2])
  a.swap(1,1)
  assert(a == [1,2])
}

fn iterator(): int {
  let l = [1,2,3]
  let i = l.iterator()
  assert(i.size-hint().at-least == 3)
  assert(i.next().! == 1)
  assert(i.next().! == 2)
  assert(i.next().! == 3)
  assert(i.next().is-none())
  let i2 = l.iterator()
  assert(i2.nth(2) == :some 3)
  let i3 = l.iterator()
  assert(i3.nth(10) == :none)
  0
}

fn test() {
  list_test/list-of-structs()
  list_test/list-slice()
  list_test/list-fill()
  list_test/list-equality()
  list_test/test-sort()
  list_test/test-sort-shapes()
  list_test/test-sort-stable()
  list_test/test-filter-in-place()
  list_test/test-swap()
  list_test/iterator()
  assert([1,2,3].show() == "[1,2,3]")
}
