ns list_test

type sort-rec = { key: int, ord: int }
impl comparable for sort-rec {
  fn compare(self, other: sort-rec): ordering { self.key.compare(other.key) }
}

fn test() {
  let xs = list/empty[int]()
  assert(xs.cap() == 0)
  for i in 0.until(101) { xs.push(i) }
  assert(xs.cap() == 128)
  xs.remove(0)
  xs.remove(99)
  assert(xs.first() is :some 1)
  assert(xs.last() is :some 99)

  let n = 40
  let descending = list/empty[int]()
  let organ-pipe = list/empty[int]()
  let scattered = list/empty[int]()
  for i in 0.until(n) {
    descending.push(n - i)
    organ-pipe.push(if i < (n / 2) i else n - i)
    scattered.push((i * 2654435761) % 1000)
  }
  for shape in [descending, organ-pipe, scattered] {
    let values = shape
    values.sort()
    for i in 1.until(values.len()) {
      assert(values.[i - 1] <= values.[i])
    }
  }

  let records = list/empty[sort-rec]()
  for i in 0.until(50) { records.push(.{ key = i % 7, ord = i }) }
  records.sort()
  for i in 1.until(records.len()) {
    let a = records.[i - 1]
    let b = records.[i]
    assert(a.key <= b.key)
    if a.key == b.key { assert(a.ord < b.ord) }
  }

  let values: list[int] = [1, 2, 3, 4, 5, 6]
  values.filter-in-place(fn v. v % 2 == 0)
  assert-equals(values.show(), "[2,4,6]")
  values.filter-in-place(fn v. v > 100)
  assert(values.is-empty())
  values.push(9)
  assert-equals(values.show(), "[9]")

  let found: list[int] = [5, 8, 13]
  assert(found.find-index(fn v. v > 6) == :some 1)
  assert(found.find-index(fn v. v > 20) == :none)

  let a = [1,2]
  assert(a.pop() == :some 2)
  assert(a.pop() == :some 1)
  assert(a.pop() == :none)
}
