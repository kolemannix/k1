ns ability_constraint {

  ability num {
    fn num(self): i32
  }
  
  fn add[t](a: t, b: t): i32 where t: num, t: show {
    a.show()
    b.show()
    a.num() + b.num()
  }
  
  impl num for int {
    fn num(self): i32 { self.trunc() }
  }
  
  fn test() {
    assert(add(1, 2) == 3)
    .{}
  }

}
