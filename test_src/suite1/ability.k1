ns ability_01

ability codec {
  fn a-const(): u8
  fn write(self): span[u8]
  fn read(buffer: span[u8]): self
}

impl codec for string {
  fn a-const(): u8 { 10 }
  fn write(self): span[u8] {
    self.span().as-byte-span()
  }
  fn read(buffer: span[u8]): string {
    string/wrap-bytes(buffer)
  }
}

ability has-secret-int {
  fn secret(): int
}
ability has-secret-gen[a] {
  fn secret(): a
}

type foo = {}
type bar = {}

impl has-secret-gen[a = int] for foo {
  fn secret(): int { 10 }
}
impl has-secret-gen[a = int] for bar {
  fn secret(): int { 20 }
}
impl has-secret-int for foo {
  fn secret(): int { 30 }
}

impl remote/greet for u16 { fn greet(self: u16): string { "yo $self" } }

ability scaled { fn scaled(self, by: int): int }
impl scaled for int { fn scaled(self, factor: int): int { self * factor } }
fn scale-generic[t: scaled](x: t): int { scaled@(t)/scaled(self = x, by = 2) }

ns remote {
  ability greet { fn greet(self): string }
  impl greet for u8 { fn greet(self: u8): string { "hi $self" } }
}

fn greet-twice[t: remote/greet](x: t): string { "${x.greet()} ${x.greet()}" }

fn(test) codec-round-trip() {
  assert-equals[string]("asdf", codec/read("asdf".write()))
}

fn(test) qualified-call-picks-impl-by-self-type() {
  assert-equals(has-secret-gen[a = int]@(foo)/secret(), 10)
  assert-equals(has-secret-gen[a = int]@(bar)/secret(), 20)
  assert-equals(has-secret-int@(foo)/secret(), 30)
  assert(test-compile(iterable[item = u8]@(list[int])/iterator(list/empty[int]())) is :some _)
}

fn(test) generic-bound-on-nested-ns-ability() {
  assert-equals(greet-twice(7: u8), "hi 7 hi 7")
  assert-equals(greet-twice(8: u16), "yo 8 yo 8")
}

fn(test) named-args-use-ability-declaration() {
  assert-equals(scaled@(int)/scaled(self = 3, by = 2), 6)
  assert-equals(scale-generic(4), 8)
  assert(test-compile(scaled@(int)/scaled(self = 3, factor = 2)) is :some _)
}

fn(test) impl-of-reports-resolution() {
  #static {
    assert(types/id[int].impl-of[print]() is :some i and i.kind == :direct)
    assert(types/id[foo].impl-of[print]() is :some i and i.kind == :compiler)
    require types/id[list[int]].impl-of[iterable]() is :some found and found.kind == :blanket
      else crash("list iterable")
    assert-equals(found.args.[0].name, "item")
    assert-equals(found.args.[0].type-id, types/id[int])
    assert-equals(found.args.[1].name, "i")
    assert(types/id[*int].impl-of[add]() is :none)
    assert(types/id[foo].impl-of[has-secret-gen[a = int]]() is :some _)
    assert(types/id[foo].impl-of[has-secret-gen[a = bool]]() is :none)
    assert(types/id[list[int]].impl-of[iterable[item = int]]() is :some _)
    assert(types/id[list[int]].impl-of[iterable[item = u8]]() is :none)
    let scalable = 0
    for t in [types/id[int], types/id[string], types/id[foo]] {
      if t.impl-of[scaled]() is :some _ { scalable = scalable + 1 }
    }
    assert-equals(scalable, 1)
  }
}
