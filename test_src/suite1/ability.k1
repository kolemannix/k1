ns ability_01

ability codec {
  fn a-const(): u8
  fn write(self): span[u8]
  fn read(buffer: span[u8]): self
}

impl codec for string {
  fn a-const(): u8 { 10 }
  fn write(self): span[u8] {
    self.span().as-byte-span()
  }
  fn read(buffer: span[u8]): string {
    string/wrap-bytes(buffer)
  }
}

ability has-secret-int {
  fn secret(): int
}
ability has-secret-gen[a] {
  fn secret(): a
}

type foo = {}
type bar = {}

impl has-secret-gen[a = int] for foo {
  fn secret(): int { 10 }
}
impl has-secret-gen[a = int] for bar {
  fn secret(): int { 20 }
}
impl has-secret-int for foo {
  fn secret(): int { 30 }
}

impl remote/greet for u16 { fn greet(self: u16): string { "yo $self" } }

ns remote {
  ability greet { fn greet(self): string }
  impl greet for u8 { fn greet(self: u8): string { "hi $self" } }
}

fn greet-twice[t: remote/greet](x: t): string { "${x.greet()} ${x.greet()}" }

fn(test) codec-round-trip() {
  assert-equals[string]("asdf", codec/read("asdf".write()))
}

fn(test) qualified-call-picks-impl-by-self-type() {
  assert-equals(has-secret-gen[a = int]@(foo)/secret(), 10)
  assert-equals(has-secret-gen[a = int]@(bar)/secret(), 20)
  assert-equals(has-secret-int@(foo)/secret(), 30)
}

fn(test) generic-bound-on-nested-ns-ability() {
  assert-equals(greet-twice(7: u8), "hi 7 hi 7")
  assert-equals(greet-twice(8: u16), "yo 8 yo 8")
}
