ns lambdas

fn static-add-one(x: int): int { x + 1 }
fn static-add-two(x: int): int { x + 2 }

fn some-fn-param1(i: int, f: some fn int -> int): int {
  f(i)
}

fn some-fn-param2(i: int, f: some fn int -> int, g: some fn int -> int): int {
  f(i) + g(i)
}

fn some-fn-param-gen[t](t: t, f: some fn t -> t, g: some fn t -> ?t): ?t {
  t || f || g
}

fn takes-string(s: string): int { s.len() }

fn forward-generic[t](t: t, f: some fn t -> t): t { some-fn-param-gen(t, f, fn x. some(x)).! }

fn count-where[t](xs: list[t], f: some fn t -> bool): int {
  let n = 0
  for x in xs { if f(x) { n = n + 1 } }
  n
}

fn forward-twice[t](xs: list[t], f: some fn t -> bool): int {
  count-where(xs, f) + count-where(xs, f)
}

type agg-arg = { a: u64, b: u64, c: u64, d: u64, e: u64 }
type agg-svc = { x: u64, y: u64 }
type agg-holder = { call: dyn[fn(agg-arg, *agg-svc) -> u64], svc: *agg-svc }

fn sum-agg(req: agg-arg, s: *agg-svc): u64 { req.a + req.e + s.x + s.y }

fn forward-agg(inner: dyn[fn(agg-arg, *agg-svc) -> u64]): dyn[fn(agg-arg, *agg-svc) -> u64] {
  (fn[inner](req: agg-arg, s: *agg-svc) inner(req, s)).to-dyn()
}

fn make-adder(n: int): dyn[fn(int) -> int] {
  (fn[n](x: int) x + n).to-dyn()
}

fn make-thunks(counter: *int): list[dyn[fn() -> empty]] {
  [
    (fn[counter]. { counter.* = counter.* + 1 }).to-dyn(),
    (fn[counter]. { counter.* = counter.* + 10 }).to-dyn(),
  ]
}

fn(test) closure-with-nested-lambda() {
  let closed-over: int = 3
  let add = fn[closed-over](x: int) {
    let add-one = fn(y: int) y + 1
    add-one(x) + closed-over + add-one(closed-over) + (if closed-over == 3 1 else 0)
  }
  assert-equals(add(3), 12)
}

fn(test) capture-pointer-mutates-local() {
  let counter = 3
  let my-inc = fn[counter.&]() { counter.* = counter.* + 1 }
  my-inc()
  my-inc()
  assert(counter == 5)
}

fn(test) nested-closures-capture() {
  let a = 10
  let outer = fn[a](x: int) {
    let inner = fn[a](y: int) a + y
    inner(x) + a
  }
  assert-equals(outer(5), 25)
}

fn(test) capture-snapshots-value() {
  let n = 1
  let get-n = fn[n]. n
  n = 2
  assert-equals(get-n(), 1)
}

fn(test) lambda-return-type() {
  let get-three = fn(-> int) { return 3 }
  assert(get-three() == 3)
}

fn(test) some-fn-params() {
  let static-add-one-var = static-add-one
  assert-equals(some-fn-param2(5, static-add-one, static-add-one-var), 12)
  assert-equals(some-fn-param2(5, static-add-one.&, static-add-two.&), 13)
  assert-equals(forward-generic(4, static-add-one), 5)
  assert-equals(forward-generic(true, fn b. not b), false)
  assert-equals(forward-twice([1, 2, 3, 4], fn x. x % 2 == 0), 4)
  assert(test-compile( some-fn-param1(4, takes-string) ) is :some _)
  assert-equals(some-fn-param1(5, static-add-one.to-dyn()), 6)
  let c1 = .{ x = 3 }
  let c2 = 2
  assert-equals(some-fn-param2(5, fn[c1] x. x + 1 + c1.x, fn[c2] x. x + 2 + c2), 18)
  assert(some-fn-param-gen(true, fn b. not b, fn b. some(b)) == some(false))
}

fn(test) returned-dyn-closures() {
  let add5 = make-adder(5)
  let add7 = make-adder(7)
  assert-equals(add5(1), 6)
  assert-equals(add7(1), 8)

  let count = 0
  for thunk in make-thunks(count.&) { thunk() }
  assert-equals(count, 11)
}

fn(test) dyn-aggregate-args() {
  let svc: agg-svc = .{ x = 3, y = 4 }
  let s = svc.&
  let req: agg-arg = .{ a = 1, b = 0, c = 0, d = 0, e = 2 }
  let named = sum-agg.to-dyn()
  assert-equals(named(req, s), 10)
  let k: u64 = 100
  let closure = fn[k](req: agg-arg, s: *agg-svc) req.a + req.e + s.x + s.y + k
  assert-equals(closure.to-dyn()(req, s), 110)
  let holder: agg-holder = .{ call = named, svc = s }
  assert-equals((holder.call)(req, holder.svc), 10)
  assert-equals(forward-agg(named)(req, s), 10)
}

fn(test) comptime-closures() {
  let r: int = #static { let a = 40; let f = fn[a](x: int) x + a; f(2) }
  assert-equals(r, 42)
  #static assert(test-compile(
    { let outer = #static { let b = 2; fn[b]. b }; outer() }
  ).is-some())
  #static assert(test-compile(
    { let a = 1; let f = fn. a; f() }
  ).is-some())
}
