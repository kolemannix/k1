ns as_buffer

use core/fixlist
use core/spill-list

type color = either { red, green }

fn sum-via-buffer[c: as-buffer[t = i64]](x: c): i64 {
  let acc: i64 = 0
  for x.as-buffer() { acc = acc + it }
  acc
}

fn sum-via-span[c: as-span[t = i64]](x: c): i64 {
  x.as-span().sum()
}

fn test() {
  let xs: list[i64] = [1, 2, 3]
  assert-equals(xs.as-buffer().len, 3)
  assert-equals(sum-via-buffer(xs), 6)
  assert-equals(sum-via-span(xs), 6)
  assert-equals(xs.as-span().len(), 3)

  let buf: buffer[i64] = [4, 5]
  assert-equals(sum-via-buffer(buf), 9)
  assert-equals(buf.as-span().len(), 2)

  let arr: array[i64, 3] = [7, 8, 9]
  assert-equals(sum-via-buffer(arr.&), 24)
  assert-equals(arr.&.as-span().len(), 3)
  arr.&.as-buffer().[0] = 10
  assert-equals(arr.[0], 10)

  let fl = fixlist/uninit[i64, 8]()
  fl.push(1)
  fl.push(2)
  assert-equals(sum-via-buffer(fl.&), 3)
  assert-equals(fl.&.as-span().len(), 2)

  let sl = spill-list/new[i64, 2]()
  sl.push(5)
  sl.push(6)
  sl.push(7)
  assert-equals(sum-via-buffer(sl.&), 18)
  assert-equals(sl.&.as-span().len(), 3)

  let parts: list[string] = ["a", "bc", "d"]
  assert-equals(string/join(parts, "-"), "a-bc-d")
  assert-equals(string/join(parts.as-span(), ""), "abcd")
  assert-equals(string/join(list/empty[string](), "-"), "")

  let ms: list[i64] = [3, 1, 2]
  assert-equals(ms.[1], 1)
  assert-equals(ms.first(), some(3))
  assert-equals(ms.last(), some(2))
  assert-equals(ms.index-opt(9), none())
  assert(ms.take(2) == [3, 1].as-span())
  assert(ms.drop(1) == [1, 2].as-span())
  assert(ms.take-right(1) == [2].as-span())
  assert(ms.drop-right(1) == [3, 1].as-span())
  assert(ms.slice(1, 99) == [1, 2].as-span())
  assert(ms.sorted() == [1, 2, 3].as-span())
  assert(ms.starts-with([3, 1].as-span()))
  assert(ms.ends-with([1, 2].as-span()))
  assert(not ms.starts-with([1].as-span()))
  ms.[0] = 9
  ms.swap(0, 2)
  assert(ms.as-span() == [2, 1, 9].as-span())
  ms.reverse()
  assert(ms.as-span() == [9, 1, 2].as-span())
  ms.sort()
  assert(ms.as-span() == [1, 2, 9].as-span())
  ms.fill(7)
  assert(ms.as-span() == [7, 7, 7].as-span())

  let cs: list[color] = list/filled(2, :red)
  cs.[1] = :green
  assert(cs.[1] == :green)

  let mf = fixlist/uninit[i64, 4]()
  mf.push(4)
  mf.push(3)
  assert-equals(mf.&.[0], 4)
  assert-equals(mf.&.last(), some(3))
  mf.&.sort()
  assert(mf.&.as-span() == [3, 4].as-span())
  mf.&.fill(0)
  assert(mf.&.as-span() == [0, 0].as-span())

  let st = "hello"
  assert-equals(st.len(), 5)
  assert-equals(st.[1], 'e')
  assert-equals(st.first(), some('h'))
  assert-equals(st.last(), some('o'))
  assert(st.non-empty())
  assert(st.as-span() == "hello".span())
  assert-equals(st.take(2), "he")

  let rs: list[i64] = [1, 2, 3]
  rs.[1] = 20
  assert-equals(rs.[1], 20)
  assert-equals(rs.first-ref().!.*, 1)
  assert-equals(rs.last-ref().!.*, 3)
  for r in rs.ref-iter() { r.* = r.* * 2 }
  assert(rs.as-span() == [2, 40, 6].as-span())

  let rf = fixlist/uninit[i64, 4]()
  rf.push(5)
  rf.push(6)
  rf.[0] = 50
  for r in rf.&.ref-iter() { r.* = r.* + 1 }
  assert(rf.&.as-span() == [51, 7].as-span())

  let rl = spill-list/new[i64, 2]()
  rl.push(8)
  rl.push(9)
  rl.&.last-ref().!.* = 90
  assert(rl.&.as-span() == [8, 90].as-span())

  let ra: array[i64, 2] = [11, 12]
  ra.[1] = 120
  assert(ra.&.as-span() == [11, 120].as-span())

  let bytes: list[u8] = [1: u8, 2: u8, 3: u8, 4: u8]
  assert(bytes.position(3: u8) is :some 2)
  assert(bytes.contains(4: u8))
  assert(not bytes.as-span().contains(9: u8))
  assert(bytes.as-span().index-of-span([2: u8, 3: u8].as-span()) is :some 1)
  assert(not bytes.as-span().contains-span([3: u8, 5: u8].as-span()))

  let wide: list[i64] = [10, 20, 30, 40]
  assert(wide.position(30) is :some 2)
  assert(wide.as-span().index-of-span([20, 30].as-span()) is :some 1)
  assert(wide.as-span().index-of-span([20, 40].as-span()) is :none)
  assert(wide.as-span().index-of-span(span/empty[i64]()) is :some 0)
  assert(wide.as-span().first-diff([10, 20, 99].as-span()) is :some 2)
  assert(wide.as-span().first-diff([10, 20].as-span()) is :some 2)
  assert(wide.as-span().first-diff(wide.as-span()) is :none)
  assert("abcd".as-span().first-diff("abxd".as-span()) is :some 2)

  let wf = fixlist/uninit[i64, 4]()
  wf.push(10)
  wf.push(20)
  assert(wf.&.first-diff(wide.as-span()) is :some 2)
  assert(wf.&.position(20) is :some 1)

  let s1: span[i64] = [1, 2].as-span()
  let s2: span[i64] = [3].as-span()
  let sep: span[i64] = [0].as-span()
  let joined = span/join([s1, s2], sep)
  assert-equals(joined.len(), 4)
  assert-equals(joined.[0], 1)
  assert-equals(joined.[2], 0)
  assert-equals(joined.[3], 3)
  assert-equals(span/join(list/empty[span[i64]](), sep).len(), 0)
}
