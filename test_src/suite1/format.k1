ns format-test

fn test() {
  let world = "Budapest"
  let get-world = fn[world]. world

  // string-builder implements `writer`
  let w = string-builder/new()

  // If you have a buffer already, or any writer at all, you can 'write' to it formatted
  w.write("hello $world -- ")
  w.write("hello $world ${}", 42)
  assert-equals(w.build(), "hello Budapest -- hello Budapest 42")
  assert-equals("true", "${}".fmt(true))
  assert-equals("-3.14", "${}".fmt(-3.14))
  assert-equals("-3", "${}".fmt(-3i8))

  assert(test-compile("${}".fmt(1, 1)).is-some())
  assert(test-compile("$missing".fmt(.{x =1})).is-some())
  // this works now because { nested: "asdf" } implements print. hah!
  assert(test-compile("$x".fmt(.{x = .{ nested = "asdf" }})).is-none())

  // Or take a string with holes and _format_ it with these values
  let s = "hello ${get-world()} ${yyyy}-${mm}-$dd".fmt(.{yyyy =2021,mm =10,dd =3})
  assert-equals(s, "hello Budapest 2021-10-3")

  bases()
  floats()
  specs()
}

fn to-base(value: u64, base: u64): string {
  let w = string-builder/new()
  core/format-uint(context w.&)(value, base)
  w.build()
}

fn bases() {
  assert-equals(to-base(0, 2), "0")
  assert-equals(to-base(5, 2), "101")
  assert-equals(to-base(1048576, 2), "100000000000000000000")
  assert-equals(to-base(u64/max-value, 2).len(), 64)
  assert-equals(to-base(0xDEADBEEF, 16), "deadbeef")
  assert-equals(to-base(u64/max-value, 16), "ffffffffffffffff")
  assert-equals(to-base(u64/max-value, 10), "18446744073709551615")
  assert-equals(to-base(7, 10), "7")
  assert-equals(to-base(0, 10), "0")
  assert-equals(to-base(42, 10), "42")
  assert-equals(to-base(100, 10), "100")
  assert-equals(to-base(1000, 10), "1000")
  assert-equals(to-base(10001, 10), "10001")
  assert-equals(u8/to-ascii-digit(0), '0')
  assert-equals(u8/to-ascii-digit(9), '9')
  assert-equals(u8/to-ascii-digit(10), 'a')
  assert-equals(u8/to-ascii-digit(35), 'z')
  assert-equals(u8/to-ascii-digit(36), 'A')
  assert-equals(u8/to-ascii-digit(61), 'Z')
}

fn floats() {
  assert-equals("${0.0: f64}", "0.0")
  assert-equals("${-0.0: f64}", "-0.0")
  assert-equals("${1.0: f64}", "1.0")
  assert-equals("${100.0: f64}", "100.0")
  assert-equals("${0.1: f64}", "0.1")
  assert-equals("${123456.789: f64}", "123456.789")
  assert-equals("${1.0 / 3.0}", "0.3333333333333333")
  assert-equals("${0.0001: f64}", "0.0001")
  assert-equals("${0.00001: f64}", "1.0e-5")
  assert-equals("${1.0e15}", "1000000000000000.0")
  assert-equals("${1.0e16}", "1.0e16")
  assert-equals("${1.0e300}", "1.0e300")
  assert-equals("${-2.5e-10}", "-2.5e-10")
  assert-equals("${5.0e-324}", "5.0e-324")
  assert-equals("${1.7976931348623157e308}", "1.7976931348623157e308")
  assert-equals("${f64/nan}", "nan")
  assert-equals("${f64/inf}", "inf")
  assert-equals("${f64/neg-inf}", "-inf")

  assert-equals("${0.1: f32}", "0.1")
  assert-equals("${(0.1: f32).widen[f64]}", "0.10000000149011612")
  assert-equals("${3.14: f32}", "3.14")
  assert-equals("${(1.0: f32) / 3.0}", "0.33333334")
  assert-equals("${3.0e38: f32}", "3.0e38")
  assert-equals("${1.0e-45: f32}", "1.0e-45")
  assert-equals("${f32/nan}", "nan")
  assert-equals("${f32/neg-inf}", "-inf")

  assert-equals(places(2.675, 2), "2.67")
  assert-equals(places(2.5, 0), "2")
  assert-equals(places(1.0e300, 1).len(), 303)
  assert-equals(places(-0.0, 3), "-0.000")
  assert-equals(places(f64/inf, 1), "inf")
  assert-equals(places32(3.14159, 3), "3.142")
  assert-equals(places32(0.1, 20), "0.10000000149011611938")
}

fn places(f: f64, places: i32): string {
  let w = string-builder/new()
  f64/format(f, w.&, places)
  w.build()
}

fn places32(f: f32, places: i32): string {
  let w = string-builder/new()
  f32/format(f, w.&, places)
  w.build()
}

fn specs() {
  let f = 3.14159
  let n: i32 = -42
  let s = "héllo"
  assert-equals("${f:.2}", "3.14")
  assert-equals("${f:.0}", "3")
  assert-equals("${(1.5: f32):.3}", "1.500")
  assert-equals("${f:8.3}", "   3.142")
  assert-equals("${f:<8.1}|", "3.1     |")
  assert-equals("${f:09.3}", "00003.142")
  assert-equals("${n:6}", "   -42")
  assert-equals("${n:<6}", "-42   ")
  assert-equals("${n:^7}", "  -42  ")
  assert-equals("${n:^6}", " -42  ")
  assert-equals("${n:06}", "-00042")
  assert-equals("${42:0<5}", "42000")
  assert-equals("${7:x>3}", "xx7")
  assert-equals("${12345:3}", "12345")
  assert-equals("${true:6}|", "true  |")
  assert-equals("${true:>6}", "  true")
  assert-equals("${s:8}|", "héllo   |")
  assert-equals("${s:>8}", "   héllo")
  assert-equals("${s:*^9}", "**héllo**")
  assert-equals("${s:.2}", "hé")
  assert-equals("${s:.9}", "héllo")
  assert-equals("${s:·>8.3}", "·····hél")
  assert-equals("${f: f64}", "3.14159")
  assert-equals("${:>6}|${:.1}".fmt(.{ a = 12, b = 2.25 }), "    12|2.2")
  let long = "0123456789012345678901234567890123456789012345678901234567890123456789"
  assert-equals("${long:>71}", " $long")

  let w = string-builder/new()
  w.write("[${:<4}]", 7)
  assert-equals(w.build(), "[7   ]")

  assert-equals("${1234567:,}", "1,234,567")
  assert-equals("${-1234567:,}", "-1,234,567")
  assert-equals("${999:,}", "999")
  assert-equals("${1000:,}", "1,000")
  assert-equals("${-100000:,}", "-100,000")
  assert-equals("${0:,}", "0")
  assert-equals("${1234567:12,}", "   1,234,567")
  assert-equals("${1234567:*<12,}", "1,234,567***")
  assert-equals("${1234567.891:,.2}", "1,234,567.89")
  assert-equals("${u64/max-value:,}", "18,446,744,073,709,551,615")
  assert-equals("${:,}".fmt(4096), "4,096")
  assert-equals(0o755, 493)
  assert-equals(0o0, 0)
  assert-equals(0o7_7u8, 63)

  assert(test-compile("${n:.2}").is-some())
  assert(test-compile("${s:,}").is-some())
}
