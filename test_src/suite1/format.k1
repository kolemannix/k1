ns format-test

fn test() {
  let world = "Budapest"
  let get-world = fn[world]. world

  // string-builder implements `writer`
  let w = string-builder/new()

  // If you have a buffer already, or any writer at all, you can 'write' to it formatted
  w.write("hello $world -- ")
  w.write("hello $world ${}", 42)
  assert-equals(w.build-tmp(), "hello Budapest -- hello Budapest 42")
  assert-equals("true", "${}".fmt(true))
  assert-equals("-3.140000", "${}".fmt(-3.14))
  assert-equals("-3", "${}".fmt(-3i8))

  assert(test-compile("${}".fmt(1, 1)).is-some())
  assert(test-compile("$missing".fmt(.{x =1})).is-some())
  // this works now because { nested: "asdf" } implements print. hah!
  assert(test-compile("$x".fmt(.{x = .{ nested = "asdf" }})).is-none())

  // Or take a string with holes and _format_ it with these values
  let s = "hello ${get-world()} ${yyyy}-${mm}-$dd".fmt(.{yyyy =2021,mm =10,dd =3})
  assert-equals(s, "hello Budapest 2021-10-3")

  bases()
  wide-floats()
}

fn to-base(value: u64, base: u64): string {
  let w = string-builder/new()
  core/format-uint(context w.&)(value, base)
  w.build()
}

fn bases() {
  assert-equals(to-base(0, 2), "0")
  assert-equals(to-base(5, 2), "101")
  assert-equals(to-base(1048576, 2), "100000000000000000000")
  assert-equals(to-base(u64/max-value, 2).len(), 64)
  assert-equals(to-base(0xDEADBEEF, 16), "deadbeef")
  assert-equals(to-base(u64/max-value, 16), "ffffffffffffffff")
  assert-equals(to-base(u64/max-value, 10), "18446744073709551615")
}

fn wide-floats() {
  let big: f64 = 1.0e300
  let text = "$big"
  assert-equals(text.len(), 308)
  assert(text.starts-with("1"))
  assert(text.ends-with(".000000"))

  let wide: f32 = 3.0e38
  assert-equals("$wide".len(), 46)
}
