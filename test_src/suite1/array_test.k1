ns array_test

let(mutable) INDEX_EVALS: int = 0

fn next-index(i: int): int {
  INDEX_EVALS = INDEX_EVALS + 1
  i
}

type packed-holder = packed { tag: u8, values: array[u16, 3] }

fn takes-three(a: array[int, 3]) {
  assert-equals(a.[0] + a.[1] + a.[2], 6)
}

fn mk-arr(): array[int, 3] { [7, 8, 9] }

fn at-three(a: array[int, 3], i: int): int { a.[i] }

fn test() {
  let list: list[u8] = list/filled-in(mem/tmp(), size = 10, value = 3)
  let a: *array[u8, 10] = list/to-array(list, 10)
  a.[4] = 1
  for a {
    assert-equals(it, if it-index == 4 1 else 3)
  }

  takes-three([1, 2, 3])
  assert(test-compile(takes-three([1, 2])) is :some _)

  INDEX_EVALS = 0
  let arr: array[int, 4] = [10, 20, 30, 40]
  assert-equals(arr.[next-index(1)], 20)
  arr.[next-index(2)] = 33
  let p = arr.[next-index(3)].&
  p.* = 44
  let ph: packed-holder = .{ tag = 1, values = [1, 2, 3] }
  ph.values.[next-index(1)] = 22
  assert-equals(mk-arr().[next-index(2)], 9)
  assert-equals(at-three(mk-arr(), next-index(0)), 7)
  assert-equals(INDEX_EVALS, 6)
  assert-equals(arr.[2] + arr.[3], 77)
  assert-equals(ph.values.[1], 22)
  assert(test-compile(arr.[4]).is-some())
  assert(test-compile(arr.[-1]).is-some())

  let values: array[int, 3] = [1, 2, 3]
  let holder = .{ items = values, name = "grid" }
  assert-equals("$holder", ".{ items = [1,2,3], name = grid }")
}
