ns continue_test

fn continue-loop(): int {
  let j: int = 0
  let count: int = 0
  let result = loop {
    j = j + 1
    if j > 10 break(j)
    if j % 3 != 0 continue
    count = count + 1
  }
  assert-equals(result, 11)
  count
}

fn continue-nested(): int {
  let hits: int = 0
  for x in [1, 2, 3] {
    for y in [1, 2, 3] {
      if y != x continue
      hits = hits + 1
    }
    if x == 2 continue
    hits = hits + 10
  }
  hits
}

fn continue-defers(): int {
  let defer-count: int = 0
  for x in [1, 2, 3] {
    defer { defer-count = defer-count + 1 }
    if x == 2 continue
  }
  defer-count
}

fn continue-index(): int {
  let index-sum: int = 0
  for x in [1, 2, 3, 4, 5, 6] {
    if x % 2 == 1 continue
    index-sum = index-sum + it-index
  }
  index-sum
}

fn(test) continue-in-loop-with-break-value() {
  let static-loop: int = #static continue-loop()
  assert-equals(static-loop, 3)
  assert-equals(continue-loop(), 3)
}

fn(test) continue-in-nested-for() {
  assert-equals(continue-nested(), 23)
}

fn(test) continue-runs-defers() {
  assert-equals(continue-defers(), 3)
}

fn(test) continue-keeps-it-index() {
  assert-equals(continue-index(), 9)
  let static-index: int = #static continue-index()
  assert-equals(static-index, 9)
}
