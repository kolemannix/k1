ns static_literals

let fifteen: int = 15

fn join[i: static int](x: i, c: bool): int {
  let v = if c x else 9
  let m = if c is { true -> x, false -> 9 }
  let l = [x, 4]
  v + m + l.len
}

fn(test) literal-types-as-values() {
  let _hello2: "hello!" = #static {
    let bytes = [104u8]
    bytes.push(101)
    bytes.push(108)
    bytes.push(108)
    bytes.push(111)
    bytes.push(33)
    string/wrap-bytes(bytes.as-span())
  }

  let three: static int = 3
  let e = true
  assert-equals(if e three else 9, 3)
  assert-equals([three, 4].len, 2)
  assert-equals(join[3](3, true), 8)
  assert-equals(join[3](3, false), 20)

  assert-equals(types/name[fifteen], "static[i64, 15]")
  assert(types/id[fifteen].schema() is :int)
  assert(types/id[fifteen] != types/id[int])

  let x: fifteen = 15
  assert-equals("${_hello2}-$x-${three}", "hello!-15-3")
}
