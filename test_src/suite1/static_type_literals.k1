ns static_literals

fn join[i: static int](x: i, c: bool): int {
  let v = if c x else 9
  let m = if c is { true -> x, false -> 9 }
  let l = [x, 4]
  v + m + l.len
}

fn test() {
  assert-equals[?string](test-compile(1: 5), :some "Expression did not conform to hint: Static lift resulted in wrong value: Different static values of same type family: 5 vs 1")
  let _c: 'c' = 'c'
  let _pi: 3.14 = 3.14
  let _hello: "hello" = "hello"

  let _hello2: "hello!" = #static {
    let bytes = [104u8]
    bytes.push(101)
    bytes.push(108)
    bytes.push(108)
    bytes.push(111)
    bytes.push(33)
    string/wrap-bytes(bytes.as-span())
  }

  let three: static int = 3
  let e = true
  assert-equals(if e three else 9, 3)
  assert-equals(if e is { true -> three, false -> 9 }, 3)
  assert-equals([three, 4].len, 2)
  assert-equals(join[3](3, true), 8)
  assert-equals(join[3](3, false), 20)

  .{}
}
