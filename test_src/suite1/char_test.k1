ns char_test

fn basic() {
  let c: char = '!'
  assert(c == '!')
  let s = c.to-string()
  assert(s.len() == 1)
  assert(s.get(0) == '!')

  assert(s.concat-char('!') == "!!")
}

fn escape() {

  let c = '\n'
  assert(c.u8() == 10)

  let c = '\0'
  assert(c.u8() == 0)

  let c = '\t'
  assert(c.u8() == 9)

  let c = '\r'
  assert(c.u8() == 13)

  let c = '\''
  assert(c.u8() == 39)

  let c = '"'
  assert(c.u8() == 34)

  let c = '\\'
  assert(c.u8() == 92)

  .{}
}

fn test() {
  basic()
  escape()
}
