fn(test) float-casts-and-special-values() {
  assert-equals(-10.1.as[i32], -10)
  assert-equals((-100.0: f32).as[i8], -100)
  assert-equals((300.0: f32).as[u8], 255)
  assert-equals((-5.0: f32).as[u8], 0)
  assert-equals((-300.0: f32).as[i8], -128)
  assert-equals((70000.5: f64).as[u16], 65535)
  assert-equals((10000000000.0: f32).as[u32], 4294967295)
  assert-equals((10000000000.0: f32).as[i32], 2147483647)

  let f32-zero: f32 = 0.0
  assert-equals((f32-zero / f32-zero).as[u8], 0)
  assert-equals((f32-zero / f32-zero).as[i32], 0)
  assert-equals(((1.0: f32) / f32-zero).as[u8], 255)
  assert-equals(((1.0: f32) / f32-zero).negated().as[i8], -128)

  let ct-over-u8: u8 = #static { (300.0: f32).as[u8] }
  let ct-under-i8: i8 = #static { (-300.0: f32).as[i8] }
  let ct-over-u32: u32 = #static { (10000000000.0: f32).as[u32] }
  assert-equals(ct-over-u8, 255)
  assert-equals(ct-under-i8, -128)
  assert-equals(ct-over-u32, 4294967295)

  assert(5.0 % 2.0 == 1.0)
  assert(1.0 / 0.0.negated() < 0.0)

  assert(not (f64/nan == f64/nan))
  assert(not (f32/nan == f32/nan))
  assert((not (f64/nan < 0.0)) and (not (f64/nan > 0.0)))
  assert-equals(mem/bitcast[f64, u64](f64/nan), 0x7FF8000000000000)
  assert-equals(mem/bitcast[f32, u32](f32/nan), 0x7FC00000)

  let static-nan: f64 = #static f64/nan
  assert(not (static-nan == static-nan))

  assert(1.0e-400 == 0.0)
  assert((1.0e-50: f32) == 0.0)
  assert(1.0e400 == f64/inf)
  assert((1.0e40: f32) == f32/inf)
  assert((16777217.0: f32) == 16777216.0)
  assert(9007199254740993.0 == 9007199254740992.0)

  assert-equals(mem/bitcast[f64, u64]((-0.0).abs()), 0)
  assert-equals(mem/bitcast[f32, u32]((-0.0: f32).abs()), 0)
  let static-abs: f32 = #static { (-7.25: f32).abs() }
  assert-equals(static-abs, 7.25)

  assert-equals(f64/nan.min(1.0), 1.0)
  assert(1.0.min(f64/nan) != 1.0.min(f64/nan))

  if 42.0 is {
    41.0 -> crash("should not equal"),
    42.0 -> .{},
    f -> crash("should not fall through")
  }
}

fn(test) float-constant-bits() {
  assert-equals(mem/bitcast[f64, u64](0.1), 0x3fb999999999999a)
  assert-equals(mem/bitcast[f32, u32](0.1: f32), 0x3dcccccd)
  assert-equals(mem/bitcast[f64, u64](-0.0), 0x8000000000000000)
  assert-equals(mem/bitcast[f32, u32](-0.0: f32), 0x80000000)
  assert-equals(mem/bitcast[f64, u64](5.0e-324), 1)
  assert-equals(mem/bitcast[f32, u32](1.0e-45), 1)
  let small: f64 = #static mem/bitcast[u64, f64](0x36a0000000000000)
  assert-equals(mem/bitcast[f64, u64](small), 0x36a0000000000000)
  let nan32: f32 = #static mem/bitcast[u32, f32](0xff812345)
  let nan64: f64 = #static mem/bitcast[u64, f64](0xfff0123456789abc)
  assert-equals(mem/bitcast[f32, u32](nan32), 0xff812345)
  assert-equals(mem/bitcast[f64, u64](nan64), 0xfff0123456789abc)
}
