ns iterator_tests

fn test() {

  let nums = [1,2,3,4]
  let first-even = nums.find(fn(x) x % 2 == 0)
  assert-equals(first-even, some(2))

  let index-of-three = nums.position(3)
  assert-equals(index-of-three, some(2))

  let odds = [1,2,3,5,7,9,11]
  assert(not odds.exists(fn(t) t == 0))
  assert(odds.exists(fn(t) t == 2))
  assert(odds.contains(7))
  assert(not odds.contains(4))

  let odd-only = [1,3,5,7,9,11]
  assert(odd-only.forall(fn(t) t % 2 == 1))

  assert(odd-only.sum() == 36)

  let counted = 1.until(4).to-list()
  assert-equals(counted.len, 3)
  assert-equals(counted.[0], 1)
  assert-equals(counted.[2], 3)

  .{}
}
