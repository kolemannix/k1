fn(test) string-escape-codes() {
  let s = "\n\0\t\r\"\\"
  let codes = list/from-mapping(s, fn c. c.u8())
  assert(codes == [10, 0, 9, 13, 34, 92])
  assert('\''.u8() == 39)
}

fn(test) string-char-and-substring-search() {
  let s37 = "abcdefghijklmnopqrstuvwxyz0123456789!"
  assert(s37.position('p') is :some 15)
  assert(s37.position('q') is :some 16)
  assert(s37.position('5') is :some 31)
  assert(s37.position('6') is :some 32)
  assert(s37.position('!') is :some 36)
  assert(s37.position('#') is :none)
  assert(s37.drop(1).position('q') is :some 15)
  assert(s37.take(16).position('q') is :none)
  assert(s37.index-of-string("pqr") is :some 15)
  assert(s37.index-of-string("789!") is :some 33)
  assert(s37.index-of-string("89!x") is :none)
  assert(s37.index-of-string(s37) is :some 0)
  assert(s37.index-of-string("!#") is :none)
  let reps = "aXa aYa aZa aQa aWa aEa aRa aTa"
  assert(reps.index-of-string("aQa") is :some 12)
  assert(reps.index-of-string("aBa") is :none)
  assert("hello".index-of-string("") is :some 0)
  assert("a: b: c".split-once(": ") is .{ before = "a", after = :some "b: c" })
  assert("a=b".split-once(":") is .{ before = "a=b", after = :none })
  assert("  12ab".drop-while(fn c. c == ' ').take-while(fn c. c.is-ascii-digit()) == "12")
  assert("  ".drop-while(fn c. c == ' ') == "" and "ab".take-while(fn c. c == 'a') == "a")
}

fn(test) hex-encode-and-decode() {
  let hex-bytes: list[u8] = [0, 255, 65, 122]
  assert(hex-bytes.as-span().to-hex() == "00ff417a")
  assert("Az".to-hex() == "417a")
  let hex-sb = string-builder/new()
  hex-bytes.as-span().write-hex(hex-sb.&, upper = true)
  assert-equals("${hex-sb.peek()}", "00FF417A")
  assert(hex-sb.build() == "00FF417A")
  assert(span/from-hex("00FF417a").! == hex-bytes.as-span())
  assert(span/from-hex("").! == span/empty())
  assert(span/from-hex("0") is :none)
  assert(span/from-hex("0g") is :none)
  assert(span/from-hex("g0") is :none)
  let long = buffer/allocate[u8](5000)
  for i in (0: size).until(long.len()) { long.[i] = (i * 7).low[u8] }
  let long-sb = string-builder/new()
  span/wrap-buffer(long).write-hex(long-sb.&, upper = false)
  assert(span/from-hex(long-sb.build()).! == span/wrap-buffer(long))
}

fn(test) base64-encode-and-decode() {
  assert-equals("f".span-bytes().to-base64(), "Zg==")
  assert-equals("fo".span-bytes().to-base64(), "Zm8=")
  assert-equals("foobar".span-bytes().to-base64(), "Zm9vYmFy")
  assert-equals("fo".span-bytes().to-base64url(), "Zm8")
  let high-bytes: list[u8] = [251, 255, 190]
  assert-equals(high-bytes.as-span().to-base64(), "+/++")
  assert-equals(high-bytes.as-span().to-base64url(), "-_--")

  let bytes = buffer/allocate[u8](4000)
  for i in (0: size).until(4000) { bytes.[i] = (i * 7).low[u8] }
  let all = span/wrap-buffer(bytes)
  for n in (0: size).until(259) {
    let prefix = all.take(n)
    assert(span/from-base64(prefix.to-base64()).! == prefix)
    assert(span/from-base64url(prefix.to-base64url()).! == prefix)
  }
  let sb = string-builder/new()
  all.write-base64(sb.&)
  assert(span/from-base64(sb.build()).! == all)

  let high-char: list[u8] = [90, 109, 57, 200]
  for bad in ["Zm9", "Zm9-", "Z=g=", "Zh==", "Zm9=", string/wrap-bytes(high-char.as-span())] {
    assert(span/from-base64(bad) is :none)
  }
  for bad in ["Z", "Zm8=", "Zm9+", "Zh"] {
    assert(span/from-base64url(bad) is :none)
  }
}

fn(test) string-split-by-char() {
  assert("".split-by-char('.') == [])
  assert("a...".split-by-char('.') == ["a", "", ""])
  assert("..".split-by-char('.') == ["", ""])
  assert-equals("aaaa.bbbb.cccc.dddd.eeee.ffff.gggg".split-by-char('.').len(), 7)
}

fn(test) numeric-from-string-bounds() {
  assert(u64/from-string("18446744073709551615").! == u64/max-value)
  assert(u64/from-string("18446744073709551616") is :err "u64 overflow")
  assert(u64/from-string("18446744073709551620") is :err "u64 overflow")
  assert(not u64/from-string("-1").is-ok())
  assert(not i64/from-string("-").is-ok())
  assert(i64/from-string("-9223372036854775808").! == i64/min-value)
  assert(not i64/from-string("9223372036854775808").is-ok())
  assert(not i64/from-string("-9223372036854775809").is-ok())
  assert(not f64/from-string("1.5x").is-ok())
}

fn(test) string-compare-and-sort() {
  assert("ab".compare("abc") is :less)
  assert("Z".compare("a") is :less)
  let words: list[string] = ["pear", "apple", "fig", "apple", ""]
  words.sort()
  assert-equals(string/join(words, "|"), "|apple|apple|fig|pear")
}

fn(test) writer-join() {
  let sb = string-builder/new()
  sb.join([1, 2, 3], ", ")
  sb.write(";")
  sb.join(list/empty[int](), ", ")
  sb.join-with(["a", "b"], "/", fn[sb.&] s. { sb.write-char('<'); sb.write(s); sb.write-char('>') })
  assert-equals(sb.build(), "1, 2, 3;<a>/<b>")
  assert-equals(string/join(["x"], ", "), "x")
}
