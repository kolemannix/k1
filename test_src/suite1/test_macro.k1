ns test_macro;

let(mutable) twice-counter: int = 0
let(mutable) repeat-counter: int = 0

fn incr(): int {
  twice-counter = twice-counter + 1
  twice-counter
}

fn incr-repeat() {
  repeat-counter = repeat-counter + 1
}

macro twice(e) {
  "$e + $e"
}

macro repeat(n: int, body) {
  let cb = code-builder/new()
  for 0.until(n) {
    cb.code(body)
    cb.writeln("")
  }
  cb.build()
}

macro debug(e) {
  #if false "println($e)" else ""
}

fn test-twice() {
  let x = twice(incr())
  assert-equals(x, 3)
  assert-equals(twice-counter, 2)
}

fn test-repeat() {
  repeat(3, incr-repeat())
  assert-equals(repeat-counter, 3)
}

fn test-debug-elided() {
  debug(crash("this must never run"))
}

fn test-code-value() {
  let c = \incr()
  assert-equals(c.chunks.len(), 1)
  let chunk = c.chunks.[0]
  assert-equals(chunk.text, "incr()")
  assert(chunk.source != 0)
}

fn test-code-literal() {
  let a = \9 * 9
  let c: code = "let q = $a"
  assert-equals(c.text(), "let q = 9 * 9")
  assert-equals(c.chunks.len(), 2)
  assert-equals(c.chunks.[1].text, "9 * 9")
  assert(c.chunks.[1].source != 0)
}

fn test-code-fmt() {
  let c: code = "let w = ${}".fmt(42)
  assert-equals(c.text(), "let w = 42")
  assert-equals(c.chunks.len(), 2)
  assert-equals(c.chunks.[0].text, "let w = ")
  assert-equals(c.chunks.[1].source, 0)

  // No expectation nearby? Ascribe.
  let d = "let v = ${}".fmt(7): code
  assert-equals(d.text(), "let v = 7")
}

fn test-code-builder() {
  let a = \1 + 2
  let cb = code-builder/new()
  cb.write("let z = $a; z * 2")
  let built = cb.build()
  assert-equals(built.text(), "let z = 1 + 2; z * 2")
  assert-equals(built.chunks.len(), 3)
  assert-equals(built.chunks.[1].text, "1 + 2")
}

fn test-emitter() {
  let cb-storage = code-builder/new()
  let cb = cb-storage.&
  // The nested block exercises transitive capture: the inner lambda captures
  // `cb` from the outer lambda's body scope
  cb.block("fn f()", fn[cb]. {
    cb.line("let x = 1")
    cb.block-close(":ok v ->", "},", fn[cb]. {
      cb.line("v")
    })
  })
  assert-equals(cb.build().text(), "fn f() {\n  let x = 1\n  :ok v -> {\n    v\n  },\n}\n")

  // line's code param makes call-site literals span-carrying
  let cb2 = code-builder/new()
  cb2.line("let y = 2")
  let built = cb2.build()
  assert-equals(built.text(), "let y = 2\n")
  let has-sourced = {
    let found = false
    for c in built.chunks { if c.source != 0 { found = true } }
    found
  }
  assert(has-sourced)

  let cb3-storage = code-builder/new()
  let cb3 = cb3-storage.&
  cb3.sep(["a", "b", "c"], ", ", fn[cb3] s. cb3.write(s))
  assert-equals(cb3.build().text(), "a, b, c")
}

use core/meta/str-lit

fn test-str-lit() {
  assert-equals(str-lit("plain"), "\"plain\"")
  assert-equals(str-lit("a\"b\\c\$d"), "\"a\\\"b\\\\c\\\$d\"")
  assert-equals(str-lit("nl\n"), "\"nl\\n\"")
}

fn test() {
  test-twice()
  test-repeat()
  test-debug-elided()
  test-code-value()
  test-code-literal()
  test-code-fmt()
  test-code-builder()
  test-emitter()
  test-str-lit()

  .{}
}
