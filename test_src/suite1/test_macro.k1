ns test_macro;

let(mutable) twice-counter: int = 0
let(mutable) repeat-counter: int = 0

fn incr(): int {
  twice-counter = twice-counter + 1
  twice-counter
}

fn incr-repeat() {
  repeat-counter = repeat-counter + 1
}

macro twice(e: code) {
  "$e + $e"
}

macro repeat(n: int, body: code) {
  let cb = code-builder/new()
  for 0.until(n) {
    cb.write-code(body)
    cb.writeln("")
  }
  cb.build()
}

macro debug(e: code) {
  #if false "println($e)" else ""
}

fn test-twice() {
  let x = twice(incr())
  assert-equals(x, 3)
  assert-equals(twice-counter, 2)
}

fn test-repeat() {
  repeat(3, incr-repeat())
  assert-equals(repeat-counter, 3)
}

macro widen-arg(n: i8) {
  "${n.unsigned().widen[u64]}"
}

fn test-signed-arg() {
  let w: u64 = widen-arg(-1)
  assert-equals(w, 255)
}

fn test-debug-elided() {
  debug(crash("this must never run"))
}

fn test-code-value() {
  let c = \incr()
  assert-equals(c.text, "incr()")
  assert-equals(c.spans.len(), 1)
  assert(c.spans.[0].source != 0)
}

fn test-code-fmt() {
  let c: code = "let w = ${}".fmt(42)
  assert-equals(c.text, "let w = 42")
  assert-equals(c.spans.len(), 1)
  assert-equals(c.spans.[0].len, 8)

  // No expectation nearby? Ascribe.
  let d = "let v = ${}".fmt(7): code
  assert-equals(d.text, "let v = 7")

  let e: code = "let p = ${:03}".fmt(7)
  assert-equals(e.text, "let p = 007")
}

fn test-code-builder() {
  let a = \1 + 2
  let cb = code-builder/new()
  cb.write("let z = $a; z * 2")
  let built = cb.build()
  assert-equals(built.text, "let z = 1 + 2; z * 2")
  assert-equals(built.spans.len(), 3)
  assert-equals(built.spans.[1].start, 8)
  assert-equals(built.spans.[1].len, 5)
}

fn test-emitter() {
  let cb-storage = code-builder/new()
  let cb = cb-storage.&
  // The nested block exercises transitive capture: the inner lambda captures
  // `cb` from the outer lambda's body scope
  cb.block("fn f()", fn[cb]. {
    cb.line("let x = 1")
    cb.block-close(":ok v ->", "},", fn[cb]. {
      cb.line("v")
    })
  })
  assert-equals(cb.build().text, "fn f() {\n  let x = 1\n  :ok v -> {\n    v\n  },\n}\n")

  // line's code param makes call-site literals span-carrying
  let cb2 = code-builder/new()
  cb2.line("let y = 2")
  let built = cb2.build()
  assert-equals(built.text, "let y = 2\n")
  assert-equals(built.spans.len(), 1)

  let cb3-storage = code-builder/new()
  let cb3 = cb3-storage.&
  cb3.sep(["a", "b", "c"], ", ", fn[cb3] s. cb3.write(s))
  assert-equals(cb3.build().text, "a, b, c")
}

macro token-summary(t: span[code-token]) {
  let sb = string-builder/new()
  for tok in t {
    sb.write("${tok.kind.enum-name()}:${tok.text}:${tok.spacing.enum-name()} ")
  }
  "${meta/str-lit(sb.build())}"
}

macro string-parts(t: span[code-token]) {
  let sb = string-builder/new()
  for t.[0].parts {
    if it is {
      :text p -> sb.write("[${p.value}]"),
      :hole h -> sb.write("{${h.tokens.len()}${h.spec}}"),
    }
  }
  "${meta/str-lit(sb.build())}"
}

macro hole-sum(t: span[code-token]) {
  let cb = code-builder/new()
  cb.write("0")
  for t.[0].parts {
    if it is :hole h {
      cb.write(" + ")
      cb.write-tokens(h.tokens)
    }
  }
  cb.build()
}

macro sum-list(t: span[code-token]) {
  let cb = code-builder/new()
  for tok in t {
    if tok.kind is :punct and tok.text == "," cb.write(" + ") else cb.write-token(tok)
  }
  cb.build()
}

macro numbers(t: span[code-token]) {
  for tok in t {
    if not (tok.kind is :number) tok.fail("expected a number, got `${tok.text}`")
  }
  "0"
}

fn test-token-params() {
  let x = 4
  assert-equals(
    token-summary(\{ <a b="s ${x + 1}">'c'
      9 fn }),
    "punct:<:none ident:a:none ident:b:inline punct:=:none string:\"s \${x + 1}\":none punct:>:none char:'c':none number:9:newline ident:fn:inline ",
  )
  assert-equals(token-summary(\{}), "")
  assert-equals(token-summary(x+1), "ident:x:none punct:+:none number:1:none ")
  let s: int = sum-list(\{ 1, 2, x })
  assert-equals(s, 7)
  let n: int = numbers(\{ 1 2 3 })
  assert-equals(n, 0)
  let fail: ?string = test-compile(numbers(\{ 1 2 three 4 }))
  assert(fail.!.starts-with("expected a number, got `three`"))
  assert-equals(string-parts(\{ "a\t${x + 1:>2} b $x" }), "[a\t]{3>2}[ b ]{1}")
  assert(test-compile(string-parts(\{ "${x:zz}" })).!.starts-with("Invalid format spec"))
  assert-equals(hole-sum(\{ "${x} and ${x * 2}" }), 12)
}

fn test-raw-group() {
  let c = \{ any < tokens > here }
  assert-equals(c.text, "any < tokens > here")
  assert(c.spans.[0].source != 0)
  assert-equals((\{}).text, "")
}

fn test() {
  test-twice()
  test-repeat()
  test-signed-arg()
  test-debug-elided()
  test-code-value()
  test-code-fmt()
  test-code-builder()
  test-emitter()
  test-token-params()
  test-raw-group()

  .{}
}
