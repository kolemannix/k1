ns for_yield_test

fn for-string(): int {
  let s = "asdf"
  let char-codes = list/from-mapping(s, fn c. c.as[int])
  assert(char-codes == [97, 115, 100, 102])
  0
}

fn for-yield() {
  let squares: list[int] = list/from-mapping([1, 5, 9, 12], fn it. it * it)
  assert(squares == [1, 25, 81, 144])
}

fn test() {
  for-string()
  for-yield()
}
