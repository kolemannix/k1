ns is_patterns

fn early(k: either { a, b }): string {
  if k is :a return "early"
  "late"
}

fn first-some(xs: span[?int]): int {
  for x in xs { if x is :some v return v }
  -1
}

fn test() {
  assert-equals(early(:a), "early")
  assert-equals(early(:b), "late")
  assert-equals(first-some([:none, :some 7, :some 9]), 7)

  assert("hello" is "hello")
  assert(not "hello" is "world")
  assert(3.14 is 3.14)

  let foo = .{ x = 1, y = "asdf" }
  let else-ran = false
  if foo is .{ x = 200 } .{} else {
    else-ran = true
  }
  assert(else-ran)
  if foo is .{ x = 1, y } {
    assert(y == "asdf")
  } else crash("")

  let opt: ?{ x: i64 } = :some(.{ x = 1 })
  if opt is :some(.{ x = 2 }) crash("")

  let qo: ?int = :some 42
  assert(not qo is :some 41)
  require qo is :some w else crash("")
  assert(w == 42)
  if qo.& is :some r* {
    assert(r.* == 42)
  } else crash("")
}
