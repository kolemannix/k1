ns struct_create {

  type(alias) point = #type types/struct-create([
    .{ name = "x", type = types/id[i64] },
    .{ name = "y", type = types/id[string] },
  ].as-span())

  fn test() {
    let p: point = .{ x = 42, y = "hello" }
    assert-equals(p.x, 42)
    assert-equals(p.y, "hello")
    assert-equals(types/size[point], 24)
    assert-equals(types/align[point], 8)

    let created: types/type-id = #static types/struct-create([
      .{ name = "x", type = types/id[i64] },
      .{ name = "y", type = types/id[string] },
    ].as-span())
    assert-equals(created, types/id[point])
    assert-equals(created, types/id[{ x: i64, y: string }])

    require types/id[point].schema() is :struct .{ fields }
      and fields.len() == 2
      and fields.get(0).name == "x"
      and fields.get(0).type-id == types/id[i64]
      and fields.get(1).name == "y"
      and fields.get(1).type-id == types/id[string]
      else crash("point schema mismatch")

    .{}
  }
}
