ns arith

let z: int = 1337

fn add_stuff(x: int, y: int): int {
  let b: int = x + 1
  let foo: int = b + z
  foo + y
}

fn mult(x: int, y: int): int {
  x * y
}

fn test() {
  let x = (1 * 100 * 2) / 3
  assert(x == 66)

  assert(50 >= 50)
  assert(51 >= 50)

  assert(50 <= 50)
  assert(49 <= 50)

  let y = x - 14

  assert(y == 52)
  assert(y > 51)
  assert(y < 53)

  assert-equals(2 % 2, 0)
  assert-equals(2 % 3, 2)
  assert-equals(-1 % 2, -1)
  assert-equals(-10 % 2, 0)

  assert(add_stuff(y = 2, x = 1) == 1341)

  let mult-result: int = mult(
    55,
    2 + 3 + 3,
  )
  assert(mult-result == 440)

  assert(1 != 2)
  assert(2 == 2)

  assert-equals(0.show(), "0")
  assert-equals(99.show(), "99")
  assert-equals(101.show(), "101")
  assert-equals(-101.show(), "-101")

  // Integer suffixes
  let _a: u8 = 255u8
  let _b: i8 = -128i8
  let _c: u16 = 65535u16
  let _d: i16 = -32768i16
  let _e: u32 = 4294967295u32
  let _f: i32 = -2147483648i32
  let _g: u64 = 18446744073709551615u64
  let _h: i64 = -9223372036854775808i64
  let _i: size = 5size
  let _j: usize = 7usize
  let _k: int = -3int
  let _l: uint = 9uint

  // Prefixes, underscores, negatives
  assert-equals(-0x1F, -31)
  assert-equals(0b1010u8, 10)
  assert-equals(-1_0_0, -100)
  assert-equals(1_000_000, 1000000)
  assert-equals(0xdead_beefu32, 3735928559u32)

  // Coercions
  assert-equals(3u8.widen[u64], 3)
  assert-equals(3i8.widen[i64], 3)
  assert-equals(-3i8.widen[i64], -3)

  // Signed widen to unsigned
  assert-equals(-1i16.widen[i32].unsigned(), 0xFFFF_FFFF)
  // Not directly allowed
  assert(test-compile(-1i16.as[u32]).is-some())

  // 2's complement negation
  assert-equals(5.negated(), -5)
  assert-equals((-5).negated(), 5)
  assert-equals(0.negated(), 0)
  assert-equals(neg/negated(42), -42)
  assert-equals(127i8.negated(), -127i8)
  assert-equals(-128i8.negated(), -128i8)
  assert-equals(-9223372036854775808i64.negated(), -9223372036854775808i64)
  assert-equals(1u8.negated(), 255u8)
  assert-equals(255u8.negated(), 1u8)
  assert-equals(0u64.negated(), 0u64)
  assert-equals(1u64.negated(), 0xFFFF_FFFF_FFFF_FFFFu64)
  assert-equals(negate-generic(3), -3)
  assert-equals(negate-generic(2.5), -2.5)

  assert-equals(3.min(5), 3)
  assert-equals(3.max(5), 5)
  assert-equals((-3: i64).min(5), -3)
  assert-equals((-3: i8).max(5), 5)
  assert-equals(200u8.min(100), 100)
  assert-equals(200u8.max(100), 200)
  assert-equals(0xFFFF_FFFF_FFFF_FFFFu64.min(1), 1)
  assert-equals(min-generic(7: u16, 2), 2)
  assert-equals(min-generic(2.0, 7.0), 2.0)
  let static-max: i32 = #static { (4: i32).max(9) }
  assert-equals(static-max, 9)

  .{}

}

fn negate-generic[t](x: t): t where t: neg {
  x.negated()
}

fn min-generic[t: scalar-cmp](a: t, b: t): t { a.min(b) }
