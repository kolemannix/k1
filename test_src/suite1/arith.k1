ns arith

fn(test) operators-and-precedence() {
  assert-equals(-1 % 2, -1)
  assert(42 & 15 == 10)
  assert(29 ^ 15 == 18)
  assert(2 & 1 < 1)
  assert(1 << 1 & 2 == 2)
  assert(-7 >> 1 == -4)
}

fn(test) integer-literal-forms() {
  assert-equals(-0x1F, -31)
  assert-equals(0b1010u8, 10)
  assert-equals(-1_0_0, -100)
  assert-equals(0xdead_beefu32, 3735928559u32)
  assert-equals(18446744073709551615u64, u64/max-value)
  assert-equals(-9223372036854775808i64, i64/min-value)
}

fn(test) widening-and-sign-casts() {
  assert-equals(-3i8.widen[i64], -3)
  assert-equals(-1i16.widen[i32].unsigned(), 0xFFFF_FFFF)
  assert(test-compile(-1i16.as[u32]).is-some())
}

fn(test) wrapping-negation() {
  assert-equals(-128i8.negated(), -128i8)
  assert-equals(1u8.negated(), 255u8)
  assert-equals(negate-generic(2.5), -2.5)
}

fn(test) scalar-min-max() {
  assert-equals((-3: i8).max(5), 5)
  assert-equals(0xFFFF_FFFF_FFFF_FFFFu64.min(1), 1)
  assert-equals(min-generic(7: u16, 2), 2)
}

fn(test) wrapping-ops-and-masked-shifts() {
  assert-equals(127i8 + 1, -128)
  assert-equals(-1i32 * i32/min-value, i32/min-value)
  assert-equals(1u64 << 65, 2)
  assert-equals(0xFFu8 >> 9, 0x7F)
  assert-equals(-1i32 >> 32, -1)
  let min64 = i64/min-value
  assert-equals(min64 >> 64, min64)
  assert-equals(min64 / -2, 0x4000_0000_0000_0000)
  assert-equals(min64 % -2, 0)
}

fn(test) overflow-reporting() {
  let wrapped = fold_test/opaque(200u8).add-overflow(100)
  assert-equals(wrapped.value, 44)
  assert(wrapped.overflowed)
  assert(not fold_test/opaque(-100i8).add-overflow(-28).overflowed)
  assert(fold_test/opaque(-100i8).add-overflow(-29).overflowed)
  assert(fold_test/opaque(0u32).sub-overflow(1).overflowed)
  assert-equals(fold_test/opaque(i64/min-value).sub-checked(1), :none)
  assert-equals(fold_test/opaque(100u8).add-checked(100), :some 200)
  assert-equals(fold_test/opaque(0x1_0000_0000u64).mul-checked(0x1_0000_0000), :none)
  assert-equals(fold_test/opaque(-0x8000_0000i64).mul-checked(0x1_0000_0000), :some i64/min-value)
  assert-equals(fold_test/opaque(-1i16).mul-overflow(i16/min-value).value, i16/min-value)
  let folded: bool = #static { 255u8.add-overflow(1).overflowed and 3u8.mul-checked(5) == :some 15 }
  assert(folded)
}

fn(test) mul-high() {
  assert-equals(fold_test/opaque(u64/max-value).mul-high(u64/max-value), u64/max-value - 1)
  assert-equals(fold_test/opaque(0x1_0000_0000u64).mul-high(0x1_0000_0000), 1)
  assert-equals(fold_test/opaque(-1).mul-high(5), -1)
  assert-equals(fold_test/opaque(i64/min-value).mul-high(i64/min-value), 0x4000_0000_0000_0000)
  let folded: u64 = #static 0xFFFF_FFFF_FFFF_FFFFu64.mul-high(3)
  assert-equals(folded, 2)
}

fn(test) int-bits() {
  assert-equals(fold_test/opaque(0u8).trailing-zeros(), 8)
  assert-equals(fold_test/opaque(-128i8).trailing-zeros(), 7)
  assert-equals(fold_test/opaque(0b1000u64).trailing-zeros(), 3)
  assert-equals(fold_test/opaque(0u32).leading-zeros(), 32)
  assert-equals(fold_test/opaque(0x00FFu16).leading-zeros(), 8)
  assert-equals(fold_test/opaque(-1i64).leading-zeros(), 0)
  assert-equals(fold_test/opaque(-1i8).count-ones(), 8)
  assert-equals(fold_test/opaque(0xF0F0u64).count-ones(), 8)
  assert-equals(fold_test/opaque(0xABu8).swap-bytes(), 0xAB)
  assert-equals(fold_test/opaque(0x00FFi16).swap-bytes(), -256)
  assert-equals(fold_test/opaque(0x1122_3344u32).swap-bytes(), 0x4433_2211)
  assert-equals(fold_test/opaque(0x0102_0304_0506_0708u64).swap-bytes(), 0x0807_0605_0403_0201)
  assert-equals(fold_test/opaque(0x81u8).rotate-left(1), 0x03)
  assert-equals(fold_test/opaque(0x81u8).rotate-left(9), 0x03)
  assert-equals(fold_test/opaque(-128i8).rotate-left(1), 1)
  assert-equals(fold_test/opaque(0x8001u16).rotate-right(1), 0xC000)
  assert-equals(fold_test/opaque(0x1234_5678i32).rotate-right(fold_test/opaque(0u32)), 0x1234_5678)
  assert-equals(fold_test/opaque(1u64).rotate-right(1), 1u64 << 63)
  assert-equals(0u16.trailing-zeros(), 16)
  assert-equals(1u32.leading-zeros(), 31)
  assert-equals(0x0F0Fi16.count-ones(), 8)
  assert-equals(0x1234u16.swap-bytes(), 0x3412)
  assert-equals(0x8000_0001u32.rotate-left(4), 0x18)
  assert-equals(0x81u8.rotate-right(1), 0xC0)
}

fn(test) absolute-value() {
  assert-equals((-7: i32).abs(), 7)
}

fn(test) out-of-range-literals-rejected() {
  assert(test-compile({ let _x: u8 = 256; .{} }) is :some "Invalid u8: 256 does not fit")
  assert(test-compile(emit("99999999999999999999")).!.contains-string("Invalid decimal integer: too large for any integer type"))
}

fn(test) divides-by-zero() {
  k1/test/expect-failure("Division by zero")
  let d: i32 = 0
  let _ = 10 / d
}

fn(test) overflows-division() {
  k1/test/expect-failure("Integer division overflow: min-value / -1")
  let d = -1i8
  let _ = -128i8 % d
}

macro emit(s: string) { code/from-string(s) }

fn negate-generic[t](x: t): t where t: neg {
  x.negated()
}

fn min-generic[t: scalar-cmp](a: t, b: t): t { a.min(b) }
