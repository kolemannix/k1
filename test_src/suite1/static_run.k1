ns static_run
let INT_SPAN: span[int] = [1,2,3,4,5]

let i2: int = { 3 * 5 }
let i3: int = { let _ = 1; #static { let _ = 1; #static 3 * 4 } }

#static {
  assert-equals(types/id[i2], types/id[15])
  assert-equals(types/id[i3], types/id[12])
}

let s1: string = {
  let a = "asd"
  a.concat("f")
}
#static assert-equals(types/id[s1], types/id["asdf"])

fn get-point(): { x: u8, y: u32, z: i64 } {
  .{ x = 1, y = 300, z = -222 }
}
fn test() {
  #static "Hello, Static"

  let point = #static {
    (.{ x = 1, y = 2 })
  }

  (point.x: 1)
  (point.y: 2)
  assert-equals(point.x.from-static(), 1)
  assert-equals(point.y.from-static(), 2)

  assert-equals[u8](#static get-point().x, 1)
  assert-equals[u32](#static get-point().y, 300)
  assert-equals[i64](#static get-point().z, -222)

  assert-equals((#static { let m = 21; m * 2 }).from-static(), 42)
  assert-equals(core/identity(#static { core/identity(21) * 2 }).from-static(), 42)

  let padded = #static {
    let padded = .{ a = 1: u8, b = 2: u8, c = 3: u8, d = 4: u64, e = 5 }
    padded
  }
  (padded.a: 1u8)
  (padded.b: 2u8)
  (padded.c: 3u8)
  (padded.d: 4u64)
  (padded.e: 5i64)

  assert-equals(core/k1/is-static, false)
  #static assert(core/k1/is-static)

  let ptr-in-structs = #static {
    let b: u8 = 10
    let f = .{ asdf = b.& }
    f.asdf.*
  }
  assert-equals[u8](ptr-in-structs, 10)

  let list-last = #static {
    let inced = [1,2,3,4,5].map(fn it. it+1)
    inced.last()
  }
  assert-equals[?int](list-last, some(6))

  assert-equals[int](#static loop {
    if 42 is {
      _ -> break 100
    }
  }, 100)

  assert-equals[?string](
    test-compile( #static sys/exit(111) ).map(fn(s) s.take(38)),
    some("Static execution exited with code: 111")
  )
  assert-equals[?string](
    test-compile( #static crash("boom") ).map(fn(s) s.take(4)),
    some("boom")
  )

  #static bar(2)

  let span: span[int] = #static {
    let xs = [1,2,3,4,5]
    xs.as-span()
  }
  assert-equals(span, [1,2,3,4,5])
  #static {
    let l = list/wrap-buffer(buffer/from-span(INT_SPAN))
    l.push(9)
    assert-equals(l.len, 6)
    assert-equals(l.last(), some(9))
  }

  let vov: span[span[int]] = #static [[1,2,3], [4,5,6]]
  assert-equals(vov.len(), 2)
  assert-equals(vov.[1].[2], 6)

  #for [0,2,4] {
    assert-equals(it % 2, 0)
  }

  static-for[int]([0,2,4], {
   assert-equals(it % 2, 0)
  })

  assert-equals(make-boxed(7).value, 7)
  assert-equals(make-boxed-let("hi").value, "hi")
  assert-equals(size-of-param[u32](), 4)

  .{}
}

type boxed[t] = { value: t }

fn make-boxed[t](value: t): *boxed[t] {
  mem/new-in-place[boxed[t]](.{ value = value })
}

fn make-boxed-let[t](value: t): *boxed[t] {
  let b: *boxed[t] = mem/new-in-place[boxed[t]](.{ value = value })
  b
}

fn size-of-param[t](): size {
  let s: size = #static types/size[t]()
  s
}

macro static-for[t](items: span[t], expr: code) {
  let code = code-builder/new()
  for items {
    code.writeln(core/meta/baked-variable("it", it))
    code.write-code(expr)
    code.writeln("")
  }
  code.build()
}

fn foo(n: int) {
  if n == 0 return
  else bar(n - 1)
}

fn bar(n: int) {
  if n == 0 return
  else foo(n - 1)
}

