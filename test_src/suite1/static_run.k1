ns static_run
let INT_SPAN: span[int] = [1,2,3,4,5]

let i2: int = { 3 * 5 }
// The extra blocks circumvent a warning
let i3: int = { let _ = 1; #static { let _ = 1; #static 3 * 4 } }

#static {
  assert-equals(types/id[i2], types/id[15])
  assert-equals(types/id[i3], types/id[12])
}

let s1: string = {
  let a = "asd"
  a.concat("f")
}
#static assert-equals(types/id[s1], types/id["asdf"])

fn statics-and-coercion(): i32 {
   let _i: "a" = #static "a"
   let _i2: string = #static "a"
   let _i3: "a" = "a"
   0
}

fn get-point(): { x: u8, y: u32, z: i64 } {
  .{ x = 1, y = 300, z = -222 }
}
fn test() {
  // String creation (special case)
  #static "Hello, Static"

  // Struct creation
  let point = #static {
    (.{ x = 1, y = 2 })
  }

  // Type assertions
  (point.x: 1)
  (point.y: 2)
  // Value assertions
  assert-equals(point.x.from-static(), 1)
  assert-equals(point.y.from-static(), 2)

  // Scalars
  assert(#static true)
  assert(not #static false)
  assert(not #static true == false)
  assert(#static .{} == .{})
  assert(#static 'a' == 'a')
  assert(not #static 'A' == 'a')
  assert(not #static 123 == -123)
  assert(not #static 123.0 == 3.14)

  // Return struct
  assert-equals[u8](#static get-point().x, 1)
  assert-equals[u32](#static get-point().y, 300)
  assert-equals[i64](#static get-point().z, -222)

  // Non-trivial statics as generic args: compiled and executed during inference
  assert-equals((#static { let m = 21; m * 2 }).from-static(), 42)

  // Variable assign
  let goodbye: "Goodbye, World!" = #static {
    let msg = "Hello, World"
    msg = "Goodbye, World!"
    msg
  }
  assert-equals[string](goodbye, "Goodbye, World!")

  let let-assign = #static {
    let i = 22
    i = 10
    i
  }
  assert-equals[int](let-assign, 10)

  let padded = #static {
    let padded = .{ a = 1: u8, b = 2: u8, c = 3: u8, d = 4: u64, e = 5 }
    padded
  }
  (padded.a: 1u8)
  (padded.b: 2u8)
  (padded.c: 3u8)
  (padded.d: 4u64)
  (padded.e: 5i64)

  let let-ref = #static {
    let i = 10

    i = core/identity(i)
    i = core/identity(i)
    i
  }
  assert-equals[int](let-ref, 10)

  assert-equals(core/k1/is-static, false)
  #static assert(core/k1/is-static)

  let enum1 = #static {
    let x = some(42)
    let y = if x is :some(x) x else crash("")
    y
  }
  assert-equals[int](enum1, 42)

  let field-ptr-test: int = #static {
    let x = 21
    let s = .{ ptr = &x }
    s.ptr.*
  }
  assert-equals(field-ptr-test, 21)


  let ptr-in-structs = #static {
    let b: u8 = 10
    let f = .{ asdf = &b }
    f.asdf.*
  }
  assert-equals[u8](ptr-in-structs, 10)

  //// Loops
  #if false assert-equals(#static {
    let i = 0
    loop {
      if i >= 5 { break }
      i = i + 1
    }
    i
  }, 5)

  #if false assert-equals(#static {
    let i = 0
    while i < 5 { i = i + 1 }
    i
  }, 5)

  #static {
    let l = list/with-capacity[empty](0)
    l.len
  }

  // lists
  let list-last = #static {
    let inced = [1,2,3,4,5].map(fn it. it+1)
    inced.last()
  }
  assert-equals[?int](list-last, some(6))

  assert-equals[int](#static loop {
    42 is {
      _ -> break 100
    }
  }, 100)

  // string-builder

  assert-equals[string](#static {
    let sb = string-builder/new()
    sb.write("Hello")
    sb.build()
  }, "Hello")

  assert-equals[?string](
    test-compile( #static sys/exit(111) ).map(fn(s) s.take(38)),
    some("Static execution exited with code: 111")
  )

  // Call order
  #static bar(2)

  // span
  let span: span[int] = #static {
    let xs = [1,2,3,4,5]
    xs.as-span()
  }
  assert-equals(span, [1,2,3,4,5])
  #static {
    // uses a global
    let l = list/wrap-buffer(buffer/from-span(INT_SPAN))
    l.push(9)
    assert-equals(l.len, 6)
    assert-equals(l.last(), some(9))
  }


  // Simple lambda
  assert-equals[int](#static {
    let lam = fn(x: int) x * 2
    lam(1)
  }, 2)

  // span of spans!
  let vov: span[span[int]] = #static [[1,2,3], [4,5,6]]
  assert-equals(vov.len(), 2)
  assert-equals(vov.[0].[0], 1)
  assert-equals(vov.[0].[1], 2)
  assert-equals(vov.[0].[2], 3)
  assert-equals(vov.[1].[0], 4)
  assert-equals(vov.[1].[1], 5)
  assert-equals(vov.[1].[2], 6)


  let point = #static .{ x = 1, y = (#static 2): int }
  assert-equals(point.from-static().x, 1)

  #for [0,2,4] {
    assert-equals(it % 2, 0)
  }

  static-for[int]([0,2,4], {
   assert-equals(it % 2, 0)
  })

  .{}
}

macro static-for[t](items: span[t], expr) {
  let code = code-builder/new()
  for items {
    code.writeln(core/meta/baked-variable("it", it))
    code.code(expr)
    code.writeln("")
  }
  code.build()
}

fn get-one(): int { 1 }
fn get-three(): int { get-one() + 2 }

fn foo(n: int) {
  if n == 0 return
  else bar(n - 1)
}

fn bar(n: int) {
  if n == 0 return
  else foo(n - 1)
}

