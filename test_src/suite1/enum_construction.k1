ns enum_construction

type state = either { on(empty), off(empty), zilch }
type state-hard = either { on(?int), off(?int) }

fn(test) qualified-variant-with-payload() {
  let bc = _root/core/opt[bool]:some(true)
  assert(bc is :some(true))
  let q4 = opt[i64]:some 42
  assert(q4 is :some 42)
  let q5: state-hard = state-hard:on :some 42
  assert(q5 is :on(:some 42))
}

fn(test) empty-payload-may-be-omitted() {
  let e1: state = :on
  assert(e1 is :on)
  let e2 = state:on
  assert(e2 is :on(.{}))
  assert(if e2 is { :on -> true, :off -> false, :zilch -> false })
  let e3: result[empty, string] = :ok
  assert(e3 is :ok)
  assert(test-compile(state-hard:on) is :some _)
}
