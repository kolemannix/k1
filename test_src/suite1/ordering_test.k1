fn(test) ordering-tag-values() {
  assert-equals(ordering:less.value, -1)
  assert-equals(ordering:equal.value, 0)
  assert-equals(ordering:greater.value, 1)

  let l: ordering = mem/bitcast(-1: i8)
  let e: ordering = mem/bitcast(0: i8)
  let g: ordering = mem/bitcast(1: i8)
  assert(l is :less)
  assert(e is :equal)
  assert(g is :greater)
}

fn(test) float-compare-total-order() {
  assert((1.5: f64).compare(2.5) is :less)
  assert((2.5: f64).compare(2.5) is :equal)
  assert((2.5: f64).compare(1.5) is :greater)
  assert((-1.0: f64).compare(1.0) is :less)

  let pos-nan:  f64 = mem/bitcast(0x7FF8000000000000: u64)
  let neg-nan:  f64 = mem/bitcast(0xFFF8000000000000: u64)
  let pos-inf:  f64 = mem/bitcast(0x7FF0000000000000: u64)
  let neg-inf:  f64 = mem/bitcast(0xFFF0000000000000: u64)
  let neg-zero: f64 = mem/bitcast(0x8000000000000000: u64)

  assert(neg-nan.compare(neg-inf) is :less)
  assert(neg-inf.compare(neg-zero) is :less)
  assert(neg-zero.compare(0.0) is :less)
  assert((0.0: f64).compare(pos-inf) is :less)
  assert(pos-inf.compare(pos-nan) is :less)
  assert(pos-nan.compare(pos-nan) is :equal)

  assert(pos-nan.compare(1.0) is :greater)
  assert((1.0: f64).compare(pos-nan) is :less)

  assert((1.5: f32).compare(2.5) is :less)
  assert((2.5: f32).compare(2.5) is :equal)
  assert((2.5: f32).compare(1.5) is :greater)
  let f32-neg-nan: f32 = mem/bitcast(0xFFC00000: u32)
  assert(f32-neg-nan.compare(-1.0) is :less)
}

fn(test) scalar-compare() {
  assert(fold_test/opaque(-1i8).compare(1) is :less)
  assert(fold_test/opaque(255u8).compare(1) is :greater)
  assert(fold_test/opaque(i64/min-value).compare(i64/max-value) is :less)
  assert(fold_test/opaque(u64/max-value).compare(0) is :greater)
  assert(fold_test/opaque(7u16).compare(7) is :equal)
  assert(fold_test/opaque('a').compare('b') is :less)
  let bytes: span[u8] = [1, 2]
  let p = bytes.data-ptr()
  assert(fold_test/opaque(p.add-bytes(1)).compare(p) is :greater)
  assert((-1i32).compare(1) is :less)
  assert(200u8.compare(3) is :greater)
}

type money = { cents: i64 }
impl scalar-cmp for money {
  fn lt(self, other: self): bool { self.cents < other.cents }
  fn le(self, other: self): bool { self.cents <= other.cents }
  fn gt(self, other: self): bool { self.cents > other.cents }
  fn ge(self, other: self): bool { self.cents >= other.cents }
}

fn(test) user-scalar-cmp-compare() {
  let a: money = .{ cents = -5 }
  let b: money = .{ cents = 7 }
  assert(fold_test/opaque(a).compare(b) is :less)
  assert(b.compare(a) is :greater)
  assert(a.compare(a) is :equal)
  let sorted = [b, a, .{ cents = 0 }].sorted()
  assert-equals(sorted.[0].cents, -5)
  assert-equals(sorted.[1].cents, 0)
  assert-equals(sorted.[2].cents, 7)
}
