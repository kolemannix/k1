ns defer_test

use core/inc

fn loop-test(sensor: *int) {
  let i = 0
  // Every iteration, we increment i, then check that the sensor is right behind it,
  // then increment the sensor
  while i < 10 {
    defer { assert-equals(i - 1, sensor.*); inc(sensor) }
    i = i + 1
  }
  .{}
}

// An early return causes 'unwinding' of all defers in scope,
// and if it appears at the end of a block, does NOT cause
// duplicate insertion of that block's defers
fn return-test(sensor: *int) {
  defer { assert-equals(sensor.*, 2); inc(sensor) }
  if true {
    defer { assert-equals(sensor.*, 1); inc(sensor) }
    if false .{} else {
      defer { assert-equals(sensor.*, 0); inc(sensor) }
      return
    }
  } else {
    assert(false)
  }
  .{}
}

type action = either { accept, reject }

// A block that yields a value runs its defers after the value is computed,
// and still yields the value
fn value-block-test(sensor: *int): action {
  let r: action = if 0 is {
    0 -> {
      defer { assert-equals(sensor.*, 1); inc(sensor) }
      inc(sensor)
      :reject
    },
    _ -> :accept
  }
  assert-equals(sensor.*, 2)
  r
}

// A function body's final value is computed before its defers run
fn value-return-test(sensor: *int): int {
  defer { assert-equals(sensor.*, 1); inc(sensor) }
  inc(sensor)
  sensor.* + 41
}

// A final statement that diverges through returns runs defers exactly once
fn branchy-test(sensor: *int): int {
  defer inc(sensor)
  if sensor.* == 0 { return 1 } else { return 2 }
}

// break computes its value, then runs the defers of every scope it exits
fn break-test(sensor: *int): int {
  loop {
    defer inc(sensor)
    if sensor.* == 3 {
      break(sensor.* * 10)
    }
  }
}

// The .try error path runs pending defers on its way out
fn try-defers(sensor: *int): result[int, string] {
  defer inc(sensor)
  let v: result[int, string] = :err "boom"
  let i = v.try
  :ok i
}

// Defers in one scope run last-declared-first, both at block end...
fn lifo-block-test(sensor: *int) {
  defer { assert-equals(sensor.*, 1); inc(sensor) }
  defer { assert-equals(sensor.*, 0); inc(sensor) }
}

// ...and at an early return
fn lifo-return-test(sensor: *int) {
  defer { assert-equals(sensor.*, 1); inc(sensor) }
  defer { assert-equals(sensor.*, 0); inc(sensor) }
  if sensor.* == 0 { return }
  assert(false)
}

fn lexical-test(): int {
  let x = 1
  defer assert-equals(x, 1)
  if true {
    let x = 2
    return x
  }
  0
}

fn value-before-defers-test(): int {
  let x = 1
  defer { x = 99 }
  x
}

fn returned-var-test(): int {
  let(returned) x = 1
  defer { x = 99 }
  x
}

fn loop-in-defer-test(sensor: *int) {
  defer {
    loop { inc(sensor); if sensor.* == 3 break }
  }
}

fn static-return-test(sensor: *int): int {
  defer inc(sensor)
  #static { if true return 3; 4 }
}

fn failing(fail: bool): result[int, string] { if fail :err "failed" else :ok 1 }

fn binder-test(fail-early: bool, fail-try: bool, sensor: *int): result[int, string] {
  defer r. if r is :err _ inc(sensor)
  if fail-early return :err "early"
  let v = failing(fail-try).try
  :ok v
}

fn test() {
  // We use an integer so that we can detect if a defer
  // runs too few or too many times!
  let sensor = 0
  loop-test(sensor.&)
  assert-equals(sensor, 10)

  sensor = 0
  return-test(sensor.&)
  assert-equals(sensor, 3)

  sensor = 0
  assert(value-block-test(sensor.&) is :reject)
  assert-equals(sensor, 2)

  sensor = 0
  assert-equals(value-return-test(sensor.&), 42)
  assert-equals(sensor, 2)

  sensor = 0
  assert-equals(branchy-test(sensor.&), 1)
  assert-equals(sensor, 1)

  sensor = 0
  assert-equals(break-test(sensor.&), 30)
  assert-equals(sensor, 4)

  sensor = 0
  assert(try-defers(sensor.&) is :err "boom")
  assert-equals(sensor, 1)

  sensor = 0
  lifo-block-test(sensor.&)
  assert-equals(sensor, 2)

  sensor = 0
  lifo-return-test(sensor.&)
  assert-equals(sensor, 2)

  assert-equals(lexical-test(), 2)
  assert-equals(value-before-defers-test(), 1)
  assert-equals(returned-var-test(), 99)

  sensor = 0
  loop-in-defer-test(sensor.&)
  assert-equals(sensor, 3)

  sensor = 0
  assert-equals(static-return-test(sensor.&), 3)
  assert-equals(sensor, 1)

  sensor = 0
  assert(binder-test(true, false, sensor.&) is :err "early")
  assert(binder-test(false, true, sensor.&) is :err "failed")
  assert(binder-test(false, false, sensor.&) is :ok 1)
  assert-equals(sensor, 2)

  .{}
}
