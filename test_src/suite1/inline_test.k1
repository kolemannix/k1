ns inline_test

fn(inline) add3(a: int, b: int, c: int): int { a + b + c }

fn(inline) clamp(x: int, lo: int, hi: int): int {
  if x < lo return lo
  if x > hi return hi
  x
}

type pair = { a: int, b: string }
fn(inline) mk-pair(a: int): pair { .{ a = a, b = "p" } }

let(mutable) hits: int = 0
fn(inline) bump() { hits = hits + 1 }

fn(inline) first-over(xs: span[int], limit: int): opt[int] {
  for x in xs {
    if x > limit return some(x)
  }
  none()
}

fn(inline) ident[t](x: t): t { x }

fn(inline) twice(x: int): int { add3(x, x, 0) }

fn(noinline) sub1(x: int): int { x - 1 }

fn(inline) sign(x: int): int {
  if x < 0 { return -1 }
  if x == 0 { return 0 }
  1
}

fn(inline) boom(): never { crash("boom") }

type pair2 = { a: int, b: int }
fn(inline) swap(p: pair2): pair2 { .{ a = p.b, b = p.a } }
fn(inline) mk-pair2(x: int): pair2 { .{ a = x, b = x + 1 } }

fn nrvo(): int {
  let q: pair2 = .{ a = 1, b = 2 }
  q = swap(q)
  let r = swap(mk-pair2(sub1(10)))
  q.a + q.b * 10 + r.a * 100
}

fn back-to-back(c: bool): int {
  let a = if c 1 else 2
  let f = if c is { true -> 100, false -> 200 }
  a + f
}

fn(inline) grade(score: int, curve: int): int {
  let adjusted = score + curve
  if adjusted >= 90 { return 4 }
  if adjusted >= 80 { return 3 }
  if adjusted >= 70 { 2 } else { 1 }
}

fn(inline) bucket(kind: u8, n: int): int {
  if kind is { 0 -> n * 2, 1 -> n * 3, _ -> n - 1 }
}

fn(inline) count-up(n: int): int {
  let acc = 0
  let i = 0
  while i < n {
    acc = acc + i
    i = i + 1
  }
  acc
}

fn test() {
  assert-equals(add3(1, 2, 3), 6)
  assert-equals(clamp(-5, 0, 10), 0)
  assert-equals(clamp(50, 0, 10), 10)
  assert-equals(clamp(5, 0, 10), 5)
  let p = mk-pair(7)
  assert-equals(p.a, 7)
  assert-equals(p.b, "p")
  bump()
  bump()
  assert-equals(hits, 2)
  let xs = [1, 5, 9, 12]
  assert-equals(first-over(xs.as-span(), 6), some(9))
  assert-equals(first-over(xs.as-span(), 100), none())
  assert-equals(twice(21), 42)
  assert-equals(ident(3), 3)
  assert-equals(ident("s"), "s")
  assert-equals(count-up(5), 10)
  assert-equals(sub1(10), 9)
  assert-equals(add3(1, 2, 3) * 2, 12)
  assert-equals(sign(sub1(1)), 0)
  assert-equals(sign(sub1(0)), -1)
  assert-equals(if sub1(1) == 0 3 else boom(), 3)
  assert-equals(nrvo(), 1012)
  assert-equals(back-to-back(sub1(1) == 0), 101)
  assert-equals(grade(85, 7), grade(sub1(86), 7))
  assert-equals(grade(75, 6), 3)
  assert-equals(bucket(9u8, 5) + bucket(0u8, 21), 46)
  let f = add3.&
  assert-equals(f(1, 1, 1), 3)
  let s1: int = #static add3(2, 2, 2)
  assert-equals(s1, 6)
  let s2: int = #static clamp(99, 0, 3)
  assert-equals(s2, 3)
  let s3: int = #static sub1(4)
  assert-equals(s3, 3)
}
