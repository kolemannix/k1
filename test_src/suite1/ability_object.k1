ns ability_object

ability counter[impl t] {
  fn label(_self: *self): string { "counter" }
  fn kind(): string { "counter-kind" }
  fn bump(*self): t
}

type by-ones = { current: int }
impl counter[t = int] for by-ones {
  fn bump(*self): int {
    self.current = self.current + 1
    self.current
  }
}

type by-tens = { current: int }
impl counter[t = int] for by-tens {
  fn label(_self: *by-tens): string { "tens" }
  fn kind(): string { "tens-kind" }
  fn bump(*self): int {
    self.current = self.current + 10
    self.current
  }
}

fn make-counter(start: int): dyn[counter[t = int]] {
  let state: *by-ones = mem/new(.{ current = start })
  state.to-dyn()
}

fn drive[t](c: dyn[counter[t = t]]): t {
  c.bump()
}

fn erase-generic[s](state: *s): dyn[counter[t = int]] where s: counter[t = int] {
  state.to-dyn()
}

ability mixed {
  fn plain(*self): int
  fn fancy[x](_self: *self, x: x): x { x }
}

type mixed-impl = { n: int }
impl mixed for mixed-impl {
  fn plain(*self): int { self.n }
}

fn test() {
  let ones: *by-ones = mem/new(.{ current = 0 })
  let d1 = ones.to-dyn[counter[t = int]]
  assert-equals(d1.bump(), 1)
  assert-equals(d1.label(), "counter")
  assert-equals(d1.kind(), "counter-kind")
  assert-equals(drive(d1), 2)

  let tens: *by-tens = mem/new(.{ current = 0 })
  let d2: dyn[counter[t = int]] = tens.to-dyn()
  assert-equals(d2.label(), "tens")
  assert-equals(d2.kind(), "tens-kind")
  let start: by-ones = .{ current = 100 }
  assert-equals(start.to-dyn[counter[t = int]].bump(), 101)

  let escaped = make-counter(5)
  assert-equals(escaped.bump(), 6)

  let counters: list[dyn[counter[t = int]]] = [ones.to-dyn(), tens.to-dyn(), erase-generic(tens)]
  let total = 0
  for c in counters { total = total + c.bump() }
  assert-equals(total, 3 + 10 + 20)

  let r: int = #static {
    let state: *by-tens = mem/new(.{ current = 40 })
    let d = state.to-dyn[counter[t = int]]()
    d.bump() + d.bump() + d.kind().len()
  }
  assert-equals(r, 50 + 60 + 9)

  let m: *mixed-impl = mem/new(.{ n = 7 })
  assert-equals(m.fancy(3), 3)
  assert-equals(m.to-dyn[mixed]().plain(), 7)
  #static assert(test-compile(
    { let m2: *mixed-impl = mem/new(.{ n = 1 }); let d2 = m2.to-dyn[mixed](); d2.fancy(3) }
  ).is-some())
  #static assert(test-compile(
    { let d: dyn[counter[t = int]] = #static { let o: *by-ones = mem/new(.{ current = 0 }); o.to-dyn() }; d }
  ).is-some())
}
