ns ability_object

ability counter[impl t] {
  fn label(_self: *self): string { "counter" }
  fn kind(): string { "counter-kind" }
  fn bump(*self): t
}

type by-ones = { current: int }
impl counter[t = int] for by-ones {
  fn bump(*self): int {
    self.current = self.current + 1
    self.current
  }
}

type by-tens = { current: int }
impl counter[t = int] for by-tens {
  fn label(_self: *by-tens): string { "tens" }
  fn kind(): string { "tens-kind" }
  fn bump(*self): int {
    self.current = self.current + 10
    self.current
  }
}

fn make-counter(start: int): dyn[counter[t = int]] {
  let state: *by-ones = mem/new(.{ current = start })
  state.to-dyn()
}

fn drive[t](c: dyn[counter[t = t]]): t {
  c.bump()
}

fn erase-generic[s](state: *s): dyn[counter[t = int]] where s: counter[t = int] {
  state.to-dyn()
}

ability mixed {
  fn plain(*self): int
  fn fancy[x](_self: *self, x: x): x { x }
}

type mixed-impl = { n: int }
impl mixed for mixed-impl {
  fn plain(*self): int { self.n }
}

ability named-like-object-fields {
  fn state(*self): int
  fn table(*self): int
}

type plain-cell = { n: int }
impl named-like-object-fields for plain-cell {
  fn state(*self): int { self.n }
  fn table(*self): int { self.n * 2 }
}

fn(test) dyn-fns-named-like-object-fields() {
  let c: *plain-cell = mem/new(.{ n = 21 })
  let d = c.to-dyn[named-like-object-fields]
  assert-equals(d.state(), 21)
  assert-equals(d.table(), 42)
}

ability int-taker {
  fn plus-one(x: int): int
}

impl int-taker for int {
  fn plus-one(x: int): int { x + 1 }
}

fn(test) receiverless-dyn-fn-taking-the-implementor-type() {
  let p: *int = mem/new(41)
  assert-equals(p.to-dyn[int-taker].plus-one(9), 10)
}

fn(test) dispatch-through-dyn() {
  let ones: *by-ones = mem/new(.{ current = 0 })
  let d1 = ones.to-dyn[counter[t = int]]
  assert-equals(d1.bump(), 1)
  assert-equals(d1.label(), "counter")
  assert-equals(d1.kind(), "counter-kind")
  assert-equals(drive(d1), 2)

  let tens: *by-tens = mem/new(.{ current = 0 })
  let d2: dyn[counter[t = int]] = tens.to-dyn()
  assert-equals(d2.label(), "tens")
  assert-equals(d2.kind(), "tens-kind")
  let start: by-ones = .{ current = 100 }
  assert-equals(start.to-dyn[counter[t = int]].bump(), 101)

  let escaped = make-counter(5)
  assert-equals(escaped.bump(), 6)

  let counters: list[dyn[counter[t = int]]] = [ones.to-dyn(), tens.to-dyn(), erase-generic(tens)]
  let total = 0
  for c in counters { total = total + c.bump() }
  assert-equals(total, 3 + 10 + 20)
}

fn(test) dispatch-through-dyn-at-compile-time() {
  let r: int = #static {
    let state: *by-tens = mem/new(.{ current = 40 })
    let d = state.to-dyn[counter[t = int]]
    d.bump() + d.bump() + d.kind().len()
  }
  assert-equals(r, 50 + 60 + 9)
}

fn(test) generic-fns-excluded-from-dyn() {
  let m: *mixed-impl = mem/new(.{ n = 7 })
  assert-equals(m.fancy(3), 3)
  assert-equals(m.to-dyn[mixed].plain(), 7)
  #static assert(test-compile(
    { let m2: *mixed-impl = mem/new(.{ n = 1 }); let d2 = m2.to-dyn[mixed]; d2.fancy(3) }
  ).is-some())
}

fn(test) static-dyn-cannot-reach-runtime() {
  #static assert(test-compile(
    { let d: dyn[counter[t = int]] = #static { let o: *by-ones = mem/new(.{ current = 0 }); o.to-dyn() }; d }
  ).is-some())
}

fn(test) core-abilities-through-dyn() {
  let shown: *int = mem/new(42)
  assert-equals(shown.to-dyn[to-string].to-string(), "42")
  let shown-static: string = #static { let s: *int = mem/new(7); s.to-dyn[to-string].to-string() }
  assert-equals(shown-static, "7")
  let h: *heap = mem/new(.{})
  let a: dyn[allocator] = h.to-dyn()
  let p = a.alloc(16, 8)
  a.free(p, 16, 8)
}

fn(test) self-typed-param-blocks-dyn() {
  assert(test-compile({ let d: ?dyn[equals] = :none; d }).!.contains-string("'equals': parameter 'other' mentions self"))
}

fn(test) ability-args-bind-like-type-args() {
  let ones: *by-ones = mem/new(.{ current = 0 })
  assert(test-compile(ones.to-dyn[counter[t = int, t = string]]).!.contains-string("Duplicate argument for type parameter t"))
  assert(test-compile(ones.to-dyn[counter[n = int]]).!.contains-string("No type parameter named n"))
  assert(test-compile(counter[t = int, t = int]@(by-ones)/bump(ones)).!.contains-string("Duplicate argument for type parameter t"))
  assert(test-compile(counter[int, t = int]@(by-ones)/bump(ones)).!.contains-string("Duplicate argument for type parameter t"))
  assert-equals(ones.to-dyn[counter[int]].bump(), 1)
  assert-equals(counter[int]@(by-ones)/bump(ones), 2)
}
