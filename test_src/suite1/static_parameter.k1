ns static_parameter

fn add-static[i: static int](x: int): int { i + x }

fn scaled[i: static int](x: i): int { #static x * 2 + 1 }

fn quoted[k: static string](): string { #static `"$k"` }

fn(test) static-int-and-string-params() {
  let three: static int = 3
  let folded: int = #static three * 7
  assert-equals(folded, 21)
  assert-equals(scaled[21](21), 43)
  assert-equals(add-static[type-of(three)](3), 6)
  assert-equals(add-static[5](3), 8)
  assert-equals(quoted["id"](), "\"id\"")
  assert-equals(quoted["name"](), "\"name\"")
}
