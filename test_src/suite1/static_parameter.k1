ns static_parameter

fn add-static[i: static int](x: int): int {
  let i: int = core/meta/static-type-to-value[_, i]()
  i + x
}

fn scaled[i: static int](x: i): int { #static(x) x * 2 + 1 }

fn test() {
  let three: static int = 3
  let folded: int = #static(three) three * 7
  assert-equals(folded, 21)
  assert-equals(scaled[21](21), 43)
  assert-equals(add-static[type-of(three)](3), 6)
  assert-equals(add-static[5](3), 8)
}
