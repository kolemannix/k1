ns pre {
  fn no-password[t](): bool {
    require types/schema[t] is :struct s else { return true }
    not s.fields.exists(fn f. f.name == "password")
  }

  fn is-int[t](): bool {
    types/schema[t] is :int _
  }
}

ns type-predicate-test

type int-wrapper[t: pred pre/is-int] = { value: t }

fn foo[t: pred pre/no-password](_t: t) {}

fn test() {
  assert(test-compile(foo(.{ password = "Passw0rd!" })).is-some())
  foo(.{ assword = "Passw0rd!" })
  let _i: int-wrapper[u64] = .{ value = 42 }
  assert(test-compile({ let _s: int-wrapper[string] = .{ value = "" }; .{} }).is-some())
}
