ns zero_test


fn test-bitcast() {
  let x: i32 = -1
  let y: u32 = mem/bitcast(x)
  assert-equals(y, 0xffff_ffff)

  // from agg to agg
  let s: string = "foo"
  let s-wrap = .{ inner = s }
  let s-again: string = mem/bitcast(s-wrap)
  assert-equals(s, s-again)

  // from agg to scalar
  let p2: { x: f32, y: f32 } = .{ x = 1.0, y = -1.0 }
  let scalar = mem/bitcast[_, i64](p2)
  let p3: { x: f32, y: f32 } = mem/bitcast(scalar)
  assert-equals(p2.x, p3.x)
  assert-equals(p2.y, p3.y)

  // from scalar to scalar
  let f: f32 = -3.14159
  let i: i32 = mem/bitcast(f)
  let f2: f32 = mem/bitcast(i)
  assert-equals(f, f2)

  // from scalar to agg
  let ipoint: u32 = 0b0000_0000_0000_0001_0000_0000_0000_0010
  let p: { x: i16, y: u16 } = mem/bitcast(ipoint)
  // Note: endianness-dependent result
  assert-equals(p.y, 1)
  assert-equals(p.x, 2)

  // agg <-> agg with differing alignments
  let pair: { b: u32, c: u32 } = .{ b = 2, c = 3 }
  let wide: { w: u64 } = mem/bitcast(pair)
  let pair2: { b: u32, c: u32 } = mem/bitcast(wide)
  assert-equals(pair2.b, 2)
  assert-equals(pair2.c, 3)

  // pointer <-> int/float scalars
  let val: u64 = 42
  let r: *u64 = val.&
  let ru: u64 = mem/bitcast(r)
  let ri: i64 = mem/bitcast(r)
  let rf: f64 = mem/bitcast(r)
  let from-u: *u64 = mem/bitcast(ru)
  let from-i: *u64 = mem/bitcast(ri)
  let from-f: *u64 = mem/bitcast(rf)
  assert(r == from-u)
  assert(r == from-i)
  assert(r == from-f)
  assert-equals(from-u.*, 42)

  assert(test-compile(
    mem/bitcast[u8, u16](4)
  ).is-some())
}

type zpoint = { x: u8, y: u8, z: i32 }
type zwrap[t] = { inner: t, tag: u8 }

fn zero-of[t](): t { t.0 }

fn returned-zero(): zpoint {
  let(returned) v = .0
  v
}

fn tail-after-newline(bump: i32): zpoint {
  let base = bump
  .0 | .{ z = base }
}

fn test-zero() {
  let filled: { a: int, b: bool, c: string } = .0 | .{ b = true }
  assert-equals(filled.a, 0)
  assert-equals(filled.b, true)
  assert(filled.c == "")

  let v8: u8 = .0
  assert-equals(v8, 0)
  let vi64: i64 = .0
  assert-equals(vi64, 0)

  let vf32: f32 = .0
  assert(vf32 == 0.0)
  let vf64: f64 = .0
  assert(vf64 == 0.0)

  let point: zpoint = .0
  assert-equals(point.x, 0)
  assert-equals(point.y, 0)
  assert-equals(point.z, 0)

  let o: ?zpoint = .0
  assert-equals(o.tag, 0)

  let some-point: ?zpoint = :some .0
  assert-equals(some-point.!.z, 0)

  let p: zpoint = .{ x = 1, y = 2, z = 3 }
  p = .0
  assert-equals(p.y, 0)
  p.z = 9
  p.z = .0
  assert-equals(p.z, 0)

  let with-field: zwrap[zpoint] = .{ inner = .0, tag = 7 }
  assert-equals(with-field.inner.z, 0)
  assert-equals(with-field.tag, 7)

  let nested: zwrap[zpoint] = .0 | .{ inner = .0 | .{ z = 5 } }
  assert-equals(nested.tag, 0)
  assert-equals(nested.inner.z, 5)

  let hinted = .0: zpoint
  assert-equals(hinted.z, 0)

  let named = zpoint.0
  assert-equals(named.x, 0)
  let arr = array[u8, 4].0
  assert-equals(arr.[3], 0)
  let w = zwrap[int].0
  assert-equals(w.inner, 0)
  assert-equals(zero-of[zpoint]().z, 0)
  assert-equals(zero-of[i64](), 0)

  let cond = v8 == 0
  let chosen: zpoint = if cond .0 else .{ x = 1, y = 1, z = 1 }
  assert-equals(chosen.z, 0)

  assert-equals(returned-zero().z, 0)
  assert-equals(tail-after-newline(4).z, 4)
  assert-equals(tail-after-newline(4).x, 0)

  let static-point = #static (.0: { x: u8, y: u8, z: i32 })
  assert-equals(static-point.z.from-static(), 0)
  let runtime-point: { x: u8, y: u8, z: i32 } = static-point
  assert-equals(runtime-point.z, 0)
  let static-w = #static zwrap[int].0
  assert-equals(static-w.tag.from-static(), 0)
  assert-equals(ZERO-POINT.y, 0)

  .{}
}

let ZERO-POINT: zpoint = .0
