ns try_test

type(alias) error = string

type foo = {
  a: bool
}

fn can-fail-int(): result[int, error] { :ok 42 }
fn can-fail-bool(): result[bool, error] { :ok false }

impl try[t = int, e = error] for foo {
  fn error(_e: e): self   { .{ a = false } }
  fn value(_t: t): self { .{ a = true  } }

  fn is-ok(self): bool { self.a }
  fn get-value(_self: self): t  { 3 }
  fn get-error(_self: self): e { "FooError" }
}

fn fails(): result[bool, error] {
  let value: result[int, error] = :err "woops"
  let i = value.try
  :ok(i % 2 == 0)
}

fn run(): result[i32, error] {
  let result: int = can-fail-int().try
  assert(result == 42)
  let result: int = foo.{ a = true }.try
  assert(result == 3)

  let c = fn(-> result[bool, error]) {
    let i = fails().try
    :ok(not i)
  }
  let res = c()
  assert(res is :err "woops")

  :ok 0
}

type abc = either(u8) { a, b, c }
fn get-result(): result[int, error] { :ok(4) }

fn unwrap-expected-type() {
  let from-value: abc = enum/enum-from-value(2).!
  assert(from-value is :c)
  let parsed: u64 = u64/from-string("42").!
  assert-equals(parsed, 42)
  let res: int = get-result().!
  assert-equals(res, 4)
  let lit: int = :some(3).!
  assert-equals(lit, 3)
}

fn test() {
  assert(run().is-ok())
  unwrap-expected-type()
}
