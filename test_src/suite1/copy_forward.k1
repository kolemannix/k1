ns copy_forward

type pair = { a: i64, b: i64 }
type quad = { a: i64, b: i64, c: i64, d: i64 }
type wire = packed { tag: u8, p: pair }

fn(noinline) bump-then-read(v: pair, p: *pair): i64 {
  p.a = p.a + 100
  v.a
}

fn(noinline) swapped(q: quad): quad {
  let(returned) r: quad = .{ a = 0, b = 0, c = 0, d = 0 }
  r.a = q.b
  r.b = q.a
  r.c = q.d
  r.d = q.c
  r
}

fn val(x: i64): i64 { x }

fn(noinline) copy-through(dst: *pair, src: *pair) {
  let t = src.*
  dst.* = t
  dst.b = dst.b + val(0)
}

fn(noinline) source-written-by-reading-call() {
  let s: pair = .{ a = val(1), b = 2 }
  let t = s
  assert-equals(bump-then-read(t, s.&), 1)
  assert-equals(s.a, 101)
}

fn(noinline) source-written-after-copy() {
  let s: pair = .{ a = val(1), b = 2 }
  let t = s
  s.a = 5
  assert-equals(t.a, 1)
  assert-equals(s.a, 5)
}

fn(noinline) call-result-reads-destination() {
  let d: quad = .{ a = val(1), b = 2, c = 3, d = 4 }
  d = swapped(d)
  assert-equals(d.a, 2)
  assert-equals(d.d, 3)
  let t = swapped(d)
  d = t
  assert-equals(d.a, 1)
  assert-equals(d.b, 2)
  assert-equals(d.c, 3)
  assert-equals(d.d, 4)
}

fn(noinline) literal-reads-destination() {
  let x: pair = .{ a = val(1), b = 2 }
  x = .{ a = x.b, b = x.a }
  assert-equals(x.a, 2)
  assert-equals(x.b, 1)
}

fn(noinline) forwarded() {
  let s: pair = .{ a = val(3), b = 4 }
  let t = s
  assert-equals(t.a + t.b, 7)
  let d: pair = .{ a = 0, b = 0 }
  d = .{ a = t.b, b = t.a }
  assert-equals(d.a, 4)
  assert-equals(d.b, 3)
  let w: wire = .{ tag = 9, p = .{ a = 5, b = 6 } }
  let u = w.p
  assert-equals(u.a + u.b, 11)
}

fn(noinline) through-pointers() {
  let x: pair = .{ a = val(7), b = 8 }
  let y: pair = .{ a = 0, b = 0 }
  copy-through(y.&, x.&)
  assert-equals(y.b, 8)
  copy-through(x.&, x.&)
  assert-equals(x.a, 7)
  assert-equals(x.b, 8)
}

fn test() {
  source-written-by-reading-call()
  source-written-after-copy()
  call-result-reads-destination()
  literal-reads-destination()
  forwarded()
  through-pointers()
}
