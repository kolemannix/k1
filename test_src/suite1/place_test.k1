ns place_test

type inner = { a: int, b: int }
type outer = { name: string, inner: inner }
type shape = either { circle({ radius: int, filled: bool }), point }

ns for inner {
  fn me(*self): *inner { self }
}

fn(test) refs-to-nested-places() {
  let outer: outer = .{ name = "hi", inner = .{ a = 11, b = 22 } }
  let outer-ref = outer.&
  let inner-ref = outer-ref.inner.&
  assert(outer-ref.inner.me().as[ptr] == inner-ref.as[ptr])
  outer-ref.inner.me().a = 99
  assert-equals(outer.inner.a, 99)

  let arr: array[int, 3] = .0
  let arr-ref = arr.&
  let elem-ref = arr-ref.[2].&
  elem-ref.* = 30
  assert-equals(arr.[2], 30)

  let points: array[inner, 2] = .0
  points.[0].a = 100
  let point-b-ref = points.[1].b.&
  point-b-ref.* = 201
  assert-equals(points.[0].a, 100)
  assert-equals(points.[0].b, 0)
  assert-equals(points.[1].b, 201)

  let shape: shape = :circle .{ radius = 5, filled = false }
  if shape.& is {
    :circle c* -> {
      c.radius = 10
      c.filled = true
    },
    _ -> crash("expected a circle")
  }
  assert(shape is :circle .{ radius = 10, filled = true })
  let inner-ref = outer.inner.&
  assert(test-compile(inner/me(inner-ref.&)) is :some m and m.starts-with("Expected *inner but got **inner"))
}
