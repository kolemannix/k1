ns matching_if

type(alias) ABC = either { a, b, c }

fn match-struct(v: { x: int, y: int }): ABC {
  if v is {
    .{ x = 11 } -> :a,
    .{ x = xx, y = yy } if xx == 1 or yy == 2 -> :b,
    _ -> :c
  }
}

fn test() {
  let foo = 3
  let x = some("foo")
  let y = some("bar")
  let result = if x is :some v and y is :some "bar" and foo == 3 {
    v == "foo"
  } else (false)
  assert(result)
  let rewrapped: ?string = if x is :some v :some v else :none
  assert-equals(rewrapped.!, "foo")

  assert(test-compile(
    if x is :some(illegal_binding) or true .{
      illegal_binding
    }
  ) is :some _)

  let my-point = .{ x = 1, y = 2 }
  let struct-result = if my-point is .{ x = 1, y = yy } and my-point is .{ x = xx, y = 2 } {
    yy == 2 and xx == 1
  } else (false)
  assert(struct-result)

  let partial = some(.{ x = some(42), y = none[int]() })
  if partial is :some .{ x = :some x-val, y = :some y-val } crash("")

  let mixed = some(.{ outer = 1, inner = some(.{ value = 1 }) })
  let mixed-result = if mixed is :some .{ outer = o, inner = :some .{ value = v } } {
    o == v
  } else (false)
  assert(mixed-result)
  assert(test-compile({
    if mixed is :some(.{ outer = o, inner = :some(.{ value = o })}) .{} else .{}
  }).is-some())

  assert(match-struct(.{ x = 11, y = 0 }) is :a)
  assert(match-struct(.{ x = 1, y = 3 }) is :b)
  assert(match-struct(.{ x = 0, y = 2 }) is :b)
  assert(match-struct(.{ x = 0, y = 0 }) is :c)

  require .{ x = 1 } is .{ x } and x == 1 and true is _ else crash("")
  assert(x == 1)
}
