ns ability_dotcall

ability a-source[impl t] {
  fn next(self: *mut self): ?t
}

type source[t] = {
  state: ptr,
  next-fn: *fn(ptr) -> ?t,
}

ns for source {
  fn next[t](self: source[t]): ?t {
    (self.next-fn)(self.state)
  }

  fn erase[t, s](inst: *mut s): source[t] where s: a-source[t = t] {
    .{
      state = inst.as[ptr],
      next-fn = fn(p: ptr) p.rw[s]().next(),
    }
  }
}

type repeats[t] = { data: t }
impl[t] a-source[t = t] for repeats[t] {
  fn next(self: *mut repeats[t]): ?t {
    :some self.data
  }
}

type count-up = { current: int, limit: int }
impl a-source[t = int] for count-up {
  fn next(self: *mut count-up): ?int {
    if self.current >= self.limit { return :none }
    self.current = self.current + 1
    :some self.current
  }
}

fn test() {
  let r: *mut repeats[int] = mem/new(.{ data = 42 })
  let src: source[int] = source/erase(r)
  assert-equals(src.next(), :some 42)

  let c: *mut count-up = mem/new(.{ current = 0, limit = 2 })
  let src2: source[int] = source/erase(c)
  assert-equals(src2.next(), :some 1)
  assert-equals(src2.next(), :some 2)
  assert-equals(src2.next(), :none)
}
