ns assign

fn min-or(a: ?u32, b: u32): u32 {
  if a is {
    :none -> b,
    :some x -> x.min(b)
  }
}

fn test() {
  let v: ?u32 = :none
  v = :some(min-or(v, 2))
  assert(v is :some 2)

  let r = v.&
  r.* = :some(min-or(r.*, 1))
  assert(v is :some 1)

  let cell: { v: ?u32 } = .{ v = :none }
  cell.v = :some(min-or(cell.v, 3))
  assert(cell.v is :some 3)
}
