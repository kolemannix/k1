ns assign

fn assign-var() {
  let count = 0
  count = 1
  assert(count == 1)
  count = 2
  assert(count == 2)
}

fn complex-references() {
  let struct-ref = .{ x = 42 }
  let struct-ref = &struct-ref

  let x-value: int = struct-ref.x
  let x-ref: *mut int = &struct-ref.x

  assert(x-ref.* == x-value)
  assert(struct-ref.*.x == struct-ref.x)

  x-ref.* = -10

  assert(x-ref.* == -10)

  struct-ref.x = 42
  assert(x-ref.* == 42)

  let either-ref: either { yes(int), no } = :yes 3
  let either-ref = &either-ref

  let yes-ref: *(type-of(either-ref).value:yes) = either-ref.as-yes().!

  assert(yes-ref.* == 3)
  let yes-value: int = either-ref.as-yes().!
  assert(yes-value == 3)

  either-ref.as-yes().!.* = -3

  assert(yes-ref.* == -3)
  assert(either-ref.as-yes().!.* == -3)

  let inner-struct-ref = .{ x = 42 }
  let inner-struct-ref = &inner-struct-ref
  let struct-opt-ref: ?*{ x: int } = :some inner-struct-ref

  if struct-opt-ref is :some x {
    assert(x.x == 42)
    x.x = 43
    assert(x.x == 43)
  } else {
    crash("None")
  }

  .{}
}

fn min-or(a: ?u32, b: u32): u32 {
  if a is {
    :none -> b,
    :some x -> if x < b x else b
  }
}

fn self-referential-rhs() {
  let v: ?u32 = :none
  v = :some(min-or(v, 2))
  assert(if v is { :some x -> x == 2, :none -> false })

  let r = &v
  r.* = :some(min-or(r.*, 1))
  assert(if v is { :some x -> x == 1, :none -> false })

  let cell: { v: ?u32 } = .{ v = :none }
  cell.v = :some(min-or(cell.v, 3))
  assert(if cell.v is { :some x -> x == 3, :none -> false })
}

fn test() {
  assign-var()
  complex-references()
  self-referential-rhs()
}
