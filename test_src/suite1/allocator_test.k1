ns allocator_test

fn test() {
  let a = core/arena/init-default()

  let _ = a.push(true)
  let _ = a.push(.{ x = 10, y = 10 })
  let s = a.push("Hello, memory")
  assert(s.len() == 13)
  assert-equals(s.*, "Hello, memory")

  a.release()

  let p = mem/new-in-place[point](mem/system-heap, .{ x = 4, y = 5 })
  assert-equals(p.*, .{ x = 4, y = 5 })

}

type point = { x: int, y: int }

