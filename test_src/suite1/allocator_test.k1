ns allocator_test

fn(test) push-and-new-in-place() {
  let a = core/arena/init-default()

  a.push(true)
  a.push(.{ x = 10, y = 10 })
  let s = a.push("Hello, memory")
  assert(s.len() == 13)
  assert-equals(s.*, "Hello, memory")

  a.release()

  let p = mem/new-in-place[point](.{ x = 4, y = 5 })
  assert-equals(p.*, .{ x = 4, y = 5 })
}

fn(test) fixed-buffer-arena-and-handles() {
  let storage: array[byte, 1024] = .0
  let bytes = storage.&.as-buffer()
  let a = core/arena/init-from-buffer(bytes.slice(3, bytes.len))
  assert(a.fixed and a.as[ptr].to-size() % types/align[core/arena] == 0)
  let kid = a.push-handle(7)
  assert-equals(a.get(a.get-many(a.push-many([kid, kid])).[1]).*, 7)
  assert-equals(a.get-many(a.handle-from-many(span/empty[int]())).len, 0)
  a.release()
  assert-equals(storage.[1023], 0)
}

fn(test) pop-to-mark-frees-extra-chunks() {
  let a = core/arena/init(256)
  let keep = a.push(7: u64)
  let m = a.mark()
  a.alloc-buffer[u64](4).fill(3)
  for i in 0.until(100) {
    a.push(i.unsigned() + 1)
  }
  assert(not a.extra-chunks.is-null())
  a.pop-to-mark(m)
  assert(a.extra-chunks.is-null())
  assert-equals(keep.*, 7)
  assert-all-zero(a.alloc-buffer[u64](16))

  a.reset()
  a.alloc-buffer[u64](8).fill(4)
  let chunk-m = a.mark()
  for i in 0.until(100) {
    a.push(i.unsigned() + 1)
  }
  let inner = a.mark()
  a.push(9: u64)
  a.pop-to-mark(inner)
  a.pop-to-mark(chunk-m)
  assert(a.extra-chunks.is-null())
  assert-all-zero(a.alloc-buffer[u64](4))
  a.release()
}

fn assert-all-zero(b: buffer[u64]) {
  for i in 0.until(b.len) {
    assert-equals(b.[i], 0)
  }
}

fn(test) reset-and-pop-zero-memory() {
  let a = core/arena/init(512)
  a.alloc-buffer[u64](16).fill(7)
  a.reset()
  assert-all-zero(a.alloc-buffer[u64](16))

  let m = a.mark()
  a.alloc-buffer[u64](8).fill(9)
  a.pop-to-mark(m)
  assert-all-zero(a.alloc-buffer[u64](8))

  a.pop-to-mark(m)
  a.alloc-buffer[u64](4).fill(5)
  a.pop-to-mark(m)
  let base = a.alloc(8, 8)
  base.ref[u64].* = 1
  let grown = a.realloc(base, old-size = 8, align = 8, new-size = 32)
  assert-equals(grown, base)
  let tail: buffer[u64] = buffer/wrap-raw(grown.add-bytes(8), 3)
  assert-all-zero(tail)

  for i in 0.until(100) {
    a.push(i.unsigned() + 1)
  }
  assert(not a.extra-chunks.is-null())
  a.reset()
  assert-all-zero(a.alloc-buffer[u64](48))
  a.release()
}

fn(test) growth-chains-chunks() {
  // Tiny first chunk so growth chains within a few pushes
  let a = core/arena/init(256)
  let first = a.push(1: u64)
  let ptrs = list/with-capacity-in[t = *u64](mem/tmp(), 100)
  for i in 0.until(100) {
    ptrs.push-in(mem/tmp(), a.push(i.unsigned()))
  }
  // Every allocation survives across chunk boundaries
  assert-equals(first.*, 1)
  for i in 0.until(100) {
    assert-equals(ptrs.[i].*, i.unsigned())
  }
  assert(not a.extra-chunks.is-null())
  assert(not a.extra-chunks.ref[core/arena-chunk].next.is-null())

  a.reset()
  assert(a.extra-chunks.is-null())
  let after-reset = a.push(42: u64)
  assert-equals(after-reset.*, 42)

  a.release()
}

fn generic-new[a: allocator](alloc: a, value: int): *int {
  alloc.new(value)
}

fn(test) allocator-ability-on-arena-and-heap() {
  let a = core/arena/init-default()
  let p = generic-new(a, 42)
  assert-equals(p.*, 42)
  // free on an arena is a no-op
  a.free-t(p)
  assert-equals(p.*, 42)

  let hp = generic-new(heap, 7)
  assert-equals(hp.*, 7)
  heap.free-t(hp)

  // grow through the ability: realloc preserves contents
  let base = a.alloc(8, 8)
  base.ref[int].* = 55
  let grown = a.realloc(base, old-size = 8, align = 8, new-size = 64)
  assert-equals(grown.ref[int].*, 55)

  a.release()
}

fn(test) pop-to-mark-reuses-space() {
  let a = core/arena/init-default()
  let before = a.push(11)
  let m = a.mark()
  let scratch1 = a.push(22)
  let scratch1-addr = scratch1.as[ptr]
  a.push("scratch string")
  a.pop-to-mark(m)
  assert-equals(before.*, 11)
  // freed space is reused: next allocation lands where scratch1 was
  let after = a.push(33)
  assert-equals(after.as[ptr], scratch1-addr)
  // popping to the same mark twice is legal (idempotent)
  a.pop-to-mark(m)
  a.release()
}

type point = { x: int, y: int }

