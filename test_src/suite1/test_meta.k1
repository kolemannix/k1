// If you'd like to write some code that you need available
// for metaprogramming, you can place it in your module's `pre`
// namespace. The pre namespace is not different than any other
// namespace, except that it gets fully compiled before the rest
// of its enclosing module.

// It's effectively the same thing as defining a 
// separate module, but more convenient

// Usage can even appear above the pre ns
#meta pre/make-point("my-meta-point")

// Macros are invoked at definition level with the '$' sentinel;
// bare params arrive as source text, so the name is a bare ident
$pre/make-point-macro(my-macro-point)
$pre/make-point-twice(my-nested-point)
$pre/define-scaled(3)
#meta pre/emit-pi-use()
#meta { let _ = emitted-pi; "" }

ns pre {
  let pi: f32 = 3.14
  fn make-point(name: string): code {
    "type $name = { x: i32, y: i32 }"
  }
  macro make-point-macro(name: code) {
    "type $name = { x: i32, y: i32 }"
  }
  macro make-point-twice(name: code) {
    "\$pre/make-point-macro($name)"
  }
  macro define-scaled(factor: code) {
    `macro scaled(x: code) { pre/scaled-code(x, $factor) }`
  }
  fn scaled-code(x: code, factor: int): code { "($x * $factor)" }
  fn emit-pi-use(): code { "use pre/pi as emitted-pi" }
  macro define-name-of(t: types/type-id, tag: int) {
    "ns for ${t.name()} { fn name-of(): string { ${meta/str-lit(t.name())} } fn tag-of(): int { $tag } }"
  }
}

ns test_meta

// Static args see every source definition in the module, even ones below
$pre/define-name-of(types/id[forward-command], tagged@(forward-command)/tag())

fn simple-increment(): i32 {
  let x = 10
  #meta {
    let code = string-builder/new()
    for 0.until(5) {
      code.writeln("x = x + 1;")
    }
    code/from-string(code.build())
  }
  assert-equals(x, 15)

  0
}

use core/writer
use types/type-schema

fn _write-json-from-schema(code: *string-builder, name: string, type-id: types/type-id) {
  if type-id.elem-of[list] is :some elem {
    code.writeln("w.write-char('[');")
    code.writeln(`for $name { if it-index > 0 { w.write(",") }`)
    _write-json-from-schema(code, "it", elem)
    code.writeln("}")
    code.writeln("w.write-char(']');")
    return
  }
  if type-id.schema() is {
    :struct s -> {
      code.writeln("w.write-char('{');")
      for f in s.fields {

        let field-let-name = `_$name${f.name}`

        code.write(
`let $field-let-name = $name.${f.name};
w.write("\"${f.name}\":");
`
       ) //" fix quote

        _write-json-from-schema(code, field-let-name, f.type-id)
        let last = it-index == s.fields.len() - 1
        if not last {
          code.writeln(`w.write(",");`)
        }
      }
      code.writeln(`w.write-char('}');`)
    },
    :bool -> {
      code.writeln(`w.write(if $name "true": string else "false");`)
    },
    :int _ -> code.writeln(`$name.print-to(w);`),
    :either _ -> {
      let t-name = type-id.name()
      crash("Cannot yet create a JSON writer for either: $t-name")
    },
    _ -> {
      code.writeln(`w.write(\`"other"\`)`)
    }
  }
}

fn write-json[t, w: writer](context w)(t: t) {
  #meta {
    let type-id = types/id[t]()
    let code = string-builder/new()
    _write-json-from-schema(code.&, "t", type-id)
    code/from-string(code.build())
  }
}

fn to-json[t](t: t): string {
  let w = list/empty[char]()
  write-json(context w.&)(t)
  let s = string/wrap-list(w)
  s
}

fn(test) json-from-schema() {
  assert-equals(to-json(true), "true")
  let json1 = to-json(.{ x = 1, y = 2, z = .{}, d = false })
  assert-equals(json1, `{"x":1,"y":2,"z":{},"d":false}`)
  let xs: list[int] = [1, 2, 3]
  assert-equals(to-json(.{ xs, ps = [.{ a = true }] }), `{"xs":[1,2,3],"ps":[{"a":true}]}`)

  .{}
}

fn(test) meta-generated-code() {
  simple-increment()

  let _x: my-meta-point = .{ x = 0, y = 42 }
  let _y: my-macro-point = .{ x = 1, y = 2 }
  let _z: my-nested-point = .{ x = 3, y = 4 }
  assert-equals(scaled(5), 15)
  assert-equals(forward-command/name-of(), "forward-command")
  assert-equals(forward-command/tag-of(), 7)
  pre/pi
  
  .{}
}

type forward-command = either { go(forward-payload) }
type forward-payload = { x: i32 }
ability tagged { fn tag(): int }
impl tagged for forward-command { fn tag(): int { 7 } }
#meta { "let tag-points: bool = true" }
#if tag-points impl tagged for my-macro-point { fn tag(): int { 9 } }
