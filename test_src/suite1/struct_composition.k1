ns struct_composition

type positioned = { x: int, y: int }
type text = #type types/combine-structs[{ text: string, x: int }, positioned]()
type user = { name: string, password: string }
type user-view = #type types/remove-fields[user](["password"])

fn(test) combine-and-remove-fields() {
  let t: text = .{ text = "hi", x = 1, y = 2 }
  assert(t is .{ text = "hi", y = 2 })
  assert-equals(types/size[text](), 32)
  assert-equals(types/size[user-view](), 16)
  assert(test-compile(#static types/remove-fields[user](["email"])) is :some e1 and e1.contains-string("no field email"))
  assert(test-compile(#static types/combine-structs[user, { name: int }]()) is :some e2 and e2.contains-string("field name"))
  assert(test-compile(#static types/combine-structs[user, union { a: int }]()) is :some e3 and e3.contains-string("is a union"))
}
