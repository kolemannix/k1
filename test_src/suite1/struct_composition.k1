ns struct_composition

type positioned = { x: int, y: int }
type text = _struct_combine[{ text: string, x: int }, positioned]
type user = { name: string, password: string }
type user-view = _struct_remove[user, { password: string }]

fn(test) combine-and-remove-fields() {
  let t: text = .{ text = "hi", x = 1, y = 2 }
  assert(t is .{ text = "hi", y = 2 })
  assert-equals(types/size[text](), 32)
  assert-equals(types/size[user-view](), 16)
}
