ns lexical_scope

fn test() {
  let result = test-compile({
    { let _foo = 100 }
    assert(_foo == 100)
  })
  assert(
    result is :some msg
    and msg.starts-with("No value '_foo' is in scope")
  )

  let u = {}
  assert(u == .{})
  let v: {} = {}
  assert(v == u)
  while false {}
  let w = if true {} else {}
  assert(w == u)
}
