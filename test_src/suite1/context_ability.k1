ns context_ability

ability tagged { fn tag(self): int }
impl tagged for int {
  fn tag(self): int { self + 1 }
}
impl tagged for bool {
  fn tag(self): int { if self { 100 } else { 200 } }
}

fn greet[w: writer](context out: w)(name: string) {
  out.write("Hello, ")
  out.write(name)
}

fn excited-greet[w: writer](context out: w)(name: string) {
  greet(name)
  out.write("!")
}

fn log-concrete(context out: *string-builder)(m: string) {
  out.write(m)
}

fn add-then[t: add](context c: t)(v: t, f: some fn t -> t): t { f(v + c) }

fn tag-context[t: tagged](context c: t)(): int {
  c.tag()
}

fn tag-both[t: tagged](context c: t)(value: t): int {
  c.tag() + value.tag()
}

fn tag-string[t: tagged and equals and to-string](context c: t)(): string {
  c.to-string()
}

fn(test) writer-context-reaches-nested-calls() {
  let sb = string-builder/new()
  let(context(impl writer)) out: *string-builder = sb.&
  excited-greet("Ana")
  log-concrete(" plain")
  assert(sb.build() == "Hello, Ana! plain")
}

fn(test) tagged-context-explicit-and-shadowed() {
  let(context(impl tagged)) flag = true
  assert(tag-context() == 100)
  assert(tag-context(context 41)() == 42)
  assert(test-compile(tag-both(5)) is :some(_))
  assert(tag-both(context 10)(5) == 17)

  let inner-result = {
    let(context(impl tagged)) inner = 1
    tag-context()
  }
  assert(inner-result == 2)

  let all-result = {
    let(context(impl tagged, equals, to-string)) all = 5
    let partial-result = {
      let(context(impl tagged)) _partial = true
      tag-string()
    }
    partial-result
  }
  assert(all-result == "5")
}

fn(test) context-resolved-after-inference-before-fnlike() {
  let(context) c: int = 5
  assert-equals(add-then(1, fn x. x * 2), 12)
}

fn(test) location-names-enclosing-fn() {
  let f = fn() k1/location().function
  assert-equals(f(), "suite1/context_ability/location-names-enclosing-fn")
}
