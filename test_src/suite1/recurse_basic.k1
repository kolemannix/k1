ns recurse_basic {
  type node = { node: *node }
  type tree = either { leaf, node(*tree) }

  fn make(n: size): *node {
    if n <= 0 ptr/null.ref[node] else mem/new(.{ node = make(n - 1) })
   }

  fn count(n: *node): size {
    if n.as[ptr].is-null() 0 else 1 + count(n.node)
  }

  fn emake(n: size): tree {
    if n == 0 :leaf else :node mem/new(emake(n - 1))
  }

  fn ecount(en: tree): size {
    en is {
      :leaf -> 0,
      :node child -> 1 + ecount(child.*)
    }
  }

  type expr = either { leaf(i64), many(list[expr]) }

  fn derived-eq() {
    let a: expr = :many([:leaf(1), :many([:leaf(2)])])
    let b: expr = :many([:leaf(1), :many([:leaf(2)])])
    let c: expr = :many([:leaf(1), :many([:leaf(3)])])
    assert(a == b)
    assert(a != c)

    let xs: list[expr] = [:leaf(7)]
    for x in xs { assert(x == a or x != a) }
    let seven: expr = :leaf(7)
    let eight: expr = :leaf(8)
    assert(xs.contains(seven))
    assert(not xs.contains(eight))
  }

  fn reca(n: size): size {
    if n == 0 0 else 1 + recb(n - 1)
  }
  fn recb(n: size): size {
    ind-reca(n)
  }
  fn ind-reca(n: size): size {
    reca(n)
  }
  fn self-rec(n: size): size {
    if n == 0 0 else 1 + self-rec(n - 1)
  }

  fn test() {
    assert-equals(reca(5), 5)
    assert-equals(self-rec(6), 6)
    let static-reca: size = #static reca(7)
    let static-self-rec: size = #static self-rec(8)
    assert-equals(static-reca, 7)
    assert-equals(static-self-rec, 8)
    let node = make(4)
    assert-equals(count(node), 4)
    let enode = emake(10)
    assert-equals(ecount(enode), 10)
    derived-eq()
  }

}
