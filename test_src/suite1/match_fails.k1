ns match_fails

type foo = { x: int, y: ?bool }
fn useless() {
  let foo: foo = .{ x = 1, y = :none }
  let result = test-compile(if foo is {
    .{ x, y = :some(true) } -> x,
    .{ x, y = :some(false) } -> x,
    .{ x, y = :some(false) } -> x,
    .{ x, y = :none } -> x + 2
  })
  assert(result is :some(_))
}

type blub = { x: int, y: ?bool }

type recursive-tree = either { leaf, node(*recursive-tree) }

fn unhandled() {
  let blub: blub = .{ x = 1, y = :none }
  let result = test-compile(if blub is {
    .{ x, y = :some(true) } -> x,
    .{ x, y = :none } -> x + 2
  })
  assert(result is :some(_))
}

fn recursive-unhandled() {
  let tree: recursive-tree = :leaf
  let result = test-compile(if tree is {
    :leaf -> 0,
    :node(:leaf*) -> 1
  })
  assert(result is :some(_))
}

fn recursive-useless() {
  let tree: recursive-tree = :leaf
  let result = test-compile(if tree is {
    :leaf -> 0,
    :node(_) -> 1,
    :node(:leaf*) -> 2
  })
  assert(result is :some(_))
}

fn correlated-fields-are-not-independent() {
  let pair = .{ a = false, b = false }
  let result = test-compile(if pair is {
    .{ a = false, b = false } -> 0,
    .{ a = true, b = true } -> 1
  })
  assert(result is :some(_))
}

fn guard-not-bool() {
  let x: int = 3
  let result = test-compile(if x is {
    y if y -> y,
    _ -> 0
  })
  assert(result is :some(_))
}

fn test() {
  useless()
  unhandled()
  recursive-unhandled()
  recursive-useless()
  correlated-fields-are-not-independent()
  guard-not-bool()
}
