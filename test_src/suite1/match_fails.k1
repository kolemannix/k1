ns match_fails

type foo = { x: int, y: ?bool }
fn useless() {
  let foo: foo = .{ x = 1, y = :none }
  let result = test-compile(foo is {
    .{ x, y = :some(true) } -> x,
    .{ x, y = :some(false) } -> x,
    .{ x, y = :some(false) } -> x,
    .{ x, y = :none } -> x + 2
  })
  assert(result is :some(_))
}

type blub = { x: int, y: ?bool }
fn unhandled() {
  let blub: blub = .{ x = 1, y = :none }
  let result = test-compile(blub is {
    .{ x, y = :some(true) } -> x,
    .{ x, y = :none } -> x + 2
  })
  assert(result is :some(_))
}

fn guard-not-bool() {
  let x: int = 3
  let result = test-compile(x is {
    y if y -> y,
    _ -> 0
  })
  assert(result is :some(_))
}

fn test() {
  useless()
  unhandled()
  guard-not-bool()
}
