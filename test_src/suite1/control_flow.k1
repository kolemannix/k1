ns control_flow

fn return-from-if(): int {
  let _x: {} = if true {
    return 1
  }
  0
}

fn(test) if-without-else-yields-unit() {
  let x = 0
  let expr: {} = if true {
    x = 42
  }
  assert(x == 42)
  assert(expr == .{})
  let _never: {} = if false {
    crash("never happens")
  }
  assert(return-from-if() == 1)
}

fn(test) loop-break-values() {
  let three: int = loop {
    let _inner: int = if true {
      break 3
    } else 4
  }
  assert-equals(three, 3)
  let y: string = loop {
    break "asdf"
  }
  assert-equals(y, "asdf")
  let nested = loop {
    break loop { break(10) }
  }
  assert-equals(nested, 10)
}

fn(test) break-exits-inner-for-only() {
  let pairs = list/empty[string]()
  for i in 0.until(3) {
    for j in 0.until(3) {
      if j == 1 break
      pairs.push("${i}${j}")
    }
    pairs.push("o$i")
  }
  assert-equals(pairs.join(","), "00,o0,10,o1,20,o2")
}

fn(test) break-runs-iteration-defers() {
  let log = list/empty[string]()
  for i in 0.until(5) {
    defer log.push("d$i")
    if i == 2 break
    log.push("b$i")
  }
  assert-equals(log.join(","), "b0,d0,b1,d1,d2")
}

fn(test) break-in-for-inside-valued-loop() {
  let n = 0
  let total: int = loop {
    for i in 0.until(10) {
      if i == 4 break
      n = n + 1
    }
    break n
  }
  assert-equals(total, 4)
}
