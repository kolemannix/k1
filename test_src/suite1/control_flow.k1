ns control_flow

fn if-basic(): int {
  let cond: bool = false
  let result: int = if cond 42 else 1337
  assert(result == 1337)
  0
}

fn if-no-else(): int {
  // Gets empty type
  let x = 0
  let expr: {} = if true {
    x = 42
  }
  assert(x == 42)
  assert(expr == .{})

  // Even if one branch is 'never'
  let _expr: {} = if false {
    crash("never happens")
  }
  0
}

fn return-simple(): bool {
  return true
}

fn rand(): bool { true }
fn return-from-if(): int {
  let _x: {} = if rand() {
    return 1
  }

  0
}

fn loop-break() {
  // break with scalar
  let x: int = loop {
    let _inner: int = if true {
      break 3
    } else 4
    
  }
  assert-equals(x, 3)

  // break with aggregate
  let y: string = loop {
    break "asdf"
  }
  assert-equals(y, "asdf")
}

fn loop-nested() {
  let result = loop {
    break loop { break(10) }
  }
  assert-equals(result, 10)
}

fn loop-false() {
  let x = loop {
    break 3
  }
  assert(x == 3)
}

fn for-break() {
  let count = 0
  for 0.until(10) {
    if it >= 4 { break }
    count = count + 1
  }
  assert-equals(count, 4)
}

fn do-crash(): bool {
  crash("should not run")
}

fn for-break() {
  let seen = list/empty[int]()
  for i in 0.until(10) {
    if i == 3 break
    seen.push(i)
  }
  assert-equals(seen.join(","), "0,1,2")

  let pairs = list/empty[string]()
  for i in 0.until(3) {
    for j in 0.until(3) {
      if j == 1 break
      pairs.push("${i}${j}")
    }
    pairs.push("o$i")
  }
  assert-equals(pairs.join(","), "00,o0,10,o1,20,o2")

  let log = list/empty[string]()
  for i in 0.until(5) {
    defer log.push("d$i")
    if i == 2 break
    log.push("b$i")
  }
  assert-equals(log.join(","), "b0,d0,b1,d1,d2")

  let n = 0
  let total: int = loop {
    for i in 0.until(10) {
      if i == 4 break
      n = n + 1
    }
    break n
  }
  assert-equals(total, 4)
}

fn test() {

  if-basic()
  if-no-else()
  assert(return-simple())
  assert(return-from-if() == 1)

  // Short-circuiting is guaranteed
  if (false and do-crash()) .{}

  loop-break()
  loop-nested()
  loop-false()
  for-break()
}
