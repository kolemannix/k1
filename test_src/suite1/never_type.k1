ns never_type

type nv = { x: never }
type e-never = either { a(int), b(never) }
type e-nv = either { a(int), b(nv) }

fn infallible(): result[int, never] { :ok 7 }
fn infallible-nv(): result[int, nv] { :ok 7 }

fn try-into-fallible(): result[int, string] {
  let a = infallible().try
  let b = infallible-nv().try
  :ok(a + b)
}
fn try-into-infallible(): result[int, never] {
  let a = infallible().try
  let b = infallible-nv().try
  :ok(a + b)
}
fn try-into-plain(): int { infallible().try + infallible-nv().try }

fn parse-name(s: string): result[string, never] { from-string/from-string(s) }
fn hostname(s: string): int { parse-name(s).try.len() }

fn parse-all[e, t: from-string[e = e]](items: span[string]): result[list[t], e] {
  let out: list[t] = []
  for s in items {
    out.push(from-string@(t)/from-string(s).try)
  }
  :ok out
}

fn ref-payload-is-inhabited(r: result[int, *never]): int {
  if r is { :ok v -> v, :err _ -> -1 }
}

fn run() {
  assert-equals(try-into-fallible(), :ok 14)
  assert-equals(try-into-infallible().!, 14)
  assert-equals(try-into-plain(), 14)
  assert-equals(hostname("k1.dev"), 6)

  assert-equals(infallible().!, 7)
  assert-equals(infallible-nv().!, 7)
  assert-equals(infallible() ? 0, 7)
  assert-equals(infallible-nv() ? 0, 7)
  assert(infallible() is :ok 7)
  assert(infallible-nv() is :ok 7)
  assert-equals(if infallible() is { :ok v -> v }, 7)
  assert-equals(if infallible-nv() is { :ok v -> v }, 7)

  assert-equals("${infallible()}", ":ok(7)")
  assert-equals("${infallible-nv()}", ":ok(7)")
  assert(infallible() == infallible())
  assert(infallible-nv() == infallible-nv())

  let en: e-never = :a 3
  let env: e-nv = :a 3
  assert-equals(if en is { :a v -> v }, 3)
  assert-equals(if env is { :a v -> v }, 3)
  assert-equals("$en", ":a 3")
  assert-equals("$env", ":a 3")
  assert(en == en)
  assert(env == env)

  assert-equals(types/size[never], 0)
  assert-equals(types/align[never], 1)
  assert-equals(types/size[nv], 0)
  assert-equals(types/size[{ p: *never }], 8)
  assert-equals(types/size[result[int, never]], 16)
  assert-equals(ref-payload-is-inhabited(:ok 5), 5)

  let names = if parse-all[never, string](["ada", "grace"]) is { :ok v -> v }
  assert-equals(names.len(), 2)
  assert(parse-all[string, u64](["1", "x"]) is :err _)
}

fn test() {
  run()
  #static run()
}
