ns struct_test

type patch-pair[t] = { first: t, second: t }
type nom-point = { x: int, y: int }
type nom-wrap[t] = { inner: t }
ns for nom-point {
  fn sum(self: nom-point): int { self.x + self.y }
}
fn identity[t](v: t): t { v }

type point = { x: int, y: int, z: int, is-good: bool }
fn basic-struct(): int {
  let zero: point = .{
    x = 0, y = 298, z = 42, is-good = true
  }
  assert(zero.x == 0)
  assert(zero.z == 42)
  assert(zero.is-good)
  assert(zero.y == 298)
  0
}

type foo = { x: int, y: bool }
ns for foo {
  fn get-value(self: foo): int { self.x }
  fn set-value(self: *mut foo, x: int) { self.x = x; }
  fn new(x: int): foo { .{ x = x, y = false } }
}

fn struct-arg-mut() {
  let x = foo/new(42)
  let x = x.&
  assert(x.x == 42)
  assert(x.get-value() == 42)
  x.set-value(41)
  assert(x.get-value() == 41)
  assert(not x.y)
}

impl equals for { a: int } {
  fn equals(self: { a: int }, other: { a: int }): bool {
    self.a == other.a
  }
}
fn eq-anon() {
  let foo = .{ a = 3 }
  let bar = .{ a = 4 }
  assert(foo != bar)
  assert(.{a = 4} == bar)
}


type block = {
  position: {
    x: int
    y: int
    width: int
    height: int
  },
  text: int
}

fn block_area(b: block): int { b.position.width * b.position.height }

fn struct-nested() {
  let width = 50
  let b: block = .{
    position = .{ x = 1, y = 1, width, height = 50 },
    text = 42
  }
  let area: int = block_area(b)
  assert(area == 2500)
  let area2: int = block_area(.{ position = .{ x = 1, y = 1, width = 50, height = 50 }, text = 42 })
  assert(area2 == 2500)
}

fn patch() {
  let breaker = false

  let make-struct = fn[breaker.&]. { if breaker.* crash(""); breaker.* = true; .{ a = 1, b = true, c = "hello", d = .{ inside = 0 } } }
  let s: { a: int, b: bool, c: string, d: { inside: int } } = make-struct() | .{ a = 4, b = false, d = .{ inside = 1 } }

  assert-equals(s.a, 4)
  assert-equals(s.b, false)
  assert-equals(s.c, "hello")
  assert-equals(s.d.inside, 1)

  let base: { a: int, b: bool } = .{ a = 1, b = true }
  let chained = base | .{ a = 2 } | .{ b = false }
  assert-equals(chained.a, 2)
  assert-equals(chained.b, false)
  assert-equals(base.a, 1)

  let pair: patch-pair[int] = .{ first = 1, second = 2 }
  let swapped = pair | .{ first = pair.second }
  assert-equals(swapped.first, 2)
  assert-equals(swapped.second, 2)

  let wrapped: ?patch-pair[int] = :some (pair | .{ second = 9 })
  assert-equals(wrapped.!.second, 9)

  let partial: { a: int, b: int } = .{ a = 7, b = 8 } | .{ b = uninit }
  assert-equals(partial.a, 7)

  assert-equals[?string](
    test-compile(base | .{ a = 2, nope = 3, extra = 4 }),
    :some "Struct has an unexpected field 'nope'"
  )
  assert-equals[?string](
    test-compile(1 | .{ a = 2 }),
    :some "patch base must be a struct"
  )
}

fn nominated() {
  let p = nom-point.{ x = 1, y = 2 }
  assert-equals(p.sum(), 3)
  let w = nom-wrap[int].{ inner = 4 }
  assert-equals(w.inner, 4)
  assert-equals(nom-point.{ x = 3, y = 4 }.sum(), 7)
  let some-p: ?nom-point = :some nom-point.{ x = 5, y = 6 }
  assert-equals(some-p.!.y, 6)
  assert-equals(identity(nom-point.{ x = 7, y = 8 }).x, 7)
  let multi = nom-point.{
    x = 9,
    y = 10,
  }
  assert-equals(multi.y, 10)
  assert(test-compile(nom-point.{ x = 1 }).is-some())
  assert(test-compile(int.{ x = 1 }).is-some())
}

fn auto-equals() {
  let a: { x: int, y: f32 } = .{ x = 10, y = 10.0 }
  let b: { x: int, y: f32 } = .{ x = 20, y = 20.0 }
  let c: { x: int, y: f32 } = .{ x = 10, y = 10.0 }
  assert(a != b)
  assert(a == c)
  core/assert-not-equals(a, b)
  assert-equals(a, c)

  assert-equals(a.show(), ".{ x = 10, y = 10.000000 }")
}

fn test() {
  basic-struct()
  struct-arg-mut()
  eq-anon()
  struct-nested()
  patch()
  nominated()
  auto-equals()
}
