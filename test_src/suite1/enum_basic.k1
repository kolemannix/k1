ns enum_basic

use core/types/enum/enum-from-value
use core/types/enum/enum-from-value-unchecked

type enum-abc = either(u8) { a, b, c }
type custom-enum-tags = either { a = 10, b = 11, c = 12 }

fn get-enum-value[i, e: types/enum[v = i]](e: e): i {
  e.enum-value()
}

fn from-value-generic[i, e: types/enum[v = i]](value: i): ?e { enum-from-value(value) }

fn(test) values-and-names() {
  let c: enum-abc = :c
  assert-equals(c.value, 2)
  assert-equals(get-enum-value(c), 2)
  assert-equals[string](c.enum-name(), "c")
  assert-equals(custom-enum-tags:b.value, 11)
  assert-equals[string]("${custom-enum-tags:b} ${custom-enum-tags:c}", "b c")
  let ab: either { a, b } = :b
  let _cd: either { c, d } = :c
  let ab-again: either { a, b } = ab
  assert(ab-again is :b)
}

fn(test) from-value-and-members() {
  let b: ?custom-enum-tags = enum-from-value(11)
  assert(b is :some :b)
  let missing: ?custom-enum-tags = enum-from-value(13)
  assert(missing is :none)
  let zero: ?custom-enum-tags = enum-from-value(0)
  assert(zero is :none)
  let unchecked: custom-enum-tags = enum-from-value-unchecked(12)
  assert(unchecked is :c)
  assert(from-value-generic[u8, enum-abc](1) is :some :b)
  assert(from-value-generic[u8, enum-abc](3) is :none)
  assert-equals(types/enum@(enum-abc)/members(), [:a, :b, :c])
  assert-equals(types/enum@(custom-enum-tags)/members().[2].value, 12)
}
