ns buffer_test

fn buffer-empty() {
  let empty = buffer/empty[int]()
  assert(empty.len == 0)
  assert(empty.is-empty())
  assert(not empty.non-empty())
  assert(empty.first() == :none)
  assert(empty.last() == :none)
}

fn buffer-filled() {
  let buf = buffer/filled[i8](5, 42)
  assert(buf.len == 5)
  assert(not buf.is-empty())
  assert(buf.non-empty())
  assert(buf == [42, 42, 42, 42, 42]: buffer[i8])
}

fn buffer-take-drop() {
  let buf = [0, 1, 2, 3, 4]: buffer[int]

  assert(buf.take(3) == [0, 1, 2]: buffer[int])
  assert(buf.drop(2) == [2, 3, 4]: buffer[int])

  assert-equals(buf.take(99).len, 5)
  assert-equals(buf.drop(99).len, 0)
  assert-equals(buf.take-right(99).len, 5)
  assert-equals(buf.drop-right(99).len, 0)
  assert-equals(buf.take-right(2).get(0), 3)
  assert-equals(buf.drop-right(2).len, 3)

  let none: buffer[int] = buffer/empty()
  assert-equals(none.take(1).len, 0)
  assert-equals(none.drop(1).len, 0)
  assert-equals(none.take-right(1).len, 0)
  assert-equals(none.drop-right(1).len, 0)

  assert-equals("abc".take-right(99), "abc")
  assert-equals("abc".drop(99), "")
}

fn buffer-concat() {
  let combined = (buffer/filled(2, 1)).concat(buffer/filled(2, 2))
  assert(combined == [1, 1, 2, 2]: buffer[int])
}

fn buffer-chunks() {
  let b = [1,2,3,4]: buffer[int]
  assert-equals(b.chunks(1).len(), 4)
  assert-equals(b.chunks(1).get(0), [1])
  assert-equals(b.chunks(1).get(3), [4])

  assert-equals(b.chunks(4).get(0), [1,2,3,4])
  assert-equals(b.chunks(7).get(0), [1,2,3,4])

  assert-equals(b.chunks(3).get(0), [1,2,3])
  assert-equals(b.chunks(3).get(1), [4])
  .{}
}

fn buffer-clone() {
  let original = [10, 20, 30]: buffer[int]
  let cloned = original.cloned()
  assert(cloned == original)

  // Modify clone and verify original is unchanged
  cloned.set(0, 99)
  assert(original.get(0) == 10)
  assert(cloned.get(0) == 99)
}

fn test() {
  buffer-empty()
  buffer-filled()
  buffer-take-drop()
  buffer-concat()
  buffer-clone()
  buffer-chunks()
}
